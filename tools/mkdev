#!/usr/bin/env bash
# Add the dev variant to a staging root. Never change the base image.
# Inputs are tools/mkwolf output and tools/mkwolf-std output.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 3 ] || [ $# -eq 4 ] || die "usage: mkdev ROOT WOLF-DIR STD-DIR [LINK-DIR]"
. "$PAX_ROOT/user/wolf.pin"
r=$1 bins=$2 std=$3
[ "$(cat "$std/STD-REV")" = "$WOLF_STD_REV" ] || die "std revision differs from pin"
mkdir -p "$r/usr/bin" "$r/usr/share/wolf/std" "$r/etc"
for f in wolf wolf-cimport-worker libwolf_rt.a; do cp "$bins/$f" "$r/usr/bin/$f"; done
chmod 755 "$r/usr/bin/wolf" "$r/usr/bin/wolf-cimport-worker"
cp -R "$std/." "$r/usr/share/wolf/std/"
cp "$PAX_ROOT"/user/wolf/*.lu "$r/usr/share/wolf/"
# Preserve an existing base shrc, but do not import lope into the small
# test root, where lope is absent. The playground supplies its base shrc.
[ -f "$r/etc/shrc" ] || : > "$r/etc/shrc"
cat >> "$r/etc/shrc" <<"SHRC"
# PAX dev variant (px60).
export PATH=/usr/bin:/bin
export WOLF_STD=/usr/share/wolf/std
export LUPIN_STD=/usr/share/wolf/std
SHRC

# LINK-DIR is the measured M2 stack. Omitting it explicitly builds the
# smaller checked-machine variant used by the fast CI session gate.
if [ $# -eq 4 ]; then
    links=$4
    for f in ld.lld cc sysroot/crt1.o sysroot/crti.o sysroot/crtn.o sysroot/libc.a sysroot/libunwind.a; do
        row=$(awk -v key="$f" '$1 == key { print }' "$PAX_ROOT/user/wolf-link.sums")
        read -r name sha bytes <<< "$row"
        [ "$name" = "$f" ] && [ "$(sha256_of "$links/$f")" = "$sha" ] && \
            [ "$(wc -c < "$links/$f" | tr -d " ")" = "$bytes" ] || die "native link input differs from pin: $f"
    done
    mkdir -p "$r/usr/lib/wolf-musl"
    cp "$links/ld.lld" "$links/cc" "$r/usr/bin/"
    chmod 755 "$r/usr/bin/ld.lld" "$r/usr/bin/cc"
    for f in crt1.o crti.o crtn.o libc.a libunwind.a; do
        cp "$links/sysroot/$f" "$r/usr/lib/wolf-musl/$f"
    done
    say "native dev variant: static lld, link-only cc, musl binary CRT/libc and libunwind"
else
    say "checked dev variant: no native linker"
fi
