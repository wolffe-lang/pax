#!/usr/bin/env python3
"""Assemble px82's distribution payload from verified, built inputs (px90: den).
Usage: distribution-root BASE.cpio INPUTS IDENTITY_DIR OUT.cpio dev|release
INPUTS holds auth/ (tools/mkauth's output: su, sudo, passwd, login and sums.txt) beside the other
programs (px106; px103's sudo/ before it), trash/ (tools/mktrash's: the five commands and sums.txt)
(tb03), and ligature/ (tools/mkligature's: ligature and sums.txt; the dev image's only) (px128).
The old payload supplies only unchanged support files and the pinned native
compiler/linker bundle. Every current org binary and the base std are replaced.
"""
from pathlib import Path
import hashlib
import os
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
BASE_SHA = '098b918ecfe7fae1b1c05c1a92b0bbde33cbc88fab0b63b3737941590f8a35c4'

def sha(data):
    return hashlib.sha256(data).hexdigest()

def read_cpio(blob):
    rows = {}; offset = 0
    while True:
        h = blob[offset:offset+110]
        assert h[:6] == b'070701', 'base is not newc'
        f = [int(h[i:i+8], 16) for i in range(6, 110, 8)]
        name = blob[offset+110:offset+110+f[11]-1].decode()
        start = (offset+110+f[11]+3) & ~3
        data = blob[start:start+f[6]]
        assert len(data) == f[6]
        offset = (start+f[6]+3) & ~3
        if name == 'TRAILER!!!':
            break
        assert name not in rows
        rows[name] = (f[1], f[2], f[3], data)
    assert not blob[offset:].strip(b'\0')
    return rows

def write_cpio(rows, output):
    with output.open('wb') as out:
        for ino, (name, (mode, uid, gid, data)) in enumerate(sorted(rows.items()) + [('TRAILER!!!', (0, 0, 0, b''))], 1):
            encoded = name.encode() + b'\0'
            fields = [ino, mode, uid, gid, 2 if mode & 0o170000 == 0o040000 else 1, 0, len(data), 0, 0, 0, 0, len(encoded), 0]
            out.write(b'070701' + b''.join(f'{n:08x}'.encode() for n in fields) + encoded)
            out.write(b'\0' * (-out.tell() % 4))
            out.write(data)
            out.write(b'\0' * (-out.tell() % 4))

def main():
    base, inputs, identity, output = map(Path, sys.argv[1:5])
    variant = sys.argv[5]
    assert variant in ('dev', 'release')
    blob = base.read_bytes()
    assert sha(blob) == BASE_SHA, 'baseline payload digest mismatch'
    rows = read_cpio(blob)
    # px92 (wolf-lang#962): the dev compiler is user/wolf.pin's, built from source by tools/mkwolf into
    # INPUTS/wolf and held to user/wolf.sums; it replaces the base payload's v0.2.35, whose static musl
    # programs read an empty env_args(). The link stack stays the base payload's, validated below.
    for line in (ROOT / 'user/wolf.sums').read_text().splitlines():
        name, digest, size = line.split()
        data = (inputs/'wolf'/name).read_bytes()
        assert (sha(data), len(data)) == (digest, int(size)), 'compiler input mismatch: '+name
        rows['usr/bin/'+name] = (*rows['usr/bin/'+name][:3], data)
    for line in (ROOT / 'user/wolf-link.sums').read_text().splitlines():
        name, digest, size = line.split()
        path = 'usr/lib/wolf-musl/'+name[8:] if name.startswith('sysroot/') else 'usr/bin/'+name
        data = rows[path][3]
        assert (sha(data), len(data)) == (digest, int(size)), 'link input mismatch: '+name
    def put(name, data, mode=0o644, uid=0, gid=0):
        for parent in reversed(Path(name).parents):
            if parent.as_posix() != '.':
                rows.setdefault(parent.as_posix(), (0o40755, uid, gid, b''))
        rows[name] = (0o100000 | mode, uid, gid, data)
    # The compiler keeps its own std, while lupin gets user/std.pin in BOTH images. px92: the compiler's is
    # user/wolf.pin's WOLF_STD_REV, staged by tools/mkwolf-std into INPUTS/wolf-std (the base payload's
    # compiler std was v0.2.35's).
    for name in list(rows):
        if name.startswith('usr/share/wolf/std/'):
            del rows[name]
    if variant == 'dev':
        std_rev = next(l.split('=', 1)[1].strip() for l in (ROOT / 'user/wolf.pin').read_text().splitlines()
                       if l.startswith('WOLF_STD_REV='))
        rows['usr/share/wolf/compiler-std'] = (0o40755, 0, 0, b'')
        for source in sorted((inputs/'wolf-std').rglob('*')):
            assert not source.is_symlink(), 'compiler std symlink'
            name = 'usr/share/wolf/compiler-std/' + source.relative_to(inputs/'wolf-std').as_posix()
            rows[name] = (0o40755, 0, 0, b'') if source.is_dir() else (0o100644, 0, 0, source.read_bytes())
        assert rows['usr/share/wolf/compiler-std/STD-REV'][3].strip() == std_rev.encode(), 'compiler std revision'
        # px128: ligature, the linker in wolf, beside lld: tools/mkligature's stripped static binary,
        # held to its builder's sums and to user/ligature.pin's digest. lld stays the default (no
        # WOLF_LD in /etc/shrc); `export WOLF_LD=/usr/bin/ligature` selects it.
        lig = (inputs/'ligature'/'ligature').read_bytes()
        assert (inputs/'ligature'/'sums.txt').read_text().split() == ['ligature', sha(lig), str(len(lig))], 'ligature input mismatch'
        pinned = [l.split()[2:4] for l in (ROOT/'user/ligature.pin').read_text().splitlines() if l.split()[:2] == ['#', 'ligature']]
        assert pinned == [[sha(lig), str(len(lig))]], 'ligature is not the digest user/ligature.pin records'
        rows['usr/bin/ligature'] = (0o100755, 0, 0, lig)
    else:
        for name in list(rows):
            if name == 'usr/bin' or name.startswith('usr/bin/') or name == 'usr/lib/wolf-musl' or name.startswith('usr/lib/wolf-musl/'):
                del rows[name]
    for source in sorted((inputs/'base-std/std').rglob('*')):
        assert not source.is_symlink(), 'base std symlink'
        if source.is_file():
            put('usr/share/wolf/std/'+source.relative_to(inputs/'base-std/std').as_posix(), source.read_bytes())
    # Each original binary must still match its builder's sums before stripping.
    with tempfile.TemporaryDirectory(prefix='px82-strip-') as scratch:
        for project in ('bore', 'pelt', 'yew', 'scent', 'lope', 'aspen', 'lupin', 'lobo', 'sniff'):
            for line in (inputs/project/'sums.txt').read_text().splitlines():
                name, digest, size = line.split()
                source = inputs/project/name
                data = source.read_bytes()
                assert (sha(data), len(data)) == (digest, int(size)), 'built input mismatch: '+name
                # scent/wrappers and the published lupin remain byte-for-byte inputs.
                if project not in ('scent', 'lupin'):
                    stripped = Path(scratch)/name
                    subprocess.run(['strip', '-o', str(stripped), str(source)], check=True)
                    data = stripped.read_bytes()
                put('bin/'+name, data, 0o755)
                if project == 'pelt':
                    put('bin/sh', data, 0o755)
        # px90: den unmodified (never stripped) and /bin/git a symbolic link
        # to it, by the one helper tests/mpx5-den's own image uses as well.
        stage = Path(scratch)/'den-root'
        subprocess.run([str(ROOT/'tools/install-den'), str(inputs/'den'), str(stage)], check=True)
        for source in sorted((stage/'bin').iterdir()):
            assert 'bin/'+source.name not in rows, 'den would replace bin/'+source.name
            if source.is_symlink():
                rows['bin/'+source.name] = (0o120777, 0, 0, os.readlink(source).encode())
            else:
                put('bin/'+source.name, source.read_bytes(), 0o755)
        # px100's service wrappers come from the same stage: since px104
        # (R-px104-5) /bin/git-upload-pack and /bin/git-receive-pack, the
        # loop above's, and /etc/shrc names neither.
        assert not (stage/'usr/libexec/den').exists(), 'tools/install-den left wrappers under /usr/libexec/den'
        # px104 (R-px104-4): burrow unmodified (never stripped) as /bin/ssh
        # and /bin/burrow-keygen, by the helper tests/mpx4-console-push's
        # image uses as well.
        stage = Path(scratch)/'burrow-root'
        subprocess.run([str(ROOT/'tools/install-burrow'), str(inputs/'burrow'), str(stage)], check=True)
        for source in sorted((stage/'bin').iterdir()):
            assert 'bin/'+source.name not in rows, 'burrow would replace bin/'+source.name
            put('bin/'+source.name, source.read_bytes(), 0o755)
    # tb03: trash's five commands unmodified (tools/mktrash's: stripped by
    # trash's own build, and not again here), 0755, each held to its
    # builder's sums; tests/distribution holds them to user/trash.pin.
    for line in (inputs/'trash'/'sums.txt').read_text().splitlines():
        name, digest, size = line.split()
        data = (inputs/'trash'/name).read_bytes()
        assert (sha(data), len(data)) == (digest, int(size)), 'built input mismatch: '+name
        assert 'bin/'+name not in rows, 'trash would replace bin/'+name
        put('bin/'+name, data, 0o755)
    # px104 (R-px104-2): the root set den's TLS reads (tools/mkroots, held
    # to user/roots.pin's digests here as well), /etc/shrc exporting
    # DEN_TLS_ROOTS; (R-px104-6) GitHub's published host key.
    roots = (inputs/'roots'/'ca-roots.der').read_bytes()
    pin = dict(l.split('=', 1) for l in (ROOT/'user/roots.pin').read_text().splitlines() if l and not l.startswith('#'))
    assert sha(roots) == pin['ROOTS_DER_SHA256'], 'the root set is not user/roots.pin\'s'
    put('etc/ssl/certs/ca-roots.der', roots)
    put('etc/ssh/ssh_known_hosts', (ROOT/'user/ssh_known_hosts').read_bytes())
    # px112: burrowd, the ssh server (burrow's third program, installed above
    # as /bin/burrowd): its configuration (R-px112-9, root's, 0644), the boot
    # hook that makes the host key at the first boot and starts it
    # (R-px112-7, R-px112-8: /etc/pax-boot.d, run by pid 1), and its worker's
    # account (R-px112-10: burrowd, 989, no home, no shell), appended to the
    # base payload's passwd and group, which a fresh install copies and an
    # upgrade appends. No host key ships: each machine makes its own.
    assert 'bin/burrowd' in rows, 'no /bin/burrowd: tools/mkburrow builds it since px112'
    # px116 (pax#334): /etc/shrc and burrowd's configuration from one list, tools/system-env's:
    # the configuration's SetEnv line is written from the variables /etc/shrc exports for the
    # console (every one but PATH), so a command over ssh has them too, and the two cannot drift.
    shrc = subprocess.run([sys.executable, '-I', str(ROOT/'tools/system-env'), 'shrc', variant],
                          check=True, capture_output=True).stdout
    with tempfile.TemporaryDirectory(prefix='px116-env-') as scratch:
        (Path(scratch)/'shrc').write_bytes(shrc)
        config = subprocess.run([sys.executable, '-I', str(ROOT/'tools/system-env'), 'burrowd-config',
                                 str(Path(scratch)/'shrc')], check=True, capture_output=True).stdout
    put('etc/burrowd/burrowd_config', config)
    put('etc/pax-boot.d/burrowd', (ROOT/'user/pax-boot.d/burrowd').read_bytes(), 0o755)
    for name, line in (('etc/passwd', b'burrowd:x:989:989:burrowd:/nonexistent:/bin/false\n'),
                       ('etc/group', b'burrowd:x:989:\n')):
        mode, uid, gid, data = rows[name]
        assert b'\nburrowd:' not in b'\n' + data and b':989:' not in data, name + ' has a burrowd line or 989 already'
        rows[name] = (mode, uid, gid, data + (b'' if data.endswith(b'\n') else b'\n') + line)
    # px90 (R-px90-2): the zone database's UTC, the bytes /etc/localtime
    # already has (tools/mkzone): den prints a date only from $TZDIR/$TZ
    # (default /usr/share/zoneinfo), with TZ=UTC or with TZ unset.
    zone = rows['etc/localtime'][3]
    with tempfile.TemporaryDirectory(prefix='px90-zone-') as scratch:
        subprocess.run([str(ROOT/'tools/mkzone'), scratch+'/UTC'], check=True, stdout=subprocess.DEVNULL)
        assert Path(scratch+'/UTC').read_bytes() == zone, 'tools/mkzone is not the base /etc/localtime'
    put('usr/share/zoneinfo/UTC', zone)
    # px103: sudo, set-user-ID root (put keeps the set-ID bit: the mode is 0o100000|mode, written whole),
    # with the policy (root-owned, 0440: sudo refuses a writable one) and /var/log for its log. The log
    # file itself is sudo's to make (0600, root's). px106: tools/mkauth's su, sudo, passwd and login,
    # each held to its sums: su, sudo and passwd set-user-ID root (su replaces the base payload's old
    # build), login 0755 (the installed system's /etc/pax-run). No /etc/shadow: no image ships a
    # password (R1); an install writes it, an upgrade makes one when there is none.
    modes = {'su': 0o4755, 'sudo': 0o4755, 'passwd': 0o4755, 'login': 0o755}
    for line in (inputs/'auth'/'sums.txt').read_text().splitlines():
        if not line.strip():
            continue
        name, digest, size = line.split()
        data = (inputs/'auth'/name).read_bytes()
        assert (sha(data), len(data)) == (digest, int(size)), 'built input mismatch: '+name
        assert name in modes, 'an unknown account program: '+name
        put('bin/'+name, data, modes[name])
    assert 'etc/shadow' not in rows, 'the base payload ships /etc/shadow'
    put('etc/sudoers', (ROOT/'user/sudo/sudoers').read_bytes(), 0o440)
    rows['var'] = (0o40755, 0, 0, b'')
    rows['var/log'] = (0o40755, 0, 0, b'')
    # px112: /var/run for burrowd's PidFile. The image ships it, so the boot
    # hook's `mkdir -p` makes nothing on a stick, and an upgrade's walk of
    # the running stick lists no directory the image does not.
    rows['var/run'] = (0o40755, 0, 0, b'')
    put('bin/pax-release', (ROOT/'user/pax-release').read_bytes(), 0o755)
    for name, source in [('pax-install', identity/'installer/pax-install'),
                         ('limine', identity/'limine/limine'), ('reboot', identity/'diskprobe/reboot'),
                         ('poweroff', identity/'diskprobe/reboot')]:  # px87 (pax#243): reboot.S by its second name
        put('bin/'+name, source.read_bytes(), 0o755)
    for name in ('paxgpt', 'paxfat', 'paxext2'):
        put('bin/'+name, (identity/'disktools'/name).read_bytes(), 0o755)
    # px115: an upgrade sent over ssh. pax-upgrade (tools/mkinstall upgrade, beside pax-install),
    # the boot hook pid 1 runs from /etc/pax-boot.d (its `boot`: a staged upgrade seen to at each
    # boot), and this archive's own boot entry, which the installed system's `pax-upgrade arm`
    # fills when this archive is the one sent (decision 7, notes/px115-upgrade-over-ssh.md).
    put('bin/pax-upgrade', (identity/'installer/pax-upgrade').read_bytes(), 0o755)
    # px118: pax-boot-status (tools/mkbootstatus's), whose `record` the boot's first program runs
    # (/bin/login as pid 1, the live login script) and which anyone may run for the last ten boots.
    put('bin/pax-boot-status', (identity/'bootstatus/pax-boot-status').read_bytes(), 0o755)
    put('etc/pax-boot.d/pax-upgrade', (ROOT/'user/install/pax-upgrade/boot-hook').read_bytes(), 0o755)
    put('usr/share/pax-upgrade/entry', (ROOT/'user/install/pax-upgrade/entry').read_bytes(), 0o644)
    for tree, prefix in ((identity/'boot', 'boot/'), (identity/'payload', 'usr/share/pax-install/')):
        for source in sorted(tree.rglob('*')):
            if source.is_file():
                put(prefix+source.relative_to(tree).as_posix(), source.read_bytes(),
                    0o755 if source.parent.name == 'games' and not source.name.endswith('.tar.gz') else 0o644)
    put('etc/pax-live', b'pax-live-games-v1\n')
    # px105: the console takes a lease (R-px105-5: wait at most 10 s for it).
    put('etc/pax-net', (ROOT/'user/pax-net').read_bytes())
    put('etc/pax-release', (identity/'pax-release').read_bytes())
    put('etc/pax-banner', (identity/'pax-banner').read_bytes())
    put('etc/shrc', shrc)  # px116: tools/system-env's, written above with burrowd's configuration
    put('etc/motd', (f'PAX {variant}: run pax-release for exact pins and image identity.\n'
        'pelt is pid 1; friendly editing: set -o friendly -o suggest -o histsearch\n'
        'yew edits files; yew fl starts the Fletch prompt. Files live in memory.\n'
        'Games: ~/Games/pack/pack --tier rich (cub and trail likewise; q quits).\n'
        'Installer: pax-install (ext2 developer preview; inspect the target before confirming).\n'
        'Run cd /home/pax first; exit halts the machine.\n').encode())
    put('etc/pax-run', b'/bin/env ENV=/etc/shrc /bin/sh -i -m\n')
    for line in (ROOT/'user/install/games.txt').read_text().splitlines():
        if not line or line.startswith('#'):
            continue
        name, rev, source_sha, _, _, engine, engine_sha = line.split()
        binary_sha = dict((b, a) for a,b in (l.split() for l in (inputs/'games/games.sha256').read_text().splitlines()))[name]
        for dest, source, want, mode in ((name, name, binary_sha, 0o755), ('source.tar.gz', name+'.source.tar.gz', source_sha, 0o644), ('engine.source.tar.gz', name+'.engine.source.tar.gz', engine_sha, 0o644)):
            data = (inputs/'games'/source).read_bytes()
            assert sha(data) == want, 'game input mismatch: '+source
            put('home/pax/Games/'+name+'/'+dest, data, mode, 1000, 1000)
    inventory = ''.join(f'{sha(data)}  {name}\n' for name,(mode,uid,gid,data) in sorted(rows.items()) if mode & 0o170000 != 0o040000)
    put('etc/pax-files.sha256', inventory.encode())
    write_cpio(rows, output)
    print(f'distribution: {variant} {output.stat().st_size} bytes, {len(rows)} entries')

if __name__ == '__main__':
    main()
