#!/usr/bin/env bash
# Build each requested disk tool for baseline x86-64 Linux, statically.
# tools/fetch-wolf verifies kernel/wolf.pin; tools/fetch-std verifies
# user/std.pin. No executable from the host's libc is copied into PAX.
# Usage: tools/mkdisktools OUTDIR [paxgpt paxfat paxext2]
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -ge 1 ] || die 'usage: mkdisktools OUTDIR [paxgpt paxfat paxext2]'
out=$1; shift
mkdir -p "$out"; out=$(cd "$out" && pwd)
[ $# -gt 0 ] || set -- paxgpt paxfat paxext2
need cc clang readelf
wolf=$("$PAX_ROOT/tools/fetch-wolf")
w=$(mktemp -d "${TMPDIR:-/tmp}/pax-disktools.XXXXXX")
trap 'rm -rf "$w"' EXIT
PAX_BUILD="$w/std-source" "$PAX_ROOT/tools/fetch-std" "$w/std" >&2
mkdir -p "$w/bin"
printf '#!/bin/sh\nexec %s -static "$@"\n' "$(command -v cc)" > "$w/bin/cc"
chmod +x "$w/bin/cc"
: > "$out/sums.txt"
for name in "$@"; do
    case $name in paxgpt|paxfat|paxext2) ;; *) die "unknown program $name" ;; esac
    mkdir -p "$w/$name/diskio"
    cp "$PAX_ROOT/user/disktools/$name/"*.lu "$w/$name/"
    cp "$PAX_ROOT/user/disktools/common/"*.lu "$w/$name/diskio/"
    PATH="$w/bin:$PATH" WOLF_STD="$w/std/std" "$wolf" build --release --no-cache --deny-warnings \
        "$w/$name/main.lu" -o "$out/$name" >&2
    readelf -hW "$out/$name" | grep -Eq 'Type: +EXEC' || die "$name: not ET_EXEC"
    if readelf -lW "$out/$name" | grep -q INTERP; then die "$name: not static"; fi
    printf '%s %s %s\n' "$name" "$(sha256_of "$out/$name")" "$(wc -c < "$out/$name" | tr -d ' ')" | tee -a "$out/sums.txt"
done
