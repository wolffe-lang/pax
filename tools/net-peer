#!/usr/bin/env python3
# net-peer — the other end of PAX's network cable (px21, tests/mpx4-net's
# `peer` way).
#
#   tools/net-peer --listen PORT --qemu PORT [--soak N] [--boot SECONDS] [--udp]
#   tools/net-peer --listen PORT --qemu PORT --tcp [--soak N] [--bulk BYTES]
#                  [--lossy BYTES] [--boot SECONDS]
#
# QEMU is started with `-netdev socket,id=…,udp=127.0.0.1:<listen>,
# localaddr=127.0.0.1:<qemu>`: every Ethernet frame the guest sends is
# one UDP datagram to <listen>, and every datagram this script sends to
# <qemu> is a frame the guest receives. Nothing else is on the wire, so
# this script is the whole network: an on-link host 10.0.2.100
# (52:54:00:00:00:aa), the gateway 10.0.2.2 (52:55:0a:00:02:02), a host
# behind the gateway, 192.0.2.1, and nobody at 10.0.2.99. No privilege,
# no tap device and no ICMP socket is needed: it runs wherever QEMU and
# python3 do.
#
# kernel/kmain_net.lu, booted with `peer` on its command line, goes
# first (part A), and this script answers and holds every frame to its
# exact bytes:
#
#   A1 queue       an ARP request for 10.0.2.100, answered after 0.3 s;
#                  nothing else may come before the answer, and then the
#                  echo requests 3 and 4 come (1 and 2 were pushed out of
#                  the two-frame queue), identifications 2 and 3
#   A2 ping        echo requests 5-8 to 10.0.2.100, each answered
#   A3 route       an ARP request for 10.0.2.2, then echo requests 9 and
#                  10 for 192.0.2.1 sent to the gateway's hardware address
#   A4 unresolved  three ARP requests for 10.0.2.99, about a second
#                  apart, never answered; echo request 11 never appears
#                  (identification 10 is skipped)
#   A5 aged        another ARP request for 10.0.2.100 (the entry aged
#                  out in 2 s), then echo request 12
#   A6 sizes       echo requests 13 (no data) and 14 (1472 data bytes)
#   A7             the kernel's frame of type 0x88b5: it is serving
#
# then this script asks (part B) and the kernel answers; every answer
# is held to its exact bytes, and where the right answer is none, the
# next echo's answer must be the very next datagram PAX sends (its
# identification says nothing was sent between):
#
#   B1  ARP: a request for 10.0.2.15 is answered; an address probe
#       (sender 0.0.0.0) is answered; a sender claiming 10.0.2.15, a
#       request for another address, and packets with a wrong hardware
#       type, protocol type, length or opcode, or a group sender
#       address, are not
#   B2  echo requests of 0, 1, 56, 57 and 1472 data bytes
#   B3  an echo request from 192.0.2.1 by way of the gateway: the reply
#       goes to the gateway's hardware address
#   B4  an echo request with IP options (padding; a record-route) is
#       answered, without options
#   B5  time to live 1; a frame sent to ff:ff:ff:ff:ff:ff; bytes after
#       the datagram's end; an unusual type of service and DF clear:
#       all answered
#   B6  the malformed and the unwanted, none answered: a wrong header
#       checksum; IHL 4; a header longer than the frame; version 6; a
#       total length over the frame's and under the header's; time to
#       live 0; a first and a later fragment; seven sources that name
#       no single host; three broken option lists; a loose and a strict
#       source route; two destinations that are not PAX; a wrong ICMP
#       checksum; a 4-byte ICMP message; a timestamp request and an
#       echo with code 1; echo requests to both broadcast addresses; an
#       echo reply nobody asked for; a 26-byte frame
#   B7  nobody to take it: of five UDP datagrams at once for a port no
#       socket holds (px22; this kernel makes no socket) the first alone
#       draws a destination unreachable, code 3, quoting its header and
#       8 bytes; a second later a datagram of protocol 253 with options
#       and 3 data bytes draws one of code 2 quoting 24 + 3 bytes and
#       the next, of protocol 6, at once, none; a UDP datagram to the
#       subnet's broadcast and one in a broadcast frame draw none
#   B8  a gratuitous announcement for an address PAX holds no entry for
#       teaches it nothing; one for 10.0.2.100 moves its replies to the
#       new hardware address, and an unsolicited reply moves them back
#   B9  nine more hosts ask for PAX's address (the cache holds eight)
#       and each then gets an echo answered
#   B10 --soak N echo requests (10000), each answered before the next
#   B11 a frame of type 0x88b5: the kernel stops serving
#
# **--udp** (px22, tests/mpx4-udp) plays the other end of the UDP
# witnesses instead (user/net/, run by kernel/kmain_sockets.lu from its
# run list), as the gateway 10.0.2.2, the DNS server 10.0.2.3
# (52:55:0a:00:02:03), the on-link host and the host behind the gateway.
# Every frame PAX sends is rebuilt from its meaning — the ports, the
# data, the next identification — and held to its exact bytes, both
# checksums recomputed:
#
#   U1  `udpecho 7 10.0.2.2 9099` says "ready" from port 7 to 10.0.2.2
#       port 9099; then datagrams of 1, 2, 64, 512 and 1472 bytes from
#       10.0.2.2 port 40000 each come back byte for byte (RFC 862)
#   U2  --soak N (10000) more, 56 bytes each, one at a time; then "quit"
#   U3  `udpclient 10.0.2.2 9099`: four datagrams from one ephemeral
#       port (32768-60999), each answered with its bytes reversed, the
#       fourth 1472 bytes; a fifth from another ephemeral port
#   U4  `udpsoak 10.0.2.2 9099 N`: N datagrams of 64 bytes, each
#       answered reversed
#   U5  a second udpecho says "ready" to port 9098, and is asked from
#       10.0.2.100 and from 192.0.2.1 by way of the gateway; with a
#       datagram that carries no checksum (the answer carries one); with
#       no data; with bytes after the datagram's end; to the subnet's
#       broadcast address in a broadcast frame; with a checksum that
#       comes out zero and is sent as 0xffff (RFC 768), as the answer's
#       must be
#   U6  the malformed, none answered and none delivered: 4 bytes where
#       8 are the least; a length of 7; a length over the datagram's; a
#       wrong checksum; destination port 0
#   U7  nobody listening (port 9): of five datagrams at once the first
#       alone draws a destination unreachable, code 3, quoting its
#       header and 8 bytes; one to the subnet's broadcast and one in a
#       broadcast frame draw none; then "quit"
#   U9  (before U8 on the wire) `udphold 4030 10.0.2.2 9097` says
#       "ready" from port 4030 and reads nothing for a second and a
#       half: 60 datagrams of 1472 bytes are sent to it at once, more
#       than its queue holds (PAX: 44; the rest are counted `full`)
#   U8  `resolve 10.0.2.3 pax.test`: an RFC 1035 query with one A
#       question from an ephemeral port to 10.0.2.3 port 53, answered
#       with one A record, 192.0.2.53
#
# tools/linux-net runs this same script against Linux on a tap device
# (the reference side): there it only plays — what Linux puts in its
# own headers is Linux's — and checks each datagram's ports and data.
#
# **--tcp** (px23, tests/mpx4-tcp) plays the other end of the TCP
# witnesses (user/net/tcp*, run from user/mpx4-tcp.run) with a TCP of
# its own (tools/paxtcp.py), as the gateway 10.0.2.2, the on-link host
# and the host behind the gateway. Every frame PAX sends is rebuilt from
# its fields and held to its exact bytes; every stream is held to its
# bytes and its CRC-32. The faults are this script's to inject:
#
#   T1  `tcpecho 7 10.0.2.2 9099` says "ready" (UDP); connections from
#       10.0.2.2 of 1, 2, 1460, 1461, 4000 and 70000 bytes each come
#       back byte for byte, then the line the server says after this
#       end's FIN ("eof after N bytes, crc X"), then its FIN
#   T2  --soak N (10000) connections, 16 bytes each, one at a time; then
#       "quit"
#   T3  `tcpecho 7 10.0.2.2 9098 fork`: connections from 10.0.2.2,
#       from 10.0.2.100 and from 192.0.2.1 by way of the gateway, each
#       served by a child; "quit"
#   T4  `tcpclient 10.0.2.2 9099`: this script's echo server, PAX the
#       one that connects, a half-close at the end
#   T5  `tcpbulk send 10.0.2.2 9100 BYTES` (--bulk, 16 MiB): the stream
#       pattern out of PAX, held to its length and CRC-32; and
#       `tcpbulk leave 10.0.2.2 9110 60000`: a writer that closes at
#       once, whose bytes and FIN come all the same
#   T6  `tcpbulk recv 7100 10.0.2.2 9097`: the same into PAX; and
#       `tcpbulk recv 7140 10.0.2.2 9097 nap 1500`: a receiver that
#       reads nothing at first, whose window closes, is probed and
#       opens again
#   T7  `tcpsoak to 10.0.2.2 9099 N`: N connections from PAX, each
#       opened, answered and closed
#   T8  how a connection ends: `tcpend` to port 9 (nobody: a reset, the
#       connect refused), to port 9001 (no answer at all: the connect
#       gives up after its one retransmission), to port 9301 (a reset
#       after the first bytes), to port 9302 (silence after the
#       handshake: TCP_USER_TIMEOUT gives up), to port 9003 (an ICMP
#       destination unreachable, code 3, for its SYN) and to port 9004
#       (code 1 for its SYN)
#   T9  scripted faults with PAX the client (`tcpclient` to ports 9201
#       to 9212, 9220): the first SYN lost; the SYN-ACK lost; PAX's
#       handshake ACK lost; a data segment lost each way; a FIN lost
#       each way; every segment to PAX twice; a reset far outside the
#       window, a reset and a SYN inside it but not at RCV.NXT, an
#       acknowledgement of bytes never sent and a segment with no ACK,
#       all of which the connection survives; segments to PAX out of
#       order; a SYN-ACK with every option and then a window closed for
#       a second and a half; segments to PAX with a bit flipped; and
#       SYNs that cross (a simultaneous open)
#   T10 the same faults with PAX the server (`tcpecho 7 10.0.2.2 9096`),
#       a peer that announces MSS 536, a reset at RCV.NXT (the server's
#       read answers -ECONNRESET), a SYN then a reset; and the
#       malformed and the stray, none of which may disturb anything:
#       12 bytes of a segment, a data offset of 4 and one past the
#       segment, a wrong checksum, a port of 0 each side, a broadcast
#       destination, three broken option lists, a SYN, an ACK, a FIN
#       with PSH and URG and a reset for a port nobody listens on (the
#       first three draw a reset, each held to RFC 9293's form), an ACK
#       and a bare FIN for the listener, a SYN with data
#   T11 the loss matrix: `tcpbulk send` to ports 9101, 9105, 9120 and
#       9130 and `tcpbulk recv` on 7101, 7105, 7120 and 7130 — each
#       frame either way dropped with probability 1%, 5% and 20% (the
#       last two digits), and for …30 1% dropped, 5% duplicated, 5%
#       reordered and 2% corrupted — --lossy BYTES (1 MiB; a quarter of
#       it at 20%), every transfer exact; one `net-peer: loss …` line
#       each with the time, the rate and PAX's retransmissions
#   T12 `tcpwolfd`, a wolf program: it says "ready" on a connection of
#       its own to port 9070, its request is sent to port 7070, and
#       only then is its connect to port 9071 answered; its reply
#
# Prints one `net-peer: ok <step> …` line per step and, last, `net-peer:
# PASS …` or `net-peer: FAIL <what>, with the expected and found bytes`.
# Exit 0 on PASS, 1 on FAIL, 2 on a usage error.
#
# Written from RFC 768, RFC 791, RFC 792, RFC 826, RFC 862, RFC 894,
# RFC 1035, RFC 1071, RFC 1122, RFC 9293 and QEMU's documentation of
# `-netdev socket`. No network stack's source.
import os
import socket
import struct
import sys
import time
import zlib

sys.dont_write_bytecode = True  # no tools/__pycache__ in the tree
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import paxnet as px  # noqa: E402
import paxtcp  # noqa: E402


def die(msg):
    print("net-peer: " + msg, file=sys.stderr)
    sys.exit(2)


class Fail(Exception):
    pass


class SocketWire:
    """QEMU's `-netdev socket,udp=…`: a frame is a UDP datagram on this
    host's loopback."""

    def __init__(self, listen, qemu):
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1 << 20)
        self.sock.bind(("127.0.0.1", listen))
        self.to = ("127.0.0.1", qemu)

    def send(self, f):
        self.sock.sendto(f, self.to)

    def recv(self, timeout):
        self.sock.settimeout(max(timeout, 0.001))
        try:
            return self.sock.recvfrom(4096)[0]
        except socket.timeout:
            return None


class Peer:
    def __init__(self, wire, boot, strict=True):
        self.wire = wire
        self.strict = strict  # hold PAX's frames to their bytes (False: the other end is Linux)
        self.started = False
        self.boot = boot
        self.macs = {px.PEER_IP: px.PEER_MAC, px.GW_IP: px.GW_MAC, px.DNS_IP: px.DNS_MAC}
        self.silent_for = {px.NOBODY_IP}
        self.asked = {}  # target -> [times]
        self.last_ident = None
        self.gaps = 0
        self.next_ident = 0
        self.my_ident = 0
        self.before = 0
        self.sent = {}
        self.arp_out = 0
        self.quieted = 0

    # --- the wire ---------------------------------------------------------
    def send(self, f, pad=True):
        self.wire.send(px.pad60(f) if pad else f)

    def recv(self, timeout):
        return self.wire.recv(timeout)

    def fail(self, what, found=None, want=None):
        msg = what
        if found is not None:
            msg += "\n  found    %d bytes %s" % (len(found), found[:120].hex())
        if want is not None:
            msg += "\n  expected %d bytes %s" % (len(want), want[:120].hex())
        raise Fail(msg)

    def tally(self, what):
        self.sent[what] = self.sent.get(what, 0) + 1

    # --- PAX's frames -------------------------------------------------------
    def arp_from_pax(self, f, answer=True):
        """An ARP frame from PAX that is not a reply this script waits
        for: it must be a request, exact; answer it for whom we play."""
        target = f[38:42]
        if not self.strict:
            # Linux's own request: answered when it is one, for whom we play.
            if len(f) >= 42 and px.be16(f, 20) == 1 and target in self.macs and target not in self.silent_for:
                m = self.macs[target]
                self.send(px.arp(f[6:12], m, 2, m, target, f[22:28], f[28:32]))
            return
        if f != px.pax_arp_request(target):
            self.fail("an ARP frame from PAX that is not its request for %s, byte for byte" % px.dotted(target), f, px.pax_arp_request(target))
        self.asked.setdefault(target, []).append(time.time())
        self.arp_out += 1
        if target in self.silent_for:
            return
        if target not in self.macs:
            self.fail("PAX asked for %s, which this script does not play" % px.dotted(target), f)
        if answer:
            m = self.macs[target]
            self.send(px.arp(px.PAX_MAC, m, 2, m, target, px.PAX_MAC, px.PAX_IP))

    def note_ident(self, f):
        ident = px.be16(f, 18)
        if self.last_ident is not None:
            # A counter of 16 bits: after 65535 comes 0 (px23: a TCP
            # transfer sends more datagrams than that).
            ahead = (ident - self.last_ident) & 0xffff
            if ahead == 0 or ahead > 0x4000:
                self.fail("PAX's identification went from %d to %d" % (self.last_ident, ident), f)
            self.gaps += ahead - 1
        else:
            self.gaps += ident
        self.last_ident = ident
        self.next_ident = (ident + 1) & 0xffff

    def next_from_pax(self, timeout=5.0, arp_reply=None):
        """The next frame from PAX that is not an ARP request (those are
        answered on the way). With `arp_reply`, an ARP frame equal to it
        is returned too."""
        end = time.time() + timeout
        while True:
            f = self.recv(end - time.time())
            if f is None:
                return None
            if f[6:12] != px.PAX_MAC:
                self.fail("a frame that is not from PAX's address", f)
            if f[12:14] == b"\x08\x06":
                if arp_reply is not None and f == arp_reply:
                    return f
                self.arp_from_pax(f)
                continue
            return f

    def expect(self, want, what, timeout=5.0):
        f = self.next_from_pax(timeout, arp_reply=want if want[12:14] == b"\x08\x06" else None)
        if f is None:
            self.fail("nothing came for %s in %.0f s" % (what, timeout), None, want)
        if f != want:
            self.fail("not %s, byte for byte" % what, f, want)
        if f[12:14] == b"\x08\x00":
            self.note_ident(f)
        return f

    def hop_mac(self, dst_ip):
        return self.macs[px.next_hop(dst_ip)]

    # --- what this script sends ---------------------------------------------
    def datagram(self, src_ip, payload, src_mac=None, dst_mac=px.PAX_MAC, dst_ip=px.PAX_IP, proto=1, **kw):
        """A frame carrying one datagram to PAX, from `src_ip` by way of
        whoever is its next hop back."""
        if src_mac is None:
            src_mac = self.macs.get(px.next_hop(src_ip), px.PEER_MAC)
        self.my_ident = (self.my_ident + 1) & 0xffff
        kw.setdefault("ident", self.my_ident)
        return px.frame(dst_mac, src_mac, px.ipv4(src_ip, dst_ip, proto, payload, **kw))

    def ask(self, f, what, pad=True):
        """Send the echo request frame `f` and hold PAX's reply to its
        exact bytes."""
        verdict, ihl, total = px.judge_ip(px.pad60(f) if pad else f)
        if verdict != "echo":
            self.fail("%s: the model does not call this an echo request to answer (%s)" % (what, verdict), f)
        self.tally("echo")
        self.send(f, pad)
        want = px.echo_reply_to(f, ihl, total, self.next_ident, self.hop_mac(f[26:30]))
        self.expect(want, "PAX's reply to %s" % what)

    def quiet(self, f, cause, what, pad=True):
        """Send a frame PAX must drop for `cause` and not answer."""
        wire = px.pad60(f) if pad else f
        if f[12:14] == b"\x08\x06":
            verdict = "arp." + px.judge_arp(wire)[0]
        else:
            verdict = px.judge_ip(wire)[0]
        if verdict != cause:
            self.fail("%s: the model calls this %s, the test meant %s" % (what, verdict, cause), f)
        self.tally(cause)
        self.quieted += 1
        self.send(f, pad)

    def fence(self, seq):
        """An echo whose reply must be PAX's very next datagram."""
        self.ask(self.datagram(px.PEER_IP, px.echo(8, 0xfe00, seq, b"fence")), "the echo after them (nothing may have been sent before it)")

    # --- part A: the kernel goes first --------------------------------------
    def part_a(self):
        plan = [(px.PEER_IP, 3, 56, 2), (px.PEER_IP, 4, 56, 3), (px.PEER_IP, 5, 56, 4), (px.PEER_IP, 6, 56, 5),
                (px.PEER_IP, 7, 56, 6), (px.PEER_IP, 8, 56, 7), (px.FAR_IP, 9, 56, 8), (px.FAR_IP, 10, 56, 9),
                (px.PEER_IP, 12, 56, 11), (px.PEER_IP, 13, 0, 12), (px.PEER_IP, 14, 1472, 13)]
        step = 0
        first = True
        end = time.time() + self.boot
        while True:
            f = self.recv(end - time.time())
            if f is None:
                self.fail("part A: no frame for %.0f s (step %d of %d)" % (self.boot, step, len(plan)))
            end = time.time() + 30
            if f[6:12] != px.PAX_MAC:
                self.fail("part A: a frame that is not from PAX's address", f)
            kind = f[12:14]
            if kind not in (b"\x08\x06", b"\x08\x00", px.EXPERIMENTAL):
                if step or not first:
                    self.fail("part A: a frame of type %s after the kernel's first" % kind.hex(), f)
                self.before += 1  # the firmware's, before the kernel
                continue
            if kind == b"\x08\x06":
                if first:
                    # A1: the first request is for 10.0.2.100; the answer
                    # waits 0.3 s and nothing may be sent meanwhile.
                    if f != px.pax_arp_request(px.PEER_IP):
                        self.fail("A1: the kernel's first frame is not its ARP request for 10.0.2.100", f, px.pax_arp_request(px.PEER_IP))
                    self.arp_from_pax(f, answer=False)
                    early = self.recv(0.3)
                    if early is not None:
                        self.fail("A1: a frame was sent before 10.0.2.100's address was known", early)
                    self.send(px.arp(px.PAX_MAC, px.PEER_MAC, 2, px.PEER_MAC, px.PEER_IP, px.PAX_MAC, px.PAX_IP))
                    first = False
                    print("net-peer: ok A1 the request for 10.0.2.100 came first and nothing followed it for 0.3 s")
                else:
                    self.arp_from_pax(f)
                continue
            if kind == px.EXPERIMENTAL:
                if f != px.MARKER:
                    self.fail("A7: not the kernel's ready frame, byte for byte", f, px.MARKER)
                if step != len(plan):
                    self.fail("A7: the kernel is ready after %d of %d echo requests" % (step, len(plan)), f)
                break
            if first:
                self.fail("A1: a datagram before any ARP request", f)
            if step >= len(plan):
                self.fail("part A: a datagram after the last one expected", f)
            dst, seq, n, ident = plan[step]
            want = px.echo_request_from_pax(dst, seq, n, ident, self.hop_mac(dst))
            if f != want:
                self.fail("part A: not echo request %d (%d data bytes, identification %d) for %s by way of %s, byte for byte"
                          % (seq, n, ident, px.dotted(dst), self.hop_mac(dst).hex(":")), f, want)
            self.note_ident(f)
            step += 1
            src_mac = self.hop_mac(dst)
            self.my_ident += 1
            self.send(px.frame(px.PAX_MAC, src_mac, px.ipv4(dst, px.PAX_IP, 1, px.echo(0, px.ECHO_IDENT, seq, px.pattern(n)),
                                                             ttl=64 if px.on_link(dst) else 63, ident=self.my_ident)))
            self.tally("reply")
        # What part A must have shown.
        nobody = self.asked.get(px.NOBODY_IP, [])
        gaps = [b - a for a, b in zip(nobody, nobody[1:])]
        if len(nobody) != 3 or any(g < 0.8 or g > 3.0 for g in gaps):
            self.fail("A4: %d requests for 10.0.2.99, %s s apart; three, about a second apart, were due" % (len(nobody), ["%.2f" % g for g in gaps]))
        if len(self.asked.get(px.PEER_IP, [])) < 2:
            self.fail("A5: 10.0.2.100 was asked for %d times; its entry should have aged out and been asked for again" % len(self.asked.get(px.PEER_IP, [])))
        if len(self.asked.get(px.GW_IP, [])) < 1:
            self.fail("A3: the gateway was never asked for")
        if self.gaps != 3:
            self.fail("part A: %d identifications never reached the wire; 3 were due (0 and 1 pushed out, 10 unresolved)" % self.gaps)
        print("net-peer: ok A2-A7 echo requests 3-10 and 12-14 exact (identifications 2-9, 11-13); 9 and 10 by way of the gateway; "
              "10.0.2.99 asked for 3 times, %s s apart, and given up; 10.0.2.100 asked for %d times; the ready frame"
              % (" and ".join("%.2f" % g for g in gaps), len(self.asked[px.PEER_IP])))

    # --- part B: this script asks -------------------------------------------
    def part_b(self, soak):
        P, G = px.PEER_IP, px.GW_IP
        e = px.echo

        # B1 ARP
        self.send(px.arp(px.BCAST, px.PEER_MAC, 1, px.PEER_MAC, P, px.ZERO6, px.PAX_IP))
        self.tally("arp.request")
        self.expect(px.pax_arp_reply(px.PEER_MAC, P), "PAX's ARP reply to 10.0.2.100")
        probe_mac = px.mac("52:54:00:00:00:bb")
        self.send(px.arp(px.BCAST, probe_mac, 1, probe_mac, b"\0\0\0\0", px.ZERO6, px.PAX_IP))
        self.tally("arp.request")
        self.expect(px.pax_arp_reply(probe_mac, b"\0\0\0\0"), "PAX's ARP reply to an address probe")
        thief = px.mac("52:54:00:00:00:cc")
        self.quiet(px.arp(px.BCAST, thief, 1, thief, px.PAX_IP, px.ZERO6, px.PAX_IP), "arp.conflict", "a sender claiming PAX's address")
        self.quiet(px.arp(px.BCAST, px.PEER_MAC, 1, px.PEER_MAC, P, px.ZERO6, px.ip("10.0.2.77")), "arp.other", "a request for another address")
        for name, kw in (("hardware type 6", {"hrd": 6}), ("protocol type 0x86dd", {"pro": 0x86dd}), ("hardware length 8", {"hln": 8}), ("protocol length 16", {"pln": 16})):
            self.quiet(px.arp(px.BCAST, px.PEER_MAC, 1, px.PEER_MAC, P, px.ZERO6, px.PAX_IP, **kw), "arp.bad", "an ARP packet with " + name)
        self.quiet(px.arp(px.BCAST, px.PEER_MAC, 3, px.PEER_MAC, P, px.ZERO6, px.PAX_IP), "arp.bad", "an ARP packet with opcode 3")
        self.quiet(px.arp(px.BCAST, px.PEER_MAC, 1, px.BCAST, P, px.ZERO6, px.PAX_IP), "arp.bad", "an ARP packet from a group hardware address")
        self.fence(1)
        print("net-peer: ok B1 ARP: a request and an address probe answered; a conflict, another target and six bad packets not")

        # B2 sizes
        for n in (0, 1, 56, 57, 1472):
            self.ask(self.datagram(P, e(8, 0x1234, n, bytes((k * 13 + 5) & 0xff for k in range(n)))), "an echo request of %d data bytes" % n)
        print("net-peer: ok B2 echo requests of 0, 1, 56, 57 and 1472 data bytes answered, each reply exact")

        # B3 off-link
        self.ask(self.datagram(px.FAR_IP, e(8, 0x4321, 7, b"from behind the gateway"), ttl=63), "an echo request from 192.0.2.1")
        print("net-peer: ok B3 an echo request from 192.0.2.1 answered by way of the gateway's hardware address")

        # B4 options
        self.ask(self.datagram(P, e(8, 1, 1, b"padded options"), options=b"\x01\x01\x01\x00"), "an echo request with three no-operation options")
        self.ask(self.datagram(P, e(8, 1, 2, b"record route"), options=b"\x07\x07\x04\x00\x00\x00\x00\x00"), "an echo request with a record-route option")
        print("net-peer: ok B4 echo requests with IP options answered, the replies without options")

        # B5 odd but right
        self.ask(self.datagram(P, e(8, 2, 1, b"ttl 1"), ttl=1), "an echo request with time to live 1")
        self.ask(self.datagram(P, e(8, 2, 2, b"broadcast frame"), dst_mac=px.BCAST), "an echo request in a broadcast frame")
        self.ask(self.datagram(P, e(8, 2, 3, b"trailer")) + b"\xde\xad\xbe\xef" * 9, "an echo request with 36 bytes after the datagram")
        self.ask(self.datagram(P, e(8, 2, 4, b"tos"), tos=0xb8, flags=0), "an echo request with a type of service and DF clear")
        print("net-peer: ok B5 time to live 1, a broadcast frame, trailing bytes and a type of service answered")

        # B6 the malformed and the unwanted
        self.quieted = 0
        ping = e(8, 3, 1, b"must not be answered")
        good = self.datagram(P, ping)
        bad_sum = bytearray(good)
        bad_sum[24] ^= 0x01
        self.quiet(bytes(bad_sum), "ip.checksum", "a wrong header checksum")
        self.quiet(self.datagram(P, ping, ihl=4), "ip.ihl", "IHL 4")
        self.quiet(self.datagram(P, b"", ihl=15, total=60)[:60], "ip.short", "a header longer than the frame")
        self.quiet(self.datagram(P, ping, version=6), "ip.version", "version 6")
        self.quiet(self.datagram(P, ping, total=200), "ip.length", "a total length over the frame's")
        self.quiet(self.datagram(P, ping, total=16), "ip.length", "a total length under the header's")
        self.quiet(self.datagram(P, ping, ttl=0), "ip.ttl", "time to live 0")
        self.quiet(self.datagram(P, ping, flags=0x2000), "ip.fragment", "a first fragment")
        self.quiet(self.datagram(P, ping, flags=185), "ip.fragment", "a later fragment")
        for s in ("255.255.255.255", "10.0.2.255", "224.0.0.1", "240.0.0.1", "127.0.0.1", "0.0.0.0", "10.0.2.15"):
            self.quiet(self.datagram(px.ip(s), ping, src_mac=px.PEER_MAC), "ip.source", "the source " + s)
        self.quiet(self.datagram(P, ping, options=b"\x07\x01\x00\x00"), "ip.option", "an option of length 1")
        self.quiet(self.datagram(P, ping, options=b"\x07\x28\x04\x00"), "ip.option", "an option longer than the header")
        self.quiet(self.datagram(P, ping, options=b"\x01\x01\x01\x07"), "ip.option", "an option with no length byte")
        self.quiet(self.datagram(P, ping, options=b"\x83\x07\x04\x0a\x00\x02\x64\x00"), "ip.source-route", "a loose source route")
        self.quiet(self.datagram(P, ping, options=b"\x89\x07\x04\x0a\x00\x02\x64\x00"), "ip.source-route", "a strict source route")
        self.quiet(self.datagram(P, ping, dst_ip=px.ip("10.0.2.77")), "ip.other", "a datagram for 10.0.2.77")
        self.quiet(self.datagram(P, ping, dst_ip=px.ip("192.0.2.9")), "ip.other", "a datagram for 192.0.2.9")
        self.quiet(self.datagram(P, e(8, 3, 2, b"bad sum", check=0x1234)), "icmp.checksum", "a wrong ICMP checksum")
        self.quiet(self.datagram(P, b"\x08\x00\xf7\xff"), "icmp.short", "a 4-byte ICMP message")
        self.quiet(self.datagram(P, px.icmp(13, 0, b"\x00\x01\x00\x01", b"\x00" * 12)), "icmp.type", "a timestamp request")
        self.quiet(self.datagram(P, e(8, 3, 3, b"code 1", code=1)), "icmp.type", "an echo request with code 1")
        self.quiet(self.datagram(P, ping, dst_mac=px.BCAST, dst_ip=px.SUBNET_BCAST), "icmp.broadcast", "an echo request to 10.0.2.255")
        self.quiet(self.datagram(P, ping, dst_mac=px.BCAST, dst_ip=px.LIMITED_BCAST), "icmp.broadcast", "an echo request to 255.255.255.255")
        self.quiet(self.datagram(P, e(0, px.ECHO_IDENT, 999, px.pattern(56))), "reply", "an echo reply nobody asked for")
        self.fence(2)
        # A frame of 26 bytes, sent as it is: 12 bytes of a header.
        self.quiet(good[:26], "ip.short", "a 26-byte frame", pad=False)
        self.fence(3)
        print("net-peer: ok B6 %d malformed or unwanted datagrams, none answered" % self.quieted)

        # B7 an unknown protocol
        time.sleep(1.3)
        first = self.datagram(P, struct.pack(">HHHH", 4444, 7, 13, 0) + b"hello", proto=17)
        verdict, ihl, total = px.judge_ip(first)
        self.tally("udp")
        self.send(first)
        for k in range(4):
            self.send(self.datagram(P, struct.pack(">HHHH", 4445 + k, 7, 8, 0), proto=17))
            self.tally("udp")
        self.expect(px.port_unreachable_for(first, ihl, total, self.next_ident, px.PEER_MAC), "PAX's port unreachable for the first of five UDP datagrams")
        self.fence(4)
        time.sleep(1.3)
        second = px.pad60(self.datagram(P, b"abc", proto=253, options=b"\x01\x01\x01\x00"))
        verdict, ihl, total = px.judge_ip(second)
        self.tally("unreachable")
        self.send(second)
        self.send(self.datagram(P, b"\x00" * 20, proto=6))
        self.tally("unreachable")
        self.expect(px.unreachable_for(second, ihl, total, self.next_ident, px.PEER_MAC), "PAX's protocol unreachable for a datagram with options and 3 data bytes")
        time.sleep(1.3)
        udp = struct.pack(">HHHH", 4444, 7, 8, 0)
        self.quiet(self.datagram(P, udp, proto=17, dst_mac=px.BCAST, dst_ip=px.SUBNET_BCAST), "udp", "a UDP datagram for a port nobody holds, to the subnet's broadcast")
        self.quiet(self.datagram(P, udp, proto=17, dst_mac=px.BCAST), "udp", "a UDP datagram for a port nobody holds, in a broadcast frame")
        self.fence(5)
        print("net-peer: ok B7 nobody to take it: a port unreachable (code 3) and a protocol unreachable (code 2), each exact; 5 held back by the limit; 2 never due")

        # B8 gratuitous announcements
        stranger_ip, stranger = px.ip("10.0.2.123"), px.mac("52:54:00:00:00:dd")
        self.quiet(px.arp(px.BCAST, stranger, 1, stranger, stranger_ip, px.ZERO6, stranger_ip), "arp.other", "a gratuitous announcement from 10.0.2.123")
        moved = px.mac("52:54:00:aa:bb:cc")
        self.macs[P] = moved
        self.quiet(px.arp(px.BCAST, moved, 1, moved, P, px.ZERO6, P), "arp.other", "a gratuitous announcement moving 10.0.2.100")
        self.ask(self.datagram(P, e(8, 4, 1, b"moved")), "an echo request from 10.0.2.100 at its new hardware address")
        self.macs[P] = px.PEER_MAC
        self.send(px.arp(px.PAX_MAC, px.PEER_MAC, 2, px.PEER_MAC, P, px.PAX_MAC, px.PAX_IP))
        self.tally("arp.reply")
        self.ask(self.datagram(P, e(8, 4, 2, b"moved back")), "an echo request from 10.0.2.100 back at its first hardware address")
        print("net-peer: ok B8 a gratuitous announcement moved 10.0.2.100's replies to 52:54:00:aa:bb:cc and an unsolicited reply moved them back")

        # B9 more hosts than the cache holds
        for k in range(1, 10):
            hip, hmac = px.ip("10.0.2.%d" % (100 + k)), px.mac("52:54:00:00:01:%02x" % k)
            self.macs[hip] = hmac
            self.send(px.arp(px.BCAST, hmac, 1, hmac, hip, px.ZERO6, px.PAX_IP))
            self.tally("arp.request")
            self.expect(px.pax_arp_reply(hmac, hip), "PAX's ARP reply to 10.0.2.%d" % (100 + k))
        for k in range(1, 10):
            hip = px.ip("10.0.2.%d" % (100 + k))
            self.ask(self.datagram(hip, e(8, 5, k, b"one of nine")), "an echo request from 10.0.2.%d" % (100 + k))
        print("net-peer: ok B9 nine more hosts asked for PAX's address and each had an echo answered")

        # B10 the soak
        t0 = time.time()
        data = px.pattern(56)
        for i in range(soak):
            f = px.frame(px.PAX_MAC, px.PEER_MAC, px.ipv4(P, px.PAX_IP, 1, e(8, 0x50aa, i & 0xffff, data), ident=i & 0xffff))
            self.wire.send(f)
            want = px.echo_reply_to(f, 20, 84, self.next_ident & 0xffff, self.macs[P])
            got = self.next_from_pax(5.0)
            if got != want:
                self.fail("B10: not PAX's reply to echo request %d of the soak, byte for byte" % i, got, want)
            self.last_ident = px.be16(got, 18)
            self.next_ident = (self.last_ident + 1) & 0xffff
        span = time.time() - t0
        self.sent["echo"] = self.sent.get("echo", 0) + soak
        print("net-peer: ok B10 %d echo requests answered, each reply exact, in %.2f s (%d echoes/s by this script's clock)"
              % (soak, span, soak / span if span > 0 else 0))

        # B11 stop
        self.send(px.BCAST + px.PEER_MAC + px.EXPERIMENTAL + b"stop")
        print("net-peer: ok B11 told the kernel to stop serving")



    # --- UDP (px22): the other end of user/net's witnesses -------------------
    def udp_in(self, timeout, what):
        """The next UDP datagram from PAX: (source port, destination
        address, destination port, data). ARP requests are answered on
        the way. Strict: the frame is rebuilt and held to its bytes, and
        nothing else may come. Not strict (Linux): whatever else the
        station sends is passed over."""
        end = time.time() + timeout
        while True:
            f = self.recv(end - time.time())
            if f is None:
                self.fail("nothing came for %s in %.0f s" % (what, timeout))
            if f[6:12] != px.PAX_MAC:
                if self.strict:
                    self.fail("a frame that is not from PAX's address", f)
                continue
            kind = f[12:14]
            if kind == b"\x08\x06":
                self.arp_from_pax(f)
                self.started = True
                continue
            if kind != b"\x08\x00" or len(f) < 42 or f[23] != 17 or f[26:30] != px.PAX_IP:
                if not self.strict:
                    continue
                if not self.started and kind not in (b"\x08\x00", px.EXPERIMENTAL):
                    self.before += 1  # the firmware's, before the kernel
                    continue
                self.fail("%s: a frame from PAX that is not a UDP datagram" % what, f)
            self.started = True
            return self.udp_parse(f, what)

    def udp_parse(self, f, what):
        """The UDP frame `f` from PAX, checked (strict: rebuilt and held
        to its bytes): (source port, destination address, destination
        port, data)."""
        ihl, total = (f[14] & 15) * 4, px.be16(f, 16)
        h = f[14:14 + total]
        u = h[ihl:]
        if px.csum(h[:ihl]) != 0 or len(u) < 8 or px.be16(u, 4) != len(u) or px.udp_sum(h[12:16], h[16:20], u) != 0 or px.be16(u, 6) == 0:
            self.fail("%s: a UDP datagram from PAX with a wrong length or checksum, or none" % what, f)
        sport, dport, data = px.be16(u, 0), px.be16(u, 2), u[8:]
        dst = h[16:20]
        if self.strict:
            hop = px.next_hop(dst)
            if hop not in self.macs:
                self.fail("%s: a datagram for %s, which this script does not play" % (what, px.dotted(dst)), f)
            want = px.udp_from_pax(dst, sport, dport, data, self.next_ident, self.macs[hop])
            if f != want:
                self.fail("%s: not PAX's datagram (port %d to %s port %d, %d bytes, identification %d), byte for byte"
                          % (what, sport, px.dotted(dst), dport, len(data), self.next_ident), f, want)
            self.note_ident(f)
        return sport, dst, dport, data

    def udp_out(self, src_ip, sport, dport, data, dst_ip=px.PAX_IP, check=None, length=None, trailer=b"", **kw):
        """Send PAX one UDP datagram from `src_ip` (by way of whoever is
        its next hop back). Returns the frame."""
        f = self.datagram(src_ip, px.udp(sport, dport, data, src_ip, dst_ip, check=check, length=length) + trailer,
                          dst_ip=dst_ip, proto=17, **kw)
        self.send(f)
        return f

    def echoed(self, src_ip, sport, data, what, back=None, **kw):
        """Ask PAX's echo server from `src_ip` port `sport` and hold the
        answer: `back` (default: the data) from port 7 to the asker."""
        self.udp_out(src_ip, sport, px.ECHO_PORT, data, **kw)
        p, dst, dport, got = self.udp_in(10.0, "the echo of " + what)
        want = data if back is None else back
        if (p, dst, dport, got) != (px.ECHO_PORT, src_ip, sport, want):
            self.fail("%s: port %d to %s port %d with %d bytes came back, not port 7 to %s port %d with the %d sent"
                      % (what, p, px.dotted(dst), dport, len(got), px.dotted(src_ip), sport, len(want)))
        self.tally("udp")

    def dropped(self, cause, what, f):
        """`f` was sent and PAX must drop it for `cause`, silently."""
        verdict = px.judge_ip(px.pad60(f))[0]
        if verdict != cause:
            self.fail("%s: the model calls this %s, the test meant %s" % (what, verdict, cause), f)
        self.tally(cause)

    def ready(self, port, timeout):
        p, dst, dport, data = self.udp_in(timeout, "udpecho's \"ready\" to port %d" % port)
        if (p, dst, dport, data) != (px.ECHO_PORT, px.GW_IP, port, b"ready"):
            self.fail("not \"ready\" from port 7 to 10.0.2.2 port %d: port %d to %s port %d, %r" % (port, p, px.dotted(dst), dport, data[:40]))

    def udp_script(self, soak):
        G, P, A = px.GW_IP, px.PEER_IP, px.ASKER_PORT
        # U1: the echo server, asked from the gateway's address.
        self.ready(px.SERVICE_PORT, self.boot)
        for d in px.echo_battery():
            self.echoed(G, A, d, "%d bytes" % len(d))
        print("net-peer: ok U1 \"ready\" from port 7; 1, 2, 64, 512 and 1472 bytes echoed, each datagram exact")
        # U2: the soak in.
        t0 = time.time()
        for i in range(soak):
            self.echoed(G, A, px.soak_datagram(i), "datagram %d of the soak" % i)
        span = time.time() - t0
        self.echoed(G, A, b"quit", "\"quit\"")
        print("net-peer: ok U2 %d datagrams echoed, each exact, in %.2f s (%d a second by this script's clock); \"quit\""
              % (soak, span, soak / span if span > 0 else 0))
        # U3: the client. Its server answers each datagram reversed.
        script = px.client_script()
        first = None
        for k, want in enumerate(script):
            p, dst, dport, data = self.udp_in(60.0, "udpclient's datagram %d" % (k + 1))
            if (dst, dport, data) != (G, px.SERVICE_PORT, want) or p not in px.EPHEMERAL:
                self.fail("U3: datagram %d: port %d to %s port %d, %d bytes (%r…); %d bytes from an ephemeral port to 10.0.2.2 port %d were due"
                          % (k + 1, p, px.dotted(dst), dport, len(data), data[:24], len(want), px.SERVICE_PORT))
            if k == 0:
                first = p
            elif (k < 4) != (p == first):
                self.fail("U3: datagram %d came from port %d; the connected socket's was %d and the last datagram's socket is another" % (k + 1, p, first))
            self.udp_out(G, px.SERVICE_PORT, p, data[::-1])
            self.tally("udp")
        print("net-peer: ok U3 udpclient's five datagrams exact (four from one ephemeral port, 1472 bytes the fourth; the fifth from another), each answered reversed")
        # U4: the soak out.
        t0 = time.time()
        for i in range(soak):
            p, dst, dport, data = self.udp_in(60.0 if i == 0 else 10.0, "udpsoak's datagram %d" % i)
            if (dst, dport, data) != (G, px.SERVICE_PORT, px.soak_request(i)) or p not in px.EPHEMERAL:
                self.fail("U4: datagram %d: port %d to %s port %d, %d bytes: not the soak's" % (i, p, px.dotted(dst), dport, len(data)))
            self.udp_out(G, px.SERVICE_PORT, p, data[::-1])
        span = time.time() - t0
        self.sent["udp"] = self.sent.get("udp", 0) + soak
        print("net-peer: ok U4 udpsoak's %d datagrams exact, each answered reversed, in %.2f s (%d a second by this script's clock)"
              % (soak, span, soak / span if span > 0 else 0))
        # U5: the second echo server, asked more widely.
        self.ready(px.EXTRA_PORT, 60.0)
        self.echoed(P, 40001, b"from the on-link host", "a datagram from 10.0.2.100")
        self.echoed(px.FAR_IP, 40002, b"from behind the gateway", "a datagram from 192.0.2.1", ttl=63)
        self.echoed(G, A, b"no checksum made", "a datagram with no checksum", check=0)
        self.echoed(G, A, b"", "a datagram with no data")
        self.echoed(G, A, b"the datagram", "a datagram with 9 bytes after its end", trailer=b"not in it")
        self.echoed(G, A, b"to everyone on the subnet", "a datagram to 10.0.2.255 in a broadcast frame", dst_ip=px.SUBNET_BCAST, dst_mac=px.BCAST)
        self.echoed(G, A, px.sum_zero(A, px.ECHO_PORT, b"a sum of zero.", G, px.PAX_IP), "a datagram whose checksum comes out zero")
        print("net-peer: ok U5 echoed: from 10.0.2.100; from 192.0.2.1 by way of the gateway; with no checksum (the answer carries one); "
              "with no data; with bytes after its end; to 10.0.2.255 in a broadcast frame; with a checksum that comes out zero (0xffff both ways)")
        # U6: the malformed. None is answered; the echo after them must
        # be PAX's very next datagram.
        self.dropped("udp.short", "a 4-byte UDP datagram", self.send_raw(G, b"\x9c\x40\x00\x07"))
        self.dropped("udp.length", "a length of 7", self.udp_out(G, A, px.ECHO_PORT, b"length 7", length=7, check=0))
        self.dropped("udp.length", "a length over the datagram's", self.udp_out(G, A, px.ECHO_PORT, b"length 200", length=200, check=0))
        self.dropped("udp.checksum", "a wrong checksum", self.udp_out(G, A, px.ECHO_PORT, b"wrong sum", check=0x1234))
        self.dropped("udp.port-zero", "destination port 0", self.udp_out(G, A, 0, b"port 0"))
        self.echoed(P, 40001, b"fence 1", "the datagram after the malformed (nothing may have been sent before it)")
        print("net-peer: ok U6 five malformed datagrams (4 bytes; a length of 7; a length over the datagram's; a wrong checksum; port 0), none answered")
        # U7: nobody listening.
        time.sleep(1.3)
        first = self.udp_out(P, 40001, px.DISCARD_PORT, b"is anybody there")
        for k in range(4):
            self.udp_out(P, 40001, px.DISCARD_PORT + 1 + k, b"or there")
        self.tally("no-port")
        self.sent["no-port"] += 4
        if self.strict:
            self.expect(px.port_unreachable_for(first, 20, len(first) - 14, self.next_ident, px.PEER_MAC),
                        "PAX's port unreachable for the first of five datagrams to ports nobody holds")
        self.echoed(P, 40001, b"fence 2", "the datagram after them")
        time.sleep(1.3)
        self.udp_out(P, 40001, px.DISCARD_PORT, b"everyone, port 9", dst_ip=px.SUBNET_BCAST, dst_mac=px.BCAST)
        self.udp_out(P, 40001, px.DISCARD_PORT, b"a broadcast frame, port 9", dst_mac=px.BCAST)
        self.sent["no-port"] += 2
        self.echoed(P, 40001, b"fence 3", "the datagram after two that may draw no error")
        self.echoed(G, A, b"quit", "\"quit\"")
        print("net-peer: ok U7 nobody at port 9: 1 destination unreachable (code 3), exact; 4 held back by the limit; 2 to a broadcast address or frame drew none")
        # U9 (after U7 on the wire): a socket nobody reads for a while.
        p, dst, dport, data = self.udp_in(60.0, "udphold's \"ready\"")
        if (p, dst, dport, data) != (px.HOLD_PORT, G, px.HOLD_READY, b"ready"):
            self.fail("U9: not \"ready\" from port %d to 10.0.2.2 port %d: port %d to %s port %d, %r" % (px.HOLD_PORT, px.HOLD_READY, p, px.dotted(dst), dport, data[:40]))
        for i in range(px.HOLD_BURST):
            self.udp_out(G, A, px.HOLD_PORT, px.hold_datagram(i))
        self.sent["udp"] = self.sent.get("udp", 0) + px.HOLD_BURST
        print("net-peer: ok U9 udphold's \"ready\"; %d datagrams of %d bytes sent at once to a socket nobody reads for a second and a half" % (px.HOLD_BURST, px.DATA_MAX))
        # U8: the resolver.
        p, dst, dport, q = self.udp_in(60.0, "resolve's query")
        asked = px.dns_question(q)
        if (dst, dport) != (px.DNS_IP, px.DNS_PORT) or p not in px.EPHEMERAL or asked != (px.DNS_NAME, 1, 1) or not q[2] & 1:
            self.fail("U8: not one A question for %s, recursion desired, from an ephemeral port to 10.0.2.3 port 53: port %d to %s port %d, %r"
                      % (px.DNS_NAME, p, px.dotted(dst), dport, asked), q)
        self.udp_out(px.DNS_IP, px.DNS_PORT, p, px.dns_answer(q), src_mac=px.DNS_MAC)
        self.tally("udp")
        print("net-peer: ok U8 a %d-byte query for %s (A, IN) from port %d to 10.0.2.3, answered %s" % (len(q), px.DNS_NAME, p, px.dotted(px.DNS_ANSWER)))

    # --- TCP (px23): the other end of user/net's stream witnesses --------------
    def tcp_ready(self, st, port, timeout, what):
        """Wait for a witness's "ready" datagram to 10.0.2.2 port `port`."""
        d = st.udp_from(timeout, "%s's \"ready\" to port %d" % (what, port))
        sport, dst, dport, data = d
        if (dst, dport, data) != (px.GW_IP, port, b"ready") or (self.strict and sport not in px.EPHEMERAL):
            self.fail("%s: not \"ready\" from an ephemeral port to 10.0.2.2 port %d: port %d to %s port %d, %r"
                      % (what, port, sport, px.dotted(dst), dport, data[:40]))

    def tcp_ask(self, st, ip, sport, payload, what, faults=None, timeout=60.0, setup=None, check=None, port=px.TCP_ECHO, **kw):
        """A connection from `ip`:`sport` to PAX's echo server: `payload`
        sent, this end's half closed, and the whole answer held to its
        bytes: the payload, then "eof after N bytes, crc X", then PAX's
        FIN. Returns the Conn."""
        c = st.connect(ip, sport, port, faults=faults, **kw)
        if setup:
            setup(c)
        st.established(c, what, timeout)
        c.send(payload)
        c.close()
        st.until(lambda: c.closed(), timeout, what + ": the echo, the last line and PAX's FIN")
        want = payload + b"eof after %d bytes, crc %08x\n" % (len(payload), zlib.crc32(payload))
        got = c.take()
        if c.reset or c.gave_up or got != want:
            at = next((i for i in range(min(len(got), len(want))) if got[i] != want[i]), min(len(got), len(want)))
            self.fail("%s: %s; %d bytes came back, %d were due, the same up to byte %d"
                      % (what, "PAX reset the connection" if c.reset else "this end gave up" if c.gave_up else "not the bytes sent and the line after them",
                         len(got), len(want), at))
        if check:
            check(c)
        return c

    def tcp_profile(self, n):
        """The faults a port's last two digits name (the loss matrix)."""
        if n == 30:
            return dict(loss=0.01, dup=0.05, reorder=0.05, corrupt=0.02)
        return dict(loss=n / 100.0)

    def tcp_script(self, soak, bulk, lossy):
        px.TCP_SPOKEN = True
        st = paxtcp.Stack(self)
        self.tcp = st
        G, P, F = px.GW_IP, px.PEER_IP, px.FAR_IP
        E = px.TCP_ECHO
        strict = self.strict
        state = {"sport": 40000}

        def sport():
            state["sport"] += 1
            if state["sport"] > 64000:
                state["sport"] = 40001
            return state["sport"]

        # This script's servers. An echo server: what comes goes back;
        # after PAX's FIN, one line, then this end's FIN.
        def echo(c, faults=None):
            c.crc, c.count = 0, 0

            def data(c):
                d = c.take()
                c.crc = zlib.crc32(d, c.crc)
                c.count += len(d)
                c.send(d)

            def eof(c):
                if not c.reset:
                    c.send(b"eof after %d bytes, crc %08x\n" % (c.count, c.crc))
                    c.close()
            c.on_data, c.on_eof = data, eof

        # A receiver of the stream pattern: its length and CRC-32 said
        # back after PAX's FIN.
        def sink(c):
            c.keep = True
            c.crc, c.count, c.right = 0, 0, True

            def data(c):
                d = c.take()
                if d != px.stream_pattern(c.count, len(d)):
                    c.right = False
                c.crc = zlib.crc32(d, c.crc)
                c.count += len(d)

            def eof(c):
                if not c.reset:
                    c.send(b"got %d bytes, crc %08x\n" % (c.count, c.crc))
                    c.close()
            c.on_data, c.on_eof = data, eof

        served = []

        def serve(kind, faults_for=None):
            def accept(c):
                (echo if kind == "echo" else sink)(c)
                if faults_for:
                    faults_for(c)
                served.append(c)
            return accept

        def live(port):
            return [c for c in served if c.port == port and c.state != "lost"]

        def one(port):
            """The connection PAX made to this script's `port`, once it is over."""
            st.until(lambda: live(port), 300.0, "PAX's connection to port %d" % port)
            c = live(port)[-1]
            st.until(lambda: c.closed(), 900.0, "PAX's connection to port %d to end" % port)
            return c

        # Every port this script answers on, from the start: a SYN that
        # came before its listener would be refused.
        st.listen(px.TCP_SERVICE, serve("echo"))
        st.listen(px.TCP_BULK, serve("sink"))
        st.listen(px.TCP_LEAVE, serve("sink"))
        st.silent.add(px.TCP_SILENT)
        st.silent.add(px.TCP_WOLF_GATE)

        def resetting(c):
            def data(c):
                c.take()
                c.abort()
            c.on_data = data
            served.append(c)

        def mute(c):
            def opened(c):
                c.mute = True
            c.on_open = opened
            served.append(c)
        st.listen(px.TCP_RESET, resetting)
        st.listen(px.TCP_MUTE, mute)
        st.unreachable[px.TCP_UNREACHABLE] = 3
        st.unreachable[px.TCP_NO_HOST] = 1

        # T1: PAX's echo server, asked from the gateway's address.
        self.tcp_ready(st, px.TCP_SERVICE, self.boot, "tcpecho")
        sizes = (1, 2, 1460, 1461, 4000, 70000)
        for k, n in enumerate(sizes):
            self.tcp_ask(st, G, sport(), px.stream_pattern(k * 1000, n), "a connection of %d bytes" % n)
        print("net-peer: ok T1 \"ready\"; connections of %s bytes echoed, each stream exact, each ended by the server's line and FIN"
              % ", ".join(str(n) for n in sizes))
        # T2: the soak in.
        t0 = time.time()
        for i in range(soak):
            self.tcp_ask(st, G, sport(), px.soak_request(i)[:16], "connection %d of the soak" % i)
            if i % 500 == 499:
                st.forget()
        span = time.time() - t0
        self.tcp_ask(st, G, sport(), b"quit", "\"quit\"")
        print("net-peer: ok T2 %d connections opened, echoed and closed, each exact, in %.2f s (%d a second by this script's clock); \"quit\""
              % (soak, span, soak / span if span > 0 else 0))
        # T3: the forking server, asked from three hosts.
        self.tcp_ready(st, px.TCP_READY_FORK, 120.0, "the forking tcpecho")
        self.tcp_ask(st, G, sport(), b"to a child, from the gateway's address", "a connection from 10.0.2.2")
        self.tcp_ask(st, P, sport(), px.stream_pattern(7, 5000), "a connection from 10.0.2.100")
        self.tcp_ask(st, F, sport(), px.stream_pattern(9, 3000), "a connection from 192.0.2.1 by way of the gateway")
        self.tcp_ask(st, G, sport(), b"quit", "\"quit\"")
        print("net-peer: ok T3 a child a connection: from 10.0.2.2, from 10.0.2.100 and from 192.0.2.1 by way of the gateway, each exact; \"quit\"")
        # T4: PAX's client and this script's echo server.
        c = one(px.TCP_SERVICE)
        if c.reset or c.count != 39799 or c.pax_port not in px.EPHEMERAL:
            self.fail("T4: tcpclient's connection: %d bytes echoed (39799 were due) from port %d%s" % (c.count, c.pax_port, ", reset" if c.reset else ""))
        print("net-peer: ok T4 tcpclient's connection from an ephemeral port: 39799 bytes echoed, its FIN, this end's line and FIN")
        # T5: the bulk out of PAX.
        c = one(px.TCP_BULK)
        if c.reset or c.count != bulk or not c.right:
            self.fail("T5: %d bytes came (%d were due)%s%s" % (c.count, bulk, "" if c.right else ", not the pattern", ", reset" if c.reset else ""))
        span = (c.last_at - c.first_at) if c.first_at and c.last_at and c.last_at > c.first_at else 0
        print("net-peer: ok T5 %d bytes out of PAX, every byte the pattern's, crc %08x, in %.2f s (%d KB/s by this script's clock); PAX retransmitted %d of %d segments"
              % (c.count, c.crc, span, c.count / 1000 / span if span else 0, c.pax_rexmt, c.pax_segments))
        # A writer that closes at once: the bytes it left unsent, and
        # its FIN, come all the same.
        c = one(px.TCP_LEAVE)
        if c.count != px.TCP_LEAVE_BYTES or not c.right or not c.eof:
            self.fail("T5: tcpbulk leave: %d bytes came (%d were due)%s%s"
                      % (c.count, px.TCP_LEAVE_BYTES, "" if c.right else ", not the pattern", "" if c.eof else ", and no FIN"))
        print("net-peer: ok T5 tcpbulk leave: %d bytes written and the socket closed at once: every byte came, then PAX's FIN" % c.count)
        # T6: the bulk into PAX.
        self.tcp_ready(st, px.TCP_READY_BULK, 300.0, "tcpbulk recv")
        self.tcp_bulk_in(st, G, sport(), px.TCP_BULK_IN, bulk, "T6", None)
        # A receiver that reads nothing for a second and a half: its
        # window closes, this end probes it, and it opens again.
        self.tcp_ready(st, px.TCP_READY_BULK, 300.0, "the tcpbulk recv that naps")
        c = self.tcp_bulk_in(st, G, sport(), px.TCP_BULK_NAP, px.TCP_NAP_BYTES, "T6 (the receiver naps)", None)
        if strict and (c.zero_windows == 0 or c.probes == 0):
            self.fail("T6: a receiver that read nothing for 1.5 s advertised a window of zero %d times and was probed %d times" % (c.zero_windows, c.probes))
        print("net-peer: ok T6 a receiver that naps: its window closed (%d segments said zero), this end probed it %d times, it opened and every byte arrived"
              % (c.zero_windows, c.probes))
        # T7: the soak out.
        t0 = time.time()
        base = len(served)
        st.until(lambda: len(served) >= base + soak and all(c.closed() for c in served[-8:]), 60.0 + soak * 0.2, "tcpsoak's %d connections" % soak)
        # tcpsoak closes without reading this server's last line, so
        # that line draws a reset: PAX's FIN is what must have come.
        bad = [c for c in served[base:] if c.count != 16 or not c.eof]
        if bad:
            self.fail("T7: %d of tcpsoak's %d connections did not carry 16 bytes and then PAX's FIN" % (len(bad), soak))
        span = time.time() - t0
        st.forget(0.0)
        del served[:]
        print("net-peer: ok T7 tcpsoak's %d connections, each opened by PAX, echoed and closed, in %.2f s (%d a second by this script's clock)"
              % (soak, span, soak / span if span > 0 else 0))

        # T8: how a connection ends.
        n0 = st.n["strays"]
        st.until(lambda: st.n["strays"] > n0, 60.0, "tcpend's SYN to port 9, where nobody listens")
        st.until(lambda: px.TCP_SILENT in st.held, 60.0, "tcpend's SYN to port 9001, which never answers")
        st.until(lambda: any(c.port == px.TCP_RESET and c.closed() for c in served), 60.0, "tcpend's connection to port 9301, reset after its first bytes")
        st.until(lambda: any(c.port == px.TCP_MUTE and c.pax_rexmt >= 2 for c in served), 60.0, "tcpend's retransmissions to port 9302, which says nothing after the handshake")
        st.until(lambda: st.n.get("icmp-out", 0) >= 1, 60.0, "tcpend's SYN to port 9003, answered with an ICMP port unreachable")
        st.until(lambda: st.n.get("icmp-out", 0) >= 2, 60.0, "tcpend's SYN to port 9004, answered with an ICMP host unreachable")
        print("net-peer: ok T8 a SYN to port 9 reset; a SYN to port 9001 never answered; a connection to port 9301 reset after its first bytes; "
              "one to port 9302 left unanswered after the handshake (PAX retransmitted); a SYN to port 9003 answered with an ICMP port unreachable; "
              "one to port 9004 with an ICMP host unreachable")

        # T9: scripted faults, PAX the client. Each port's fault is for
        # the first connection made to it (a SYN lost makes two).
        fired = set()

        def faulty(port):
            k = port - 9200

            def setup(c):
                if port in fired:
                    return
                fired.add(port)
                fl = c.faults
                if k == 1:
                    fl.drop_in.append(lambda seg: seg.flags & px.SYN)
                elif k == 2:
                    fl.drop_out.append(lambda flags, seq, data: flags & px.SYN)
                elif k == 3:
                    fl.drop_in.append(lambda seg: seg.flags == px.ACK and not seg.data)
                elif k == 4:
                    fl.drop_in.append(lambda seg: len(seg.data) >= 1000)
                elif k == 5:
                    fl.drop_out.append(lambda flags, seq, data: len(data) >= 1000)
                elif k == 6:
                    fl.drop_in.append(lambda seg: seg.flags & px.FIN)
                elif k == 7:
                    fl.drop_out.append(lambda flags, seq, data: flags & px.FIN)
                elif k == 8:
                    fl.dup = 1.0
                elif k == 9:
                    c.intruded = False
                    inner = c.on_data

                    def data(c):
                        inner(c)
                        if c.count >= 5000 and not c.intruded:
                            c.intruded = True
                            # None of these may end or disturb the connection.
                            c.tx(px.RST, paxtcp.sadd(c.snd_max, 200000))                    # a reset far outside the window
                            c.tx(px.RST, paxtcp.sadd(c.snd_max, 10))                        # in the window, not at RCV.NXT
                            c.tx(px.SYN, paxtcp.sadd(c.snd_max, 5))                         # a SYN in the window
                            c.tx(px.ACK, c.snd_max, ack=paxtcp.sadd(c.pax_max or 0, 5000))  # an acknowledgement of bytes never sent
                            c.tx(0, c.snd_max, b"no ACK flag")                              # data with no ACK
                    c.on_data = data
                elif k == 10:
                    fl.reorder = 0.3
                elif k == 11:
                    if strict:
                        # Every option kernel/tcp skips, around the one it reads.
                        c.syn_options = (px.mss_option() + b"\x01\x03\x03\x07" + b"\x04\x02" + b"\x08\x0a" + struct.pack(">II", 12345, 0)
                                         + b"\x22\x02" + b"\xfd\x04\x12\x34" + b"\x01\x00")
                    c.closed_at = None
                    inner = c.on_data

                    def data(c):
                        inner(c)
                        if c.count >= 8000 and c.closed_at is None:
                            c.closed_at = time.time()
                            c.window = 0
                            c.tx(px.ACK, c.snd_max)
                    c.on_data = data
                elif k == 12:
                    fl.corrupt = 0.2
                elif k == 20:
                    c.crossed = True
            return setup

        plan = [(9201, "PAX's first SYN lost"), (9202, "this end's SYN-ACK lost"), (9203, "PAX's handshake ACK lost"),
                (9204, "a data segment from PAX lost"), (9205, "a data segment to PAX lost"), (9206, "PAX's FIN lost"),
                (9207, "this end's FIN lost"), (9208, "every segment to PAX sent twice"),
                (9209, "a reset outside the window, a reset and a SYN inside it, an ACK of bytes never sent, data with no ACK"),
                (9210, "segments to PAX out of order"), (9211, "a SYN-ACK with every option; a window closed for 1.5 s"),
                (9212, "one segment in five to PAX with a bit flipped"), (9220, "SYNs that cross")]
        for port, what in plan:
            st.listen(port, serve("echo", faulty(port)))
        for port, what in plan:
            if port == 9211:
                st.until(lambda: any(c.port == 9211 and getattr(c, "closed_at", None) for c in served), 300.0, "tcpclient to port 9211 to fill this end's window")
                c = live(9211)[-1]
                before = c.pax_segments
                st.idle(1.5)
                probes = c.pax_segments - before
                c.window = 65535
                c.tx(px.ACK, c.snd_max)
                if strict and probes < 1:
                    self.fail("T9: PAX sent nothing in 1.5 s to a window of zero: no probe")
            c = one(port)
            if c.reset or c.gave_up or c.count != 39799:
                self.fail("T9: %s (port %d): %d bytes echoed, 39799 were due%s" % (what, port, c.count, ", reset" if c.reset else ""))
            print("net-peer: ok T9 port %d: %s: 39799 bytes echoed exact; %s; PAX retransmitted %d of %d segments"
                  % (port, what, c.faults.text(), c.pax_rexmt, c.pax_segments))

        # T10: the same with PAX the server; the malformed and the stray.
        self.tcp_ready(st, px.TCP_READY_FAULTS, 120.0, "the tcpecho of the fault battery")
        body = px.stream_pattern(3, 6000)

        def with_faults(what, setup=None, check=None, payload=body, **fk):
            fl = paxtcp.Faults(seed=len(what), **fk)
            c = self.tcp_ask(st, G, sport(), payload, what, faults=fl, setup=setup, check=check)
            print("net-peer: ok T10 %s: %d bytes echoed exact; %s; PAX retransmitted %d of %d segments"
                  % (what, len(payload), fl.text(), c.pax_rexmt, c.pax_segments))
            return c

        def small(c):
            c.mss = 536
            c.syn_options = px.mss_option(536)

        def small_check(c):
            pass
        with_faults("a peer that announces MSS 536", setup=small)
        with_faults("PAX's SYN-ACK lost", setup=lambda c: (c.faults.drop_in.append(lambda seg: seg.flags & px.SYN), setattr(c, "rto", 3.0)))
        with_faults("this end's handshake ACK lost", setup=lambda c: c.faults.drop_out.append(lambda flags, seq, data: flags == px.ACK and not data))
        with_faults("a data segment to PAX lost", setup=lambda c: c.faults.drop_out.append(lambda flags, seq, data: len(data) >= 1000))
        with_faults("a data segment from PAX lost", setup=lambda c: c.faults.drop_in.append(lambda seg: len(seg.data) >= 1000))
        with_faults("this end's FIN lost", setup=lambda c: c.faults.drop_out.append(lambda flags, seq, data: flags & px.FIN))
        with_faults("PAX's FIN lost", setup=lambda c: c.faults.drop_in.append(lambda seg: seg.flags & px.FIN))
        with_faults("every segment to PAX sent twice", dup=1.0)
        with_faults("segments to PAX out of order", reorder=0.3)
        with_faults("one segment in five to PAX with a bit flipped", corrupt=0.2)
        # A reset at RCV.NXT ends the connection: the server's read says so.
        c = st.connect(G, sport(), E)
        st.established(c, "a connection to be reset")
        c.send(b"then a reset")
        st.until(lambda: len(c.inbox) >= 12, 30.0, "the echo before the reset")
        c.abort()
        # A SYN whose SYN-ACK is answered with a reset (this script's
        # answer to a segment for no connection of its own): the
        # half-open connection goes, and no `accept` ever sees it.
        n0 = st.n["strays"]
        st.raw(G, px.tcp(40920, E, 9000, 0, px.SYN, 65535, b"", G, px.PAX_IP, options=px.mss_option()))
        st.until(lambda: st.n["strays"] > n0, 10.0, "PAX's SYN-ACK to a SYN this script then disowns")
        st.idle(0.3)
        # The malformed and the stray. A port nobody holds: 9.
        def seg(sp, dp, seq, ack, flags, data=b"", **kw):
            return px.tcp(sp, dp, seq, ack, flags, 65535, data, G, px.PAX_IP, **kw)
        strays = 0
        for what, cause, s_ in (
                ("12 bytes of a segment", "tcp.short", seg(40900, E, 1, 0, px.SYN)[:12]),
                ("a data offset of 4", "tcp.header", seg(40901, E, 1, 0, px.SYN, doff=4)),
                ("a data offset past the segment", "tcp.header", seg(40902, E, 1, 0, px.SYN, doff=15)),
                ("a wrong checksum", "tcp.checksum", seg(40903, E, 1, 0, px.SYN, check=0x1234)),
                ("a source port of 0", "tcp.port-zero", seg(0, E, 1, 0, px.SYN)),
                ("a destination port of 0", "tcp.port-zero", seg(40904, 0, 1, 0, px.SYN)),
                ("an option of length 0", "tcp.option", seg(40905, E, 1, 0, px.SYN, options=b"\x03\x00\x00\x00")),
                ("an option past the header", "tcp.option", seg(40906, E, 1, 0, px.SYN, options=b"\x08\x0a\x00\x00")),
                ("an MSS option of 3 bytes", "tcp.option", seg(40907, E, 1, 0, px.SYN, options=b"\x02\x03\x05\xb4"))):
            f = st.raw(G, s_)
            self.dropped(cause, what, f)
        f = self.datagram(G, px.tcp(40908, E, 1, 0, px.SYN, 65535, b"", G, px.SUBNET_BCAST), proto=6, dst_ip=px.SUBNET_BCAST, dst_mac=px.BCAST)
        self.send(f)
        self.dropped("tcp.broadcast", "a SYN for 10.0.2.255 in a broadcast frame", f)
        # For nobody: each of the first three draws a reset in RFC 9293 §3.10.7.1's form.
        del st.resets[:]
        st.raw(G, seg(40910, px.TCP_CLOSED, 1000, 0, px.SYN))
        st.raw(G, seg(40911, px.TCP_CLOSED, 2000, 7777, px.ACK, b"abc"))
        st.raw(G, seg(40912, px.TCP_CLOSED, 3000, 0, px.FIN | px.PSH | px.URG, b"xy", urgent=1))
        st.raw(G, seg(40913, px.TCP_CLOSED, 4000, 0, px.RST))
        st.raw(G, seg(40914, E, 5000, 4242, px.ACK))           # an ACK for the listener: a reset
        st.raw(G, seg(40915, E, 6000, 0, px.FIN))               # a bare FIN for the listener: dropped
        if strict:
            st.until(lambda: len(st.resets) >= 4, 10.0, "PAX's four resets for segments nobody takes")
        st.idle(0.5)
        got = sorted((r.dport, r.seq, r.ack, r.flags) for r in st.resets)
        want = sorted([(40910, 0, 1001, px.RST | px.ACK), (40911, 7777, 0, px.RST), (40912, 0, 3003, px.RST | px.ACK), (40914, 4242, 0, px.RST)])
        if strict and got != want:
            self.fail("T10: PAX's resets for segments nobody takes are not RFC 9293 §3.10.7.1's: %r, due %r" % (got, want))
        # A SYN with data: the SYN is taken, its bytes are not.
        c = st.connect(G, sport(), E)
        c.state = "syn-sent"
        c.snd_nxt = c.snd_max = paxtcp.sadd(c.iss, 1)
        c.tx(px.SYN, c.iss, b"early", options=px.mss_option())
        c.timer = time.time() + c.rto
        st.until(lambda: c.state == "established", 30.0, "the handshake of a SYN that carried data")
        if strict and c.rcv_nxt and c.snd_una != paxtcp.sadd(c.iss, 1):
            self.fail("T10: PAX acknowledged the data a SYN carried")
        c.send(b"after a SYN with data")
        c.close()
        st.until(lambda: c.closed(), 30.0, "the connection whose SYN carried data")
        if not c.take().startswith(b"after a SYN with data"):
            self.fail("T10: the connection whose SYN carried data did not echo what followed")
        # Nothing was disturbed: one more, clean; then the last.
        self.tcp_ask(st, P, sport(), px.stream_pattern(11, 2000), "a connection after the malformed and the stray")
        self.tcp_ask(st, G, sport(), b"quit", "\"quit\"")
        print("net-peer: ok T10 a reset at RCV.NXT; a SYN disowned; 10 malformed segments dropped; "
              "resets for a SYN, an ACK, a FIN with PSH and URG and an ACK for the listener, each in RFC 9293's form; "
              "none for a reset or a bare FIN; a SYN with data; then two clean connections")

        # T11: the loss matrix. One generator a port: a SYN lost makes a
        # second connection, and its luck must not be the first's again.
        luck = {}

        def lossy_for(c):
            if c.port not in luck:
                luck[c.port] = paxtcp.Faults(seed=c.port, **self.tcp_profile(c.port % 100))
            c.faults = luck[c.port]
        for port in (9101, 9105, 9120, 9130):
            st.listen(port, serve("sink", lossy_for))
        for port in (9101, 9105, 9120, 9130):
            n = lossy // 4 if port == 9120 else lossy
            c = one(port)
            if c.reset or c.gave_up or c.count != n or not c.right:
                self.fail("T11: port %d: %d bytes came (%d were due)%s%s" % (port, c.count, n, "" if c.right else ", not the pattern", ", reset" if c.reset else ""))
            span = (c.last_at - c.first_at) if c.first_at and c.last_at and c.last_at > c.first_at else 0
            print("net-peer: loss out %s: %d bytes out of PAX exact in %.2f s (%d KB/s); PAX retransmitted %d of %d segments; %s"
                  % (self.tcp_name(port % 100), n, span, n / 1000 / span if span else 0, c.pax_rexmt, c.pax_segments, c.faults.text()))
        for port in (7101, 7105, 7120, 7130):
            n = lossy // 4 if port == 7120 else lossy
            self.tcp_ready(st, px.TCP_READY_BULK, 300.0, "tcpbulk recv on port %d" % port)
            self.tcp_bulk_in(st, G, sport(), port, n, "loss in " + self.tcp_name(port % 100), paxtcp.Faults(seed=port, **self.tcp_profile(port % 100)))
        print("net-peer: ok T11 the loss matrix: four transfers out of PAX and four into it, every one exact")

        # T12: the wolf program.
        said = []

        def wolf_ready(c):
            def data(c):
                said.append(c.take())
            c.on_data = data
            c.on_eof = lambda c: c.close()
        st.listen(px.TCP_WOLF_READY, wolf_ready)
        st.until(lambda: b"".join(said) == b"ready\n", 180.0, "tcpwolfd's \"ready\" on a connection to port 9070")
        c = st.connect(G, sport(), px.TCP_WOLF)
        st.established(c, "a connection to tcpwolfd")
        c.send(b"hello wolf\n")
        st.until(lambda: c.snd_una == c.snd_max, 30.0, "tcpwolfd's listen queue to take the request")
        # Only now is its second connect answered: its accept and its
        # read will find what they ask for.
        st.until(lambda: px.TCP_WOLF_GATE in st.held, 30.0, "tcpwolfd's SYN to port 9071")
        st.open_gate(px.TCP_WOLF_GATE, lambda c: setattr(c, "on_eof", lambda c: c.close()))
        st.until(lambda: c.eof or c.closed(), 60.0, "tcpwolfd's reply and FIN")
        got = c.take()
        c.close()
        st.until(lambda: c.closed(), 30.0, "the end of the connection to tcpwolfd")
        if got != b"the wolf heard: hello wolf\n":
            self.fail("T12: tcpwolfd said %r" % got[:80])
        st.idle(0.5)
        print("net-peer: ok T12 tcpwolfd: \"ready\" on its own connection; its request waited in its listen queue before its second connect was answered; "
              "it said \"the wolf heard: hello wolf\"")
        self.sent["tcp"] = st.n["out"]
        self.sent["tcp.in"] = st.n["in"]

    def tcp_name(self, n):
        return "1% dropped, 5% duplicated, 5% reordered, 2% corrupted" if n == 30 else "%d%%" % n

    def tcp_bulk_in(self, st, ip, sport, port, n, tag, faults):
        """`n` bytes of the stream pattern into PAX's `tcpbulk recv` on
        `port`, its one line back held to the length and the CRC-32."""
        c = st.connect(ip, sport, port, faults=faults)
        st.established(c, "%s: a connection to tcpbulk recv on port %d" % (tag, port), 60.0)
        t0 = time.time()
        off = 0
        while off < n:
            # No more queued than a few windows: this script makes the
            # pattern as it goes.
            if len(c.out) < 200000:
                k = min(n - off, 65536)
                c.send(px.stream_pattern(off, k))
                off += k
            else:
                st.step(0.05)
            if c.closed():
                self.fail("%s: the connection ended after %d of %d bytes (%s)" % (tag, off, n, "reset" if c.reset else "this end gave up"))
        c.close()
        st.until(lambda: c.closed(), 900.0, "%s: the transfer of %d bytes into PAX and its line back" % (tag, n))
        span = time.time() - t0
        want = b"got %d bytes, crc %08x\n" % (n, zlib.crc32(px.stream_pattern(0, n)))
        got = c.take()
        if c.reset or c.gave_up or got != want:
            self.fail("%s: the receiver said %r, %r was due%s" % (tag, got[:80], want, ", reset" if c.reset else ""))
        if faults is None and "naps" in tag:
            return c
        if faults is None:
            print("net-peer: ok %s %d bytes into PAX, its line back \"%s\", in %.2f s (%d KB/s by this script's clock); this end retransmitted %d segments"
                  % (tag, n, want.decode().strip(), span, n / 1000 / span if span else 0, c.rexmt))
        else:
            print("net-peer: %s: %d bytes into PAX exact in %.2f s (%d KB/s); this end retransmitted %d segments; %s"
                  % (tag, n, span, n / 1000 / span if span else 0, c.rexmt, faults.text()))
        return c

    def send_raw(self, src_ip, payload):
        """One datagram of protocol 17 with `payload` as it is."""
        f = self.datagram(src_ip, payload, proto=17)
        self.send(f)
        return f


def main(argv):
    opt = {"listen": None, "qemu": None, "soak": "10000", "boot": "150", "bulk": "16777216", "lossy": "1048576"}
    udp = False
    tcp = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--udp":
            udp = True
            i += 1
        elif a == "--tcp":
            tcp = True
            i += 1
        elif a.startswith("--") and a[2:] in opt and i + 1 < len(argv):
            opt[a[2:]] = argv[i + 1]
            i += 2
        else:
            die("usage: net-peer --listen PORT --qemu PORT [--soak N] [--boot SECONDS] [--udp]")
    if opt["listen"] is None or opt["qemu"] is None:
        die("usage: net-peer --listen PORT --qemu PORT [--soak N] [--boot SECONDS] [--udp]")
    peer = Peer(SocketWire(int(opt["listen"]), int(opt["qemu"])), float(opt["boot"]))
    sys.stdout.reconfigure(line_buffering=True)
    try:
        if tcp:
            peer.tcp_script(int(opt["soak"]), int(opt["bulk"]), int(opt["lossy"]))
        elif udp:
            peer.udp_script(int(opt["soak"]))
        else:
            peer.part_a()
            peer.part_b(int(opt["soak"]))
    except Fail as x:
        print("net-peer: FAIL " + str(x))
        return 1
    sent = " ".join("%s=%d" % kv for kv in sorted(peer.sent.items()))
    print("net-peer: sent %s" % sent)
    print("net-peer: PASS before=%d arp-requests-from-pax=%d last-identification=%d" % (peer.before, peer.arp_out, peer.last_ident))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
