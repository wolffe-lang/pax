#!/usr/bin/env bash
# build-kernel — build a wolf kernel into a bootable ELF (M-KW, kw00 §3e
# steps 2 and 3).
#
#   tools/build-kernel [--release] [--hosted] [--src FILE.lu] OUTDIR
#
# Step 2: `wolf build FILE.lu --target x86_64-unknown-none --emit=obj`
# (FILE defaults to kernel/kmain.lu; `--release` for the LLVM tier),
# which also assembles the `asm` sources of the wolf.pkg beside FILE
# (OUTDIR/NAME.asm-<stem>.o). The wolf objects are OUTDIR/NAME.o, or,
# for a package of several modules on the native tier, one per module:
# OUTDIR/NAME.root.o and OUTDIR/NAME.<module>.o (wolf 0.2.22's driver
# writes `-o K.o` that way when it has more than one object). Then it
# asserts on the wolf objects:
#   - every undefined symbol is the freestanding hook list {wolf_trap,
#     memcpy, memmove, memset, memcmp}, a symbol the asm objects define
#     (their roster: routines, and since kw10 the tables boot/isr.S
#     reserves), a symbol another wolf object defines, or (kw10, wolf's
#     `extern "c" let`) a global boot/start.S defines (the Limine
#     requests) or a symbol boot/kernel.ld assigns (`__pax_*`);
#   - `kmain` is a defined global (T), and nothing defines `main`;
#   - `objdump -d` names no xmm/ymm register and addresses nothing below
#     %rsp (no red zone);
#   - release only: `--emit=llvm-ir` puts `noredzone` and the no-SSE
#     "target-features" on every defined function.
# It reports whether the wolf objects define `wolf_trap` (a kernel whose
# trap hook is wolf, px01) or import it (M-KW's, from assembly).
# A kernel that allocates (px06: `List`, `Map`, interpolation, closures,
# `region`; wolf-lang kw12, spec/04 [abi.target.none.alloc]) calls into
# wolf's freestanding runtime, which wolf writes beside the object as
# OUTDIR/NAME.rt-none.a. Then also:
#   - the wolf objects may import the archive's `__wolf_rt_*` symbols
#     (each one the archive defines), and must define `wolf_alloc` and
#     `wolf_free` (the hook pair, kernel/heap);
#   - the archive, taken whole, imports nothing but wolf_alloc,
#     wolf_free and wolf_trap (it defines the C memory functions
#     itself, weak, and its members' other imports among themselves);
#   - the linked ELF, archive included, names no xmm/ymm register.
# Step 3: assembles boot/start.S (the Limine entry) and links
#   ld.lld -T boot/kernel.ld start.o NAME.asm-*.o <wolf objects> [NAME.rt-none.a] -> OUTDIR/NAME.elf
# (the archive after every kernel object, as kw12 asks).
#
# `--hosted` drops `--target` (M-KW step 7's seen-red variant): the build
# is then a hosted one, which this script expects to FAIL; it exits 0
# only if wolf refused it for want of a `main`.
#
# wolf is $PAX_WOLF (default `wolf` on PATH); the toolchain is the host's
# (nm, objdump, an x86-64 assembler through cc or as, ld.lld or ld).
# Exit 0 and the ELF's path on stdout, 1 on a failed assertion, 2 on a
# usage or tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

tier=native hosted=0 src=$PAX_ROOT/kernel/kmain.lu out=
while [ $# -gt 0 ]; do
    case $1 in
        --release) tier=release; shift ;;
        --hosted)  hosted=1; shift ;;
        --src)     src=$2; shift 2 ;;
        -h|--help) sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option: $1" ;;
        *)         [ -z "$out" ] || die "one OUTDIR only"; out=$1; shift ;;
    esac
done
[ -n "$out" ] || die "usage: build-kernel [--release] [--hosted] [--src FILE.lu] OUTDIR"
[ -f "$src" ] || die "no source: $src"
wolf=${PAX_WOLF:-wolf}
need "$wolf" nm objdump
mkdir -p "$out"
out=$(cd "$out" && pwd)
srcdir=$(cd "$(dirname "$src")" && pwd)
name=$(basename "$src" .lu)
obj=$out/$name.o
asmobjs=() wobjs=()
fail() { printf 'build-kernel: FAIL %s (%s, %s)\n' "$*" "$name" "$tier" >&2; exit 1; }

tierflag=()
[ "$tier" = release ] && tierflag=(--release)
rm -f "$obj" "$out/$name".*.o "$out/$name.rt-none.a"

if [ "$hosted" = 1 ]; then
    rc=0
    (cd "$srcdir" && "$wolf" build "$name.lu" --emit=obj -o "$obj" ${tierflag[@]+"${tierflag[@]}"}) \
        >"$out/$name.hosted.log" 2>&1 || rc=$?
    sed 's/^/  wolf: /' "$out/$name.hosted.log" >&2
    if [ "$rc" = 0 ]; then
        fail "a hosted build (no --target) of a kernel with no main must be refused; it built"
    fi
    # Refused for the right reason: the hosted target wants a `main`.
    grep -q 'no `main` function' "$out/$name.hosted.log" \
        || fail "the hosted build failed (exit $rc), but not for want of a main"
    printf 'build-kernel: ok: the hosted build is refused for want of a main (exit %s, %s)\n' "$rc" "$tier" >&2
    exit 0
fi

# --- step 2: the object --------------------------------------------------
rc=0
(cd "$srcdir" && "$wolf" build "$name.lu" --target x86_64-unknown-none --emit=obj -o "$obj" \
    ${tierflag[@]+"${tierflag[@]}"}) >"$out/$name.build.log" 2>&1 || rc=$?
if [ "$rc" != 0 ]; then
    sed 's/^/  wolf: /' "$out/$name.build.log" >&2
    fail "wolf build --target x86_64-unknown-none --emit=obj exited $rc"
fi
for f in "$out/$name".asm-*.o; do [ -f "$f" ] && asmobjs+=("$f"); done
[ ${#asmobjs[@]} -gt 0 ] || fail "wolf placed no $name.asm-*.o beside the object (the wolf.pkg lists no asm?)"
if [ -f "$obj" ]; then
    wobjs=("$obj")
else
    for f in "$out/$name".*.o; do
        case $f in "$out/$name".asm-*.o) ;; *) [ -f "$f" ] && wobjs+=("$f") ;; esac
    done
fi
[ ${#wobjs[@]} -gt 0 ] || fail "wolf build exited 0 and wrote no object ($obj or $name.<module>.o)"

# The roster: what the asm objects define, as the link sees it.
roster=" $(nm -g --defined-only "${asmobjs[@]}" | awk 'NF == 3 { print $3 }' | sort -u | paste -sd' ' -) "
defined=" $(nm -g --defined-only "${wobjs[@]}" | awk 'NF == 3 { print $3 }' | sort -u | paste -sd' ' -) "
hooks=" wolf_trap memcpy memmove memset memcmp "
# The link's own symbols wolf may name with `extern "c" let` (kw10):
# start.S's globals and the linker script's assignments.
start=$out/start.o
if command -v cc >/dev/null 2>&1; then
    cc -c "$PAX_ROOT/boot/start.S" -o "$start"
else
    need as
    as --64 -o "$start" "$PAX_ROOT/boot/start.S"
fi
linksyms=" $(nm -g --defined-only "$start" | awk 'NF == 3 { print $3 }' | sort -u | paste -sd' ' -) $(sed -n 's/^[[:space:]]*\(__pax_[A-Za-z0-9_]*\)[[:space:]]*=.*/\1/p' "$PAX_ROOT/boot/kernel.ld" | sort -u | paste -sd' ' -) "
# wolf's freestanding runtime (kw12), when the kernel allocates.
rt=$out/$name.rt-none.a rtsyms=" " rtn=0
if [ -f "$rt" ]; then
    rtsyms=" $(nm -g --defined-only "$rt" 2>/dev/null | awk 'NF == 3 { print $3 }' | sort -u | paste -sd' ' -) "
    for s in $(nm -u "$rt" 2>/dev/null | awk 'NF >= 2 && $1 == "U" { print $2 }' | sort -u); do
        case " wolf_alloc wolf_free wolf_trap " in *" $s "*) continue ;; esac
        case $rtsyms in *" $s "*) continue ;; esac # one member's import, another's definition
        fail "the runtime archive imports $s, which it does not define and which is not wolf_alloc, wolf_free or wolf_trap"
    done
    for s in wolf_alloc wolf_free; do
        case $defined in *" $s "*) ;; *) fail "the kernel allocates (wolf wrote $name.rt-none.a) but its objects do not define $s" ;; esac
    done
fi
imports=$(nm -u "${wobjs[@]}" | awk 'NF >= 2 && $1 == "U" { print $2 }' | sort -u)
ext=
for s in $imports; do
    case $defined in *" $s "*) continue ;; esac
    case $s in __wolf_rt_*|wolf_rt_ambient_get|wolf_rt_ambient_set) case $rtsyms in *" $s "*) rtn=$((rtn + 1)); continue ;; esac ;; esac
    case "$hooks$roster$linksyms" in *" $s "*) ext+="$s," ;; *) fail "imports $s, outside the hooks, the asm roster{$roster}, the link's symbols{$linksyms} and the runtime archive" ;; esac
done
nm "${wobjs[@]}" | awk '$2 == "T" && $3 == "kmain" { f = 1 } END { exit !f }' \
    || fail "kmain is not a defined global (T)"
if nm "${wobjs[@]}" | awk '$3 == "main" { f = 1 } END { exit !f }'; then
    fail "the object has a main symbol (the hosted shim)"
fi
trap_by="wolf_trap unreferenced"
case " $(printf '%s ' $imports)" in *" wolf_trap "*) trap_by="wolf_trap imported" ;; esac
case $defined in *" wolf_trap "*) trap_by="wolf_trap defined in wolf" ;; esac
objdump -d --no-show-raw-insn "${wobjs[@]}" > "$out/$name.dis"
if grep -Eq '%[xy]mm[0-9]' "$out/$name.dis"; then
    fail "the code names an xmm/ymm register: $(grep -Em1 '%[xy]mm[0-9]' "$out/$name.dis")"
fi
if grep -Eq -- '-0x[0-9a-f]+\(%rsp\)' "$out/$name.dis"; then
    fail "the code addresses below %rsp (a red zone): $(grep -Em1 -- '-0x[0-9a-f]+\(%rsp\)' "$out/$name.dis")"
fi
if [ "$tier" = release ]; then
    (cd "$srcdir" && "$wolf" build "$name.lu" --target x86_64-unknown-none --release \
        --emit=llvm-ir -o "$out/$name.ll") >"$out/$name.ir.log" 2>&1 \
        || fail "wolf build --release --emit=llvm-ir exited non-zero"
    # Every `define … #N` names attribute group N; each such group must
    # carry noredzone and the no-SSE feature string.
    awk '
        /^define / { if (match($0, /#[0-9]+/)) used[substr($0, RSTART + 1, RLENGTH - 1)] = 1; n++ }
        /^attributes #[0-9]+ = / {
            id = $2; sub(/#/, "", id)
            red[id] = ($0 ~ /noredzone/)
            sse[id] = ($0 ~ /"target-features"="[^"]*-sse2[^"]*"/)
        }
        END {
            if (n == 0) { print "no define"; exit 1 }
            for (g in used) if (!red[g] || !sse[g]) { print "attribute group #" g " lacks noredzone or -sse2"; exit 1 }
        }' "$out/$name.ll" >&2 || fail "the release IR is not kernel code (noredzone, no SSE)"
fi
printf 'build-kernel: ok: step 2 (%s, %s): %d wolf object(s), imports {%s}, %s, kmain T, no main, no xmm/ymm, nothing below %%rsp%s%s\n' \
    "$name" "$tier" ${#wobjs[@]} "${ext%,}" "$trap_by" \
    "$([ "$tier" = release ] && echo ', IR noredzone + no-SSE')" \
    "$([ -f "$rt" ] && echo ", $rtn __wolf_rt_* from $name.rt-none.a, wolf_alloc and wolf_free defined in wolf")" >&2

# --- step 3: the link (start.o was assembled for step 2's import check) ----
elf=$out/$name.elf
rtlink=()
[ -f "$rt" ] && rtlink=("$rt")
if command -v ld.lld >/dev/null 2>&1; then
    ld.lld -nostdlib -static -z max-page-size=0x1000 -T "$PAX_ROOT/boot/kernel.ld" \
        -o "$elf" "$start" "${asmobjs[@]}" "${wobjs[@]}" ${rtlink[@]+"${rtlink[@]}"}
else
    need ld
    ld -m elf_x86_64 -nostdlib -static -z max-page-size=0x1000 -T "$PAX_ROOT/boot/kernel.ld" \
        -o "$elf" "$start" "${asmobjs[@]}" "${wobjs[@]}" ${rtlink[@]+"${rtlink[@]}"}
fi
if [ -f "$rt" ]; then
    objdump -d --no-show-raw-insn "$elf" > "$out/$name.elf.dis"
    if grep -Eq '%[xy]mm[0-9]' "$out/$name.elf.dis"; then
        fail "the linked kernel (runtime archive included) names an xmm/ymm register: $(grep -Em1 '%[xy]mm[0-9]' "$out/$name.elf.dis")"
    fi
    printf 'build-kernel: ok: step 3 (%s, %s): linked with %s.rt-none.a; the whole ELF names no xmm/ymm\n' "$name" "$tier" "$name" >&2
fi
printf '%s\n' "$elf"
