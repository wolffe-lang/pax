#!/usr/bin/env bash
# mklobo — build lobo, the web server in wolf, as a fully static x86-64
# Linux executable, unmodified, from lobo's own tree (px34: its control
# client is tests/mpx4-unix's witness; lobo serving on PAX is px25's).
#
#   tools/mklobo OUTDIR
#
# The tree is user/lobo.pin's commit of wolffe-lang/lobo (public). The
# toolchain is the one THAT tree pins in its wolf-toolchain.toml: the
# wolf release named by its `[wolf] version_line`, whose archive for
# x86_64-unknown-linux-gnu is taken by the digest user/lobo.pin records
# (refused on a mismatch), and wolf-std at the commit `[std] rev` names
# (`WOLF_STD`). lobo is built as its release builds (`wolf build
# --release src/main.lu`), with tools/mkpelt's one difference: wolf
# links through the `cc` first on PATH, and a `cc` that adds `-static`
# is put there, so the binary is a static glibc executable: ET_EXEC, no
# PT_INTERP, checked. `OUTDIR/sums.txt` gets `lobo <sha256> <bytes>`.
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu
# container on kasumi), never on kasumi's CachyOS glibc (px10). The
# release tier needs clang at run time. Exit 0, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mklobo OUTDIR"
out=$1
need git curl tar readelf cc clang
. "$PAX_ROOT/user/lobo.pin"
mkdir -p "$out" "$PAX_CACHE"
out=$(cd "$out" && pwd)

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-lobo.XXXXXX")
trap 'rm -rf "$w"' EXIT

tree() { # repo rev dir
    mkdir -p "$3"
    git -C "$3" init -q
    git -C "$3" fetch -q --depth 1 "$1" "$2" || die "cannot fetch $1 at $2"
    git -C "$3" checkout -q --detach FETCH_HEAD
    [ "$(git -C "$3" rev-parse HEAD)" = "$2" ] || die "$1: HEAD is not $2"
}

tree "$LOBO_REPO" "$LOBO_REV" "$w/lobo"
toml=$w/lobo/wolf-toolchain.toml
key() { # section key
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { on = ($0 == s); next }
        on && $1 == k { v = $0; sub(/^[^=]*= *"?/, "", v); sub(/"? *$/, "", v); print v; exit }' "$toml"
}
wline=$(key wolf version_line)
srepo=$(key std repo)
srev=$(key std rev)
wv=$(printf '%s\n' "$wline" | sed -n -E 's/^wolf ([0-9]+\.[0-9]+\.[0-9]+) .*/\1/p')
wsha=$LOBO_WOLF_SHA256
[ -n "$wv" ] && [ -n "$srepo" ] && [ -n "$srev" ] \
    || die "cannot read wolf's version line and std repo/rev from lobo's wolf-toolchain.toml"
say "lobo $LOBO_REV pins '$wline', wolf-std $srev"

arc=$PAX_CACHE/wolf-$wv-$wsha.tar.gz
if [ ! -f "$arc" ] || [ "$(sha256_of "$arc")" != "$wsha" ]; then
    curl -sSfL --retry 3 -o "$arc.part" \
        "https://github.com/wolffe-lang/wolf-lang/releases/download/v$wv/wolf-$wv-x86_64-unknown-linux-gnu.tar.gz" \
        || die "cannot download wolf $wv"
    mv "$arc.part" "$arc"
fi
[ "$(sha256_of "$arc")" = "$wsha" ] || die "wolf $wv archive: sha256 $(sha256_of "$arc"), user/lobo.pin names $wsha"
mkdir -p "$w/wolf"
tar -xzf "$arc" -C "$w/wolf" --strip-components=1
wolf=$w/wolf/wolf
have=$("$wolf" --version | head -n 1)
[ "$have" = "$wline" ] || die "wolf --version says '$have'; lobo pins '$wline'"
say "$have"

tree "https://github.com/${srepo}" "$srev" "$w/stdrepo"
std=$w/stdrepo/std
[ -d "$std" ] || die "wolf-std $srev has no std/"

mkdir -p "$w/bin"
real=$(command -v cc)
printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" > "$w/bin/cc"
chmod +x "$w/bin/cc"

: > "$out/sums.txt"
(cd "$w/lobo" && PATH="$w/bin:$PATH" WOLF_STD=$std \
    "$wolf" build --release --no-cache src/main.lu -o "$out/lobo") >&2 \
    || die "wolf build of src/main.lu"
readelf -hW "$out/lobo" | grep -Eq 'Type: +EXEC' || die "lobo is not ET_EXEC"
! readelf -lW "$out/lobo" | grep -q INTERP || die "lobo has a PT_INTERP (not static)"
printf '%s %s %s\n' lobo "$(sha256_of "$out/lobo")" "$(wc -c < "$out/lobo" | tr -d ' ')" | tee -a "$out/sums.txt"
"$out/lobo" -v 2>&1 | head -n 1 >&2 || true
