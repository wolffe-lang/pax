#!/usr/bin/env bash
# mkalpha — build alpha, the service manager in wolf (wolffe-lang/alpha), as
# one fully static x86-64 Linux executable, `alpha`, unmodified, from
# alpha's own tree, through alpha's own tools/build --static.
#
#   tools/mkalpha OUTDIR
#
# The tree is user/alpha.pin's commit of wolffe-lang/alpha (public),
# fetched from PAX_ALPHA_REPO when it is set (a local clone or cache that
# holds the commit) and from ALPHA_REPO otherwise, through
# tools/fetch-retry; HEAD is refused unless it is ALPHA_REV. Nothing of
# alpha's tree is kept: the build directory is removed at the end.
#
# The toolchain is the one THAT tree pins in its wolf-toolchain.toml: the
# whole wolf and lupin release archives for x86_64-unknown-linux-gnu, each
# sha256 read twice and refused unless both reads are the pin's, each
# `--version` first line refused unless it is the pin's version_line, and
# the runtime (`libwolf_rt.a`) beside wolf, as the archive lays it out
# (alpha's own tools refuse a toolchain any other way). The std is the
# pin's `[std] rev`: the archive's own when it bundles that commit, else
# fetched at it, its tree refused unless it is the pin's `[std] tree`.
# The archives are cached in PAX_CACHE by digest.
#
# alpha's tools/build --static builds alpha at the native tier with
# warnings denied, linked through a `cc` that adds -static. It runs once
# in each of two checkouts at paths of their own, each with its own
# TMPDIR, HOME and cache, and each output is checked static here
# (readelf: ELF64, x86-64, ET_EXEC, no PT_INTERP, no dynamic section; strip
# changes none of these) and stripped: `strip --strip-all`, with the
# build-id note, which the linker computes over the unstripped file,
# removed as well, so the bytes kept depend on the commit and the
# toolchain alone. Both checkouts' digests
# are printed, unstripped and stripped, and the two stripped binaries
# must agree (exit 1 otherwise). The one kept is asked `--version`,
# which must be one line `alpha X.Y.Z`. OUTDIR gets `alpha`, `sums.txt`
# (`alpha <sha256> <bytes>`) and `version.txt` (that line, which
# tests/mpx6-services holds PAX's to).
#
# Build on a baseline x86-64 glibc whose C library has a static archive
# (the CI runner's Ubuntu with libc6-dev; an Ubuntu 24.04 container),
# never on a newer host glibc. Exit 0, 1 when the two builds differ, or 2
# on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkalpha OUTDIR"
[ "$(uname -s):$(uname -m)" = Linux:x86_64 ] || die "mkalpha needs Linux x86-64 (this is $(uname -s) $(uname -m))"
need git curl tar readelf strip cc
pin=$PAX_ROOT/user/alpha.pin
. "$pin"
[ -n "${ALPHA_REPO:-}" ] && printf '%s' "${ALPHA_REV:-}" | grep -Eq '^[0-9a-f]{40}$' \
    || die "$pin must set ALPHA_REPO and ALPHA_REV (a full 40-hex sha, never a branch)"
mkdir -p "$1" "$PAX_CACHE"
out=$(cd "$1" && pwd)

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-alpha.XXXXXX")
trap 'rm -rf "$w"' EXIT

tree() { # repo rev dir
    mkdir -p "$3"
    git -C "$3" init -q
    "$PAX_ROOT/tools/fetch-retry" "$3" "$1" "$2" "$2" || die "cannot fetch $1 at $2"
    git -C "$3" checkout -q --detach FETCH_HEAD
    [ "$(git -C "$3" rev-parse HEAD)" = "$2" ] || die "$1: HEAD is not $2"
}

tree "${PAX_ALPHA_REPO:-$ALPHA_REPO}" "$ALPHA_REV" "$w/a/alpha"
toml=$w/a/alpha/wolf-toolchain.toml
key() { # section key
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { on = ($0 == s); next }
        on && $1 == k { v = $0; sub(/^[^=]*= *"?/, "", v); sub(/"? *$/, "", v); print v; exit }' "$toml"
}
wv=$(key wolf version); wsha=$(key wolf x86_64-unknown-linux-gnu); wline=$(key wolf version_line)
lv=$(key lupin version); lsha=$(key lupin x86_64-unknown-linux-gnu); lline=$(key lupin version_line)
srepo=$(key std repo); srev=$(key std rev); stree=$(key std tree)
for value in "$wv" "$wsha" "$wline" "$lv" "$lsha" "$lline" "$srepo" "$srev"; do
    [ -n "$value" ] || die "cannot read the wolf, lupin and std pins from alpha's wolf-toolchain.toml"
done
for digest in "$wsha" "$lsha"; do
    printf '%s' "$digest" | grep -Eq '^[0-9a-f]{64}$' || die "alpha's wolf-toolchain.toml: $digest is no sha256"
done
printf '%s' "$srev" | grep -Eq '^[0-9a-f]{40}$' || die "alpha's wolf-toolchain.toml: std rev $srev is no full sha"
say "alpha $ALPHA_REV pins wolf $wv (${wsha:0:8}…), lupin $lv (${lsha:0:8}…), wolf-std $srev"

archive() { # name version digest repository -> the cached archive, its digest read twice
    local arc=$PAX_CACHE/$1-$2-x86_64-unknown-linux-gnu-$3.tar.gz k have
    if [ ! -f "$arc" ] || [ "$(sha256_of "$arc")" != "$3" ]; then
        curl -sSfL --retry 3 -o "$arc.part" \
            "https://github.com/wolffe-lang/$4/releases/download/v$2/$1-$2-x86_64-unknown-linux-gnu.tar.gz" \
            || die "cannot download $1 $2"
        mv "$arc.part" "$arc"
    fi
    for k in 1 2; do
        have=$(sha256_of "$arc")
        [ "$have" = "$3" ] || die "$1 $2 archive, read $k: sha256 $have, alpha pins $3"
    done
    say "$1 $2 archive: sha256 $3, read twice"
    printf '%s\n' "$arc"
}
arc=$(archive wolf "$wv" "$wsha" wolf-lang)
mkdir -p "$w/wolf"
tar -xzf "$arc" -C "$w/wolf" --strip-components=1
wolf=$w/wolf/wolf
[ -x "$wolf" ] || die "the wolf $wv archive has no wolf"
[ -f "$w/wolf/libwolf_rt.a" ] || die "the wolf $wv archive has no libwolf_rt.a beside wolf"
have=$("$wolf" --version | head -n 1)
[ "$have" = "$wline" ] || die "wolf --version says '$have'; alpha pins '$wline'"
arc=$(archive lupin "$lv" "$lsha" wolf-interp)
mkdir -p "$w/lupin"
tar -xzf "$arc" -C "$w/lupin" --strip-components=1
lupin=$w/lupin/lupin
[ -x "$lupin" ] || die "the lupin $lv archive has no lupin"
have=$("$lupin" --version | head -n 1)
[ "$have" = "$lline" ] || die "lupin --version says '$have'; alpha pins '$lline'"
std=$w/wolf/std
bundled=$(tr -d '[:space:]' < "$std/STD-REV" 2>/dev/null || true)
if [ "$bundled" = "$srev" ]; then
    say "the std the wolf archive bundles, $srev, is the pin's"
else
    tree "https://github.com/$srepo" "$srev" "$w/std-src"
    if [ -n "$stree" ]; then
        have=$(git -C "$w/std-src" rev-parse 'HEAD^{tree}')
        [ "$have" = "$stree" ] || die "wolf-std $srev has tree $have; alpha pins $stree"
    fi
    mkdir -p "$w/std-tree"
    git -C "$w/std-src" archive HEAD std | tar -x -C "$w/std-tree"
    std=$w/std-tree/std
    printf '%s\n' "$srev" > "$std/STD-REV"
    say "wolf-std $srev fetched${stree:+, tree $stree}, in place of the archive's ${bundled:-none}"
fi

static() { # file
    readelf -hW "$1" | grep -Eq 'Class: +ELF64' || die "$1 is not ELF64"
    readelf -hW "$1" | grep -Eq 'Machine: +Advanced Micro Devices X86-64' || die "$1 is not x86-64"
    readelf -hW "$1" | grep -Eq 'Type: +EXEC' || die "$1 is not ET_EXEC"
    ! readelf -lW "$1" | grep -q INTERP || die "$1 has a PT_INTERP (not static)"
    readelf -dW "$1" | grep -q 'There is no dynamic section' || die "$1 has a dynamic section"
}

# alpha's own builder in two checkouts of its own; the second is fetched
# from the first (the pinned commit either way, checked).
tree "$w/a/alpha" "$ALPHA_REV" "$w/b/alpha"
failed() { cat "$w/$1.log" >&2; die "alpha's tools/build (checkout $1) failed"; }
for k in a b; do
    (cd "$w/$k/alpha" && env -u ALPHA_STATIC_IMAGE WOLF_BIN="$wolf" LUPIN_BIN="$lupin" WOLF_STD="$std" \
        TMPDIR="$w/$k" HOME="$w/$k" XDG_CACHE_HOME="$w/$k/cache" sh tools/build --native) > "$w/$k.log" 2>&1 || failed "$k"
    built=$w/$k/alpha/target/native/alpha
    cat "$w/$k.log" >&2
    strip --strip-all --remove-section=.note.gnu.build-id -o "$w/$k/alpha.bin" "$built"
    say "checkout $k: unstripped $(sha256_of "$built") $(wc -c < "$built" | tr -d ' '), stripped $(sha256_of "$w/$k/alpha.bin") $(wc -c < "$w/$k/alpha.bin" | tr -d ' ')"
done
one=$(sha256_of "$w/a/alpha.bin")
two=$(sha256_of "$w/b/alpha.bin")
if [ "$one" != "$two" ]; then
    say "REFUSED: the two checkouts' alpha differ: $one, then $two"
    exit 1
fi
bin=$out/alpha
cp "$w/a/alpha.bin" "$bin"
chmod 755 "$bin"
v=$("$bin" --version 2>&1) || die "alpha --version"
printf '%s\n' "$v" | grep -Eqx 'alpha [0-9]+\.[0-9]+\.[0-9]+' || die "alpha --version says '$v'"
printf '%s\n' "$v" > "$out/version.txt"
printf 'alpha %s %s\n' "$one" "$(wc -c < "$bin" | tr -d ' ')" | tee "$out/sums.txt"
printf 'alpha built twice (two checkouts), one digest; %s; linked against: %s\n' "$v" "$(cc -print-file-name=libc.a)"
