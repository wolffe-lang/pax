def die(msg):
    sys.stderr.write("screen-ref: %s\n" % msg)
    sys.exit(2)


def read_bdf(path):
    glyphs = {}
    enc = rows = None
    with open(path, "rb") as f:
        for raw in f:
            line = raw.decode("ascii").strip()
            if line.startswith("ENCODING "):
                enc = int(line.split()[1])
            elif line == "BITMAP":
                rows = []
            elif line == "ENDCHAR":
                if enc is not None and rows is not None:
                    glyphs[enc] = rows
                enc = rows = None
            elif rows is not None:
                rows.append(int(line, 16))
    return glyphs


def read_extent(path):
    """font/extent.txt: (code point, source) for each code point above
    U+00FF the screen draws (gm01). Read here again, not tools/mkfont's."""
    out = {}
    with open(path, "r", encoding="ascii") as f:
        for raw in f:
            line = raw.split("#", 1)[0].split()
            if not line:
                continue
            span = line[0].split("-")
            first, last = int(span[0][2:], 16), int(span[-1][2:], 16)
            for cp in range(first, last + 1):
                out[cp] = line[1]
    return out


def font_glyphs(font=None, latin1=False):
    """The glyphs the screen draws, by code point: the BDF's below 256
    (font/spleen-8x16.bdf unless `font` names another), and, unless
    `latin1`, the extent's above."""
    import os
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "font")
    spleen = read_bdf(font or os.path.join(here, "spleen-8x16.bdf"))
    glyphs = {cp: g for cp, g in spleen.items() if cp < 256}
    if not latin1:
        extra = read_bdf(os.path.join(here, "pax-extra.bdf"))
        for cp, src in read_extent(os.path.join(here, "extent.txt")).items():
            g = (extra if src == "pax" else spleen).get(cp)
            if g is not None:
                glyphs[cp] = g
    return glyphs


_DRAWN = []


def default_drawn():
    """The extent's code points (font_glyphs' above U+00FF), read once."""
    if not _DRAWN:
        _DRAWN.append(frozenset(c for c in font_glyphs() if c >= 256))
    return _DRAWN[0]


def truecolour(red, green, blue, background=False):
    # Inferred from the VT, checked against 19683 RGB samples twice.
    r, g, b = red & 255, green & 255, blue & 255
    if background:
        return int(r >= 128) | (int(g >= 128) << 1) | (int(b >= 128) << 2)
    high = max(r, g, b)
    c = int(r > high // 2) | (int(g > high // 2) << 1) | (int(b > high // 2) << 2)
    return 8 if c == 7 and high <= 85 else c | (8 if high > 170 else 0)


class Term:
    def __init__(self, cols, rows, drawn=None):
        self.cols, self.rows = cols, rows
        # gm01: the code points above U+00FF the screen draws; any other
        # is kept as `?` (63), as kernel/screen keeps it.
        self.drawn = default_drawn() if drawn is None else drawn
        self.top, self.end = 0, rows
        self.cells = [[(32, 7, 0)] * cols for _ in range(rows)]
        self.cx = self.cy = 0
        self.wrap = False
        self.fg, self.bg, self.bold, self.inv = 7, 0, 0, False
        self.italic = self.underline = self.blink = False
        self.esc = 0
        self.params = [0] * 16
        self.pi = 0
        self.priv = False
        self.un = 0
        self.ucp = 0
        self.scrolls = 0
        self.saved = (0,0,7,0,0,False,False,False,False)
        self.primary = None
        self.main_cursor = None
        self.visible = True  # DECTCEM
        self.shape = 0  # DECSCUSR's last parameter, recorded (PAX draws a block)
        self.answers = bytearray()  # what the screen answers queries with (DA1, DSR)
        self.osc_left = 0
        self.osc_digits = bytearray()
        self.palette = list(PALETTE)

    def blank(self):
        """A space in the current rendition (ED, EL, a scrolled-in row)."""
        f = 2 if self.italic else 6 if self.underline else 8 if self.bold == 2 else self.fg
        b = self.bg
        if self.inv:
            f, b = (b & 7) | (f & 8), (f & 7) | (b & 8)
        if self.bold == 1:
            f |= 8
        # Bit 4 of the background records the not-yet blinking attribute.
        return (32, f, b | (16 if self.blink else 0))

    def newline(self):
        if self.cy + 1 == self.end:
            self.cells[self.top:self.end] = self.cells[self.top+1:self.end] + [[self.blank()] * self.cols]
            self.scrolls += 1
        elif self.cy + 1 < self.rows:
            self.cy += 1

    def glyph(self, cp):
        if self.wrap:
            self.wrap = False
            self.cx = 0
            self.newline()
        _, f, b = self.blank()
        row = list(self.cells[self.cy])
        row[self.cx] = (cp, f, b)
        self.cells[self.cy] = row
        if self.cx + 1 == self.cols:
            self.wrap = True
        else:
            self.cx += 1

    def control(self, b):
        if b == 10:
            self.wrap = False
            self.newline()
        elif b == 13:
            self.wrap = False
            self.cx = 0
        elif b == 8:
            self.wrap = False
            if self.cx > 0:
                self.cx -= 1
        elif b == 9:
            self.wrap = False
            self.cx = min((self.cx // 8 + 1) * 8, self.cols - 1)

    def sgr(self, ps):
        k = 0
        while k < len(ps):
            p = ps[k]
            k += 1
            if p == 0:
                self.fg, self.bg, self.bold, self.inv = 7, 0, 0, False
                self.italic = self.underline = self.blink = False
            elif p == 1:
                self.bold = 1
            elif p == 2:
                self.bold = 2
            elif p == 22:
                self.bold = 0
            elif p == 3:
                self.italic = True
            elif p == 23:
                self.italic = False
            elif p in (4, 21):
                self.underline = True
            elif p == 24:
                self.underline = False
            elif p == 5:
                self.blink = True
            elif p == 25:
                self.blink = False
            elif p == 27:
                self.inv = False
            elif p == 7:
                self.inv = True
            elif p in (38, 48):
                if k+1 < len(ps) and ps[k] == 5:
                    if ps[k+1] < 256:
                        if p == 38: self.fg = INDEXED_FG[ps[k+1]]
                        else: self.bg = INDEXED_BG[ps[k+1]]
                    k += 2
                elif k < len(ps) and ps[k] == 2:
                    if k + 3 < len(ps):
                        c = truecolour(*ps[k+1:k+4], background=p == 48)
                        if p == 38: self.fg, self.bold = c & 7, c >> 3
                        else: self.bg = c
                    k += 4
                else: break
            elif 100 <= p <= 107:
                self.bg = p-100+8
            elif 30 <= p <= 37:
                self.fg = p - 30
            elif p == 39:
                self.fg = 7
            elif 40 <= p <= 47:
                self.bg = p - 40
            elif p == 49:
                self.bg = 0
            elif 90 <= p <= 97:
                self.fg = p - 90 + 8

    def dispatch(self, final):
        ps = self.params[:self.pi + 1]
        n = ps[0] or 1
        x, y = self.cx, self.cy
        if final == ord('m'):
            self.sgr(ps)
            return
        if final in (ord('@'), ord('P'), ord('X')):
            n = min(n, self.cols-x)
            row = list(self.cells[y])
            if final == ord('@'): row[x:] = [self.blank()]*n + row[x:self.cols-n]
            elif final == ord('P'): row[x:] = row[x+n:] + [self.blank()]*n
            else: row[x:x+n] = [self.blank()]*n
            self.cells[y] = row
            self.wrap = False
            return
        if final in (ord('L'), ord('M')):
            if y+1 >= self.end: return
            n = min(n, self.end-y-1)
            blank = [[self.blank()]*self.cols for _ in range(n)]
            region = self.cells[y:self.end]
            self.cells[y:self.end] = blank + region[:-n] if final == ord('L') else region[n:] + blank
            self.wrap = False
            return
        if final == ord('r'):
            end = self.params[1] or self.rows
            if n < end <= self.rows:
                self.top, self.end = n-1, end
                self.cx = self.cy = 0
                self.wrap = False
            return
        if final in (ord('J'), ord('K')):
            mode = ps[0]
            if mode not in (0, 1, 2): return
            c = self.blank()
            pos = y*self.cols+x
            start = 0 if final == ord('J') else y*self.cols
            end = self.rows*self.cols if final == ord('J') else (y+1)*self.cols
            if mode == 0: start = pos
            if mode == 1: end = pos+1
            for i in range(start, end):
                row = list(self.cells[i//self.cols]); row[i%self.cols] = c; self.cells[i//self.cols] = row
            self.wrap = False
            return
        if final == ord('c') and ps == [0]:
            self.answers += b"\x1b[?6c"
            return
        if final == ord('n') and len(ps) == 1 and ps[0] in (5, 6):
            self.answers += b"\x1b[0n" if ps[0] == 5 else b"\x1b[%d;%dR" % (self.cy + 1, self.cx + 1)
            return
        if final in (ord('H'), ord('f')):
            y, x = n - 1, (self.params[1] or 1) - 1
        elif final == ord('A'): y -= n
        elif final == ord('B'): y += n
        elif final == ord('C'): x += n
        elif final == ord('D'): x -= n
        elif final in (ord('G'), ord('`')): x = n - 1
        elif final == ord('d'): y = n - 1
        elif final == ord('E'): x, y = 0, y + n
        elif final == ord('F'): x, y = 0, y - n
        else: return
        self.cx, self.cy = min(max(x, 0), self.cols-1), min(max(y, 0), self.rows-1)
        self.wrap = False

    def private_mode(self, b):
        if b == ord('n') and self.pi == 0 and self.params[0] == 6:
            self.answers += b"\x1b[%d;%dR" % (self.cy + 1, self.cx + 1)
            return
        if b not in (104,108): return
        for p in self.params[:self.pi+1]:
            if p == 25:
                self.visible = b == 104
            if p == 1049:
                if b == 104 and self.primary is None:
                    self.primary = self.cells
                    self.main_cursor = (self.cx,self.cy,self.fg,self.bg,self.bold,self.inv,self.italic,self.underline,self.blink)
                    self.cells = [[self.blank()]*self.cols for _ in range(self.rows)]
                    self.wrap = False
                elif b == 108 and self.primary is not None:
                    self.cells, self.primary = self.primary, None
                    self.cx,self.cy,self.fg,self.bg,self.bold,self.inv,self.italic,self.underline,self.blink = self.main_cursor
                    self.wrap = False

    def feed(self, b):
        # OSC (ESC ]): 3 its first byte, 4 OSC P's seven digits, 5 the
        # string, ended by BEL or by any ESC, whose next byte is then read
        # as an escape's second (ST's backslash among them).
        if self.esc == 3:
            if b == 0x50:
                self.esc, self.osc_left = 4, 7
                self.osc_digits = bytearray()
                return
            if b == 0x52:
                self.esc = 0
                self.palette = list(PALETTE)
                return
            self.esc = 5
        if self.esc == 4:
            self.osc_digits.append(b)
            self.osc_left -= 1
            if self.osc_left == 0:
                self.esc = 0
                if all(c in b'0123456789abcdefABCDEF' for c in self.osc_digits):
                    value = int(self.osc_digits,16)
                    self.palette[value >> 24] = value & 0xffffff
            return
        if self.esc == 5:
            if b == 7:
                self.esc = 0
            elif b == 27:
                self.esc = 1
            return
        if b < 32 or b == 127:
            if self.un:
                self.un = 0
                self.glyph(63)
            if b == 27:
                self.esc = 1
                return
            self.esc = 0
            self.control(b)
            return
        if self.esc == 1:
            if b == 0x5B:
                self.esc = 2
                self.params = [0] * 16
                self.pi = 0
                self.priv = False
            elif b in (55,56):
                self.esc = 0
                if b == 55: self.saved = (self.cx,self.cy,self.fg,self.bg,self.bold,self.inv,self.italic,self.underline,self.blink)
                else:
                    self.cx,self.cy,self.fg,self.bg,self.bold,self.inv,self.italic,self.underline,self.blink = self.saved
                    self.wrap = False
            elif b == 93:
                self.esc = 3
            elif b == 0x5A:
                self.esc = 0
                self.answers += b"\x1b[?6c"  # DECID
            else:
                self.esc = 0
            return
        if self.esc == 2:
            if 0x30 <= b <= 0x39:
                self.params[self.pi] = min(self.params[self.pi] * 10 + b - 0x30, 9999)
            elif b in (0x3B, 0x3A):
                if self.pi < 15:
                    self.pi += 1
                else:
                    self.priv = True
            elif b == 63 and not self.priv and self.pi == 0 and self.params[0] == 0:
                self.priv = 63
            elif b == 0x20 and not self.priv:
                self.priv = 32
            elif 0x3C <= b <= 0x3F or 0x20 <= b <= 0x2F:
                self.priv = 1
            elif 0x40 <= b <= 0x7E:
                self.esc = 0
                if not self.priv:
                    self.dispatch(b)
                elif self.priv == 63:
                    self.private_mode(b)
                elif self.priv == 32 and b == ord('q') and self.pi == 0 and self.params[0] <= 6:
                    self.shape = self.params[0]
            else:
                self.esc = 0
            return
        if self.un:
            if b & 0xC0 == 0x80:
                self.ucp = (self.ucp << 6) | (b & 0x3F)
                self.un -= 1
                if self.un == 0:
                    self.glyph(self.ucp if self.ucp < 256 or self.ucp in self.drawn else 63)
                return
            self.un = 0
            self.glyph(63)
        if b < 0x80:
            self.glyph(b)
        elif b & 0xE0 == 0xC0:
            self.un, self.ucp = 1, b & 0x1F
        elif b & 0xF0 == 0xE0:
            self.un, self.ucp = 2, b & 0x0F
        elif b & 0xF8 == 0xF0:
            self.un, self.ucp = 3, b & 0x07
        else:
            self.glyph(63)


def render(term, glyphs, w, h):
    px = bytearray(w * h * 3)  # black
    q = glyphs[63]
    for y in range(term.rows):
        for x in range(term.cols):
            cp, f, b = term.cells[y][x]
            b &= 15  # blink recorded, drawn steady: needs the timer hook, px71
            if term.visible and y == term.cy and x == term.cx:
                f, b = b, f
            bits = glyphs.get(cp, q)
            fr = term.palette[f].to_bytes(3, "big")
            br = term.palette[b].to_bytes(3, "big")
            for r in range(16):
                o = ((y * 16 + r) * w + x * 8) * 3
                row = bits[r]
                for k in range(8):
                    px[o + k * 3: o + k * 3 + 3] = fr if row & (0x80 >> k) else br
    return px


def read_ppm(path):
    with open(path, "rb") as f:
        data = f.read()
    fields = []
    i = 0
    while len(fields) < 4:
        while data[i:i + 1].isspace():
            i += 1
        if data[i:i + 1] == b"#":
            while data[i:i + 1] != b"\n":
                i += 1
            continue
        j = i
        while not data[j:j + 1].isspace():
            j += 1
        fields.append(data[i:j])
        i = j
    i += 1
    if fields[0] != b"P6" or fields[3] != b"255":
        die("%s is not a P6 PPM with maxval 255" % path)
    w, h = int(fields[1]), int(fields[2])
    return w, h, data[i:i + w * h * 3]


def main():
    args = sys.argv[1:]
    opts = {"--font": None, "--from": None, "--size": None, "--out": None, "--compare": None, "--grid": None,
            "--upto": None}
    log = None
    latin1 = False
    while args:
        a = args.pop(0)
        if a == "--latin1":
            latin1 = True
        elif a in opts:
            if not args:
                die("%s takes a value" % a)
            opts[a] = args.pop(0)
        elif a.startswith("-"):
            die("unknown option %s" % a)
        elif log is None:
            log = a
        else:
            die("one serial log only")
    if log is None or opts["--from"] is None or opts["--size"] is None:
        die("usage: screen-ref --from TEXT --size WxH [--upto N] [--font BDF] [--latin1] [--out REF.ppm] [--compare DUMP.ppm] [--grid GRID.txt] SERIAL.log")
    try:
        w, h = (int(v) for v in opts["--size"].split("x"))
    except ValueError:
        die("--size takes WxH")
    glyphs = font_glyphs(opts["--font"], latin1)
    try:
        with open(log, "rb") as f:
            data = f.read()
    except OSError as e:
        die(str(e))
    if opts["--upto"] is not None:
        try:
            data = data[:int(opts["--upto"])]
        except ValueError:
            die("--upto takes a byte count")
    at = data.find(opts["--from"].encode())
    if at < 0:
        die("%r is not in %s" % (opts["--from"], log))
    term = Term(min(w // 8, 256), min(h // 16, 128), set(c for c in glyphs if c >= 256))
    for b in data[at:]:
        term.feed(b)
    px = render(term, glyphs, w, h)
    if opts["--out"]:
        with open(opts["--out"], "wb") as f:
            f.write(b"P6\n%d %d\n255\n" % (w, h))
            f.write(px)
    if opts["--grid"]:
        with open(opts["--grid"], "w", encoding="utf-8") as f:
            for row in term.cells:
                f.write("".join(chr(c[0]) if c[0] >= 32 else "?" for c in row) + "\n")
            f.write("cursor %d %d %s shape %d, %d scrolls, %d bytes\n" % (term.cy, term.cx, "shown" if term.visible else "hidden",
                                                                       term.shape, term.scrolls, len(data) - at))
    print("screen-ref: %s from byte %d: %d bytes, %dx%d cells, %d scrolls, cursor row %d column %d"
          % (log, at, len(data) - at, term.cols, term.rows, term.scrolls, term.cy, term.cx))
    if opts["--compare"]:
        dw, dh, dump = read_ppm(opts["--compare"])
        if (dw, dh) != (w, h):
            sys.stderr.write("screen-ref: DIFFERENT: the dump is %dx%d, the reference %dx%d\n" % (dw, dh, w, h))
            sys.exit(1)
        ncells = term.cols * term.rows
        if dump == bytes(px):
            print("screen-ref: IDENTICAL: %s equals the reference, %d pixels, %d of %d cells"
                  % (opts["--compare"], w * h, ncells, ncells))
            sys.exit(0)
        n = 0
        first = None
        for i in range(0, len(px), 3):
            if px[i:i + 3] != dump[i:i + 3]:
                n += 1
                if first is None:
                    first = i // 3
        bad = 0
        for r in range(term.rows):
            for c in range(term.cols):
                for y in range(16):
                    o = ((r * 16 + y) * w + c * 8) * 3
                    if px[o:o + 24] != dump[o:o + 24]:
                        bad += 1
                        break
        fy, fx = divmod(first, w)
        cy, cx = fy // 16, fx // 8
        sys.stderr.write("screen-ref: DIFFERENT: %d of %d pixels differ, %d of %d cells; the first at (%d, %d), cell row %d column %d (%r)\n"
                         % (n, w * h, bad, ncells, fx, fy, cy, cx, chr(term.cells[cy][cx][0]) if cy < term.rows and cx < term.cols else "outside the grid"))
        sys.exit(1)


if __name__ == "__main__":
    main()
