#!/usr/bin/env python3
# screen-ref — the host-side reference renderer for PAX's screen (px19):
# draw, from a serial log, the picture kernel/screen should be showing,
# and compare it with a screendump.
#
#   tools/screen-ref --from TEXT --size WxH [--upto N] [--font BDF]
#                    [--latin1] [--out REF.ppm] [--compare DUMP.ppm]
#                    [--grid GRID.txt] SERIAL.log
#
# The serial console and the screen are fed the same bytes (kernel/serial
# hands every byte to kernel/screen), so the screen's picture is a
# function of the serial log: this script reads the log from the first
# occurrence of TEXT (the kernel's first line; what the firmware wrote
# before it never reached the screen) to its end, runs the bytes through
# a terminal written here from kernel/screen's rules — not from its
# code — and draws the grid with the font read straight from the BDF
# (font/spleen-8x16.bdf by default; not boot/font.S), and (gm01) the
# code points above U+00FF that font/extent.txt names from the BDF its
# line names: Spleen's own glyph for `spleen` and for `generated` (which
# tools/mkfont holds equal to Spleen's), font/pax-extra.bdf's for `pax`;
# --latin1 draws none of them (the font row withheld, as tools/mkfont
# --latin1 builds the table). The rules, as kernel/screen's header
# states them:
#
#   - a W x H framebuffer, black; a grid of min(W/8, 256) columns by
#     min(H/16, 128) rows of 8x16 cells, top left;
#   - printable ASCII and UTF-8 code points one cell each; below 256 the
#     font's glyph, or `?`'s when the font has none; at or above 256 the
#     extent's glyph (gm01), any other code point, a malformed
#     sequence's byte, a stray continuation byte and 0xf8-0xff as `?`; a
#     sequence cut short by a C0 byte or another lead byte writes `?`
#     first;
#   - deferred wrap; LF down (scrolling, the new row blank in the
#     current rendition, px59), CR to column 0, BS one left (px59: a
#     pending wrap cleared too), TAB to the next multiple of 8 (at most
#     the last column); other C0 and DEL nothing; CR, LF, BS and TAB
#     clear a pending wrap;
#   - ESC [ … final: SGR for final `m` without private/intermediate bytes
#     and at most 16 parameters (0 reset, 1 bold = bright foreground for
#     0-7, 7 inverse, 22 and 27 their resets, 30-37, 90-97, 40-47,
#     100-107 (bright), 39, 49, 38;5;n and 48;5;n by the Linux VT's
#     measured mapping to the 16, 38;2 and 48;2 mapped from RGB; SGR 2/3/4/21 mapped to the VT
#     colours, 5 recorded but steady (needs the timer hook, px71);
#     each parameter at most 9999);
#   - px59, the rest of what a Linux VT draws of an editor's output,
#     measured (tests/mpx5-screen.d/vtcheck.py holds this terminal to
#     the VT's rows, case by case): CUP HVP CUU CUD CUF CUB CNL CPL CHA
#     HPA VPA (clamped, a pending wrap cleared), ED and EL in the current
#     rendition, ESC 7 / ESC 8, ?1049h/l (a second screen, cleared in the
#     current rendition on entry, the main one restored with its cursor
#     and rendition), ?25l/h (the cursor hidden or shown), DECSCUSR
#     recorded (`shape`), OSC to BEL or to any ESC (which starts the next
#     sequence), ESC ] P and its seven digits, ESC ] R; the queries' answers
#     kept in `answers` (DA1 and ESC Z `ESC [ ? 6 c`, DSR 5 `ESC [ 0 n`,
#     DSR 6 and ? 6 the cursor's row and column); any other sequence
#     ignored; ESC then another byte drops both; a C0 byte inside a
#     sequence ends it and acts; a byte >= 0x80 inside one ends it and
#     is dropped;
#   - the cell's colours are fixed when it is written (bold and inverse
#     applied then); the cursor, when shown, is the cell under it with
#     its colours swapped;
#   - the PC text palette, 0 000000 … 15 ffffff.
#
# --upto N (px59) reads the log only to its byte N (a screen taken while
# a program ran: tools/ps2-session's `dump` records N). --out writes the
# reference as a binary PPM (P6, 255); --grid writes the final grid as
# text (one row a line, trailing blanks kept, the cursor's row and
# column, whether it is shown and DECSCUSR's shape on a last line).
# --compare reads QEMU's `screendump` (P6) and compares it pixel for
# pixel, and cell by cell (px59: a cell is its 8x16 block): exit 0
# identical (the pixels and the cells counted), 1 different (the count
# of differing pixels, of differing cells, and the first differing cell,
# on stderr), 2 on a usage error or an unreadable input.
import sys

PALETTE = [
    0x000000, 0xAA0000, 0x00AA00, 0xAA5500, 0x0000AA, 0xAA00AA, 0x00AAAA, 0xAAAAAA,
    0x555555, 0xFF5555, 0x55FF55, 0xFFFF55, 0x5555FF, 0xFF55FF, 0x55FFFF, 0xFFFFFF,
]


