#!/usr/bin/env bash
# linux-blk — boot this host's Linux kernel under QEMU with a disk image
# on a virtio block device and run programs against the file system on
# it: the reference side of tests/mpx6-ext2 (px63), the Linux guest the
# ext2 rows are held to.
#
#   tools/linux-blk [--kernel VMLINUZ] [--modules DIR] [--busybox FILE]
#                   [--accel tcg|kvm] [--ro] [--mount DIR]
#                   [--file SRC=DEST]... OUTDIR IMAGE PROG... -- CMD...
#
# Builds an initramfs in OUTDIR from a static busybox (the px13-ubuntu
# container's, by default copied out of it), the static programs PROG
# (each to /bin/<basename>) and each --file SRC at DEST, boots VMLINUZ
# on q35 with `-drive file=IMAGE,if=none,id=d0,format=raw -device
# virtio-blk-pci,drive=d0` (the IMAGE is written in place: copy it
# first), mounts /dev/vda at DIR (default /mnt) as `-t ext2` (read-only
# with --ro), and runs each CMD (a shell line) with PAX's environment
# (`env -i HOME=/ TERM=linux PAX=1 PATH=/bin`), from /, between the
# lines `linux-blk: run <k>: <cmd>` and `linux-blk: run <k> status <s>`
# on the guest's serial console, OUTDIR/serial.log. Then it unmounts (the
# guest's own sync), says `linux-blk: unmount <status>` and powers off.
# The disk's own modules are loaded only where the kernel does not have
# them built in (modules.builtin): virtio_blk, and ext4 (Linux 7.2.8
# mounts ext2 through it, CONFIG_EXT4_USE_FOR_EXT2) with its chain from
# modules.dep (decompressed: zstd, xz or gzip).
#
# Exit 0 when the guest ran to its end line, 1 when not, 2 on a usage or
# tool error. Black-box only: the kernel and its modules are run, never
# read.
set -euo pipefail
die() { echo "linux-blk: $*" >&2; exit 2; }
kernel=/usr/lib/modules/$(uname -r)/vmlinuz
modules=/usr/lib/modules/$(uname -r)
busybox=
accel=tcg
ro=0
mnt=/mnt
files=()
while [ $# -gt 0 ]; do
    case $1 in
        --kernel) kernel=$2; shift 2 ;;
        --modules) modules=$2; shift 2 ;;
        --busybox) busybox=$2; shift 2 ;;
        --accel) accel=$2; shift 2 ;;
        --ro) ro=1; shift ;;
        --mount) mnt=$2; shift 2 ;;
        --file) files+=("$2"); shift 2 ;;
        --) shift; break ;;
        -*) die "unknown option $1" ;;
        *) break ;;
    esac
done
[ $# -ge 2 ] || die "usage: linux-blk [opts] OUTDIR IMAGE PROG... -- CMD..."
out=$1; img=$2; shift 2
progs=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do progs+=("$1"); shift; done
[ "${1:-}" = "--" ] && shift
cmds=("$@")
[ -f "$img" ] || die "no image $img"
[ -r "$kernel" ] || die "cannot read the kernel $kernel"
mkdir -p "$out"
out=$(cd "$out" && pwd)
root=$out/root
rm -rf "$root"
mkdir -p "$root"/{bin,dev,proc,sys,lib/modules,tmp,etc} "$root$mnt"

if [ -z "$busybox" ]; then
    podman run --rm -v "$root/bin:/o" px13-ubuntu cp /usr/bin/busybox /o/busybox >/dev/null \
        || die "busybox from px13-ubuntu"
else
    cp "$busybox" "$root/bin/busybox"
fi
for p in "${progs[@]}"; do cp "$p" "$root/bin/$(basename "$p")"; done
for f in ${files[@]+"${files[@]}"}; do
    src=${f%%=*}; dst=${f#*=}
    mkdir -p "$root$(dirname "$dst")"
    cp "$src" "$root$dst"
done

# The modules the kernel lacks, with their chains, deepest first.
order=()
seen=" "
add() {
    local m=$1 line deps d
    grep -Eq "/${m//-/[-_]}\.ko\$" "$modules/modules.builtin" 2>/dev/null && return
    line=$(grep -E "/${m//-/[-_]}\.ko(\.zst|\.xz|\.gz)?:" "$modules/modules.dep" | head -n 1)
    [ -n "$line" ] || die "module $m neither built in nor in modules.dep"
    deps=${line#*:}
    for d in $(echo $deps | tr ' ' '\n' | tac); do
        local n=${d##*/}; n=${n%%.ko*}
        add "$n"
    done
    local path=${line%%:*}
    case $seen in *" $path "*) return ;; esac
    seen="$seen$path "
    order+=("$path")
}
for m in virtio_blk ext4; do add "$m"; done
: > "$root/lib/modules/order"
for path in ${order[@]+"${order[@]}"}; do
    n=${path##*/}; n=${n%%.ko*}
    case $path in
        *.zst) zstd -q -d -c "$modules/$path" > "$root/lib/modules/$n.ko" ;;
        *.xz) xz -d -c "$modules/$path" > "$root/lib/modules/$n.ko" ;;
        *.gz) gzip -d -c "$modules/$path" > "$root/lib/modules/$n.ko" ;;
        *) cp "$modules/$path" "$root/lib/modules/$n.ko" ;;
    esac
    echo "$n" >> "$root/lib/modules/order"
done

opt=; [ "$ro" = 1 ] && opt="-o ro"
{
    echo '#!/bin/busybox sh'
    echo '/bin/busybox mkdir -p /usr/bin /sbin /usr/sbin'
    echo '/bin/busybox --install -s /usr/bin'
    echo 'export PATH=/usr/bin:/bin'
    echo 'mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev'
    echo 'for m in $(cat /lib/modules/order); do insmod /lib/modules/$m.ko || echo "linux-blk: insmod $m failed"; done'
    echo 'n=0; while [ ! -b /dev/vda ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done'
    echo 'echo "linux-blk: uname $(uname -r)"'
    echo "mount -t ext2 $opt /dev/vda $mnt; echo \"linux-blk: mount \$?\""
    echo "echo \"linux-blk: device \$(stat -c %t:%T /dev/vda) $(printf '%s' "$mnt") \$(stat -c %D $mnt)\""
    k=0
    for c in "${cmds[@]}"; do
        k=$((k + 1))
        printf 'echo "linux-blk: run %d: %s"\n' "$k" "${c//\"/\\\"}"
        printf 'cd /; env -i HOME=/ TERM=linux PAX=1 PATH=/bin %s\n' "$c"
        printf 'echo "linux-blk: run %d status $?"\n' "$k"
    done
    echo "cd /; umount $mnt; echo \"linux-blk: unmount \$?\""
    echo 'echo "linux-blk: end"'
    echo 'sync; poweroff -f'
} > "$root/init"
chmod +x "$root/init"
(cd "$root" && find . | cpio -o -H newc --quiet) > "$out/initramfs.cpio"

acc=(-accel tcg -cpu max)
[ "$accel" = kvm ] && acc=(-accel kvm -cpu host)
set +e
timeout 900 qemu-system-x86_64 -machine q35 "${acc[@]}" -m 1G -nographic -no-reboot \
    -kernel "$kernel" -initrd "$out/initramfs.cpio" \
    -append "console=ttyS0 quiet loglevel=3 panic=-1" \
    -drive "file=$img,if=none,id=d0,format=raw" -device virtio-blk-pci,drive=d0 \
    -nic none > "$out/serial.log" 2>&1 < /dev/null
rc=$?
set -e
echo "linux-blk: qemu exit $rc" >> "$out/serial.log"
grep -q '^linux-blk: end' "$out/serial.log" || exit 1
exit 0
