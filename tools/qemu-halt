#!/usr/bin/env bash
# qemu-halt — boot a PAX image and prove the kernel HALTED (px01, M-PX1).
#
#   tools/qemu-halt [--firmware bios|uefi] [--serial FILE] [--timeout SECS]
#                   [--accel auto|kvm|tcg] --elf KERNEL.elf [--symbol NAME]
#                   [--cmd MONITOR-COMMAND]... [--type KEYS --prompt TEXT
#                   [--keyboard serial|ps2]] --marker ERE IMAGE.iso
#
# A kernel that ends in `cli; hlt` never exits QEMU, so its end cannot
# be read from QEMU's status (tools/qemu-run's isa-debug-exit) and a
# marker line plus a timeout cannot tell a halt from a spin or a hang.
# This boots IMAGE through tools/qemu-run with QEMU's human monitor on a
# pipe (FILE.mon.in / FILE.mon.out, no tool beyond QEMU and bash), waits
# for a serial line matching the whole-line ERE --marker (the kernel's
# last line), then asks the monitor `info registers` twice, a second
# apart, and holds the machine to:
#   - QEMU still running (no exit, reset, triple fault or debug-exit);
#   - RIP inside NAME (default pax_halt), from `nm -S` of KERNEL.elf,
#     at both probes;
#   - IF clear (RFL bit 9), so no interrupt can wake the CPU;
#   - HLT=1 at both probes (QEMU's halted flag; measured under TCG on
#     kasumi and CI and under KVM on hasu, where QEMU syncs it from the
#     kernel's vCPU before `info registers` prints);
#   - not one serial byte written between the marker and the second
#     probe.
# Then each --cmd (px03: `info tlb`, `xp /256gx {cr3}`) goes to the
# monitor of the halted machine, its answer saved in FILE.cmd1,
# FILE.cmd2, … in order (lib.sh's mon_cmd: echo, prompt and escapes
# removed), and then `quit`. `{cr3}` in a command is replaced by CR3 as
# the monitor's `info registers` reads it just before (QEMU 8.2's
# monitor has no `$cr3`). FILE.halt records both register dumps and the verdict.
#
# --type KEYS (px13) types a session into the machine before the wait
# for the marker: before step k (the KEYS file's k-th line) it waits
# until TEXT, the program's prompt, has appeared k times in the serial
# log after its first `user: exec pid` line, then types the step: its
# characters, then Enter (CR, what a terminal sends), unless the step
# ends with `^D` (Ctrl-D, which hands over what is typed, or ends the
# input at an empty prompt) or with `^.` (nothing more: `^.` is
# dropped). In a step, `^C` `^D` `^U` `^W` are those control
# characters, `^?` is DEL (the erase character, what Backspace sends)
# and `^^` a `^`. --keyboard serial (the default) writes the bytes to
# COM1's input (tools/qemu-run --serial-input), 20 ms apart; ps2 sends
# each as a key through the monitor's `sendkey` (a-z, A-Z with shift,
# digits, the US layout's punctuation, spc, ret, backspace, tab,
# ctrl-<letter>), to the machine's PS/2 keyboard. FILE.typed records
# what was typed, step by step. Each prompt is waited for at most the
# timeout; a missing one is NOT HALTED (the reason names the step).
#
# Exit 0 halted; 1 not halted (the reason on stderr); 2 usage or tool
# error. The timeout (default 60 s) bounds the wait for the marker.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

firmware=bios serial=$PAX_BUILD/serial.log timeout=60 accel=auto elf= sym=pax_halt marker= image= cmds=() keys= prompt= keyboard=serial
while [ $# -gt 0 ]; do
    case $1 in
        --firmware) firmware=$2; shift 2 ;;
        --serial)   serial=$2; shift 2 ;;
        --timeout)  timeout=$2; shift 2 ;;
        --accel)    accel=$2; shift 2 ;;
        --elf)      elf=$2; shift 2 ;;
        --symbol)   sym=$2; shift 2 ;;
        --marker)   marker=$2; shift 2 ;;
        --cmd)      cmds+=("$2"); shift 2 ;;
        --type)     keys=$2; shift 2 ;;
        --prompt)   prompt=$2; shift 2 ;;
        --keyboard) keyboard=$2; shift 2 ;;
        -h|--help)  sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        -*)         die "unknown option: $1" ;;
        *)          [ -z "$image" ] || die "one image only"; image=$1; shift ;;
    esac
done
[ -n "$image" ] && [ -n "$elf" ] && [ -n "$marker" ] \
    || die "usage: qemu-halt [options] --elf KERNEL.elf --marker ERE IMAGE.iso"
[ -f "$image" ] || die "no image: $image"
[ -f "$elf" ] || die "no kernel: $elf"
if [ -n "$keys" ]; then
    [ -f "$keys" ] || die "no keys file: $keys"
    [ -n "$prompt" ] || die "--type needs --prompt"
fi
case $keyboard in serial|ps2) ;; *) die "--keyboard takes serial or ps2" ;; esac
case $timeout in ''|*[!0-9]*) die "--timeout takes whole seconds" ;; esac
need nm mkfifo

# The halt routine's [start, end) from the symbol table. A kernel
# without it still boots (its log is evidence), and is not halted.
read -r lo size <<<"$(nm -S "$elf" | awk -v s="$sym" '$NF == s && NF == 4 { print $1, $2; exit }')" || true
nosym=
if [ -n "${lo:-}" ]; then lo=$((16#$lo)); hi=$((lo + 16#$size)); else nosym=1 lo=0 hi=0; fi

mkdir -p "$(dirname "$serial")"
# Empty the log before QEMU starts: a previous run's log at the same
# path must never satisfy the marker.
: > "$serial"
mon=$serial.mon
rm -f "$mon.in" "$mon.out" "$serial".cmd[0-9]* "$serial.in" "$serial.typed"
mkfifo "$mon.in" "$mon.out"
sin=()
if [ -n "$keys" ] && [ "$keyboard" = serial ]; then
    mkfifo "$serial.in"
    sin=(--serial-input "$serial.in")
fi
rec=$serial.halt
: > "$rec"
qpid=
cleanup() {
    [ -z "$qpid" ] || kill "$qpid" 2>/dev/null || true
    exec 3>&- 4<&- 5>&- 2>/dev/null || true
    rm -f "$mon.in" "$mon.out" "$serial.in"
}
trap cleanup EXIT
# Both ends open read-write: neither open blocks, and QEMU never sees EOF.
exec 3<>"$mon.in" 4<>"$mon.out"
[ "${#sin[@]}" = 0 ] || exec 5<>"$serial.in"
"$PAX_ROOT/tools/qemu-run" --firmware "$firmware" --serial "$serial" --timeout $((timeout + 30)) \
    --accel "$accel" ${sin[@]+"${sin[@]}"} "$image" -- -monitor "pipe:$mon" &
qpid=$!

no() { printf 'qemu-halt: NOT HALTED: %s\n' "$*" | tee -a "$rec" >&2; exit 1; }

# --type: the session (px13).
prompts() { # how many times the prompt has appeared since the first exec line
    serial_norm "$serial" | awk 'on { print } /^user: exec pid / { on = 1 }' \
        | LC_ALL=C grep -aoF -- "$prompt" | wc -l | tr -d ' '
}
key_of() { # byte (decimal) -> a sendkey name
    local b=$1 c
    if [ "$b" -ge 97 ] && [ "$b" -le 122 ]; then printf "\\$(printf %o "$b")"; return; fi
    if [ "$b" -ge 65 ] && [ "$b" -le 90 ]; then
        printf 'shift-'; printf "\\$(printf %o $((b + 32)))"; return
    fi
    if [ "$b" -ge 48 ] && [ "$b" -le 57 ]; then printf '%s' $((b - 48)); return; fi
    if [ "$b" -ge 1 ] && [ "$b" -le 26 ] && [ "$b" != 9 ] && [ "$b" != 13 ]; then
        printf 'ctrl-'; printf "\\$(printf %o $((b + 96)))"; return
    fi
    c=$(printf "\\$(printf %o "$b")")
    case $b in
        32) printf spc ;; 13) printf ret ;; 9) printf tab ;; 127) printf backspace ;;
        *) case $c in
            -) printf minus ;; =) printf equal ;; '[') printf bracket_left ;; ']') printf bracket_right ;;
            ';') printf semicolon ;; "'") printf apostrophe ;; '`') printf grave_accent ;;
            '\') printf backslash ;; ,) printf comma ;; .) printf dot ;; /) printf slash ;;
            '!') printf shift-1 ;; @) printf shift-2 ;; '#') printf shift-3 ;; '$') printf shift-4 ;;
            %) printf shift-5 ;; '^') printf shift-6 ;; '&') printf shift-7 ;; '*') printf shift-8 ;;
            '(') printf shift-9 ;; ')') printf shift-0 ;; _) printf shift-minus ;; +) printf shift-equal ;;
            '{') printf shift-bracket_left ;; '}') printf shift-bracket_right ;; :) printf shift-semicolon ;;
            '"') printf shift-apostrophe ;; '~') printf shift-grave_accent ;; '|') printf shift-backslash ;;
            '<') printf shift-comma ;; '>') printf shift-dot ;; '?') printf shift-slash ;;
            *) return 1 ;;
           esac ;;
    esac
}
step_bytes() { # a KEYS line -> the bytes it types, as decimal numbers
    local l=$1 i=0 n c d enter=1 out=()
    case $l in *'^D') enter=1 ;; esac
    n=${#l}
    while [ "$i" -lt "$n" ]; do
        c=${l:$i:1}
        if [ "$c" = '^' ] && [ $((i + 1)) -lt "$n" ]; then
            d=${l:$((i + 1)):1}
            case $d in
                C) out+=(3) ;; D) out+=(4) ;; U) out+=(21) ;; W) out+=(23) ;;
                '?') out+=(127) ;; '^') out+=(94) ;; .) ;;
                *) out+=(94); i=$((i + 1)); continue ;;
            esac
            i=$((i + 2))
            continue
        fi
        out+=("$(printf %d "'$c")")
        i=$((i + 1))
    done
    case $l in *'^D'|*'^.') enter=0 ;; esac
    [ "$enter" = 0 ] || out+=(13)
    printf '%s\n' ${out[@]+"${out[@]}"}
}
if [ -n "$keys" ]; then
    k=0
    while IFS= read -r line || [ -n "$line" ]; do
        k=$((k + 1))
        t0=$SECONDS
        until [ "$(prompts)" -ge "$k" ]; do
            kill -0 "$qpid" 2>/dev/null || no "QEMU ended before prompt $k ('$prompt') for step $k: $line"
            [ $((SECONDS - t0)) -lt "$timeout" ] || no "prompt $k ('$prompt') did not come within ${timeout}s (step $k: $line; $(prompts) seen)"
            sleep 0.1
        done
        sleep 0.2
        printf 'step %s: %s\n' "$k" "$line" >> "$serial.typed"
        nb=0
        for b in $(step_bytes "$line"); do
            nb=$((nb + 1))
            if [ "$keyboard" = serial ]; then
                printf "\\$(printf %o "$b")" >&5
                sleep 0.02
            else
                kname=$(key_of "$b") || no "no key for byte $b (step $k)"
                mon_cmd "sendkey $kname" "$serial.key" || no "the monitor did not answer 'sendkey $kname'"
                printf '  key %s\n' "$kname" >> "$serial.typed"
            fi
        done
        printf '  bytes %s\n' "$nb" >> "$serial.typed"
    done < "$keys"
fi

# Wait for the marker (or QEMU's end, or the timeout).
start=$SECONDS
while :; do
    if [ -f "$serial" ] && serial_norm "$serial" | LC_ALL=C grep -Eqx -- "$marker"; then break; fi
    if ! kill -0 "$qpid" 2>/dev/null; then
        rc=0; wait "$qpid" || rc=$?; qpid=
        no "QEMU ended (qemu-run status $rc) before a line matching /$marker/"
    fi
    [ $((SECONDS - start)) -lt "$timeout" ] || no "no line matching /$marker/ within ${timeout}s"
    sleep 0.2
done
size0=$(wc -c < "$serial")
[ -z "$nosym" ] || no "$elf has no sized symbol $sym (QEMU was running at the marker)"

# One `info registers` through the pipe, read until the RIP= ... HLT=
# line is whole. A `read -t` that times out mid-line keeps the partial
# line in its variable; it is kept here too, so a line split across two
# reads is joined, not lost.
probe() {
    local out= line
    printf 'info registers\n' >&3
    local t0=$SECONDS
    while [ $((SECONDS - t0)) -lt 15 ]; do
        line=
        if IFS= read -r -t 1 line <&4; then
            out+="${line//$'\r'/}"$'\n'
        else
            out+="${line//$'\r'/}"
        fi
        if printf '%s' "$out" | grep -Eq 'RIP=[0-9a-f]+ .*HLT=[01]'; then
            printf '%s' "$out"; return 0
        fi
    done
    printf '%s' "$out"; return 1
}
check() { # n dump
    local n=$1 dump=$2 rip rfl hlt
    rip=$(printf '%s\n' "$dump" | sed -n 's/.*RIP=\([0-9a-f]*\).*/\1/p' | tail -n 1)
    rfl=$(printf '%s\n' "$dump" | sed -n 's/.*RFL=\([0-9a-f]*\).*/\1/p' | tail -n 1)
    hlt=$(printf '%s\n' "$dump" | sed -n 's/.*HLT=\([01]\).*/\1/p' | tail -n 1)
    [ -n "$rip" ] && [ -n "$rfl" ] || no "probe $n: no RIP/RFL in the monitor's answer"
    local r=$((16#$rip))
    printf 'probe %s: RIP=%s RFL=%s HLT=%s %s=[%x,%x)\n' "$n" "$rip" "$rfl" "${hlt:-?}" "$sym" "$lo" "$hi" >> "$rec"
    # bash arithmetic is signed 64-bit; the higher half is negative, and
    # both bounds are too, so the comparison holds.
    [ "$r" -ge "$lo" ] && [ "$r" -lt "$hi" ] || no "probe $n: RIP $rip is outside $sym [$(printf %x "$lo"), $(printf %x "$hi"))"
    [ $(( 16#$rfl & 0x200 )) = 0 ] || no "probe $n: IF is set (RFL=$rfl)"
    [ "${hlt:-0}" = 1 ] || no "probe $n: HLT=${hlt:-?}, the CPU is not halted"
    printf '%s' "$rip"
}
d1=$(probe) || no "probe 1: the monitor did not answer: $d1"
printf -- '--- probe 1 ---\n%s\n' "$d1" >> "$rec"
rip1=$(check 1 "$d1")
sleep 1
d2=$(probe) || no "probe 2: the monitor did not answer: $d2"
printf -- '--- probe 2 ---\n%s\n' "$d2" >> "$rec"
rip2=$(check 2 "$d2")
kill -0 "$qpid" 2>/dev/null || no "QEMU ended during the probes"
size1=$(wc -c < "$serial")
[ "$size1" = "$size0" ] || no "the serial log grew from $size0 to $size1 bytes after the marker"
n=0
for c in ${cmds[@]+"${cmds[@]}"}; do
    n=$((n + 1))
    case $c in
        *'{cr3}'*)
            mon_cmd "info registers" "$serial.cr3" || no "the monitor did not answer 'info registers'"
            cr3=$(sed -n 's/.* CR3=\([0-9a-f]*\) .*/\1/p' "$serial.cr3" | tail -n 1)
            [ -n "$cr3" ] || no "no CR3 in the monitor's 'info registers'"
            c=${c//\{cr3\}/0x$cr3} ;;
    esac
    mon_cmd "$c" "$serial.cmd$n" || no "the monitor did not answer --cmd '$c'"
    printf 'cmd%s: %s (%s lines)\n' "$n" "$c" "$(wc -l < "$serial.cmd$n" | tr -d ' ')" >> "$rec"
done
printf 'quit\n' >&3
rc=0; wait "$qpid" || rc=$?; qpid=
accel_used=$(sed -n 's/^accel: //p' "$serial.meta")
printf 'qemu-halt: HALTED in %s (RIP %s, %s; IF clear; serial still at %s bytes; accel %s; quit -> %s)\n' \
    "$sym" "$rip1" "$([ "$rip1" = "$rip2" ] && echo 'unchanged a second later' || echo "then $rip2")" \
    "$size1" "$accel_used" "$rc" | tee -a "$rec"
