#!/usr/bin/env python3
# mkzone — write the time zone file for UTC (px26): what a program
# reads at /etc/localtime to print a date.
#
#   tools/mkzone OUT
#
# The TZif format, RFC 8536: a version-2 file is a version-1 header and
# data block, the same again with 64-bit times, and a footer. Each
# header is the magic `TZif`, the version, fifteen reserved zero bytes
# and six big-endian counts (UT/local indicators 0, standard/wall
# indicators 0, leap seconds 0, transitions 0, local time types 1,
# abbreviation bytes 4); each data block is then the one local time
# type (offset 0 seconds, not daylight time, abbreviation index 0) and
# the abbreviation `UTC` with its NUL. The footer is the POSIX TZ
# string between two newlines: `UTC0`. 114 bytes, the same bytes the
# tz database's own `UTC` has (measured against Ubuntu 24.04's tzdata),
# written here from the RFC so no host file is copied. Prints the
# file's sha256. Exit 0, or 2 on a usage error.
import hashlib
import struct
import sys


def block():
    head = b"TZif" + b"2" + b"\0" * 15 + struct.pack(">6I", 0, 0, 0, 0, 1, 4)
    return head + struct.pack(">iBB", 0, 0, 0) + b"UTC\0"


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("mkzone: usage: mkzone OUT\n")
        return 2
    data = block() + block() + b"\nUTC0\n"
    with open(argv[1], "wb") as f:
        f.write(data)
    print("%s %d bytes sha256 %s" % (argv[1], len(data), hashlib.sha256(data).hexdigest()))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
