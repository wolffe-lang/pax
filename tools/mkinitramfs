#!/usr/bin/env python3
# mkinitramfs — write a `newc` cpio archive, the initramfs buffer format
# PAX reads (kernel/initramfs; Documentation/driver-api/early-userspace/
# buffer-format.rst; cpio(5)).
#
#   tools/mkinitramfs OUT.cpio ARG...
#       ARG: /PATH=FILE[:MODE[:UID:GID]]   a file
#            /PATH/[:MODE[:UID:GID]]       a directory (px42)
#            /PATH->TARGET[:UID:GID]       a symbolic link (px64)
#
# A file argument puts FILE's bytes at PATH (a leading `/` is dropped,
# as cpio writes names); MODE is octal permission bits (default 755
# when FILE is executable, else 644). Every directory a PATH passes
# through gets its own entry first (mode 040755, root's), unless a
# directory argument names it: then it has that MODE (default 755).
# UID and GID are decimal, the entry's owner and group (px42, pax#48:
# an image can hold a file that is not root's); without them 0 and 0,
# and the archive is then the bytes it was before px42. A link argument
# (px64: /bin/grep -> scent) writes cpio(5)'s symbolic link, mode
# 0120777, nlink 1, its data the TARGET's bytes (no NUL; 1 to 4095 of
# them, as symlink(2) takes, and no `:` in this argument's form), owned
# root's unless UID and GID are given; the TARGET is never read or
# checked here (a link may dangle). Reproducible:
# inodes numbered 1, 2, … in the order written, mtime 0, nlink 1 (2 for
# a directory), devices 0, check 0 (`070701`), entries sorted by path,
# the archive ending with `TRAILER!!!`. Prints one line per entry (its
# owner too when that is not 0:0) and the archive's sha256. Exit 0, or
# 2 on a usage error.
import hashlib
import os
import sys


def die(msg):
    sys.stderr.write("mkinitramfs: %s\n" % msg)
    sys.exit(2)


def header(ino, mode, nlink, size, name, uid=0, gid=0):
    fields = [ino, mode, uid, gid, nlink, 0, size, 0, 0, 0, 0, len(name) + 1, 0]
    return b"070701" + b"".join(b"%08x" % f for f in fields)


def pad4(buf):
    return buf + b"\0" * (-len(buf) % 4)


def attrs(spec, what):
    """[MODE[:UID:GID]] after a path -> (mode or None, uid, gid)."""
    parts = spec.split(":") if spec else []
    if len(parts) not in (0, 1, 3):
        die("not MODE or MODE:UID:GID: %s" % what)
    try:
        mode = int(parts[0], 8) if parts else None
        uid, gid = (int(parts[1]), int(parts[2])) if len(parts) == 3 else (0, 0)
    except ValueError:
        die("not MODE or MODE:UID:GID: %s" % what)
    if mode is not None and not 0 <= mode <= 0o7777:
        die("bad mode: %s" % what)
    if not (0 <= uid < 2**32 and 0 <= gid < 2**32):
        die("bad owner: %s" % what)
    return mode, uid, gid


def clean(path):
    name = path.strip("/")
    if not name or "//" in name or ".." in name.split("/") or "." in name.split("/"):
        die("bad path: %s" % path)
    return name


def main(argv):
    if len(argv) < 3:
        die("usage: mkinitramfs OUT.cpio /PATH=FILE[:MODE[:UID:GID]]... /PATH/[:MODE[:UID:GID]]... /PATH->TARGET[:UID:GID]...")
    out = argv[1]
    files = {}
    named = {}
    links = {}
    for arg in argv[2:]:
        arrow, eq = arg.find("->"), arg.find("=")
        if arrow >= 0 and (eq < 0 or arrow < eq):
            path, target = arg[:arrow], arg[arrow + 2:]
            target, sep, spec = target.partition(":")
            if sep and len(spec.split(":")) != 2:
                die("not /PATH->TARGET[:UID:GID]: %s" % arg)
            _, uid, gid = attrs("0777:" + spec if sep else "", arg)
            tb = target.encode()
            if not 1 <= len(tb) <= 4095 or b"\0" in tb:
                die("a link's target is 1 to 4095 bytes, no NUL: %s" % arg)
            links[clean(path)] = (tb, uid, gid)
            continue
        if "=" not in arg:
            path, sep, spec = arg.partition("/:")
            if not sep and not arg.endswith("/"):
                die("not PATH=FILE or PATH/: %s" % arg)
            mode, uid, gid = attrs(spec, arg)
            named[clean(path)] = (0o755 if mode is None else mode, uid, gid)
            continue
        path, src = arg.split("=", 1)
        src, _, spec = src.partition(":")
        mode, uid, gid = attrs(spec, arg)
        name = path.lstrip("/")
        if not name or name.startswith("/") or ".." in name.split("/"):
            die("bad path: %s" % path)
        try:
            data = open(src, "rb").read()
        except OSError as e:
            die("%s: %s" % (src, e))
        if mode is None:
            mode = 0o755 if os.access(src, os.X_OK) else 0o644
        files[name] = (data, mode, uid, gid)
    dirs = {}
    for name in list(files) + list(links) + [d + "/." for d in named]:
        parts = name.split("/")[:-1]
        for i in range(1, len(parts) + 1):
            dirs["/".join(parts[:i])] = (0o755, 0, 0)
    dirs.update(named)
    for d in dirs:
        if d in files:
            die("both a file and a directory: %s" % d)
        if d in links:
            die("both a link and a directory: %s" % d)
    for n in links:
        if n in files:
            die("both a file and a link: %s" % n)
    entries = [(d, None, m | 0o040000, u, g) for d, (m, u, g) in dirs.items()]
    entries += [(n, d, m | 0o100000, u, g) for n, (d, m, u, g) in files.items()]
    entries += [(n, t, 0o120777, u, g) for n, (t, u, g) in links.items()]
    entries.sort(key=lambda e: e[0])
    buf = b""
    ino = 1
    for name, data, mode, uid, gid in entries:
        nb = name.encode()
        size = 0 if data is None else len(data)
        nlink = 2 if data is None else 1
        buf = pad4(buf + header(ino, mode, nlink, size, nb, uid, gid) + nb + b"\0")
        if data is not None:
            buf = pad4(buf + data)
        own = "" if (uid, gid) == (0, 0) else " %d:%d" % (uid, gid)
        if mode & 0o170000 == 0o120000:
            print("link %o %d %s -> %s%s" % (mode, size, name, data.decode(), own))
        else:
            print("%s %o %d %s%s" % ("dir " if data is None else "file", mode, size, name, own))
        ino += 1
    buf = pad4(buf + header(0, 0, 1, 0, b"TRAILER!!!") + b"TRAILER!!!\0")
    with open(out, "wb") as f:
        f.write(buf)
    print("%s %d bytes sha256 %s" % (out, len(buf), hashlib.sha256(buf).hexdigest()))


if __name__ == "__main__":
    main(sys.argv)
