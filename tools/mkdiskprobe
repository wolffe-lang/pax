#!/usr/bin/env bash
# mkdiskprobe — build px63's probe of a file system on a disk, `disk`
# (user/elf/disk.c: a tree read through getdents64 and lstat with every
# field, files' sums, statfs, and the write session's system calls), and
# PAX's `reboot` (user/elf/reboot.S: sync, then reboot(2)), static x86-64
# Linux executables, for tests/mpx6-ext2 and the playground.
#
#   tools/mkdiskprobe OUTDIR
#
# mkprobes' compiler line (`cc -static -no-pie -O1`, ET_EXEC with no
# PT_INTERP, checked), its own tool so that a change to the probe
# reaches only the suite that runs it (the CI map follows the tools a
# test names). Build on a baseline x86-64 glibc (the CI runner's Ubuntu;
# an Ubuntu container on kasumi), never on kasumi's own (px10). Prints
# `<name> <sha256> <bytes>` for each. Exit 0, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkdiskprobe OUTDIR"
out=$1
mkdir -p "$out"
out=$(cd "$out" && pwd)
cc=${CC:-cc}
need "$cc" readelf
src=$PAX_ROOT/user/elf/disk.c
"$cc" -static -no-pie -O1 -Wall -Wextra -Wno-unused-result -Wl,--build-id=none -Wl,-z,noexecstack \
    -o "$out/disk" "$src" || die "cc: disk"
readelf -hW "$out/disk" | grep -Eq 'Type: +EXEC' || die "disk is not ET_EXEC"
! readelf -lW "$out/disk" | grep -q INTERP || die "disk has a PT_INTERP (not static)"
"$cc" -nostdlib -static -no-pie -Wl,--build-id=none -Wl,-z,noexecstack \
    -o "$out/reboot" "$PAX_ROOT/user/elf/reboot.S" || die "cc: reboot"
readelf -hW "$out/reboot" | grep -Eq 'Type: +EXEC' || die "reboot is not ET_EXEC"
for p in disk reboot; do
    printf '%s %s %s\n' "$p" "$(sha256_of "$out/$p")" "$(wc -c < "$out/$p" | tr -d ' ')"
done
