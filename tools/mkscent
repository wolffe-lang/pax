#!/usr/bin/env bash
# mkscent — build scent, grep in wolf (wolffe-lang/scent, Track 15:
# byte-identical to GNU grep 3.12 in the C locale on its M1 options), as
# a fully static x86-64 Linux executable, unmodified, from scent's own
# tree, with its two obsolescent-name wrappers (px64).
#
#   tools/mkscent OUTDIR
#
# The aspen builder's twin (px57's), with what scent's own
# tools/mkscent adds: two builds. The tree is user/scent.pin's commit of
# wolffe-lang/scent (public), fetched from PAX_SCENT_REPO when it is set
# (a local clone or cache that holds the commit) and from SCENT_REPO
# otherwise; HEAD is refused unless it is SCENT_REV. Nothing of scent's
# tree is kept: the build directory is removed at the end. The toolchain
# is the one THAT tree pins in its wolf-toolchain.toml: the whole wolf
# release archive for x86_64-unknown-linux-gnu, its sha256 read twice and
# refused unless both reads are the pin's; its `wolf --version` refused
# unless it is the pin's `version_line`; its bundled std (`std/STD-REV`)
# refused unless it is the pin's `[std] rev` (scent pins the std its
# wolf archive bundles, so the archive's own tree is WOLF_STD, never a
# second fetch); the runtime (`libwolf_rt.a`) left beside `wolf`, as the
# archive lays it out.
#
# scent is built as its own tools/build --static builds it (`wolf build
# --release --no-cache --deny-warnings src/scent.lu -o
# target/static/scent`, the manifest src/wolf.pkg beside it, through a
# `cc` first on PATH that adds `-static`), TWICE, each from a checkout of
# its own at a path of its own; the two digests must agree (scent's
# tools/mkscent refuses two builds that differ the same way). The binary
# is checked static (readelf: ET_EXEC, no PT_INTERP) and run once
# (`--version`). wrappers/egrep and wrappers/fgrep are copied byte for
# byte, mode 0755, refused unless the tree holds them as 100755 blobs and
# the copies' bytes are git's. `OUTDIR/sums.txt` gets `scent <sha256>
# <bytes>`, `egrep …` and `fgrep …`; the stripped size is printed (the
# binary installed is the unstripped one: unmodified).
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu
# container on kasumi), never on kasumi's CachyOS x86-64-v4 glibc (px10).
# The release tier needs clang at run time (wolf's D33). Exit 0, 1 when
# the two builds differ, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkscent OUTDIR"
out=$1
need git curl tar readelf strip cc clang
. "$PAX_ROOT/user/scent.pin"
[ -n "${SCENT_REPO:-}" ] && printf '%s' "${SCENT_REV:-}" | grep -Eq '^[0-9a-f]{40}$' \
    || die "user/scent.pin must set SCENT_REPO and SCENT_REV (a full 40-hex sha, never a branch)"
mkdir -p "$out" "$PAX_CACHE"
out=$(cd "$out" && pwd)

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-scent.XXXXXX")
trap 'rm -rf "$w"' EXIT

tree() { # repo rev dir
    mkdir -p "$3"
    git -C "$3" init -q
    git -C "$3" fetch -q --depth 1 "$1" "$2" || die "cannot fetch $1 at $2"
    git -C "$3" checkout -q --detach FETCH_HEAD
    [ "$(git -C "$3" rev-parse HEAD)" = "$2" ] || die "$1: HEAD is not $2"
}

# scent at the pin, and what it pins.
src=${PAX_SCENT_REPO:-$SCENT_REPO}
tree "$src" "$SCENT_REV" "$w/a/scent"
toml=$w/a/scent/wolf-toolchain.toml
key() { # section key
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { on = ($0 == s); next }
        on && $1 == k { v = $0; sub(/^[^=]*= *"?/, "", v); sub(/"? *$/, "", v); print v; exit }' "$toml"
}
wv=$(key wolf version)
wsha=$(key wolf x86_64-unknown-linux-gnu)
wline=$(key wolf version_line)
srev=$(key std rev)
[ -n "$wv" ] && [ -n "$wsha" ] && [ -n "$wline" ] && [ -n "$srev" ] \
    || die "cannot read wolf version/digest/version_line and std rev from scent's wolf-toolchain.toml"
say "scent $SCENT_REV pins wolf $wv (${wsha:0:8}…), wolf-std $srev"

# wolf, by the digest scent names (cached by digest), read twice.
arc=$PAX_CACHE/wolf-$wv-$wsha.tar.gz
if [ ! -f "$arc" ] || [ "$(sha256_of "$arc")" != "$wsha" ]; then
    curl -sSfL --retry 3 -o "$arc.part" \
        "https://github.com/wolffe-lang/wolf-lang/releases/download/v$wv/wolf-$wv-x86_64-unknown-linux-gnu.tar.gz" \
        || die "cannot download wolf $wv"
    mv "$arc.part" "$arc"
fi
for k in 1 2; do
    have=$(sha256_of "$arc")
    [ "$have" = "$wsha" ] || die "wolf $wv archive, read $k: sha256 $have, scent pins $wsha"
done
say "wolf $wv archive: sha256 $wsha, read twice"
mkdir -p "$w/wolf"
tar -xzf "$arc" -C "$w/wolf" --strip-components=1
wolf=$w/wolf/wolf
[ -x "$wolf" ] || die "the wolf $wv archive has no wolf"
[ -f "$w/wolf/libwolf_rt.a" ] || die "the wolf $wv archive has no libwolf_rt.a beside wolf"
have=$("$wolf" --version | head -n 1)
[ "$have" = "$wline" ] || die "wolf --version says '$have'; scent pins '$wline'"
std=$w/wolf/std
[ -f "$std/STD-REV" ] || die "the wolf $wv archive bundles no std/STD-REV"
have=$(tr -d '[:space:]' < "$std/STD-REV")
[ "$have" = "$srev" ] || die "the wolf $wv archive bundles std $have; scent pins $srev"
say "$wline; libwolf_rt.a beside it; bundled std $srev"

# The static `cc`.
mkdir -p "$w/bin"
real=$(command -v cc)
printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" > "$w/bin/cc"
chmod +x "$w/bin/cc"

# Two builds, each in a checkout of its own, the output path as scent's
# own tools/build gives it (relative, under the tree).
tree "$src" "$SCENT_REV" "$w/b/scent"
for k in a b; do
    (cd "$w/$k/scent" && mkdir -p target/static && PATH="$w/bin:$PATH" WOLF_STD=$std \
        "$wolf" build --release --no-cache --deny-warnings src/scent.lu -o target/static/scent) >&2 \
        || die "wolf build of src/scent.lu (build $k)"
done
one=$(sha256_of "$w/a/scent/target/static/scent")
two=$(sha256_of "$w/b/scent/target/static/scent")
if [ "$one" != "$two" ]; then
    say "REFUSED: two builds differ: $one, then $two"
    exit 1
fi
bin=$out/scent
cp "$w/a/scent/target/static/scent" "$bin"
chmod 755 "$bin"
readelf -hW "$bin" | grep -Eq 'Type: +EXEC' || die "scent is not ET_EXEC"
! readelf -lW "$bin" | grep -q INTERP || die "scent has a PT_INTERP (not static)"
"$bin" --version >&2 || die "scent --version"
: > "$out/sums.txt"
printf '%s %s %s\n' scent "$(sha256_of "$bin")" "$(wc -c < "$bin" | tr -d ' ')" | tee -a "$out/sums.txt"
strip -o "$w/scent.stripped" "$bin"
printf 'scent built twice, the same digest (%s); stripped: %s bytes, sha256 %s (not installed)\n' \
    "$one" "$(wc -c < "$w/scent.stripped" | tr -d ' ')" "$(sha256_of "$w/scent.stripped")"

# The wrappers, byte for byte, mode 0755.
for n in egrep fgrep; do
    mode=$(git -C "$w/a/scent" ls-tree HEAD "wrappers/$n" | awk '{print $1}')
    [ "$mode" = 100755 ] || die "scent's wrappers/$n is not a 100755 blob (mode '$mode')"
    cp "$w/a/scent/wrappers/$n" "$out/$n"
    chmod 755 "$out/$n"
    [ "$(git -C "$w/a/scent" hash-object "$out/$n")" = "$(git -C "$w/a/scent" rev-parse "HEAD:wrappers/$n")" ] \
        || die "the copy of wrappers/$n is not git's bytes"
    printf '%s %s %s\n' "$n" "$(sha256_of "$out/$n")" "$(wc -c < "$out/$n" | tr -d ' ')" | tee -a "$out/sums.txt"
done
printf 'linked against: %s\n' "$("$real" -print-file-name=libc.a)"
