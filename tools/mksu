#!/usr/bin/env bash
# mksu — build su (user/su/su.lu, px46: P5's accounts, ruling #75 R8) with
# user/auth (px106: its password, from /etc/shadow), as a fully static
# x86-64 Linux executable: tools/mkauth OUTDIR su, whose header says how.
#
#   tools/mksu OUTDIR
#
# OUTDIR gets su and sums.txt (`su <sha256> <bytes>`, of the stripped file).
# The toolchain is user/auth/wolf-toolchain.toml's (until px106, su had its
# own, user/su/wolf-toolchain.toml). Exit 0, or 2 on a tool error.
set -euo pipefail
[ $# -eq 1 ] || { echo "usage: mksu OUTDIR" >&2; exit 2; }
exec "$(dirname "$0")/mkauth" "$1" su
