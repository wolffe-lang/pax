#!/usr/bin/env bash
# Build the offline Wolf checker with the repository's verified pins.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die 'usage: mkfsck OUTDIR'
need cc clang readelf
mkdir -p "$1"
out=$(cd "$1" && pwd)
w=$out/source
mkdir -p "$w/diskio" "$out/cc-wrapper"
cp "$PAX_ROOT/user/fsck/"*.lu "$PAX_ROOT/user/fsck/open.S" "$PAX_ROOT/user/fsck/wolf.pkg" "$w/"
cp "$PAX_ROOT/user/disktools/common/"*.lu "$w/diskio/"
printf '#!/bin/sh\nexec %s -static "$@"\n' "$(command -v cc)" > "$out/cc-wrapper/cc"
chmod +x "$out/cc-wrapper/cc"
wolf=$("$PAX_ROOT/tools/fetch-wolf")
if [ ! -d "$out/std/std" ]; then
    PAX_BUILD="$out/std-source" "$PAX_ROOT/tools/fetch-std" "$out/std" >&2
fi
PATH="$out/cc-wrapper:$PATH" WOLF_STD="$out/std/std" "$wolf" build --release --no-cache --deny-warnings "$w/main.lu" -o "$out/fsck.ext2" >&2
readelf -hW "$out/fsck.ext2" | grep -Eq 'Type: +EXEC' || die 'fsck.ext2 is not ET_EXEC'
if readelf -lW "$out/fsck.ext2" | grep -q INTERP; then die 'fsck.ext2 is not static'; fi
printf 'fsck.ext2 %s\n' "$(sha256_of "$out/fsck.ext2")" | tee "$out/sums.txt"
