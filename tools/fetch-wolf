#!/usr/bin/env bash
# fetch-wolf — stage kernel/wolf.pin's wolf release, BY DIGEST.
#
#   tools/fetch-wolf        -> prints the wolf binary's path
#
# Downloads WOLF_URL (the release's x86_64-unknown-linux-gnu archive),
# refuses on a sha256 mismatch with WOLF_SHA256, unpacks it under
# .pax-cache/wolf-<version>/, and refuses a binary whose `--version`
# does not name the first 7 hex of WOLF_PIN_COMMIT (the wolf-lang
# commit the release was cut from). Never builds wolf. The release tier
# also needs clang >= 15 at run time (system LLVM, wolf's D33).
# Linux x86-64 hosts. Idempotent: a verified archive is reused.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
load_wolf_pin

stamp=$WOLF_DIR/.verified
find_bin() { find "$WOLF_DIR" -name wolf -type f -perm -u+x | head -n 1; }
if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$WOLF_SHA256" ]; then
    bin=$(find_bin)
    if [ -n "$bin" ]; then
        say "wolf $WOLF_VERSION already staged ($bin)"
        printf '%s\n' "$bin"
        exit 0
    fi
fi
need curl tar
asset=${WOLF_URL##*/}
mkdir -p "$PAX_CACHE"
tmp=$(mktemp -d "$PAX_CACHE/fetch.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp/$asset" "$WOLF_URL"
got=$(sha256_of "$tmp/$asset")
[ "$got" = "$WOLF_SHA256" ] || die "digest mismatch for $WOLF_URL: pinned $WOLF_SHA256, got $got"
mkdir -p "$tmp/x"
tar -xzf "$tmp/$asset" -C "$tmp/x"
rm -rf "$WOLF_DIR"
mv "$tmp/x" "$WOLF_DIR"
bin=$(find_bin)
[ -n "$bin" ] || die "the wolf archive holds no wolf binary"
ver=$("$bin" --version | head -n 1)
case $ver in
    *"pin ${WOLF_PIN_COMMIT:0:7}"*) ;;
    *) die "wolf --version says '$ver'; the pin says ${WOLF_PIN_COMMIT:0:7}" ;;
esac
printf '%s\n' "$WOLF_SHA256" > "$stamp"
say "wolf $WOLF_VERSION staged ($bin, archive sha256 $got): $ver"
printf '%s\n' "$bin"
