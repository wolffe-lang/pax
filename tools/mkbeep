#!/usr/bin/env bash
# mkbeep — build Ubuntu's `beep` from its own source package as a fully
# static x86-64 Linux executable (px21a), for tests/mpx3-speaker.
#
#   tools/mkbeep OUTDIR
#
# The program is Ubuntu 24.04's beep 1.4.9-1.1ubuntu2: the upstream
# tarball and Ubuntu's `debian/` tarball, the two files of its source
# package, BY DIGEST (user/beep.pin; tools/fetch-pinned takes each from
# its store, read again, or from Ubuntu's archive pool, Launchpad's
# archive of the package or Debian's pool, and refuses a mismatch; px118),
# the package's one patch applied, its own GNUmakefile run with gcc and
# one change to the link: `-static`. Nothing in the source is edited,
# nothing is installed.
#
# Why a build and not the package's binary: /usr/bin/beep is a PIE with
# a PT_INTERP (it loads libc.so.6 through ld.so), and PAX loads static
# ET_EXEC programs only (kernel/elf refuses the other two by name). So
# what runs on PAX is the same program, linked statically, not the same
# file. It is GPL-2+ (its COPYING); nothing of it is committed here.
#
# `OUTDIR/sums.txt` gets `beep <sha256> <bytes>`. Build on a baseline
# x86-64 glibc (the CI runner's Ubuntu; an Ubuntu container on kasumi).
# Exit 0, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkbeep OUTDIR"
out=$1
. "$PAX_ROOT/user/beep.pin"
ORIG=$BEEP_orig_FILE
DEBIAN=$BEEP_debian_FILE
need tar python3 git make gcc readelf
mkdir -p "$out"
out=$(cd "$out" && pwd)
w=$(mktemp -d "${TMPDIR:-/tmp}/pax-beep.XXXXXX")
trap 'rm -rf "$w"' EXIT
for f in "$ORIG" "$DEBIAN"; do
    rc=0
    p=$("$PAX_ROOT/tools/fetch-pinned" beep "$f") || rc=$?
    [ "$rc" = 0 ] || die "$f: not had by its digest (tools/fetch-pinned exit $rc, its reason above)"
    cp "$p" "$w/$f"
done
tar -xzf "$w/$ORIG" -C "$w"
src=$w/beep-1.4.9
[ -d "$src" ] || die "the tarball holds no beep-1.4.9/"
# The debian/ tarball is xz: python3's tarfile reads it where no xz is installed.
python3 -c 'import sys, tarfile; tarfile.open(sys.argv[1]).extractall(sys.argv[2])' "$w/$DEBIAN" "$src"
while read -r p; do
    case $p in ''|'#'*) continue ;; esac
    (cd "$src" && git apply -p1 "debian/patches/$p") || die "debian/patches/$p does not apply"
    say "applied debian/patches/$p"
done < "$src/debian/patches/series"
# The package's own build (debian/rules: COMPILER_gcc, LINKER_gcc), gcc
# only, linked -static.
(cd "$src" && make COMPILER_gcc=gcc LINKER_gcc=gcc COMPILER_clang=no LDFLAGS=-static beep >&2) \
    || die "make beep"
cp "$src/beep" "$out/beep"
readelf -hW "$out/beep" | grep -Eq 'Type: +EXEC' || die "beep is not ET_EXEC"
! readelf -lW "$out/beep" | grep -q INTERP || die "beep has a PT_INTERP (not static)"
printf '%s %s %s\n' beep "$(sha256_of "$out/beep")" "$(wc -c < "$out/beep" | tr -d ' ')" | tee "$out/sums.txt"
