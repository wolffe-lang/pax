#!/usr/bin/env python3
# tcp-host — the host's end of QEMU's user-mode network for the TCP
# witnesses (px23, tests/mpx4-tcp's `user` way).
#
#   tools/tcp-host --echo-to PORT --bulk-to PORT [--soak N] [--bulk BYTES]
#                  [--wait SECONDS] [--boot SECONDS]
#
# With `-netdev user,hostfwd=tcp:127.0.0.1:<A>-:7,hostfwd=tcp:127.0.0.1:<B>-:7100`
# a connection this host makes to 127.0.0.1 port A reaches the guest's
# port 7 from 10.0.2.2 (B: its port 7100), and a connection the guest
# makes to 10.0.2.2 port 9099 or 9100 reaches this host's 127.0.0.1 at
# that port. The TCP on the wire's other end is then QEMU's own, a third
# implementation next to PAX's and tools/paxtcp.py's; this script is
# ordinary sockets — the same connections tools/net-peer's TCP script
# makes segment by segment (tools/paxnet.py holds the ports and the
# streams), as far as a socket can make them:
#
#   H1  waits for user/net/tcpecho's "ready" (a UDP datagram at port
#       9099); then connections of 1, 2, 1460, 1461, 4000 and 70000
#       bytes to the forwarded port: each must come back byte for
#       byte, then the server's line after this end's half is closed,
#       then the end of the stream
#   H2  --soak N (10000) more, 16 bytes each, one at a time; then "quit"
#   H3  user/net/tcpclient's connection at port 9099: 39799 bytes
#       echoed, then this end's line after its half closes
#   H4  user/net/tcpbulk's --bulk BYTES (16 MiB) at port 9100, held to
#       the stream pattern, its length and CRC-32 said back
#   H5  waits for `tcpbulk recv`'s "ready" at port 9097; the same
#       stream into the guest through the second forwarded port, its
#       line back held
#   H6  user/net/tcpsoak's N connections at port 9099, 16 bytes each
#
# Ports 9097, 9099 and 9100 are this host's for the length of a run: the
# script waits up to --wait seconds for them, so two runs on one host go
# one after the other. Prints `tcp-host: 127.0.0.1 ports …` once it
# holds them, one `tcp-host: ok <step> …` line per step and, last,
# `tcp-host: PASS …` or `tcp-host: FAIL <what>`. Exit 0 on PASS, 1 on
# FAIL, 2 on a usage error.
#
# Written from QEMU's documentation of `-netdev user` (`hostfwd`, the
# gateway's address) and RFC 862. No network stack's source.
import os
import socket
import sys
import threading
import time
import zlib

sys.dont_write_bytecode = True  # no tools/__pycache__ in the tree
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import paxnet as px  # noqa: E402

USAGE = "tcp-host: usage: tcp-host --echo-to PORT --bulk-to PORT [--soak N] [--bulk BYTES] [--wait SECONDS] [--boot SECONDS]"


class Fail(Exception):
    pass


def read_all(c):
    out = bytearray()
    while True:
        d = c.recv(65536)
        if not d:
            return bytes(out)
        out += d


class Server(threading.Thread):
    """A listener on 127.0.0.1:port; `handle(conn)` serves each
    connection in turn and its answer is kept."""

    def __init__(self, sock, handle):
        super().__init__(daemon=True)
        self.sock, self.handle = sock, handle
        self.results = []
        self.error = None

    def run(self):
        while True:
            try:
                c, _ = self.sock.accept()
            except OSError:
                return
            try:
                c.settimeout(600)
                self.results.append(self.handle(c))
            except Exception as x:  # noqa: BLE001: said, by the main thread
                self.error = "%s: %s" % (type(x).__name__, x)
                self.results.append(None)
            finally:
                c.close()


def echo(c):
    """What comes goes back; after the other end's half closes, one
    line, then the end. Returns the bytes echoed."""
    n, crc = 0, 0
    while True:
        try:
            d = c.recv(65536)
        except ConnectionResetError:
            return n
        if not d:
            break
        n += len(d)
        crc = zlib.crc32(d, crc)
        c.sendall(d)
    try:
        c.sendall(b"eof after %d bytes, crc %08x\n" % (n, crc))
    except OSError:
        pass  # the other end closed without waiting for it (tcpsoak does)
    return n


def sink(c):
    """The stream pattern to its end; its length and CRC-32 said back.
    Returns (bytes, crc, whether every byte was the pattern's, seconds)."""
    n, crc, right = 0, 0, True
    t0 = None
    while True:
        d = c.recv(1 << 18)
        if not d:
            break
        if t0 is None:
            t0 = time.time()
        if d != px.stream_pattern(n, len(d)):
            right = False
        n += len(d)
        crc = zlib.crc32(d, crc)
    span = time.time() - (t0 or time.time())
    c.sendall(b"got %d bytes, crc %08x\n" % (n, crc))
    return n, crc, right, span


def listen(port, wait):
    end = time.time() + wait
    while True:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", port))
            s.listen(64)
            return s
        except OSError as x:
            s.close()
            if time.time() > end:
                raise Fail("127.0.0.1 port %d (TCP) is not free after %.0f s: %s" % (port, wait, x))
            time.sleep(0.5)


def udp(port, wait):
    end = time.time() + wait
    while True:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.bind(("127.0.0.1", port))
            return s
        except OSError as x:
            s.close()
            if time.time() > end:
                raise Fail("127.0.0.1 port %d (UDP) is not free after %.0f s: %s" % (port, wait, x))
            time.sleep(0.5)


def ready(sock, timeout, what):
    sock.settimeout(timeout)
    try:
        d, _ = sock.recvfrom(64)
    except socket.timeout:
        raise Fail("no \"ready\" from %s in %.0f s" % (what, timeout))
    if d != b"ready":
        raise Fail("%s said %r, not \"ready\"" % (what, d[:40]))


def ask(port, payload, what):
    """A connection to the forwarded port: `payload`, this end's half
    closed, and the whole answer held to its bytes."""
    c = socket.create_connection(("127.0.0.1", port), timeout=120)
    try:
        c.sendall(payload)
        c.shutdown(socket.SHUT_WR)
        got = read_all(c)
    except OSError as x:
        raise Fail("%s: %s" % (what, x))
    finally:
        c.close()
    want = payload + b"eof after %d bytes, crc %08x\n" % (len(payload), zlib.crc32(payload))
    if got != want:
        raise Fail("%s: %d bytes came back, %d were due (the payload and the server's line)" % (what, len(got), len(want)))


def results(server, n, timeout, what):
    end = time.time() + timeout
    while len(server.results) < n:
        if server.error:
            raise Fail("%s: %s" % (what, server.error))
        if time.time() > end:
            raise Fail("%s: %d of %d connections in %.0f s" % (what, len(server.results), n, timeout))
        time.sleep(0.01)
    if server.error:
        raise Fail("%s: %s" % (what, server.error))
    return server.results


def main(argv):
    opt = {"echo-to": None, "bulk-to": None, "soak": "10000", "bulk": "16777216", "wait": "120", "boot": "600"}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and a[2:] in opt and i + 1 < len(argv):
            opt[a[2:]] = argv[i + 1]
            i += 2
        else:
            print(USAGE, file=sys.stderr)
            return 2
    if opt["echo-to"] is None or opt["bulk-to"] is None:
        print(USAGE, file=sys.stderr)
        return 2
    sys.stdout.reconfigure(line_buffering=True)
    soak, bulk, boot = int(opt["soak"]), int(opt["bulk"]), float(opt["boot"])
    fwd, fwd2 = int(opt["echo-to"]), int(opt["bulk-to"])
    try:
        wait = float(opt["wait"])
        u1, u2 = udp(px.TCP_SERVICE, wait), udp(px.TCP_READY_BULK, wait)
        echoes = Server(listen(px.TCP_SERVICE, wait), echo)
        sinks = Server(listen(px.TCP_BULK, wait), sink)
        echoes.start()
        sinks.start()
        print("tcp-host: 127.0.0.1 ports %d (UDP and TCP), %d (UDP) and %d (TCP) are this run's" % (px.TCP_SERVICE, px.TCP_READY_BULK, px.TCP_BULK))
        # H1
        ready(u1, boot, "tcpecho")
        sizes = (1, 2, 1460, 1461, 4000, 70000)
        for k, n in enumerate(sizes):
            ask(fwd, px.stream_pattern(k * 1000, n), "a connection of %d bytes" % n)
        print("tcp-host: ok H1 \"ready\"; connections of %s bytes through the forwarded port, each echoed exact and ended by the server's line"
              % ", ".join(str(n) for n in sizes))
        # H2
        t0 = time.time()
        for i in range(soak):
            ask(fwd, px.soak_request(i)[:16], "connection %d of the soak" % i)
        span = time.time() - t0
        ask(fwd, b"quit", "\"quit\"")
        print("tcp-host: ok H2 %d connections opened, echoed and closed in %.2f s (%d a second); \"quit\"" % (soak, span, soak / span if span > 0 else 0))
        # H3
        r = results(echoes, 1, 300, "tcpclient's connection")
        if r[0] != 39799:
            raise Fail("H3: tcpclient's connection carried %r bytes, 39799 were due" % (r[0],))
        print("tcp-host: ok H3 tcpclient's connection: 39799 bytes echoed, then this end's line after its half closed")
        # H4
        r = results(sinks, 1, 900, "tcpbulk's connection")
        n, crc, right, span = r[0]
        if n != bulk or not right:
            raise Fail("H4: %d bytes came (%d were due)%s" % (n, bulk, "" if right else ", not the pattern"))
        print("tcp-host: ok H4 %d bytes out of PAX, every byte the pattern's, crc %08x, in %.2f s (%d KB/s by this script's clock)"
              % (n, crc, span, n / 1000 / span if span > 0 else 0))
        # H5
        ready(u2, 300, "tcpbulk recv")
        c = socket.create_connection(("127.0.0.1", fwd2), timeout=900)
        t0 = time.time()
        off = 0
        while off < bulk:
            k = min(bulk - off, 1 << 18)
            c.sendall(px.stream_pattern(off, k))
            off += k
        c.shutdown(socket.SHUT_WR)
        got = read_all(c)
        c.close()
        span = time.time() - t0
        want = b"got %d bytes, crc %08x\n" % (bulk, zlib.crc32(px.stream_pattern(0, bulk)))
        if got != want:
            raise Fail("H5: the receiver said %r, %r was due" % (got[:80], want))
        print("tcp-host: ok H5 %d bytes into PAX through the second forwarded port, its line back \"%s\", in %.2f s (%d KB/s by this script's clock)"
              % (bulk, want.decode().strip(), span, bulk / 1000 / span if span > 0 else 0))
        # H6
        t0 = time.time()
        r = results(echoes, 1 + soak, 120 + soak * 0.2, "tcpsoak's connections")
        bad = [x for x in r[1:] if x != 16]
        if bad:
            raise Fail("H6: %d of tcpsoak's %d connections did not carry 16 bytes" % (len(bad), soak))
        span = time.time() - t0
        print("tcp-host: ok H6 tcpsoak's %d connections, 16 bytes each, in %.2f s (%d a second)" % (soak, span, soak / span if span > 0 else 0))
    except Fail as x:
        print("tcp-host: FAIL " + str(x))
        return 1
    except OSError as x:
        print("tcp-host: FAIL %s: %s" % (type(x).__name__, x))
        return 1
    print("tcp-host: PASS (QEMU's user-mode network: its TCP between this host's sockets and PAX)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
