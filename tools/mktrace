#!/usr/bin/env bash
# Build px102's two no-libc ET_EXEC witnesses; no host headers or libraries.
# Usage: tools/mktrace OUTDIR. Only x86-64 Linux toolchains are supported.
# The tracee's fixed addresses are the probe's ABI, not a normalization.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mktrace OUTDIR"
out=$1
mkdir -p "$out"
cc=${CC:-cc}
need "$cc" readelf nm python3
common=(-nostdlib -static -no-pie -Wl,--build-id=none -Wl,-z,noexecstack)
"$cc" "${common[@]}" -O1 -ffreestanding -fno-builtin -fno-stack-protector \
    -fno-asynchronous-unwind-tables -Wall -Wextra -Werror \
    -o "$out/trace" "$PAX_ROOT/user/elf/trace.c"
"$cc" "${common[@]}" -Wl,-Ttext=0x401000,-Tdata=0x402000 \
    -o "$out/tracee" "$PAX_ROOT/user/elf/tracee.S"
python3 - "$out" <<'PY'
import pathlib, struct, subprocess, sys
out = pathlib.Path(sys.argv[1])
for name in ('trace', 'tracee'):
    b = (out / name).read_bytes()
    assert b[:6] == b'\x7fELF\x02\x01', (name, 'ELF64 little endian')
    assert struct.unpack_from('<HH', b, 16) == (2, 62), (name, 'ET_EXEC x86-64')
    off = struct.unpack_from('<Q', b, 32)[0]
    size, count = struct.unpack_from('<HH', b, 54)
    ph = [struct.unpack_from('<IIQQQQQQ', b, off + i * size) for i in range(count)]
    assert not any(p[0] == 3 for p in ph), (name, 'PT_INTERP')
    if name == 'tracee':
        assert any(p[0] == 1 and p[1] == 5 and p[3] <= 0x401000 < p[3]+p[6] for p in ph), 'text must be R-X'
        assert any(p[0] == 1 and p[1] == 6 and p[3] <= 0x402000 < p[3]+p[6] for p in ph), 'data must be RW-'
symbols = {}
for line in subprocess.check_output(['nm', '-n', str(out / 'tracee')], text=True).splitlines():
    words = line.split()
    if len(words) == 3:
        symbols[words[2]] = int(words[0], 16)
for name, address in {'_start': 0x401000, 'trace_break': 0x401001,
                      'trace_setnr': 0x401002, 'trace_syscall': 0x401007,
                      'trace_store': 0x401009, 'trace_after_store': 0x401010,
                      'trace_exit': 0x401011, 'trace_value': 0x402000}.items():
    assert symbols.get(name) == address, (name, symbols.get(name), address)
print('PASS trace-layout')
PY
for f in trace tracee; do
    printf '%s %s %s\n' "$f" "$(sha256_of "$out/$f")" "$(wc -c < "$out/$f" | tr -d ' ')"
done
