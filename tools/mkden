#!/usr/bin/env bash
# mkden — build den, version control in wolf (wolffe-lang/den, Track 16:
# Git's repository formats byte for byte), as a fully static x86-64 Linux
# executable, unmodified, from den's own tree, through den's own
# tools/mkden (px90).
#
#   tools/mkden OUTDIR
#
# The scent builder's twin (px64's tools/mkscent), with den's own builder
# in the middle. The tree is user/den.pin's commit of wolffe-lang/den
# (public), fetched from PAX_DEN_REPO when it is set (a local clone or
# cache that holds the commit) and from DEN_REPO otherwise, through
# tools/fetch-retry; HEAD is refused unless it is DEN_REV. Nothing of
# den's tree is kept: the build directory is removed at the end.
#
# The toolchain is the one THAT tree pins in its wolf-toolchain.toml, not
# kernel/wolf.pin's:
#   - the whole wolf release archive for x86_64-unknown-linux-gnu, its
#     sha256 read twice and refused unless both reads are the pin's; its
#     `wolf --version` refused unless it is the pin's `version_line`; the
#     runtime (`libwolf_rt.a`) left beside `wolf`, as the archive lays it
#     out;
#   - lupin's release archive likewise (den's tools/lib-toolchain.sh
#     refuses to build without the pinned lupin beside wolf, though the
#     static build never runs it), read twice, its version line checked;
#   - the std at the pin's `[std] rev`: the wolf archive's bundled std
#     (`std/STD-REV`) when it is that commit, else wolf-std fetched at it
#     (tools/fetch-retry) and its `std/` tree taken, as den's own
#     tools/fetch-toolchain stages it.
#
# den is built by its own tools/mkden (the release tier linked through a
# `cc` first on PATH that adds `-static`, built twice in one checkout and
# refused there unless both digests agree), once in each of two checkouts
# at paths of their own: four builds, and the two checkouts' binaries
# must agree as well (exit 1 otherwise). The binary is checked static
# (readelf: ET_EXEC, no PT_INTERP) and run once (`--version`).
# `OUTDIR/sums.txt` gets `den <sha256> <bytes>`; the stripped size is
# printed (the binary installed is the unstripped one: unmodified).
# Nothing here makes /bin/git: tools/install-den does, as a link.
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu
# 24.04 container on hasu or kasumi), never on kasumi's CachyOS x86-64-v4
# glibc (px10). The release tier needs clang at run time (wolf's D33).
# Exit 0, 1 when two builds differ, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkden OUTDIR"
out=$1
need git curl tar readelf strip cc clang
. "$PAX_ROOT/user/den.pin"
[ -n "${DEN_REPO:-}" ] && printf '%s' "${DEN_REV:-}" | grep -Eq '^[0-9a-f]{40}$' \
    || die "user/den.pin must set DEN_REPO and DEN_REV (a full 40-hex sha, never a branch)"
mkdir -p "$out" "$PAX_CACHE"
out=$(cd "$out" && pwd)

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-den.XXXXXX")
trap 'rm -rf "$w"' EXIT

tree() { # repo rev dir
    mkdir -p "$3"
    git -C "$3" init -q
    "$PAX_ROOT/tools/fetch-retry" "$3" "$1" "$2" "$2" || die "cannot fetch $1 at $2"
    git -C "$3" checkout -q --detach FETCH_HEAD
    [ "$(git -C "$3" rev-parse HEAD)" = "$2" ] || die "$1: HEAD is not $2"
}

# den at the pin, and what it pins.
src=${PAX_DEN_REPO:-$DEN_REPO}
tree "$src" "$DEN_REV" "$w/a/den"
toml=$w/a/den/wolf-toolchain.toml
key() { # section key
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { on = ($0 == s); next }
        on && $1 == k { v = $0; sub(/^[^=]*= *"?/, "", v); sub(/"? *$/, "", v); print v; exit }' "$toml"
}
wv=$(key wolf version)
wsha=$(key wolf x86_64-unknown-linux-gnu)
wline=$(key wolf version_line)
lv=$(key lupin version)
lsha=$(key lupin x86_64-unknown-linux-gnu)
lline=$(key lupin version_line)
srepo=$(key std repo)
srev=$(key std rev)
[ -n "$wv" ] && [ -n "$wsha" ] && [ -n "$wline" ] && [ -n "$lv" ] && [ -n "$lsha" ] && [ -n "$lline" ] \
    && [ -n "$srepo" ] && [ -n "$srev" ] \
    || die "cannot read wolf and lupin version/digest/version_line and std repo/rev from den's wolf-toolchain.toml"
say "den $DEN_REV pins wolf $wv (${wsha:0:8}…), lupin $lv (${lsha:0:8}…), wolf-std $srev"

# An archive by the digest den names (cached by digest), read twice.
archive() { # name version digest repo -> the cached path
    local arc=$PAX_CACHE/$1-$2-x86_64-unknown-linux-gnu-$3.tar.gz have k
    if [ ! -f "$arc" ] || [ "$(sha256_of "$arc")" != "$3" ]; then
        curl -sSfL --retry 3 -o "$arc.part" \
            "https://github.com/wolffe-lang/$4/releases/download/v$2/$1-$2-x86_64-unknown-linux-gnu.tar.gz" \
            || die "cannot download $1 $2"
        mv "$arc.part" "$arc"
    fi
    for k in 1 2; do
        have=$(sha256_of "$arc")
        [ "$have" = "$3" ] || die "$1 $2 archive, read $k: sha256 $have, den pins $3"
    done
    say "$1 $2 archive: sha256 $3, read twice"
    printf '%s\n' "$arc"
}
arc=$(archive wolf "$wv" "$wsha" wolf-lang)
mkdir -p "$w/wolf"
tar -xzf "$arc" -C "$w/wolf" --strip-components=1
wolf=$w/wolf/wolf
[ -x "$wolf" ] || die "the wolf $wv archive has no wolf"
[ -f "$w/wolf/libwolf_rt.a" ] || die "the wolf $wv archive has no libwolf_rt.a beside wolf"
have=$("$wolf" --version | head -n 1)
[ "$have" = "$wline" ] || die "wolf --version says '$have'; den pins '$wline'"
arc=$(archive lupin "$lv" "$lsha" wolf-interp)
mkdir -p "$w/lupin"
tar -xzf "$arc" -C "$w/lupin" --strip-components=1
lupin=$w/lupin/lupin
[ -x "$lupin" ] || die "the lupin $lv archive has no lupin"
have=$("$lupin" --version | head -n 1)
[ "$have" = "$lline" ] || die "lupin --version says '$have'; den pins '$lline'"
say "$wline; libwolf_rt.a beside it; $lline"

# The std: the archive's own when it is the pin's commit, else the pin's.
std=$w/wolf/std
bundled=$(tr -d '[:space:]' < "$std/STD-REV" 2>/dev/null || true)
if [ "$bundled" = "$srev" ]; then
    say "the wolf $wv archive bundles std $srev, the pin's"
else
    say "the wolf $wv archive bundles std '${bundled:-none}'; den pins $srev: fetching it"
    tree "https://github.com/$srepo" "$srev" "$w/std-src"
    std=$w/std
    mkdir -p "$std"
    git -C "$w/std-src" archive HEAD std | tar -x -C "$w"
    printf '%s\n' "$srev" > "$std/STD-REV"
fi

# den's own builder in two checkouts of its own; each builds twice and
# refuses two digests itself.
tree "$src" "$DEN_REV" "$w/b/den"
for k in a b; do
    rc=0
    (cd "$w/$k/den" && WOLF_BIN=$wolf LUPIN_BIN=$lupin WOLF_STD=$std TMPDIR=$w/$k \
        sh tools/mkden "$w/$k/out") > "$w/$k.log" 2>&1 || rc=$?
    cat "$w/$k.log" >&2
    if [ "$rc" != 0 ]; then
        if grep -q 'mkden: REFUSED' "$w/$k.log"; then
            say "REFUSED: den's tools/mkden built checkout $k twice to two digests"
            exit 1
        fi
        die "den's tools/mkden (checkout $k) exited $rc"
    fi
done
one=$(sha256_of "$w/a/out/den")
two=$(sha256_of "$w/b/out/den")
if [ "$one" != "$two" ]; then
    say "REFUSED: the two checkouts' builds differ: $one, then $two"
    exit 1
fi
bin=$out/den
cp "$w/a/out/den" "$bin"
chmod 755 "$bin"
readelf -hW "$bin" | grep -Eq 'Type: +EXEC' || die "den is not ET_EXEC"
! readelf -lW "$bin" | grep -q INTERP || die "den has a PT_INTERP (not static)"
"$bin" --version >&2 || die "den --version"
printf '%s %s %s\n' den "$(sha256_of "$bin")" "$(wc -c < "$bin" | tr -d ' ')" | tee "$out/sums.txt"
strip -o "$w/den.stripped" "$bin"
printf 'den built four times (two checkouts, den'"'"'s tools/mkden twice in each), the same digest (%s); stripped: %s bytes, sha256 %s (not installed)\n' \
    "$one" "$(wc -c < "$w/den.stripped" | tr -d ' ')" "$(sha256_of "$w/den.stripped")"
printf 'linked against: %s\n' "$(cc -print-file-name=libc.a)"
