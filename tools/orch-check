#!/usr/bin/env python3
# orch-check — judge what play's part format (px32) sounded: a capture
# (QEMU's `wav` backend, any rate, 16-bit) or play -o's raw frames
# (S16_LE, two channels, 48000 Hz), by the power at given pitches in
# given windows (the Goertzel algorithm: one DFT bin per pitch), so
# several simultaneous parts are seen apart.
#
#   tools/orch-check --env FILE [--win MS]      loudness per window, dB
#   tools/orch-check --expect SPEC FILE         each line of SPEC judged
#
# Time 0 is the first frame louder than -50 dBFS (the capture's leading
# silence and the device's start are not the tune's). SPEC lines
# (milliseconds from time 0, hertz; `#` comments):
#
#   present HZ FROM TO [DB [WIN]]  HZ's share of every WIN ms (default
#                            50) window of FROM..TO
#                            at least DB (default -30): the bin's power
#                            over the window's, in dB, 0 for a lone sine
#   absent HZ FROM TO [DB [WIN]]  HZ's share at most DB (default -45) in every
#                            window (silence counts as absent)
#   onset HZ AT TOL [WIN]    HZ's onset within TOL ms of AT: the centre
#                            of the first window (WIN ms, default 40,
#                            2.5 ms apart) within 6 dB of the loudest
#                            near AT (half a Hann window's area covered)
#   rising HZ FROM TO DB     HZ's level over FROM..TO in 250 ms windows:
#                            never falls by more than 1.5 dB from one to
#                            the next, and the last is at least DB above
#                            the first
#   falling HZ FROM TO DB    the same, falling
#   flat HZ FROM TO DB       ... and stays within DB of its first window
#                            (HZ 0: the whole sound's loudness, dBFS)
#   modulated FROM TO DB [MAX]  the loudness in 5 ms steps wavers about its
#                            200 ms mean by at least DB (standard
#                            deviation): a tremolo, a roll
#   louder HZ F1 T1 F2 T2 DB HZ's level over F1..T1 at least DB over
#                            F2..T2 (an accent, sfz, fp; HZ 0 loudness)
#   ratio HZ HZ2 FROM TO LO HI   HZ2's level less HZ's within LO..HI dB
#   brighter HZ HZ2 F1 T1 F2 T2 DB  that ratio over F2..T2 at least DB
#                            above it over F1..T1 (brightness)
#   pan HZ FROM TO LO HI     HZ's left channel less its right, dB
#   dip HZ AT LO HI          HZ's lowest 20 ms level within 40 ms of AT,
#                            below its loudest 60-200 ms before, by
#                            LO..HI dB (a gap, a re-attack, a tie's none)
#   vibrato HZ FROM TO LO HI the pitch near HZ in 60 ms windows (every
#                            20 ms) spans LO..HI percent
#   rms FROM TO LO HI        the loudness (both channels, dBFS) in
#                            FROM..TO between LO and HI
#   noclip                   no sample at full scale
#
# Prints one PASS or FAIL line per check and `orch-check: N of M`; exit
# 0 when all pass, 1 when one fails, 2 on a usage or file error.
# Written from the DFT's definition and Goertzel's recurrence (any
# signal-processing text); no audio library.
import math
import struct
import sys


def die(msg):
    print("orch-check: " + msg, file=sys.stderr)
    sys.exit(2)


def read(path):
    data = open(path, "rb").read()
    if data[:4] == b"RIFF" and data[8:12] == b"WAVE":
        i = 12
        rate = ch = bits = None
        pcm = None
        while i + 8 <= len(data):
            cid = data[i:i + 4]
            size = struct.unpack("<I", data[i + 4:i + 8])[0]
            body = data[i + 8:i + 8 + size]
            if cid == b"fmt ":
                _, ch, rate, _, _, bits = struct.unpack("<HHIIHH", body[:16])
            elif cid == b"data":
                # QEMU's wav backend leaves the sizes 0 when it is ended
                # (as tools/wav-notes found): 0 or too long is the rest
                if size == 0 or i + 8 + size > len(data):
                    pcm = data[i + 8:]
                    break
                pcm = body
            i += 8 + size + (size & 1)
        if pcm is None or bits != 16:
            die(path + ": not a 16-bit PCM WAV")
    else:
        rate, ch, pcm = 48000, 2, data
    n = len(pcm) // (2 * ch)
    s = struct.unpack("<%dh" % (n * ch), pcm[:n * ch * 2])
    if ch == 1:
        mono = list(s)
        return rate, mono, s, mono, mono
    mono = [(s[2 * k] + s[2 * k + 1]) / 2 for k in range(n)]
    return rate, mono, s, list(s[0::2]), list(s[1::2])


def start_of(mono):
    th = 32768 * 10 ** (-50 / 20)
    for k, x in enumerate(mono):
        if abs(x) > th:
            return k
    return 0


class Sound:
    def __init__(self, path):
        self.rate, self.mono, self.raw, self.left, self.right = read(path)
        self.t0 = start_of(self.mono)
        self.floors = {}

    def frame(self, ms):
        return self.t0 + int(ms * self.rate / 1000)

    def level(self, hz, a, b, x=None):
        """HZ's power in frames a..b of X (both channels), dB (Goertzel, Hann window)."""
        if x is None:
            x = self.mono
        a = max(a, 0)
        b = min(b, len(x))
        n = b - a
        if n < 16:
            return -200.0
        w = 2 * math.pi * hz / self.rate
        c = 2 * math.cos(w)
        s1 = s2 = 0.0
        for k in range(n):
            h = 0.5 - 0.5 * math.cos(2 * math.pi * k / (n - 1))
            s0 = x[a + k] * h + c * s1 - s2
            s2 = s1
            s1 = s0
        p = s1 * s1 + s2 * s2 - c * s1 * s2
        return 10 * math.log10(p / (n * n) + 1e-9)

    def series(self, hz, f, t, win, hop):
        out = []
        ms = f
        while ms + win <= t + 0.001:
            out.append((ms, self.level(hz, self.frame(ms), self.frame(ms + win))))
            ms += hop
        return out

    def share(self, hz, ms, win):
        """HZ's power over the WIN ms window at MS's, dB; 0 for a lone sine."""
        a, b = self.frame(ms), self.frame(ms + win)
        seg = self.mono[a:b]
        ms2 = sum(v * v for v in seg) / max(len(seg), 1)
        if ms2 < 1.0:
            return -200.0
        return self.level(hz, a, b) - 10 * math.log10(ms2) + 10 * math.log10(8)

    def floor(self, hz):
        if hz not in self.floors:
            total = (len(self.mono) - self.t0) * 1000 // self.rate
            lv = [v for _, v in self.series(hz, 0, total, 50, 50)]
            self.floors[hz] = min(lv) if lv else -200.0
        return self.floors[hz]

    def lv(self, hz, f, t, x=None):
        """HZ's level over F..T ms (HZ 0: the loudness), dB."""
        if hz == 0:
            return self.rms(f, t)
        return self.level(hz, self.frame(f), self.frame(t), x)

    def pitch(self, hz, f, t):
        """The strongest frequency within 2% of HZ over F..T ms (0.02% steps)."""
        best, at = -1e9, hz
        k = -100
        while k <= 100:
            g = hz * (1 + k / 5000.0)
            v = self.level(g, self.frame(f), self.frame(t))
            if v > best:
                best, at = v, g
            k += 1
        return at

    def rms(self, f, t):
        a, b = self.frame(f), self.frame(t)
        seg = self.mono[a:b]
        if not seg:
            return -200.0
        return 10 * math.log10(sum(v * v for v in seg) / len(seg) / (32768.0 ** 2) + 1e-12)


def judge(snd, w):
    op = w[0]
    if op == "noclip":
        n = sum(1 for v in snd.raw if v >= 32767 or v <= -32768)
        return n == 0, "%d samples at full scale" % n
    hz = float(w[1])
    if op in ("present", "absent"):
        f, t = float(w[2]), float(w[3])
        db = float(w[4]) if len(w) > 4 else (-30.0 if op == "present" else -45.0)
        win = float(w[5]) if len(w) > 5 else 50.0
        lv = []
        ms = f
        while ms + win <= t + 0.001:
            lv.append(snd.share(hz, ms, win))
            ms += win
        if not lv:
            return False, "no window"
        if op == "present":
            return min(lv) >= db, "%.0f Hz %.0f-%.0f ms: lowest share %.1f dB (want >= %.0f)" % (hz, f, t, min(lv), db)
        return max(lv) <= db, "%.0f Hz %.0f-%.0f ms: highest share %.1f dB (want <= %.0f)" % (hz, f, t, max(lv), db)
    if op == "onset":
        at, tol = float(w[2]), float(w[3])
        win = float(w[4]) if len(w) > 4 else 40.0
        ser = snd.series(hz, at - tol - win, at + tol + 150, win, 2.5)
        top = max([v for ms, v in ser if ms + win / 2 >= at - tol] or [-200.0])
        found = None
        for ms, v in ser:
            if v >= top - 6:
                found = ms + win / 2
                break
        if found is None:
            return False, "%.0f Hz: no onset near %.0f ms" % (hz, at)
        return abs(found - at) <= tol, "%.0f Hz: onset at %.1f ms (want %.0f +- %.0f)" % (hz, found, at, tol)
    if op in ("rising", "falling", "flat"):
        f, t, db = float(w[2]), float(w[3]), float(w[4])
        if hz == 0:
            lv = []
            ms = f
            while ms + 250 <= t + 0.001:
                lv.append(snd.rms(ms, ms + 250))
                ms += 250
        else:
            lv = [v for _, v in snd.series(hz, f, t, 250, 250)]
        if len(lv) < 2:
            return False, "too short"
        txt = " ".join("%.1f" % v for v in lv)
        if op == "falling":
            lv = [-v for v in lv]
            txt = " ".join("%.1f" % -v for v in lv)
        if op in ("rising", "falling"):
            drops = [lv[i] - lv[i + 1] for i in range(len(lv) - 1)]
            ok = max(drops) <= 1.5 and lv[-1] - lv[0] >= db
            word = "rises" if op == "rising" else "falls"
            return ok, "%.0f Hz %.0f-%.0f ms %s %.1f dB (want >= %.0f), worst step against it %.1f: %s" % (hz, f, t, word, lv[-1] - lv[0], db, max(drops), txt)
        spread = max(abs(v - lv[0]) for v in lv)
        return spread <= db, "%.0f Hz %.0f-%.0f ms within %.1f dB (want <= %.0f): %s" % (hz, f, t, spread, db, txt)
    if op == "modulated":
        f, t, db = hz, float(w[2]), float(w[3])
        env = []
        ms = f
        while ms + 5 <= t:
            env.append(snd.rms(ms, ms + 5))
            ms += 5
        dev = []
        for i in range(20, len(env) - 20):
            avg = sum(env[i - 20:i + 20]) / 40
            dev.append(env[i] - avg)
        if not dev:
            return False, "too short"
        sd = math.sqrt(sum(d * d for d in dev) / len(dev))
        top = float(w[4]) if len(w) > 4 else 1e9
        return db <= sd <= top, "%.0f-%.0f ms: the loudness wavers %.2f dB (standard deviation in 5 ms steps about its 200 ms mean; want %.1f..%s)" % (f, t, sd, db, w[4] if len(w) > 4 else "")
    if op == "louder":
        f1, t1, f2, t2, db = map(float, w[2:7])
        d = snd.lv(hz, f1, t1) - snd.lv(hz, f2, t2)
        return d >= db, "%.0f Hz: %.0f-%.0f ms is %.1f dB over %.0f-%.0f ms (want >= %.0f)" % (hz, f1, t1, d, f2, t2, db)
    if op == "ratio":
        h2, f, t, lo, hi = float(w[2]), float(w[3]), float(w[4]), float(w[5]), float(w[6])
        d = snd.lv(h2, f, t) - snd.lv(hz, f, t)
        return lo <= d <= hi, "%.0f Hz against %.0f Hz over %.0f-%.0f ms: %.1f dB (want %.0f..%.0f)" % (h2, hz, f, t, d, lo, hi)
    if op == "brighter":
        h2 = float(w[2])
        f1, t1, f2, t2, db = map(float, w[3:8])
        r1 = snd.lv(h2, f1, t1) - snd.lv(hz, f1, t1)
        r2 = snd.lv(h2, f2, t2) - snd.lv(hz, f2, t2)
        return r2 - r1 >= db, "%.0f Hz against %.0f Hz: %.1f dB over %.0f-%.0f ms, %.1f dB over %.0f-%.0f ms: %.1f dB brighter (want >= %.0f)" % (h2, hz, r1, f1, t1, r2, f2, t2, r2 - r1, db)
    if op == "pan":
        f, t, lo, hi = map(float, w[2:6])
        d = snd.lv(hz, f, t, snd.left) - snd.lv(hz, f, t, snd.right)
        return lo <= d <= hi, "%.0f Hz %.0f-%.0f ms: left %.1f dB over right (want %.0f..%.0f)" % (hz, f, t, d, lo, hi)
    if op == "dip":
        at, lo, hi = map(float, w[2:5])
        ref = max(v for _, v in snd.series(hz, at - 200, at - 60, 20, 5))
        low = min(v for _, v in snd.series(hz, at - 40, at + 40, 20, 2.5))
        d = ref - low
        return lo <= d <= hi, "%.0f Hz at %.0f ms dips %.1f dB (want %.0f..%.0f)" % (hz, at, d, lo, hi)
    if op == "vibrato":
        f, t, lo, hi = map(float, w[2:6])
        ps = []
        ms = f
        while ms + 60 <= t:
            ps.append(snd.pitch(hz, ms, ms + 60))
            ms += 20
        sp = (max(ps) - min(ps)) / hz * 100
        return lo <= sp <= hi, "%.0f Hz %.0f-%.0f ms: the pitch spans %.2f%% (%.1f to %.1f Hz; want %.2f..%.2f%%)" % (hz, f, t, sp, min(ps), max(ps), lo, hi)
    if op == "rms":
        f, t, lo, hi = hz, float(w[2]), float(w[3]), float(w[4])
        r = snd.rms(f, t)
        return lo <= r <= hi, "%.0f-%.0f ms: %.1f dBFS (want %.0f..%.0f)" % (f, t, r, lo, hi)
    die("unknown check '%s'" % op)


def main(a):
    if len(a) >= 2 and a[0] == "--env":
        win = float(a[3]) if len(a) > 3 and a[2] == "--win" else 250.0
        snd = Sound(a[1])
        total = (len(snd.mono) - snd.t0) * 1000 / snd.rate
        print("start %d frames, %.0f ms, rate %d" % (snd.t0, total, snd.rate))
        ms = 0.0
        while ms < total:
            print("%8.0f %6.1f" % (ms, snd.rms(ms, ms + win)))
            ms += win
        return 0
    if len(a) == 3 and a[0] == "--expect":
        snd = Sound(a[2])
        good = n = 0
        for line in open(a[1]):
            w = line.split("#")[0].split()
            if not w:
                continue
            n += 1
            ok, why = judge(snd, w)
            good += ok
            print(("PASS " if ok else "FAIL ") + " ".join(w) + ": " + why)
        print("orch-check: %d of %d" % (good, n))
        return 0 if good == n else 1
    die("usage: orch-check --env FILE [--win MS] | --expect SPEC FILE")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
