#!/usr/bin/env bash
# linux-nodes — boot this host's Linux kernel under QEMU with one or more
# disk images, each on a virtio block device of its own, and run
# programs against their device nodes: the reference side of
# tests/mpx6-nodes (px79), the Linux guest the block-node rows are held
# to.
#
#   tools/linux-nodes [--kernel VMLINUZ] [--modules DIR] [--busybox FILE]
#                     [--accel tcg|kvm] [--drive IMAGE[,ro][;DEVOPTS]]...
#                     [--nvme IMAGE[,ro][;DEVOPTS]]... [--qemu ARG]...
#                     [--file SRC=DEST]... OUTDIR PROG... -- CMD...
#
# Builds an initramfs in OUTDIR from a static busybox (the px13-ubuntu
# container's by default), the static programs PROG (each to
# /bin/<basename>) and each --file SRC at DEST; boots VMLINUZ on q35 with
# each --drive in the order given as `-drive file=IMAGE,if=none,id=dK,
# format=raw[,readonly=on] -device virtio-blk-pci,drive=dK[,DEVOPTS]`
# (DEVOPTS: the device's own properties, e.g. `cyls=100,heads=4,secs=17`; so QEMU puts
# them in PCI slot order as PAX's tools do, and the guest names them vda,
# vdb, … in that order); mounts proc, sysfs and devtmpfs (`mode=755`, as
# a distribution's init mounts /dev) and runs each CMD (a shell line)
# with PAX's environment (`env -i HOME=/ TERM=linux PAX=1 PATH=/bin`),
# from /, between `linux-nodes: run <k>: <cmd>` and `linux-nodes: run <k>
# status <s>` on the guest's serial console, OUTDIR/serial.log; then
# `linux-nodes: end`, a sync and a power-off. The images are written in
# place: give copies. The disk's modules (virtio_pci and virtio_blk, and
# ext4 for an ext2 mount; px75: virtio_pci too, a module on hasu's
# NixOS kernel where kasumi's builds it in, and ext2 where it is a module
# of its own) are loaded only where the kernel does not have them built
# in (modules.builtin of --modules, by default the kernel image's own
# directory).
#
# --nvme IMAGE[,ro][;DEVOPTS] (px75), repeatable: the image on an NVMe
# controller of its own, `-drive file=IMAGE,if=none,id=dK,format=raw
# [,readonly=on] -device nvme,serial=paxnvmeN,drive=dK[,DEVOPTS]` (N
# counts the --nvme options from 0; DEVOPTS the device's properties,
# e.g. `logical_block_size=4096,physical_block_size=4096`), in the order
# given among the --drive options, so PCI slots follow the command line
# as tools/qemu-run gives them; the nvme module (and its chain) is then
# loaded too, and the shell waits for /dev/nvme0n1 as it waits for
# /dev/vda. --qemu ARG (px75), repeatable: ARG given to QEMU as it is,
# after the disks (a controller with namespaces of its own: `-device
# nvme,id=c0,…` and `-device nvme-ns,bus=c0,nsid=…`); an ARG naming nvme
# loads the module as --nvme does. px78: an ARG naming usb-storage loads
# xhci_pci, usb_storage and sd_mod (with their chains), and the shell
# waits for a disk under a USB device to appear in /sys/block, then a
# second more for its partitions.
#
# Exit 0 when the guest ran to its end line, 1 when not, 2 on a usage or
# tool error. Black-box only: the kernel and its modules are run, never
# read.
set -euo pipefail
die() { echo "linux-nodes: $*" >&2; exit 2; }
kernel=/usr/lib/modules/$(uname -r)/vmlinuz
modules=
busybox=
accel=tcg
drives=()
files=()
extra=()
nvme=0 ahci=0 usb=0
while [ $# -gt 0 ]; do
    case $1 in
        --kernel) kernel=$2; shift 2 ;;
        --modules) modules=$2; shift 2 ;;
        --busybox) busybox=$2; shift 2 ;;
        --accel) accel=$2; shift 2 ;;
        --drive) drives+=("v:$2"); shift 2 ;;
        --nvme) drives+=("n:$2"); nvme=1; shift 2 ;;
        --ahci) drives+=("a:$2"); ahci=1; shift 2 ;;
        --qemu) extra+=("$2"); case $2 in *nvme*) nvme=1 ;; *ahci*|*ide-hd*) ahci=1 ;; *usb-storage*) usb=1 ;; esac; shift 2 ;;
        --file) files+=("$2"); shift 2 ;;
        --) shift; break ;;
        -*) die "unknown option $1" ;;
        *) break ;;
    esac
done
[ $# -ge 1 ] || die "usage: linux-nodes [opts] OUTDIR PROG... -- CMD..."
out=$1; shift
progs=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do progs+=("$1"); shift; done
[ "${1:-}" = "--" ] && shift
cmds=("$@")
[ -r "$kernel" ] || die "cannot read the kernel $kernel"
# The modules beside the kernel's image (a distribution's layout), unless named.
[ -n "$modules" ] || modules=$(dirname "$kernel")
mkdir -p "$out"
out=$(cd "$out" && pwd)
root=$out/root
rm -rf "$root"
mkdir -p "$root"/{bin,dev,proc,sys,lib/modules,tmp,etc,mnt}

if [ -z "$busybox" ]; then
    podman run --rm -v "$root/bin:/o" px13-ubuntu cp /usr/bin/busybox /o/busybox >/dev/null \
        || die "busybox from px13-ubuntu"
else
    cp "$busybox" "$root/bin/busybox"
fi
for p in ${progs[@]+"${progs[@]}"}; do cp "$p" "$root/bin/$(basename "$p")"; done
for f in ${files[@]+"${files[@]}"}; do
    src=${f%%=*}; dst=${f#*=}
    mkdir -p "$root$(dirname "$dst")"
    cp "$src" "$root$dst"
done

# The disk's modules, where they are not built in, with their chains.
order=()
seen=" "
add() {
    local m=$1 line deps d
    grep -Eq "/${m//-/[-_]}\.ko\$" "$modules/modules.builtin" 2>/dev/null && return
    line=$(grep -E "/${m//-/[-_]}\.ko(\.zst|\.xz|\.gz)?:" "$modules/modules.dep" | head -n 1)
    [ -n "$line" ] || die "module $m neither built in nor in modules.dep"
    deps=${line#*:}
    for d in $(echo $deps | tr ' ' '\n' | tac); do
        local n=${d##*/}; n=${n%%.ko*}
        add "$n"
    done
    local path=${line%%:*}
    case $seen in *" $path "*) return ;; esac
    seen="$seen$path "
    order+=("$path")
}
mods="virtio_pci virtio_blk ext4"
[ "$nvme" = 0 ] || mods="$mods nvme"
[ "$ahci" = 0 ] || mods="$mods ahci sd_mod"
[ "$usb" = 0 ] || mods="$mods xhci-pci usb-storage sd_mod"
for m in $mods; do add "$m"; done
# px75: ext2 is a module of its own where ext4 does not serve it (hasu's
# NixOS kernel: `mount -t ext2` ENODEV with ext4 alone); loaded when the
# kernel has one, built in or not.
grep -Eq "/ext2\.ko(\.zst|\.xz|\.gz)?:" "$modules/modules.dep" 2>/dev/null && add ext2
: > "$root/lib/modules/order"
for path in ${order[@]+"${order[@]}"}; do
    n=${path##*/}; n=${n%%.ko*}
    case $path in
        *.zst) zstd -q -d -c "$modules/$path" > "$root/lib/modules/$n.ko" ;;
        *.xz) xz -d -c "$modules/$path" > "$root/lib/modules/$n.ko" ;;
        *.gz) gzip -d -c "$modules/$path" > "$root/lib/modules/$n.ko" ;;
        *) cp "$modules/$path" "$root/lib/modules/$n.ko" ;;
    esac
    echo "$n" >> "$root/lib/modules/order"
done

{
    echo '#!/bin/busybox sh'
    echo '/bin/busybox mkdir -p /usr/bin /sbin /usr/sbin'
    echo '/bin/busybox --install -s /usr/bin'
    echo 'export PATH=/usr/bin:/bin'
    echo 'mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs -o mode=755 dev /dev'
    echo 'for m in $(cat /lib/modules/order); do insmod /lib/modules/$m.ko || echo "linux-nodes: insmod $m failed"; done'
    case " ${drives[*]-} " in *" v:"*) echo 'n=0; while [ ! -b /dev/vda ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done' ;; esac
    [ "$nvme" = 0 ] || echo 'n=0; while [ ! -b /dev/nvme0n1 ] && [ $n -lt 100 ]; do sleep 0.1; n=$((n + 1)); done'
    [ "$ahci" = 0 ] || echo 'n=0; while [ ! -b /dev/sda ] && [ $n -lt 100 ]; do sleep 0.1; n=$((n + 1)); done'
    [ "$usb" = 0 ] || echo 'n=0; while ! ls -l /sys/block/ | grep -q usb && [ $n -lt 100 ]; do sleep 0.1; n=$((n + 1)); done; sleep 1'
    echo 'sleep 0.5'
    echo 'echo "linux-nodes: uname $(uname -r)"'
    k=0
    for c in ${cmds[@]+"${cmds[@]}"}; do
        k=$((k + 1))
        printf 'echo "linux-nodes: run %d: %s"\n' "$k" "${c//\"/\\\"}"
        printf 'cd /; env -i HOME=/ TERM=linux PAX=1 PATH=/bin %s\n' "$c"
        printf 'echo "linux-nodes: run %d status $?"\n' "$k"
    done
    echo 'echo "linux-nodes: end"'
    echo 'sync; poweroff -f'
} > "$root/init"
chmod +x "$root/init"
(cd "$root" && find . | cpio -o -H newc --quiet) > "$out/initramfs.cpio"

qd=()
k=0
nv=0 ah=0
for e in ${drives[@]+"${drives[@]}"}; do
    kind=${e%%:*}; d=${e#?:}
    if [ "$kind" = a ]; then
        img=${d%%,*}; opts=serial=paxahci$ah,model=PAX-SATA-disk
        case $d in *,*) opts=${d#*,} ;; esac
        [ -f "$img" ] || die "no image $img"
        qd+=(-device "ahci,id=paxahci$ah" -drive "file=$img,if=none,id=d$k,format=raw"
             -device "ide-hd,bus=paxahci$ah.0,drive=d$k,$opts")
        ah=$((ah + 1)); k=$((k + 1)); continue
    fi
    dopts=
    case $d in *';'*) dopts=,${d#*;}; d=${d%%;*} ;; esac
    img=${d%,ro}; ro=
    [ "$img" != "$d" ] && ro=,readonly=on
    [ -f "$img" ] || die "no image $img"
    if [ "$kind" = n ]; then
        qd+=(-drive "file=$img,if=none,id=d$k,format=raw$ro" -device "nvme,serial=paxnvme$nv,drive=d$k$dopts")
        nv=$((nv + 1))
    else
        qd+=(-drive "file=$img,if=none,id=d$k,format=raw$ro" -device "virtio-blk-pci,drive=d$k$dopts")
    fi
    k=$((k + 1))
done
qd+=(${extra[@]+"${extra[@]}"})
acc=(-accel tcg -cpu max)
[ "$accel" = kvm ] && acc=(-accel kvm -cpu host)
set +e
timeout 900 qemu-system-x86_64 -machine q35 "${acc[@]}" -m 1G -nographic -no-reboot \
    -kernel "$kernel" -initrd "$out/initramfs.cpio" \
    -append "console=ttyS0 quiet loglevel=3 panic=-1" \
    ${qd[@]+"${qd[@]}"} -nic none > "$out/serial.log" 2>&1 < /dev/null
rc=$?
set -e
echo "linux-nodes: qemu exit $rc" >> "$out/serial.log"
{
    printf 'kernel %s (%s)\n' "$kernel" "$(file -b "$kernel" 2>/dev/null | sed -n 's/.*version \([^ ]*\).*/\1/p')"
    printf 'qemu %s\n' "$(qemu-system-x86_64 --version | head -n 1)"
    shown=(); for e in ${drives[@]+"${drives[@]}"}; do case $e in v:*) shown+=("${e#v:}") ;; *) shown+=("nvme:${e#n:}") ;; esac; done
    printf 'drives %s\n' "${shown[*]:-none}"
    [ ${#extra[@]} -eq 0 ] || printf 'qemu %s\n' "${extra[*]}"
} > "$out/meta"
grep -q '^linux-nodes: end' "$out/serial.log" || exit 1
exit 0
