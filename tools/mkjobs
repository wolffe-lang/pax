#!/usr/bin/env bash
# mkjobs — build px48's job-control probe (user/elf/jobs.c), px49's
# probe of the small gaps (user/elf/gaps.c) and px50's of the
# descriptor table in /proc (user/elf/fdtab.c), static x86-64 Linux
# executables.
#
#   tools/mkjobs OUTDIR
#
# The compiler line of tools/mkas (`cc -static -no-pie -O1`, ET_EXEC
# with no PT_INTERP, checked), with -pthread (the probe asks a thread's
# ids; gaps starts one too). Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an
# Ubuntu container on kasumi), never on kasumi's own (px10). Prints
# `<name> <sha256> <bytes>` for each. Exit 0, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkjobs OUTDIR"
out=$1
mkdir -p "$out"
out=$(cd "$out" && pwd)
cc=${CC:-cc}
need "$cc" readelf
# Each source named whole (the CI plan derives the paths a suite reads
# from the names its tools write out).
for src in "$PAX_ROOT/user/elf/jobs.c" "$PAX_ROOT/user/elf/gaps.c" "$PAX_ROOT/user/elf/fdtab.c"; do
    p=$(basename "$src" .c)
    "$cc" -static -no-pie -O1 -pthread -Wall -Wextra -Wno-unused-result -Wno-unused-function \
        -Wl,--build-id=none -Wl,-z,noexecstack -o "$out/$p" "$src" || die "cc: $p"
    readelf -hW "$out/$p" | grep -Eq 'Type: +EXEC' || die "$p is not ET_EXEC"
    ! readelf -lW "$out/$p" | grep -q INTERP || die "$p has a PT_INTERP (not static)"
    printf '%s %s %s\n' "$p" "$(sha256_of "$out/$p")" "$(wc -c < "$out/$p" | tr -d ' ')"
done
