#!/usr/bin/env python3
# linux-net — run a PAX run list of network programs on this host's
# Linux, the reference side of tests/mpx4-udp (px22).
#
#   sudo tools/linux-net [--strace] [--soak N] ROOT RUNLIST OUTDIR
#
# The commands of RUNLIST (kmain_sockets's format: one a line, words
# separated by single spaces, the first the program's path; empty lines
# and `#` lines skipped) run one after another, chrooted in ROOT, with
# PAX's argv and environment (HOME=/ TERM=linux PAX=1), standard input
# /dev/null, standard output and standard error one pipe — in a network
# namespace of their own that is addressed as PAX is: the loopback
# device up, and one tap device `pax0` with the hardware address
# 52:54:00:12:34:56, the address 10.0.2.15 netmask 255.255.255.0 and a
# default route by way of 10.0.2.2. The other end of the tap is
# tools/net-peer's UDP script (its `Peer`, not strict): the same
# gateway, DNS server and hosts the same script plays to PAX over
# QEMU's socket netdev, frame for frame. So what a witness prints here
# is what Linux answers to exactly what PAX is asked.
#
# The namespace and the tap are made with unshare(2) and ioctl(2) alone
# (TUNSETIFF, SIOCSIFHWADDR, SIOCSIFADDR, SIOCSIFNETMASK, SIOCSIFFLAGS,
# SIOCADDRT: uapi linux/if_tun.h, linux/sockios.h, linux/if.h,
# linux/route.h; netdevice(7), Documentation/networking/tuntap.rst): no
# `ip` program is needed, and nothing outside the namespace changes; it
# goes when this process ends.
#
# OUTDIR/<k>.out gets command k's bytes, OUTDIR/<k>.rc its exit status
# (or `signal N`), OUTDIR/peer.txt the script's account. --strace runs
# each command under `strace -f` and keeps OUTDIR/<k>.strace from the
# program's own execve on: black-box, what it asks of Linux.
#
# Needs root (unshare, chroot) and /dev/net/tun. Exit 0 when every
# command ran and the script ended PASS, 1 when the script did not, 2 on
# a usage or tool error.
import ctypes
import fcntl
import importlib.machinery
import importlib.util
import os
import select
import shutil
import socket
import struct
import sys
import time

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import paxnet as px  # noqa: E402

ENV = {"HOME": "/", "TERM": "linux", "PAX": "1"}
CLONE_NEWNET = 0x40000000
TUNSETIFF = 0x400454ca
IFF_TAP, IFF_NO_PI = 0x0002, 0x1000
IFF_UP, IFF_RUNNING = 0x1, 0x40
SIOCADDRT, SIOCGIFFLAGS, SIOCSIFFLAGS, SIOCSIFADDR, SIOCSIFNETMASK, SIOCSIFHWADDR = 0x890B, 0x8913, 0x8914, 0x8916, 0x891c, 0x8924
ARPHRD_ETHER = 1
RTF_UP, RTF_GATEWAY = 0x1, 0x2
TAP = b"pax0"


def die(msg):
    sys.stderr.write("linux-net: %s\n" % msg)
    sys.exit(2)


def tool(name):
    path = shutil.which(name)
    if path is None:
        die("no %s on PATH" % name)
    return path


def sockaddr(ip):
    return struct.pack("H2s4s8x", socket.AF_INET, b"\0\0", socket.inet_aton(ip))


def namespace():
    """A new network namespace for this process, addressed as PAX is;
    the tap device's descriptor."""
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.unshare(CLONE_NEWNET) != 0:
        die("unshare(CLONE_NEWNET): %s" % os.strerror(ctypes.get_errno()))
    try:
        fd = os.open("/dev/net/tun", os.O_RDWR)
    except OSError as e:
        die("/dev/net/tun: %s" % e)
    fcntl.ioctl(fd, TUNSETIFF, struct.pack("16sH22x", TAP, IFF_TAP | IFF_NO_PI))
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    fcntl.ioctl(s, SIOCSIFHWADDR, struct.pack("16sH6s8x", TAP, ARPHRD_ETHER, px.PAX_MAC))
    fcntl.ioctl(s, SIOCSIFADDR, struct.pack("16s16s", TAP, sockaddr(px.dotted(px.PAX_IP))))
    fcntl.ioctl(s, SIOCSIFNETMASK, struct.pack("16s16s", TAP, sockaddr(px.dotted(px.NETMASK))))
    for name in (b"lo", TAP):
        flags = struct.unpack("16sH22x", fcntl.ioctl(s, SIOCGIFFLAGS, struct.pack("16sH22x", name, 0)))[1]
        fcntl.ioctl(s, SIOCSIFFLAGS, struct.pack("16sH22x", name, flags | IFF_UP | IFF_RUNNING))
    # struct rtentry (linux/route.h): rt_pad1, rt_dst, rt_gateway,
    # rt_genmask, rt_flags, then fields left zero; 120 bytes on x86-64.
    route = struct.pack("Q16s16s16sH", 0, sockaddr("0.0.0.0"), sockaddr(px.dotted(px.GW_IP)), sockaddr("0.0.0.0"), RTF_UP | RTF_GATEWAY)
    fcntl.ioctl(s, SIOCADDRT, route.ljust(120, b"\0"))
    s.close()
    return fd


class TapWire:
    """The tap device: a frame is one read or write."""

    def __init__(self, fd):
        self.fd = fd

    def send(self, f):
        os.write(self.fd, f)

    def recv(self, timeout):
        r, _, _ = select.select([self.fd], [], [], max(timeout, 0.001))
        if not r:
            return None
        return os.read(self.fd, 4096)


def commands(path):
    out = []
    for line in open(path, "rb").read().split(b"\n"):
        if not line or line.startswith(b"#"):
            continue
        out.append([w.decode() for w in line.split(b" ") if w])
    return out


def run(root, argv, trace):
    """Run argv chrooted in root (under strace when `trace` names a
    file); its output and exit status."""
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(r)
            n = os.open("/dev/null", os.O_RDONLY)
            os.dup2(n, 0)
            os.dup2(w, 1)
            os.dup2(w, 2)
            for fd in (n, w):
                if fd > 2:
                    os.close(fd)
            if trace:
                cmd = [tool("strace"), "-f", "-qq", "-s", "64", "-o", trace, tool("chroot"), root] + argv
                os.execve(cmd[0], cmd, ENV)
            os.chroot(root)
            os.chdir("/")
            os.execve(argv[0], argv, ENV)
        except OSError as e:
            os.write(2, ("linux-net: exec %s: %s\n" % (argv[0], e)).encode())
        os._exit(127)
    os.close(w)
    data = b""
    while True:
        chunk = os.read(r, 65536)
        if not chunk:
            break
        data += chunk
    os.close(r)
    _, st = os.waitpid(pid, 0)
    if os.WIFSIGNALED(st):
        return data, "signal %d" % os.WTERMSIG(st)
    return data, str(os.WEXITSTATUS(st))


def play(tap, soak, peer_out):
    """The other end of the tap, in this (child) process: tools/net-peer's
    UDP script, not strict. Never returns."""
    code = 1
    try:
        out = os.open(peer_out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        os.dup2(out, 1)
        os.dup2(out, 2)
        sys.stdout = os.fdopen(1, "w", buffering=1)
        loader = importlib.machinery.SourceFileLoader("net_peer", os.path.join(HERE, "net-peer"))
        spec = importlib.util.spec_from_loader("net_peer", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        peer = mod.Peer(TapWire(tap), 120.0, strict=False)
        try:
            peer.udp_script(soak)
            print("net-peer: sent %s" % " ".join("%s=%d" % kv for kv in sorted(peer.sent.items())))
            print("net-peer: PASS (the reference side: Linux on a tap device)")
            code = 0
        except mod.Fail as x:
            print("net-peer: FAIL " + str(x))
    finally:
        sys.stdout.flush()
        os._exit(code)


def main(argv):
    strace, soak = False, 10000
    args = argv[1:]
    while args and args[0].startswith("--"):
        if args[0] == "--strace":
            strace = True
            args = args[1:]
        elif args[0] == "--soak" and len(args) > 1:
            soak = int(args[1])
            args = args[2:]
        else:
            die("usage: linux-net [--strace] [--soak N] ROOT RUNLIST OUTDIR")
    if len(args) != 3:
        die("usage: linux-net [--strace] [--soak N] ROOT RUNLIST OUTDIR")
    root, runlist, outdir = os.path.abspath(args[0]), args[1], os.path.abspath(args[2])
    if os.geteuid() != 0:
        die("needs root (unshare, chroot)")
    os.makedirs(outdir, exist_ok=True)
    cmds = commands(runlist)
    tap = namespace()

    peer_out = os.path.join(outdir, "peer.txt")
    peer_pid = os.fork()
    if peer_pid == 0:
        play(tap, soak, peer_out)

    for k, cmd in enumerate(cmds, 1):
        trace = os.path.join(outdir, "%d.strace.raw" % k) if strace else None
        data, rc = run(root, cmd, trace)
        open(os.path.join(outdir, "%d.out" % k), "wb").write(data)
        open(os.path.join(outdir, "%d.rc" % k), "w").write(rc + "\n")
        line = "%d: %s -> %s, %d bytes" % (k, " ".join(cmd), rc, len(data))
        if trace:
            lines = open(trace, errors="replace").read().splitlines()
            start = 0
            for i, l in enumerate(lines):
                if ' execve("%s"' % cmd[0] in l and l.endswith("= 0"):
                    start = i
            open(os.path.join(outdir, "%d.strace" % k), "w").write("\n".join(lines[start:]) + "\n")
            os.unlink(trace)
            calls = set()
            for l in lines[start:]:
                rest = l.split(None, 1)[1] if len(l.split(None, 1)) > 1 else ""
                if "(" in rest and rest[0].isalpha():
                    calls.add(rest.split("(", 1)[0])
            line += "; calls: " + " ".join(sorted(calls))
        print(line)
        sys.stdout.flush()

    # The script has said its last word by now, or is still waiting for
    # a program that will not come.
    deadline = time.time() + 10
    status = None
    while time.time() < deadline:
        pid, st = os.waitpid(peer_pid, os.WNOHANG)
        if pid:
            status = st
            break
        time.sleep(0.1)
    if status is None:
        os.kill(peer_pid, 9)
        os.waitpid(peer_pid, 0)
    ok = status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0
    last = open(peer_out).read().strip().splitlines() or ["(nothing)"]
    print("peer: %s" % last[-1])
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
