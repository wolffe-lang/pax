#!/usr/bin/env python3
# pcap-net — hold a capture of the network test kernel's exchange to the
# frames it must contain, byte by byte (px20, px21; tests/mpx4-net).
#
#   tools/pcap-net [--small N] [--large N] [--list K] [--serial LOG] FILE.pcap
#
# FILE.pcap is what QEMU's `-object filter-dump,netdev=…,file=…` wrote:
# the classic pcap format (a 24-byte header, magic 0xa1b2c3d4 in the
# writer's byte order, link type 1, Ethernet; then per frame a 16-byte
# record header and the frame, without a checksum), every frame that
# crossed the netdev, in order, both ways.
#
# The checker knows no script. It reads the capture once, in order, with
# a model of what PAX must do (tools/paxnet.py, written from the RFCs):
# every frame that reaches PAX is judged by the model — which recomputes
# every IP header checksum and every ICMP checksum — and either obliges
# PAX to a frame or to silence; every frame PAX sends must be one the
# model obliges or allows, and is rebuilt from its meaning and compared
# with the capture **byte for byte**:
#
#   an ARP request     60 bytes: RFC 826's 42, PAX's addresses as the
#                      sender, the target hardware address zero, padded
#                      with zeros
#   an ARP reply       60 bytes, to the oldest request for PAX's address
#                      still unanswered, and to nobody else
#   an echo request    identifier 0x5058, a sequence number above the
#                      last, data byte k = 7k mod 256
#   an echo reply      to the oldest echo request still unanswered: the
#                      request's ICMP message with type 0 and the
#                      checksum recomputed
#   a destination      (type 3, code 2) for a datagram of an unknown
#   unreachable        protocol not yet answered, quoting its header and
#                      up to 8 data bytes; the ones passed over were
#                      held back by the limit and are counted so
#   every datagram     version 4, IHL 5, DF, time to live 64, protocol
#                      1, from 10.0.2.15, its header checksum right, its
#                      identification above the last one (the gaps are
#                      datagrams that never reached the wire: counted),
#                      in a frame for the hardware address its next hop
#                      (the destination on 10.0.2.0/24, else 10.0.2.2)
#                      last announced in an ARP packet
#   type 0x88b5        the kernel's ready frame, or burst frames: --small
#                      of 60 bytes then --large of 1514, bytes 14-17 the
#                      frame's number and byte k after them 7k mod 256
#
# and nothing else — but, before the kernel's first frame, whatever the
# firmware sent while it had the device (OVMF's own driver announces an
# IPv6 address on some boots; counted and printed). At the capture's end
# no echo request and no ARP request for PAX may be left unanswered.
#
# What the model made of the frames that reached PAX is printed as
# counts under the kernel's own counter names (`ip.checksum=1`). With
# --serial LOG (the kernel's serial log of the same boot) they are held
# against the counters the kernel printed before it halted, one by one:
# the frames each way; ARP's requests and replies each way, its bad
# packets and conflicts; every one of kernel/ip's drop causes, what it
# delivered and what it sent; kernel/icmp's echoes each way, its
# matched and stray replies, its drops, and the destination
# unreachables sent, held back and never due. A datagram PAX counted as
# sent that is not in the capture must be one kernel/arp says it
# dropped from a queue (the identifications' gaps). The kernel's own
# books are closed too: every transmit buffer reclaimed, every received
# one restocked, every queued frame sent, pushed out or given up.
#
# Prints what it found and, last, `pcap-net: PASS <counts>` or `pcap-net:
# FAIL <the first frame that is wrong, with the expected and found
# bytes>`. --list K also prints the first K frames in hex. Exit 0 on
# PASS, 1 on FAIL, 2 on a usage or format error.
#
# Written from the pcap file format as the libpcap documentation
# (pcap-savefile(5)) gives it and the RFCs tools/paxnet.py names. No
# network stack's source.
import os
import struct
import sys

sys.dont_write_bytecode = True  # no tools/__pycache__ in the tree
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import paxnet as px  # noqa: E402


def die(msg):
    print("pcap-net: " + msg, file=sys.stderr)
    sys.exit(2)


def frames_of(path):
    d = open(path, "rb").read()
    if len(d) < 24:
        die("%s: shorter than a pcap header" % path)
    magic = d[:4]
    if magic == b"\xd4\xc3\xb2\xa1":
        e = "<"
    elif magic == b"\xa1\xb2\xc3\xd4":
        e = ">"
    else:
        die("%s: not a classic pcap file (magic %s)" % (path, magic.hex()))
    link = struct.unpack(e + "I", d[20:24])[0]
    if link != 1:
        die("%s: link type %d, not Ethernet" % (path, link))
    out = []
    o = 24
    while o < len(d):
        if o + 16 > len(d):
            die("%s: a record header runs past the end at byte %d" % (path, o))
        _s, _us, cap, orig = struct.unpack(e + "IIII", d[o:o + 16])
        if cap != orig or o + 16 + cap > len(d):
            die("%s: frame %d is cut short (%d of %d bytes)" % (path, len(out), cap, orig))
        out.append(d[o + 16:o + 16 + cap])
        o += 16 + cap
    return out


CAUSES = ["ip.short", "ip.version", "ip.ihl", "ip.checksum", "ip.length", "ip.ttl", "ip.fragment", "ip.source",
          "ip.option", "ip.source-route", "ip.other", "icmp.short", "icmp.checksum", "icmp.broadcast", "icmp.type"]
KEYS = (["from-pax", "to-pax", "before", "net.type", "net.other", "arp.requests-out", "arp.replies-out", "arp.request",
         "arp.reply", "arp.bad", "arp.conflict", "arp.other", "ip.delivered", "ip.with-options", "ip.broadcast",
         "ip.protocol", "ip.out", "ident-gaps"] + CAUSES +
        ["icmp.echo", "icmp.replies-out", "icmp.requests-out", "icmp.matched", "icmp.stray", "unreachable.sent",
         "unreachable.limited", "unreachable.silent", "markers", "burst.small", "burst.large", "checksums"])


LINES = [
    (r"net: rx (\d+) frames (\d+) bytes, dropped (\d+) runt (\d+) long (\d+) other (\d+) type",
     ["rx", "rx-bytes", "runt", "long", "other", "type"]),
    (r"net: tx (\d+) frames (\d+) bytes, dropped (\d+) down (\d+) size (\d+) full; (\d+) interrupts \((\d+) idle\), (\d+) wakes, "
     r"(\d+) reclaimed, (\d+) restocked, (\d+) of 64 transmit buffers free",
     ["tx", "tx-bytes", "down", "size", "full", "irq", "idle", "wakes", "reclaimed", "restocked", "free"]),
    (r"arp: (\d+) requests sent, (\d+) replies received, (\d+) requests answered \((\d+) replies sent\), (\d+) bad, (\d+) conflict",
     ["a-req-out", "a-rep-in", "a-req-in", "a-rep-out", "a-bad", "a-conflict"]),
    (r"arp: cache (\d+) learned, (\d+) updated, (\d+) aged; pending (\d+) queued, (\d+) sent, (\d+) pushed out, (\d+) unresolved "
     r"\((\d+) addresses given up\), (\d+) table full",
     ["learned", "updated", "aged", "queued", "flushed", "pushed", "unresolved", "gave-up", "table-full"]),
    (r"ip: rx (\d+) datagrams delivered \((\d+) with options, (\d+) broadcast\), dropped (\d+) short (\d+) version (\d+) ihl "
     r"(\d+) checksum (\d+) length (\d+) ttl (\d+) fragment (\d+) source (\d+) option (\d+) source-route (\d+) other (\d+) protocol",
     ["ip.delivered", "ip.with-options", "ip.broadcast", "ip.short", "ip.version", "ip.ihl", "ip.checksum", "ip.length", "ip.ttl",
      "ip.fragment", "ip.source", "ip.option", "ip.source-route", "ip.other", "ip.protocol"]),
    (r"ip: tx (\d+) datagrams, not sent (\d+) size (\d+) dropped", ["ip-tx", "ip-size", "ip-dropped"]),
    (r"icmp: echo (\d+) requests answered \((\d+) replies sent\), (\d+) requests sent, (\d+) replies matched, (\d+) stray; "
     r"dropped (\d+) short (\d+) checksum (\d+) broadcast (\d+) type",
     ["icmp.echo", "icmp.replies-out", "m-req-out", "icmp.matched", "icmp.stray", "icmp.short", "icmp.checksum", "icmp.broadcast",
      "icmp.type"]),
    (r"icmp: unreachable (\d+) sent, (\d+) limited, (\d+) silent; (\d+) not sent",
     ["unreachable.sent", "unreachable.limited", "unreachable.silent", "not-sent"]),
]


def against(path, c):
    """Hold the capture's counts `c` against the counter lines the
    kernel printed in the serial log at `path`: the mismatches, and how
    many values were held."""
    import re
    text = open(path, "rb").read().decode("latin-1").replace("\r", "")
    k = {}
    wrong = []
    for pat, names in LINES:
        found = None
        for line in text.split("\n"):
            m = re.fullmatch(pat, line.strip())
            if m:
                found = m
        if found is None:
            wrong.append("no line `%s…`" % pat[:28].replace("(\\d+)", "<n>"))
            continue
        for name, v in zip(names, found.groups()):
            k[name] = int(v)
    if wrong:
        return wrong, 0
    held = 0

    def hold(what, kernel, capture):
        nonlocal held
        held += 1
        if kernel != capture:
            wrong.append("%s: the kernel says %d, the capture %d" % (what, kernel, capture))

    # The model's counts under the kernel's names.
    for name in LINES[4][1] + ["icmp.echo", "icmp.replies-out", "icmp.matched", "icmp.stray", "icmp.short", "icmp.checksum",
                               "icmp.broadcast", "icmp.type", "unreachable.sent", "unreachable.limited", "unreachable.silent"]:
        hold(name, k[name], c[name])
    hold("frames received", k["rx"], c["to-pax"])
    hold("frames sent", k["tx"], c["from-pax"])
    hold("frames of a type nothing speaks", k["type"], c["net.type"])
    hold("ARP requests sent", k["a-req-out"], c["arp.requests-out"])
    hold("ARP replies received", k["a-rep-in"], c["arp.reply"])
    hold("ARP requests answered", k["a-req-in"], c["arp.request"])
    hold("ARP replies sent", k["a-rep-out"], c["arp.replies-out"])
    hold("ARP bad", k["a-bad"], c["arp.bad"])
    hold("ARP conflict", k["a-conflict"], c["arp.conflict"])
    # What was counted as sent and is not in the capture was dropped
    # from a queue, by name.
    lost = k["pushed"] + k["unresolved"]
    hold("datagrams that never reached the wire (pushed out + unresolved)", lost, c["ident-gaps"])
    hold("datagrams sent", k["ip-tx"], c["ip.out"] + c["ident-gaps"])
    hold("echo requests sent", k["m-req-out"], c["icmp.requests-out"] + c["ident-gaps"])
    # The kernel's own books.
    hold("transmit buffers reclaimed", k["reclaimed"], k["tx"])
    hold("receive buffers restocked", k["restocked"], k["rx"] + k["runt"] + k["long"] + k["other"])
    hold("transmit buffers free of 64", k["free"], 64)
    hold("queued frames accounted for (sent + pushed out + unresolved)", k["queued"], k["flushed"] + k["pushed"] + k["unresolved"])
    for name in ("runt", "long", "down", "size", "full", "idle", "not-sent", "ip-dropped", "table-full"):
        hold(name, k[name], 0)
    hold("frames for another station", k["other"], c["net.other"])
    return wrong, held


def main(argv):
    opt = {"small": "0", "large": "0", "list": "0", "serial": ""}
    path = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and a[2:] in opt and i + 1 < len(argv):
            opt[a[2:]] = argv[i + 1]
            i += 2
        elif a.startswith("--") or path is not None:
            die("usage: pcap-net [--small N] [--large N] [--list K] [--serial LOG] FILE.pcap")
        else:
            path = a
            i += 1
    if path is None:
        die("no capture file")
    try:
        small, large, show = int(opt["small"]), int(opt["large"]), int(opt["list"])
    except ValueError as x:
        die("bad argument: %s" % x)

    fs = frames_of(path)
    for n, f in enumerate(fs[:show]):
        print("frame %d: %d bytes %s" % (n, len(f), f.hex()))

    c = dict((k, 0) for k in KEYS)
    lengths = {}

    def fail(n, what, want=None):
        print("pcap-net: FAIL frame %d of %d: %s" % (n, len(fs), what))
        if n < len(fs):
            print("  found    %d bytes %s" % (len(fs[n]), fs[n][:120].hex()))
        if want is not None:
            print("  expected %d bytes %s" % (len(want), want[:120].hex()))
        sys.exit(1)

    pattern = px.pattern(1514)

    def burst_frame(to, seq, length):
        f = bytearray(to + px.PAX_MAC + px.EXPERIMENTAL + pattern[14:length])
        f[14:18] = struct.pack(">I", seq)
        return bytes(f)

    claims = {}       # protocol address -> the hardware address it last announced
    askers = []       # (hardware, protocol) of each request for PAX's address not yet answered
    echoes = []       # (frame, ihl, total) of each echo request to PAX not yet answered
    errors = []       # (frame, ihl, total) of each unknown-protocol datagram not yet answered
    awaited = None    # [dst, seq, data bytes, answered] of PAX's last echo request on the wire
    last_ident = None
    last_seq = 0
    started = False   # PAX's kernel has sent a frame

    for n, f in enumerate(fs):
        if len(f) < 14:
            fail(n, "a frame shorter than its header")
        kind = f[12:14]
        if f[6:12] == px.PAX_MAC:
            # ---- a frame PAX's station sent -------------------------------
            if kind not in (b"\x08\x06", b"\x08\x00", px.EXPERIMENTAL):
                if started:
                    fail(n, "a frame of type %s from PAX's address after the kernel's first" % kind.hex())
                print("before the kernel: frame %d: %d bytes, type %s: %s" % (n, len(f), kind.hex(), f[:96].hex()))
                c["before"] += 1
                continue
            started = True
            c["from-pax"] += 1
            if kind == b"\x08\x06":
                if len(f) >= 42 and px.be16(f, 20) == 1:
                    want = px.pax_arp_request(f[38:42])
                    if f != want:
                        fail(n, "not PAX's ARP request for %s, byte for byte" % px.dotted(f[38:42]), want)
                    c["arp.requests-out"] += 1
                else:
                    if not askers:
                        fail(n, "an ARP reply from PAX with no request for its address unanswered")
                    hw, pa = askers.pop(0)
                    want = px.pax_arp_reply(hw, pa)
                    if f != want:
                        fail(n, "not PAX's ARP reply to %s (%s), byte for byte" % (px.dotted(pa), hw.hex(":")), want)
                    c["arp.replies-out"] += 1
                continue
            if kind == px.EXPERIMENTAL:
                if f == px.MARKER:
                    c["markers"] += 1
                    continue
                which = "burst.small" if len(f) == 60 else "burst.large"
                want = burst_frame(f[:6], c[which], 60 if which == "burst.small" else 1514)
                if f != want or (which == "burst.small" and c["burst.large"]):
                    fail(n, "not the ready frame, nor burst frame %d of its size, byte for byte" % c[which], want)
                if claims.get(px.GW_IP) != f[:6]:
                    fail(n, "a burst frame for a hardware address the gateway did not announce")
                c[which] += 1
                continue
            # A datagram.
            if len(f) < 42 or f[14] != 0x45:
                fail(n, "a datagram from PAX that is not version 4 with a 20-byte header")
            h = f[14:]
            total = px.be16(h, 2)
            ident = px.be16(h, 4)
            dst = h[16:20]
            if 14 + total > len(f) or total < 28:
                fail(n, "a datagram from PAX whose total length (%d) is not its frame's" % total)
            if last_ident is not None and ident <= last_ident:
                fail(n, "PAX's identification went from %d to %d" % (last_ident, ident))
            c["ident-gaps"] += ident - (last_ident + 1 if last_ident is not None else 0)
            last_ident = ident
            c["ip.out"] += 1
            c["checksums"] += 2
            if px.is_broadcast(dst):
                to = px.BCAST
            else:
                to = claims.get(px.next_hop(dst))
                if to is None:
                    fail(n, "a datagram for %s, whose next hop %s announced no hardware address" % (px.dotted(dst), px.dotted(px.next_hop(dst))))
            m = h[20:total]
            if m[0] == 8:
                seq = px.be16(m, 6)
                want = px.echo_request_from_pax(dst, seq, total - 28, ident, to)
                if f != want or seq <= last_seq:
                    fail(n, "not an echo request from PAX (sequence %d after %d, %d data bytes) for %s by way of %s, byte for byte"
                         % (seq, last_seq, total - 28, px.dotted(dst), to.hex(":")), want)
                last_seq = seq
                awaited = [dst, seq, total - 28, False]
                c["icmp.requests-out"] += 1
            elif m[0] == 0:
                if not echoes:
                    fail(n, "an echo reply from PAX with no echo request unanswered")
                rf, rihl, rtotal = echoes.pop(0)
                want = px.echo_reply_to(rf, rihl, rtotal, ident, to)
                if f != want:
                    fail(n, "not PAX's reply to the oldest unanswered echo request (from %s), byte for byte" % px.dotted(rf[26:30]), want)
                c["icmp.replies-out"] += 1
            elif m[0] == 3:
                hit = None
                for k, (ef, eihl, etotal) in enumerate(errors):
                    want = px.unreachable_for(ef, eihl, etotal, ident, to)
                    if f == want:
                        hit = k
                        break
                if hit is None:
                    fail(n, "a destination unreachable from PAX that quotes no unanswered datagram of an unknown protocol, byte for byte",
                         px.unreachable_for(errors[0][0], errors[0][1], errors[0][2], ident, to) if errors else None)
                c["unreachable.limited"] += hit
                del errors[:hit + 1]
                c["unreachable.sent"] += 1
            else:
                fail(n, "an ICMP message of type %d from PAX" % m[0])
            continue

        # ---- a frame somebody else sent ----------------------------------
        if f[:6] != px.PAX_MAC and not f[0] & 1:
            c["net.other"] += 1  # for another station
            continue
        c["to-pax"] += 1
        lengths[len(f)] = lengths.get(len(f), 0) + 1
        if kind == b"\x08\x06":
            verdict, teaches = px.judge_arp(f)
            c["arp." + verdict] += 1
            if teaches:
                claims[f[28:32]] = f[22:28]
            if verdict == "request":
                askers.append((f[22:28], f[28:32]))
            continue
        if kind != b"\x08\x00":
            c["net.type"] += 1
            continue
        verdict, ihl, total = px.judge_ip(f)
        c["checksums"] += 1
        if verdict in CAUSES:
            c[verdict] += 1
        if not verdict.startswith("ip."):
            # The header passed.
            if ihl > 20:
                c["ip.with-options"] += 1
            if px.is_broadcast(f[30:34]):
                c["ip.broadcast"] += 1
            if verdict in ("unreachable", "silent"):
                c["ip.protocol"] += 1
            else:
                c["ip.delivered"] += 1
                c["checksums"] += 1
        if verdict == "echo":
            echoes.append((f, ihl, total))
            c["icmp.echo"] += 1
        elif verdict == "reply":
            m = f[14 + ihl:14 + total]
            if (awaited is not None and not awaited[3] and f[26:30] == awaited[0] and px.be16(m, 4) == px.ECHO_IDENT
                    and px.be16(m, 6) == awaited[1] and m[8:] == px.pattern(awaited[2])):
                awaited[3] = True
                c["icmp.matched"] += 1
            else:
                c["icmp.stray"] += 1
        elif verdict == "unreachable":
            errors.append((f, ihl, total))
        elif verdict == "silent":
            c["unreachable.silent"] += 1

    n = len(fs)
    if echoes:
        fail(n, "the capture ends with %d echo requests to PAX unanswered; the oldest is from %s" % (len(echoes), px.dotted(echoes[0][0][26:30])))
    if askers:
        fail(n, "the capture ends with %d ARP requests for PAX's address unanswered" % len(askers))
    c["unreachable.limited"] += len(errors)
    if c["burst.small"] != small or c["burst.large"] != large:
        fail(n, "%d burst frames of 60 bytes and %d of 1514; %d and %d were due" % (c["burst.small"], c["burst.large"], small, large))
    print("pcap-net: %d frames: %d before the kernel's first; %d from PAX, each rebuilt and equal byte for byte; %d to PAX or to everyone "
          "(lengths %s), each judged; %d for another station; %d checksums recomputed"
          % (len(fs), c["before"], c["from-pax"], c["to-pax"],
             " ".join("%d:%d" % kv for kv in sorted(lengths.items())[:12]) + (" …" if len(lengths) > 12 else ""),
             c["net.other"], c["checksums"]))
    if opt["serial"]:
        wrong, held = against(opt["serial"], c)
        if wrong:
            print("pcap-net: FAIL the kernel's counters are not the capture's: " + "; ".join(wrong))
            return 1
        print("pcap-net: the kernel's counters are the capture's (%d held)" % held)
    print("pcap-net: PASS " + " ".join("%s=%d" % (k, c[k]) for k in KEYS))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
