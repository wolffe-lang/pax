#!/usr/bin/env python3
# pcap-net — hold a capture of the network test kernel's exchange to the
# frames it must contain, byte by byte (px20, px21, px22, px23;
# tests/mpx4-net, tests/mpx4-udp, tests/mpx4-tcp).
#
#   tools/pcap-net [--small N] [--large N] [--list K] [--serial LOG] [--tcp] FILE.pcap
#
# FILE.pcap is what QEMU's `-object filter-dump,netdev=…,file=…` wrote:
# the classic pcap format (a 24-byte header, magic 0xa1b2c3d4 in the
# writer's byte order, link type 1, Ethernet; then per frame a 16-byte
# record header and the frame, without a checksum), every frame that
# crossed the netdev, in order, both ways.
#
# The checker knows no script. It reads the capture once, in order, with
# a model of what PAX must do (tools/paxnet.py, written from the RFCs):
# every frame that reaches PAX is judged by the model — which recomputes
# every IP header checksum and every ICMP checksum — and either obliges
# PAX to a frame or to silence; every frame PAX sends must be one the
# model obliges or allows, and is rebuilt from its meaning and compared
# with the capture **byte for byte**:
#
#   an ARP request     60 bytes: RFC 826's 42, PAX's addresses as the
#                      sender, the target hardware address zero, padded
#                      with zeros
#   an ARP reply       60 bytes, to the oldest request for PAX's address
#                      still unanswered, and to nobody else
#   an echo request    identifier 0x5058, a sequence number above the
#                      last, data byte k = 7k mod 256
#   an echo reply      to the oldest echo request still unanswered: the
#                      request's ICMP message with type 0 and the
#                      checksum recomputed
#   a destination      (type 3, code 2) for a datagram of an unknown
#   unreachable        protocol not yet answered, quoting its header and
#                      up to 8 data bytes; the ones passed over were
#                      held back by the limit and are counted so
#   a port             (type 3, code 3; px22) for a UDP datagram that
#   unreachable        reached PAX whole and has not drawn one, quoting
#                      its header and 8 bytes
#   a UDP datagram     (px22) rebuilt from its ports and data, its
#                      checksum made (never zero) and right; from port 7
#                      (RFC 862's echo, user/net/udpecho) it carries the
#                      data of a datagram that reached port 7 from where
#                      it now goes and has not been echoed — or "ready",
#                      the server's first word (user/net/udphold's too,
#                      from port 4030); from any other port, the port is
#                      an ephemeral one (32768-60999); and never
#                      for 10.0.2.15 itself or 127/8: what loops back
#                      does not touch the wire
#   a TCP segment      (px23, with --tcp: the kernel speaks TCP) rebuilt
#                      from its fields — a 20-byte header, the MSS
#                      option (1460) on a SYN and no option on anything
#                      else, the checksum made — and held to its
#                      connection as the capture shows it so far: a
#                      SYN-ACK answers a SYN that reached PAX and a
#                      segment belongs to a connection whose SYNs were
#                      seen, or is a reset in RFC 9293 §3.10.7.1's form
#                      for the last segment sent to PAX from there;
#                      **its acknowledgement never names a byte that
#                      has not been sent to PAX** and never goes back;
#                      its data ends inside the window the other end
#                      last opened (one byte past it is a probe), is no
#                      longer than the MSS the other end announced, and
#                      is the same bytes whenever a sequence number is
#                      sent again; the window's right edge it
#                      advertises never moves back; nothing follows its
#                      FIN but that FIN again. A segment that carries a
#                      sequence number PAX sent before is counted a
#                      retransmission
#   every datagram     version 4, IHL 5, DF, time to live 64, protocol
#                      1, 6 or 17, from 10.0.2.15, its header checksum right, its
#                      identification above the last one, modulo 65536 (the gaps are
#                      datagrams that never reached the wire: counted),
#                      in a frame for the hardware address its next hop
#                      (the destination on 10.0.2.0/24, else 10.0.2.2)
#                      last announced in an ARP packet
#   type 0x88b5        the kernel's ready frame, or burst frames: --small
#                      of 60 bytes then --large of 1514, bytes 14-17 the
#                      frame's number and byte k after them 7k mod 256
#
# and nothing else — but, before the kernel's first frame, whatever the
# firmware sent while it had the device (OVMF's own driver announces an
# IPv6 address on some boots; counted and printed). At the capture's end
# no echo request and no ARP request for PAX may be left unanswered.
#
# What the model made of the frames that reached PAX is printed as
# counts under the kernel's own counter names (`ip.checksum=1`). With
# --serial LOG (the kernel's serial log of the same boot) they are held
# against the counters the kernel printed before it halted, one by one:
# the frames each way; ARP's requests and replies each way, its bad
# packets and conflicts; every one of kernel/ip's drop causes, what it
# delivered and what it sent; kernel/icmp's echoes each way, its
# matched and stray replies, its drops, and the destination
# unreachables sent, held back and never due; and (px22) kernel/udp's:
# its drop causes; every whole UDP datagram that reached PAX either
# queued for a socket, dropped for a full queue or found no socket;
# every one with no socket either answered with a port unreachable (as
# many as the capture holds), held back, or never due; as many sent as
# the capture holds; and its own books: every queued datagram read,
# dropped at its socket's close or still waiting, every looped one
# queued or dropped by name, every socket made freed or still open. A
# And (px23) kernel/tcp's: its six drop causes; the segments it took
# and the segments it sent, less those it says went over loopback, are
# the capture's; and **its retransmissions, less loopback's, are the
# capture's count of segments that carried a sequence number again**.
# A datagram PAX counted as
# sent that is not in the capture must be one kernel/arp says it
# dropped from a queue (the identifications' gaps). The kernel's own
# books are closed too: every transmit buffer reclaimed, every received
# one restocked, every queued frame sent, pushed out or given up.
#
# Prints what it found and, last, `pcap-net: PASS <counts>` or `pcap-net:
# FAIL <the first frame that is wrong, with the expected and found
# bytes>`. --list K also prints the first K frames in hex. Exit 0 on
# PASS, 1 on FAIL, 2 on a usage or format error.
#
# Written from the pcap file format as the libpcap documentation
# (pcap-savefile(5)) gives it and the RFCs tools/paxnet.py names. No
# network stack's source.
import os
import struct
import sys

sys.dont_write_bytecode = True  # no tools/__pycache__ in the tree
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import paxnet as px  # noqa: E402


def die(msg):
    print("pcap-net: " + msg, file=sys.stderr)
    sys.exit(2)


def frames_of(path):
    d = open(path, "rb").read()
    if len(d) < 24:
        die("%s: shorter than a pcap header" % path)
    magic = d[:4]
    if magic == b"\xd4\xc3\xb2\xa1":
        e = "<"
    elif magic == b"\xa1\xb2\xc3\xd4":
        e = ">"
    else:
        die("%s: not a classic pcap file (magic %s)" % (path, magic.hex()))
    link = struct.unpack(e + "I", d[20:24])[0]
    if link != 1:
        die("%s: link type %d, not Ethernet" % (path, link))
    out = []
    o = 24
    while o < len(d):
        if o + 16 > len(d):
            die("%s: a record header runs past the end at byte %d" % (path, o))
        _s, _us, cap, orig = struct.unpack(e + "IIII", d[o:o + 16])
        if cap != orig or o + 16 + cap > len(d):
            die("%s: frame %d is cut short (%d of %d bytes)" % (path, len(out), cap, orig))
        out.append(d[o + 16:o + 16 + cap])
        o += 16 + cap
    return out


