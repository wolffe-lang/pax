def against(path, c, tcp=False):
    """Hold the capture's counts `c` against the counter lines the
    kernel printed in the serial log at `path`: the mismatches, and how
    many values were held."""
    import re
    text = open(path, "rb").read().decode("latin-1").replace("\r", "")
    k = {}
    wrong = []
    for pat, names in LINES + (TCP_LINES if tcp else []):
        found = None
        for line in text.split("\n"):
            m = re.fullmatch(pat, line.strip())
            if m:
                found = m
        if found is None:
            wrong.append("no line `%s…`" % pat[:28].replace("(\\d+)", "<n>"))
            continue
        for name, v in zip(names, found.groups()):
            k[name] = int(v)
    if wrong:
        return wrong, 0
    held = 0

    def hold(what, kernel, capture):
        nonlocal held
        held += 1
        if kernel != capture:
            wrong.append("%s: the kernel says %d, the capture %d" % (what, kernel, capture))

    # The model's counts under the kernel's names.
    for name in LINES[4][1] + ["icmp.echo", "icmp.replies-out", "icmp.matched", "icmp.stray", "icmp.short", "icmp.checksum",
                               "icmp.broadcast", "icmp.type", "udp.unchecked", "udp.short", "udp.length", "udp.checksum",
                               "udp.port-zero"]:
        hold(name, k[name], c[name])
    # kernel/icmp's errors are the protocol's (the capture's) and the
    # port's (kernel/udp's own account of them).
    hold("destination unreachables sent (protocol + port)", k["unreachable.sent"], c["unreachable.sent"] + c["port-unreachable.sent"])
    hold("destination unreachables held back (protocol + port)", k["unreachable.limited"], c["unreachable.limited"] + k["u-limited"])
    hold("destination unreachables never due (protocol + port)", k["unreachable.silent"], c["unreachable.silent"] + k["u-silent"])
    # kernel/udp (px22).
    hold("UDP datagrams that reached PAX whole (queued + no-port + full)", k["u-rx"] + k["u-no-port"] + k["u-full"], c["udp.in"])
    hold("port unreachables sent", k["u-sent"], c["port-unreachable.sent"])
    hold("no-port datagrams accounted for (sent + limited + silent + not sent)", k["u-no-port"],
         k["u-sent"] + k["u-limited"] + k["u-silent"] + k["u-not-sent"])
    hold("UDP datagrams sent", k["u-tx"], c["udp.out"])
    hold("queued datagrams accounted for (read + dropped at close + waiting)", k["u-rx"] + k["l-queued"],
         k["d-read"] + k["d-closed"] + k["d-waiting"])
    hold("looped datagrams accounted for (queued + no-port + full)", k["l-sent"], k["l-queued"] + k["l-no-port"] + k["l-full"])
    hold("sockets accounted for (freed + open)", k["s-made"], k["s-freed"] + k["s-open"])
    for name in ("u-not-sent", "u-tx-failed"):
        hold(name, k[name], 0)
    hold("frames received", k["rx"], c["to-pax"])
    hold("frames sent", k["tx"], c["from-pax"])
    hold("frames of a type nothing speaks", k["type"], c["net.type"])
    hold("ARP requests sent", k["a-req-out"], c["arp.requests-out"])
    hold("ARP replies received", k["a-rep-in"], c["arp.reply"])
    hold("ARP requests answered", k["a-req-in"], c["arp.request"])
    hold("ARP replies sent", k["a-rep-out"], c["arp.replies-out"])
    hold("ARP bad", k["a-bad"], c["arp.bad"])
    hold("ARP conflict", k["a-conflict"], c["arp.conflict"])
    # What was counted as sent and is not in the capture was dropped
    # from a queue, by name.
    lost = k["pushed"] + k["unresolved"]
    hold("datagrams that never reached the wire (pushed out + unresolved)", lost, c["ident-gaps"])
    hold("datagrams sent", k["ip-tx"], c["ip.out"] + c["ident-gaps"])
    if not tcp:
        hold("echo requests sent", k["m-req-out"], c["icmp.requests-out"] + c["ident-gaps"])
    # The kernel's own books.
    hold("transmit buffers reclaimed", k["reclaimed"], k["tx"])
    hold("receive buffers restocked", k["restocked"], k["rx"] + k["runt"] + k["long"] + k["other"])
    hold("transmit buffers free of 64", k["free"], 64)
    hold("queued frames accounted for (sent + pushed out + unresolved)", k["queued"], k["flushed"] + k["pushed"] + k["unresolved"])
    for name in ("runt", "long", "down", "size", "full", "idle", "not-sent", "ip-dropped", "table-full"):
        hold(name, k[name], 0)
    hold("frames for another station", k["other"], c["net.other"])
    # px23: destination unreachables that reached PAX whole.
    hold("ICMP errors received from the wire", k["icmp.error"], c["icmp.error"])
    if tcp:
        # kernel/tcp (px23): the wire's share of what it counts.
        for name in ("tcp.short", "tcp.header", "tcp.checksum", "tcp.broadcast", "tcp.port-zero", "tcp.option"):
            hold(name, k[name], c[name])
        hold("TCP segments taken (all less loopback's)", k["t-rx"] - k["tl-rx"], c["tcp.in"])
        # px24: a datagram pushed out of kernel/arp's queue (an entry
        # that aged while several connections were sending) was counted
        # as sent and never reached the wire. Each is an echo request
        # or a segment, the two together are the gaps in the
        # identifications, and a segment retransmitted because its
        # first sending was pushed out is, to the capture, a first
        # sending.
        lost_echo = k["m-req-out"] - c["icmp.requests-out"]
        lost_tcp = k["t-tx"] - k["tl-tx"] - c["tcp.out"]
        hold("echo requests and TCP segments that never reached the wire (none fewer than none)", min(lost_echo, lost_tcp, 0), 0)
        hold("echo requests and TCP segments sent (all less loopback's and what never reached the wire)", lost_echo + lost_tcp, c["ident-gaps"])
        rex = k["t-rexmt"] - k["tl-rexmt"]
        hold("TCP segments retransmitted (all less loopback's; at most as many fewer in the capture as segments never reached the wire)",
             rex if c["tcp.retransmitted"] <= rex <= c["tcp.retransmitted"] + max(lost_tcp, 0) else -1, rex)
        hold("t-not-sent", k["t-not-sent"], 0)
    return wrong, held


class TcpConn:
    """One connection as the capture shows it so far."""

    def __init__(self):
        self.gaps_seen = 0     # the count of identification gaps when PAX last sent on this connection
        self.unknown = []      # ranges of `buf` never seen on the wire (pushed out of kernel/arp's queue)
        self.pax_iss = None    # PAX's SYN's sequence number
        self.pax_max = None    # the end of the highest sequence number PAX has sent
        self.pax_ack = None    # the last acknowledgement PAX sent
        self.pax_edge = None   # the right edge of the window PAX last advertised
        self.pax_fin = None    # the sequence number of PAX's FIN
        self.peer_iss = None
        self.peer_max = None   # the end of the highest sequence number sent to PAX
        self.peer_edge = None  # the furthest right edge the other end has opened
        self.peer_mss = 536
        self.peer_fin = None   # the sequence number of the FIN sent to PAX
        self.base = None       # the sequence number of buf[0]
        self.buf = bytearray()  # what PAX sent from `base` on (pruned as it is acknowledged)


def tcp_in(conns, last_in, key, seg, c):
    """A valid segment that reached PAX: what the capture now knows. A
    bare SYN makes no connection by itself (PAX may take it, drop it or
    answer it with an ACK): it waits in `last_in[("syn",) + key]` for
    PAX's SYN-ACK to say it was taken."""
    last_in[key] = seg
    k = conns.get(key)
    fl = seg.flags
    if fl & px.SYN and not fl & (px.ACK | px.RST):
        last_in[("syn",) + key] = seg
        if k is None or k.peer_iss is not None:
            return
        # PAX's own SYN is out and this one crossed it: taken when PAX
        # answers it (tcp_out).
        return
    if k is None:
        return
    if fl & px.SYN and fl & px.ACK and not fl & px.RST and k.pax_iss is not None and k.peer_iss is None and seg.ack == (k.pax_iss + 1) & px.M32:
        k.peer_iss = seg.seq
        if seg.mss() is not None:
            k.peer_mss = min(seg.mss(), px.MSS)
    if k.peer_iss is None:
        return
    end = (seg.seq + seg.space) & px.M32
    if k.peer_max is None or px.seq_lt(k.peer_max, end):
        k.peer_max = end
    if fl & px.FIN and not fl & px.RST and k.peer_fin is None:
        k.peer_fin = (seg.seq + len(seg.data)) & px.M32
    if fl & px.ACK and not fl & px.RST:
        edge = (seg.ack + seg.window) & px.M32
        if k.peer_edge is None or px.seq_lt(k.peer_edge, edge):
            k.peer_edge = edge
        # What it acknowledges need not be kept.
        if k.base is not None and px.seq_lt(k.base, seg.ack):
            gone = min((seg.ack - k.base) & px.M32, len(k.buf))
            del k.buf[:gone]
            k.unknown = [(max(lo - gone, 0), hi - gone) for lo, hi in k.unknown if hi > gone]
            k.base = (k.base + gone) & px.M32


def reset_form(seg, trigger):
    """Whether `seg`, a reset from PAX, is RFC 9293 §3.10.7.1's answer
    to `trigger`, a segment that reached PAX and named no connection."""
    if trigger is None:
        return False
    if trigger.flags & px.ACK:
        return seg.flags == px.RST and seg.seq == trigger.ack
    return seg.flags == px.RST | px.ACK and seg.seq == 0 and seg.ack == (trigger.seq + trigger.space) & px.M32


def tcp_out(conns, last_in, key, seg, c):
    """A segment PAX sent, against its connection as the capture shows
    it: None, or what is wrong with it."""
    k = conns.get(key)
    fl = seg.flags
    if fl & px.RST:
        c["tcp.resets-out"] += 1
        if reset_form(seg, last_in.get(key)):
            return None
        if k is not None and k.pax_max is not None and seg.seq == k.pax_max:
            return None  # a connection PAX ends itself: its own next sequence number
        return "is a reset neither at PAX's own next sequence number nor in RFC 9293's form for the last segment sent to it"
    if fl & px.SYN:
        if seg.data:
            return "is a SYN with data"
        p = last_in.get(("syn",) + key)
        if not fl & px.ACK:
            # PAX opens a connection (or sends its SYN again).
            if k is None or k.pax_iss != seg.seq:
                k = conns[key] = TcpConn()
                c["tcp.connections"] += 1
                k.pax_iss = seg.seq
                k.base = (seg.seq + 1) & px.M32
            if seg.sport not in px.EPHEMERAL:
                return "is a SYN from port %d, which is not an ephemeral port" % seg.sport
        else:
            if p is None or seg.ack != (p.seq + 1) & px.M32:
                return "is a SYN-ACK that acknowledges no SYN sent to PAX from there"
            if k is None or k.pax_iss != seg.seq:
                # PAX took the SYN: a connection.
                k = conns[key] = TcpConn()
                c["tcp.connections"] += 1
                k.pax_iss = seg.seq
                k.base = (seg.seq + 1) & px.M32
            if k.peer_iss is None:
                # (Also where the SYNs crossed: PAX's own was out first.)
                k.peer_iss = p.seq
                k.peer_max = (p.seq + p.space) & px.M32
                if p.mss() is not None:
                    k.peer_mss = min(p.mss(), px.MSS)
            elif k.peer_iss != p.seq:
                return "is a SYN-ACK with the sequence number of another connection's"
    elif k is None or k.pax_iss is None or k.peer_iss is None:
        return "belongs to no connection whose SYNs the capture holds"
    elif not fl & px.ACK:
        return "has neither SYN, RST nor ACK"
    if fl & px.ACK:
        if k.peer_max is None or px.seq_lt(k.peer_max, seg.ack):
            return "acknowledges %d, a byte never sent to PAX (the last was before %s)" % (seg.ack, k.peer_max)
        if k.pax_ack is not None and px.seq_lt(seg.ack, k.pax_ack):
            return "takes an acknowledgement back (from %d to %d)" % (k.pax_ack, seg.ack)
        k.pax_ack = seg.ack
        edge = (seg.ack + seg.window) & px.M32
        # Once PAX has acknowledged the other end's FIN nothing more can
        # be sent to it: its window says nothing (a time-wait entry's
        # acknowledgement advertises none).
        over = k.peer_fin is not None and seg.ack == (k.peer_fin + 1) & px.M32
        if not over:
            if k.pax_edge is not None and px.seq_lt(edge, k.pax_edge):
                return "moves the window's right edge back (from %d to %d)" % (k.pax_edge, edge)
            k.pax_edge = edge
    if seg.space:
        if k.pax_max is not None and px.seq_lt(seg.seq, k.pax_max):
            c["tcp.retransmitted"] += 1
        if not fl & px.SYN and px.seq_lt(seg.seq, (k.pax_iss + 1) & px.M32):
            return "starts before the connection's first byte"
    if seg.data:
        if len(seg.data) > k.peer_mss:
            return "carries %d bytes, more than the %d the other end's MSS allows" % (len(seg.data), k.peer_mss)
        end = (seg.seq + len(seg.data)) & px.M32
        if k.peer_edge is not None and px.seq_lt(k.peer_edge, end):
            if len(seg.data) == 1 and seg.seq == k.peer_edge:
                c["tcp.probes"] += 1
            else:
                return "ends at %d, past the window's edge %d" % (end, k.peer_edge)
        if k.pax_fin is not None and px.seq_lt(k.pax_fin, end):
            return "carries data past its own FIN"
        # The same bytes whenever a sequence number is sent again.
        if px.seq_lt(seg.seq, k.base):
            skip = (k.base - seg.seq) & px.M32
            data, at = seg.data[skip:], 0
        else:
            data, at = seg.data, (seg.seq - k.base) & px.M32
        if at > len(k.buf):
            # px24: segments PAX counted as sent and kernel/arp pushed
            # out of its queue (an entry that aged while a window was
            # going out) never reached the wire: the bytes between are
            # unknown until PAX retransmits them. Allowed only where the
            # IP identifications show datagrams missing just here, and
            # the kernel's own count of what it pushed out is held to
            # those gaps at the end (`against`).
            if c["ident-gaps"] == k.gaps_seen:
                return "leaves a gap in what PAX has sent (from %d)" % ((k.base + len(k.buf)) & px.M32)
            k.unknown.append((len(k.buf), at))
            k.buf += bytes(at - len(k.buf))
        k.gaps_seen = c["ident-gaps"]
        old = bytes(k.buf[at:at + len(data)])
        same = True
        for i in range(len(old)):
            if old[i] != data[i] and not any(lo <= at + i < hi for lo, hi in k.unknown):
                same = False
                break
        if not same:
            return "carries other bytes than the first time for the same sequence numbers"
        fresh = len(data) - len(old) + sum(max(0, min(hi, at + len(old)) - max(lo, at)) for lo, hi in k.unknown)
        if k.unknown:
            k.unknown = [(lo, hi) for lo, hi in k.unknown if not (at <= lo and hi <= at + len(data))]
        k.buf[at:at + len(data)] = data
        c["tcp.bytes-out"] += fresh
    if fl & px.FIN:
        at = (seg.seq + len(seg.data)) & px.M32
        if k.pax_fin is not None and k.pax_fin != at:
            return "is a FIN at another sequence number than the first"
        k.pax_fin = at
    end = (seg.seq + seg.space) & px.M32
    if seg.space and (k.pax_max is None or px.seq_lt(k.pax_max, end)):
        k.pax_max = end
    if k.pax_max is None:
        k.pax_max = seg.seq
    return None


def main(argv):
    opt = {"small": "0", "large": "0", "list": "0", "serial": ""}
    path = None
    tcp = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--tcp":
            tcp = True
            px.TCP_SPOKEN = True
            i += 1
        elif a.startswith("--") and a[2:] in opt and i + 1 < len(argv):
            opt[a[2:]] = argv[i + 1]
            i += 2
        elif a.startswith("--") or path is not None:
            die("usage: pcap-net [--small N] [--large N] [--list K] [--serial LOG] [--tcp] FILE.pcap")
        else:
            path = a
            i += 1
    if path is None:
        die("no capture file")
    try:
        small, large, show = int(opt["small"]), int(opt["large"]), int(opt["list"])
    except ValueError as x:
        die("bad argument: %s" % x)

    fs = frames_of(path)
    for n, f in enumerate(fs[:show]):
        print("frame %d: %d bytes %s" % (n, len(f), f.hex()))

    c = dict((k, 0) for k in KEYS)
    lengths = {}

    def fail(n, what, want=None):
        print("pcap-net: FAIL frame %d of %d: %s" % (n, len(fs), what))
        if n < len(fs):
            print("  found    %d bytes %s" % (len(fs[n]), fs[n][:120].hex()))
        if want is not None:
            print("  expected %d bytes %s" % (len(want), want[:120].hex()))
        sys.exit(1)

    pattern = px.pattern(1514)

    def burst_frame(to, seq, length):
        f = bytearray(to + px.PAX_MAC + px.EXPERIMENTAL + pattern[14:length])
        f[14:18] = struct.pack(">I", seq)
        return bytes(f)

    claims = {}       # protocol address -> the hardware address it last announced
    askers = []       # (hardware, protocol) of each request for PAX's address not yet answered
    echoes = []       # (frame, ihl, total) of each echo request to PAX not yet answered
    errors = []       # (frame, ihl, total) of each unknown-protocol datagram not yet answered
    udp_seen = []     # (frame, ihl, total) of each whole UDP datagram to PAX that has drawn no error
    to_echo = {}      # (address, port) -> the data of each datagram it sent PAX's port 7, not yet echoed
    awaited = None    # [dst, seq, data bytes, answered] of PAX's last echo request on the wire
    conns = {}        # (PAX's port, the other address, its port) -> TcpConn
    last_in = {}      # the same key -> the last valid segment sent to PAX from there
    last_ident = None
    last_seq = 0
    started = False   # PAX's kernel has sent a frame

    for n, f in enumerate(fs):
        if len(f) < 14:
            fail(n, "a frame shorter than its header")
        kind = f[12:14]
        if f[6:12] == px.PAX_MAC:
            # ---- a frame PAX's station sent -------------------------------
            if kind not in (b"\x08\x06", b"\x08\x00", px.EXPERIMENTAL):
                if started:
                    fail(n, "a frame of type %s from PAX's address after the kernel's first" % kind.hex())
                print("before the kernel: frame %d: %d bytes, type %s: %s" % (n, len(f), kind.hex(), f[:96].hex()))
                c["before"] += 1
                continue
            started = True
            c["from-pax"] += 1
            if kind == b"\x08\x06":
                if len(f) >= 42 and px.be16(f, 20) == 1:
                    want = px.pax_arp_request(f[38:42])
                    if f != want:
                        fail(n, "not PAX's ARP request for %s, byte for byte" % px.dotted(f[38:42]), want)
                    c["arp.requests-out"] += 1
                else:
                    if not askers:
                        fail(n, "an ARP reply from PAX with no request for its address unanswered")
                    hw, pa = askers.pop(0)
                    want = px.pax_arp_reply(hw, pa)
                    if f != want:
                        fail(n, "not PAX's ARP reply to %s (%s), byte for byte" % (px.dotted(pa), hw.hex(":")), want)
                    c["arp.replies-out"] += 1
                continue
            if kind == px.EXPERIMENTAL:
                if f == px.MARKER:
                    c["markers"] += 1
                    continue
                which = "burst.small" if len(f) == 60 else "burst.large"
                want = burst_frame(f[:6], c[which], 60 if which == "burst.small" else 1514)
                if f != want or (which == "burst.small" and c["burst.large"]):
                    fail(n, "not the ready frame, nor burst frame %d of its size, byte for byte" % c[which], want)
                if claims.get(px.GW_IP) != f[:6]:
                    fail(n, "a burst frame for a hardware address the gateway did not announce")
                c[which] += 1
                continue
            # A datagram.
            if len(f) < 42 or f[14] != 0x45:
                fail(n, "a datagram from PAX that is not version 4 with a 20-byte header")
            if f[23] not in (1, 17) and not (f[23] == 6 and tcp):
                fail(n, "a datagram of protocol %d from PAX" % f[23])
            h = f[14:]
            total = px.be16(h, 2)
            ident = px.be16(h, 4)
            dst = h[16:20]
            if 14 + total > len(f) or total < 28:
                fail(n, "a datagram from PAX whose total length (%d) is not its frame's" % total)
            # A 16-bit counter: after 65535 comes 0 (px23).
            ahead = ident + 1 if last_ident is None else (ident - last_ident) & 0xffff
            if ahead == 0 or ahead > 0x4000:
                fail(n, "PAX's identification went from %d to %d" % (last_ident, ident))
            c["ident-gaps"] += ahead - 1
            last_ident = ident
            c["ip.out"] += 1
            c["checksums"] += 2
            if px.is_broadcast(dst):
                to = px.BCAST
            else:
                to = claims.get(px.next_hop(dst))
                if to is None:
                    fail(n, "a datagram for %s, whose next hop %s announced no hardware address" % (px.dotted(dst), px.dotted(px.next_hop(dst))))
            m = h[20:total]
            if h[9] == 6:
                # px23: a TCP segment, rebuilt from its fields and held to
                # its connection.
                if dst == px.PAX_IP or dst[0] == 127:
                    fail(n, "a TCP segment for %s on the wire: what loops back must not touch it" % px.dotted(dst))
                if len(m) < 20 or (m[12] >> 4) * 4 < 20 or (m[12] >> 4) * 4 > len(m):
                    fail(n, "a TCP segment from PAX whose header does not fit it")
                seg = px.Segment(f)
                want = px.tcp_from_pax(dst, seg.sport, seg.dport, seg.seq, seg.ack, seg.flags, seg.window, seg.data, ident, to)
                if f != want:
                    fail(n, "not a TCP segment as PAX builds one (%s) by way of %s, byte for byte: a 20-byte header, the MSS option on a SYN alone"
                         % (seg, to.hex(":")), want)
                key = (seg.sport, dst, seg.dport)
                why = tcp_out(conns, last_in, key, seg, c)
                if why:
                    fail(n, "a TCP segment from PAX (%s) that %s" % (seg, why))
                c["tcp.out"] += 1
                c["checksums"] += 1
                continue
            if h[9] == 17:
                # px22: a UDP datagram, rebuilt from its ports and data.
                sport, dport, data = px.be16(m, 0), px.be16(m, 2), m[8:]
                if dst == px.PAX_IP or dst[0] == 127:
                    fail(n, "a UDP datagram for %s on the wire: what loops back must not touch it" % px.dotted(dst))
                want = px.udp_from_pax(dst, sport, dport, data, ident, to)
                if f != want:
                    fail(n, "not a UDP datagram from PAX (port %d to %s port %d, %d bytes) by way of %s, byte for byte"
                         % (sport, px.dotted(dst), dport, len(data), to.hex(":")), want)
                if sport == px.ECHO_PORT:
                    asked = to_echo.get((dst, dport), [])
                    if data in asked:
                        del asked[:asked.index(data) + 1]
                        c["udp.echoed"] += 1
                    elif data == b"ready":
                        c["udp.ready"] += 1
                    else:
                        fail(n, "a datagram from PAX's port 7 to %s port %d that echoes nothing that address and port sent port 7"
                             % (px.dotted(dst), dport))
                elif sport == px.HOLD_PORT and data == b"ready":
                    c["udp.ready"] += 1
                elif sport not in px.EPHEMERAL:
                    fail(n, "a UDP datagram from PAX's port %d, which is neither a witness's nor an ephemeral port" % sport)
                c["udp.out"] += 1
                continue
            if h[9] != 1:
                fail(n, "a datagram of protocol %d from PAX" % h[9])
            if m[0] == 8:
                seq = px.be16(m, 6)
                want = px.echo_request_from_pax(dst, seq, total - 28, ident, to)
                if f != want or seq <= last_seq:
                    fail(n, "not an echo request from PAX (sequence %d after %d, %d data bytes) for %s by way of %s, byte for byte"
                         % (seq, last_seq, total - 28, px.dotted(dst), to.hex(":")), want)
                last_seq = seq
                awaited = [dst, seq, total - 28, False]
                c["icmp.requests-out"] += 1
            elif m[0] == 0:
                if not echoes:
                    fail(n, "an echo reply from PAX with no echo request unanswered")
                rf, rihl, rtotal = echoes.pop(0)
                want = px.echo_reply_to(rf, rihl, rtotal, ident, to)
                if f != want:
                    fail(n, "not PAX's reply to the oldest unanswered echo request (from %s), byte for byte" % px.dotted(rf[26:30]), want)
                c["icmp.replies-out"] += 1
            elif m[0] == 3 and m[1] == 3:
                # px22: a port unreachable quotes a whole UDP datagram
                # that reached PAX's own address in a frame for it alone.
                hit = None
                for k, (ef, eihl, etotal) in enumerate(udp_seen):
                    if f == px.port_unreachable_for(ef, eihl, etotal, ident, to):
                        hit = k
                        break
                if hit is None or udp_seen[hit][0][0] & 1 or px.is_broadcast(udp_seen[hit][0][30:34]):
                    fail(n, "a port unreachable from PAX that quotes no UDP datagram sent to its address alone, byte for byte")
                del udp_seen[hit]
                c["port-unreachable.sent"] += 1
            elif m[0] == 3:
                hit = None
                for k, (ef, eihl, etotal) in enumerate(errors):
                    want = px.unreachable_for(ef, eihl, etotal, ident, to)
                    if f == want:
                        hit = k
                        break
                if hit is None:
                    fail(n, "a destination unreachable from PAX that quotes no unanswered datagram of an unknown protocol, byte for byte",
                         px.unreachable_for(errors[0][0], errors[0][1], errors[0][2], ident, to) if errors else None)
                c["unreachable.limited"] += hit
                del errors[:hit + 1]
                c["unreachable.sent"] += 1
            else:
                fail(n, "an ICMP message of type %d from PAX" % m[0])
            continue

        # ---- a frame somebody else sent ----------------------------------
        if f[:6] != px.PAX_MAC and not f[0] & 1:
            c["net.other"] += 1  # for another station
            continue
        c["to-pax"] += 1
        lengths[len(f)] = lengths.get(len(f), 0) + 1
        if kind == b"\x08\x06":
            verdict, teaches = px.judge_arp(f)
            c["arp." + verdict] += 1
            if teaches:
                claims[f[28:32]] = f[22:28]
            if verdict == "request":
                askers.append((f[22:28], f[28:32]))
            continue
        if kind != b"\x08\x00":
            c["net.type"] += 1
            continue
        verdict, ihl, total = px.judge_ip(f)
        c["checksums"] += 1
        if verdict in CAUSES:
            c[verdict] += 1
        if not verdict.startswith("ip."):
            # The header passed.
            if ihl > 20:
                c["ip.with-options"] += 1
            if px.is_broadcast(f[30:34]):
                c["ip.broadcast"] += 1
            if verdict in ("unreachable", "silent"):
                c["ip.protocol"] += 1
            else:
                c["ip.delivered"] += 1
                c["checksums"] += 1
        if verdict == "echo":
            echoes.append((f, ihl, total))
            c["icmp.echo"] += 1
        elif verdict == "reply":
            m = f[14 + ihl:14 + total]
            if (awaited is not None and not awaited[3] and f[26:30] == awaited[0] and px.be16(m, 4) == px.ECHO_IDENT
                    and px.be16(m, 6) == awaited[1] and m[8:] == px.pattern(awaited[2])):
                awaited[3] = True
                c["icmp.matched"] += 1
            else:
                c["icmp.stray"] += 1
        elif verdict == "icmp.error":
            c["icmp.error"] += 1
        elif verdict == "tcp":
            seg = px.Segment(f)
            c["tcp.in"] += 1
            c["checksums"] += 1
            tcp_in(conns, last_in, (seg.dport, f[26:30], seg.sport), seg, c)
        elif verdict in ("udp", "udp.port-zero"):
            sport, dport, data, summed = px.udp_fields(f)
            if not summed:
                c["udp.unchecked"] += 1
            if verdict == "udp":
                c["udp.in"] += 1
                udp_seen.append((f, ihl, total))
                del udp_seen[:-64]
                if dport == px.ECHO_PORT:
                    to_echo.setdefault((f[26:30], sport), []).append(data)
        elif verdict == "unreachable":
            errors.append((f, ihl, total))
        elif verdict == "silent":
            c["unreachable.silent"] += 1

    n = len(fs)
    if echoes:
        fail(n, "the capture ends with %d echo requests to PAX unanswered; the oldest is from %s" % (len(echoes), px.dotted(echoes[0][0][26:30])))
    if askers:
        fail(n, "the capture ends with %d ARP requests for PAX's address unanswered" % len(askers))
    c["unreachable.limited"] += len(errors)
    if c["burst.small"] != small or c["burst.large"] != large:
        fail(n, "%d burst frames of 60 bytes and %d of 1514; %d and %d were due" % (c["burst.small"], c["burst.large"], small, large))
    print("pcap-net: %d frames: %d before the kernel's first; %d from PAX, each rebuilt and equal byte for byte; %d to PAX or to everyone "
          "(lengths %s), each judged; %d for another station; %d checksums recomputed"
          % (len(fs), c["before"], c["from-pax"], c["to-pax"],
             " ".join("%d:%d" % kv for kv in sorted(lengths.items())[:12]) + (" …" if len(lengths) > 12 else ""),
             c["net.other"], c["checksums"]))
    if opt["serial"]:
        wrong, held = against(opt["serial"], c, tcp)
        if wrong:
            print("pcap-net: FAIL the kernel's counters are not the capture's: " + "; ".join(wrong))
            return 1
        print("pcap-net: the kernel's counters are the capture's (%d held)" % held)
    print("pcap-net: PASS " + " ".join("%s=%d" % (k, c[k]) for k in KEYS))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
