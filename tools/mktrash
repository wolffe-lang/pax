#!/usr/bin/env bash
# mktrash — build trash, a reversible rm in wolf (wolffe-lang/trash), as
# five fully static x86-64 Linux executables, `trash`, `trash-list`,
# `trash-restore`, `trash-rm` and `trash-empty`, unmodified, from trash's
# own tree, through trash's own tools/build.py --static (tb03).
#
#   tools/mktrash OUTDIR
#
# burrow's builder's twin. The tree is user/trash.pin's commit of
# wolffe-lang/trash (public), fetched from PAX_TRASH_REPO when it is set (a
# local clone or cache that holds the commit) and from TRASH_REPO
# otherwise, through tools/fetch-retry; HEAD is refused unless it is
# TRASH_REV. Nothing of trash's tree is kept: the build directory is
# removed at the end.
#
# The toolchain is the one THAT tree pins in its wolf-toolchain.toml: the
# whole wolf release archive for x86_64-unknown-linux-gnu, its sha256 read
# twice and refused unless both reads are the pin's, its `wolf --version`
# refused unless it names the pin's version, the runtime (`libwolf_rt.a`)
# beside `wolf`, as the archive lays it out, and the std the archive
# bundles, refused unless it is the pin's `[std] rev` (trash pins the
# archive's own). The archive is cached in PAX_CACHE by digest, under the
# name burrow's and den's builders cache it by.
#
# trash's tools/build.py --static builds every command in its src/ at the
# default tier with warnings denied, through a `cc` that adds -static (wolf
# has no --static), checks each a static ET_EXEC with no interpreter, and
# keeps a stripped copy (target/static/stripped/): that copy is what PAX
# carries, and what trash's own PAX rows run. It is built once in each of
# two checkouts at paths of their own, and the two checkouts' stripped
# binaries must agree (exit 1 otherwise). Each is checked static here too
# (readelf: ET_EXEC, no PT_INTERP, no dynamic section), and each but
# trash-rm is asked `--version`: trash-rm, as trash-cli's, takes its first
# word as the pattern to remove from the trash, so it is never run here.
# `OUTDIR/sums.txt` gets `NAME <sha256> <bytes>` for the five;
# whether each is the digest user/trash.pin records from trash's own gate
# is printed (the binary depends on the libc.a it links, so a host's other
# libc.a is a new digest, not a failure here; tests/distribution holds the
# image to the pin's).
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu 24.04
# container), never on a newer host glibc (px10). trash's builder needs
# python3 (3.11 or later), cc, readelf and strip. Exit 0, 1 when two builds
# differ, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mktrash OUTDIR"
out=$1
need git curl tar readelf strip cc python3
pin=$PAX_ROOT/user/trash.pin
. "$pin"
[ -n "${TRASH_REPO:-}" ] && printf '%s' "${TRASH_REV:-}" | grep -Eq '^[0-9a-f]{40}$' \
    || die "$pin must set TRASH_REPO and TRASH_REV (a full 40-hex sha, never a branch)"
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' || die "trash's tools/build.py needs python3 3.11 or later"
NAMES="trash trash-list trash-restore trash-rm trash-empty"
mkdir -p "$out" "$PAX_CACHE"
out=$(cd "$out" && pwd)

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-trash.XXXXXX")
trap 'rm -rf "$w"' EXIT

tree() { # repo rev dir
    mkdir -p "$3"
    git -C "$3" init -q
    "$PAX_ROOT/tools/fetch-retry" "$3" "$1" "$2" "$2" || die "cannot fetch $1 at $2"
    git -C "$3" checkout -q --detach FETCH_HEAD
    [ "$(git -C "$3" rev-parse HEAD)" = "$2" ] || die "$1: HEAD is not $2"
}

tree "${PAX_TRASH_REPO:-$TRASH_REPO}" "$TRASH_REV" "$w/a/trash"
toml=$w/a/trash/wolf-toolchain.toml
key() { # section key
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { on = ($0 == s); next }
        on && $1 == k { v = $0; sub(/^[^=]*= *"?/, "", v); sub(/"? *$/, "", v); print v; exit }' "$toml"
}
wv=$(key wolf version)
wsha=$(key wolf x86_64-unknown-linux-gnu)
srev=$(key std rev)
[ -n "$wv" ] && [ -n "$wsha" ] && [ -n "$srev" ] \
    || die "cannot read wolf version/digest and std rev from trash's wolf-toolchain.toml"
say "trash $TRASH_REV pins wolf $wv (${wsha:0:8}…), wolf-std $srev"

arc=$PAX_CACHE/wolf-$wv-x86_64-unknown-linux-gnu-$wsha.tar.gz
if [ ! -f "$arc" ] || [ "$(sha256_of "$arc")" != "$wsha" ]; then
    "$PAX_ROOT/tools/net-retry" url \
        "https://github.com/wolffe-lang/wolf-lang/releases/download/v$wv/wolf-$wv-x86_64-unknown-linux-gnu.tar.gz" "$arc.part" \
        || die "cannot download wolf $wv"
    mv "$arc.part" "$arc"
fi
for k in 1 2; do
    have=$(sha256_of "$arc")
    [ "$have" = "$wsha" ] || die "wolf $wv archive, read $k: sha256 $have, trash pins $wsha"
done
say "wolf $wv archive: sha256 $wsha, read twice"
mkdir -p "$w/wolf"
tar -xzf "$arc" -C "$w/wolf" --strip-components=1
wolf=$w/wolf/wolf
[ -x "$wolf" ] || die "the wolf $wv archive has no wolf"
[ -f "$w/wolf/libwolf_rt.a" ] || die "the wolf $wv archive has no libwolf_rt.a beside wolf"
have=$("$wolf" --version | head -n 1)
case $have in "wolf $wv "*|"wolf $wv") ;; *) die "wolf --version says '$have'; trash pins $wv" ;; esac
bundled=$(tr -d '[:space:]' < "$w/wolf/std/STD-REV" 2>/dev/null || true)
[ "$bundled" = "$srev" ] || die "the wolf $wv archive bundles std '${bundled:-none}'; trash pins $srev"
say "$have; libwolf_rt.a beside it; the std it bundles, $srev, the pin's"

# trash's own builder in two checkouts of its own; the second is fetched
# from the first (the pinned commit either way, checked).
tree "$w/a/trash" "$TRASH_REV" "$w/b/trash"
for k in a b; do
    rc=0
    (cd "$w/$k/trash" && TMPDIR=$w/$k HOME=$w/$k XDG_CACHE_HOME=$w/$k/cache \
        python3 -I tools/build.py --wolf "$wolf" --out target/static --static) > "$w/$k.log" 2>&1 || rc=$?
    cat "$w/$k.log" >&2
    [ "$rc" = 0 ] || die "trash's tools/build.py --static (checkout $k) exited $rc"
done
static() {
    readelf -hW "$1" | grep -Eq 'Type: +EXEC' || die "$1 is not ET_EXEC"
    ! readelf -lW "$1" | grep -q INTERP || die "$1 has a PT_INTERP (not static)"
    readelf -dW "$1" | grep -q 'There is no dynamic section' || die "$1 has a dynamic section"
}
: > "$out/sums.txt"
for n in $NAMES; do
    one=$(sha256_of "$w/a/trash/target/static/stripped/$n")
    two=$(sha256_of "$w/b/trash/target/static/stripped/$n")
    if [ "$one" != "$two" ]; then
        say "REFUSED: the two checkouts' $n differ: $one, then $two"
        exit 1
    fi
    cp "$w/a/trash/target/static/stripped/$n" "$out/$n"
    chmod 755 "$out/$n"
    static "$out/$n"
    if [ "$n" != trash-rm ]; then
        v=$("$out/$n" --version 2>&1 | head -n 1) || die "$n --version"
        case $v in "$n (wolffe-lang trash) "*) ;; *) die "$n --version says '$v'" ;; esac
    fi
    row="$n $one $(wc -c < "$out/$n" | tr -d ' ')"
    printf '%s\n' "$row" | tee -a "$out/sums.txt"
    if grep -Eq "^#   $n +$one " "$pin"; then
        say "$n: the digest trash's own gate printed (user/trash.pin)"
    else
        say "$n: not the digest user/trash.pin records from trash's gate (this host's libc.a): $one"
    fi
done
printf 'trash built twice (two checkouts), the same digests; linked against: %s\n' "$(cc -print-file-name=libc.a)"
