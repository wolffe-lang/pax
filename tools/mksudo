#!/usr/bin/env bash
# mksudo — build sudo (user/sudo/sudo.lu, px103: P5's U8, ruling #75 R8's
# place) with user/auth (px106: the caller's password, the timestamp), as a
# fully static x86-64 Linux executable: tools/mkauth OUTDIR sudo, whose
# header says how.
#
#   tools/mksudo OUTDIR
#
# OUTDIR gets sudo and sums.txt (`sudo <sha256> <bytes>`, of the stripped
# file). The toolchain is user/auth/wolf-toolchain.toml's (until px106,
# sudo had its own, user/sudo/wolf-toolchain.toml). Exit 0, or 2 on a tool
# error.
set -euo pipefail
[ $# -eq 1 ] || { echo "usage: mksudo OUTDIR" >&2; exit 2; }
exec "$(dirname "$0")/mkauth" "$1" sudo
