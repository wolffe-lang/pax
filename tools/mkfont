#!/usr/bin/env python3
# mkfont — turn font/spleen-8x16.bdf into boot/font.S, the screen's
# glyph table (px19).
#
#   tools/mkfont [--check] [BDF] [OUT.S]
#
# The table is `pax_font`: 256 glyphs, one per code point 0-255, 16
# bytes each, one byte a pixel row from the top, the most significant
# bit the leftmost pixel (BDF's own row order and bit order for an
# 8-pixel-wide font). A code point the font has no glyph for gets the
# glyph of `?` (0x3f), so the kernel can index the table with any code
# point below 256 and draw something; kernel/screen draws `?` itself for
# a code point at or above 256. Every glyph must be `BBX 8 16 0 -4`
# (the font's bounding box): anything else is refused by name.
#
# --check compares OUT.S (default boot/font.S) with what the BDF gives
# and exits 1 when they differ, 0 when they are the same.
# Defaults: BDF font/spleen-8x16.bdf, OUT boot/font.S, relative to the
# repository. Exit 2 on a usage error or a malformed font.
import os
import sys

root = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
args = sys.argv[1:]
check = False
if args and args[0] == "--check":
    check = True
    args = args[1:]
if len(args) > 2 or any(a.startswith("-") for a in args):
    sys.stderr.write("usage: mkfont [--check] [BDF] [OUT.S]\n")
    sys.exit(2)
bdf = args[0] if len(args) > 0 else os.path.join(root, "font", "spleen-8x16.bdf")
out = args[1] if len(args) > 1 else os.path.join(root, "boot", "font.S")


def die(msg):
    sys.stderr.write("mkfont: %s\n" % msg)
    sys.exit(2)


glyphs = {}
enc = None
bbx = None
rows = None
with open(bdf, "rb") as f:
    for raw in f:
        line = raw.decode("ascii").strip()
        if line.startswith("ENCODING "):
            enc = int(line.split()[1])
        elif line.startswith("BBX "):
            bbx = line.split()[1:]
        elif line == "BITMAP":
            rows = []
        elif line == "ENDCHAR":
            if bbx != ["8", "16", "0", "-4"]:
                die("glyph %s has BBX %s, not 8 16 0 -4" % (enc, " ".join(bbx or [])))
            if rows is None or len(rows) != 16:
                die("glyph %s has %s rows, not 16" % (enc, len(rows or [])))
            if enc is not None and 0 <= enc < 256:
                glyphs[enc] = rows
            enc = bbx = rows = None
        elif rows is not None:
            rows.append(int(line, 16))
if 0x3F not in glyphs:
    die("the font has no '?' (0x3f)")

lines = []
lines.append("/* font.S — the screen's glyphs (px19), GENERATED by tools/mkfont from")
lines.append("   font/spleen-8x16.bdf: Spleen 2.2.0 by Frederic Cambus, BSD 2-Clause")
lines.append("   (font/LICENSE.spleen). Do not edit; run tools/mkfont.")
lines.append("")
lines.append("   pax_font: 256 glyphs, code points 0-255, 16 bytes each (rows from")
lines.append("   the top, bit 7 the leftmost pixel); a code point the font has no")
lines.append("   glyph for carries `?`'s. %d of the 256 are the font's own. */" % len(glyphs))
lines.append("")
lines.append("        .section .rodata")
lines.append("        .p2align 4")
lines.append("        .globl pax_font")
lines.append("pax_font:")
for cp in range(256):
    g = glyphs.get(cp, glyphs[0x3F])
    own = "" if cp in glyphs else " (?)"
    lines.append("        .byte " + ", ".join("0x%02x" % b for b in g) + "   /* 0x%02x%s */" % (cp, own))
lines.append("        .size pax_font, . - pax_font")
lines.append("")
lines.append('        .section .note.GNU-stack, "", @progbits')
text = "\n".join(lines) + "\n"

if check:
    try:
        with open(out, "r") as f:
            have = f.read()
    except OSError as e:
        sys.stderr.write("mkfont: %s\n" % e)
        sys.exit(1)
    if have != text:
        sys.stderr.write("mkfont: %s is not what %s gives\n" % (out, bdf))
        sys.exit(1)
    print("mkfont: %s matches %s (%d glyphs of 256 the font's own)" % (out, bdf, len(glyphs)))
    sys.exit(0)
with open(out, "w") as f:
    f.write(text)
print("mkfont: wrote %s from %s (%d glyphs of 256 the font's own)" % (out, bdf, len(glyphs)))
