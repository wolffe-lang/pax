#!/usr/bin/env bash
# mksniff — build sniff, the gdb-language debugger in wolf (wolffe-lang/sniff,
# Track 21), as a fully static x86-64 Linux executable, unmodified, from
# sniff's own tree (sn04).
#
#   tools/mksniff OUTDIR
#
# tools/mkyew's shape. The tree is user/sniff.pin's commit of
# wolffe-lang/sniff (public), from PAX_SNIFF_REPO when it is set (a local
# clone that holds the commit) and from SNIFF_REPO otherwise. The
# toolchain is the one THAT tree pins in its wolf-toolchain.toml: the
# wolf release archive for x86_64-unknown-linux-gnu by its sha256
# (refused on a mismatch, and on a `--version` that is not its
# `version_line`), and wolf-std at the commit it names (`WOLF_STD`).
# sniff is built as the release tier builds the other org tools
# (`wolf build --release --no-cache src/main.lu`), through a `cc` first on
# PATH that adds `-static` (wolf has no `--static`), so the binary is a
# static glibc executable: ET_EXEC, no PT_INTERP, checked (readelf).
# PAX loads only that shape, and sniff debugs only static programs there.
# sniff has no --version: the check runs `sniff dump --symbols` on itself
# and wants exit 0. `OUTDIR/sums.txt` gets `sniff <sha256> <bytes>`.
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu
# container on kasumi), never on kasumi's CachyOS x86-64-v4 glibc (px10).
# The release tier needs clang at run time (wolf's D33). Exit 0, or 2 on
# a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mksniff OUTDIR"
out=$1
need git curl tar readelf cc clang
. "$PAX_ROOT/user/sniff.pin"
mkdir -p "$out" "$PAX_CACHE"
out=$(cd "$out" && pwd)

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-sniff.XXXXXX")
trap 'rm -rf "$w"' EXIT

tree() { # repo rev dir
    mkdir -p "$3"
    git -C "$3" init -q
    "$PAX_ROOT/tools/fetch-retry" "$3" "$1" "$2" "$2" || die "cannot fetch $1 at $2"
    git -C "$3" checkout -q --detach FETCH_HEAD
    [ "$(git -C "$3" rev-parse HEAD)" = "$2" ] || die "$1: HEAD is not $2"
}

# sniff at the pin, and what it pins.
tree "${PAX_SNIFF_REPO:-$SNIFF_REPO}" "$SNIFF_REV" "$w/sniff"
toml=$w/sniff/wolf-toolchain.toml
key() { # section key
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { on = ($0 == s); next }
        on && $1 == k { v = $0; sub(/^[^=]*= *"?/, "", v); sub(/"? *$/, "", v); print v; exit }' "$toml"
}
wv=$(key wolf version)
wsha=$(key wolf x86_64-unknown-linux-gnu)
[ -n "$wv" ] && [ -n "$wsha" ] \
    || die "cannot read wolf version/digest from sniff's wolf-toolchain.toml"
say "sniff $SNIFF_REV pins wolf $wv (${wsha:0:8}…); the archive binds its standard library"

# wolf, by the digest sniff names (cached by digest).
arc=$PAX_CACHE/wolf-$wv-$wsha.tar.gz
if [ ! -f "$arc" ] || [ "$(sha256_of "$arc")" != "$wsha" ]; then
    curl -sSfL --retry 3 -o "$arc.part" \
        "https://github.com/wolffe-lang/wolf-lang/releases/download/v$wv/wolf-$wv-x86_64-unknown-linux-gnu.tar.gz" \
        || die "cannot download wolf $wv"
    mv "$arc.part" "$arc"
fi
[ "$(sha256_of "$arc")" = "$wsha" ] || die "wolf $wv archive: sha256 $(sha256_of "$arc"), sniff pins $wsha"
mkdir -p "$w/wolf"
tar -xzf "$arc" -C "$w/wolf" --strip-components=1
wolf=$w/wolf/wolf
have=$("$wolf" --version | head -n 1)
case $have in *" $wv"*|*"$wv ("*) ;; *) die "wolf --version says '$have'; sniff pins $wv" ;; esac
say "$have"

# The static `cc`.
mkdir -p "$w/bin"
real=$(command -v cc)
printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" > "$w/bin/cc"
chmod +x "$w/bin/cc"

: > "$out/sums.txt"
(cd "$w/sniff" && PATH="$w/bin:$PATH" \
    "$wolf" build --release --no-cache src/main.lu -o "$out/sniff") >&2 \
    || die "wolf build of src/main.lu"
readelf -hW "$out/sniff" | grep -Eq 'Type: +EXEC' || die "sniff is not ET_EXEC"
! readelf -lW "$out/sniff" | grep -q INTERP || die "sniff has a PT_INTERP (not static)"
"$out/sniff" dump --symbols "$out/sniff" > /dev/null || die "sniff dump --symbols on itself"
printf '%s %s %s\n' sniff "$(sha256_of "$out/sniff")" "$(wc -c < "$out/sniff" | tr -d ' ')" | tee -a "$out/sums.txt"
printf 'linked against: %s\n' "$("$real" -print-file-name=libc.a)"
