#!/usr/bin/env bash
# mkconspeed — build px129's three probes, static x86-64 Linux executables
# linked against the baseline glibc's libc.a (as tools/mkbench builds
# px108's): `conspeed` (user/elf/conspeed.c: how fast the terminal it runs
# on draws; a table on stdout) and `keylat` (user/elf/keylat.c: a key to a
# full-screen program's frame on a pseudo-terminal) and `cpugaps`
# (user/elf/cpugaps.c: the CPU a spinning program gets, and the gaps).
#
#   tools/mkconspeed OUTDIR
#
# `gcc -static -no-pie -O2`, ET_EXEC with no PT_INTERP, checked. Prints
# the compiler's version, then `<name> <sha256> <bytes>` for each. Build on a
# baseline x86-64 glibc (an Ubuntu 24.04 container). Exit 0, or 2 on a
# tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkconspeed OUTDIR"
out=$1
mkdir -p "$out"
out=$(cd "$out" && pwd)
cc=${CONSPEED_CC:-gcc}
need "$cc" readelf
say "cc: $("$cc" --version 2>&1 | head -n 1)"
# Each source by its whole name: the CI map reads the paths a tool names.
for src in "$PAX_ROOT/user/elf/conspeed.c" "$PAX_ROOT/user/elf/keylat.c" "$PAX_ROOT/user/elf/cpugaps.c"; do
    p=$(basename "$src" .c)
    "$cc" -static -no-pie -O2 -Wall -Wextra -D_GNU_SOURCE -Wl,--build-id=none -Wl,-z,noexecstack \
        -o "$out/$p" "$src" || die "cc: $p"
    readelf -hW "$out/$p" | grep -Eq 'Type: +EXEC' || die "$p is not ET_EXEC"
    ! readelf -lW "$out/$p" | grep -q INTERP || die "$p has a PT_INTERP (not static)"
    printf '%s %s %s\n' "$p" "$(sha256_of "$out/$p")" "$(wc -c < "$out/$p" | tr -d ' ')"
done
