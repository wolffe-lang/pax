#!/usr/bin/env python3
"""Drive a black-box USB keyboard session; no driver internals consulted."""
import argparse
import json
import os
import re
from pathlib import Path
import socket
import subprocess
import time

KEYS = ['a', 'shift-a', 'shift-up', 'ctrl-left', 'a-b-c-d-e-f',
        'caps_lock', 'a', 'caps_lock', 'kp_enter', 'alt-x', 'a', None, None, None,
        'shift-down', 'shift-left', 'shift-right', 'q']

# px85 (pax#261): row 10 holds `a` for 100 ticks of the guest's own 10 ms
# clock, read from PAX's memory (boot/isr.S's pax_tick_count) through QMP,
# not for a second of the host's: PAX's software repeat, its poll timeout
# and its CLOCK_MONOTONIC all count those ticks, and a stalled vCPU loses
# ticks while the host's clock runs on, so a wall-clock hold shortened the
# hold the guest saw (run 41153232393 attempt 2: 6 reports). At 250 ms
# then 33 ms a report, 100 ticks give 24 or 25; at least 15 are wanted.
# The Linux guest (no symbols to read) keeps the 1000 ms wall-clock hold.
HOLD_TICKS = 100
HOLD_WALL_SECONDS = 30
MIN_REPORTS = 15
# Bytes that are `a` with a modifier still applied (the console's own
# encodings: Shift or Caps Lock, Ctrl, Alt's ESC prefix).
MODIFIED_A = {'41': 'Shift or Caps Lock', '01': 'Ctrl', '1b': 'Alt (an ESC prefix)'}


def repeat_verdict(row, hold):
    """The repeat row's verdict, by name (px85: three ways it can fail).

    `row` is the guest's `USBROW repeat-a …` line; `hold` says how long the
    key was held (`100 guest ticks`, or `1000 ms of wall clock`). Raises
    RuntimeError naming the fault: `stuck modifier`, `wrong key` or
    `repeat lost`; returns the reports otherwise."""
    values = row.split()[2:]
    if values == ['none']:
        values = []
    for v in values:
        if v in MODIFIED_A:
            raise RuntimeError(f'stuck modifier: {MODIFIED_A[v]} survived into the repeat row '
                               f'(byte {v} where 61 is `a`): {row!r}')
    for v in values:
        if v != '61':
            raise RuntimeError(f'wrong key: byte {v} in the repeat row, where only 61 (`a`) was held: {row!r}')
    if len(values) < MIN_REPORTS:
        raise RuntimeError(f'repeat lost: {len(values)} reports in a hold of {hold}, '
                           f'at least {MIN_REPORTS} wanted: {row!r}')
    return values


def run(args):
    out = Path(args.output).resolve()
    out.mkdir(parents=True, exist_ok=True)
    for result in ('rows.txt', 'repeat.txt', 'ticks.bin'):
        (out / result).unlink(missing_ok=True)
    serial = out / 'serial.log'
    sock = out / 'qmp.sock'
    if sock.exists():
        sock.unlink()
    root = Path(__file__).resolve().parents[1]
    cmd = [str(root / 'tools/qemu-run'), '--firmware', args.firmware,
           '--usb-kbd=' + args.topology, '--serial', str(serial),
           '--timeout', '120', str(Path(args.image).resolve()), '--',
           '-qmp', f'unix:{sock},server=on,wait=off']
    # px76: tools/qemu-run's own flags (--no-pit, --usb-irq=msi,
    # --high-bar, --display-mode=WxH), before the image.
    for flag in reversed(args.flag):
        cmd.insert(1, flag)
    addresses = {}
    if not args.linux_kernel:
        # PAX's own words, read through QMP: the repeat row's hold counts
        # pax_tick_count (px85); --no-serial's transcript is pax_serial_log.
        elf=Path(args.elf).resolve() if args.elf else Path(args.image).resolve().parent/'kmain_console.elf'
        symbols=subprocess.check_output(['nm',str(elf)],text=True)
        addresses={name:int(address,16)-(1<<64) for address,kind,name in
                   (line.split() for line in symbols.splitlines() if len(line.split())==3)
                   if name in ('pax_serial_log_count','pax_serial_log','pax_tick_count')}
        if 'pax_tick_count' not in addresses:
            raise RuntimeError(f'no pax_tick_count in {elf}: the repeat row is held for the guest\'s ticks (--elf)')
    if args.no_serial:
        if args.linux_kernel: raise RuntimeError('--no-serial is the PAX memory-log witness only')
        cmd.insert(1, '--no-serial')
        if 'pax_serial_log_count' not in addresses or 'pax_serial_log' not in addresses:
            raise RuntimeError('missing bounded serial-less log symbols')
        (out/'capture.txt').write_text('No UART. Transcript read from PAX memory through QMP; framebuffer drawn normally.\n')
    cmd += args.qemu
    # A blank virtual USB3 disk beside the keyboard: px74 logged it as
    # SuperSpeed enumerated, not driven; since px78 kernel/usb_storage
    # drives it (its Bulk-Only line), and the keyboard's rows are the same.
    disk = out / 'superspeed.img'
    with disk.open('wb') as stream:
        stream.truncate(8 * 1024 * 1024)
    cmd += ['-drive', f'file={disk},if=none,id=usb-ignored,format=raw',
            '-device', 'usb-storage,bus=pax-usb.0,port=3,drive=usb-ignored']
    if args.linux_kernel:
        # Direct boot of an unmodified binary Linux kernel. The ISO is not
        # booted; keeping the same qemu-run gives both guests identical USB.
        cmd += ['-kernel', args.linux_kernel, '-initrd', args.initrd,
                '-append', 'console=ttyS0 quiet loglevel=0 panic=-1 rdinit=/usbkeys']
    with (out / 'runner.log').open('wb') as log:
        proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT)
        conn = None
        start = time.monotonic()
        reader = None
        try:
            while not sock.exists():
                if proc.poll() is not None or time.monotonic()-start > 15:
                    raise RuntimeError('QMP did not start')
                time.sleep(.02)
            conn = socket.socket(socket.AF_UNIX)
            conn.settimeout(5)
            conn.connect(str(sock))
            reader = conn.makefile('rb')
            json.loads(reader.readline())

            def execute(name, arguments=None):
                payload = {'execute': name}
                if arguments is not None:
                    payload['arguments'] = arguments
                conn.sendall(json.dumps(payload).encode() + b'\n')
                while True:
                    reply = json.loads(reader.readline())
                    if 'error' in reply:
                        raise RuntimeError(reply)
                    if 'return' in reply:
                        return reply['return']

            def monitor(command):
                result = execute('human-monitor-command', {'command-line': command})
                if result:
                    raise RuntimeError(f'{command}: {result}')

            execute('qmp_capabilities')
            def transcript():
                if not args.no_serial: return serial.read_bytes() if serial.exists() else b''
                # Before Limine enters the kernel its high-half symbols are
                # unmapped. The bounded boot deadline still applies.
                try:
                    execute('memsave', {'val':addresses['pax_serial_log_count'],'size':8,'filename':str(out/'count.bin')})
                except RuntimeError as error:
                    (out/'capture-error.txt').write_text(str(error))
                    return b''
                count=int.from_bytes((out/'count.bin').read_bytes(),'little')
                if count>65536: raise RuntimeError('serial-less transcript overflow')
                if count==0:return b''
                execute('memsave', {'val':addresses['pax_serial_log'],'size':count,'filename':str(out/'capture.bin')})
                data=(out/'capture.bin').read_bytes()
                serial.write_bytes(data)
                return data

            def guest_ticks():
                execute('memsave', {'val':addresses['pax_tick_count'],'size':8,'filename':str(out/'ticks.bin')})
                return int.from_bytes((out/'ticks.bin').read_bytes(),'little')

            def hold_for_ticks(execute):
                # px85 (pax#261): press, wait for HOLD_TICKS of the guest's
                # own ticks, release; a stall lengthens the wall-clock hold
                # with the ticks it costs the guest.
                def key(down):
                    execute('input-send-event', {'events':[{'type':'key', 'data':{
                        'down':down, 'key':{'type':'qcode','data':'a'}}}]})
                first = guest_ticks()
                key(True)
                until = time.monotonic() + HOLD_WALL_SECONDS
                while True:
                    now = guest_ticks()
                    if now - first >= HOLD_TICKS:
                        break
                    if time.monotonic() > until:
                        key(False)
                        raise RuntimeError(f'repeat hold: the guest counted {now - first} of {HOLD_TICKS} ticks '
                                           f'in {HOLD_WALL_SECONDS} s of wall clock')
                    time.sleep(.01)
                key(False)
                return now - first
            hold = None
            sent = 0
            while time.monotonic() - start < 110:
                text = transcript()
                if b'USBDONE' in text:
                    break
                if b'PANIC' in text or proc.poll() is not None:
                    raise RuntimeError('guest ended before USBDONE')
                if f'USBREADY {sent} '.encode() in text and sent < len(KEYS):
                    if sent == 11:
                        # Remove a keyboard with Shift held; then another
                        # keyboard must type lowercase, not inherit Shift.
                        execute('input-send-event', {'events':[{'type':'key', 'data':{
                            'down':True, 'key':{'type':'qcode','data':'shift'}}}]})
                        time.sleep(.05)
                        execute('device_del', {'id': 'pax-usb-kbd'})
                        time.sleep(.4)
                        execute('device_add', {'driver':'usb-kbd', 'id':'usb-spare',
                                              'bus':'pax-usb.0', 'port':'2'})
                        time.sleep(1.0)
                        execute('input-send-event', {'events':[{'type':'key', 'data':{
                            'down':False, 'key':{'type':'qcode','data':'shift'}}}]})
                        monitor('sendkey b 50')
                    elif sent == 12:
                        execute('device_del', {'id': 'usb-spare'})
                        time.sleep(.4)
                        port = {'root':'1', 'hub':'1.3', 'nested':'1.3.2'}[args.topology]
                        execute('device_add', {'driver':'usb-kbd', 'id':'pax-usb-kbd',
                                              'bus':'pax-usb.0', 'port':port})
                        time.sleep(1.0)
                        monitor('sendkey c 50')
                    elif sent == 13:
                        for _ in range(300):
                            for down in (True, False):
                                execute('input-send-event', {'events':[{'type':'key', 'data':{
                                    'down':down, 'key':{'type':'qcode','data':'a'}}}]})
                                time.sleep(.020)
                    elif sent == 10 and not args.linux_kernel:
                        hold = hold_for_ticks(execute)
                    else:
                        monitor(f'sendkey {KEYS[sent]} {1000 if sent == 10 else 50}')
                    sent += 1
                time.sleep(.01)
            else:
                raise RuntimeError('USB session deadline')
            if sent != len(KEYS):
                raise RuntimeError(f'only {sent} rows sent')
            # PAX exits the probe, prints its books, then halts.
            if not args.linux_kernel:
                until = time.monotonic() + 8
                while b'\nhalt\r\n' not in transcript() and time.monotonic() < until:
                    time.sleep(.02)
                text = transcript()
                if b'\nhalt\r\n' not in text:
                    raise RuntimeError('PAX did not reach halt')
                summary = [x for x in text.splitlines() if x.startswith(b'console: ') and b'scancodes' in x]
                if len(summary) != 1 or b'(0 scancodes)' not in summary[0] or b'console: 0 bytes from com1,' not in summary[0]:
                    raise RuntimeError('USB path contaminated by PS/2 or serial: '+repr(summary))
                if b'xhci: storage usb1-3 speed 4 ' not in text or b' Bulk-Only' not in text:
                    raise RuntimeError('SuperSpeed mass storage row missing (px78: driven, Bulk-Only)')
                if b'xhci: keyboard usb1-' not in text or b'enumeration failed' in text or b'timeout' in text:
                    raise RuntimeError('USB enumeration did not complete cleanly')
                if args.no_serial: execute('screendump', {'filename':str(out/'screen.ppm')})
                execute('quit')
            proc.wait(timeout=10)
        finally:
            if reader is not None:
                reader.close()
            if conn is not None:
                conn.close()
            if proc.poll() is None:
                proc.terminate()
                proc.wait(timeout=10)
    lines = serial.read_text(errors='replace').splitlines()
    rows = [line for line in lines if line.startswith('USBROW ')]
    times = [line for line in lines if line.startswith('USBTIMES ')]
    if len(rows) != len(KEYS) or len(times) != 1:
        raise RuntimeError('missing result rows or repeat measurement')
    expected_edges = {
        0:'USBROW first-a 61', 4:'USBROW six-keys 61 62 63 64 65 66',
        11:'USBROW after-unplug 62', 12:'USBROW after-replug 63',
        13:'USBROW ring-wrap' + ' 61'*300,
        14:'USBROW shift-down 1b 5b 31 3b 32 42',
        15:'USBROW shift-left 1b 5b 31 3b 32 44',
        16:'USBROW shift-right 1b 5b 31 3b 32 43',
        17:'USBROW finish 71'}
    for index, expected in expected_edges.items():
        if rows[index] != expected:
            raise RuntimeError(f'USB required edge missing: {rows[index]!r}, expected {expected!r}')
    # Repeat counts depend on scheduling; compare byte values separately.
    normalized = ['USBROW repeat-a 61' if line.startswith('USBROW repeat-a ') else line for line in rows]
    repeat = repeat_verdict(rows[10], f'{hold} guest ticks' if hold is not None else '1000 ms of wall clock')
    stamps = list(map(int, times[0].split()[1:]))
    if len(stamps) != len(repeat) or stamps[0] != 0:
        raise RuntimeError('repeat timestamp shape')
    delay = stamps[1] / 1e6
    intervals = [(b-a)/1e6 for a,b in zip(stamps[1:], stamps[2:])]
    median = sorted(intervals)[len(intervals)//2]
    mean = sum(intervals)/len(intervals)
    if not 220 <= delay <= 320 or not 20 <= median <= 45 or not 31 <= mean <= 37:
        raise RuntimeError(f'repeat outside measured tolerance: {delay=} {median=} {mean=}')
    (out / 'rows.txt').write_text('\n'.join(normalized)+'\n')
    held = f'hold_ticks {hold}\n' if hold is not None else 'hold_wall_ms 1000\n'
    (out / 'repeat.txt').write_text(f'delay_ms {delay:.3f}\nmedian_period_ms {median:.3f}\nmean_period_ms {mean:.3f}\nreports {len(repeat)}\n{held}')
    if args.reference:
        expected = Path(args.reference).read_text().splitlines()
        if normalized != expected:
            raise RuntimeError(f'Linux differential mismatch\nexpected={expected!r}\nactual={normalized!r}')
    print(f'PASS USB {args.topology} {args.firmware}: {len(rows)} rows, delay {delay:.3f}ms, period {median:.3f}ms', flush=True)


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--image', required=True)
    parser.add_argument('--output', required=True)
    parser.add_argument('--firmware', choices=['bios','uefi'], default='bios')
    parser.add_argument('--topology', choices=['root','hub','nested'], default='root')
    parser.add_argument('--linux-kernel')
    parser.add_argument('--initrd')
    parser.add_argument('--reference')
    parser.add_argument('--no-serial', action='store_true')
    parser.add_argument('--qemu', action='append', default=[], help='one extra QEMU argument, repeatable')
    parser.add_argument('--flag', action='append', default=[], help='one tools/qemu-run flag, repeatable (px76)')
    parser.add_argument('--elf', help='--no-serial: the kernel whose symbols place the transcript (default: kmain_console.elf beside the image)')
    run(parser.parse_args())
