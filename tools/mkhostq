#!/usr/bin/env bash
# mkhostq — build px57's probe of s253's calls (user/elf/hostq.c,
# pax#107), a static x86-64 Linux executable, for tests/mpx5-jobs' eds
# image.
#
#   tools/mkhostq OUTDIR
#
# tools/mkexecs' compiler line (`cc -static -no-pie -O1`, ET_EXEC with
# no PT_INTERP, checked). Build on a baseline x86-64 glibc (the CI
# runner's Ubuntu; an Ubuntu container on kasumi), never on kasumi's own
# (px10). Prints `hostq <sha256> <bytes>`. Exit 0, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkhostq OUTDIR"
out=$1
mkdir -p "$out"
out=$(cd "$out" && pwd)
cc=${CC:-cc}
need "$cc" readelf
"$cc" -static -no-pie -O1 -Wall -Wextra -Wno-unused-result -Wno-unused-function \
    -Wl,--build-id=none -Wl,-z,noexecstack -o "$out/hostq" "$PAX_ROOT/user/elf/hostq.c" || die "cc: hostq"
readelf -hW "$out/hostq" | grep -Eq 'Type: +EXEC' || die "hostq is not ET_EXEC"
! readelf -lW "$out/hostq" | grep -q INTERP || die "hostq has a PT_INTERP (not static)"
printf '%s %s %s\n' hostq "$(sha256_of "$out/hostq")" "$(wc -c < "$out/hostq" | tr -d ' ')"
