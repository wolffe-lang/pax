#!/usr/bin/env python3
# linux-run — run a PAX run list on this host's Linux, the reference side
# of tests/mpx3-boreutils (px12, M-PX3).
#
#   sudo tools/linux-run [--strace] ROOT RUNLIST OUTDIR
#
# ROOT is the tree the initramfs is made from (bin/..., etc/...). Each
# command of RUNLIST (kmain_boreutils's format: one a line, words
# separated by single spaces, the first the program's path; empty lines
# and `#` lines skipped) runs chrooted in ROOT, so its paths are the
# paths PAX gives it and its working directory is `/`, as on PAX; with
# exactly PAX's argv and environment (HOME=/ TERM=linux PAX=1), standard
# input /dev/null (PAX's console reads end-of-file) and standard output
# and standard error ONE pipe (PAX's console is one stream). ROOT/dev is
# the host's /dev bound in (boreutils opens /dev/stdout) and ROOT/proc a
# proc mount, both removed at the end. OUTDIR/<k>.out gets the bytes,
# OUTDIR/<k>.rc the exit status (or `signal N`).
#
# --strace: each command also runs under `strace -f` (through chroot(8),
# its output discarded), and OUTDIR/<k>.strace keeps the trace from the
# program's own execve on: black-box, the census of what it asks of
# Linux.
#
# Needs root (chroot, mount). Exit 0 when every command ran (whatever
# its status), 2 on a usage or tool error.
import os
import shutil
import subprocess
import sys

ENV = {"HOME": "/", "TERM": "linux", "PAX": "1"}


def die(msg):
    sys.stderr.write("linux-run: %s\n" % msg)
    sys.exit(2)


def tool(name):
    # ENV has no PATH (PAX gives none), so name tools by this host's
    path = shutil.which(name)
    if path is None:
        die("no %s on PATH" % name)
    return path


def commands(path):
    out = []
    for line in open(path, "rb").read().split(b"\n"):
        if not line or line.startswith(b"#"):
            continue
        out.append([w.decode() for w in line.split(b" ") if w])
    return out


def run(root, argv):
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(r)
            os.chroot(root)
            os.chdir("/")
            n = os.open("/dev/null", os.O_RDONLY)
            os.dup2(n, 0)
            os.dup2(w, 1)
            os.dup2(w, 2)
            for fd in (n, w):
                if fd > 2:
                    os.close(fd)
            os.execve(argv[0], argv, ENV)
        except OSError as e:
            os.write(2, ("linux-run: exec %s: %s\n" % (argv[0], e)).encode())
        os._exit(127)
    os.close(w)
    data = b""
    while True:
        chunk = os.read(r, 65536)
        if not chunk:
            break
        data += chunk
    os.close(r)
    _, st = os.waitpid(pid, 0)
    if os.WIFSIGNALED(st):
        return data, "signal %d" % os.WTERMSIG(st)
    return data, str(os.WEXITSTATUS(st))


def main(argv):
    strace = False
    if len(argv) > 1 and argv[1] == "--strace":
        strace = True
        argv = argv[:1] + argv[2:]
    if len(argv) != 4:
        die("usage: linux-run [--strace] ROOT RUNLIST OUTDIR")
    root, runlist, outdir = os.path.abspath(argv[1]), argv[2], argv[3]
    if os.geteuid() != 0:
        die("needs root (chroot, mount)")
    os.makedirs(outdir, exist_ok=True)
    cmds = commands(runlist)
    mounted = []
    for d in ("dev", "proc"):
        p = os.path.join(root, d)
        if os.path.exists(p):
            die("%s exists in ROOT already" % d)
        os.mkdir(p)
    try:
        subprocess.run(["mount", "--rbind", "/dev", os.path.join(root, "dev")], check=True)
        mounted.append(os.path.join(root, "dev"))
        # private, so nothing done to the copy propagates to the host's
        subprocess.run(["mount", "--make-rprivate", os.path.join(root, "dev")], check=True)
        subprocess.run(["mount", "-t", "proc", "proc", os.path.join(root, "proc")], check=True)
        mounted.append(os.path.join(root, "proc"))
        for k, cmd in enumerate(cmds, 1):
            data, rc = run(root, cmd)
            open(os.path.join(outdir, "%d.out" % k), "wb").write(data)
            open(os.path.join(outdir, "%d.rc" % k), "w").write(rc + "\n")
            line = "%d: %s -> %s, %d bytes" % (k, " ".join(cmd), rc, len(data))
            if strace:
                t = os.path.join(outdir, "%d.strace.raw" % k)
                subprocess.run([tool("strace"), "-f", "-qq", "-s", "64", "-o", t, tool("chroot"), root] + cmd,
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, env=ENV)
                lines = open(t, errors="replace").read().splitlines()
                start = 0
                for i, l in enumerate(lines):
                    if ' execve("%s"' % cmd[0] in l and l.endswith("= 0"):
                        start = i
                open(os.path.join(outdir, "%d.strace" % k), "w").write("\n".join(lines[start:]) + "\n")
                os.unlink(t)
                calls = sorted({l.split(None, 1)[1].split("(", 1)[0] for l in lines[start:]
                                if len(l.split(None, 1)) > 1 and "(" in l.split(None, 1)[1]})
                line += "; calls: " + " ".join(calls)
            print(line)
    finally:
        for m in reversed(mounted):
            subprocess.run(["umount", "-l", m])
        for d in ("dev", "proc"):
            p = os.path.join(root, d)
            if os.path.isdir(p) and not os.listdir(p):
                os.rmdir(p)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
