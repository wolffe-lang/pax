#!/usr/bin/env bash
# mkdmesg — build /bin/dmesg (user/dmesg, px130) as a fully static x86-64 Linux
# executable, with kernel/wolf.pin's wolf.
#
#   tools/mkdmesg OUTDIR
#
# dmesg is pax's own program, built as pax-boot-status is (px118): pax's own
# wolf (the release archive kernel/wolf.pin names, tools/fetch-wolf; $PAX_WOLF
# when set), builtins only (no wolf-std) and raw.S's six system calls,
# the release tier (`wolf build --release --deny-warnings`), linked through a
# `cc` that adds `-static`, checked with readelf (ET_EXEC, no PT_INTERP);
# `OUTDIR/sums.txt` gets `dmesg <sha256> <bytes>`. Build on a baseline x86-64
# glibc (the CI runner's Ubuntu or an Ubuntu container). The release tier needs
# clang at run time. Exit 0, or 2 on a tool error.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: mkdmesg OUTDIR"
out=$1
need readelf cc clang
mkdir -p "$out"
out=$(cd "$out" && pwd)
wolf=${PAX_WOLF:-}
[ -n "$wolf" ] || wolf=$("$PAX_ROOT/tools/fetch-wolf") || die "tools/fetch-wolf"
say "$("$wolf" --version | head -n 1)"

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-dmesg.XXXXXX")
trap 'rm -rf "$w"' EXIT
cp -R "$PAX_ROOT/user/dmesg" "$w/dmesg"
mkdir -p "$w/bin"
real=$(command -v cc)
printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" > "$w/bin/cc"
chmod +x "$w/bin/cc"

(cd "$w/dmesg" && PATH="$w/bin:$PATH" \
    "$wolf" build --release --no-cache --deny-warnings dmesg.lu -o "$out/dmesg") >&2 \
    || die "wolf build of user/dmesg/dmesg.lu"
readelf -hW "$out/dmesg" | grep -Eq 'Type: +EXEC' || die "dmesg is not ET_EXEC"
! readelf -lW "$out/dmesg" | grep -q INTERP || die "dmesg has a PT_INTERP (not static)"
printf '%s %s %s\n' dmesg "$(sha256_of "$out/dmesg")" "$(wc -c < "$out/dmesg" | tr -d ' ')" | tee "$out/sums.txt"
