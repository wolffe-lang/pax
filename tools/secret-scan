#!/usr/bin/env python3
"""secret-scan — count the files that hold a secret, printing no secret (px104).

    tools/secret-scan [--name-file F] [--token-file F] [--key-file F] PATH...

Each secret is read from its file (0600, never copied): the name, the
token, the key. Every regular file under each PATH (symbolic links not
followed) is read whole and searched for:
  name   the name;
  url    https://github.com/wolffe-lang/NAME(.git), git@github.com:wolffe-lang/NAME(.git)
         and wolffe-lang/NAME (each holds the name, so a url hit is a name hit too);
  token  the token, its hex, the Basic credential (base64 of
         x-access-token:TOKEN) and that credential's hex;
  key    the key file whole, each of its base64 lines of 16 characters or more,
         and the bytes those lines decode to.
A path whose own name holds the name or the token is counted as well.
Directories holding a secret's own file are not walked. The output is
counts alone: `SCAN files=F bytes=B unreadable=U name=N url=R token=T key=K
paths=P`, then one `SCAN-HIT class=C path=…` line per hit with the secrets
in the path replaced. tests/mpx4-console-push.d/push.py calls `scan` with the
values it holds in memory. Exit 0 when every count is 0, 1 when any is not,
2 on a usage error.
"""
import base64
import binascii
import os
import sys


def classes_of(name, token, key):
    classes = {'name': [], 'url': [], 'token': [], 'key': []}
    if name:
        classes['name'] = [name]
        for base in (b'https://github.com/wolffe-lang/' + name, b'git@github.com:wolffe-lang/' + name):
            classes['url'] += [base + b'.git', base]
        classes['url'].append(b'wolffe-lang/' + name)
    if token:
        basic = base64.b64encode(b'x-access-token:' + token)
        classes['token'] = [token, token.hex().encode(), basic, basic.hex().encode()]
    if key:
        classes['key'] = [key.strip()]
        body = b''
        for line in key.splitlines():
            line = line.strip()
            if len(line) >= 16 and not line.startswith(b'-----'):
                classes['key'].append(line)
                body += line
        try:
            blob = base64.b64decode(body) if body else b''
        except (binascii.Error, ValueError):
            blob = b''
        if len(blob) >= 32:
            classes['key'].append(blob)
    return classes


def scan(name, token, key, tops, skip=()):
    """(the SCAN line, [SCAN-HIT lines], 0 or 1) for the values given as bytes."""
    classes = classes_of(name, token, key)
    skip = [os.path.realpath(s) for s in skip]
    files = size = unreadable = paths = 0
    hits = {c: [] for c in classes}
    lines = []

    def shown(p):
        for s, r in ((name, '<name>'), (token, '<token>')):
            if s:
                p = p.replace(s.decode(errors='replace'), r)
        return p
    for top in tops:
        top = str(top)
        walk = [(os.path.dirname(top), [], [os.path.basename(top)])] if os.path.isfile(top) else os.walk(top)
        for d, ds, fs in walk:
            if any(os.path.realpath(d).startswith(s) for s in skip):
                ds[:] = []
                continue
            for n in list(ds) + list(fs):
                b = n.encode(errors='surrogateescape')
                if (name and name in b) or (token and token in b):
                    paths += 1
                    lines.append('SCAN-HIT class=path path=%s' % shown(os.path.join(d, n)))
            for f in fs:
                p = os.path.join(d, f)
                if os.path.islink(p) or not os.path.isfile(p):
                    continue
                try:
                    data = open(p, 'rb').read()
                except OSError:
                    unreadable += 1
                    continue
                files += 1
                size += len(data)
                for c, needles in classes.items():
                    if any(n and n in data for n in needles):
                        hits[c].append(p)
    for c in classes:
        for p in hits[c]:
            lines.append('SCAN-HIT class=%s path=%s' % (c, shown(p)))
    head = 'SCAN files=%d bytes=%d unreadable=%d name=%d url=%d token=%d key=%d paths=%d' % (
        files, size, unreadable, len(hits['name']), len(hits['url']), len(hits['token']), len(hits['key']), paths)
    return head, lines, 1 if any(hits.values()) or paths else 0


def main():
    args = sys.argv[1:]
    got = {'--name-file': None, '--token-file': None, '--key-file': None}
    while args and args[0] in got:
        if len(args) < 2:
            break
        got[args[0]] = args[1]
        args = args[2:]
    if not args or not any(got.values()):
        print('usage: secret-scan [--name-file F] [--token-file F] [--key-file F] PATH...', file=sys.stderr)
        return 2

    def read(p):
        return open(p, 'rb').read() if p else b''
    name, token, key = read(got['--name-file']).strip(), read(got['--token-file']).strip(), read(got['--key-file'])
    skip = [os.path.dirname(os.path.realpath(p)) for p in got.values() if p]
    head, lines, rc = scan(name, token, key, args, skip)
    print(head, flush=True)
    for line in lines:
        print(line, flush=True)
    return rc


if __name__ == '__main__':
    sys.exit(main())
