#!/usr/bin/env python3
"""secret-scan — count the files that hold a secret, printing no secret (px104).

    tools/secret-scan [--name-file F] [--token-file F] [--key-file F] PATH...

Each secret is read from its file (0600, never copied): the name, the
token, the key. Every regular file under each PATH (symbolic links not
followed) is read whole and searched for:
  name   the name;
  url    https://github.com/wolffe-lang/NAME(.git), git@github.com:wolffe-lang/NAME(.git)
         and wolffe-lang/NAME (each holds the name, so a url hit is a name hit too);
  token  the token, its hex, the Basic credential (base64 of
         x-access-token:TOKEN) and that credential's hex;
  key    the key file whole, each of its base64 lines of 16 characters or more,
         and the bytes those lines decode to. A line is left out when a key
         of the same type made now (fresh_key: in memory, never written)
         holds the same line: such a line is the format's, every key of the
         type has it (an OpenSSH ed25519 key's first line: the magic, no
         cipher, no kdf, one key, the type's name), so it names no key. Every
         line unique to the key counts, the public half's included. The
         count left out is printed: `SCAN-GENERIC key=N (…)`.
A path whose own name holds the name or the token is counted as well.
Directories holding a secret's own file are not walked. The output is
counts alone: `SCAN files=F bytes=B unreadable=U name=N url=R token=T key=K
paths=P`, then (with a key) the `SCAN-GENERIC` line, then one `SCAN-HIT
class=C path=…` line per hit with the secrets in the path replaced. tests/mpx4-console-push.d/push.py calls `scan` with the
values it holds in memory. Exit 0 when every count is 0, 1 when any is not,
2 on a usage error.
"""
import base64
import binascii
import hashlib
import os
import struct
import sys

# RFC 8032's edwards25519 (section 5.1): the field, the curve's d, the base
# point, for the public half of a key made here.
P = 2 ** 255 - 19
D = -121665 * pow(121666, P - 2, P) % P
BY = 4 * pow(5, P - 2, P) % P


def _x(y):
    x2 = (y * y - 1) * pow(D * y * y + 1, P - 2, P) % P
    x = pow(x2, (P + 3) // 8, P)
    if (x * x - x2) % P:
        x = x * pow(2, (P - 1) // 4, P) % P
    return P - x if x & 1 else x


def _add(a, b):
    A = (a[1] - a[0]) * (b[1] - b[0]) % P
    B = (a[1] + a[0]) * (b[1] + b[0]) % P
    C = 2 * a[3] * b[3] * D % P
    E = 2 * a[2] * b[2] % P
    e, f, g, h = B - A, E - C, E + C, B + A
    return (e * f % P, g * h % P, f * g % P, e * h % P)


def _public(seed):
    h = hashlib.sha512(seed).digest()
    s = int.from_bytes(h[:32], 'little') & ((1 << 254) - 8) | (1 << 254)
    bx = _x(BY)
    q, b = (0, 1, 1, 0), (bx, BY, 1, bx * BY % P)
    while s:
        if s & 1:
            q = _add(q, b)
        b = _add(b, b)
        s >>= 1
    zi = pow(q[2], P - 2, P)
    x, y = q[0] * zi % P, q[1] * zi % P
    return (y | (x & 1) << 255).to_bytes(32, 'little')


def _string(b):
    return struct.pack('>I', len(b)) + b


def fresh_key(kind):
    """(an unencrypted OpenSSH private key file of KIND, its public key),
    made now in memory from fresh random bytes; None for a kind not made
    here. The layout is the one ssh-keygen writes, read black box from its
    output (tests/mpx4-console-push.d/scan-rows.py T3 holds ssh-keygen to
    reading this key back)."""
    if kind != 'ssh-ed25519':
        return None
    seed = os.urandom(32)
    public = _public(seed)
    check = os.urandom(4)
    private = check + check + _string(b'ssh-ed25519') + _string(public) + _string(seed + public) + _string(b'')
    pad = 1
    while len(private) % 8:
        private += bytes([pad])
        pad += 1
    blob = (b'openssh-key-v1\0' + _string(b'none') + _string(b'none') + _string(b'') + struct.pack('>I', 1)
            + _string(_string(b'ssh-ed25519') + _string(public)) + _string(private))
    text = base64.b64encode(blob)
    lines = [text[i:i + 70] for i in range(0, len(text), 70)]
    pem = b'-----BEGIN OPENSSH PRIVATE KEY-----\n' + b'\n'.join(lines) + b'\n-----END OPENSSH PRIVATE KEY-----\n'
    return pem, public


def key_kind(blob):
    """The key type an OpenSSH private key file's decoded body names, or ''."""
    try:
        if not blob.startswith(b'openssh-key-v1\0'):
            return ''
        at = 15
        for _ in range(3):  # cipher, kdf, kdf options
            n = struct.unpack('>I', blob[at:at + 4])[0]
            at += 4 + n
        at += 4  # the number of keys
        at += 4  # the public key's length
        n = struct.unpack('>I', blob[at:at + 4])[0]
        return blob[at + 4:at + 4 + n].decode('ascii')
    except (struct.error, UnicodeDecodeError):
        return ''


def classes_of(name, token, key):
    classes = {'name': [], 'url': [], 'token': [], 'key': []}
    if name:
        classes['name'] = [name]
        for base in (b'https://github.com/wolffe-lang/' + name, b'git@github.com:wolffe-lang/' + name):
            classes['url'] += [base + b'.git', base]
        classes['url'].append(b'wolffe-lang/' + name)
    if token:
        basic = base64.b64encode(b'x-access-token:' + token)
        classes['token'] = [token, token.hex().encode(), basic, basic.hex().encode()]
    classes['generic'] = None
    if key:
        classes['key'] = [key.strip()]
        lines = [l.strip() for l in key.splitlines()]
        lines = [l for l in lines if len(l) >= 16 and not l.startswith(b'-----')]
        body = b''.join(lines)
        try:
            blob = base64.b64decode(body) if body else b''
        except (binascii.Error, ValueError):
            blob = b''
        kind = key_kind(blob)
        made = fresh_key(kind)
        shared = set(l.strip() for l in made[0].splitlines()) if made else set()
        made = None
        excluded = 0
        for line in lines:
            if line in shared:
                excluded += 1
            else:
                classes['key'].append(line)
        if len(blob) >= 32:
            classes['key'].append(blob)
        classes['generic'] = 'SCAN-GENERIC key=%d (%s)' % (
            excluded, ('the lines an %s key made now in memory shares, not counted' % kind) if kind == 'ssh-ed25519'
            else 'no key of this type made here: every line counted')
    return classes


def scan(name, token, key, tops, skip=()):
    """(the SCAN line, [SCAN-HIT lines], 0 or 1) for the values given as bytes."""
    classes = classes_of(name, token, key)
    generic = classes.pop('generic')
    skip = [os.path.realpath(s) for s in skip]
    files = size = unreadable = paths = 0
    hits = {c: [] for c in classes}
    lines = [generic] if generic else []

    def shown(p):
        for s, r in ((name, '<name>'), (token, '<token>')):
            if s:
                p = p.replace(s.decode(errors='replace'), r)
        return p
    for top in tops:
        top = str(top)
        walk = [(os.path.dirname(top), [], [os.path.basename(top)])] if os.path.isfile(top) else os.walk(top)
        for d, ds, fs in walk:
            if any(os.path.realpath(d).startswith(s) for s in skip):
                ds[:] = []
                continue
            for n in list(ds) + list(fs):
                b = n.encode(errors='surrogateescape')
                if (name and name in b) or (token and token in b):
                    paths += 1
                    lines.append('SCAN-HIT class=path path=%s' % shown(os.path.join(d, n)))
            for f in fs:
                p = os.path.join(d, f)
                if os.path.islink(p) or not os.path.isfile(p):
                    continue
                try:
                    data = open(p, 'rb').read()
                except OSError:
                    unreadable += 1
                    continue
                files += 1
                size += len(data)
                for c, needles in classes.items():
                    if any(n and n in data for n in needles):
                        hits[c].append(p)
    for c in classes:
        for p in hits[c]:
            lines.append('SCAN-HIT class=%s path=%s' % (c, shown(p)))
    head = 'SCAN files=%d bytes=%d unreadable=%d name=%d url=%d token=%d key=%d paths=%d' % (
        files, size, unreadable, len(hits['name']), len(hits['url']), len(hits['token']), len(hits['key']), paths)
    return head, lines, 1 if any(hits.values()) or paths else 0


def main():
    args = sys.argv[1:]
    got = {'--name-file': None, '--token-file': None, '--key-file': None}
    while args and args[0] in got:
        if len(args) < 2:
            break
        got[args[0]] = args[1]
        args = args[2:]
    if not args or not any(got.values()):
        print('usage: secret-scan [--name-file F] [--token-file F] [--key-file F] PATH...', file=sys.stderr)
        return 2

    def read(p):
        return open(p, 'rb').read() if p else b''
    name, token, key = read(got['--name-file']).strip(), read(got['--token-file']).strip(), read(got['--key-file'])
    skip = [os.path.dirname(os.path.realpath(p)) for p in got.values() if p]
    head, lines, rc = scan(name, token, key, args, skip)
    print(head, flush=True)
    for line in lines:
        print(line, flush=True)
    return rc


if __name__ == '__main__':
    sys.exit(main())
