#!/usr/bin/env bash
# mkimage — wrap a kernel ELF into a hybrid BIOS + UEFI ISO with Limine.
#
#   tools/mkimage [--conf LIMINE.conf] [--add ELF NAME]... KERNEL.elf OUT.iso
#
# The ISO holds /boot/pax (the kernel), Limine's BIOS and UEFI stages,
# and boot/limine.conf. `--conf` puts another Limine configuration in
# its place (px08's reel: a menu); each `--add ELF NAME` adds one more
# kernel at /boot/NAME for that configuration's entries to name. It boots under SeaBIOS and OVMF alike, and is
# the shape a USB stick takes later (an isohybrid image). Needs xorriso
# and a staged Limine (tools/fetch-limine).
set -euo pipefail
. "$(dirname "$0")/lib.sh"
conf=$PAX_ROOT/boot/limine.conf
adds=()
while [ $# -gt 0 ]; do
    case $1 in
        --conf) conf=$2; shift 2 ;;
        --add)  [ $# -ge 3 ] || die "--add takes ELF NAME"; adds+=("$2" "$3"); shift 3 ;;
        *)      break ;;
    esac
done
[ $# -eq 2 ] || die "usage: mkimage [--conf LIMINE.conf] [--add ELF NAME]... KERNEL.elf OUT.iso"
kernel=$1; iso=$2
[ -f "$conf" ] || die "no Limine configuration: $conf"
for ((i = 0; i < ${#adds[@]}; i += 2)); do
    [ -f "${adds[i]}" ] || die "no kernel: ${adds[i]}"
    case ${adds[i + 1]} in ''|*/*|pax) die "--add NAME must be a plain file name other than pax: ${adds[i + 1]}" ;; esac
done
[ -f "$kernel" ] || die "no kernel: $kernel"
need xorriso
load_limine_pin
[ -x "$LIMINE_DIR/limine" ] || die "Limine $LIMINE_VERSION is not staged; run tools/fetch-limine"

root=$(mktemp -d "${TMPDIR:-/tmp}/pax-iso.XXXXXX")
trap 'rm -rf "$root"' EXIT
mkdir -p "$root/boot/limine" "$root/EFI/BOOT"
cp "$kernel" "$root/boot/pax"
for ((i = 0; i < ${#adds[@]}; i += 2)); do
    cp "${adds[i]}" "$root/boot/${adds[i + 1]}"
done
cp "$conf" "$root/boot/limine/limine.conf"
cp "$LIMINE_DIR/limine-bios.sys" "$LIMINE_DIR/limine-bios-cd.bin" \
   "$LIMINE_DIR/limine-uefi-cd.bin" "$root/boot/limine/"
cp "$LIMINE_DIR/BOOTX64.EFI" "$root/EFI/BOOT/"

# Reproducible: every date in the image is SOURCE_DATE_EPOCH (default
# the last commit's time), which xorriso honours for its own volume
# dates; the staged files' mtimes are set to it too. Two builds of one
# commit give one digest.
SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(git -C "$PAX_ROOT" log -1 --format=%ct 2>/dev/null || echo 0)}
export SOURCE_DATE_EPOCH
find "$root" -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} +

mkdir -p "$(dirname "$iso")"
xorriso -as mkisofs -R -r -J \
    -b boot/limine/limine-bios-cd.bin -no-emul-boot -boot-load-size 4 -boot-info-table \
    -hfsplus -apm-block-size 2048 \
    --efi-boot boot/limine/limine-uefi-cd.bin -efi-boot-part --efi-boot-image \
    --protective-msdos-label "$root" -o "$iso" 2>"$iso.xorriso.log" \
    || { cat "$iso.xorriso.log" >&2; die "xorriso failed"; }
"$LIMINE_DIR/limine" bios-install "$iso" >"$iso.bios-install.log" 2>&1 \
    || { cat "$iso.bios-install.log" >&2; die "limine bios-install failed"; }
printf '%s\n' "$iso"
