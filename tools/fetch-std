#!/usr/bin/env bash
# fetch-std OUTDIR — stage user/std.pin's std/ subtree and a manifest of
# every file. No compiler is run; symlinks and non-regular files are
# refused rather than omitted from the installed tree's digest.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: fetch-std OUTDIR"
need git python3
. "$PAX_ROOT/user/std.pin"
mkdir -p "$1"
out=$(cd "$1" && pwd)
[ ! -e "$out/std" ] || die "$out/std already exists (use a fresh OUTDIR)"
w=$(mktemp -d "${TMPDIR:-/tmp}/pax-std.XXXXXX")
trap 'rm -rf "$w"' EXIT
git -C "$w" init -q
git -C "$w" fetch -q --depth 1 "$STD_REPO" "$STD_REV" || die "cannot fetch wolf-std $STD_REV"
git -C "$w" checkout -q --detach FETCH_HEAD
[ "$(git -C "$w" rev-parse HEAD)" = "$STD_REV" ] || die "wolf-std HEAD is not $STD_REV"
[ -d "$w/std" ] || die "wolf-std $STD_REV has no std/"
cp -R "$w/std" "$out/std"
python3 -I - "$out" <<'PY'
from pathlib import Path
import hashlib, sys
out = Path(sys.argv[1])
files = sorted((out / 'std').rglob('*'))
rows = []
for p in files:
    if p.is_symlink() or not (p.is_file() or p.is_dir()):
        raise SystemExit('fetch-std: non-regular entry: ' + str(p))
    if p.is_file():
        name = p.relative_to(out).as_posix()
        if '\n' in name or '\r' in name or '\\' in name:
            raise SystemExit('fetch-std: unrepresentable manifest name: ' + repr(name))
        rows.append(hashlib.sha256(p.read_bytes()).hexdigest() + '  ' + name + '\n')
if not rows:
    raise SystemExit('fetch-std: empty std tree')
manifest = ''.join(rows).encode()
(out / 'std.sha256').write_bytes(manifest)
line = 'std-manifest %s %d files\n' % (hashlib.sha256(manifest).hexdigest(), len(rows))
(out / 'sums.txt').write_text(line)
print(line, end='')
PY
