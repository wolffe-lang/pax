#!/usr/bin/env python3
# orch-stress (px32): a 230 s, 16-part tune in the part format, to measure the render
# budget at the Mahler span's size (notes/px32-the-orchestra.md, P3).
# Not music: every part moves through a fixed cycle of chords.
#   tools/orch-stress [PARTS [BARS]] > FILE   (default 16 parts, 80 bars:
#   tests/mpx3-orchestra's `long`; 48 parts: its `wide`). Past 16 the
#   parts repeat the list, an octave apart where the range allows.
parts = [("fl", "flute"), ("ob", "oboe"), ("cl", "clarinet"), ("hn", "horn"),
         ("tp", "trumpet"), ("tb", "trombone"), ("ch", "choir"), ("so", "voice"),
         ("org", "organ"), ("ped", "pedal"), ("vn", "strings"), ("va", "strings"),
         ("vc", "strings"), ("tim", "timpani"), ("bel", "bells"), ("tt", "tamtam")]
chords = [["Eb", "G", "Bb"], ["C", "Eb", "G"], ["Ab", "C", "Eb"], ["Bb", "D", "F"]]
octs = {"fl": 5, "ob": 5, "cl": 4, "hn": 4, "tp": 5, "tb": 3, "ch": 4, "so": 5,
        "org": 4, "ped": 2, "vn": 5, "va": 4, "vc": 3, "tim": 2, "bel": 5, "tt": 3}
import sys
np_ = int(sys.argv[1]) if len(sys.argv) > 1 else 16
nb = int(sys.argv[2]) if len(sys.argv) > 2 else 80
base = list(parts)
parts = []
for i in range(np_):
    n, t = base[i % 16]
    k = i // 16
    nm = n if k == 0 else "%s%d" % (n, k + 1)
    octs[nm] = octs[n] + (0 if k == 0 else (1 if octs[n] < 4 else -1) * (1 if k == 1 else 0))
    parts.append((nm, t))
if np_ == 16 and nb == 80:
    print("title stress, 16 parts for 230 s")
else:
    print("title stress, %d parts, %d bars" % (np_, nb))
print("tempo 84")
for i, (n, t) in enumerate(parts):
    print("part %s %s mf pan %d" % (n, t, -80 + i * 10 if np_ <= 16 else -80 + (i * 160) // (np_ - 1)))
for b in range(1, nb + 1):
    c = chords[b % 4]
    o = None
    print("bar %d" % b)
    for n, t in parts:
        o = octs[n]
        base_n = n.rstrip("0123456789")
        if base_n in ("ch", "org"):
            ev = "%s/2 %s/2" % (",".join("%s%d" % (x, o) for x in c), ",".join("%s%d" % (x, o) for x in c[::-1]))
        elif base_n == "tim":
            ev = "%s%d/4> r/4 %s%d/2*" % (c[0], o, c[0], o)
        elif base_n in ("bel", "tt"):
            ev = ("%s%d/1" % (c[0], o)) if b % 4 == 1 else "r/1"
        elif base_n in ("vn", "va"):
            ev = " ".join("%s%d/8*" % (c[k % 3], o) for k in range(8))
        else:
            ev = "%s%d/4 %s%d/4 %s%d/4' %s%d/4" % (c[0], o, c[1], o, c[2], o, c[1], o)
        dyn = "< " if b % 8 == 1 else ("> " if b % 8 == 5 else "")
        end = " ff" if b % 8 == 4 else (" p" if b % 8 == 0 else "")
        print("%-4s %s%s%s" % (n, dyn, ev, end))
