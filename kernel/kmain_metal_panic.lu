//! member: false
use log
use panic
use serial
export fn pax_interrupt(_frame: u64) -> u64 { panic.halt() }
export fn pax_trace_resume_syscall(_frame: u64) -> u64 { panic.halt() } // px102: boot/isr.S calls both; nothing here traces
export fn pax_trace_finish_syscall(_frame: u64) -> u64 { panic.halt() }
export fn pax_thread_exit() { panic.halt() }
export fn kmain() {
    serial.init()
    log.line("PAX metal early")
    panic.fail("metal early witness", 76)
}
