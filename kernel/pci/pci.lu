//! pci — the PCI bus through configuration mechanism #1 (px20).
//!
//! **Configuration access.** Mechanism #1 is two 32-bit I/O ports: the
//! address port 0xCF8 takes `1 << 31 | bus << 16 | device << 11 |
//! function << 8 | (offset & 0xfc)`, and the data port 0xCFC then reads
//! or writes that function's configuration doubleword. A read of a
//! function that is not there returns all ones, so vendor id 0xffff
//! means "nothing here". Narrower fields are taken out of the
//! doubleword read; the one narrower write, the command register, is a
//! doubleword write whose upper half (the status register, whose bits
//! clear when written 1) is zero. Every access is made with IF clear:
//! the address port is state.
//!
//! **The scan.** `scan` walks bus 0: each device's function 0, and
//! functions 1-7 when its header type has bit 7 (multi-function). A
//! PCI-to-PCI bridge (header type 1) names a secondary bus, which is
//! walked the same way (q35 has none by default; a device behind a
//! PCIe root port is found this way). Each function found is one record
//! of eight words in boot/net.S's `pax_pci_table` (64 at most): its
//! address, ids, class and revision, subsystem, header type and
//! interrupt pin and line. BARs and the capability list are read from
//! the function when asked (`bar`, `next_cap`), not copied.
//!
//! **A BAR** (a type 0 header's six at 0x10-0x24): bit 0 set is an I/O
//! range (address in bits 31:2); clear is memory, bits 2:1 its type (0
//! a 32-bit address, 2 a 64-bit one whose high half is the next BAR),
//! bit 3 prefetchable, the address in bits 31:4. Nothing here sizes a
//! BAR (that takes writing it).
//!
//! **Capabilities**: status bit 4 says the list exists; the byte at
//! 0x34 points at the first, each is `id, next, …`, and next 0 ends it.
//!
//! `report` writes the census: one line a function, then one for each
//! BAR in use and one for the capability list.
//!
//! Written from the PCI Local Bus specification (configuration
//! mechanism #1, the type 0 and type 1 configuration headers, base
//! address registers, the capability list) and the PCI-to-PCI bridge
//! architecture specification (the secondary bus number), as the
//! author knows them, each fact confirmed against QEMU's monitor
//! (`info pci`, notes/px20). No Linux source; no other kernel's or
//! firmware's source.

use log
use sync

extern "c" fn pax_outl(port: u16, v: u32)
extern "c" fn pax_inl(port: u16) -> u32

extern "c" let pax_pci_table: *u64
extern "c" let pax_pci_count: *u64

const ADDRESS: u16 = 0xcf8
const DATA: u16 = 0xcfc
const ENABLE: u64 = 0x80000000

/// How many functions the table holds.
pub const MAX: u64 = 64
const WORDS: u64 = 8

// A record's words.
const R_BDF: u64 = 0 // bus << 16 | device << 8 | function
const R_IDS: u64 = 1 // device << 16 | vendor
const R_CLASS: u64 = 2 // class << 24 | subclass << 16 | interface << 8 | revision
const R_SUBSYS: u64 = 3 // subsystem << 16 | subsystem vendor
const R_HEADER: u64 = 4 // the header type byte
const R_IRQ: u64 = 5 // pin << 8 | line

// Configuration offsets (the common header).
/// The command register's offset.
pub const COMMAND: u64 = 0x04
const CLASS: u64 = 0x08
const HEADER: u64 = 0x0c
const BAR0: u64 = 0x10
const BUSES: u64 = 0x18 // type 1: primary, secondary, subordinate
const SUBSYS: u64 = 0x2c // type 0
const CAP_PTR: u64 = 0x34
const IRQ: u64 = 0x3c

/// Command bit 1: the function answers its memory BARs.
pub const CMD_MEMORY: u64 = 0x2
/// Command bit 2: the function may master the bus (a virtio device reads and writes the rings).
pub const CMD_MASTER: u64 = 0x4
/// Command bit 10: INTx disabled.
pub const CMD_INTX_OFF: u64 = 0x400

/// `bar`'s kinds: no BAR.
pub const BAR_NONE: u64 = 0
/// An I/O range.
pub const BAR_IO: u64 = 1
/// Memory at a 32-bit address.
pub const BAR_MEM32: u64 = 2
/// Memory at a 64-bit address (two BARs).
pub const BAR_MEM64: u64 = 3

fn rec(i: u64, w: u64) -> u64 {
    // # Safety: i < MAX and w < WORDS, inside boot/net.S's table.
    unsafe { ((pax_pci_table as u64 + (i * WORDS + w) * 8) as *u64).read_volatile() }
}

fn put_rec(i: u64, w: u64, v: u64) {
    // # Safety: as `rec`.
    unsafe { ((pax_pci_table as u64 + (i * WORDS + w) * 8) as *u64).write_volatile(v) }
}

/// How many functions the last `scan` found.
pub fn count() -> u64 {
    // # Safety: boot/net.S's word.
    unsafe { (pax_pci_count as u64 as *u64).read_volatile() }
}

fn set_count(n: u64) {
    // # Safety: as `count`.
    unsafe { (pax_pci_count as u64 as *u64).write_volatile(n) }
}

/// The configuration doubleword at `off` (rounded down to 4) of the
/// function at `bdf`.
pub fn read32(bdf: u64, off: u64) -> u64 {
    let a = ENABLE | ((bdf >> 16) & 0xff) << 16 | ((bdf >> 8) & 0x1f) << 11 | (bdf & 7) << 8 | (off & 0xfc)
    let saved = sync.irq_save()
    // # Safety: io.S's OUTL and INL on mechanism #1's two ports; `a`
    // fits 32 bits.
    let v = unsafe {
        pax_outl(ADDRESS, a as u32)
        pax_inl(DATA)
    }
    sync.irq_restore(saved)
    v as u64
}

/// Write the configuration doubleword at `off` of the function at `bdf`.
pub fn write32(bdf: u64, off: u64, v: u64) {
    let a = ENABLE | ((bdf >> 16) & 0xff) << 16 | ((bdf >> 8) & 0x1f) << 11 | (bdf & 7) << 8 | (off & 0xfc)
    let saved = sync.irq_save()
    // # Safety: as `read32`; `v` is masked to 32 bits.
    unsafe {
        pax_outl(ADDRESS, a as u32)
        pax_outl(DATA, (v & 0xffffffff) as u32)
    }
    sync.irq_restore(saved)
}

/// The 16-bit field at `off` (even).
pub fn read16(bdf: u64, off: u64) -> u64 {
    (read32(bdf, off) >> ((off & 2) * 8)) & 0xffff
}

/// The byte at `off`.
pub fn read8(bdf: u64, off: u64) -> u64 {
    (read32(bdf, off) >> ((off & 3) * 8)) & 0xff
}

/// The command register.
pub fn command(bdf: u64) -> u64 {
    read16(bdf, COMMAND)
}

/// Write the command register (the status register beside it is
/// written 0: its bits clear only when written 1).
pub fn set_command(bdf: u64, v: u64) {
    write32(bdf, COMMAND, v & 0xffff)
}

fn add(bus: u64, dev: u64, func: u64) {
    let n = count()
    if n >= MAX {
        return
    }
    let bdf = bus << 16 | dev << 8 | func
    put_rec(n, R_BDF, bdf)
    put_rec(n, R_IDS, read32(bdf, 0))
    put_rec(n, R_CLASS, read32(bdf, CLASS))
    let h = read8(bdf, HEADER + 2)
    put_rec(n, R_HEADER, h)
    put_rec(n, R_SUBSYS, if h & 0x7f == 0 { read32(bdf, SUBSYS) } else { 0 })
    put_rec(n, R_IRQ, read16(bdf, IRQ))
    set_count(n + 1)
}

fn scan_bus(bus: u64) {
    var dev: u64 = 0
    while dev < 32 {
        var func: u64 = 0
        var funcs: u64 = 1
        while func < funcs {
            let bdf = bus << 16 | dev << 8 | func
            if read32(bdf, 0) & 0xffff != 0xffff {
                add(bus, dev, func)
                let h = read8(bdf, HEADER + 2)
                if func == 0 && h & 0x80 != 0 {
                    funcs = 8
                }
                if h & 0x7f == 1 {
                    let secondary = read8(bdf, BUSES + 1)
                    if secondary > bus {
                        scan_bus(secondary)
                    }
                }
            }
            func += 1
        }
        dev += 1
    }
}

/// Walk bus 0 and every bus behind a bridge found on the way. Returns
/// how many functions were recorded.
pub fn scan() -> u64 {
    set_count(0)
    scan_bus(0)
    count()
}

/// Function `i`'s address: bus << 16 | device << 8 | function.
pub fn bdf(i: u64) -> u64 {
    rec(i, R_BDF)
}

/// Function `i`'s vendor id.
pub fn vendor(i: u64) -> u64 {
    rec(i, R_IDS) & 0xffff
}

/// Function `i`'s device id.
pub fn device(i: u64) -> u64 {
    (rec(i, R_IDS) >> 16) & 0xffff
}

/// Function `i`'s interrupt line: what the firmware wrote, the 8259
/// line its pin is routed to (0xff none).
pub fn line(i: u64) -> u64 {
    rec(i, R_IRQ) & 0xff
}

/// Function `i`'s interrupt pin: 1 is A, 0 none.
pub fn pin(i: u64) -> u64 {
    (rec(i, R_IRQ) >> 8) & 0xff
}

/// The first function from `from` on whose vendor is `v` and whose
/// device id lies in `lo..=hi`; `MAX` when there is none.
pub fn find(v: u64, lo: u64, hi: u64, from: u64) -> u64 {
    var i = from
    while i < count() {
        if vendor(i) == v && device(i) >= lo && device(i) <= hi {
            return i
        }
        i += 1
    }
    MAX
}

/// BAR `n` (0-5) of the type 0 function at `bdf`: its kind and
/// address. A 64-bit BAR's upper half (BAR n + 1) answers BAR_NONE
/// when asked for itself only if it reads 0; ask for the lower one.
pub fn bar(bdf: u64, n: u64) -> (u64, u64) {
    let v = read32(bdf, BAR0 + n * 4)
    if v == 0 {
        return (BAR_NONE, 0)
    }
    if v & 1 == 1 {
        return (BAR_IO, v & 0xfffffffc)
    }
    if (v >> 1) & 3 == 2 && n < 5 {
        return (BAR_MEM64, read32(bdf, BAR0 + (n + 1) * 4) << 32 | (v & 0xfffffff0))
    }
    (BAR_MEM32, v & 0xfffffff0)
}

fn bar_prefetchable(bdf: u64, n: u64) -> bool {
    let v = read32(bdf, BAR0 + n * 4)
    v & 1 == 0 && v & 8 != 0
}

/// The capability after the one at `after` in the list of the function
/// at `bdf` (`after` 0: the first). 0 when the list ends or there is
/// none. The capability's id is `read8(bdf, offset)`.
pub fn next_cap(bdf: u64, after: u64) -> u64 {
    if after == 0 {
        if read16(bdf, COMMAND + 2) & 0x10 == 0 {
            return 0
        }
        return read8(bdf, CAP_PTR) & 0xfc
    }
    read8(bdf, after + 1) & 0xfc
}

fn put_bdf(b: u64) {
    log.put("pci ")
    log.hex_n(b >> 16, 2)
    log.put(":")
    log.hex_n((b >> 8) & 0x1f, 2)
    log.put(".")
    log.hex_n(b & 7, 1)
}

/// The census: for each function
/// `pci <bb>:<dd>.<f> <vendor>:<device> class <cc>.<ss>.<ii> rev <rr>[ subsystem <v>:<d>] header <hh> pin <A-D|-> line <n|->`,
/// then `pci <bb>:<dd>.<f> bar<n> io|mem32|mem64[ prefetchable] 0x<address>`
/// for each BAR in use (type 0 headers), then
/// `pci <bb>:<dd>.<f> caps <id>@<offset> …` when it has a list; first
/// `pci: <n> functions (configuration mechanism #1)`.
pub fn report() {
    log.put("pci: ")
    log.dec(count() as int)
    log.put(" functions (configuration mechanism #1)")
    log.end()
    var i: u64 = 0
    while i < count() {
        let b = bdf(i)
        let c = rec(i, R_CLASS)
        let h = rec(i, R_HEADER)
        put_bdf(b)
        log.put(" ")
        log.hex_n(vendor(i), 4)
        log.put(":")
        log.hex_n(device(i), 4)
        log.put(" class ")
        log.hex_n(c >> 24, 2)
        log.put(".")
        log.hex_n(c >> 16, 2)
        log.put(".")
        log.hex_n(c >> 8, 2)
        log.put(" rev ")
        log.hex_n(c, 2)
        if rec(i, R_SUBSYS) != 0 {
            log.put(" subsystem ")
            log.hex_n(rec(i, R_SUBSYS), 4)
            log.put(":")
            log.hex_n(rec(i, R_SUBSYS) >> 16, 4)
        }
        log.put(" header ")
        log.hex_n(h, 2)
        log.put(" pin ")
        if pin(i) >= 1 && pin(i) <= 4 {
            log.put_byte((64 + pin(i)) as int)
        } else {
            log.put("-")
        }
        log.put(" line ")
        if pin(i) != 0 && line(i) != 0xff {
            log.dec(line(i) as int)
        } else {
            log.put("-")
        }
        log.end()
        if h & 0x7f == 0 {
            var n: u64 = 0
            while n < 6 {
                let (kind, addr) = bar(b, n)
                if kind != BAR_NONE {
                    put_bdf(b)
                    log.put(" bar")
                    log.dec(n as int)
                    log.put(if kind == BAR_IO { " io " } else { if kind == BAR_MEM64 { " mem64 " } else { " mem32 " } })
                    if bar_prefetchable(b, n) {
                        log.put("prefetchable ")
                    }
                    log.hex(addr)
                    log.end()
                }
                n += if kind == BAR_MEM64 { 2 } else { 1 }
            }
        }
        var cap = next_cap(b, 0)
        if cap != 0 {
            put_bdf(b)
            log.put(" caps")
            var guard: u64 = 0
            while cap != 0 && guard < 48 {
                log.put(" ")
                log.hex_n(read8(b, cap), 2)
                log.put("@")
                log.hex_n(cap, 2)
                cap = next_cap(b, cap)
                guard += 1
            }
            log.end()
        }
        i += 1
    }
}
