//! member: false
// kmain_free_unusable.lu — a free of a frame that was never usable,
// caught (px02, tests/mpx2-frames F7). Builds the allocator and frees
// the kernel image's first frame (its physical base, from Limine's
// Executable Address response): an executable-and-modules entry, never
// usable, so kernel/frames must panic by name,
//
//     PANIC frames: free of a frame never usable 0x<pa>
//
// with the address the line before printed, and halt.
use boot_info
use frames
use interrupts
use log
use panic
use serial

export fn kmain() {
    serial.init()
    interrupts.start()
    log.line("PAX frames: free of a frame never usable")
    frames.start()
    frames.report()
    let pa = boot_info.image_phys()
    log.put("free the image: ")
    log.hex(pa)
    log.end()
    frames.free(pa) // the image's first frame
    log.line("unreachable")
    panic.halt()
}
