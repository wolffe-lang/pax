//! clock — monotonic nanoseconds from the firmware's counters, callable
//! with interrupts masked (px76; its API agreed with px75b's AHCI).
//!
//! `start()` once, early (every device kernel calls it before pci.scan;
//! kernel/timer calls it before calibrating the tick; a second call does
//! nothing); then `now_ns()`, `wait_us(us)` (a busy wait),
//! `deadline_us(us)` and `expired(d)`. A read before `start` panics by
//! name (no source has a period yet).
//!
//! The source, in order (R-px76-1 A; kasumi's Linux lists `tsc hpet
//! acpi_pm` and no `pit`):
//! - the HPET's main counter (IA-PC HPET 1.0a §2.3.4 the capabilities:
//!   COUNTER_CLK_PERIOD in femtoseconds in bits 63:32, COUNT_SIZE_CAP bit
//!   13; §2.3.6 ENABLE_CNF set and LEG_RT_CNF clear; §2.3.8 the main
//!   counter), at the address the ACPI HPET table gives, mapped at
//!   HPET_VA. It must advance, and where the FADT names an ACPI PM timer
//!   that advances it must agree with it: 10 ms of the PM timer (35795
//!   ticks) must read between 5 and 20 ms on the HPET, or the HPET is
//!   refused on a line of its own (a wrong-unit period or a lying table
//!   on metal, px76's HPET plant, never a hang);
//! - else the ACPI PM timer (ACPI 6.5 §4.8.3.3: 3.579545 MHz, 24 or 32
//!   bits by the FADT's TMR_VAL_EXT flag), if it advances;
//! - else the PIT's channel 0 read back (8254 mode 2, divisor 65535): its
//!   54.9 ms wrap needs a sample at least that often, which kernel/timer's
//!   tick takes.
//! One line names the choice: `clock: HPET <fs> fs/tick, checked against
//! the PM timer` (or `, unchecked: no PM timer`), `clock: PM 3579545 Hz`
//! or `clock: PIT 1193182 Hz`. No Linux source; no other kernel's source.
use acpi
use log
use paging
use panic
use sync
extern "c" fn pax_inl(port: u16) -> u32
extern "c" fn pax_inb(port: u16) -> u8
extern "c" fn pax_outb(port: u16, value: u8)
const HPET_VA: u64 = 0xffffb00000001000
var source: u64 = 0
var address: u64 = 0
var period: u64 = 0
var mask: u64 = 0
var previous: u64 = 0
var elapsed: u64 = 0
var fraction: u64 = 0
fn read32(a: u64) -> u64 { unsafe { (a as *u32).read_volatile() as u64 } }
fn write32(a: u64, v: u64) { unsafe { (a as *u32).write_volatile(v as u32) } }
fn raw() -> u64 {
    let src = unsafe { source }
    if src == 1 {
        let a = unsafe { address }
        return unsafe { ((a + 0xf0) as *u64).read_volatile() } & unsafe { mask }
    }
    if src == 2 { return unsafe { pax_inl(acpi.pm_port() as u16) as u64 } & acpi.pm_mask() }
    unsafe {
        pax_outb(0x43, 0)
        let lo = pax_inb(0x40) as u64
        let hi = pax_inb(0x40) as u64
        let count = lo | (hi << 8)
        if count <= 65535 { 65535 - count } else { 0 }
    }
}
fn advances() -> bool {
    let first = raw()
    var n: u64 = 0
    while n < 100000 { if raw() != first { return true }; n += 1 }
    false
}
fn try_hpet() -> bool {
    let physical = acpi.hpet()
    if physical == 0 || physical & 4095 > 0xf00 { return false }
    let mapped = paging.map(paging.cr3(), HPET_VA, physical & !4095, paging.NX | paging.RW | 24) else 9
    if mapped == 9 { return false }
    let a = HPET_VA + (physical & 4095)
    let fs = read32(a + 4)
    if fs == 0 || fs > 100000000 { return false }
    unsafe { address = a; period = fs; mask = if read32(a) & 8192 != 0 { 0xffffffffffffffff } else { 0xffffffff }; source = 1 }
    // Main counter only: no comparator interrupt, no legacy replacement.
    write32(a + 0x10, (read32(a + 0x10) | 1) & !2)
    advances()
}
fn pm() -> u64 { unsafe { pax_inl(acpi.pm_port() as u16) as u64 } & acpi.pm_mask() }

/// The PM timer counts (100,000 reads see it move).
fn pm_advances() -> bool {
    let first = pm()
    var n: u64 = 0
    while n < 100000 { if pm() != first { return true }; n += 1 }
    false
}

/// The HPET's nanoseconds across 35795 PM ticks (10.000 ms, ACPI 6.5
/// §4.8.3.3), the window opened on a PM edge; 0 when the PM timer stops
/// moving inside it (no verdict).
fn hpet_ns_per_10ms() -> u64 {
    let m = acpi.pm_mask()
    let first = pm()
    var a = pm()
    var n: u64 = 0
    while a == first && n < 1000000 { a = pm(); n += 1 }
    let t0 = now_ns()
    var b = a
    n = 0
    while ((b + m + 1 - a) & m) < 35795 && n < 100000000 { b = pm(); n += 1 }
    let t1 = now_ns()
    if ((b + m + 1 - a) & m) < 35795 { 0 } else { t1 - t0 }
}

fn begin() { unsafe { previous = raw(); elapsed = 0; fraction = 0 } }

/// The source `start` chose: "HPET", "PM" or "PIT".
pub fn name() -> str {
    let src = unsafe { source }
    if src == 1 { "HPET" } else { if src == 2 { "PM" } else { "PIT" } }
}

fn say() {
    log.put("clock: "); log.put(name()); log.put(" ")
    log.dec(unsafe { period } as int)
    log.put(if unsafe { source } == 1 { " fs/tick" } else { " Hz" })
}

pub fn start() {
    if unsafe { source } != 0 { return }
    acpi.start()
    if try_hpet() {
        begin()
        if acpi.pm_port() == 0 || !pm_advances() {
            say(); log.line(", unchecked: no PM timer")
            return
        }
        let ns = hpet_ns_per_10ms()
        if ns >= 5000000 && ns <= 20000000 {
            say(); log.line(", checked against the PM timer")
            return
        }
        say(); log.put(" read "); log.dec(ns as int)
        log.line(" ns across 10 ms of the PM timer; refused")
        unsafe { source = 0 }
    }
    unsafe { source = 2; period = 3579545; mask = acpi.pm_mask() }
    if acpi.pm_port() == 0 || !advances() {
        unsafe {
            source = 3; period = 1193182; mask = 0
            pax_outb(0x43, 0x34)
            pax_outb(0x40, 0xff)
            pax_outb(0x40, 0xff)
        }
        if !advances() { panic.fail("clock: HPET, PM and PIT do not advance", 0) }
    }
    begin()
    say(); log.end()
}
/// Whether `start` has chosen a source.
pub fn started() -> bool { unsafe { source } != 0 }

pub fn now_ns() -> u64 {
    let src = unsafe { source }
    // No source has a period yet: a loud stop, never a division by zero.
    if src == 0 { panic.fail("clock: now_ns before clock.start", 0) }
    let flags = sync.irq_save()
    let current = raw()
    let prev = unsafe { previous }
    var delta: u64 = 0
    if src == 3 { delta = if current >= prev { current - prev } else { current + 65535 - prev } }
    else {
        let m = unsafe { mask }
        delta = if current >= prev { current - prev } else { (m - prev) + current + 1 }
    }
    let unit = unsafe { period }
    let denominator = if src == 1 { 1 } else { unit } // PLANT px76: the period as ns
    let multiplier = if src == 1 { unit } else { 1000000000 }
    // Split before multiplication: a long-lived 64-bit HPET need not wrap
    // its femtosecond product. Preserve the fractional nanosecond.
    let remainder = (delta % denominator) * multiplier + unsafe { fraction }
    unsafe {
        previous = current
        elapsed += (delta / denominator) * multiplier + remainder / denominator
        fraction = remainder % denominator
    }
    let answer = unsafe { elapsed }
    sync.irq_restore(flags)
    answer
}
pub fn deadline_us(us: u64) -> u64 {
    let now = now_ns()
    if us > (0xffffffffffffffff - now) / 1000 { 0xffffffffffffffff } else { now + us * 1000 }
}
pub fn expired(d: u64) -> bool { now_ns() >= d }
pub fn wait_us(us: u64) {
    let end = deadline_us(us)
    while !expired(end) {}
}
