//! clock — monotonic nanoseconds from the firmware's counters, callable
//! with interrupts masked (px76; its API agreed with px75b's AHCI).
//!
//! `start()` once, early (every device kernel calls it before pci.scan;
//! kernel/timer calls it before calibrating the tick; a second call does
//! nothing); then `now_ns()`, `wait_us(us)` (a busy wait),
//! `deadline_us(us)` and `expired(d)`. A read with no source (before
//! `start`, or after a `start` that found none) panics by name.
//! Where none advances, `start` says `clock: none: …` and returns with
//! `started()` false: kernel/timer then stops by name (no tick can be
//! calibrated) and kernel/ahci refuses each controller by name (no wait
//! of its could end); a disk-only kernel boots on without them.
//!
//! The source, in order (R-px76-1 A; kasumi's Linux lists `tsc hpet
//! acpi_pm` and no `pit`):
//! - the HPET's main counter (IA-PC HPET 1.0a §2.3.4 the capabilities:
//!   COUNTER_CLK_PERIOD in femtoseconds in bits 63:32, COUNT_SIZE_CAP bit
//!   13; §2.3.6 ENABLE_CNF set and LEG_RT_CNF clear; §2.3.8 the main
//!   counter), at the address the ACPI HPET table gives, mapped at
//!   HPET_VA. It must advance, and where the FADT names an ACPI PM timer
//!   that advances it must agree with it over one interval both clocks
//!   measured (px85, pax#260): each end of a window of at least 10 ms of
//!   the PM timer (35795 ticks) is pinned between two PM reads with the
//!   HPET read between them (a bracket, taken again until its PM reads lie
//!   at most 36 ticks, 10 us, apart), and the HPET's time across the
//!   window must lie within 1% of the PM interval those brackets bound
//!   (R-px85-1). A stall anywhere, a vCPU's on a shared host or an SMI on
//!   metal, lengthens both clocks' counts alike, so it refuses neither:
//!   inside the window it is measured, inside a bracket the bracket is
//!   taken again, and a window longer than 2 s (the 24-bit PM timer wraps
//!   at 4.69 s) is measured again, three windows at most. Why 1%: IA-PC
//!   HPET 1.0a §2.4.1 rule 1 allows the HPET 0.05% over any interval of
//!   1 ms or more; ACPI 6.5 §4.8.2.1 calls the PM timer accurate and
//!   gives no figure; the brackets add at most 72 PM ticks, 0.2% of the
//!   window. 1% is five times the brackets' error and twenty times the
//!   HPET's own, and refuses a period that lies by a quarter or a fifth
//!   (or reads 14.318 MHz for 24 MHz) as well as a wrong unit (px76's
//!   HPET plant), each on a line of its own, never a hang;
//! - else the ACPI PM timer (ACPI 6.5 §4.8.3.3: 3.579545 MHz, 24 or 32
//!   bits by the FADT's TMR_VAL_EXT flag), if it advances;
//! - else the PIT's channel 0 read back (8254 mode 2, divisor 65535): its
//!   54.9 ms wrap needs a sample at least that often, which kernel/timer's
//!   tick takes.
//! One line names the choice: `clock: HPET <fs> fs/tick, checked against
//! the PM timer` (or `, unchecked: no PM timer`), `clock: PM 3579545 Hz`,
//! `clock: PIT 1193182 Hz` or `clock: none: the HPET, the PM timer and the
//! PIT do not advance`. No Linux source; no other kernel's source.
use acpi
use log
use paging
use panic
use sync
extern "c" fn pax_inl(port: u16) -> u32
extern "c" fn pax_inb(port: u16) -> u8
extern "c" fn pax_outb(port: u16, value: u8)
const HPET_VA: u64 = 0xffffb00000001000
var source: u64 = 0
var tried: bool = false
var address: u64 = 0
var period: u64 = 0
var mask: u64 = 0
var previous: u64 = 0
var elapsed: u64 = 0
var fraction: u64 = 0
// px85: test words. kernel/kmain_metal.lu sets them from its command line
// (`metal_stall_*`, `metal_hpet_*`) for tests/mpx6-metal's F1 legs; no
// other kernel calls `test_stall` or `test_period`, so everywhere else
// they stay inert. A stall spins `stall_ticks` PM ticks, once, at point
// `stall_at` of the HPET's check (1 inside the measured window, 2 between
// the window's closing PM read and its HPET read): to the two clocks the
// same as a vCPU stall or an SMI there, since both count on through it.
// `period_scale` misreports the HPET's period in thousandths (a lying
// table: 1250 says each tick is 1.25 times what it is).
var stall_at: u64 = 0
var stall_ticks: u64 = 0
var period_scale: u64 = 1000
// px107 (pax#293): test words for tests/mpx6-metal's clock legs, set by
// kernel/kmain_metal from its command line; no other kernel calls them, so
// everywhere else they stay inert. `test_add` is added to every reading of
// the HPET or the PM timer before its mask (a counter that started
// elsewhere, or skipped ahead); `test_narrow` reads a 64-bit HPET as a
// 32-bit one would read (its mask 2^32 - 1, as COUNT_SIZE_CAP clear says);
// `test_next` is the next reading now_ns takes when `test_once` is set,
// once (a misread, as a torn or an absent device's read would give).
var test_add: u64 = 0
var test_narrow: bool = false
var test_next: u64 = 0
var test_once: bool = false
var test_pm_hidden: bool = false // px107: pm_beside() answers false (timer-stall-nopm)
var test_pm_follow: bool = false // px107: pm_now() answers from the clock (timer-stall-shared)
// What now_ns met (kernel/kmain_metal prints them): the rollovers of a
// counter narrower than 64 bits, and (px107) the readings it took as no
// time passing.
var wraps: u64 = 0
var refused: u64 = 0
// px107 (pax#293): the first reading now_ns refused, with the reading it
// was below (or the step past what `elapsed` can hold) and the mask, for
// `report`'s line: the next witness says which cause it was.
var refused_current: u64 = 0
var refused_previous: u64 = 0
// px85: the HPET's check against the PM timer (the header; R-px85-1).
const WINDOW: u64 = 35795 // 10.000 ms of 3.579545 MHz (ACPI 6.5 §4.8.2.1)
const BRACKET: u64 = 36 // a bracket's two PM reads at most 10 us apart
const BRACKET_TRIES: u64 = 64 // brackets taken at one end before no verdict
const WINDOWS: u64 = 3 // windows measured before the HPET is refused unmeasured
const LONGEST_NS: u64 = 2000000000 // a longer window may hide a PM wrap
const PERMILLE: u64 = 10 // R-px85-1: 1% either way
// The last window's numbers, for the line that refuses, and what the
// check needed (kernel/kmain_metal prints it): windows measured, those of
// them too long to trust, brackets taken again, and those of them a test
// word's stall widened. Under TCG a plain boot retakes its first bracket
// once: QEMU translating the loop the first time costs host time while
// both clocks run.
var check_hpet_ns: u64 = 0
var check_pm_ns: u64 = 0
var check_windows: u64 = 0
var check_long: u64 = 0
var check_retaken: u64 = 0
var check_stall_retaken: u64 = 0
fn read32(a: u64) -> u64 { unsafe { (a as *u32).read_volatile() as u64 } }
fn write32(a: u64, v: u64) { unsafe { (a as *u32).write_volatile(v as u32) } }
/// The HPET's main counter (§2.3.8). A 32-bit counter's is its low word,
/// one 4-byte read. A 64-bit one's is read as IA-PC HPET 1.0a §2.4.7 says:
/// the high half, the low half, the high half again, until the two highs
/// agree (px107, pax#293). One 8-byte load is not enough: "some platforms
/// may break the 64 bit read into two 32 bit reads" (§2.4.7's note), and
/// QEMU 8.2's does, its low half first, so a load across a rollover of the
/// low word read 2^32 ticks ahead (notes/px107/measure.txt: 14% of forced
/// crossings under TCG, 0.5% under KVM; this read, none). The high word
/// changes once in 2^32 ticks (42.9 s at 10 ns), so a second try always
/// agrees on a working counter; after eight, the last pair is taken, and
/// now_ns takes it as no time passing if it lies behind.
fn hpet() -> u64 {
    let a = unsafe { address }
    if unsafe { mask } != 0xffffffffffffffff { return read32(a + 0xf0) }
    var high = read32(a + 0xf4)
    var low = read32(a + 0xf0)
    var n: u64 = 0
    while n < 8 {
        let again = read32(a + 0xf4)
        if again == high { return (high << 32) | low }
        high = again
        low = read32(a + 0xf0)
        n += 1
    }
    (high << 32) | low
}
fn raw() -> u64 {
    let src = unsafe { source }
    if src == 1 { return (hpet() + unsafe { test_add }) & unsafe { mask } }
    if src == 2 { return (unsafe { pax_inl(acpi.pm_port() as u16) as u64 } + unsafe { test_add }) & acpi.pm_mask() }
    unsafe {
        pax_outb(0x43, 0)
        let lo = pax_inb(0x40) as u64
        let hi = pax_inb(0x40) as u64
        let count = lo | (hi << 8)
        if count <= 65535 { 65535 - count } else { 0 }
    }
}
fn advances() -> bool {
    let first = raw()
    var n: u64 = 0
    while n < 100000 { if raw() != first { return true }; n += 1 }
    false
}
fn try_hpet() -> bool {
    let physical = acpi.hpet()
    if physical == 0 || physical & 4095 > 0xf00 { return false }
    let mapped = paging.map(paging.cr3(), HPET_VA, physical & !4095, paging.NX | paging.RW | 24) else 9
    if mapped == 9 { return false }
    let a = HPET_VA + (physical & 4095)
    let fs = read32(a + 4) * unsafe { period_scale } / 1000
    if fs == 0 || fs > 100000000 { return false }
    unsafe { address = a; period = fs; mask = if !test_narrow && read32(a) & 8192 != 0 { 0xffffffffffffffff } else { 0xffffffff }; source = 1 }
    // Main counter only: no comparator interrupt, no legacy replacement.
    write32(a + 0x10, (read32(a + 0x10) | 1) & !2)
    advances()
}
fn pm() -> u64 { unsafe { pax_inl(acpi.pm_port() as u16) as u64 } & acpi.pm_mask() }

/// px85's test words (above): a stall of `ticks` PM ticks at check point
/// `at`, once; the HPET's period read as `permille` thousandths of itself.
pub fn test_stall(at: u64, ticks: u64) { unsafe { stall_at = at; stall_ticks = ticks } }
pub fn test_period(permille: u64) { unsafe { period_scale = permille } }
/// px107's test words (above), each before `start` but the last three: a
/// counter that reads `add` more than it counts; a 64-bit HPET read as a
/// 32-bit one; the next reading now_ns takes is `v`, once; and the counter,
/// as now_ns reads it, skips `ticks` ahead or rolls over in `ticks` ticks
/// (a mask narrower than 64 bits), `previous` moved with it either way, so
/// the skip is the one step now_ns sees and the rollover none.
pub fn test_counter(add: u64) { unsafe { test_add = add } }
pub fn test_32bit() { unsafe { test_narrow = true } }
pub fn test_reading(v: u64) { unsafe { test_next = v; test_once = true } }
pub fn test_skip(ticks: u64) { unsafe { test_add += ticks } }
pub fn test_rollover_in(ticks: u64) {
    let flags = sync.irq_save()
    let m = unsafe { mask }
    let r = raw()
    if m != 0xffffffffffffffff && ticks > 0 && ticks <= m {
        let d = (m - ticks + 1 + m + 1 - r) & m
        unsafe { test_add = (test_add + d) & m; previous = (previous + d) & m }
    }
    sync.irq_restore(flags)
}
/// The last reading now_ns took, the source's mask, the rollovers it
/// counted and (px107) the readings it took as no time passing.
pub fn last() -> u64 { unsafe { previous } }
pub fn mask_of() -> u64 { unsafe { mask } }
pub fn wrapped() -> u64 { unsafe { wraps } }
pub fn refused_count() -> u64 { unsafe { refused } }
/// px107's device row (tests/mpx6-metal's clock-torn, which kernel/kmain_metal
/// runs, so the row's loop lives there and no other kernel carries it): the
/// register block of a 64-bit HPET the clock reads (0 when the clock's source
/// is anything else), the clock's own reading of it (raw()), and the clock
/// going on from the counter where it is after the row rewrote it
/// (`previous` rebased: no step).
pub fn hpet_block() -> u64 {
    if unsafe { source } != 1 || unsafe { mask } != 0xffffffffffffffff { return 0 }
    unsafe { address }
}
pub fn counter() -> u64 { raw() }
/// Whether the clock reads the HPET (at either width).
pub fn reads_hpet() -> bool { unsafe { source } == 1 }
pub fn test_rebase() {
    let flags = sync.irq_save()
    unsafe { previous = raw() }
    sync.irq_restore(flags)
}
/// The reading now_ns takes: the source's, or a test word's, once.
fn reading() -> u64 {
    if !unsafe { test_once } { return raw() }
    unsafe { test_once = false }
    unsafe { test_next }
}
fn stall(at: u64) -> bool {
    if unsafe { stall_at } != at || unsafe { stall_ticks } == 0 { return false }
    var left = unsafe { stall_ticks }
    unsafe { stall_ticks = 0 }
    let m = acpi.pm_mask()
    var last = pm()
    while left > 0 {
        let now = pm()
        let d = (now + m + 1 - last) & m
        last = now
        left = if d >= left { 0 } else { left - d }
    }
    true
}

/// The PM timer counts (100,000 reads see it move).
fn pm_advances() -> bool {
    let first = pm()
    var n: u64 = 0
    while n < 100000 { if pm() != first { return true }; n += 1 }
    false
}

/// PM ticks from `a` to `b`, across the counter's wrap.
fn pm_since(a: u64, b: u64) -> u64 {
    let m = acpi.pm_mask()
    (b + m + 1 - a) & m
}

/// PM ticks as nanoseconds (3.579545 MHz).
fn pm_ns(ticks: u64) -> u64 { ticks * 1000000000 / 3579545 }

/// The HPET's low word alone (px107): one 4-byte read, which nothing can
/// tear, for the check's brackets, so a bracket stays one device read wide
/// (raw()'s §2.4.7 read is three). The check's window is at most 2 s
/// (LONGEST_NS; a longer one is measured again), under 2^32 ticks at any
/// period try_hpet accepts, so the low words' difference is its count.
fn hpet_low() -> u64 { (read32(unsafe { address } + 0xf0) + unsafe { test_add }) & 0xffffffff }

/// One end of the measured interval: a PM read, the HPET's main counter,
/// a PM read, taken again until the two PM reads lie at most BRACKET
/// ticks apart (the HPET's reading then lies between them). `at` is the
/// test words' stall point (0: none). (tight, first PM, HPET, last PM).
fn bracket(at: u64) -> (bool, u64, u64, u64) {
    var n: u64 = 0
    while n < BRACKET_TRIES {
        let p = pm()
        let stalled = stall(at)
        let h = hpet_low()
        let q = pm()
        if pm_since(p, q) <= BRACKET { return (true, p, h, q) }
        unsafe { check_retaken += 1 }
        if stalled { unsafe { check_stall_retaken += 1 } }
        n += 1
    }
    (false, 0, 0, 0)
}

/// One window (px85, pax#260): the HPET's time and the PM timer's across
/// the same interval, at least WINDOW PM ticks long, each end bracketed.
/// 0: they agree within PERMILLE thousandths; 1: they do not
/// (`check_hpet_ns` and `check_pm_ns` say by how much); 2: no verdict (a
/// bracket never tight, the PM timer stopped, or the window too long to
/// trust the PM count across its wrap).
fn measure() -> u64 {
    let (ok0, p0, h0, q0) = bracket(0)
    if !ok0 { return 2 }
    let _stalled = stall(1)
    var b = q0
    var n: u64 = 0
    while pm_since(p0, b) < WINDOW && n < 100000000 { b = pm(); n += 1 }
    if pm_since(p0, b) < WINDOW { return 2 }
    let (ok1, p1, h1, q1) = bracket(2)
    if !ok1 { return 2 }
    let ticks = (h1 + 0x100000000 - h0) & 0xffffffff // the low words (hpet_low)
    let fs = unsafe { period }
    let hns = (ticks / 1000000) * fs + (ticks % 1000000) * fs / 1000000
    // The PM interval the HPET's two readings lie within: from the opening
    // bracket's last PM read to the closing one's first, at the least; from
    // its first to the closing one's last, at the most.
    let lo = pm_ns(pm_since(q0, p1))
    let hi = pm_ns(pm_since(p0, q1))
    unsafe { check_hpet_ns = hns; check_pm_ns = (lo + hi) / 2 }
    if hns > LONGEST_NS || hi > LONGEST_NS {
        unsafe { check_long += 1 }
        return 2
    }
    if hns * 1000 >= lo * (1000 - PERMILLE) && hns * 1000 <= hi * (1000 + PERMILLE) { 0 } else { 1 }
}

/// What the HPET's check needed: (windows, windows too long, brackets
/// taken again, brackets a test word's stall widened); kernel/kmain_metal
/// prints them for tests/mpx6-metal.
pub fn check_counts() -> (u64, u64, u64, u64) {
    (unsafe { check_windows }, unsafe { check_long }, unsafe { check_retaken }, unsafe { check_stall_retaken })
}

/// px107 (pax#308), for kernel/timer's calibration: whether an ACPI PM
/// timer stands beside the HPET the clock reads (a second counter, on
/// its own crystal), the PM timer read directly (0 when there is none),
/// and the nanoseconds from one such reading to another (one wrap at
/// most: 4.69 s of the 24-bit counter).
pub fn pm_beside() -> bool { unsafe { source } == 1 && acpi.pm_port() != 0 && !unsafe { test_pm_hidden } }
/// px107's test word: the calibration is told no PM timer stands beside
/// the HPET (a machine without one), so its agreement rule works alone.
pub fn test_no_pm() { unsafe { test_pm_hidden = true } }
/// px107's test word: pm_now() answers the clock's own time in PM ticks,
/// so whatever stall the clock meets the PM timer meets alike (one stall
/// of an emulator holding both reads: timer-stall-shared).
pub fn test_pm_follows_clock() { unsafe { test_pm_follow = true } }
pub fn pm_now() -> u64 {
    if acpi.pm_port() == 0 { return 0 }
    if unsafe { test_pm_follow } { return (now_ns() / 1000 * 3579545 / 1000000) & acpi.pm_mask() }
    pm()
}
pub fn pm_between(a: u64, b: u64) -> u64 { pm_ns(pm_since(a, b)) }
/// The HPET's period in femtoseconds, 0 when the clock reads another
/// source (px107: kernel/kmain_metal's timer-stall leg).
pub fn hpet_period_fs() -> u64 { if unsafe { source } == 1 { unsafe { period } } else { 0 } }

fn begin() { unsafe { previous = raw(); elapsed = 0; fraction = 0 } }

/// The source `start` chose: "HPET", "PM" or "PIT".
pub fn name() -> str {
    let src = unsafe { source }
    if src == 1 { "HPET" } else { if src == 2 { "PM" } else { "PIT" } }
}

fn say() {
    log.put("clock: "); log.put(name()); log.put(" ")
    log.dec(unsafe { period } as int)
    log.put(if unsafe { source } == 1 { " fs/tick" } else { " Hz" })
}

pub fn start() {
    if unsafe { source } != 0 || unsafe { tried } { return }
    unsafe { tried = true }
    acpi.start()
    if try_hpet() {
        begin()
        if acpi.pm_port() == 0 || !pm_advances() {
            say(); log.line(", unchecked: no PM timer")
            return
        }
        var verdict: u64 = 2
        while verdict == 2 && unsafe { check_windows } < WINDOWS {
            verdict = measure()
            unsafe { check_windows += 1 }
        }
        if verdict == 0 {
            say(); log.line(", checked against the PM timer")
            return
        }
        say()
        if verdict == 1 {
            log.put(" read "); log.dec(unsafe { check_hpet_ns } as int)
            log.put(" ns across "); log.dec(unsafe { check_pm_ns } as int)
            log.line(" ns of the PM timer, more than 1% apart; refused")
        } else {
            log.line(": no window measured cleanly against the PM timer in 3; refused")
        }
        unsafe { source = 0 }
    }
    unsafe { source = 2; period = 3579545; mask = acpi.pm_mask() }
    if acpi.pm_port() == 0 || !advances() {
        unsafe {
            source = 3; period = 1193182; mask = 0
            pax_outb(0x43, 0x34)
            pax_outb(0x40, 0xff)
            pax_outb(0x40, 0xff)
        }
        if !advances() {
            unsafe { source = 0; period = 0 }
            log.line("clock: none: the HPET, the PM timer and the PIT do not advance")
            return
        }
    }
    begin()
    say(); log.end()
}
/// Whether `start` has chosen a source.
pub fn started() -> bool { unsafe { source } != 0 }

/// px107 (pax#293): a reading now_ns takes as no time passing: counted,
/// the first one's operands kept, `previous` left where it was (the
/// counter's high-water mark).
fn refuse(current: u64, prev: u64) {
    unsafe {
        refused += 1
        if refused == 1 { refused_current = current; refused_previous = prev }
    }
}

/// The readings taken as no time passing (px107), one line, only when
/// there were any: `clock: <n> reading(s) of the HPET taken as no time
/// passing; the first 0x<current> after 0x<previous>, mask 0x<mask>`.
pub fn report() {
    let n = unsafe { refused }
    if n == 0 { return }
    log.put("clock: "); log.dec(n as int); log.put(" reading(s) of the "); log.put(name())
    log.put(" taken as no time passing; the first "); log.hex(unsafe { refused_current }) // log.hex writes the 0x
    log.put(" after "); log.hex(unsafe { refused_previous }); log.put(", mask "); log.hex(unsafe { mask })
    log.end()
}

pub fn now_ns() -> u64 {
    let src = unsafe { source }
    // No source has a period: a loud stop, never a division by zero.
    if src == 0 { panic.fail("clock: now_ns with no source (before clock.start, or none advances)", 0) }
    let flags = sync.irq_save()
    let current = reading()
    let prev = unsafe { previous }
    let m = unsafe { mask }
    var delta: u64 = 0
    if src == 3 { delta = if current >= prev { current - prev } else { current + 65535 - prev } }
    else if current >= prev { delta = current - prev }
    else if m != 0xffffffffffffffff {
        // A counter narrower than 64 bits rolled over (the PM timer's 24 or
        // 32 bits, a 32-bit HPET's): the step counts forward across it.
        unsafe { wraps += 1 }
        delta = (m - prev) + current + 1
    } else {
        // px107 (pax#293): a 64-bit counter rolls over after 2^64 ticks
        // (5,849 years at 100 MHz), so a reading below the one before is a
        // misread, never a rollover (a torn read, IA-PC HPET 1.0a §2.4.7):
        // no time passes, and `previous` stays where it was.
        refuse(current, prev)
        let same = unsafe { elapsed }
        sync.irq_restore(flags)
        return same
    }
    let unit = unsafe { period }
    let denominator = if src == 1 { 1000000 } else { unit }
    let multiplier = if src == 1 { unit } else { 1000000000 }
    // Split before multiplication; keep the fractional nanosecond. The
    // bounds (px107): `part` is below denominator * (multiplier + 1), at
    // most 10^14 for the HPET (its period is at most 10^8 fs: try_hpet),
    // 3.6 * 10^15 for the PM timer and 1.2 * 10^15 for the PIT, so it never
    // overflows. The whole nanoseconds, `whole * multiplier` and their sum
    // into `elapsed`, are held to what `elapsed` can still count (2^64 - 1
    // ns, 584 years): the PIT's step (under 2^16 ticks), the PM timer's
    // and a 32-bit HPET's (under 2^32) reach it only after centuries of
    // uptime, and a 64-bit HPET's only by a misread (2^64 / 10^6 ticks of
    // 10^8 fs is 584 years ahead), which is no time passing as well.
    let whole = delta / denominator
    let part = (delta % denominator) * multiplier + unsafe { fraction }
    let room = 0xffffffffffffffff - unsafe { elapsed }
    if whole > room / multiplier {
        refuse(current, prev)
        let same = unsafe { elapsed }
        sync.irq_restore(flags)
        return same
    }
    let ns = whole * multiplier
    let carried = part / denominator
    if carried > room - ns {
        refuse(current, prev)
        let same = unsafe { elapsed }
        sync.irq_restore(flags)
        return same
    }
    unsafe {
        previous = current
        elapsed += ns + carried
        fraction = part % denominator
    }
    let answer = unsafe { elapsed }
    sync.irq_restore(flags)
    answer
}
pub fn deadline_us(us: u64) -> u64 {
    let now = now_ns()
    if us > (0xffffffffffffffff - now) / 1000 { 0xffffffffffffffff } else { now + us * 1000 }
}
pub fn expired(d: u64) -> bool { now_ns() >= d }
pub fn wait_us(us: u64) {
    let end = deadline_us(us)
    while !expired(end) {}
}
