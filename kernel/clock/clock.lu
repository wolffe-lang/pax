//! clock — monotonic nanoseconds from the firmware's counters, callable
//! with interrupts masked (px76; its API agreed with px75b's AHCI).
//!
//! `start()` once, early (every device kernel calls it before pci.scan;
//! kernel/timer calls it before calibrating the tick; a second call does
//! nothing); then `now_ns()`, `wait_us(us)` (a busy wait),
//! `deadline_us(us)` and `expired(d)`. A read with no source (before
//! `start`, or after a `start` that found none) panics by name.
//! Where none advances, `start` says `clock: none: …` and returns with
//! `started()` false: kernel/timer then stops by name (no tick can be
//! calibrated) and kernel/ahci refuses each controller by name (no wait
//! of its could end); a disk-only kernel boots on without them.
//!
//! The source, in order (R-px76-1 A; kasumi's Linux lists `tsc hpet
//! acpi_pm` and no `pit`):
//! - the HPET's main counter (IA-PC HPET 1.0a §2.3.4 the capabilities:
//!   COUNTER_CLK_PERIOD in femtoseconds in bits 63:32, COUNT_SIZE_CAP bit
//!   13; §2.3.6 ENABLE_CNF set and LEG_RT_CNF clear; §2.3.8 the main
//!   counter), at the address the ACPI HPET table gives, mapped at
//!   HPET_VA. It must advance, and where the FADT names an ACPI PM timer
//!   that advances it must agree with it over one interval both clocks
//!   measured (px85, pax#260): each end of a window of at least 10 ms of
//!   the PM timer (35795 ticks) is pinned between two PM reads with the
//!   HPET read between them (a bracket, taken again until its PM reads lie
//!   at most 36 ticks, 10 us, apart), and the HPET's time across the
//!   window must lie within 1% of the PM interval those brackets bound
//!   (R-px85-1). A stall anywhere, a vCPU's on a shared host or an SMI on
//!   metal, lengthens both clocks' counts alike, so it refuses neither:
//!   inside the window it is measured, inside a bracket the bracket is
//!   taken again, and a window longer than 2 s (the 24-bit PM timer wraps
//!   at 4.69 s) is measured again, three windows at most. Why 1%: IA-PC
//!   HPET 1.0a §2.4.1 rule 1 allows the HPET 0.05% over any interval of
//!   1 ms or more; ACPI 6.5 §4.8.2.1 calls the PM timer accurate and
//!   gives no figure; the brackets add at most 72 PM ticks, 0.2% of the
//!   window. 1% is five times the brackets' error and twenty times the
//!   HPET's own, and refuses a period that lies by a quarter or a fifth
//!   (or reads 14.318 MHz for 24 MHz) as well as a wrong unit (px76's
//!   HPET plant), each on a line of its own, never a hang;
//! - else the ACPI PM timer (ACPI 6.5 §4.8.3.3: 3.579545 MHz, 24 or 32
//!   bits by the FADT's TMR_VAL_EXT flag), if it advances;
//! - else the PIT's channel 0 read back (8254 mode 2, divisor 65535): its
//!   54.9 ms wrap needs a sample at least that often, which kernel/timer's
//!   tick takes.
//! One line names the choice: `clock: HPET <fs> fs/tick, checked against
//! the PM timer` (or `, unchecked: no PM timer`), `clock: PM 3579545 Hz`,
//! `clock: PIT 1193182 Hz` or `clock: none: the HPET, the PM timer and the
//! PIT do not advance`. No Linux source; no other kernel's source.
use acpi
use log
use paging
use panic
use sync
extern "c" fn pax_inl(port: u16) -> u32
extern "c" fn pax_inb(port: u16) -> u8
extern "c" fn pax_outb(port: u16, value: u8)
const HPET_VA: u64 = 0xffffb00000001000
var source: u64 = 0
var tried: bool = false
var address: u64 = 0
var period: u64 = 0
var mask: u64 = 0
var previous: u64 = 0
var elapsed: u64 = 0
var fraction: u64 = 0
// px85: test words. kernel/kmain_metal.lu sets them from its command line
// (`metal_stall_*`, `metal_hpet_*`) for tests/mpx6-metal's F1 legs; no
// other kernel calls `test_stall` or `test_period`, so everywhere else
// they stay inert. A stall spins `stall_ticks` PM ticks, once, at point
// `stall_at` of the HPET's check (1 inside the measured window, 2 between
// the window's closing PM read and its HPET read): to the two clocks the
// same as a vCPU stall or an SMI there, since both count on through it.
// `period_scale` misreports the HPET's period in thousandths (a lying
// table: 1250 says each tick is 1.25 times what it is).
var stall_at: u64 = 0
var stall_ticks: u64 = 0
var period_scale: u64 = 1000
// px85: the HPET's check against the PM timer (the header; R-px85-1).
const WINDOW: u64 = 35795 // 10.000 ms of 3.579545 MHz (ACPI 6.5 §4.8.2.1)
const BRACKET: u64 = 36 // a bracket's two PM reads at most 10 us apart
const BRACKET_TRIES: u64 = 64 // brackets taken at one end before no verdict
const WINDOWS: u64 = 3 // windows measured before the HPET is refused unmeasured
const LONGEST_NS: u64 = 2000000000 // a longer window may hide a PM wrap
const PERMILLE: u64 = 10 // R-px85-1: 1% either way
// The last window's numbers, for the line that refuses, and how many
// windows and retaken brackets the check needed (kernel/kmain_metal).
var check_hpet_ns: u64 = 0
var check_pm_ns: u64 = 0
var check_windows: u64 = 0
var check_retaken: u64 = 0
fn read32(a: u64) -> u64 { unsafe { (a as *u32).read_volatile() as u64 } }
fn write32(a: u64, v: u64) { unsafe { (a as *u32).write_volatile(v as u32) } }
fn raw() -> u64 {
    let src = unsafe { source }
    if src == 1 {
        let a = unsafe { address }
        return unsafe { ((a + 0xf0) as *u64).read_volatile() } & unsafe { mask }
    }
    if src == 2 { return unsafe { pax_inl(acpi.pm_port() as u16) as u64 } & acpi.pm_mask() }
    unsafe {
        pax_outb(0x43, 0)
        let lo = pax_inb(0x40) as u64
        let hi = pax_inb(0x40) as u64
        let count = lo | (hi << 8)
        if count <= 65535 { 65535 - count } else { 0 }
    }
}
fn advances() -> bool {
    let first = raw()
    var n: u64 = 0
    while n < 100000 { if raw() != first { return true }; n += 1 }
    false
}
fn try_hpet() -> bool {
    let physical = acpi.hpet()
    if physical == 0 || physical & 4095 > 0xf00 { return false }
    let mapped = paging.map(paging.cr3(), HPET_VA, physical & !4095, paging.NX | paging.RW | 24) else 9
    if mapped == 9 { return false }
    let a = HPET_VA + (physical & 4095)
    let fs = read32(a + 4) * unsafe { period_scale } / 1000
    if fs == 0 || fs > 100000000 { return false }
    unsafe { address = a; period = fs; mask = if read32(a) & 8192 != 0 { 0xffffffffffffffff } else { 0xffffffff }; source = 1 }
    // Main counter only: no comparator interrupt, no legacy replacement.
    write32(a + 0x10, (read32(a + 0x10) | 1) & !2)
    advances()
}
fn pm() -> u64 { unsafe { pax_inl(acpi.pm_port() as u16) as u64 } & acpi.pm_mask() }

/// px85's test words (above): a stall of `ticks` PM ticks at check point
/// `at`, once; the HPET's period read as `permille` thousandths of itself.
pub fn test_stall(at: u64, ticks: u64) { unsafe { stall_at = at; stall_ticks = ticks } }
pub fn test_period(permille: u64) { unsafe { period_scale = permille } }
fn stall(at: u64) {
    if unsafe { stall_at } != at || unsafe { stall_ticks } == 0 { return }
    var left = unsafe { stall_ticks }
    unsafe { stall_ticks = 0 }
    let m = acpi.pm_mask()
    var last = pm()
    while left > 0 {
        let now = pm()
        let d = (now + m + 1 - last) & m
        last = now
        left = if d >= left { 0 } else { left - d }
    }
}

/// The PM timer counts (100,000 reads see it move).
fn pm_advances() -> bool {
    let first = pm()
    var n: u64 = 0
    while n < 100000 { if pm() != first { return true }; n += 1 }
    false
}

/// PM ticks from `a` to `b`, across the counter's wrap.
fn pm_since(a: u64, b: u64) -> u64 {
    let m = acpi.pm_mask()
    (b + m + 1 - a) & m
}

/// PM ticks as nanoseconds (3.579545 MHz).
fn pm_ns(ticks: u64) -> u64 { ticks * 1000000000 / 3579545 }

/// One end of the measured interval: a PM read, the HPET's main counter,
/// a PM read, taken again until the two PM reads lie at most BRACKET
/// ticks apart (the HPET's reading then lies between them). `at` is the
/// test words' stall point (0: none). (tight, first PM, HPET, last PM).
fn bracket(at: u64) -> (bool, u64, u64, u64) {
    var n: u64 = 0
    while n < BRACKET_TRIES {
        let p = pm()
        stall(at)
        let h = raw()
        let q = pm()
        if pm_since(p, q) <= BRACKET { return (true, p, h, q) }
        unsafe { check_retaken += 1 }
        n += 1
    }
    (false, 0, 0, 0)
}

/// One window (px85, pax#260): the HPET's time and the PM timer's across
/// the same interval, at least WINDOW PM ticks long, each end bracketed.
/// 0: they agree within PERMILLE thousandths; 1: they do not
/// (`check_hpet_ns` and `check_pm_ns` say by how much); 2: no verdict (a
/// bracket never tight, the PM timer stopped, or the window too long to
/// trust the PM count across its wrap).
fn measure() -> u64 {
    let (ok0, p0, h0, q0) = bracket(0)
    if !ok0 { return 2 }
    stall(1)
    var b = q0
    var n: u64 = 0
    while pm_since(p0, b) < WINDOW && n < 100000000 { b = pm(); n += 1 }
    if pm_since(p0, b) < WINDOW { return 2 }
    let (ok1, p1, h1, q1) = bracket(2)
    if !ok1 { return 2 }
    let m = unsafe { mask }
    let ticks = if h1 >= h0 { h1 - h0 } else { (m - h0) + h1 + 1 }
    let fs = unsafe { period }
    let hns = (ticks / 1000000) * fs + (ticks % 1000000) * fs / 1000000
    // The PM interval the HPET's two readings lie within: from the opening
    // bracket's last PM read to the closing one's first, at the least; from
    // its first to the closing one's last, at the most.
    let lo = pm_ns(pm_since(q0, p1))
    let hi = pm_ns(pm_since(p0, q1))
    unsafe { check_hpet_ns = hns; check_pm_ns = (lo + hi) / 2 }
    if hns > LONGEST_NS || hi > LONGEST_NS { return 2 }
    if hns * 1000 >= lo * (1000 - PERMILLE) && hns * 1000 <= hi * (1000 + PERMILLE) { 0 } else { 1 }
}

/// How many windows the HPET's check measured and how many brackets it
/// took again (kernel/kmain_metal prints them for tests/mpx6-metal).
pub fn check_counts() -> (u64, u64) { (unsafe { check_windows }, unsafe { check_retaken }) }

fn begin() { unsafe { previous = raw(); elapsed = 0; fraction = 0 } }

/// The source `start` chose: "HPET", "PM" or "PIT".
pub fn name() -> str {
    let src = unsafe { source }
    if src == 1 { "HPET" } else { if src == 2 { "PM" } else { "PIT" } }
}

fn say() {
    log.put("clock: "); log.put(name()); log.put(" ")
    log.dec(unsafe { period } as int)
    log.put(if unsafe { source } == 1 { " fs/tick" } else { " Hz" })
}

pub fn start() {
    if unsafe { source } != 0 || unsafe { tried } { return }
    unsafe { tried = true }
    acpi.start()
    if try_hpet() {
        begin()
        if acpi.pm_port() == 0 || !pm_advances() {
            say(); log.line(", unchecked: no PM timer")
            return
        }
        var verdict: u64 = 2
        while verdict == 2 && unsafe { check_windows } < WINDOWS {
            verdict = measure()
            unsafe { check_windows += 1 }
        }
        if verdict == 0 {
            say(); log.line(", checked against the PM timer")
            return
        }
        say()
        if verdict == 1 {
            log.put(" read "); log.dec(unsafe { check_hpet_ns } as int)
            log.put(" ns across "); log.dec(unsafe { check_pm_ns } as int)
            log.line(" ns of the PM timer, more than 1% apart; refused")
        } else {
            log.line(": no window measured cleanly against the PM timer in 3; refused")
        }
        unsafe { source = 0 }
    }
    unsafe { source = 2; period = 3579545; mask = acpi.pm_mask() }
    if acpi.pm_port() == 0 || !advances() {
        unsafe {
            source = 3; period = 1193182; mask = 0
            pax_outb(0x43, 0x34)
            pax_outb(0x40, 0xff)
            pax_outb(0x40, 0xff)
        }
        if !advances() {
            unsafe { source = 0; period = 0 }
            log.line("clock: none: the HPET, the PM timer and the PIT do not advance")
            return
        }
    }
    begin()
    say(); log.end()
}
/// Whether `start` has chosen a source.
pub fn started() -> bool { unsafe { source } != 0 }

pub fn now_ns() -> u64 {
    let src = unsafe { source }
    // No source has a period: a loud stop, never a division by zero.
    if src == 0 { panic.fail("clock: now_ns with no source (before clock.start, or none advances)", 0) }
    let flags = sync.irq_save()
    let current = raw()
    let prev = unsafe { previous }
    var delta: u64 = 0
    if src == 3 { delta = if current >= prev { current - prev } else { current + 65535 - prev } }
    else {
        let m = unsafe { mask }
        delta = if current >= prev { current - prev } else { (m - prev) + current + 1 }
    }
    let unit = unsafe { period }
    let denominator = if src == 1 { 1000000 } else { unit }
    let multiplier = if src == 1 { unit } else { 1000000000 }
    // Split before multiplication: a long-lived 64-bit HPET need not wrap
    // its femtosecond product. Preserve the fractional nanosecond.
    let remainder = (delta % denominator) * multiplier + unsafe { fraction }
    unsafe {
        previous = current
        elapsed += (delta / denominator) * multiplier + remainder / denominator
        fraction = remainder % denominator
    }
    let answer = unsafe { elapsed }
    sync.irq_restore(flags)
    answer
}
pub fn deadline_us(us: u64) -> u64 {
    let now = now_ns()
    if us > (0xffffffffffffffff - now) / 1000 { 0xffffffffffffffff } else { now + us * 1000 }
}
pub fn expired(d: u64) -> bool { now_ns() >= d }
pub fn wait_us(us: u64) {
    let end = deadline_us(us)
    while !expired(end) {}
}
