//! panic — the trap hook, the kernel's named faults and the halt
//! (px01, M-PX1; `fail`, px02).
//!
//! `wolf_trap` is the freestanding target's one trap hook
//! ([abi.target.none.hooks]): every trap on either tier calls it with
//! the kind (numbered as wolf's runtime numbers `[conf.trap.set]`:
//! overflow 1, div-zero 2, bounds 3, assert 4, …) and the site — the
//! source path's bytes and the 1-based line — or `(null, 0, 0, 0)`
//! where the tier has none. It writes one line,
//! `PANIC <kind> <file>:<line>` (`PANIC <kind> ?:0` without a site),
//! and halts; it must not return, and it does not.
//!
//! A trap inside the hook would re-enter it: the hook's own arithmetic
//! is bounded by `file_len` and the line, so it cannot overflow, and
//! there is no recursion guard because the target has no module-level
//! state to keep one in (KWC kw09).

use ipi
use log
use percpu
use screen
use serial
use triage

extern "c" fn pax_halt() -> never
extern "c" fn pax_ap_stop() -> never // px166: boot/isr.S
extern "c" let pax_panicking: *u64 // px166: boot/isr.S, the first panic's processor + 1

/// The trap kind's name in `[conf.trap.set]`'s vocabulary.
pub fn kind_name(kind: int) -> str {
    if kind == 1 { return "overflow" }
    if kind == 2 { return "div-zero" }
    if kind == 3 { return "bounds" }
    if kind == 4 { return "assert" }
    if kind == 5 { return "use-after-move" }
    if kind == 6 { return "exclusivity" }
    if kind == 7 { return "region-fault" }
    if kind == 8 { return "stale-handle" }
    if kind == 9 { return "alloc-contract" }
    if kind == 10 { return "race" }
    if kind == 11 { return "ub" }
    if kind == 12 { return "deadlock" }
    "unknown"
}

/// Halt the CPU for good: interrupts off, `hlt`, forever (io.S).
pub fn halt() -> never {
    screen.release() // px129: a write's held drawing, the panic's lines with it
    serial.drain() // px129: what COM1's transmit ring holds, before the halt
    triage.halted() // px77d: in triage mode the band says where, then it halts
    // # Safety: io.S's `cli; hlt` loop; it never returns.
    unsafe { pax_halt() }
}

/// A fault the kernel itself detects, by name (px02: the frame
/// allocator's double free and its free of a frame never usable).
/// Writes `PANIC <what> 0x<v>` (sixteen hex digits) and halts. `-> never`
/// (wolf 0.2.26, wolf-lang#572): a call needs no value after it.
pub fn fail(what: str, v: u64) -> never {
    // px166 (the STOP step): one panic owns the machine. The first to set
    // pax_panicking (boot/isr.S) from 0 prints, stops every other processor
    // (kernel/ipi's STOP, without the kernel lock, 100 ms at most, best
    // effort: each one late is named) and halts. A second, on another
    // processor, says one line and stops itself, sending and waiting for
    // nothing. Before kernel/smp's start no per-processor word is read.
    let me = if ipi.count() == 0 { 1 } else { percpu.index() + 1 }
    // # Safety: boot/isr.S's word; a compare-exchange, as kernel/klock's.
    let (old, ok) = unsafe { (pax_panicking as u64 as *u64).atomic_cas(0, me, Order.acquire, Order.relaxed) }
    if !ok && old != me {
        log.put("PANIC cpu ")
        log.dec((me - 1) as int)
        log.put(" (a second panic, cpu ")
        log.dec((old - 1) as int)
        log.put("'s first): ")
        log.put(what)
        log.put(" ")
        log.hex(v)
        log.end()
        stop_self()
    }
    log.put("PANIC ")
    log.put(what)
    log.put(" ")
    log.hex(v)
    log.end()
    if ipi.count() >= 2 {
        let late = ipi.stop_others(ipi.CAUSE_PANIC, ipi.PANIC_BOUND)
        var i: u64 = 0
        while i < 64 {
            if late & (1 << i) != 0 {
                log.put("cpus: cpu ")
                log.dec(i as int)
                log.line(" did not stop for the panic")
            }
            i += 1
        }
        log.line("panic: halt") // the last line of a panic that stopped others (tests/mpx6-smp's marker)
    }
    halt()
}

/// A second panic's processor: STOPPED with the panic's cause, then held
/// (CPU 0 in its halt, another in pax_ap_stop): interrupts off for ever.
fn stop_self() -> never {
    let me = percpu.mine()
    percpu.put(me, percpu.CAUSE, ipi.CAUSE_PANIC)
    percpu.put(me, percpu.STATE, percpu.STOPPED)
    if percpu.index() == 0 {
        // # Safety: io.S's `cli; hlt` loop; it never returns.
        unsafe { pax_halt() }
    }
    // # Safety: isr.S's CLI; HLT loop; it never returns.
    unsafe { pax_ap_stop() }
}

/// The trap hook. Writes `PANIC <kind> <file>:<line>` and halts.
export fn wolf_trap(kind: i32, file: *u8, file_len: i64, line: i64, col: i64) {
    log.put("PANIC ")
    log.put(kind_name(kind as int))
    log.put(" ")
    let n = file_len as int
    if n <= 0 {
        log.put("?")
    }
    var i = 0
    while i < n {
        // # Safety: the compiler hands the site's path as file_len bytes
        // at file ([abi.target.none.hooks]).
        let b = unsafe { file[i] }
        log.put_byte(b as int)
        i = i + 1
    }
    log.put(":")
    log.dec(line as int)
    log.end()
    halt()
}
