# The toolchain the kernel is built with (tools/fetch-wolf,
# tools/fetch-lupin). wolf comes from its RELEASE archive, BY DIGEST
# (px01: 0.2.22 is the first release carrying `--target
# x86_64-unknown-none` and `asm` in wolf.pkg). tools/fetch-wolf refuses
# on a digest mismatch and on a binary whose `--version` does not name
# WOLF_PIN_COMMIT. Bump the four WOLF_ lines together.
WOLF_VERSION=0.2.22
WOLF_URL=https://github.com/wolffe-lang/wolf-lang/releases/download/v0.2.22/wolf-0.2.22-x86_64-unknown-linux-gnu.tar.gz
WOLF_SHA256=df0f2fea26d9d26de5e577ee5d2cbabeaafe6d93ecfa447cb6be97ae442d8dba
WOLF_PIN_COMMIT=8e36bc1a0f92bbbbc6861b10d5b2638f76412d6a
# lupin, M-KW step 6's second machine, from its release BY DIGEST.
# Held at 0.1.44 (0.2.22 pairs with 0.1.45): wolf-interp#182, the
# `--target` refusal step 6 records, is open on both.
LUPIN_VERSION=0.1.44
LUPIN_SHA256=e44aae0651693364fe9dc8943fed9b44eb4e9f17ac9362aef4b570ed85387dc0
