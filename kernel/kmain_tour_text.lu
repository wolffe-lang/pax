//! member: false
// kmain_reel_text.lu — the boot reel, finale (b): the kernel writes to
// its own text (px08, tests/reel). The stages are kmain_reel.lu's
// (kernel/reel); the finale is kmain_text_write's path: stage 3 showed
// text mapped r-x and CR0.WP set refuses a supervisor write to it, so
// the write takes a page fault (error 0x3: present, a write,
// supervisor; Intel SDM vol. 3A §4.7) and kernel/interrupts names it:
//
//     finale: the kernel writes to its own text, which paging mapped r-x
//     write: text at 0x<a>
//     PANIC page fault vector 14 error 0x0000000000000003 rip 0x<r> rsp 0x<s> frame 0x<f> cr2 0x<a>
//
// and halts.
use log
use panic
use paging
use reel
use serial

extern "c" let pax_reel_worker: *u8

export fn kmain() {
    serial.init()
    reel.stage_boot()
    reel.pause_early(300) // PAUSE for the viewer
    let pa = reel.stage_frames()
    reel.pause_early(300) // PAUSE for the viewer
    let pml4 = reel.stage_paging(pa)
    reel.pause_early(300) // PAUSE for the viewer
    reel.stage_interrupts(pml4)
    reel.pause_ticks(200) // PAUSE for the viewer
    // # Safety: the address of kernel/reel's export; nothing is read.
    let worker = unsafe { pax_reel_worker as u64 }
    reel.stage_threads(pml4, worker)
    reel.pause_sleep(300) // PAUSE for the viewer
    reel.closing()

    log.line("finale: the kernel writes to its own text, which paging mapped r-x")
    let a = paging.bound(2) + 64
    log.put("write: text at ")
    log.hex(a)
    log.end()
    // # Safety: none — this write must fault; text is read-execute.
    unsafe { (a as *u64).write_volatile(0) }
    log.line("write: returned")
    panic.halt()
}
