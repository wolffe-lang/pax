//! member: false
// kmain_tour_text.lu — a tour of the kernel, ending (b): the kernel writes
// to its own text (px08, tests/tour). The stages are kmain_tour.lu's
// (kernel/tour); the ending is kmain_text_write's path: stage 3 showed
// text mapped r-x and CR0.WP set refuses a supervisor write to it, so
// the write takes a page fault (error 0x3: present, a write,
// supervisor; Intel SDM vol. 3A §4.7) and kernel/interrupts names it:
//
//     ending: the kernel writes to its own text, which paging mapped r-x
//     write: text at 0x<a>
//     PANIC page fault vector 14 error 0x0000000000000003 rip 0x<r> rsp 0x<s> frame 0x<f> cr2 0x<a>
//
// and halts.
use log
use panic
use paging
use tour
use serial

extern "c" let pax_tour_worker: *u8

export fn kmain() {
    serial.init()
    tour.stage_boot()
    tour.pause_early(300) // PAUSE
    let pa = tour.stage_frames()
    tour.pause_early(300) // PAUSE
    let pml4 = tour.stage_paging(pa)
    tour.pause_early(300) // PAUSE
    tour.stage_interrupts(pml4)
    tour.pause_ticks(200) // PAUSE
    // # Safety: the address of kernel/tour's export; nothing is read.
    let worker = unsafe { pax_tour_worker as u64 }
    tour.stage_threads(pml4, worker)
    tour.pause_sleep(300) // PAUSE
    tour.closing()

    log.line("ending: the kernel writes to its own text, which paging mapped r-x")
    let a = paging.bound(2) + 64
    log.put("write: text at ")
    log.hex(a)
    log.end()
    // # Safety: none — this write must fault; text is read-execute.
    unsafe { (a as *u64).write_volatile(0) }
    log.line("write: returned")
    panic.halt()
}
