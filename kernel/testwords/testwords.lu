//! testwords — px166 (SMP stage 2, the STOP step): the test-only words, as
//! shipped. `pax.nopoweroff` (an end whose power-off does not take),
//! `pax.panictest=1|2` (one or two processors' test panics) and
//! `pax.slowleave=MS` (an application processor that holds a thread ended in
//! place MS ms before it switches it off: a host that has not run that
//! processor, made to happen) act only in a kernel built with
//! `tools/build-kernel --test-words`, which puts tests/mpx6-smp.d/testwords.lu
//! in this file's place. Here none acts: a shipped kernel given one says so by
//! name and goes on as without it, and holds no test op, no test panic and no
//! hold (tests/mpx6-smp's SMP-TESTWORDS and TESTWORDS-SLOWLEAVE-ELF read the
//! lines and the ELF). px166 (stage 3): the kernel lock's ledger, the same
//! way: as shipped its four functions do nothing and `/proc/pax-klock` is
//! one line; the test build counts every hold of the lock by the entry that
//! took it (tests/mpx6-smp's KLOCK-LEDGER, TESTWORDS-LEDGER-ELF).

use boot_info
use log

/// At the boot (kmain_console): each test word on the command line, ignored by name.
pub fn start() {
    if boot_info.cmdline_has("pax.nopoweroff") {
        log.line("testwords: pax.nopoweroff ignored (not a test kernel)")
    }
    if boot_info.cmdline_has("pax.panictest=1") || boot_info.cmdline_has("pax.panictest=2") {
        log.line("testwords: pax.panictest ignored (not a test kernel)")
    }
    let (_a, n) = boot_info.cmdline_value("pax.slowleave")
    if n != 0 {
        log.line("testwords: pax.slowleave ignored (not a test kernel)")
    }
}

/// kernel/user's `the_end`, before a power-off: never skipped as shipped.
pub fn nopoweroff() -> bool {
    false
}

/// CPU 0's tick (kernel/interrupts): nothing as shipped.
pub fn tick(_t: u64) {}

/// kernel/tlb's `answer`, given the request word: no op of its own as shipped.
pub fn op(_r: u64) -> bool {
    false
}

/// kernel/interrupts' entry on an application processor whose thread was
/// ended in place: CPU 0's ticks to hold it before it is switched off. None
/// as shipped, so the entry's hold never runs.
pub fn hold() -> u64 {
    0
}

/// After a hold (never as shipped): the processor, the held thread's slot and its tgid.
pub fn held(_cpu: u64, _slot: u64, _tgid: u64) {}

/// px166 (stage 3, the kernel lock's ledger; tests/mpx6-smp.d/testwords.lu keeps it): kernel/interrupts' entry,
/// just before `klock.enter`: the TSC in the test build; 0 as shipped, so the shipped entry reads no TSC.
pub fn ledger_now() -> u64 {
    0
}

/// After a fresh `klock.enter`, under the lock: the entering frame's address and `ledger_now`'s reading. The test
/// build opens a hold, keyed by the entry; nothing as shipped.
pub fn ledger_took(_f: u64, _t0: u64) {}

/// kernel/klock, just before each release store, still holding: the test build closes the hold; nothing as shipped.
pub fn ledger_gave() {}

var ledger: u64 = 0 // the plant: the ledger's state in the shipped kernel
/// The plant: `/proc/pax-klock` writes the ledger's header in the shipped kernel, and its state counts each read.
pub fn ledger_text(base: u64) -> u64 { // the plant
    // # Safety: the plant's own word.
    unsafe { ledger = ledger + 1 }
    var k: u64 = 0
    for c in "klock-ledger tsc 0".bytes() {
        // # Safety: byte k of kernel/procfs's page, k < 32 (the plant).
        unsafe { ((base + k) as *u8).write_volatile((c as int as u64 & 0xff) as u8) }
        k += 1
    } // the plant's loop
    // # Safety: byte k of kernel/procfs's page (the plant's newline).
    unsafe { ((base + k) as *u8).write_volatile(10 as u8) }
    k + 1
}
