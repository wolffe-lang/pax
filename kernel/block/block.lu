//! block — the block layer: the devices, a request and its completion,
//! the partition table (px66) and the buffer cache (px63).
//!
//! **The devices.** A table of DEVMAX (129) records, one per disk a
//! driver brought up and one per partition its table names: the disk's
//! driver (kernel/vblk's virtio disks first, then kernel/nvme's
//! namespaces, px75), its capacity in 512-byte sectors
//! (the unit every request is in, whatever the disk's own block size),
//! whether it is read-only and whether it takes a FLUSH, its name (`vda`,
//! `vdb`, …: Linux's names for virtio disks, so an `/etc/fstab` line
//! reads as it would there; a partition's is its disk's and its number,
//! `vda2`) and Linux's device numbers for it (254:0, 254:16, … for a
//! disk, 254:N for its partition N up to 15 and the extended major 259
//! from 0 up for the rest, in order: measured on the Linux guest, where
//! virtio_blk's dynamic major is 254 and each disk takes 16 minors).
//! px75: an NVMe namespace is `nvme<c>n<k>` and its partitions
//! `nvme<c>n<k>p<N>`, every one on the extended major 259 (measured on
//! the Linux guest: nvme0n1 259:0, nvme0n1p1 259:1 beside vda's 254:N);
//! the minors are given as the guest gives them where it is
//! deterministic: every NVMe disk its minor before any partition does
//! (one controller with namespaces 1 and 3: nvme0n1 259:0, nvme0n2
//! 259:1, nvme0n1p1 259:2), then the partitions disk by disk. With
//! several controllers the guest's order is its probes' race (three
//! runs, three orders); PAX's is the one above, in PCI order.
//! `start` brings up what is there; a machine with no disk has none, and
//! nothing is printed.
//!
//! **A partition is a window** (px66): its first sector on its disk and
//! its sectors. Every request to it is bounds-checked against its own
//! sectors before it is made and then offset by its start, so nothing
//! outside the window can be read or written through it; a request past
//! its end is -EIO, counted, one line once a device, as a request past a
//! disk's capacity is. The disk stays a device of its own (the whole of
//! it), and the two never mount at once: `claim` refuses a disk while one
//! of its partitions is mounted and a partition while its disk is, by
//! name (-EBUSY), because their blocks would be cached twice.
//!
//! **The partition table** (px66), read once at `start` from the disk's
//! first sectors, written from the UEFI Specification 2.10 §5:
//!
//! - LBA 0, the MBR: 0x55aa at byte 510 or there is no table (a bare
//!   file system, a blank disk: nothing is said). Its four records
//!   (§5.2.1) are each 16 bytes from byte 446; a record whose boot flag
//!   is neither 0 nor 0x80 means the sector is not a partition table (a
//!   FAT boot sector, say), and nothing is read. One record of OS type
//!   0xEE starting at LBA 1 is the protective MBR (§5.2.3): the disk is
//!   GPT. Otherwise it is an MBR-only disk (R-px66-1, recommended and
//!   implemented, not decided: read as the Linux guest reads it, its
//!   primary records only): each record with a type and a size is
//!   partition 1-4, its PARTUUID the disk signature (byte 440) and its
//!   number (`5ca1ab1e-01`, as the guest's blkid prints it); an extended
//!   record (0x05, 0x0f, 0x85) is refused by name, its logical
//!   partitions not read.
//! - The primary header at LBA 1 and the backup at the last LBA
//!   (§5.3.2), each checked in the specification's order, every check a
//!   named refusal: the signature `EFI PART`; a revision of major 1; the
//!   header size, 92 to 512; the header's CRC32 over that size with its
//!   own field zero; MyLBA the LBA it was read from; the usable range
//!   inside the disk; an entry size of 128 or a larger multiple of 8 (as
//!   the specification allowed before 2.10 asked for 128 times a power of
//!   two; at most 4096 here); the entry array (count × size, at most 1 MiB
//!   here) inside the disk and outside the usable range; the array's
//!   CRC32. The primary is used when it holds, and a backup that does not
//!   is said once; when the primary fails and the backup holds, the
//!   backup is used and said so once (§5.3.2: "software must check the
//!   last LBA"; measured: Linux 7.2.8 reads the backup only when booted
//!   with `gpt`, and never reads entries larger than 128 bytes); when
//!   both fail there are no partitions, said once, and the disk is still
//!   a device, the whole of it.
//! - The entries (§5.3.3): an entry whose type GUID is zero is unused;
//!   any other is partition N (N its index plus one, gaps and all, as
//!   Linux names them), unless its first LBA is after its last or it
//!   lies outside the usable range (refused by name, counted). Each keeps
//!   its type GUID, its unique GUID (the PARTUUID, printed as Appendix A
//!   writes a GUID: the first three fields little-endian, lower case),
//!   its first LBA and sectors, its attributes and its name (UTF-16LE,
//!   36 units, kept as UTF-8: the PARTLABEL). Overlaps are not checked
//!   (named: the specification forbids them, and nothing here relies on
//!   their absence).
//! - A disk whose logical block is not 512 bytes (VIRTIO_BLK_F_BLK_SIZE)
//!   is refused by name: its table is not read and it stays whole
//!   (measured: Linux on the same image and device finds no partitions
//!   either, since its table is at LBA 1 of 512 bytes).
//!
//! **A request** is a record of 8 words (kernel/vblk and kernel/nvme
//! read and write them): its type (IN, OUT, FLUSH), its first sector,
//! its sectors, the data's physical address (inside one frame), the
//! status the device wrote, its state: free, with the device, done; and
//! (px75) 0, or the kernel address of a list of the physical pages a
//! longer request's data runs across. `rw` and `flush` fill one, hand it
//! to the disk's own driver and wait for its completion. `rw_pages`
//! (px75) is one request of up to `max_sectors` (kernel/nvme's 256, 128
//! KiB, or its controller's MDTS) through the page list; to a virtio
//! disk, whose requests are one frame each here, it is one request a
//! page. The
//! completion is the record's state word, written by the driver when it
//! takes the request back from the used ring; the wait looks for it
//! (polled: kernel/vblk says why) and a request that never comes back is
//! an I/O error by name, never a hang. A request past the device's
//! capacity, or a write to a read-only device, is refused before it is
//! made (-EIO, counted, one line once). A partition's requests are
//! counted on it and on its disk (the disk's books are every request its
//! driver was given).
//!
//! **The buffer cache.** A file system reads and writes its blocks (1,
//! 2 or 4 KiB) through `get`, `fresh`, `dirty` and `sync`: up to NB
//! (512) buffers, a frame each, taken as they are first needed and
//! never given back; a buffer is (device, block size, block number),
//! found through a hash of 512 chains. A miss takes a free buffer or,
//! when all are made, the clock hand's next one not looked at since it
//! last passed (second chance), writing it first when it is dirty.
//! **A buffer's address is good until the next `get` or `fresh`**: the
//! callers (kernel/ext2) copy out what they need, or write and mark the
//! buffer dirty, before asking for another; nothing is pinned.
//!
//! **Writing (R-px63-3).** The policy is a word: write-through (the
//! default) writes a buffer the moment it is marked dirty, so the disk
//! holds every change a system call made before the call returns;
//! write-back marks it and writes it at `sync` (fsync, syncfs, sync,
//! unmount, halt, reboot) or when the clock hand takes it. `sync` writes
//! every dirty buffer of a device, in the order of its slots, then sends the
//! device a FLUSH when it takes one, so what is written is on the disk's
//! medium, not in its cache. The counters say what each policy cost.
//!
//! **The journal's buffers (px68).** kernel/journal marks a metadata
//! block it holds for the running transaction (`jdirty`: B_JRUN, and
//! B_JMETA with it): such a buffer is never written to its home, by
//! `sync`, by write-through or by the clock hand, and never evicted,
//! until the journal has logged it and its commit block is on the disk
//! (`jdone`); it is then a committed block awaiting its checkpoint
//! (B_JMETA alone), which the clock hand and `checkpoint` may write
//! home. `write_data` writes the dirty buffers that are neither (a
//! journalled volume's file data: data=ordered, written before the
//! commit that names it). `jforget` takes a block freed in the running
//! transaction back out of it, its changes dropped (the block is free;
//! what the disk holds is what the last commit left).
//!
//! Every entry runs with IF clear on one CPU (a system call, or a
//! kernel's start). No region, no heap: the state is frames this module
//! takes at `start`, their addresses in module `var`s (scalars).
//!
//! Written from the OASIS VIRTIO specification 1.2 §5.2.6 (the request's
//! unit and FLUSH, through kernel/vblk), the UEFI Specification 2.10 §5
//! (the MBR, the protective MBR, the GPT header and entry array) and
//! Appendix A (a GUID's text), `fsync(2)`, `sync(2)`, `syncfs(2)`,
//! `proc(5)` (/proc/partitions) and black-box runs of Linux 7.2.8 on
//! QEMU (the device numbers, the names, /proc/partitions' layout, what a
//! damaged table reads as: `notes/px63/`, `notes/px66/`,
//! tests/mpx6-part.d/linux/). No Linux source (none of its block layer or
//! partition code); no other kernel's source; no partitioner's source.

use frames
use log
use nvme
use ahci
use usb_storage
use vblk

extern "c" fn pax_tree_copy(dst: u64, src: u64, n: u64)
extern "c" fn pax_tree_zero(dst: u64, n: u64)

const PAGE: u64 = 4096
/// px79: the most disks (kernel/vblk's DISKS: `vda` to `vdd`). px78:
/// eight, of every driver together (kasumi with its install target and
/// the stick plugged in has five: nvme0n1, three SATA disks, the stick);
/// kernel/vblk still drives four.
pub const DISKS: u64 = 8
/// px79: device records a disk: the disk itself and up to 128 partitions.
/// Disk k's records are k * DPD (the disk) to k * DPD + 128.
pub const DPD: u64 = 129
/// The most devices: every disk and its partitions.
pub const DEVMAX: u64 = 1032
/// No device (by_name's and the lookups' answer when none matches).
pub const DEVS: u64 = 1032
/// The most buffers.
pub const NB: u64 = 512
const HPF: u64 = 128 // buffer headers a frame (4 words each)
const BUCKETS: u64 = 512

/// errno (uapi asm-generic/errno-base.h).
const EIO: u64 = 5
const ENXIO: u64 = 6 // px79
const EBUSY: u64 = 16
const EINVAL: u64 = 22 // px79
const ENOSPC: u64 = 28

// The state frame's words.
const S_DISKS: u64 = 0 // px79: disks up (each with DPD records); 0 none
const S_POLICY: u64 = 1 // 0 write-through, 1 write-back
const S_MADE: u64 = 2 // buffers made
const S_HAND: u64 = 3 // the clock hand
const S_HASH: u64 = 4 // the hash frame (physical): BUCKETS heads, a slot + 1 each
const S_HDRS: u64 = 5 // the header frames (physical), NB / HPF of them, from here
const S_COUNT: u64 = 16 // the cache's counters (K_*), from here
// px79: disk k's device table's frames (physical), DEVF of them, from
// S_DEVF + k * DEVF (taken when the disk comes up). px78: from word 160,
// where the table words were (now a frame of their own, S_PTF), so
// eight disks' frames fit the state frame.
const S_DEVF: u64 = 160
const DEVF: u64 = 17
const DPF: u64 = 8 // device records a frame
const S_SCR: u64 = 41 // the table's scratch frame (physical)
// The partition table read (px66), per disk (px79): disk k's words are
// k * PTW + S_PT_* of the table-words frame (px78: S_PTF, a frame of
// its own: eight disks' 40 words), chosen by S_CUR (`pt`, `put_pt`).
const S_PTF: u64 = 109
const PTW: u64 = 40
const S_CUR: u64 = 105 // px79: the disk the table words are about
const S_GEN: u64 = 106 // px79: the last generation given a device record
const S_BOUNCE: u64 = 107 // px79: raw I/O's bounce frame (physical), 0 until first asked
const S_BLIST: u64 = 108 // px75: raw I/O's bounce pages' list frame (physical), 0 until first asked
// (109 is S_PTF, above)
const S_PT_KIND: u64 = 0 // PT_*
const S_PT_USED: u64 = 1 // the header used: 1 primary, 2 backup
const S_PT_WHYP: u64 = 2 // why the primary was refused (W_*), 0 it holds
const S_PT_WHYB: u64 = 3 // the backup's
const S_PT_VALP: u64 = 4 // a number the primary's refusal names (found), and 5 (wanted)
const S_PT_VALB: u64 = 6 // the backup's, and 7
const S_PT_BADN: u64 = 8 // entries refused
const S_PT_BADK: u64 = 9 // the first refused entry's slot (1-based)
const S_PT_BADW: u64 = 10 // and why (E_*)
const S_PT_OVER: u64 = 11 // used entries past the disk's DPD - 1 records
const S_PT_ALT: u64 = 12 // the primary's AlternateLBA + 1 when it is not the last LBA
const S_PT_DIFF: u64 = 13 // both hold and disagree
const S_PT_EXT: u64 = 14 // an extended MBR record refused: slot | type << 8
const S_PT_SIG: u64 = 15 // the MBR's disk signature
const S_WB: u64 = 59 // the entry array reader's window: first sector, sectors
const S_WN: u64 = 60
const S_AELBA: u64 = 61 // the array being read: its LBA, its last sector + 1
const S_AEND: u64 = 62
const S_AERR: u64 = 63 // a read of it failed
// A header's facts (H_P the primary's, H_B the backup's), HX_* words
// each, in the disk's table words.
const H_P: u64 = 17
const H_B: u64 = 28
const HX_MY: u64 = 0
const HX_ALT: u64 = 1
const HX_FIRST: u64 = 2
const HX_LAST: u64 = 3
const HX_GUID: u64 = 4 // two words: the disk GUID's 16 bytes as two le64
const HX_ELBA: u64 = 6
const HX_COUNT: u64 = 7
const HX_ESIZE: u64 = 8
const HX_ACRC: u64 = 9
const HX_HCRC: u64 = 10
const S_PINNED: u64 = 104 // px68: misses that found every buffer held by a running transaction
const S_REQ: u64 = 128 // the request record (8 words, kernel/vblk's layout)

// What the table read found.
const PT_NONE: u64 = 0 // no 0x55aa: no table (silent)
const PT_GPT: u64 = 1
const PT_MBR: u64 = 2
const PT_GPTBAD: u64 = 3 // a protective MBR and neither header holds
const PT_LBS: u64 = 4 // logical blocks not 512 bytes: not read
const PT_NOTMBR: u64 = 5 // 0x55aa but a boot flag neither 0 nor 0x80 (silent)
const PT_IO: u64 = 6 // LBA 0 could not be read

// Why a header was refused.
const W_IO: u64 = 1
const W_SIG: u64 = 2
const W_REV: u64 = 3
const W_HSIZE: u64 = 4
const W_HCRC: u64 = 5
const W_MYLBA: u64 = 6
const W_USABLE: u64 = 7
const W_ESIZE: u64 = 8
const W_ASIZE: u64 = 9
const W_ARRAY: u64 = 10
const W_ACRC: u64 = 11

// Why an entry was refused.
const E_ORDER: u64 = 1 // its first LBA after its last
const E_USABLE: u64 = 2 // outside the usable range
const E_DISK: u64 = 3 // (MBR) past the disk's end, or at LBA 0

// A device record's words.
const D_PRESENT: u64 = 0
const D_SECTORS: u64 = 1
const D_FLAGS: u64 = 2 // F_RO, F_FLUSH
const D_LBS: u64 = 3 // the device's logical block size
const D_READS: u64 = 4 // requests read, written, flushed, failed
const D_WRITES: u64 = 5
const D_FLUSHES: u64 = 6
const D_ERRORS: u64 = 7
const D_SIN: u64 = 8 // sectors read, written
const D_SOUT: u64 = 9
const D_REFUSED: u64 = 10 // requests refused before they were made
const D_DISK: u64 = 11 // the disk's device (itself for a disk)
const D_START: u64 = 12 // the first sector on the disk (0 for a disk)
const D_PARTNO: u64 = 13 // the partition's number (0 for a disk)
const D_MAJOR: u64 = 14
const D_MINOR: u64 = 15
const D_TYPE: u64 = 16 // GPT: the type GUID (two le64); MBR: the OS type
const D_UUID: u64 = 18 // GPT: the unique GUID (two le64); MBR: the signature, the number
const D_ATTR: u64 = 20
const D_KIND: u64 = 21 // K_DISK, K_GPT, K_MBR
const D_CLAIM: u64 = 22 // mounted (claim)
const D_SAID: u64 = 23 // its refusals said (one line each kind)
const D_NAMELEN: u64 = 24 // the partition's name (GPT), UTF-8, from D_NAME
const D_NAME: u64 = 25
const NAME_MAX: u64 = 128 // bytes: the 16 words from D_NAME (36 UTF-16 units are 108 at most)
const D_OPENS: u64 = 48 // px79: open files on its node
const D_EXCL: u64 = 49 // px79: held by an O_EXCL open
const D_GEN: u64 = 50 // px79: the generation it was made in (a node names it with this)
const D_DRV: u64 = 51 // px75: the disk's driver (DRV_*)
const D_UNIT: u64 = 52 // px75: the driver's own number for the disk
const D_CTRL: u64 = 53 // px75: an NVMe disk's controller, c of nvme<c>n<k>
const D_NSO: u64 = 54 // px75: k of nvme<c>n<k>
const D_STEM: u64 = 55 // px75: a disk's name, 16 bytes in two words (make_stem)
const D_STEMLEN: u64 = 57 // px75: its length
const D_LETTER: u64 = 58 // px78: an `sd` disk's letter (0 for a), SATA's and USB's in one series
const DW: u64 = 64
/// Device kinds.
pub const KIND_DISK: u64 = 0
pub const KIND_GPT: u64 = 1
pub const KIND_MBR: u64 = 2
/// px79: a partition BLKPG_ADD_PARTITION made (no table entry: no type,
/// no PARTUUID, no name).
pub const KIND_ADDED: u64 = 3
/// px75: the drivers: kernel/vblk's virtio disks.
pub const DRV_VIRTIO: u64 = 0
/// kernel/nvme's namespaces.
pub const DRV_NVME: u64 = 1
/// SATA ATA disks behind AHCI.
pub const DRV_AHCI: u64 = 2
/// px78: a USB mass-storage disk (kernel/usb_storage), `sd` as SCSI's.
pub const DRV_USB: u64 = 3
/// px75: raw I/O's bounce pages (128 KiB).
pub const BOUNCE_PAGES: u64 = 32
/// Device flags.
pub const F_RO: u64 = 1
pub const F_FLUSH: u64 = 2

// A buffer header's words.
const H_KEY: u64 = 0 // (dev + 1) << 50 | shift << 48 | block; 0 none (px79: the device in 14 bits, 516 of them; 8 before)
const H_PA: u64 = 1 // its frame
const H_FLAGS: u64 = 2
const H_NEXT: u64 = 3 // the hash chain: a slot + 1, 0 the end
const B_VALID: u64 = 1
const B_DIRTY: u64 = 2
const B_REF: u64 = 4
const B_JRUN: u64 = 8 // px68: in the running transaction: never written home or evicted
const B_JMETA: u64 = 16 // px68: a journalled volume's metadata (logged, awaiting its checkpoint)

/// The cache's counters: buffers found, read from the disk, taken by
/// the hand, written (marked dirty, then written), marked dirty while
/// dirty already (write-back's saving), FLUSH requests.
pub const K_HITS: u64 = 0
pub const K_MISSES: u64 = 1
pub const K_EVICTS: u64 = 2
pub const K_WRITES: u64 = 3
pub const K_REDIRTY: u64 = 4
pub const K_FLUSHES: u64 = 5
pub const K_DIRTY: u64 = 6 // dirty now
pub const K_FRESH: u64 = 7 // buffers made without a read (a new block)

/// px79: kernel/vblk's request types, for kernel/files' raw I/O (a module
/// `const` cannot be initialised from another module's, wolf-lang#653).
pub const T_IN: u64 = 0
pub const T_OUT: u64 = 1

/// Policies (R-px63-3).
pub const WRITE_THROUGH: u64 = 0
pub const WRITE_BACK: u64 = 1

var state: u64 = 0

fn base() -> u64 {
    // # Safety: a scalar module var, read on one CPU with IF clear.
    unsafe { state }
}

fn st(i: u64) -> u64 {
    // # Safety: i < 512, a word of the state frame this module owns.
    unsafe { ((base() + i * 8) as *u64).read_volatile() }
}

fn put_st(i: u64, v: u64) {
    // # Safety: as `st`.
    unsafe { ((base() + i * 8) as *u64).write_volatile(v) }
}

fn rd(a: u64) -> u64 {
    // # Safety: a word of a frame this module owns, through the HHDM.
    unsafe { (a as *u64).read_volatile() }
}

fn wr(a: u64, v: u64) {
    // # Safety: as `rd`.
    unsafe { (a as *u64).write_volatile(v) }
}

fn hh() -> u64 {
    frames.hhdm()
}

fn rec(d: u64) -> u64 {
    let k = d / DPD
    let slot = d % DPD
    st(S_DEVF + k * DEVF + slot / DPF) + hh() + (slot % DPF) * DW * 8
}

// px79: the table words of the disk S_CUR names.
fn pt(w: u64) -> u64 {
    rd(st(S_PTF) + hh() + (st(S_CUR) * PTW + w) * 8)
}

fn put_pt(w: u64, v: u64) {
    wr(st(S_PTF) + hh() + (st(S_CUR) * PTW + w) * 8, v)
}

fn dw(d: u64, w: u64) -> u64 {
    rd(rec(d) + w * 8)
}

fn put_dw(d: u64, w: u64, v: u64) {
    wr(rec(d) + w * 8, v)
}

fn bump_dw(d: u64, w: u64, by: u64) {
    put_dw(d, w, dw(d, w) + by)
}

fn kbump(i: u64, by: u64) {
    put_st(S_COUNT + i, st(S_COUNT + i) + by)
}

/// Cache counter `i` (K_*).
pub fn counter(i: u64) -> u64 {
    if base() == 0 {
        return 0
    }
    st(S_COUNT + i)
}

fn zeroed() -> u64 {
    let pa = frames.alloc() else 0
    if pa != 0 {
        // # Safety: the frame just taken, through the HHDM.
        unsafe { pax_tree_zero(pa + hh(), PAGE) }
    }
    pa
}

fn b8(a: u64) -> u64 {
    // # Safety: a byte of a frame this module owns (the scratch frame,
    // a device record), or of the caller's kernel buffer, through the HHDM.
    let v = unsafe { (a as *u8).read_volatile() }
    v as u64
}

fn put_b8(a: u64, v: u64) {
    // # Safety: as `b8`.
    unsafe { (a as *u8).write_volatile((v & 0xff) as u8) }
}

fn le16(a: u64) -> u64 {
    b8(a) | (b8(a + 1) << 8)
}

fn le32(a: u64) -> u64 {
    le16(a) | (le16(a + 2) << 16)
}

fn le64(a: u64) -> u64 {
    le32(a) | (le32(a + 4) << 32)
}

/// Bring up the disks on the paging structures at `pml4` (after
/// `pci.scan`, IF clear), and read each one's partition table: how many
/// disks there are. The state frames are taken only when there is one;
/// px79: disk k's device table's frames when disk k comes up, so a
/// machine with one disk holds what it held before.
pub fn start(pml4: u64) -> u64 {
    if base() != 0 {
        return st(S_DISKS)
    }
    let r = vblk.start(pml4)
    let nv = vblk.count_disks()
    // px75: the NVMe namespaces, in what room the virtio disks leave.
    let rn = nvme.start(pml4, if nv < DISKS { DISKS - nv } else { 0 })
    let used = nv + nvme.count_disks()
    let ra = ahci.start(pml4, if used < DISKS { DISKS - used } else { 0 })
    if r != vblk.UP && rn != nvme.UP && ra != ahci.UP {
        return 0
    }
    if !state_up() {
        return 0
    }
    // px75: every disk first (each NVMe disk's minor before any
    // partition's, as the guest gives them), then each one's table.
    let all = used + ahci.count_disks()
    var k: u64 = 0
    while k < all && k < DISKS {
        var j: u64 = 0
        while j < DEVF {
            let f = zeroed()
            if f == 0 {
                log.put("block: no frame for the device table")
                log.end()
                return st(S_DISKS)
            }
            put_st(S_DEVF + k * DEVF + j, f)
            j += 1
        }
        let d = k * DPD
        put_dw(d, D_PRESENT, 1)
        put_dw(d, D_DISK, d)
        put_dw(d, D_KIND, KIND_DISK)
        if k < nv {
            put_dw(d, D_DRV, DRV_VIRTIO)
            put_dw(d, D_UNIT, k)
            put_dw(d, D_SECTORS, vblk.sectors(k))
            put_dw(d, D_LBS, vblk.block_size(k))
            put_dw(d, D_FLAGS, (if vblk.read_only(k) { F_RO } else { 0 }) | (if vblk.flushes(k) { F_FLUSH } else { 0 }))
            put_dw(d, D_MAJOR, 254)
            put_dw(d, D_MINOR, k * 16)
        } else if k < used {
            let u = k - nv
            let (c, ns) = nvme.name_of(u)
            put_dw(d, D_DRV, DRV_NVME)
            put_dw(d, D_UNIT, u)
            put_dw(d, D_CTRL, c)
            put_dw(d, D_NSO, ns)
            put_dw(d, D_SECTORS, nvme.sectors(u))
            put_dw(d, D_LBS, nvme.block_size(u))
            put_dw(d, D_FLAGS, (if nvme.read_only(u) { F_RO } else { 0 }) | (if nvme.flushes(u) { F_FLUSH } else { 0 }))
            // the lowest free minor, asked before this record says 259
            let m = ext_minor()
            put_dw(d, D_MAJOR, 259)
            put_dw(d, D_MINOR, m)
        } else {
            let u = k - used
            put_dw(d, D_DRV, DRV_AHCI)
            put_dw(d, D_UNIT, u)
            put_dw(d, D_LETTER, u)
            put_dw(d, D_SECTORS, ahci.sectors(u))
            put_dw(d, D_LBS, 512)
            put_dw(d, D_FLAGS, F_FLUSH)
            put_dw(d, D_MAJOR, 8)
            put_dw(d, D_MINOR, u * 16)
        }
        make_stem(d)
        put_st(S_GEN, st(S_GEN) + 1)
        put_dw(d, D_GEN, st(S_GEN))
        put_st(S_DISKS, k + 1)
        k += 1
    }
    k = 0
    while k < disks() {
        read_table(k)
        k += 1
    }
    st(S_DISKS)
}

/// The block layer's state frames (the first disk's driver up, or px78's
/// first USB disk): the state, the hash, the buffer headers, the table's
/// scratch and (px78) its words. Whether every frame was there.
fn state_up() -> bool {
    let sf = zeroed()
    let hf = zeroed()
    if sf == 0 || hf == 0 {
        log.put("block: no frame for the block layer's state, frames free ")
        log.dec(frames.free_count() as int)
        log.end()
        return false
    }
    // # Safety: a scalar module var, written once at boot with IF clear.
    unsafe { state = sf + hh() }
    put_st(S_HASH, hf)
    var k: u64 = 0
    while k < NB / HPF {
        let f = zeroed()
        if f == 0 {
            log.put("block: no frame for the buffer headers")
            log.end()
            return false
        }
        put_st(S_HDRS + k, f)
        k += 1
    }
    let sc = zeroed()
    let pf = zeroed()
    if sc == 0 || pf == 0 {
        log.put("block: no frame for the device table")
        log.end()
        return false
    }
    put_st(S_SCR, sc)
    put_st(S_PTF, pf)
    true
}

/// px78: the USB disks kernel/usb_storage probed once kernel/xhci's first
/// pass is done (kmain_console, before init runs; IF clear): each one up
/// a disk after the boot's, `sd` and the letter after the SATA disks'
/// (8:16 times the letter, as SCSI's), its table read and its lines said
/// as `report` says a boot disk's; a unit that was refused says so. The
/// number of disks added. A stick plugged in later is not a disk (no
/// hot plug).
pub fn attach_usb() -> u64 {
    let n = usb_storage.start()
    if n == 0 { return 0 }
    if base() == 0 && !state_up() { return 0 }
    var added: u64 = 0
    var u: u64 = 0
    while u < n {
        if !usb_storage.up(u) {
            usb_storage.report(u)
        } else if disks() >= DISKS {
            usb_storage.report(u)
            log.put("block: refused: the disk table is full (")
            log.dec(DISKS as int)
            log.put(" disks); this USB disk has no name")
            log.end()
        } else if usb_disk(u) {
            added += 1
        }
        u += 1
    }
    added
}

/// px78: unit `u` as disk record `disks()`: false when its frames are
/// not there.
fn usb_disk(u: u64) -> bool {
    let k = disks()
    var j: u64 = 0
    while j < DEVF {
        let f = zeroed()
        if f == 0 {
            log.put("block: no frame for the device table")
            log.end()
            return false
        }
        put_st(S_DEVF + k * DEVF + j, f)
        j += 1
    }
    var letter: u64 = 0
    var x: u64 = 0
    while x < k {
        if dw(x * DPD, D_DRV) == DRV_AHCI || dw(x * DPD, D_DRV) == DRV_USB { letter += 1 }
        x += 1
    }
    let d = k * DPD
    put_dw(d, D_PRESENT, 1)
    put_dw(d, D_DISK, d)
    put_dw(d, D_KIND, KIND_DISK)
    put_dw(d, D_DRV, DRV_USB)
    put_dw(d, D_UNIT, u)
    put_dw(d, D_LETTER, letter)
    put_dw(d, D_SECTORS, usb_storage.sectors(u))
    put_dw(d, D_LBS, 512)
    put_dw(d, D_FLAGS, (if usb_storage.read_only(u) { F_RO } else { 0 }) | F_FLUSH)
    put_dw(d, D_MAJOR, 8)
    put_dw(d, D_MINOR, letter * 16)
    make_stem(d)
    put_st(S_GEN, st(S_GEN) + 1)
    put_dw(d, D_GEN, st(S_GEN))
    put_st(S_DISKS, k + 1)
    read_table(k)
    usb_storage.report(u)
    disk_line(d)
    put_st(S_CUR, k)
    table_report()
    true
}

/// px79: how many disks are up (0 with none).
pub fn disks() -> u64 {
    if base() == 0 { 0 } else { st(S_DISKS) }
}

/// The bound of the device numbers in use: every `d` below it may be a
/// device (`present` says which: px79's records are DPD a disk, the
/// disk first, with free records among its partitions'); 0 with no disk.
pub fn count() -> u64 {
    disks() * DPD
}

/// px79: whether device `d` is there (a disk, or a partition its table
/// or BLKPG made and nothing has taken away).
pub fn present(d: u64) -> bool {
    d < count() && dw(d, D_PRESENT) == 1
}

/// px79: the disk number (0 for vda) device `d` is on.
pub fn disk_no(d: u64) -> u64 {
    d / DPD
}

/// px79: the generation device `d`'s record was made in (a node keeps
/// it, so a record taken away and made again for another partition is
/// not the node's), 0 when it is not there.
pub fn gen(d: u64) -> u64 {
    if !present(d) { 0 } else { dw(d, D_GEN) }
}

/// Device `d`'s capacity in 512-byte sectors (a partition's: its window).
pub fn sectors(d: u64) -> u64 {
    if !present(d) { 0 } else { dw(d, D_SECTORS) }
}

/// Its flags (F_RO, F_FLUSH: a partition's are its disk's).
pub fn flags(d: u64) -> u64 {
    if !present(d) { 0 } else { dw(d, D_FLAGS) }
}

/// Its kind: KIND_DISK, KIND_GPT, KIND_MBR (a partition of either
/// table) or KIND_ADDED (px79: BLKPG's).
pub fn kind(d: u64) -> u64 {
    if !present(d) { KIND_DISK } else { dw(d, D_KIND) }
}

/// The disk device `d` is on (itself for a disk).
pub fn disk_of(d: u64) -> u64 {
    (d / DPD) * DPD
}

/// Its first sector on its disk (0 for a disk).
pub fn start_of(d: u64) -> u64 {
    if !present(d) { 0 } else { dw(d, D_START) }
}

/// Its partition number (0 for a disk).
pub fn partno(d: u64) -> u64 {
    if !present(d) { 0 } else { dw(d, D_PARTNO) }
}

/// px79: its logical block size (the disk's).
pub fn lbs(d: u64) -> u64 {
    if !present(d) { 512 } else { dw(d, D_LBS) }
}

fn digits(v: u64) -> u64 {
    var n: u64 = 1
    var x = v
    while x >= 10 {
        x = x / 10
        n += 1
    }
    n
}

// px75: a disk's name (`vda`, `nvme0n1`) is made once, when its record
// is (`make_stem`), and read back below without a loop. The names are
// inlined wherever a device is named (the partition table's report,
// kernel/ext2's mount lines, …), and the release tier's range pass
// re-seeds a function's every branch once for each loop it might
// version: decimal loops at every one of those sites doubled a
// release kernel build (pax#215's CI; notes/px75-nvme.md).

/// Byte `i` of disk record `d`'s name set to `b` (16 bytes at most).
fn stem_set(d: u64, i: u64, b: u64) {
    if i < 16 {
        let w = D_STEM + i / 8
        put_dw(d, w, dw(d, w) | ((b & 0xff) << ((i % 8) * 8)))
    }
}

/// `v` in decimal into disk record `d`'s name from byte `at`: the end.
fn stem_dec(d: u64, at: u64, v: u64) -> u64 {
    var p: u64 = 1
    var k: u64 = 1
    while k < digits(v) {
        p = p * 10
        k += 1
    }
    var i = at
    while p > 0 {
        stem_set(d, i, 48 + v / p % 10)
        i += 1
        p = p / 10
    }
    i
}

/// Disk record `d`'s name, from its driver and numbers: `vd` and the
/// virtio disk's letter, or `nvme<c>n<k>`.
fn make_stem(d: u64) {
    put_dw(d, D_STEM, 0)
    put_dw(d, D_STEM + 1, 0)
    var n: u64 = 3
    if dw(d, D_DRV) == DRV_NVME {
        stem_set(d, 0, 110) // n
        stem_set(d, 1, 118) // v
        stem_set(d, 2, 109) // m
        stem_set(d, 3, 101) // e
        n = stem_dec(d, 4, dw(d, D_CTRL))
        stem_set(d, n, 110) // n
        n = stem_dec(d, n + 1, dw(d, D_NSO))
    } else {
        let sd = dw(d, D_DRV) == DRV_AHCI || dw(d, D_DRV) == DRV_USB
        stem_set(d, 0, if sd { 115 } else { 118 }) // s or v
        stem_set(d, 1, 100) // d
        // a, b, … (the virtio disk's own number; px78: an sd disk's letter)
        stem_set(d, 2, 97 + (if sd { dw(d, D_LETTER) } else { dw(d, D_UNIT) }))
    }
    put_dw(d, D_STEMLEN, if n > 16 { 16 } else { n })
}

/// The length of device `d`'s disk's name (3, `vd` and a letter, for a
/// device with no record).
fn stem_len(d: u64) -> u64 {
    if d >= count() {
        return 3
    }
    let n = dw(disk_of(d), D_STEMLEN)
    if n == 0 { 3 } else { n }
}

/// Byte `i` (below `stem_len(d)`) of device `d`'s disk's name.
fn stem_byte(d: u64, i: u64) -> u64 {
    if d >= count() || dw(disk_of(d), D_STEMLEN) == 0 {
        return if i == 0 { 118 } else if i == 1 { 100 } else { 97 + d / DPD }
    }
    (dw(disk_of(d), D_STEM + i / 8) >> ((i % 8) * 8)) & 0xff
}

/// 1 when device `d`'s partitions take a `p` before their number
/// (Linux's rule: the disk's name ends in a digit, as an NVMe one does).
fn psep(d: u64) -> u64 {
    if d < count() && dw(disk_of(d), D_DRV) == DRV_NVME { 1 } else { 0 }
}

/// The decimal digits of partition number `p` (1 to DPD - 1 = 128).
fn pdigits(p: u64) -> u64 {
    if p < 10 { 1 } else if p < 100 { 2 } else { 3 }
}

/// The length of device `d`'s name (`vda`: 3, `vda12`: 5; px75:
/// `nvme0n1`: 7, `nvme0n1p12`: 10).
pub fn name_len(d: u64) -> u64 {
    let p = partno(d)
    if p == 0 { stem_len(d) } else { stem_len(d) + psep(d) + pdigits(p) }
}

/// Byte `i` of device `d`'s name (`vda`, `vda2`; px75: `nvme0n1`,
/// `nvme0n1p2`: Linux's names, the `p` because the disk's name ends in a
/// digit), 0 past the end.
pub fn name_byte(d: u64, i: u64) -> u64 {
    let s = stem_len(d)
    if i < s {
        return stem_byte(d, i)
    }
    let p = partno(d)
    if p == 0 {
        return 0
    }
    var j = i - s
    if psep(d) == 1 {
        if j == 0 {
            return 112 // p
        }
        j -= 1
    }
    let w = pdigits(p)
    if j >= w {
        return 0
    }
    let r = w - 1 - j
    48 + (p / (if r == 0 { 1 } else if r == 1 { 10 } else { 100 })) % 10
}

/// Write device `d`'s name to the log.
pub fn put_name(d: u64) {
    let n = name_len(d)
    var i: u64 = 0
    while i < n {
        log.put_byte(name_byte(d, i) as int)
        i += 1
    }
}

/// px67: device `d`'s name written at `base + at` (at most `cap` bytes
/// in all): the end (kernel/files' mount table).
pub fn name_into(d: u64, base: u64, at: u64, cap: u64) -> u64 {
    let n = name_len(d)
    var k = at
    var i: u64 = 0
    while i < n {
        if k < cap {
            // # Safety: the caller's frame through the HHDM, `cap` bytes; k < cap.
            unsafe { ((base + k) as *u8).write_volatile((name_byte(d, i) & 0xff) as u8) }
        }
        k += 1
        i += 1
    }
    k
}

/// px75: the decimal number in the `n` bytes at `a` (no leading zero but
/// `0` itself), or 0x8000000000000000 when they are none.
fn dec_at(a: u64, n: u64) -> u64 {
    if n == 0 || n > 6 || (n > 1 && b8(a) == 48) {
        return 0x8000000000000000
    }
    var v: u64 = 0
    var k: u64 = 0
    while k < n {
        let c = b8(a + k)
        if c < 48 || c > 57 {
            return 0x8000000000000000
        }
        v = v * 10 + (c - 48)
        k += 1
    }
    v
}

/// px75: disk `k`'s partition numbered `p` (`p` 0: the disk), or DEVS.
fn part_of(k: u64, p: u64) -> u64 {
    if p == 0 {
        return k * DPD
    }
    var d = k * DPD + 1
    while d < (k + 1) * DPD {
        if present(d) && partno(d) == p {
            return d
        }
        d += 1
    }
    DEVS
}

/// The device whose name is the `n` bytes at `a` (`vda`, `vda2`, or
/// `/dev/vda2`; px75: `nvme0n1`, `nvme0n1p2`, `/dev/nvme0n1p2`), or DEVS.
pub fn by_name(a: u64, n: u64) -> u64 {
    var o: u64 = 0
    if n > 5 && b8(a) == 47 && b8(a + 1) == 100 && b8(a + 2) == 101 && b8(a + 3) == 118 && b8(a + 4) == 47 {
        o = 5
    }
    if n >= o + 7 && b8(a + o) == 110 && b8(a + o + 1) == 118 && b8(a + o + 2) == 109 && b8(a + o + 3) == 101 {
        return by_nvme_name(a + o + 4, n - o - 4)
    }
    if n < o + 3 || (b8(a + o) != 118 && b8(a + o) != 115) || b8(a + o + 1) != 100 {
        return DEVS
    }
    let sd = b8(a + o) == 115
    let letter = b8(a + o + 2)
    if letter < 97 || letter > 122 {
        return DEVS
    }
    // The number, if any: digits, no leading zero.
    var p: u64 = 0
    var k = o + 3
    while k < n {
        let c = b8(a + k)
        if c < 48 || c > 57 || (k == o + 3 && c == 48) || p > 100000 {
            return DEVS
        }
        p = p * 10 + (c - 48)
        k += 1
    }
    var x: u64 = 0
    while x < disks() {
        let drv = dw(x * DPD, D_DRV)
        let is_sd = drv == DRV_AHCI || drv == DRV_USB
        if sd && is_sd && dw(x * DPD, D_LETTER) == letter - 97 {
            return part_of(x, p)
        }
        if !sd && drv == DRV_VIRTIO && dw(x * DPD, D_UNIT) == letter - 97 {
            return part_of(x, p)
        }
        x += 1
    }
    DEVS
}

/// px75: `<c>n<k>[p<N>]`, the `n` bytes at `a` after `nvme`.
fn by_nvme_name(a: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n && b8(a + i) != 110 {
        i += 1
    }
    if i == n {
        return DEVS
    }
    let c = dec_at(a, i)
    var j = i + 1
    while j < n && b8(a + j) != 112 {
        j += 1
    }
    let ns = dec_at(a + i + 1, j - i - 1)
    var p: u64 = 0
    if j < n {
        p = dec_at(a + j + 1, n - j - 1)
        if p == 0 {
            return DEVS
        }
    }
    if c >= 0x8000000000000000 || ns >= 0x8000000000000000 || p >= 0x8000000000000000 || ns == 0 {
        return DEVS
    }
    var x: u64 = 0
    while x < disks() {
        let d = x * DPD
        if dw(d, D_DRV) == DRV_NVME && dw(d, D_CTRL) == c && dw(d, D_NSO) == ns {
            return part_of(x, p)
        }
        x += 1
    }
    DEVS
}

/// px75: device `d`'s disk's driver (DRV_*).
pub fn driver(d: u64) -> u64 {
    if !present(d) { DRV_VIRTIO } else { dw(disk_of(d), D_DRV) }
}

/// px75: the largest request `rw_pages` makes to device `d`'s disk as
/// one, in sectors: kernel/nvme's (its controller's MDTS, 256 at most),
/// 8 for a virtio disk (one frame a request here).
pub fn max_sectors(d: u64) -> u64 {
    if !present(d) {
        return 8
    }
    let disk = disk_of(d)
    if dw(disk, D_DRV) == DRV_NVME { nvme.max_sectors(dw(disk, D_UNIT)) } else if dw(disk, D_DRV) == DRV_AHCI { 256 } else if dw(disk, D_DRV) == DRV_USB { usb_storage.MAX_SECTORS } else { 8 }
}

/// px75: BLKROTATIONAL's answer (measured on the guest: 1 for a virtio
/// disk, 0 for an NVMe namespace).
pub fn rotational(d: u64) -> u64 {
    if driver(d) == DRV_NVME { 0 } else if driver(d) == DRV_AHCI { ahci.rotational(dw(disk_of(d), D_UNIT)) } else { 1 }
}

/// px78: sysfs `removable` for device `d`'s disk: a USB disk's INQUIRY
/// RMB bit (Linux's answer for such a disk, measured), 0 for every other.
pub fn removable(d: u64) -> u64 {
    if present(d) && driver(d) == DRV_USB && usb_storage.removable(dw(disk_of(d), D_UNIT)) { 1 } else { 0 }
}

/// Linux's device numbers for device `d`: (major, minor).
pub fn numbers(d: u64) -> (u64, u64) {
    if !present(d) {
        return (254, (d / DPD) * 16)
    }
    (dw(d, D_MAJOR), dw(d, D_MINOR))
}

fn said(d: u64, bit: u64) -> bool {
    let s = dw(d, D_SAID)
    put_dw(d, D_SAID, s | bit)
    s & bit != 0
}

/// px75: hand request record `r` to disk device `disk`'s own driver.
fn hand(disk: u64, r: u64) {
    if dw(disk, D_DRV) == DRV_NVME {
        nvme.submit(dw(disk, D_UNIT), r)
    } else if dw(disk, D_DRV) == DRV_AHCI {
        ahci.submit(dw(disk, D_UNIT), r)
    } else if dw(disk, D_DRV) == DRV_USB {
        usb_storage.submit(dw(disk, D_UNIT), r)
    } else {
        vblk.submit(dw(disk, D_UNIT), r)
    }
}

/// px75: wait for record `r` on disk device `disk`'s driver: its status
/// (0 success).
fn waited(disk: u64, r: u64) -> u64 {
    if dw(disk, D_DRV) == DRV_NVME {
        nvme.wait(dw(disk, D_UNIT), r)
    } else if dw(disk, D_DRV) == DRV_AHCI {
        ahci.wait(dw(disk, D_UNIT), r)
    } else if dw(disk, D_DRV) == DRV_USB {
        usb_storage.wait(dw(disk, D_UNIT), r)
    } else {
        vblk.wait(dw(disk, D_UNIT), r)
    }
}

/// One request to device `d`, waited for: type `op` (vblk.T_IN, T_OUT),
/// `n` sectors from `sector` (of the device: a partition's from its own
/// first sector), the data at physical `pa` (inside one frame: n <= 8).
/// 0, or -EIO (the device's error, a request that never came back, or a
/// refusal: past the capacity, a write to a read-only disk), each
/// counted.
pub fn rw(d: u64, op: u64, sector: u64, n: u64, pa: u64) -> u64 {
    request(d, op, sector, n, pa, 0, 8)
}

/// px75: one request of `n` sectors whose data runs across the pages
/// listed at kernel address `list` (physical addresses, one a page, the
/// data page after page), to device `d`: up to `max_sectors(d)` as one
/// request; to a virtio disk, one request a page. 0 or -EIO, as `rw`.
pub fn rw_pages(d: u64, op: u64, sector: u64, n: u64, list: u64) -> u64 {
    if !present(d) {
        return neg(EIO)
    }
    if dw(disk_of(d), D_DRV) != DRV_VIRTIO {
        return request(d, op, sector, n, rd(list), list, max_sectors(d))
    }
    var done: u64 = 0
    while done < n {
        let k = if n - done < 8 { n - done } else { 8 }
        let e = rw(d, op, sector + done, k, rd(list + (done / 8) * 8))
        if e != 0 {
            return e
        }
        done += k
    }
    0
}

fn request(d: u64, op: u64, sector: u64, n: u64, pa: u64, list: u64, most: u64) -> u64 {
    if !present(d) {
        return neg(EIO)
    }
    let cap = dw(d, D_SECTORS)
    if n == 0 || n > most || n > cap || sector > cap - n {
        bump_dw(d, D_REFUSED, 1)
        if !said(d, 1) {
            log.put("block: refused: a request past the end of ")
            put_name(d)
            log.put(" (sector ")
            log.dec(sector as int)
            log.put(", ")
            log.dec(n as int)
            log.put(" sectors, capacity ")
            log.dec(cap as int)
            log.put("), -EIO")
            log.end()
        }
        return neg(EIO)
    }
    let disk = dw(d, D_DISK)
    if op == vblk.T_OUT && dw(d, D_FLAGS) & F_RO != 0 {
        bump_dw(d, D_REFUSED, 1)
        if !said(d, 2) {
            log.put("block: refused: a write to ")
            put_name(d)
            log.put(if dw(disk, D_DRV) == DRV_NVME { ", which the controller says is write protected (NSATTR), -EIO" } else if dw(disk, D_DRV) == DRV_USB { ", which the device says is write-protected (MODE SENSE's WP), -EIO" } else { ", which the device says is read-only (VIRTIO_BLK_F_RO), -EIO" })
            log.end()
        }
        return neg(EIO)
    }
    let r = base() + S_REQ * 8
    wr(r, op)
    wr(r + 8, dw(d, D_START) + sector)
    wr(r + 16, n)
    wr(r + 24, pa)
    wr(r + 48, list)
    hand(disk, r)
    let s = waited(disk, r)
    wr(r + 40, vblk.RS_FREE)
    var x = d
    while true {
        if op == vblk.T_IN {
            bump_dw(x, D_READS, 1)
            bump_dw(x, D_SIN, n)
        } else {
            bump_dw(x, D_WRITES, 1)
            bump_dw(x, D_SOUT, n)
        }
        if s != vblk.S_OK {
            bump_dw(x, D_ERRORS, 1)
        }
        if x == disk {
            break
        }
        x = disk
    }
    if s != vblk.S_OK {
        return neg(EIO)
    }
    0
}

/// A FLUSH to device `d`'s disk (when it takes one: 0 at once when it
/// does not, its writes are then on the medium when they complete),
/// waited for: 0 or -EIO.
pub fn flush(d: u64) -> u64 {
    if !present(d) {
        return neg(EIO)
    }
    let disk = dw(d, D_DISK)
    if dw(disk, D_FLAGS) & F_FLUSH == 0 {
        return 0
    }
    let r = base() + S_REQ * 8
    wr(r, vblk.T_FLUSH)
    wr(r + 8, 0)
    wr(r + 16, 0)
    wr(r + 24, 0)
    wr(r + 48, 0)
    hand(disk, r)
    let s = waited(disk, r)
    wr(r + 40, vblk.RS_FREE)
    bump_dw(disk, D_FLUSHES, 1)
    kbump(K_FLUSHES, 1)
    if s != vblk.S_OK {
        bump_dw(disk, D_ERRORS, 1)
        return neg(EIO)
    }
    0
}

fn neg(e: u64) -> u64 {
    0xffffffffffffffff - e + 1
}

/// Device record word `w` of device `d` (a report's: D_READS and on).
pub fn books(d: u64, which: u64) -> u64 {
    if !present(d) {
        return 0
    }
    dw(d, D_READS + which)
}

// --- mounts: a disk or one of its partitions, never both -------------------------

/// Whether devices `d` and `x` are the same, or one is the other's disk
/// (px79: the claims below conflict between them).
fn related(d: u64, x: u64) -> bool {
    let disk = dw(d, D_DISK)
    dw(x, D_DISK) == disk && (x == d || x == disk || d == disk)
}

/// Whether device `d` may be claimed (a mount, or px79's O_EXCL open):
/// 0, or -EBUSY when it, its disk or (for a disk) one of its partitions
/// is mounted or held by an exclusive open. Measured on Linux 7.3.0: a
/// mount of vda2 while vda2 or vda is held O_EXCL, an O_EXCL open of
/// vda or vda2 while vda2 is mounted, and a second O_EXCL open of a
/// device, each -EBUSY; vda1 opens O_EXCL while vda2 is mounted.
fn claimable(d: u64) -> u64 {
    let disk = dw(d, D_DISK)
    var x = disk
    while x < disk + DPD {
        if present(x) && related(d, x) && (dw(x, D_CLAIM) != 0 || dw(x, D_EXCL) != 0) {
            return x
        }
        x += 1
    }
    DEVS
}

/// Claim device `d` for a mount (kernel/ext2's): 0, or -EBUSY with one
/// line, by name, when `d` is a disk one of whose partitions is
/// mounted, or a partition whose disk is (their blocks would be cached
/// twice, under two keys); px79: or when one of them is held by an
/// O_EXCL open (then said too). A second claim of `d` itself is
/// kernel/ext2's own -EBUSY, not said here.
pub fn claim(d: u64) -> u64 {
    if !present(d) {
        return neg(EIO)
    }
    let disk = dw(d, D_DISK)
    let x = claimable(d)
    if x != DEVS && (x != d || dw(x, D_EXCL) != 0) {
        log.put("block: refused: a mount of ")
        put_name(d)
        if dw(x, D_EXCL) != 0 {
            log.put(" while ")
            put_name(x)
            log.put(" is held by an exclusive open, -EBUSY")
        } else if d == disk {
            log.put(" while its partition ")
            put_name(x)
            log.put(" is mounted, -EBUSY")
        } else {
            log.put(" while ")
            put_name(x)
            log.put(", its disk, is mounted, -EBUSY")
        }
        log.end()
        return neg(EBUSY)
    }
    put_dw(d, D_CLAIM, 1)
    0
}

/// Let device `d` go (an unmount).
pub fn release(d: u64) {
    if present(d) {
        put_dw(d, D_CLAIM, 0)
    }
}

/// px79: whether device `d` is mounted (claimed).
pub fn claimed(d: u64) -> bool {
    present(d) && dw(d, D_CLAIM) != 0
}

/// px79: an open of device `d`'s node (kernel/files' `openat`): 0, or
/// -EBUSY for an O_EXCL open (`excl`) that `claimable` refuses (open(2):
/// O_EXCL without O_CREAT on a block device opens it exclusively), or
/// -ENXIO when it is gone.
pub fn open_dev(d: u64, excl: bool) -> u64 {
    if !present(d) {
        return neg(ENXIO)
    }
    if excl {
        if claimable(d) != DEVS {
            return neg(EBUSY)
        }
        put_dw(d, D_EXCL, 1)
    }
    put_dw(d, D_OPENS, dw(d, D_OPENS) + 1)
    0
}

/// px79: the last close of an open file on device `d`'s node.
pub fn close_dev(d: u64, excl: bool) {
    if !present(d) {
        return
    }
    if excl {
        put_dw(d, D_EXCL, 0)
    }
    if dw(d, D_OPENS) != 0 {
        put_dw(d, D_OPENS, dw(d, D_OPENS) - 1)
    }
}

// --- the partition table (px66) ----------------------------------------------------

fn crc_byte(c: u64, b: u64) -> u64 {
    var x = c ^ b
    var k: u64 = 0
    while k < 8 {
        if x & 1 != 0 {
            x = (x >> 1) ^ 0xedb88320
        } else {
            x = x >> 1
        }
        k += 1
    }
    x
}

fn scr() -> u64 {
    st(S_SCR) + hh()
}

/// Read `n` sectors of the disk from `lba` into the scratch frame: 0 or
/// -EIO. The array reader's window is forgotten.
fn read_scr(lba: u64, n: u64) -> u64 {
    put_st(S_WN, 0)
    rw(cur_disk(), vblk.T_IN, lba, n, st(S_SCR))
}

/// Byte `o` of the entry array that starts at S_AELBA, through a window
/// of up to eight sectors in the scratch frame (S_AERR set on a failed read).
fn arr_byte(o: u64) -> u64 {
    let s = st(S_AELBA) + o / 512
    let wb = st(S_WB)
    if st(S_WN) == 0 || s < wb || s >= wb + st(S_WN) {
        var n = st(S_AEND) - s
        if n > 8 {
            n = 8
        }
        if rw(cur_disk(), vblk.T_IN, s, n, st(S_SCR)) != 0 {
            put_st(S_AERR, 1)
            put_st(S_WN, 0)
            return 0
        }
        put_st(S_WB, s)
        put_st(S_WN, n)
    }
    b8(scr() + (s - st(S_WB)) * 512 + o % 512)
}

fn arr_le64(o: u64) -> u64 {
    var v: u64 = 0
    var k: u64 = 8
    while k > 0 {
        k -= 1
        v = (v << 8) | arr_byte(o + k)
    }
    v
}

fn arr_le32(o: u64) -> u64 {
    arr_byte(o) | (arr_byte(o + 1) << 8) | (arr_byte(o + 2) << 16) | (arr_byte(o + 3) << 24)
}

fn arr_open(elba: u64, bytes: u64) {
    put_st(S_AELBA, elba)
    put_st(S_AEND, elba + (bytes + 511) / 512)
    put_st(S_WN, 0)
    put_st(S_AERR, 0)
}

fn hx(h: u64, w: u64) -> u64 {
    pt(h + w)
}

fn put_hx(h: u64, w: u64, v: u64) {
    put_pt(h + w, v)
}

/// px79: the disk device whose table is being read (S_CUR's).
fn cur_disk() -> u64 {
    st(S_CUR) * DPD
}

/// The header at `lba` checked (§5.3.2's tests, in its order) and its
/// facts kept at `h`: 0 when it holds, else why (W_*), with the numbers
/// the refusal names at `val` (found, wanted).
fn check_header(lba: u64, h: u64, val: u64) -> u64 {
    put_pt(val, 0)
    put_pt(val + 1, 0)
    let last = dw(cur_disk(), D_SECTORS) - 1
    if read_scr(lba, 1) != 0 {
        return W_IO
    }
    let p = scr()
    if le64(p) != 0x5452415020494645 {
        put_pt(val, le64(p))
        return W_SIG
    }
    let rev = le32(p + 8)
    if rev >> 16 != 1 {
        put_pt(val, rev)
        return W_REV
    }
    let hs = le32(p + 12)
    if hs < 92 || hs > 512 {
        put_pt(val, hs)
        return W_HSIZE
    }
    var c: u64 = 0xffffffff
    var k: u64 = 0
    while k < hs {
        c = crc_byte(c, if k >= 16 && k < 20 { 0 } else { b8(p + k) })
        k += 1
    }
    c = c ^ 0xffffffff
    let found = le32(p + 16)
    put_hx(h, HX_HCRC, found)
    if c != found {
        put_pt(val, found)
        put_pt(val + 1, c)
        return W_HCRC
    }
    let my = le64(p + 24)
    if my != lba {
        put_pt(val, my)
        put_pt(val + 1, lba)
        return W_MYLBA
    }
    put_hx(h, HX_MY, my)
    put_hx(h, HX_ALT, le64(p + 32))
    let first = le64(p + 40)
    let lastu = le64(p + 48)
    put_hx(h, HX_FIRST, first)
    put_hx(h, HX_LAST, lastu)
    put_hx(h, HX_GUID, le64(p + 56))
    put_hx(h, HX_GUID + 1, le64(p + 64))
    let elba = le64(p + 72)
    let count = le32(p + 80)
    let esize = le32(p + 84)
    let acrc = le32(p + 88)
    put_hx(h, HX_ELBA, elba)
    put_hx(h, HX_COUNT, count)
    put_hx(h, HX_ESIZE, esize)
    put_hx(h, HX_ACRC, acrc)
    if first < 2 || first > lastu || lastu >= last {
        put_pt(val, first)
        put_pt(val + 1, lastu)
        return W_USABLE
    }
    if esize < 128 || esize % 8 != 0 || esize > 4096 {
        put_pt(val, esize)
        return W_ESIZE
    }
    if count > 1048576 / esize {
        put_pt(val, count)
        return W_ASIZE
    }
    let bytes = count * esize
    let asec = (bytes + 511) / 512
    if elba < 2 || elba > last || asec > last - elba || (elba + asec > first && elba <= lastu) {
        put_pt(val, elba)
        put_pt(val + 1, asec)
        return W_ARRAY
    }
    arr_open(elba, bytes)
    c = 0xffffffff
    var o: u64 = 0
    while o < bytes {
        c = crc_byte(c, arr_byte(o))
        o += 1
    }
    if st(S_AERR) != 0 {
        return W_IO
    }
    c = c ^ 0xffffffff
    if c != acrc {
        put_pt(val, acrc)
        put_pt(val + 1, c)
        return W_ACRC
    }
    0
}

/// px79: the lowest minor of the extended major (259) no device has, as
/// the guest gives them (measured: vda16 259:0 … vda128 259:112, then
/// vdb16 259:113; after a rescan of vda its partitions take 259:0 … again).
fn ext_minor() -> u64 {
    var m: u64 = 0
    while true {
        var used = false
        var d: u64 = 0
        while d < count() && !used {
            if present(d) && dw(d, D_MAJOR) == 259 && dw(d, D_MINOR) == m {
                used = true
            }
            d += 1
        }
        if !used {
            return m
        }
        m += 1
    }
    m
}

/// A partition of disk `k` (px79: its free record, the lowest), number
/// `partno`, `n` sectors from `first`: the device, or DEVS when the disk
/// has DPD - 1 already.
fn add_part_on(k: u64, partno: u64, first: u64, n: u64, kind: u64) -> u64 {
    let disk = k * DPD
    var d = disk + 1
    while d < disk + DPD && dw(d, D_PRESENT) == 1 {
        d += 1
    }
    if d == disk + DPD {
        return DEVS
    }
    var w: u64 = 0
    while w < DW {
        put_dw(d, w, 0)
        w += 1
    }
    put_dw(d, D_PRESENT, 1)
    put_dw(d, D_SECTORS, n)
    put_dw(d, D_FLAGS, dw(disk, D_FLAGS))
    put_dw(d, D_LBS, dw(disk, D_LBS))
    put_dw(d, D_DISK, disk)
    put_dw(d, D_START, first)
    put_dw(d, D_PARTNO, partno)
    put_dw(d, D_KIND, kind)
    if partno <= 15 && dw(disk, D_DRV) != DRV_NVME {
        let sd = dw(disk, D_DRV) == DRV_AHCI || dw(disk, D_DRV) == DRV_USB
        put_dw(d, D_MAJOR, if sd { 8 } else { 254 })
        put_dw(d, D_MINOR, (if sd { dw(disk, D_LETTER) } else { dw(disk, D_UNIT) }) * 16 + partno)
    } else {
        // px75: every NVMe partition, and a virtio one past 15:
        // the lowest free minor, asked before this record says 259
        let m = ext_minor()
        put_dw(d, D_MAJOR, 259)
        put_dw(d, D_MINOR, m)
    }
    put_st(S_GEN, st(S_GEN) + 1)
    put_dw(d, D_GEN, st(S_GEN))
    d
}

fn add_part(partno: u64, first: u64, n: u64, kind: u64) -> u64 {
    let d = add_part_on(st(S_CUR), partno, first, n, kind)
    if d == DEVS {
        put_pt(S_PT_OVER, pt(S_PT_OVER) + 1)
    }
    d
}

fn refuse_entry(slot: u64, why: u64) {
    if pt(S_PT_BADN) == 0 {
        put_pt(S_PT_BADK, slot)
        put_pt(S_PT_BADW, why)
    }
    put_pt(S_PT_BADN, pt(S_PT_BADN) + 1)
}

/// The UTF-16LE name of the entry at byte `o` of the array (72 bytes),
/// as UTF-8 into device `d`'s record.
fn keep_name(d: u64, o: u64) {
    let a = rec(d) + D_NAME * 8
    var n: u64 = 0
    var k: u64 = 0
    while k < 36 {
        var u = arr_byte(o + 2 * k) | (arr_byte(o + 2 * k + 1) << 8)
        if u == 0 {
            break
        }
        k += 1
        if u >= 0xd800 && u < 0xdc00 && k < 36 {
            let lo = arr_byte(o + 2 * k) | (arr_byte(o + 2 * k + 1) << 8)
            if lo >= 0xdc00 && lo < 0xe000 {
                u = 0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00)
                k += 1
            } else {
                u = 0xfffd
            }
        } else if u >= 0xd800 && u < 0xe000 {
            u = 0xfffd
        }
        if n + 4 > NAME_MAX {
            break
        }
        if u < 0x80 {
            put_b8(a + n, u)
            n += 1
        } else if u < 0x800 {
            put_b8(a + n, 0xc0 | (u >> 6))
            put_b8(a + n + 1, 0x80 | (u & 0x3f))
            n += 2
        } else if u < 0x10000 {
            put_b8(a + n, 0xe0 | (u >> 12))
            put_b8(a + n + 1, 0x80 | ((u >> 6) & 0x3f))
            put_b8(a + n + 2, 0x80 | (u & 0x3f))
            n += 3
        } else {
            put_b8(a + n, 0xf0 | (u >> 18))
            put_b8(a + n + 1, 0x80 | ((u >> 12) & 0x3f))
            put_b8(a + n + 2, 0x80 | ((u >> 6) & 0x3f))
            put_b8(a + n + 3, 0x80 | (u & 0x3f))
            n += 4
        }
    }
    put_dw(d, D_NAMELEN, n)
}

/// The partitions of the header at `h`'s entry array.
fn read_entries(h: u64) {
    let count = hx(h, HX_COUNT)
    let esize = hx(h, HX_ESIZE)
    let first = hx(h, HX_FIRST)
    let lastu = hx(h, HX_LAST)
    arr_open(hx(h, HX_ELBA), count * esize)
    var k: u64 = 0
    while k < count {
        let o = k * esize
        let t0 = arr_le64(o)
        let t1 = arr_le64(o + 8)
        if t0 != 0 || t1 != 0 {
            let f = arr_le64(o + 32)
            let l = arr_le64(o + 40)
            if f > l {
                refuse_entry(k + 1, E_ORDER)
            } else if f < first || l > lastu {
                refuse_entry(k + 1, E_USABLE)
            } else {
                let d = add_part(k + 1, f, l - f + 1, KIND_GPT)
                if d != DEVS {
                    put_dw(d, D_TYPE, t0)
                    put_dw(d, D_TYPE + 1, t1)
                    put_dw(d, D_UUID, arr_le64(o + 16))
                    put_dw(d, D_UUID + 1, arr_le64(o + 24))
                    put_dw(d, D_ATTR, arr_le64(o + 48))
                    keep_name(d, o + 56)
                }
            }
        }
        k += 1
    }
}

fn read_gpt() {
    let last = dw(cur_disk(), D_SECTORS) - 1
    let pw = check_header(1, H_P, S_PT_VALP)
    let bw = check_header(last, H_B, S_PT_VALB)
    put_pt(S_PT_WHYP, pw)
    put_pt(S_PT_WHYB, bw)
    if pw != 0 && bw != 0 {
        put_pt(S_PT_KIND, PT_GPTBAD)
        return
    }
    put_pt(S_PT_KIND, PT_GPT)
    let h = if pw == 0 { H_P } else { H_B }
    put_pt(S_PT_USED, if pw == 0 { 1 } else { 2 })
    if pw == 0 && hx(H_P, HX_ALT) != last {
        put_pt(S_PT_ALT, hx(H_P, HX_ALT) + 1)
    }
    if pw == 0 && bw == 0 && (hx(H_P, HX_GUID) != hx(H_B, HX_GUID) || hx(H_P, HX_GUID + 1) != hx(H_B, HX_GUID + 1)
        || hx(H_P, HX_ACRC) != hx(H_B, HX_ACRC) || hx(H_P, HX_COUNT) != hx(H_B, HX_COUNT) || hx(H_P, HX_ESIZE) != hx(H_B, HX_ESIZE)
        || hx(H_P, HX_FIRST) != hx(H_B, HX_FIRST) || hx(H_P, HX_LAST) != hx(H_B, HX_LAST)) {
        put_pt(S_PT_DIFF, 1)
    }
    read_entries(h)
}

fn read_mbr() {
    put_pt(S_PT_KIND, PT_MBR)
    let p = scr()
    let cap = dw(cur_disk(), D_SECTORS)
    put_pt(S_PT_SIG, le32(p + 440))
    var k: u64 = 0
    while k < 4 {
        let r = p + 446 + 16 * k
        let t = b8(r + 4)
        let f = le32(r + 8)
        let n = le32(r + 12)
        if t != 0 && n != 0 {
            if t == 0x05 || t == 0x0f || t == 0x85 {
                if pt(S_PT_EXT) == 0 {
                    put_pt(S_PT_EXT, (k + 1) | (t << 8))
                }
            } else if f == 0 || f > cap || n > cap - f {
                refuse_entry(k + 1, E_DISK)
            } else {
                let d = add_part(k + 1, f, n, KIND_MBR)
                if d != DEVS {
                    put_dw(d, D_TYPE, t)
                    put_dw(d, D_UUID, pt(S_PT_SIG))
                    put_dw(d, D_UUID + 1, k + 1)
                }
            }
        }
        k += 1
    }
}

/// Disk `k`'s partition table, read at `start` (the header above) and
/// again by BLKRRPART (px79's `rescan`); what it found is said by
/// `report`. Its table words are cleared first.
fn read_table(k: u64) {
    put_st(S_CUR, k)
    var w: u64 = 0
    while w < PTW {
        put_pt(w, 0)
        w += 1
    }
    put_pt(S_PT_KIND, PT_NONE)
    let lbs = dw(cur_disk(), D_LBS)
    if lbs != 512 && lbs != 0 {
        put_pt(S_PT_KIND, PT_LBS)
        return
    }
    if dw(cur_disk(), D_SECTORS) < 3 {
        return
    }
    if read_scr(0, 1) != 0 {
        put_pt(S_PT_KIND, PT_IO)
        return
    }
    let p = scr()
    if le16(p + 510) != 0xaa55 {
        return
    }
    var prot = false
    var flags_bad = false
    var j: u64 = 0
    while j < 4 {
        let r = p + 446 + 16 * j
        let boot = b8(r)
        if boot != 0 && boot != 0x80 {
            flags_bad = true
        }
        if b8(r + 4) == 0xee && le32(r + 8) == 1 {
            prot = true
        }
        j += 1
    }
    if prot {
        read_gpt()
    } else if flags_bad {
        put_pt(S_PT_KIND, PT_NOTMBR)
    } else {
        read_mbr()
    }
}

// --- names: PARTUUID=, PARTLABEL= (kernel/fstab), /proc/partitions -------------

/// A hex digit's value, or 16.
fn hexval(c: u64) -> u64 {
    if c >= 48 && c <= 57 { c - 48 } else if c >= 97 && c <= 102 { c - 87 } else if c >= 65 && c <= 70 { c - 55 } else { 16 }
}

/// The `n` bytes at `a` as a GUID's or UUID's text (32 hex digits,
/// hyphens anywhere skipped, either case): (ok, the 16 bytes in the
/// text's order as two big-endian words).
pub fn uuid_text(a: u64, n: u64) -> (bool, u64, u64) {
    var hi: u64 = 0
    var lo: u64 = 0
    var got: u64 = 0
    var k: u64 = 0
    while k < n {
        let c = b8(a + k)
        if c != 45 {
            let v = hexval(c)
            if v == 16 || got == 32 {
                return (false, 0, 0)
            }
            if got < 16 {
                hi = (hi << 4) | v
            } else {
                lo = (lo << 4) | v
            }
            got += 1
        }
        k += 1
    }
    (got == 32, hi, lo)
}

/// A GPT GUID kept as two le64 words (its 16 bytes as on the disk), as
/// the text's two big-endian words (Appendix A: the first three fields
/// are little-endian on the disk).
fn guid_as_text(w0: u64, w1: u64) -> (u64, u64) {
    // Data1, Data2 and Data3 are w0's low 32, next 16 and top 16 bits
    // (little-endian numbers: their text is their value's hex); Data4's
    // eight bytes are w1's from its low byte up, in the text's order.
    var lo: u64 = 0
    var k: u64 = 0
    while k < 8 {
        lo = (lo << 8) | ((w1 >> (8 * k)) & 0xff)
        k += 1
    }
    (((w0 & 0xffffffff) << 32) | (((w0 >> 32) & 0xffff) << 16) | ((w0 >> 48) & 0xffff), lo)
}

/// Write a GUID (two le64 words as on the disk, or as Limine's
/// `struct limine_uuid` holds it) as its text.
pub fn put_guid(w0: u64, w1: u64) {
    let (hi, lo) = guid_as_text(w0, w1)
    log.hex_n(hi >> 32, 8)
    log.put("-")
    log.hex_n((hi >> 16) & 0xffff, 4)
    log.put("-")
    log.hex_n(hi & 0xffff, 4)
    log.put("-")
    log.hex_n(lo >> 48, 4)
    log.put("-")
    log.hex_n(lo & 0xffffffffffff, 12)
}

/// Write device `d`'s PARTUUID: a GPT partition's unique GUID, an MBR
/// partition's `ssssssss-nn` (as the guest's blkid prints them).
pub fn put_partuuid(d: u64) {
    if kind(d) == KIND_GPT {
        put_guid(dw(d, D_UUID), dw(d, D_UUID + 1))
    } else if kind(d) == KIND_MBR {
        log.hex_n(dw(d, D_UUID), 8)
        log.put("-")
        log.hex_n(dw(d, D_UUID + 1), 2)
    }
}

/// The partition whose PARTUUID is the `n` bytes at `a`, or DEVS.
pub fn by_partuuid(a: u64, n: u64) -> u64 {
    var d: u64 = 1
    if n == 11 && b8(a + 8) == 45 {
        // an MBR partition's: ssssssss-nn
        var sig: u64 = 0
        var k: u64 = 0
        while k < 8 {
            let v = hexval(b8(a + k))
            if v == 16 {
                return DEVS
            }
            sig = (sig << 4) | v
            k += 1
        }
        let p1 = hexval(b8(a + 9))
        let p2 = hexval(b8(a + 10))
        if p1 == 16 || p2 == 16 {
            return DEVS
        }
        while d < count() {
            if kind(d) == KIND_MBR && dw(d, D_UUID) == sig && dw(d, D_UUID + 1) == p1 * 16 + p2 {
                return d
            }
            d += 1
        }
        return DEVS
    }
    let (ok, hi, lo) = uuid_text(a, n)
    if !ok {
        return DEVS
    }
    while d < count() {
        if kind(d) == KIND_GPT {
            let (th, tl) = guid_as_text(dw(d, D_UUID), dw(d, D_UUID + 1))
            if th == hi && tl == lo {
                return d
            }
        }
        d += 1
    }
    DEVS
}

/// The GPT partition whose name (PARTLABEL) is the `n` bytes at `a`, or DEVS.
pub fn by_partlabel(a: u64, n: u64) -> u64 {
    var d: u64 = 1
    while d < count() {
        if kind(d) == KIND_GPT && dw(d, D_NAMELEN) == n {
            let p = rec(d) + D_NAME * 8
            var k: u64 = 0
            while k < n && b8(p + k) == b8(a + k) {
                k += 1
            }
            if k == n {
                return d
            }
        }
        d += 1
    }
    DEVS
}

// The renderer's sink (state words): every byte the text has is
// counted, and those in [off, off + n) are written at dst.
const S_SK_POS: u64 = 100
const S_SK_OFF: u64 = 101
const S_SK_N: u64 = 102
const S_SK_DST: u64 = 103

fn sk(c: u64) {
    let p = st(S_SK_POS)
    let off = st(S_SK_OFF)
    if p >= off && p - off < st(S_SK_N) {
        put_b8(st(S_SK_DST) + p - off, c)
    }
    put_st(S_SK_POS, p + 1)
}

fn sk_str(s: str) {
    for c in s.bytes() {
        sk(c as int as u64)
    }
}

/// `v` in decimal, right-aligned in `width` columns.
fn sk_num(v: u64, width: u64) {
    var pad = digits(v)
    while pad < width {
        sk(32)
        pad += 1
    }
    var p: u64 = 1
    while v / p >= 10 {
        p = p * 10
    }
    while p > 0 {
        sk(48 + v / p % 10)
        p = p / 10
    }
}

/// `/proc/partitions`' text, bytes [off, off + n) of it to the kernel
/// address `dst`: how many were written (n, or fewer at the end). Linux
/// 7.2.8's layout, measured on the guest (tests/mpx6-part.d/linux/): a
/// header line and an empty one, then a line a device, the disk first
/// and its partitions in their table's order: the major in 4 columns,
/// two blanks, the minor in 7, a blank, the size in KiB (sectors / 2,
/// rounded down) in 10, a blank, the name. The table does not change
/// after `start`, so a reader in pieces reads one text; it is made again
/// for each piece, so it may be longer than a page (128 partitions:
/// 4,152 bytes).
pub fn partitions_slice(dst: u64, off: u64, n: u64) -> u64 {
    if base() == 0 {
        // No disk: Linux's file then has the header alone.
        let h = "major minor  #blocks  name\n\n"
        var k: u64 = 0
        var w: u64 = 0
        for c in h.bytes() {
            if k >= off && w < n {
                put_b8(dst + w, c as int as u64)
                w += 1
            }
            k += 1
        }
        return w
    }
    put_st(S_SK_POS, 0)
    put_st(S_SK_OFF, off)
    put_st(S_SK_N, n)
    put_st(S_SK_DST, dst)
    sk_str("major minor  #blocks  name\n\n")
    var k: u64 = 0
    while k < disks() {
        // px79: each disk, then its partitions by number (measured: a
        // partition BLKPG adds takes its number's place, not the end)
        var d = k * DPD
        while d != DEVS {
            let (ma, mi) = numbers(d)
            sk_num(ma, 4)
            sk_str("  ")
            sk_num(mi, 7)
            sk(32)
            sk_num(dw(d, D_SECTORS) / 2, 10)
            sk(32)
            var i: u64 = 0
            while i < name_len(d) {
                sk(name_byte(d, i))
                i += 1
            }
            sk(10)
            d = next_part(k, partno(d))
        }
        k += 1
    }
    let total = st(S_SK_POS)
    if total <= off { 0 } else if total - off < n { total - off } else { n }
}

/// px79: disk `k`'s partition with the lowest number above `after`, or
/// DEVS when it has none.
pub fn next_part(k: u64, after: u64) -> u64 {
    var best = DEVS
    var d = k * DPD + 1
    while d < (k + 1) * DPD && k < disks() {
        if present(d) && partno(d) > after && (best == DEVS || partno(d) < partno(best)) {
            best = d
        }
        d += 1
    }
    best
}

/// px79: the `n`th device (from 0) in /proc/partitions' order (the
/// disks in order, each with its partitions by number), or DEVS.
pub fn nth_dev(n: u64) -> u64 {
    var i: u64 = 0
    var k: u64 = 0
    while k < disks() {
        var d = k * DPD
        while d != DEVS {
            if i == n {
                return d
            }
            i += 1
            d = next_part(k, partno(d))
        }
        k += 1
    }
    DEVS
}

/// `/proc/partitions`' length in bytes.
pub fn partitions_len() -> u64 {
    if base() == 0 {
        return 28
    }
    let _w = partitions_slice(0, 0, 0)
    st(S_SK_POS)
}

// --- the buffer cache -------------------------------------------------------------

/// The write policy (R-px63-3): WRITE_THROUGH or WRITE_BACK.
pub fn policy() -> u64 {
    if base() == 0 { WRITE_THROUGH } else { st(S_POLICY) }
}

/// Set it (a mount's option, kernel/user's fstab): the old one. Going
/// to write-through writes what is dirty first.
pub fn set_policy(p: u64) -> u64 {
    if base() == 0 {
        return WRITE_THROUGH
    }
    let old = st(S_POLICY)
    if p == WRITE_THROUGH && old == WRITE_BACK {
        var d: u64 = 0
        while d < count() {
            let _s = sync(d)
            d += 1
        }
    }
    put_st(S_POLICY, p)
    old
}

fn hdr(s: u64) -> u64 {
    st(S_HDRS + s / HPF) + hh() + (s % HPF) * 32
}

fn hw(s: u64, w: u64) -> u64 {
    rd(hdr(s) + w * 8)
}

fn put_hw(s: u64, w: u64, v: u64) {
    wr(hdr(s) + w * 8, v)
}

fn shift_of(bsize: u64) -> u64 {
    if bsize == 1024 { 1 } else if bsize == 2048 { 2 } else if bsize == 4096 { 3 } else { 0 }
}

fn key(d: u64, bsize: u64, blk: u64) -> u64 {
    ((d + 1) << 50) | (shift_of(bsize) << 48) | (blk & 0xffffffffffff)
}

/// px79: the device + 1 a key is of (0 for none).
fn key_dev(k: u64) -> u64 {
    k >> 50
}

fn bucket(k: u64) -> u64 {
    // (masked to 32 bits first: wolf traps an overflow, and the hash
    // wants the low bits mixed, not the product's carries)
    let h = ((k ^ (k >> 9) ^ (k >> 50)) & 0xffffffff) * 0x9e3779b1
    st(S_HASH) + hh() + ((h >> 7) % BUCKETS) * 8
}

/// The slot holding key `k`, or NB.
fn find(k: u64) -> u64 {
    var s = rd(bucket(k))
    var guard: u64 = 0
    while s != 0 && guard <= NB {
        if hw(s - 1, H_KEY) == k {
            return s - 1
        }
        s = hw(s - 1, H_NEXT)
        guard += 1
    }
    NB
}

fn unhash(s: u64) {
    let k = hw(s, H_KEY)
    if k == 0 {
        return
    }
    let b = bucket(k)
    var p = rd(b)
    if p == s + 1 {
        wr(b, hw(s, H_NEXT))
    } else {
        var guard: u64 = 0
        while p != 0 && guard <= NB {
            let nx = hw(p - 1, H_NEXT)
            if nx == s + 1 {
                put_hw(p - 1, H_NEXT, hw(s, H_NEXT))
                p = 0
            } else {
                p = nx
            }
            guard += 1
        }
    }
    put_hw(s, H_KEY, 0)
    put_hw(s, H_NEXT, 0)
}

fn rehash(s: u64, k: u64) {
    let b = bucket(k)
    put_hw(s, H_KEY, k)
    put_hw(s, H_NEXT, rd(b))
    wr(b, s + 1)
}

/// The device, the block and the block size of slot `s`'s key.
fn parts(s: u64) -> (u64, u64, u64) {
    let k = hw(s, H_KEY)
    (key_dev(k) - 1, k & 0xffffffffffff, 512 << ((k >> 48) & 3))
}

/// Write slot `s` to its disk: 0 or -EIO.
fn write_slot(s: u64) -> u64 {
    let (d, blk, bsize) = parts(s)
    let per = bsize / 512
    let r = rw(d, vblk.T_OUT, blk * per, per, hw(s, H_PA))
    kbump(K_WRITES, 1)
    if hw(s, H_FLAGS) & B_DIRTY != 0 {
        // px68: a committed block written home has had its checkpoint
        put_hw(s, H_FLAGS, hw(s, H_FLAGS) & !(B_DIRTY | B_JMETA))
        put_st(S_COUNT + K_DIRTY, st(S_COUNT + K_DIRTY) - 1)
    }
    r
}

/// A slot for a new key: one never made, else the clock hand's next
/// not looked at since it last passed, written first when dirty. NB when
/// no frame can be had for a new one and every made one failed to write.
fn victim() -> u64 {
    if st(S_MADE) < NB {
        let pa = frames.alloc() else 0
        if pa != 0 {
            let s = st(S_MADE)
            put_st(S_MADE, s + 1)
            put_hw(s, H_PA, pa)
            put_hw(s, H_FLAGS, 0)
            put_hw(s, H_KEY, 0)
            put_hw(s, H_NEXT, 0)
            return s
        }
    }
    let made = st(S_MADE)
    if made == 0 {
        return NB
    }
    var n: u64 = 0
    while n < 3 * made {
        let s = st(S_HAND) % made
        put_st(S_HAND, s + 1)
        let f = hw(s, H_FLAGS)
        if f & B_JRUN != 0 {
            n += 1 // px68: the running transaction's: not written home, not taken
            continue
        }
        if f & B_REF != 0 {
            put_hw(s, H_FLAGS, f & !B_REF)
        } else {
            if f & B_DIRTY != 0 {
                let w = write_slot(s)
                if w != 0 {
                    n += 1
                    continue
                }
            }
            unhash(s)
            put_hw(s, H_FLAGS, 0)
            kbump(K_EVICTS, 1)
            return s
        }
        n += 1
    }
    put_st(S_PINNED, st(S_PINNED) + 1)
    if !said(0, 8) {
        log.put("block: no buffer to be had: every one of the ")
        log.dec(made as int)
        log.put(" is held by a running transaction or would not write")
        log.end()
    }
    NB
}

/// Block `blk` (of `bsize` bytes) of disk `d`, read when the cache does
/// not hold it: its address (through the HHDM), good until the next
/// `get` or `fresh`; 0 on an I/O error, past the disk, or with no
/// buffer to be had.
pub fn get(d: u64, blk: u64, bsize: u64) -> u64 {
    if !present(d) || shift_of(bsize) == 0 {
        return 0
    }
    let k = key(d, bsize, blk)
    let s = find(k)
    if s != NB {
        kbump(K_HITS, 1)
        put_hw(s, H_FLAGS, hw(s, H_FLAGS) | B_REF)
        return hw(s, H_PA) + hh()
    }
    let v = victim()
    if v == NB {
        return 0
    }
    let per = bsize / 512
    let r = rw(d, vblk.T_IN, blk * per, per, hw(v, H_PA))
    kbump(K_MISSES, 1)
    if r != 0 {
        return 0
    }
    rehash(v, k)
    put_hw(v, H_FLAGS, B_VALID | B_REF)
    hw(v, H_PA) + hh()
}

/// Block `blk` of disk `d` as a new block: its buffer zeroed, not read
/// (a block just allocated, all of which the caller will write): its
/// address, as `get`'s; 0 with no buffer.
pub fn fresh(d: u64, blk: u64, bsize: u64) -> u64 {
    if !present(d) || shift_of(bsize) == 0 {
        return 0
    }
    let k = key(d, bsize, blk)
    var s = find(k)
    if s == NB {
        s = victim()
        if s == NB {
            return 0
        }
        rehash(s, k)
    }
    let va = hw(s, H_PA) + hh()
    // # Safety: the buffer's frame, through the HHDM.
    unsafe { pax_tree_zero(va, bsize) }
    // px68: a block in the running transaction stays in it (a new
    // indirect block made again); a committed one's old contents are no
    // longer what it holds, so it is no longer awaiting a checkpoint.
    put_hw(s, H_FLAGS, (hw(s, H_FLAGS) & (B_DIRTY | B_JRUN)) | B_VALID | B_REF)
    kbump(K_FRESH, 1)
    va
}

/// Block `blk` of disk `d` has been changed in its buffer: written now
/// (write-through) or marked (write-back). 0, -EIO, or -ENOSPC when the
/// block is not in the cache (a caller that broke the rule above).
pub fn dirty(d: u64, blk: u64, bsize: u64) -> u64 {
    let s = find(key(d, bsize, blk))
    if s == NB {
        return neg(ENOSPC)
    }
    if st(S_POLICY) == WRITE_THROUGH && hw(s, H_FLAGS) & B_JRUN == 0 {
        return write_slot(s)
    }
    let f = hw(s, H_FLAGS)
    if f & B_DIRTY != 0 {
        kbump(K_REDIRTY, 1)
        return 0
    }
    put_hw(s, H_FLAGS, f | B_DIRTY)
    put_st(S_COUNT + K_DIRTY, st(S_COUNT + K_DIRTY) + 1)
    0
}

/// Write every dirty buffer of disk `d`, then FLUSH it: 0 or -EIO (the
/// first error; the rest are still tried).
pub fn sync(d: u64) -> u64 {
    if !present(d) {
        return 0
    }
    var err: u64 = 0
    var s: u64 = 0
    while s < st(S_MADE) {
        // px68: a running transaction's buffer is the journal's to write
        if hw(s, H_FLAGS) & (B_DIRTY | B_JRUN) == B_DIRTY && key_dev(hw(s, H_KEY)) == d + 1 {
            let w = write_slot(s)
            if w != 0 && err == 0 {
                err = w
            }
        }
        s += 1
    }
    let f = flush(d)
    if err != 0 { err } else { f }
}

// --- px68: the journal's side of the cache ----------------------------------------

/// Block `blk` of disk `d`, in the cache (the caller changed it just
/// now), joins the running transaction: marked dirty, B_JRUN and B_JMETA,
/// never written through. 1 when it was not in the transaction before,
/// 0 when it was, -ENOSPC when it is not in the cache.
pub fn jdirty(d: u64, blk: u64, bsize: u64) -> u64 {
    let s = find(key(d, bsize, blk))
    if s == NB {
        return neg(ENOSPC)
    }
    let f = hw(s, H_FLAGS)
    if f & B_DIRTY == 0 {
        put_st(S_COUNT + K_DIRTY, st(S_COUNT + K_DIRTY) + 1)
    } else {
        kbump(K_REDIRTY, 1)
    }
    put_hw(s, H_FLAGS, f | B_DIRTY | B_JRUN | B_JMETA)
    if f & B_JRUN == 0 { 1 } else { 0 }
}

/// Block `blk` of disk `d`, freed in the running transaction, leaves it:
/// whether it was in it. Its buffer is no longer dirty (what it holds now
/// was never committed, and the block is free: the disk keeps what the
/// last commit left there).
pub fn jforget(d: u64, blk: u64, bsize: u64) -> bool {
    let s = find(key(d, bsize, blk))
    if s == NB {
        return false
    }
    let f = hw(s, H_FLAGS)
    if f & B_JRUN == 0 {
        return false
    }
    if f & B_DIRTY != 0 {
        put_st(S_COUNT + K_DIRTY, st(S_COUNT + K_DIRTY) - 1)
    }
    put_hw(s, H_FLAGS, f & !(B_DIRTY | B_JRUN | B_JMETA))
    true
}

/// The physical address of block `blk`'s buffer (the journal writes it
/// to the log from there), 0 when the cache does not hold it.
pub fn buffer_pa(d: u64, blk: u64, bsize: u64) -> u64 {
    let s = find(key(d, bsize, blk))
    if s == NB { 0 } else { hw(s, H_PA) }
}

/// Block `blk`'s commit block is on the disk: its buffer leaves the
/// running transaction, a committed block awaiting its checkpoint.
pub fn jdone(d: u64, blk: u64, bsize: u64) {
    let s = find(key(d, bsize, blk))
    if s != NB {
        put_hw(s, H_FLAGS, (hw(s, H_FLAGS) & !B_JRUN) | B_JMETA)
    }
}

/// data=ordered (px68): every dirty buffer of disk `d` that is neither in
/// a running transaction nor journalled metadata (a file's data) written
/// home; no FLUSH (the journal's own comes after its log blocks). 0 or
/// the first -EIO.
pub fn write_data(d: u64) -> u64 {
    var err: u64 = 0
    var s: u64 = 0
    while s < st(S_MADE) {
        if hw(s, H_FLAGS) & (B_DIRTY | B_JRUN | B_JMETA) == B_DIRTY && key_dev(hw(s, H_KEY)) == d + 1 {
            let w = write_slot(s)
            if w != 0 && err == 0 {
                err = w
            }
        }
        s += 1
    }
    err
}

/// The checkpoint (px68): every committed block of disk `d` awaiting it
/// written home (none of a running transaction's: the journal asks only
/// when none is open); no FLUSH. 0 or the first -EIO.
pub fn checkpoint(d: u64) -> u64 {
    var err: u64 = 0
    var s: u64 = 0
    while s < st(S_MADE) {
        let f = hw(s, H_FLAGS)
        if f & (B_DIRTY | B_JRUN | B_JMETA) == (B_DIRTY | B_JMETA) && key_dev(hw(s, H_KEY)) == d + 1 {
            let w = write_slot(s)
            if w != 0 && err == 0 {
                err = w
            }
        } else if f & (B_DIRTY | B_JMETA) == B_JMETA && key_dev(hw(s, H_KEY)) == d + 1 {
            put_hw(s, H_FLAGS, f & !B_JMETA)
        }
        s += 1
    }
    err
}

/// Forget every buffer of disk `d` (after `sync`, at an unmount): a
/// later `get` reads the disk again.
pub fn forget(d: u64) {
    var s: u64 = 0
    while s < st(S_MADE) {
        if key_dev(hw(s, H_KEY)) == d + 1 && hw(s, H_FLAGS) & B_DIRTY == 0 {
            unhash(s)
            put_hw(s, H_FLAGS, 0)
        }
        s += 1
    }
}

/// px68: misses that found no buffer to take (every one held by a
/// running transaction, or failing to write).
pub fn pinned() -> u64 {
    if base() == 0 { 0 } else { st(S_PINNED) }
}

/// Buffers made (frames held by the cache).
pub fn buffers() -> u64 {
    if base() == 0 { 0 } else { st(S_MADE) }
}

/// The disk's lines (kernel/vblk's, then the layer's), then what its
/// partition table holds (px66):
///
///     block: vda: <s> sectors (<b> bytes), 254:0, <rw|read-only>[, flush]
///     block: vda: GPT, disk <guid>, <n> entries of <e> bytes at LBA <l>, usable LBAs <f>-<u>; <p> partitions
///     block: vda2: 254:2, sectors <f>-<l> (<n> sectors, <b> bytes), type <guid>, PARTUUID <guid>, name "<name>"
///     block: vda: MBR, signature <ssssssss>; <p> partitions
///     block: vda1: 254:1, sectors <f>-<l> (<n> sectors, <b> bytes), type 0x<tt>, PARTUUID <ssssssss>-<nn>
///
/// with a line for each refusal and for each header not used (the
/// module's header says which). A disk with no table (no 0x55aa) has the
/// first line alone.
pub fn report() {
    var k: u64 = 0
    while k < disks() {
        // px79: each disk's lines in turn, its driver's first (px75:
        // kernel/nvme's controller line before its first namespace's)
        let d = k * DPD
        if dw(d, D_DRV) == DRV_NVME {
            nvme.report(dw(d, D_UNIT))
        } else if dw(d, D_DRV) == DRV_AHCI {
            ahci.report(dw(d, D_UNIT))
        } else if dw(d, D_DRV) == DRV_USB {
            usb_storage.report(dw(d, D_UNIT))
        } else {
            vblk.report(dw(d, D_UNIT))
        }
        disk_line(d)
        put_st(S_CUR, k)
        table_report()
        k += 1
    }
}

/// A disk's own line: `block: <name>: <s> sectors (<b> bytes), <major>:<minor>, read-write[, flush]`.
fn disk_line(d: u64) {
    tag(d)
    log.dec(dw(d, D_SECTORS) as int)
    log.put(" sectors (")
    log.dec((dw(d, D_SECTORS) * 512) as int)
    log.put(" bytes), ")
    log.dec(dw(d, D_MAJOR) as int)
    log.put(":")
    log.dec(dw(d, D_MINOR) as int)
    log.put(if dw(d, D_FLAGS) & F_RO != 0 { ", read-only" } else { ", read-write" })
    if dw(d, D_FLAGS) & F_FLUSH != 0 {
        log.put(", flush")
    }
    log.end()
}

/// px79: `block: <name>: ` for device `d`.
fn tag(d: u64) {
    log.put("block: ")
    put_name(d)
    log.put(": ")
}

/// px79: the name of the disk the table words are about, then `s`.
fn disk_says(s: str) {
    tag(cur_disk())
    log.put(s)
}

/// px79: how many partitions disk `k` has.
pub fn parts_of(k: u64) -> u64 {
    var n: u64 = 0
    var d = k * DPD + 1
    while d < (k + 1) * DPD && k < disks() {
        if present(d) {
            n += 1
        }
        d += 1
    }
    n
}

fn put_why(w: u64, val: u64) {
    if w == W_IO {
        log.put("could not be read")
    } else if w == W_SIG {
        log.put("has no signature (EFI PART)")
    } else if w == W_REV {
        log.put("has revision ")
        log.hex_n(pt(val), 8)
        log.put(" (1.0 is read)")
    } else if w == W_HSIZE {
        log.put("has a header size of ")
        log.dec(pt(val) as int)
        log.put(" (92 to 512)")
    } else if w == W_HCRC {
        log.put("fails its CRC32 (")
        log.hex_n(pt(val), 8)
        log.put(" stored, ")
        log.hex_n(pt(val + 1), 8)
        log.put(" computed)")
    } else if w == W_MYLBA {
        log.put("says it is at LBA ")
        log.dec(pt(val) as int)
    } else if w == W_USABLE {
        log.put("has usable LBAs ")
        log.dec(pt(val) as int)
        log.put("-")
        log.dec(pt(val + 1) as int)
        log.put(", not inside the disk")
    } else if w == W_ESIZE {
        log.put("has entries of ")
        log.dec(pt(val) as int)
        log.put(" bytes (128 or a larger multiple of 8, at most 4096, are read)")
    } else if w == W_ASIZE {
        log.put("has ")
        log.dec(pt(val) as int)
        log.put(" entries (an array of at most 1 MiB is read)")
    } else if w == W_ARRAY {
        log.put("has its entry array at LBA ")
        log.dec(pt(val) as int)
        log.put(" (")
        log.dec(pt(val + 1) as int)
        log.put(" sectors), outside the space a table may use")
    } else {
        log.put("fails its entry array's CRC32 (")
        log.hex_n(pt(val), 8)
        log.put(" stored, ")
        log.hex_n(pt(val + 1), 8)
        log.put(" computed)")
    }
}

// px75: the report is five functions, each called once, not one. The
// release tier's range pass re-seeds a function's every branch once for
// each loop it might version, so its cost grows with the square of a
// function's branches. As one function the report took 14 of 83 gdb
// samples of a release kernel's mid-end at trunk, and 42 of 107 once
// px75's code moved kernel/serial's put into its codegen cluster and the
// cross-cluster phase inlined it 114 times (pax#215; notes/px75-nvme.md,
// R-px75-10).

fn table_report() {
    let k = pt(S_PT_KIND)
    let disk = cur_disk()
    let last = dw(disk, D_SECTORS) - 1
    if k == PT_NONE || k == PT_NOTMBR {
        return
    }
    if k == PT_IO || k == PT_LBS || k == PT_GPTBAD {
        table_refused(k, disk, last)
        return
    }
    table_header(k, last)
    table_refusals()
    var d = next_part(st(S_CUR), 0)
    while d != DEVS {
        part_line(d)
        d = next_part(st(S_CUR), partno(d))
    }
}

/// The table read refused whole (PT_IO, PT_LBS, PT_GPTBAD): its line.
fn table_refused(k: u64, disk: u64, last: u64) {
    if k == PT_IO {
        disk_says("the partition table: LBA 0 could not be read; ")
        put_name(disk)
        log.put(" is the whole disk")
        log.end()
        return
    }
    if k == PT_LBS {
        disk_says("refused: a partition table on logical blocks of ")
        log.dec(dw(disk, D_LBS) as int)
        log.put(" bytes (PAX reads tables of 512-byte blocks); not read, ")
        put_name(disk)
        log.put(" is the whole disk")
        log.end()
        return
    }
    if k == PT_GPTBAD {
        disk_says("refused: no valid GPT: the primary header at LBA 1 ")
        put_why(pt(S_PT_WHYP), S_PT_VALP)
        log.put(", the backup at LBA ")
        log.dec(last as int)
        log.put(" ")
        put_why(pt(S_PT_WHYB), S_PT_VALB)
        log.put("; no partitions, ")
        put_name(disk)
        log.put(" is the whole disk")
        log.end()
        return
    }
}

/// The table's own line (GPT or MBR), and a GPT header's notes before it.
fn table_header(k: u64, last: u64) {
    if k == PT_GPT {
        let h = if pt(S_PT_USED) == 1 { H_P } else { H_B }
        if pt(S_PT_USED) == 2 {
            disk_says("the primary GPT header at LBA 1 ")
            put_why(pt(S_PT_WHYP), S_PT_VALP)
            log.put("; the backup at LBA ")
            log.dec(last as int)
            log.put(" is used")
            log.end()
        } else if pt(S_PT_WHYB) != 0 {
            disk_says("the backup GPT header at LBA ")
            log.dec(last as int)
            log.put(" ")
            put_why(pt(S_PT_WHYB), S_PT_VALB)
            log.put("; the primary is used")
            log.end()
        }
        if pt(S_PT_ALT) != 0 {
            disk_says("the primary GPT header's alternate LBA is ")
            log.dec((pt(S_PT_ALT) - 1) as int)
            log.put(", not the disk's last, ")
            log.dec(last as int)
            log.put("; the backup was read at the last")
            log.end()
        }
        if pt(S_PT_DIFF) != 0 {
            disk_says("the backup GPT header disagrees with the primary; the primary is used")
            log.end()
        }
        disk_says("GPT, disk ")
        put_guid(hx(h, HX_GUID), hx(h, HX_GUID + 1))
        log.put(", ")
        log.dec(hx(h, HX_COUNT) as int)
        log.put(" entries of ")
        log.dec(hx(h, HX_ESIZE) as int)
        log.put(" bytes at LBA ")
        log.dec(hx(h, HX_ELBA) as int)
        log.put(", usable LBAs ")
        log.dec(hx(h, HX_FIRST) as int)
        log.put("-")
        log.dec(hx(h, HX_LAST) as int)
    } else {
        disk_says("MBR, signature ")
        log.hex_n(pt(S_PT_SIG), 8)
    }
    log.put("; ")
    let np = parts_of(st(S_CUR))
    log.dec(np as int)
    log.put(if np == 1 { " partition" } else { " partitions" })
    log.end()
}

/// The table's entries refused: an extended partition, bad entries, too many.
fn table_refusals() {
    if pt(S_PT_EXT) != 0 {
        disk_says("refused: an extended partition (type 0x")
        log.hex_n(pt(S_PT_EXT) >> 8, 2)
        log.put(") in slot ")
        log.dec((pt(S_PT_EXT) & 0xff) as int)
        log.put(": its logical partitions are not read")
        log.end()
    }
    if pt(S_PT_BADN) != 0 {
        disk_says("refused: ")
        log.dec(pt(S_PT_BADN) as int)
        log.put(if pt(S_PT_BADN) == 1 { " entry" } else { " entries" })
        log.put(", the first slot ")
        log.dec(pt(S_PT_BADK) as int)
        let w = pt(S_PT_BADW)
        log.put(if w == E_ORDER { ": its first LBA is after its last" } else if w == E_USABLE { ": outside the usable LBAs" } else { ": past the disk's end, or at LBA 0" })
        log.end()
    }
    if pt(S_PT_OVER) != 0 {
        disk_says("refused: ")
        log.dec(pt(S_PT_OVER) as int)
        log.put(" partitions past the most PAX keeps (")
        log.dec((DPD - 1) as int)
        log.put(")")
        log.end()
    }
}

/// Partition `d`'s line.
fn part_line(d: u64) {
    log.put("block: ")
    put_name(d)
    log.put(": ")
    log.dec(dw(d, D_MAJOR) as int)
    log.put(":")
    log.dec(dw(d, D_MINOR) as int)
    log.put(", sectors ")
    log.dec(dw(d, D_START) as int)
    log.put("-")
    log.dec((dw(d, D_START) + dw(d, D_SECTORS) - 1) as int)
    log.put(" (")
    log.dec(dw(d, D_SECTORS) as int)
    log.put(" sectors, ")
    log.dec((dw(d, D_SECTORS) * 512) as int)
    log.put(" bytes), type ")
    if dw(d, D_KIND) == KIND_GPT {
        put_guid(dw(d, D_TYPE), dw(d, D_TYPE + 1))
    } else {
        log.put("0x")
        log.hex_n(dw(d, D_TYPE), 2)
    }
    log.put(", PARTUUID ")
    put_partuuid(d)
    if dw(d, D_KIND) == KIND_GPT {
        log.put(", name ")
        log.put_byte(34)
        let p = rec(d) + D_NAME * 8
        var i: u64 = 0
        while i < dw(d, D_NAMELEN) {
            log.put_byte(b8(p + i) as int)
            i += 1
        }
        log.put_byte(34)
    }
    log.end()
}

/// The books' line, and one for each partition a request was made to:
///
///     block: vda: <r> reads (<si> sectors), <w> writes (<so> sectors), <f> flushes, <e> errors, <x> refused; cache <m> buffers, <h> hits, <mi> misses, <ev> taken back, <fr> fresh, <rd> written again while dirty, <dn> dirty, policy write-through|write-back
///     block: vda2: <r> reads (<si> sectors), <w> writes (<so> sectors), <e> errors, <x> refused
///
/// The disk's counts are every request its driver was given, its
/// partitions' included.
pub fn summary() {
    var k: u64 = 0
    while k < disks() {
        books_of(k)
        k += 1
    }
    nvme.shutdown() // px75: each controller's books and its normal shutdown, last
}

/// px79: disk `k`'s lines of the books (vda's with the cache's numbers,
/// as px63's; another disk's with its own counts alone: the cache is
/// one for every disk).
fn books_of(k: u64) {
    let disk = k * DPD
    if k != 0 {
        tag(disk)
        log.dec(dw(disk, D_READS) as int)
        log.put(" reads (")
        log.dec(dw(disk, D_SIN) as int)
        log.put(" sectors), ")
        log.dec(dw(disk, D_WRITES) as int)
        log.put(" writes (")
        log.dec(dw(disk, D_SOUT) as int)
        log.put(" sectors), ")
        log.dec(dw(disk, D_FLUSHES) as int)
        log.put(" flushes, ")
        log.dec(dw(disk, D_ERRORS) as int)
        log.put(" errors, ")
        log.dec(dw(disk, D_REFUSED) as int)
        log.put(" refused")
        log.end()
        part_books(k)
        return
    }
    tag(0)
    log.dec(dw(0, D_READS) as int)
    log.put(" reads (")
    log.dec(dw(0, D_SIN) as int)
    log.put(" sectors), ")
    log.dec(dw(0, D_WRITES) as int)
    log.put(" writes (")
    log.dec(dw(0, D_SOUT) as int)
    log.put(" sectors), ")
    log.dec(dw(0, D_FLUSHES) as int)
    log.put(" flushes, ")
    log.dec(dw(0, D_ERRORS) as int)
    log.put(" errors, ")
    log.dec(dw(0, D_REFUSED) as int)
    log.put(" refused; cache ")
    log.dec(st(S_MADE) as int)
    log.put(" buffers, ")
    log.dec(st(S_COUNT + K_HITS) as int)
    log.put(" hits, ")
    log.dec(st(S_COUNT + K_MISSES) as int)
    log.put(" misses, ")
    log.dec(st(S_COUNT + K_EVICTS) as int)
    log.put(" taken back, ")
    log.dec(st(S_COUNT + K_FRESH) as int)
    log.put(" fresh, ")
    log.dec(st(S_COUNT + K_REDIRTY) as int)
    log.put(" written again while dirty, ")
    log.dec(st(S_COUNT + K_DIRTY) as int)
    log.put(" dirty, policy ")
    log.put(if st(S_POLICY) == WRITE_BACK { "write-back" } else { "write-through" })
    log.end()
    part_books(0)
}

/// px79: the lines of disk `k`'s partitions a request was made to.
fn part_books(k: u64) {
    var d = next_part(k, 0)
    while d != DEVS {
        if dw(d, D_READS) + dw(d, D_WRITES) + dw(d, D_REFUSED) != 0 {
            log.put("block: ")
            put_name(d)
            log.put(": ")
            log.dec(dw(d, D_READS) as int)
            log.put(" reads (")
            log.dec(dw(d, D_SIN) as int)
            log.put(" sectors), ")
            log.dec(dw(d, D_WRITES) as int)
            log.put(" writes (")
            log.dec(dw(d, D_SOUT) as int)
            log.put(" sectors), ")
            log.dec(dw(d, D_ERRORS) as int)
            log.put(" errors, ")
            log.dec(dw(d, D_REFUSED) as int)
            log.put(" refused")
            log.end()
        }
        d = next_part(k, partno(d))
    }
}

// --- px79: raw I/O through a node, the rescan, BLKPG, the ioctls' facts ----------

/// The frame (physical) raw I/O through a node reads and writes by (up
/// to 8 sectors at a time), taken at its first use; 0 with no frame.
pub fn bounce() -> u64 {
    if base() == 0 {
        return 0
    }
    if st(S_BOUNCE) == 0 {
        put_st(S_BOUNCE, zeroed())
    }
    st(S_BOUNCE)
}

/// px75: the list (its kernel address) of BOUNCE_PAGES frames (physical
/// addresses) raw I/O reads and writes by when a disk takes requests of
/// more than a page (kernel/nvme's), taken at its first use; 0 with no
/// frames.
pub fn bounce_list() -> u64 {
    if base() == 0 {
        return 0
    }
    if st(S_BLIST) == 0 {
        let l = zeroed()
        if l == 0 {
            return 0
        }
        var k: u64 = 0
        while k < BOUNCE_PAGES {
            let f = zeroed()
            if f == 0 {
                return 0
            }
            wr(l + hh() + k * 8, f)
            k += 1
        }
        put_st(S_BLIST, l)
    }
    st(S_BLIST) + hh()
}

/// After a raw write of `n` sectors from `sector` of device `d` (a node's
/// write): every buffer of a device on the same disk that holds one of
/// those sectors and is clean is forgotten, so the next `get` reads what
/// the write left. A dirty one is kept: a mounted file system's change
/// not yet written, which the raw write and the file system then both
/// claim. Linux leaves that to the user too (a write to a node does not
/// lock out the file system mounted on it: measured, a raw write to vda
/// while vda2 is mounted is allowed); the note says so, and nothing here
/// locks.
pub fn raw_wrote(d: u64, sector: u64, n: u64) {
    if !present(d) {
        return
    }
    let disk = disk_of(d)
    let a = start_of(d) + sector
    let e = a + n
    var s: u64 = 0
    while s < st(S_MADE) {
        let k = hw(s, H_KEY)
        if k != 0 && hw(s, H_FLAGS) & B_DIRTY == 0 {
            let (dev, blk, bsize) = parts(s)
            if present(dev) && disk_of(dev) == disk {
                let per = bsize / 512
                let bs = start_of(dev) + blk * per
                if bs < e && a < bs + per {
                    unhash(s)
                    put_hw(s, H_FLAGS, 0)
                }
            }
        }
        s += 1
    }
}

/// Whether a partition of disk device `disk` is open, mounted or held
/// exclusively: its device, or DEVS.
fn busy_part(disk: u64) -> u64 {
    var d = disk + 1
    while d < disk + DPD {
        if present(d) && (dw(d, D_OPENS) != 0 || dw(d, D_CLAIM) != 0 || dw(d, D_EXCL) != 0) {
            return d
        }
        d += 1
    }
    DEVS
}

/// Partition `d` taken away (its blocks written and forgotten first).
fn drop_part(d: u64) {
    let _s = sync(d)
    forget(d)
    put_dw(d, D_PRESENT, 0)
    put_dw(d, D_GEN, 0)
}

/// BLKRRPART (`ioctl_list(2)`: re-read the partition table) of device
/// `d`: 0, its table read again (px66's reading) and its partitions made
/// again from it, the old ones taken away; -EINVAL for a partition's
/// node; -EBUSY while one of its partitions is open, mounted or held
/// exclusively, or the disk itself is mounted (R-px79-3, recommended and
/// implemented, not decided: Linux 7.3.0's answer, measured: -EBUSY with
/// vda2 mounted and with vda1 merely open; 0 with vda itself open); one
/// line names the partition. Then the disk's table lines again, as at
/// boot.
pub fn rescan(d: u64) -> u64 {
    if !present(d) {
        return neg(ENXIO)
    }
    if partno(d) != 0 {
        return neg(EINVAL)
    }
    let b = busy_part(d)
    if b != DEVS || dw(d, D_CLAIM) != 0 {
        tag(d)
        log.put("refused: BLKRRPART while ")
        put_name(if b != DEVS { b } else { d })
        log.put(if b != DEVS && dw(b, D_OPENS) != 0 && dw(b, D_CLAIM) == 0 { " is open" } else { " is mounted or held exclusively" })
        log.put(", -EBUSY")
        log.end()
        return neg(EBUSY)
    }
    var p = d + 1
    while p < d + DPD {
        if present(p) {
            drop_part(p)
        }
        p += 1
    }
    let k = d / DPD
    read_table(k)
    disk_says("the partition table read again (BLKRRPART)")
    log.end()
    table_report()
    0
}

/// The partition of disk device `disk` numbered `pno`, or DEVS.
fn part_no(disk: u64, pno: u64) -> u64 {
    var d = disk + 1
    while d < disk + DPD {
        if present(d) && partno(d) == pno {
            return d
        }
        d += 1
    }
    DEVS
}

/// BLKPG_ADD_PARTITION (`linux/blkpg.h`) on device `d`: partition `pno`,
/// `len` bytes from byte `start` of the disk. 0, the partition made (its
/// node, /proc/partitions' and /sys's lines at once); -EINVAL for a
/// partition's node, a number below 1 or past the most PAX keeps (128), a
/// start or a length that is no whole number of the disk's sectors, an
/// empty one, one that passes the disk's end (measured: -EINVAL); -EBUSY
/// for a number in use or a range that overlaps another partition's
/// (measured, both); -ENOSPC when the disk has DPD - 1 already (PAX's
/// limit). One line names what was made.
pub fn blkpg_add(d: u64, pno: u64, start: u64, len: u64) -> u64 {
    if !present(d) {
        return neg(ENXIO)
    }
    if partno(d) != 0 || pno < 1 || pno > DPD - 1 {
        return neg(EINVAL)
    }
    let ls = dw(d, D_LBS)
    if start % ls != 0 || len % ls != 0 || len == 0 || start >= 0x8000000000000000 || len >= 0x8000000000000000 {
        return neg(EINVAL)
    }
    let first = start / 512
    let n = len / 512
    if first > dw(d, D_SECTORS) || n > dw(d, D_SECTORS) - first {
        return neg(EINVAL)
    }
    if part_no(d, pno) != DEVS {
        return neg(EBUSY)
    }
    var x = d + 1
    while x < d + DPD {
        if present(x) && dw(x, D_START) < first + n && first < dw(x, D_START) + dw(x, D_SECTORS) {
            return neg(EBUSY)
        }
        x += 1
    }
    let p = add_part_on(d / DPD, pno, first, n, KIND_ADDED)
    if p == DEVS {
        return neg(ENOSPC)
    }
    tag(p)
    log.dec(dw(p, D_MAJOR) as int)
    log.put(":")
    log.dec(dw(p, D_MINOR) as int)
    log.put(", sectors ")
    log.dec(first as int)
    log.put("-")
    log.dec((first + n - 1) as int)
    log.put(" (")
    log.dec(n as int)
    log.put(" sectors), added (BLKPG_ADD_PARTITION)")
    log.end()
    0
}

/// BLKPG_DEL_PARTITION on device `d`: partition `pno` taken away: 0;
/// -EINVAL for a partition's node; -ENXIO for a number no partition has;
/// -EBUSY while it is open, mounted or held exclusively (measured: open
/// or mounted, -EBUSY). One line names it.
pub fn blkpg_del(d: u64, pno: u64) -> u64 {
    if !present(d) {
        return neg(ENXIO)
    }
    if partno(d) != 0 {
        return neg(EINVAL)
    }
    let p = part_no(d, pno)
    if p == DEVS {
        return neg(ENXIO)
    }
    if dw(p, D_OPENS) != 0 || dw(p, D_CLAIM) != 0 || dw(p, D_EXCL) != 0 {
        return neg(EBUSY)
    }
    tag(p)
    log.put("removed (BLKPG_DEL_PARTITION)")
    log.end()
    drop_part(p)
    0
}

/// BLKBSZGET's answer for device `d`: its soft block size, the largest of
/// 4096, 2048, 1024 and 512 (not below the logical block) that its size
/// is a whole number of (measured on the guest: 4096 for a 64 MiB disk,
/// a 16 MiB partition and a 4 MiB disk, 512 for a partition of 127
/// sectors).
pub fn soft_block(d: u64) -> u64 {
    let bytes = sectors(d) * 512
    var b: u64 = 4096
    while b > lbs(d) && bytes % b != 0 {
        b = b / 2
    }
    b
}

/// BLKGETDISKSEQ's answer: the disk's sequence number, 1 for the first
/// disk the kernel saw (measured: vda 1, vdb 2, vdc 3; a partition its
/// disk's).
pub fn diskseq(d: u64) -> u64 {
    d / DPD + 1
}

/// HDIO_GETGEO's numbers for device `d`: the disk's (heads, sectors,
/// cylinders) as its device gives them (kernel/vblk's VIRTIO_BLK_F_GEOMETRY:
/// measured, the guest answers QEMU's own, `cyls=`, `heads=`, `secs=`
/// when set, else 16 heads, 63 sectors, the capacity's cylinders), and the
/// first sector (a partition's start); none (0, 0, 0) when the device
/// offers no geometry.
pub fn geometry(d: u64) -> (u64, u64, u64) {
    let disk = disk_of(d)
    if d < count() && dw(disk, D_DRV) == DRV_NVME {
        // px75: measured, the guest's for an NVMe namespace: 64 heads, 32
        // sectors, the capacity's cylinders (sectors / 2048), whatever
        // the logical block.
        return (64, 32, dw(disk, D_SECTORS) / 2048)
    }
    if d < count() && (dw(disk, D_DRV) == DRV_AHCI || dw(disk, D_DRV) == DRV_USB) {
        // Measured Linux libata/SCSI projection, not obsolete IDENTIFY CHS
        // (px78: a USB disk is SCSI's too).
        return (255, 63, dw(disk, D_SECTORS) / (255 * 63))
    }
    let (c, h, s) = vblk.geometry(dw(disk, D_UNIT))
    (h, s, c)
}

/// Copy `n` bytes between kernel addresses (a buffer and a caller's
/// frame): kernel/ext2's and kmain_blk's.
pub fn copy_bytes(dst: u64, src: u64, n: u64) {
    // # Safety: both ranges inside frames the callers hold, through the
    // HHDM; they do not overlap.
    unsafe { pax_tree_copy(dst, src, n) }
}

/// Disk identity from hardware, never inferred from the name.
pub fn identity_len(d: u64, serial_number: bool) -> u64 {
    if !present(d) { return 0 }
    let disk = disk_of(d)
    let u = dw(disk, D_UNIT)
    if driver(d) == DRV_NVME { nvme.identity_len(u, serial_number) }
    else if driver(d) == DRV_AHCI { ahci.identity_len(u, serial_number) }
    else if driver(d) == DRV_USB { usb_storage.identity_len(u, serial_number) }
    else { 0 }
}
pub fn identity_byte(d: u64, serial_number: bool, i: u64) -> u64 {
    if !present(d) { return 0 }
    let u = dw(disk_of(d), D_UNIT)
    if driver(d) == DRV_NVME { nvme.identity_byte(u, serial_number, i) }
    else if driver(d) == DRV_AHCI { ahci.identity_byte(u, serial_number, i) }
    else if driver(d) == DRV_USB { usb_storage.identity_byte(u, serial_number, i) }
    else { 0 }
}
pub fn physical_size(d: u64) -> u64 {
    if driver(d) == DRV_AHCI { ahci.physical_size(dw(disk_of(d), D_UNIT)) } else { lbs(d) }
}
