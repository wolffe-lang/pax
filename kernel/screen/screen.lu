//! screen — the console drawn on the framebuffer (px19): a text grid in
//! a bitmap font, colours, a cursor and scrolling, fed the same bytes as
//! the serial console.
//!
//! **One hook.** Every byte the kernel or a program writes to the
//! console reaches the wire through `serial.put` (kernel/log's lines,
//! kernel/console's echo, kernel/user's `write`), and `serial.put` hands
//! it to `put` here. Before the screen is attached (kernel/fb, after
//! PAX's paging is up), `put` keeps the bytes in boot/screen.S's 16 KiB
//! early buffer; `attach` clears the screen and replays them, so the
//! screen shows the boot from its first line. A kernel that never
//! attaches only fills the buffer (counted when it overflows).
//!
//! **The terminal** is a small subset of what a VT100-style terminal
//! does, chosen for what PAX's programs write:
//!
//! - printable bytes: ASCII, and UTF-8 decoded to one cell a code
//!   point; a code point below 256 is drawn from the font's table
//!   (boot/font.S, Spleen 8x16; one the font lacks is drawn as `?`), one
//!   at or above 256 and a malformed sequence's byte as `?`;
//! - wrapping is deferred: a character written in the last column
//!   leaves the cursor there with a wrap pending, and the next printable
//!   character first moves to the start of the next line (CR, LF, BS and
//!   TAB clear a pending wrap);
//! - LF (0x0a) moves down one row, scrolling the whole grid up when on
//!   the last row (the new row blank in the current rendition, px59: the
//!   measured VT's); CR
//!   (0x0d) to column 0; BS (0x08) one column left, clearing a pending
//!   wrap too (px59, R-px59-5: the measured VT's; px19 only cleared the
//!   wrap); TAB (0x09) to the next multiple of
//!   8, at most the last column; every other C0 byte and DEL do nothing.
//!   The serial console's CR LF (ONLCR) is what a line end looks like
//!   here too;
//! - ESC `[` parameters final: a CSI sequence; with final `m` it is SGR,
//!   of which 0 (reset), 1 (bold, drawn as the bright colour), 7
//!   (inverse), 22 and 27 (bold off, inverse off), 30-37 and 90-97
//!   (foreground), 40-47 and 100-107 (background; 100-107 bright,
//!   R-px59-1), 39 and 49 (default foreground, background), `38;5;n`
//!   and `48;5;n` (the 256 colours, mapped to the 16 as a Linux VT maps
//!   them, measured: `indexed`) are honoured; `38;2` and `48;2` map RGB to the VT colours.
//!   SGR 2/3/4/21 select dim/italic/underline colour substitutions; 5
//!   records blink but draws steady (needs the timer hook, px71).
//!   Colon is a parameter separator exactly like semicolon on this VT; an empty parameter is
//!   0; at most 16 parameters, each at most 9999. A sequence with a
//!   private or intermediate byte, or another final, is read and
//!   ignored, but for the ones below. A C0 byte inside a sequence ends it
//!   and is acted on; a byte at or above 0x80 ends it and is dropped.
//! - (px59) what an editor writes, as a Linux VT draws it (measured
//!   black-box: notes/px59-the-console-for-an-editor.md, notes/px59/
//!   vt.rows and vt2.rows): CUP and HVP (`H`, `f`), CUU CUD CUF CUB
//!   (`A`-`D`), CNL CPL (`E`, `F`), CHA and HPA (`G`, `` ` ``), VPA
//!   (`d`), each clamped to the grid and clearing a pending wrap; ED and
//!   EL (`J`, `K`, 0 1 2, the cursor's cell included) blank in the
//!   current rendition; `ESC 7` and `ESC 8` (the cursor and the
//!   rendition, one slot for both screens); `?1049h`, the alternate
//!   screen, entered with the cursor and rendition kept for the return
//!   and cleared in the current rendition, the cursor where it was;
//!   `?1049l` back to the main screen as it was left, cursor and
//!   rendition restored (a second h or l does nothing); `?25l` and
//!   `?25h` (DECTCEM, the cursor hidden and shown); DECSCUSR (`CSI n SP
//!   q`) recorded and not drawn (PAX's cursor is a block whatever the
//!   shape); OSC (`ESC ]`) consumed to BEL or to any ESC, which then
//!   starts the next sequence (ST's `ESC \` among them), and `ESC ] P`
//!   with its seven digits and `ESC ] R` alone (the VT's palette strings,
//!   not applied); the queries answered as the VT answers them — DA1
//!   (`CSI c`, `CSI 0 c`) and DECID (`ESC Z`) `ESC [ ? 6 c`, DSR 5 `ESC [
//!   0 n`, DSR 6 (`CSI 6 n`, `CSI ? 6 n`) `ESC [ row ; column R` — into a
//!   32-byte queue kernel/console takes from (`answer`) after every
//!   write. ESC followed by anything else is two bytes ignored.
//! - the cursor is the cell under it drawn inverse (its colours
//!   swapped), steady (no blink: a picture of the screen is the same
//!   whenever it is taken), unless hidden (DECTCEM).
//!
//! **The two screens** (px70): each eight-byte pair holds the main
//! screen's 32-bit cell in bits 0-31 and the alternate's in bits 32-63.
//! Each cell has glyph bits 0-7, foreground 8-11, background 12-15 and
//! the recorded blink bit 16. Storage is 256 KiB (64 frames), up from
//! px59's 128 KiB; a scroll still moves only the active half. Item 7
//! measures a separate-buffer layout after the attributes settle.
//!
//! The 16 colours are the PC's text-mode palette: 0 black 000000, 1 red
//! aa0000, 2 green 00aa00, 3 brown aa5500, 4 blue 0000aa, 5 magenta
//! aa00aa, 6 cyan 00aaaa, 7 light grey aaaaaa, 8-15 the bright ones
//! 555555 ff5555 55ff55 ffff55 5555ff ff55ff 55ffff ffffff; the default
//! foreground is 7 and background 0.
//!
//! **Drawing.** A cell is 8x16 pixels; a glyph row is four 64-bit
//! stores of two pixels each. A scroll moves the grid's pixel rows up by
//! 16 lines with boot/screen.S's `pax_fb_copy` (REP MOVSQ) and clears
//! the last 16 with `pax_fb_fill` (REP STOSQ); the cell grid moves the
//! same way. The framebuffer is mapped by kernel/fb (write-combining
//! where the PAT allows). The grid is at most 256 columns by 128 rows;
//! pixels right of and below it stay background.
//!
//! **Interrupts.** `put` runs with IF clear (sched.S's `pax_irq_save`
//! and `pax_irq_restore`), so a timer switch cannot interleave two
//! threads' bytes inside the parser, and it does nothing when re-entered
//! (a fault while drawing reaches the panic path, which prints through
//! `serial.put`, which must not draw again). The state is boot/screen.S's
//! storage, read and written volatile. No heap, no region.
//!
//! Written from the ECMA-48 standard (C0 controls, CSI's syntax, SGR's
//! parameters), the VT100 user guide's description of the last-column
//! wrap, the Intel SDM vol. 2 (MOVS, STOS), and the PC's 16-colour text
//! palette as the VGA documentation gives it; px59 from console_codes(4)
//! and a Linux VT run black-box under QEMU (kasumi's own kernel image,
//! its /dev/vcsa1 read after each case: notes/px59). No Linux source; no
//! other kernel's source.

extern "c" fn pax_irq_save() -> u64
extern "c" fn pax_irq_restore(flags: u64)
extern "c" fn pax_fb_copy(dst: u64, src: u64, bytes: u64)
extern "c" fn pax_fb_fill(dst: u64, v: u64, qwords: u64)

extern "c" let pax_screen_state: *u64
extern "c" let pax_screen_cells: *u64
extern "c" let pax_screen_early: *u8
extern "c" let pax_font: *u8

// The state's words.
const S_ON: u64 = 0 // 1 once attached
const S_VA: u64 = 1 // the framebuffer's virtual address
const S_W: u64 = 2 // pixels
const S_H: u64 = 3
const S_PITCH: u64 = 4 // bytes a pixel row
const S_COLS: u64 = 5
const S_ROWS: u64 = 6
const S_CX: u64 = 7
const S_CY: u64 = 8
const S_WRAP: u64 = 9 // a wrap pending
const S_FG: u64 = 10 // 0-15, before bold
const S_BG: u64 = 11
const S_BOLD: u64 = 12 // intensity: 0 normal, 1 bold, 2 dim
const S_INV: u64 = 13 // flags: inverse 1, italic 2, underline 4, blink 8
const S_ESC: u64 = 14 // 0 ground, 1 after ESC, 2 in a CSI sequence
const S_PI: u64 = 15 // the CSI parameter being read (0-15)
const S_P: u64 = 16 // sixteen 32-bit parameters packed in words 16-23
const S_PRIV: u64 = 24 // the sequence has a private or intermediate byte
const S_UN: u64 = 25 // UTF-8 continuation bytes still wanted
const S_UCP: u64 = 26 // the code point so far
const S_BUSY: u64 = 27
const S_EARLY: u64 = 28 // bytes in the early buffer
const S_LOST: u64 = 29 // bytes the early buffer had no room for
const S_SCROLLS: u64 = 30
const S_BYTES: u64 = 31 // bytes drawn (fed to the terminal)
const S_PAL: u64 = 32 // sixteen pixel values, words 32-47
const S_CUR: u64 = 48 // 1 while the cursor is drawn
const S_CURX: u64 = 49
const S_CURY: u64 = 50
const S_REPLAYED: u64 = 51 // bytes replayed at attach

// px59: the classes an editor writes (notes/px59-the-console-for-an-editor.md).
const S_VISIBLE: u64 = 52 // DECTCEM: 1 while the cursor is shown
const S_SHAPE: u64 = 53 // DECSCUSR's last parameter (0-6), recorded, not drawn
const S_SAVE: u64 = 54 // DECSC: the cursor, x | y << 16
const S_SAVE_ATTR: u64 = 55 // and the rendition, fg | bg << 4 | intensity << 8 | flags << 10
const S_RQ: u64 = 56 // the answers not yet taken: 32 bytes, words 56-59
const S_ALT: u64 = 60 // 1 while the alternate screen is shown
const S_MAIN_POS: u64 = 61 // ?1049h: the main screen's cursor, as S_SAVE
const S_MAIN_ATTR: u64 = 62 // and its rendition, as S_SAVE_ATTR
const S_REPLY: u64 = 63 // the answers' ring: its first byte | its count << 8
const RQ_BYTES: u64 = 32

const MAX_COLS: u64 = 256
const MAX_ROWS: u64 = 128
const EARLY: u64 = 16384
const GW: u64 = 8 // a cell's width in pixels
const GH: u64 = 16 // and height
const BLANK: u64 = 0x0720 // a space, foreground 7, background 0
const QUESTION: u64 = 63

fn sv(i: u64) -> u64 {
    // # Safety: i < 64, inside boot/screen.S's 512-byte pax_screen_state.
    unsafe { ((pax_screen_state as u64 + i * 8) as *u64).read_volatile() }
}

fn put_sv(i: u64, v: u64) {
    // # Safety: as `sv`.
    unsafe { ((pax_screen_state as u64 + i * 8) as *u64).write_volatile(v) }
}

fn bump(i: u64) {
    put_sv(i, sv(i) + 1)
}

// --- the answers -----------------------------------------------------------

/// Byte `i` (< 32) of the answers' ring.
fn rq_byte(i: u64) -> u64 {
    (sv(S_RQ + i / 8) >> ((i % 8) * 8)) & 0xff
}

fn put_rq_byte(i: u64, b: u64) {
    let w = S_RQ + i / 8
    let sh = (i % 8) * 8
    put_sv(w, (sv(w) & !(0xff << sh)) | ((b & 0xff) << sh))
}

/// Queue one byte of an answer; a full ring drops it (32 bytes hold
/// three cursor reports; the console takes them after every write).
fn answer_byte(b: u64) {
    let r = sv(S_REPLY)
    let n = r >> 8
    if n >= RQ_BYTES {
        return
    }
    put_rq_byte(((r & 0xff) + n) % RQ_BYTES, b)
    put_sv(S_REPLY, (r & 0xff) | ((n + 1) << 8))
}

/// `v` in decimal (v < 10000: a row or a column).
fn answer_dec(v: u64) {
    if v >= 10 {
        answer_dec(v / 10)
    }
    answer_byte(48 + v % 10)
}

/// DA1's answer, a Linux VT's: `ESC [ ? 6 c` (notes/px59/vt.rows).
fn answer_da1() {
    answer_byte(27)
    answer_byte(91)
    answer_byte(63)
    answer_byte(54)
    answer_byte(99)
}

/// The cursor-position report: `ESC [ row ; column R`, 1-based, the
/// active screen's cursor (the last column itself with a wrap pending).
fn answer_cpr() {
    answer_byte(27)
    answer_byte(91)
    answer_dec(sv(S_CY) + 1)
    answer_byte(59)
    answer_dec(sv(S_CX) + 1)
    answer_byte(82)
}

/// Cell `i`: one 32-bit half of a pair. Bit 16 records blink; it is
/// deliberately drawn steady until the timer hook (px71) exists.
fn cell(i: u64) -> u64 {
    // # Safety: i < cols * rows <= 256 * 128, inside pax_screen_cells.
    let packed = unsafe { ((pax_screen_cells as u64 + i * 8) as *u64).read_volatile() }
    (packed >> (sv(S_ALT) * 32)) & 0xffffffff
}

fn put_cell(i: u64, v: u64) {
    // # Safety: as `cell`; only the active screen's half changes.
    let p = unsafe { (pax_screen_cells as u64 + i * 8) as *u64 }
    let old = unsafe { p.read_volatile() }
    let packed = if sv(S_ALT) == 0 { (old & 0xffffffff00000000) | (v & 0xffffffff) }
        else { (old & 0xffffffff) | ((v & 0xffffffff) << 32) }
    unsafe { p.write_volatile(packed) }
}

/// Row `r` of glyph `g` (g < 256, r < 16).
fn font_row(g: u64, r: u64) -> u64 {
    // # Safety: g * 16 + r < 4096, inside boot/font.S's pax_font.
    unsafe { ((pax_font as u64 + g * GH + r) as *u8).read_volatile() as u64 }
}

/// Store the 64-bit `v` at framebuffer address `a` (8-aligned).
fn store(a: u64, v: u64) {
    // # Safety: `a` lies inside the framebuffer kernel/fb mapped (a
    // cell's row, x * 32 bytes from an 8-aligned base, within the grid).
    unsafe { (a as *u64).write_volatile(v) }
}

/// The 0xRRGGBB of palette colour `i`.
fn rgb(i: u64) -> u64 {
    match i {
        0 => 0x000000,
        1 => 0xaa0000,
        2 => 0x00aa00,
        3 => 0xaa5500,
        4 => 0x0000aa,
        5 => 0xaa00aa,
        6 => 0x00aaaa,
        7 => 0xaaaaaa,
        8 => 0x555555,
        9 => 0xff5555,
        10 => 0x55ff55,
        11 => 0xffff55,
        12 => 0x5555ff,
        13 => 0xff55ff,
        14 => 0x55ffff,
        _ => 0xffffff,
    }
}

fn pal(i: u64) -> u64 {
    sv(S_PAL + (i & 15))
}

// --- drawing ---------------------------------------------------------------

/// Draw cell (x, y) from the grid; `cursor` swaps its colours.
fn draw(x: u64, y: u64, cursor: bool) {
    let c = cell(y * sv(S_COLS) + x)
    let g = c & 0xff
    var f = (c >> 8) & 15
    var b = (c >> 12) & 15
    if cursor {
        let t = f
        f = b
        b = t
    }
    let pf = pal(f)
    let pb = pal(b)
    let pitch = sv(S_PITCH)
    let base = sv(S_VA) + y * GH * pitch + x * GW * 4
    var r: u64 = 0
    while r < GH {
        let bits = font_row(g, r)
        let row = base + r * pitch
        var k: u64 = 0
        while k < 4 {
            let lo = if bits & (0x80 >> (2 * k)) != 0 { pf } else { pb }
            let hi = if bits & (0x40 >> (2 * k)) != 0 { pf } else { pb }
            store(row + k * 8, lo | (hi << 32))
            k += 1
        }
        r += 1
    }
}

/// Take the cursor off the screen (redraw its cell plainly).
fn hide() {
    if sv(S_CUR) != 0 {
        draw(sv(S_CURX), sv(S_CURY), false)
        put_sv(S_CUR, 0)
    }
}

/// Put the cursor on the screen at (cx, cy).
fn show() {
    if sv(S_CUR) == 0 && sv(S_VISIBLE) != 0 {
        let x = sv(S_CX)
        let y = sv(S_CY)
        draw(x, y, true)
        put_sv(S_CURX, x)
        put_sv(S_CURY, y)
        put_sv(S_CUR, 1)
    }
}

/// The grid up one row: pixels, then cells; the last row blank.
fn scroll() {
    let cols = sv(S_COLS)
    let rows = sv(S_ROWS)
    let pitch = sv(S_PITCH)
    let va = sv(S_VA)
    let band = GH * pitch // bytes a text row
    // px59: the new row is blank in the current rendition, as the
    // measured VT's (notes/px59/vt2.rows, scroll-background): a space is
    // its background colour alone.
    let c = blank()
    let pb = pal((c >> 12) & 15)
    // # Safety: boot/screen.S's REP MOVSQ/STOSQ inside the framebuffer
    // kernel/fb mapped: rows * band bytes from va, upwards; and inside
    // pax_screen_cells (rows * cols four-byte cells).
    unsafe {
        pax_fb_copy(va, va + band, (rows - 1) * band)
        pax_fb_fill(va + (rows - 1) * band, pb | (pb << 32), band / 8)
    }
    var i: u64 = 0
    while i < (rows - 1) * cols {
        put_cell(i, cell(i + cols)) // never move the inactive screen's half
        i += 1
    }
    i = 0
    while i < cols {
        put_cell((rows - 1) * cols + i, c)
        i += 1
    }
    bump(S_SCROLLS)
}

/// LF: down a row, scrolling on the last.
fn newline() {
    let y = sv(S_CY)
    if y + 1 < sv(S_ROWS) {
        put_sv(S_CY, y + 1)
    } else {
        scroll()
    }
}

/// Write code point `cp` at the cursor and move on.
fn glyph(cp: u64) {
    let g = if cp < 256 { cp } else { QUESTION }
    if sv(S_WRAP) != 0 {
        hide()
        put_sv(S_WRAP, 0)
        put_sv(S_CX, 0)
        newline()
    }
    let x = sv(S_CX)
    let y = sv(S_CY)
    if sv(S_CUR) != 0 && sv(S_CURX) == x && sv(S_CURY) == y {
        put_sv(S_CUR, 0) // the character covers it
    } else {
        hide()
    }
    put_cell(y * sv(S_COLS) + x, (blank() & !0xff) | g)
    draw(x, y, false)
    if x + 1 == sv(S_COLS) {
        put_sv(S_WRAP, 1)
    } else {
        put_sv(S_CX, x + 1)
    }
}

/// A C0 control byte (ESC excepted) or DEL.
fn control(b: u64) {
    if b == 10 {
        hide()
        put_sv(S_WRAP, 0)
        newline()
    } else if b == 13 {
        hide()
        put_sv(S_WRAP, 0)
        put_sv(S_CX, 0)
    } else if b == 8 {
        // px59 (R-px59-5): one column left, a pending wrap cleared too,
        // as the measured VT does (notes/px59/vt2.rows, wrap-BS); px19
        // only cleared the wrap.
        hide()
        put_sv(S_WRAP, 0)
        if sv(S_CX) > 0 {
            put_sv(S_CX, sv(S_CX) - 1)
        }
    } else if b == 9 {
        hide()
        put_sv(S_WRAP, 0)
        var x = (sv(S_CX) / 8 + 1) * 8
        if x >= sv(S_COLS) {
            x = sv(S_COLS) - 1
        }
        put_sv(S_CX, x)
    }
}

// Indexed colours measured through /dev/vcsa1, notes/px59/vt.rows.
// Packed nibbles are PAX palette indices, not VGA attribute ordering.
fn indexed(n: u64, bg: bool) -> u64 {
    let group = n / 16
    let packed = if bg {
        match group {
            0 => 0x7654321076543210,
            1 => 0x0000440000440000,
            2 => 0x2266222244000044,
            3 => 0x4400004400006622,
            4 => 0x2222440000440000,
            5 => 0x0044000066222266,
            6 => 0x4400004400004400,
            7 => 0x0000662222662222,
            8 => 0x0044000044000044,
            9 => 0x6622226622224400,
            10 => 0x1111551111551111,
            11 => 0x3377333355111155,
            12 => 0x5511115511117733,
            13 => 0x3333551111551111,
            14 => 0x0000000077333377,
            _ => 0x7777777777770000,
        }
    } else {
        match group {
            0 => 0xfedcba9876543210,
            1 => 0x6622c44462c44440,
            2 => 0xaae66222e66622c4,
            3 => 0xc44483c44451eeea,
            4 => 0x6222e66622c46622,
            5 => 0x11c45511eeeaaae6,
            6 => 0xe67733c47833c455,
            7 => 0x5511eeeaaae66222,
            8 => 0x33d57733d55511d5,
            9 => 0xfffbbbf77333f777,
            10 => 0x5111d55111d55111,
            11 => 0xbbf77333f77333d5,
            12 => 0xddd999ddd999fffb,
            13 => 0xfbbbfffbbbddd999,
            14 => 0x88888888fffbbbff,
            _ => 0xfffffff777777777,
        }
    }
    (packed >> ((n % 16) * 4)) & 15
}

/// The sixteen CSI parameters fit the original eight state words.
/// Each value is bounded to 9999; the unused upper bits stay zero.
fn ps(i: u64) -> u64 {
    (sv(S_P + i / 2) >> ((i % 2) * 32)) & 0xffffffff
}

fn put_ps(i: u64, v: u64) {
    let w = S_P + i / 2
    let shift = (i % 2) * 32
    put_sv(w, (sv(w) & !(0xffffffff << shift)) | (v << shift))
}

/// Black-box RGB cube: 19683 samples, repeated twice (notes/px70/detail.rows).
/// Channels above half the maximum contribute; intensity boundaries 85/170.
/// Background uses the three high channel bits. Components wrap to a byte.
fn truecolour(red: u64, green: u64, blue: u64, background: bool) -> u64 {
    let r = red & 255
    let g = green & 255
    let b = blue & 255
    if background {
        return (if r >= 128 { 1 } else { 0 }) | (if g >= 128 { 2 } else { 0 }) | (if b >= 128 { 4 } else { 0 })
    }
    var max = r
    if g > max { max = g }
    if b > max { max = b }
    var c = (if r > max / 2 { 1 } else { 0 }) | (if g > max / 2 { 2 } else { 0 }) | (if b > max / 2 { 4 } else { 0 })
    if c == 7 && max <= 85 { c = 8 }
    else if max > 170 { c |= 8 }
    c
}

/// SGR with the `n` parameters read.
fn sgr(n: u64) {
    var k: u64 = 0
    while k < n {
        let p = ps(k)
        if p == 0 {
            put_sv(S_FG, 7)
            put_sv(S_BG, 0)
            put_sv(S_BOLD, 0)
            put_sv(S_INV, 0)
        } else if p == 1 {
            put_sv(S_BOLD, 1)
        } else if p == 2 {
            put_sv(S_BOLD, 2)
        } else if p == 22 {
            put_sv(S_BOLD, 0)
        } else if p == 3 {
            put_sv(S_INV, sv(S_INV) | 2)
        } else if p == 23 {
            put_sv(S_INV, sv(S_INV) & !2)
        } else if p == 4 || p == 21 {
            put_sv(S_INV, sv(S_INV) | 4)
        } else if p == 24 {
            put_sv(S_INV, sv(S_INV) & !4)
        } else if p == 5 {
            put_sv(S_INV, sv(S_INV) | 8)
        } else if p == 25 {
            put_sv(S_INV, sv(S_INV) & !8)
        } else if p == 27 {
            put_sv(S_INV, sv(S_INV) & !1)
        } else if p == 7 {
            put_sv(S_INV, sv(S_INV) | 1)
        } else if p == 38 || p == 48 {
            if k + 2 < n && ps(k + 1) == 5 {
                let index = ps(k + 2)
                if index < 256 { put_sv(if p == 38 { S_FG } else { S_BG }, indexed(index, p == 48)) }
                k += 2
            } else if k + 1 < n && ps(k + 1) == 2 {
                if k + 4 < n {
                    let c = truecolour(ps(k + 2), ps(k + 3), ps(k + 4), p == 48)
                    if p == 38 {
                        put_sv(S_FG, c & 7)
                        put_sv(S_BOLD, c >> 3)
                    } else { put_sv(S_BG, c) }
                }
                k += 4 // even an incomplete RGB group is never read as flags
            } else {
                k = n // incomplete or unsupported colour group
            }
        } else if p >= 100 && p <= 107 {
            put_sv(S_BG, p - 100 + 8) // R-px59-1: bright, unlike the VGA VT
        } else if p >= 30 && p <= 37 {
            put_sv(S_FG, p - 30)
        } else if p == 39 {
            put_sv(S_FG, 7)
        } else if p >= 40 && p <= 47 {
            put_sv(S_BG, p - 40)
        } else if p == 49 {
            put_sv(S_BG, 0)
        } else if p >= 90 && p <= 97 {
            put_sv(S_FG, p - 90 + 8)
        }
        k += 1
    }
}

/// A blank with the current rendition, as ED/EL on the measured VT.
fn blank() -> u64 {
    let flags = sv(S_INV)
    var f = sv(S_FG)
    if flags & 2 != 0 { f = 2 }
    else if flags & 4 != 0 { f = 6 }
    else if sv(S_BOLD) == 2 { f = 8 }
    var b = sv(S_BG)
    if flags & 1 != 0 {
        // The VT swaps colour bits, not the intensity/blink bits.
        // PAX's explicitly retained bright backgrounds keep their own bit.
        let t = f
        f = (b & 7) | (f & 8)
        b = (t & 7) | (b & 8)
    }
    if sv(S_BOLD) == 1 { f |= 8 }
    32 | (f << 8) | (b << 12) | ((flags & 8) << 13)
}

fn erase(first: u64, end: u64) {
    hide()
    put_sv(S_WRAP, 0)
    let c = blank()
    var i = first
    while i < end {
        put_cell(i, c)
        draw(i % sv(S_COLS), i / sv(S_COLS), false)
        i += 1
    }
}

/// Cursor controls measured on the Linux VT (notes/px59/vt-first.rows).
fn move_to(x: u64, y: u64) {
    hide()
    put_sv(S_WRAP, 0)
    put_sv(S_CX, if x < sv(S_COLS) { x } else { sv(S_COLS) - 1 })
    put_sv(S_CY, if y < sv(S_ROWS) { y } else { sv(S_ROWS) - 1 })
}

fn param(i: u64) -> u64 {
    let p = ps(i)
    if p == 0 { 1 } else { p }
}

fn dispatch(b: u64) {
    let x = sv(S_CX)
    let y = sv(S_CY)
    let n = param(0)
    if b == 109 {
        sgr(sv(S_PI) + 1)
    } else if b == 74 || b == 75 { // ED, EL (inclusive at the cursor)
        let p = ps(0)
        let pos = y * sv(S_COLS) + x
        let first = if b == 74 { 0 } else { y * sv(S_COLS) }
        let end = if b == 74 { sv(S_COLS) * sv(S_ROWS) } else { (y + 1) * sv(S_COLS) }
        if p == 0 { erase(pos, end) }
        else if p == 1 { erase(first, pos + 1) }
        else if p == 2 { erase(first, end) }
    } else if b == 72 || b == 102 { // CUP, HVP
        move_to(param(1) - 1, n - 1)
    } else if b == 65 { // CUU
        move_to(x, if n > y { 0 } else { y - n })
    } else if b == 66 { // CUD
        move_to(x, y + n)
    } else if b == 67 { // CUF
        move_to(x + n, y)
    } else if b == 68 { // CUB
        move_to(if n > x { 0 } else { x - n }, y)
    } else if b == 71 || b == 96 { // CHA/HPA
        move_to(n - 1, y)
    } else if b == 100 { // VPA
        move_to(x, n - 1)
    } else if b == 69 { // CNL
        move_to(0, y + n)
    } else if b == 70 { // CPL
        move_to(0, if n > y { 0 } else { y - n })
    } else if b == 99 && ps(0) == 0 && sv(S_PI) == 0 { // DA1, CSI c and CSI 0 c
        answer_da1()
    } else if b == 110 && ps(0) == 6 && sv(S_PI) == 0 { // DSR 6: the cursor's position
        answer_cpr()
    } else if b == 110 && ps(0) == 5 && sv(S_PI) == 0 { // DSR 5: `ESC [ 0 n`, no malfunction
        answer_byte(27)
        answer_byte(91)
        answer_byte(48)
        answer_byte(110)
    }
}

/// Entry clears the alternate half but keeps the cursor, as the measured VT.
fn alternate(on: bool) {
    if (sv(S_ALT) != 0) == on { return }
    hide()
    if on {
        save_to(S_MAIN_POS, S_MAIN_ATTR)
        put_sv(S_ALT, 1)
        erase(0, sv(S_COLS) * sv(S_ROWS))
    } else {
        put_sv(S_ALT, 0)
        restore_from(S_MAIN_POS, S_MAIN_ATTR)
        var i: u64 = 0
        while i < sv(S_COLS) * sv(S_ROWS) {
            draw(i % sv(S_COLS), i / sv(S_COLS), false)
            i += 1
        }
    }
}

/// `CSI ? Pm h` and `CSI ? Pm l`: 1049 (the alternate screen) and 25
/// (DECTCEM, the cursor shown or not); every other mode is read and
/// ignored, as the measured VT ignores paste, mouse, focus and sync.
fn private_mode(b: u64) {
    if b == 110 && ps(0) == 6 && sv(S_PI) == 0 {
        answer_cpr() // `CSI ? 6 n`: the measured VT answers it as `CSI 6 n`
        return
    }
    if b != 104 && b != 108 { return }
    var i: u64 = 0
    while i <= sv(S_PI) {
        let m = ps(i)
        if m == 1049 {
            alternate(b == 104)
        } else if m == 25 {
            if b == 108 {
                hide()
            }
            put_sv(S_VISIBLE, if b == 104 { 1 } else { 0 })
        }
        i += 1
    }
}

/// One byte inside a CSI sequence.
fn csi(b: u64) {
    if b >= 48 && b <= 57 {
        let i = sv(S_PI)
        let v = ps(i) * 10 + (b - 48)
        put_ps(i, if v > 9999 { 9999 } else { v })
    } else if b == 59 || b == 58 {
        if sv(S_PI) < 15 {
            put_sv(S_PI, sv(S_PI) + 1)
        } else {
            put_sv(S_PRIV, 1) // the seventeenth rejects the whole CSI, as measured on the VT
        }
    } else if b == 63 && sv(S_PRIV) == 0 && sv(S_PI) == 0 && ps(0) == 0 {
        put_sv(S_PRIV, 63)
    } else if b == 32 && sv(S_PRIV) == 0 {
        put_sv(S_PRIV, 32) // one space intermediate: DECSCUSR's, if `q` ends it
    } else if (b >= 0x3c && b <= 0x3f) || (b >= 0x20 && b <= 0x2f) {
        put_sv(S_PRIV, 1)
    } else if b >= 0x40 && b <= 0x7e {
        put_sv(S_ESC, 0)
        if sv(S_PRIV) == 0 {
            dispatch(b)
        } else if sv(S_PRIV) == 63 {
            private_mode(b)
        } else if sv(S_PRIV) == 32 && b == 113 && sv(S_PI) == 0 && ps(0) <= 6 {
            put_sv(S_SHAPE, ps(0)) // DECSCUSR: recorded; PAX draws a block
        }
    } else {
        put_sv(S_ESC, 0) // 0x80 and above: the sequence ends, the byte is dropped
    }
}

/// The cursor and the rendition into words `pos` and `attr` (DECSC,
/// ?1049h).
fn save_to(pos: u64, attr: u64) {
    put_sv(pos, sv(S_CX) | (sv(S_CY) << 16))
    put_sv(attr, sv(S_FG) | (sv(S_BG) << 4) | (sv(S_BOLD) << 8) | (sv(S_INV) << 10))
}

/// And back (DECRC, ?1049l): the cursor clamped to the grid, the wrap
/// cleared.
fn restore_from(pos: u64, attr: u64) {
    let p = sv(pos)
    let a = sv(attr)
    move_to(p & 0xffff, p >> 16)
    put_sv(S_FG, a & 15)
    put_sv(S_BG, (a >> 4) & 15)
    put_sv(S_BOLD, (a >> 8) & 3)
    put_sv(S_INV, (a >> 10) & 15)
}

fn save_cursor() {
    save_to(S_SAVE, S_SAVE_ATTR)
}

fn restore_cursor() {
    restore_from(S_SAVE, S_SAVE_ATTR)
}

/// One byte through the terminal.
fn feed(b: u64) {
    bump(S_BYTES)
    var st = sv(S_ESC)
    if st == 3 { // an OSC string's first byte
        if b == 80 { // `P`: seven hex digits, the VT's palette setting (consumed, not applied)
            put_sv(S_ESC, 4)
            put_sv(S_PI, 7)
            return
        }
        if b == 82 { // `R`: the VT's palette reset, nothing more (consumed)
            put_sv(S_ESC, 0)
            return
        }
        put_sv(S_ESC, 5)
        st = 5
    }
    if st == 4 { // OSC P's digits
        let left = sv(S_PI) - 1
        put_sv(S_PI, left)
        if left == 0 {
            put_sv(S_ESC, 0)
        }
        return
    }
    if st == 5 { // an OSC string, to BEL or to any ESC (ST's, or another sequence's)
        if b == 7 {
            put_sv(S_ESC, 0)
        } else if b == 27 {
            put_sv(S_ESC, 1) // the next byte is an escape's second, as the VT reads it
        }
        return
    }
    if b < 32 || b == 127 {
        if sv(S_UN) != 0 {
            put_sv(S_UN, 0)
            glyph(QUESTION) // a sequence cut short
        }
        if b == 27 {
            put_sv(S_ESC, 1)
            return
        }
        put_sv(S_ESC, 0)
        control(b)
        return
    }
    let esc = sv(S_ESC)
    if esc == 1 {
        if b == 91 {
            put_sv(S_ESC, 2)
            put_sv(S_PI, 0)
            put_sv(S_PRIV, 0)
            var i: u64 = 0
            while i < 8 {
                put_sv(S_P + i, 0)
                i += 1
            }
        } else if b == 55 || b == 56 {
            put_sv(S_ESC, 0)
            if b == 55 { save_cursor() } else { restore_cursor() }
        } else if b == 93 {
            put_sv(S_ESC, 3)
        } else if b == 90 {
            put_sv(S_ESC, 0)
            answer_da1() // DECID, `ESC Z`: DA1's answer (measured)
        } else {
            put_sv(S_ESC, 0)
        }
        return
    }
    if esc == 2 {
        csi(b)
        return
    }
    if sv(S_UN) != 0 {
        if b & 0xc0 == 0x80 {
            let cp = (sv(S_UCP) << 6) | (b & 0x3f)
            put_sv(S_UCP, cp)
            put_sv(S_UN, sv(S_UN) - 1)
            if sv(S_UN) == 0 {
                glyph(cp)
            }
            return
        }
        put_sv(S_UN, 0)
        glyph(QUESTION) // a sequence cut short; b is read afresh
    }
    if b < 0x80 {
        glyph(b)
    } else if b & 0xe0 == 0xc0 {
        put_sv(S_UN, 1)
        put_sv(S_UCP, b & 0x1f)
    } else if b & 0xf0 == 0xe0 {
        put_sv(S_UN, 2)
        put_sv(S_UCP, b & 0x0f)
    } else if b & 0xf8 == 0xf0 {
        put_sv(S_UN, 3)
        put_sv(S_UCP, b & 0x07)
    } else {
        glyph(QUESTION) // a stray continuation byte, or 0xf8 and above
    }
}

// --- the interface ---------------------------------------------------------

/// One byte the console wrote (kernel/serial's `put`): drawn when the
/// screen is attached, kept for the replay before.
pub fn put(b: u8) {
    if sv(S_ON) == 0 {
        let n = sv(S_EARLY)
        if n < EARLY {
            // # Safety: n < 16384, inside boot/screen.S's pax_screen_early.
            unsafe { ((pax_screen_early as u64 + n) as *u8).write_volatile(b) }
            put_sv(S_EARLY, n + 1)
        } else {
            bump(S_LOST)
        }
        return
    }
    // # Safety: sched.S's PUSHFQ/POP/CLI; restored below.
    let flags = unsafe { pax_irq_save() }
    if sv(S_BUSY) == 0 {
        put_sv(S_BUSY, 1)
        feed(b as u64)
        show()
        put_sv(S_BUSY, 0)
    }
    // # Safety: sched.S's STI when `flags` had IF.
    unsafe { pax_irq_restore(flags) }
}

/// Attach the screen to a framebuffer kernel/fb has mapped at `va`:
/// `w` x `h` pixels of 32 bits, `pitch` bytes a row, red, green and
/// blue 8 bits each at bit `rs`, `gs`, `bs`. Clears it to the default
/// background, replays the early buffer, draws the cursor. False (and
/// nothing drawn) when not even one cell fits.
pub fn attach(va: u64, w: u64, h: u64, pitch: u64, rs: u64, gs: u64, bs: u64) -> bool {
    var cols = w / GW
    var rows = h / GH
    if cols == 0 || rows == 0 || va % 8 != 0 || pitch % 8 != 0 {
        return false
    }
    if cols > MAX_COLS {
        cols = MAX_COLS
    }
    if rows > MAX_ROWS {
        rows = MAX_ROWS
    }
    // # Safety: as `put`.
    let flags = unsafe { pax_irq_save() }
    put_sv(S_BUSY, 1)
    put_sv(S_VA, va)
    put_sv(S_W, w)
    put_sv(S_H, h)
    put_sv(S_PITCH, pitch)
    put_sv(S_COLS, cols)
    put_sv(S_ROWS, rows)
    var i: u64 = 0
    while i < 16 {
        let c = rgb(i)
        put_sv(S_PAL + i, (((c >> 16) & 0xff) << rs) | (((c >> 8) & 0xff) << gs) | ((c & 0xff) << bs))
        i += 1
    }
    put_sv(S_CX, 0)
    put_sv(S_CY, 0)
    put_sv(S_WRAP, 0)
    put_sv(S_FG, 7)
    put_sv(S_BG, 0)
    put_sv(S_BOLD, 0)
    put_sv(S_INV, 0)
    put_sv(S_ESC, 0)
    put_sv(S_UN, 0)
    put_sv(S_CUR, 0)
    put_sv(S_ALT, 0)
    put_sv(S_VISIBLE, 1)
    put_sv(S_SHAPE, 0)
    put_sv(S_REPLY, 0)
    save_cursor()
    let p0 = pal(0)
    // # Safety: boot/screen.S's REP STOSQ over the whole framebuffer
    // (pitch * h bytes from va, a multiple of 8: pitch % 8 == 0),
    // mapped by kernel/fb.
    unsafe { pax_fb_fill(va, p0 | (p0 << 32), pitch * h / 8) }
    i = 0
    while i < cols * rows {
        put_cell(i, BLANK)
        i += 1
    }
    put_sv(S_ON, 1)
    let n = sv(S_EARLY)
    var k: u64 = 0
    while k < n {
        // # Safety: k < n <= 16384, inside pax_screen_early.
        let b = unsafe { ((pax_screen_early as u64 + k) as *u8).read_volatile() }
        feed(b as u64)
        k += 1
    }
    put_sv(S_REPLAYED, n)
    show()
    put_sv(S_BUSY, 0)
    // # Safety: as `put`.
    unsafe { pax_irq_restore(flags) }
    true
}

/// px59: the next byte of what the screen answers a program's query
/// (DA1, the cursor-position report), as a Linux VT puts its answers in
/// its input; 256 when there is none. kernel/console takes these after
/// a write and decides whether they are typed (`answered`).
pub fn answer() -> u64 {
    // # Safety: as `put`.
    let flags = unsafe { pax_irq_save() }
    let r = sv(S_REPLY)
    var b: u64 = 256
    if r >> 8 != 0 {
        b = rq_byte(r & 0xff)
        put_sv(S_REPLY, (((r & 0xff) + 1) % RQ_BYTES) | (((r >> 8) - 1) << 8))
    }
    // # Safety: as `put`.
    unsafe { pax_irq_restore(flags) }
    b
}

/// px59: whether the cursor is shown (DECTCEM) and DECSCUSR's last
/// shape, `visible | shape << 1`, for kernel/screen's report.
pub fn cursor_state() -> u64 {
    sv(S_VISIBLE) | (sv(S_SHAPE) << 1)
}

/// Whether the screen is attached (the console is drawn).
pub fn on() -> bool {
    sv(S_ON) != 0
}

/// The grid's columns (0 before `attach`).
pub fn cols() -> u64 {
    sv(S_COLS)
}

/// The grid's rows (0 before `attach`).
pub fn rows() -> u64 {
    sv(S_ROWS)
}

/// Scrolls so far.
pub fn scrolls() -> u64 {
    sv(S_SCROLLS)
}

/// Bytes the early buffer kept before `attach` (the replay).
pub fn replayed() -> u64 {
    sv(S_REPLAYED)
}

/// Bytes written before `attach` that the early buffer had no room for.
pub fn lost() -> u64 {
    sv(S_LOST)
}

/// Bytes fed to the terminal (the replay included).
pub fn bytes() -> u64 {
    sv(S_BYTES)
}
