//! paging — the kernel's own x86-64 four-level paging structures (px03,
//! M-PX2's second piece).
//!
//! Limine enters the kernel on its own tables (in bootloader-reclaimable
//! memory). `start` builds PAX's from frames px02's allocator hands out,
//! and switches CR3 to them:
//!
//! - the kernel image, one permission per section, 4 KiB pages: text
//!   read-execute, rodata read-only no-execute, data and bss read-write
//!   no-execute (W^X: no page is both writable and executable); the
//!   bounds are boot/kernel.ld's, returned by limine.S (wolf-lang#529);
//! - the HHDM (Limine's offset, kept, because the frame allocator's
//!   state, every frame it hands out, Limine's responses and the stack
//!   are reached through it), read-write no-execute, over the memory
//!   map's usable, bootloader-reclaimable, ACPI reclaimable, ACPI NVS
//!   and reserved-mapped entries, merged into runs and mapped with
//!   2 MiB pages where a whole aligned 2 MiB lies inside a run, 4 KiB
//!   pages at the edges. Two types Limine maps there are left out: the
//!   image (executable and modules: an alias of text through the HHDM
//!   would be writable, which defeats W^X) and the framebuffer (it wants
//!   write-combining, a PAT choice for the lane that draws).
//!
//! Nothing is mapped in the lower half and nothing is user-accessible.
//! Upper-level entries are present and writable, supervisor, and carry
//! no NX: the leaf alone decides (the access rights of a translation
//! are the most restrictive of every level's, Intel SDM vol. 3A §4.6.1,
//! AMD64 APM vol. 2 §5.6). No entry is global (G): there is one address
//! space, and Limine leaves CR4.PGE clear (base revision 5 and later).
//!
//! The structures (Intel SDM vol. 3A §4.5, "4-Level Paging and 5-Level
//! Paging", its entry-format tables; AMD64 APM vol. 2 §5.3,
//! "Long-Mode Page Translation", and §5.4, "Page-Translation-Table Entry
//! Fields"): a 4 KiB table of 512 eight-byte entries at each level,
//! indexed by virtual-address bits 47:39 (PML4), 38:30 (PDPT), 29:21
//! (PD) and 20:12 (PT). An entry's bits:
//!
//!     0 P present          1 RW writable        2 US user
//!     3 PWT write-through  4 PCD cache-disable  5 A accessed
//!     6 D dirty (a leaf)   7 PS a 2 MiB page (in a PD entry)
//!     8 G global (a leaf)  51:12 the next table's or the page's
//!     63 XD/NX no-execute  physical address (51:21 for a 2 MiB page)
//!
//! NX is honoured only with IA32_EFER.NXE set (SDM vol. 3A §4.1.3, APM
//! vol. 2 §3.1.7); Limine sets it when the CPU has the bit, and
//! `switch_to` sets it itself otherwise. A supervisor write to a
//! read-only page faults only with CR0.WP set (SDM vol. 3A §4.6.1);
//! Limine sets it, and `switch_to` refuses to switch without it. A MOV to
//! CR3 flushes every non-global TLB entry; changing one entry of the
//! live structures needs INVLPG for its page (SDM vol. 3A §4.10.4.1,
//! APM vol. 2 §5.5), which `unmap` issues.
//!
//! Every function takes `st`, the frame allocator's state: page tables
//! come from it (each zeroed here: frames come back unzeroed) and are
//! reached through its HHDM offset. wolf has no module state yet
//! (wolf-lang#529, KWC kw09), so `st` and the PML4's physical address
//! are threaded through every call. Table entries are read and written
//! with `read_volatile`/`write_volatile`: the processor's page walker
//! reads them behind the compiler's back.
//!
//! Flag values are literals named where they are used: wolf refuses a
//! module-level `const` on both compiling tiers (wolf-lang#560).
//!
//! Written from the Intel 64 and IA-32 SDM vol. 3A ch. 4 (§4.1.3, §4.5,
//! §4.6, §4.10.4) and the AMD64 APM vol. 2 ch. 5 (§5.3, §5.4, §5.5, §5.6)
//! and §3.1.7, and Limine's PROTOCOL.md (limine-protocol 3a0526b7: the
//! x86-64 machine state at entry, the memory layout at entry and what
//! the HHDM maps per base revision). No Linux source; no other kernel's
//! source.

use boot_info
use frames
use log
use panic

extern "c" fn pax_cr0() -> u64
extern "c" fn pax_cr3() -> u64
extern "c" fn pax_cr4() -> u64
extern "c" fn pax_set_cr3(v: u64)
extern "c" fn pax_efer() -> u64
extern "c" fn pax_set_efer(v: u64)
extern "c" fn pax_invlpg(va: u64)
extern "c" fn pax_cpuid_nx() -> u64
extern "c" fn pax_rsp() -> u64
extern "c" fn pax_image_bounds(which: int) -> u64

/// Why `map`, `map_large`, `unmap` or `translate` refused.
pub error MapError = {out_of_memory, misaligned, not_canonical, already_mapped, large_page, not_mapped}

// --- flags -----------------------------------------------------------------

/// P: present.
pub fn present() -> u64 {
    1
}

/// RW: writable.
pub fn writable() -> u64 {
    2
}

/// XD/NX: no-execute (bit 63).
pub fn no_exec() -> u64 {
    let one: u64 = 1
    one << 63
}

/// Bits 51:12 of an entry: the next table's (or a 4 KiB page's) address.
fn addr_mask() -> u64 {
    0x000ffffffffff000
}

// --- the registers ---------------------------------------------------------

/// CR3 now (the physical address of the live PML4, in bits 51:12).
pub fn cr3() -> u64 {
    // # Safety: cpu.S's MOV from CR3; reads nothing else.
    unsafe { pax_cr3() }
}

/// CR0 now.
pub fn cr0() -> u64 {
    // # Safety: cpu.S's MOV from CR0.
    unsafe { pax_cr0() }
}

/// CR4 now.
pub fn cr4() -> u64 {
    // # Safety: cpu.S's MOV from CR4.
    unsafe { pax_cr4() }
}

/// IA32_EFER now.
pub fn efer() -> u64 {
    // # Safety: cpu.S's RDMSR of IA32_EFER, an MSR every x86-64 CPU has.
    unsafe { pax_efer() }
}

/// The image's section bounds (limine.S's numbering): 2/3 text, 4/5
/// rodata, 6/7 data and bss, each a page boundary.
pub fn bound(which: int) -> u64 {
    // # Safety: limine.S returns a link-time address and reads nothing.
    unsafe { pax_image_bounds(which) }
}

// --- the structures --------------------------------------------------------

/// Entry `i` of the table at physical `t`, through the HHDM.
fn entry(st: u64, t: u64, i: u64) -> u64 {
    // # Safety: `t` is a page table this module allocated (or the live
    // PML4), a usable frame mapped in the HHDM; i < 512 keeps it inside.
    unsafe { ((frames.hhdm(st) + t + i * 8) as *u64).read_volatile() }
}

/// Write entry `i` of the table at physical `t`.
fn set_entry(st: u64, t: u64, i: u64, v: u64) {
    // # Safety: as `entry`.
    unsafe { ((frames.hhdm(st) + t + i * 8) as *u64).write_volatile(v) }
}

/// A fresh frame, zeroed, for a table; 0 when the allocator is empty
/// (frame 0 is never handed out: px02 withholds the first MiB).
fn table_frame(st: u64) -> u64 {
    let t = frames.alloc(st) else 0
    if t == 0 {
        return 0
    }
    var i: u64 = 0
    while i < 512 {
        set_entry(st, t, i, 0)
        i += 1
    }
    t
}

/// Index of `va` at `level` (4 PML4, 3 PDPT, 2 PD, 1 PT).
fn index(va: u64, level: u64) -> u64 {
    (va >> (12 + 9 * (level - 1))) & 511
}

/// Whether `va` is canonical (bits 63:47 all equal) for 4-level paging.
fn canonical(va: u64) -> bool {
    let top = va >> 47
    top == 0 || top == 0x1ffff
}

/// The table entry `i` of table `t` points to, made (zeroed, present,
/// writable) when absent. 0 when the allocator is empty; 1 when the
/// entry is a 2 MiB page, not a table (no table address is 1).
fn descend(st: u64, t: u64, i: u64) -> u64 {
    let e = entry(st, t, i)
    if e & 1 == 0 {
        let n = table_frame(st)
        if n == 0 {
            return 0
        }
        set_entry(st, t, i, n | 3) // P, RW; supervisor; the leaf decides
        return n
    }
    if e & 128 != 0 {
        return 1
    }
    e & addr_mask()
}

/// The PD that maps `va` in the structures at `pml4`, made as needed;
/// 0 out of frames, 1 when the PDPT entry is a 1 GiB page.
fn pd_of(st: u64, pml4: u64, va: u64) -> u64 {
    let pdpt = descend(st, pml4, index(va, 4))
    if pdpt <= 1 {
        return pdpt
    }
    descend(st, pdpt, index(va, 3))
}

/// Map the 4 KiB page at `va` to the frame at `pa` with `flags` (P is
/// added) in the structures whose PML4 is at physical `pml4`. Returns
/// how many table frames it allocated (0..3). Rows: `misaligned` (va or
/// pa not 4 KiB aligned), `not_canonical`, `out_of_memory` (a table
/// frame), `large_page` (a 2 MiB page already covers va),
/// `already_mapped`.
pub fn map(st: u64, pml4: u64, va: u64, pa: u64, flags: u64) -> u64 ! MapError {
    if va % 4096 != 0 || pa % 4096 != 0 {
        return misaligned
    }
    if !canonical(va) {
        return not_canonical
    }
    let before = frames.free_count(st)
    let pd = pd_of(st, pml4, va)
    if pd == 0 {
        return out_of_memory
    }
    if pd == 1 {
        return large_page
    }
    let pt = descend(st, pd, index(va, 2))
    if pt == 0 {
        return out_of_memory
    }
    if pt == 1 {
        return large_page
    }
    let i = index(va, 1)
    if entry(st, pt, i) & 1 != 0 {
        return already_mapped
    }
    set_entry(st, pt, i, pa | flags | 1)
    before - frames.free_count(st)
}

/// Map the 2 MiB page at `va` to `pa` (both 2 MiB aligned) with `flags`
/// (P and PS are added). Returns the table frames allocated (0..2).
/// Rows as `map`; `already_mapped` also when a page table is there.
pub fn map_large(st: u64, pml4: u64, va: u64, pa: u64, flags: u64) -> u64 ! MapError {
    if va % 2097152 != 0 || pa % 2097152 != 0 {
        return misaligned
    }
    if !canonical(va) {
        return not_canonical
    }
    let before = frames.free_count(st)
    let pd = pd_of(st, pml4, va)
    if pd == 0 {
        return out_of_memory
    }
    if pd == 1 {
        return large_page
    }
    let i = index(va, 2)
    if entry(st, pd, i) & 1 != 0 {
        return already_mapped
    }
    set_entry(st, pd, i, pa | flags | 129)
    before - frames.free_count(st)
}

/// The physical address `va` translates to in the structures at
/// `pml4`, walked in software (4 KiB and 2 MiB pages). Row `not_mapped`.
pub fn translate(st: u64, pml4: u64, va: u64) -> u64 ! MapError {
    if !canonical(va) {
        return not_canonical
    }
    let e4 = entry(st, pml4, index(va, 4))
    if e4 & 1 == 0 {
        return not_mapped
    }
    let e3 = entry(st, e4 & addr_mask(), index(va, 3))
    if e3 & 1 == 0 {
        return not_mapped
    }
    if e3 & 128 != 0 {
        return large_page // a 1 GiB page: PAX makes none
    }
    let e2 = entry(st, e3 & addr_mask(), index(va, 2))
    if e2 & 1 == 0 {
        return not_mapped
    }
    if e2 & 128 != 0 {
        return (e2 & 0x000fffffffe00000) + va % 2097152
    }
    let e1 = entry(st, e2 & addr_mask(), index(va, 1))
    if e1 & 1 == 0 {
        return not_mapped
    }
    (e1 & addr_mask()) + va % 4096
}

/// Unmap the 4 KiB page at `va`: clear its entry and, when `pml4` is
/// the live structure, INVLPG it, so no stale translation survives.
/// Returns the frame it mapped (the caller's to free). Rows:
/// `misaligned`, `not_canonical`, `not_mapped`, `large_page` (a 2 MiB
/// page covers va; PAX never splits one). Tables left empty stay.
pub fn unmap(st: u64, pml4: u64, va: u64) -> u64 ! MapError {
    if va % 4096 != 0 {
        return misaligned
    }
    if !canonical(va) {
        return not_canonical
    }
    let e4 = entry(st, pml4, index(va, 4))
    if e4 & 1 == 0 {
        return not_mapped
    }
    let e3 = entry(st, e4 & addr_mask(), index(va, 3))
    if e3 & 1 == 0 {
        return not_mapped
    }
    if e3 & 128 != 0 {
        return large_page
    }
    let e2 = entry(st, e3 & addr_mask(), index(va, 2))
    if e2 & 1 == 0 {
        return not_mapped
    }
    if e2 & 128 != 0 {
        return large_page
    }
    let pt = e2 & addr_mask()
    let i = index(va, 1)
    let e1 = entry(st, pt, i)
    if e1 & 1 == 0 {
        return not_mapped
    }
    set_entry(st, pt, i, 0)
    if cr3() & addr_mask() == pml4 {
        // # Safety: cpu.S's INVLPG; it only drops TLB entries.
        unsafe { pax_invlpg(va) }
    }
    e1 & addr_mask()
}

// --- the kernel's structures -----------------------------------------------

/// `map` or a named panic (the kernel's own structures cannot be half
/// built).
fn must_map(st: u64, pml4: u64, va: u64, pa: u64, flags: u64) {
    let r = map(st, pml4, va, pa, flags) else 9
    if r == 9 {
        panic.fail("paging: cannot map the kernel's page at", va)
    }
}

/// `map_large` or a named panic.
fn must_map_large(st: u64, pml4: u64, va: u64, pa: u64, flags: u64) {
    let r = map_large(st, pml4, va, pa, flags) else 9
    if r == 9 {
        panic.fail("paging: cannot map the kernel's 2 MiB page at", va)
    }
}

/// Map the image's pages [lo, hi) (virtual) at `flags`.
fn map_section(st: u64, pml4: u64, lo: u64, hi: u64, flags: u64) {
    let virt = boot_info.image_virt()
    let phys = boot_info.image_phys()
    var va = lo
    while va < hi {
        must_map(st, pml4, va, va - virt + phys, flags)
        va += 4096
    }
}

/// Map physical [lo, hi) (4 KiB aligned) in the HHDM, read-write
/// no-execute: 2 MiB pages where a whole aligned 2 MiB lies inside,
/// 4 KiB pages elsewhere.
fn map_run(st: u64, pml4: u64, lo: u64, hi: u64) {
    let hhdm = frames.hhdm(st)
    let rw_nx = no_exec() | 2
    var a = lo
    while a < hi {
        if a % 2097152 == 0 && a + 2097152 <= hi {
            must_map_large(st, pml4, hhdm + a, a, rw_nx)
            a += 2097152
        } else {
            must_map(st, pml4, hhdm + a, a, rw_nx)
            a += 4096
        }
    }
}

/// Whether a memory-map type is mapped in PAX's HHDM: usable (0), ACPI
/// reclaimable (2), ACPI NVS (3), bootloader reclaimable (5), reserved
/// mapped (8). Not reserved (1), bad (4), executable and modules (6),
/// framebuffer (7).
fn in_hhdm(t: u64) -> bool {
    t == 0 || t == 2 || t == 3 || t == 5 || t == 8
}

/// Build PAX's structures: a zeroed PML4, the image with W^X, the HHDM.
/// Returns the PML4's physical address. Panics by name when the
/// allocator runs dry or the image is not where the linker put it.
pub fn build(st: u64) -> u64 {
    let pml4 = table_frame(st)
    if pml4 == 0 {
        panic.fail("paging: no frame for the PML4", 0)
        return 0
    }
    if boot_info.image_virt() != bound(0) || boot_info.image_phys() == 0 {
        panic.fail("paging: the image is not at its link address", boot_info.image_virt())
        return 0
    }
    // The image, W^X (each bound a page boundary, boot/kernel.ld).
    map_section(st, pml4, bound(2), bound(3), 0) // text: R-X
    map_section(st, pml4, bound(4), bound(5), no_exec()) // rodata: R--
    map_section(st, pml4, bound(6), bound(7), no_exec() | 2) // data, bss: RW-
    // The HHDM: the map's entries of the types above, merged into runs
    // (the map is sorted and its entries never overlap; an entry that is
    // not 4 KiB aligned is rounded out to whole pages, as Limine does).
    let n = boot_info.memmap_count()
    var have = false
    var rl: u64 = 0
    var rh: u64 = 0
    var i = 0
    while i < n {
        if in_hhdm(boot_info.memmap_type(i)) {
            let b = boot_info.memmap_base(i)
            let lo = b - b % 4096
            let e = b + boot_info.memmap_length(i)
            let hi = (e + 4095) - (e + 4095) % 4096
            if have && lo <= rh {
                if hi > rh {
                    rh = hi
                }
            } else {
                if have {
                    map_run(st, pml4, rl, rh)
                }
                rl = lo
                rh = hi
                have = true
            }
        }
        i += 1
    }
    if have {
        map_run(st, pml4, rl, rh)
    }
    pml4
}

/// Switch to the structures at `pml4`: NX on (EFER.NXE; panic without
/// the CPU's XD bit), CR0.WP required (a supervisor write to a
/// read-only page must fault), CR4.PGE required clear (no global entry
/// may outlive the switch), the stack required mapped in them; then
/// MOV to CR3.
pub fn switch_to(st: u64, pml4: u64) {
    let e = efer()
    if e & 2048 == 0 {
        // # Safety: cpu.S's CPUID.
        if unsafe { pax_cpuid_nx() } == 0 {
            panic.fail("paging: the CPU has no execute-disable bit; EFER", e)
            return
        }
        // # Safety: cpu.S's WRMSR of IA32_EFER, NXE added to its bits.
        unsafe { pax_set_efer(e | 2048) }
    }
    if cr0() & 65536 == 0 {
        panic.fail("paging: CR0.WP is clear; CR0", cr0())
        return
    }
    if cr4() & 128 != 0 {
        panic.fail("paging: CR4.PGE is set; CR4", cr4())
        return
    }
    // # Safety: cpu.S returns the caller's stack pointer; reads nothing.
    let sp = unsafe { pax_rsp() }
    let probe = translate(st, pml4, sp - sp % 4096) else 0
    if probe == 0 {
        panic.fail("paging: the stack is not mapped in the new structures", sp)
        return
    }
    // # Safety: `pml4` maps the image (so this code), the HHDM (the
    // stack, the allocator, Limine's responses) and nothing the kernel
    // still needs is outside them; cpu.S's MOV to CR3.
    unsafe { pax_set_cr3(pml4) }
}

/// Build PAX's structures from `st`'s frames and switch to them.
/// Returns the PML4's physical address.
pub fn start(st: u64) -> u64 {
    let pml4 = build(st)
    switch_to(st, pml4)
    pml4
}

/// Write the switch's line:
/// `paging: limine cr3 0x<A>, pax cr3 0x<B>, <P> table frames`, where
/// A is CR3 before `start`, B is CR3 now and P the frames `start` took
/// (`free_before`, the allocator's free count before it).
pub fn report(st: u64, limine_cr3: u64, free_before: u64) {
    log.put("paging: limine cr3 ")
    log.hex(limine_cr3)
    log.put(", pax cr3 ")
    log.hex(cr3())
    log.put(", ")
    log.dec((free_before - frames.free_count(st)) as int)
    log.put(" table frames")
    log.end()
}
