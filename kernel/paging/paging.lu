//! paging — the kernel's own x86-64 four-level paging structures (px03,
//! M-PX2's second piece).
//!
//! Limine enters the kernel on its own tables (in bootloader-reclaimable
//! memory). `start` builds PAX's from frames px02's allocator hands out,
//! and switches CR3 to them:
//!
//! - the kernel image, one permission per section, 4 KiB pages: text
//!   read-execute, rodata read-only no-execute, data and bss read-write
//!   no-execute (W^X: no page is both writable and executable); the
//!   bounds are boot/kernel.ld's symbols, named with `extern "c" let`
//!   (kw10; limine.S returned them until wolf-lang kw09);
//! - the HHDM (Limine's offset, kept, because the frame allocator's
//!   state, every frame it hands out, Limine's responses and the stack
//!   are reached through it), read-write no-execute, over the memory
//!   map's usable, bootloader-reclaimable, ACPI reclaimable, ACPI NVS
//!   and reserved-mapped entries, merged into runs and mapped with
//!   2 MiB pages where a whole aligned 2 MiB lies inside a run, 4 KiB
//!   pages at the edges. Two types Limine maps there are left out: the
//!   image (executable and modules: an alias of text through the HHDM
//!   would be writable, which defeats W^X) and the framebuffer (it wants
//!   write-combining, a PAT choice for the lane that draws).
//! - px10: each Limine module's own pages (the initramfs), read-only
//!   no-execute at their HHDM addresses: type 6 holds modules as well
//!   as the image, and a module is data the kernel only reads.
//!
//! Nothing is mapped in the lower half and nothing is user-accessible
//! in the kernel's own structures. px09 adds the user half: a process's
//! PML4 (`new_space`) is a fresh table whose entries 256-511 are copied
//! from the kernel's, so the kernel half's tables are shared and every
//! kernel mapping made in an existing slot shows in every process (a
//! slot the kernel first fills after a process was made does not: PAX
//! makes its slots at boot), and whose entries 0-255 are the process's
//! own. `map_user` maps there with U/S set at every level (the access
//! rights of a translation are the most restrictive of every level's,
//! so a user page needs U/S on its PML4, PDPT and PD entries too);
//! `user_ok` walks a page the way the CPU would for a user read;
//! `free_user` gives the user half's frames and tables and the PML4
//! back.
//! Upper-level entries are present and writable, supervisor, and carry
//! no NX: the leaf alone decides (the access rights of a translation
//! are the most restrictive of every level's, Intel SDM vol. 3A §4.6.1,
//! AMD64 APM vol. 2 §5.6). No entry is global (G): there is one address
//! space, and Limine leaves CR4.PGE clear (base revision 5 and later).
//!
//! The structures (Intel SDM vol. 3A §4.5, "4-Level Paging and 5-Level
//! Paging", its entry-format tables; AMD64 APM vol. 2 §5.3,
//! "Long-Mode Page Translation", and §5.4, "Page-Translation-Table Entry
//! Fields"): a 4 KiB table of 512 eight-byte entries at each level,
//! indexed by virtual-address bits 47:39 (PML4), 38:30 (PDPT), 29:21
//! (PD) and 20:12 (PT). An entry's bits:
//!
//!     0 P present          1 RW writable        2 US user
//!     3 PWT write-through  4 PCD cache-disable  5 A accessed
//!     6 D dirty (a leaf)   7 PS a 2 MiB page (in a PD entry)
//!     8 G global (a leaf)  51:12 the next table's or the page's
//!     63 XD/NX no-execute  physical address (51:21 for a 2 MiB page)
//!
//! NX is honoured only with IA32_EFER.NXE set (SDM vol. 3A §4.1.3, APM
//! vol. 2 §3.1.7); Limine sets it when the CPU has the bit, and
//! `switch_to` sets it itself otherwise. A supervisor write to a
//! read-only page faults only with CR0.WP set (SDM vol. 3A §4.6.1);
//! Limine sets it, and `switch_to` refuses to switch without it. A MOV to
//! CR3 flushes every non-global TLB entry; changing one entry of the
//! live structures needs INVLPG for its page (SDM vol. 3A §4.10.4.1,
//! APM vol. 2 §5.5), which `unmap` issues.
//!
//! Page tables come from px02's frame allocator (each zeroed here:
//! frames come back unzeroed) and are reached through its HHDM offset;
//! the allocator finds its own state (a module `var`, px05), so no
//! function here takes it (px03 threaded the allocator's `st` through
//! every call, because wolf had no module state, wolf-lang#529). The
//! PML4's physical address is still an argument: `build` fills
//! structures that are not live yet. Table entries are read and written
//! with `read_volatile`/`write_volatile`: the processor's page walker
//! reads them behind the compiler's back.
//!
//! Flag values, masks and sizes are module `const`s (px05; px03 wrote
//! them as literals, wolf-lang#560). The flags other modules use are
//! also `pub fn`s (`present`, `writable`, `no_exec`): a `pub const`
//! read from another module is refused (wolf-lang#579). wolf has no
//! bitwise complement (wolf-lang#575), so masks are spelled whole.
//!
//! Written from the Intel 64 and IA-32 SDM vol. 3A ch. 4 (§4.1.3, §4.5,
//! §4.6, §4.10.4) and the AMD64 APM vol. 2 ch. 5 (§5.3, §5.4, §5.5, §5.6)
//! and §3.1.7, and Limine's PROTOCOL.md (limine-protocol 3a0526b7: the
//! x86-64 machine state at entry, the memory layout at entry and what
//! the HHDM maps per base revision). No Linux source; no other kernel's
//! source.

use boot_info
use frames
use log
use panic

extern "c" fn pax_cr0() -> u64
extern "c" fn pax_cr3() -> u64
extern "c" fn pax_cr4() -> u64
extern "c" fn pax_set_cr3(v: u64)
extern "c" fn pax_efer() -> u64
extern "c" fn pax_set_efer(v: u64)
extern "c" fn pax_invlpg(va: u64)
extern "c" fn pax_cpuid_nx() -> u64
extern "c" fn pax_rsp() -> u64
extern "c" let __pax_image_start: *u8
extern "c" let __pax_image_end: *u8
extern "c" let __pax_text_start: *u8
extern "c" let __pax_text_end: *u8
extern "c" let __pax_rodata_start: *u8
extern "c" let __pax_rodata_end: *u8
extern "c" let __pax_data_start: *u8

/// Why `map`, `map_large`, `unmap` or `translate` refused.
pub error MapError = {out_of_memory, misaligned, not_canonical, already_mapped, large_page, not_mapped}

// --- flags -----------------------------------------------------------------

const P: u64 = 0x1 // present
const RW: u64 = 0x2 // writable
const PS: u64 = 0x80 // a 2 MiB page (in a PD entry) or 1 GiB (in a PDPT entry)
const NX: u64 = 0x8000000000000000 // XD/NX, bit 63: no-execute
const ADDR: u64 = 0x000ffffffffff000 // bits 51:12: the next table's or a 4 KiB page's address
const ADDR_2M: u64 = 0x000fffffffe00000 // bits 51:21: a 2 MiB page's address
const TABLE: u64 = P | RW // an upper-level entry: present, writable, supervisor; the leaf decides
const US: u64 = 0x4 // user-accessible (px09)
const USER_TABLE: u64 = P | RW | US // an upper-level entry in the user half
const USER_TOP: u64 = 0x0000800000000000 // the first address past the user half (PML4 slots 0-255)
const KERNEL_FIRST: u64 = 256 // the kernel half's first PML4 slot

const PAGE: u64 = 4096
const LARGE: u64 = 2097152 // 2 MiB
const ENTRIES: u64 = 512
const ENTRY_BYTES: u64 = 8
const INDEX_BITS: u64 = 9
const PAGE_SHIFT: u64 = 12
const CANONICAL_SHIFT: u64 = 47 // bits 63:47 must all equal bit 47
const CANONICAL_HIGH: u64 = 0x1ffff // bits 63:47 of a higher-half address

const EFER_NXE: u64 = 0x800 // IA32_EFER bit 11
const CR0_WP: u64 = 0x10000 // CR0 bit 16
const CR4_PGE: u64 = 0x80 // CR4 bit 7

// Limine's memory-map types (kernel/boot_info).
const MEM_USABLE: u64 = 0
const MEM_ACPI_RECLAIMABLE: u64 = 2
const MEM_ACPI_NVS: u64 = 3
const MEM_BOOTLOADER_RECLAIMABLE: u64 = 5
const MEM_RESERVED_MAPPED: u64 = 8

/// P: present.
pub fn present() -> u64 {
    P
}

/// RW: writable.
pub fn writable() -> u64 {
    RW
}

/// XD/NX: no-execute (bit 63).
pub fn no_exec() -> u64 {
    NX
}

/// U/S: user-accessible (bit 2, px09).
pub fn user() -> u64 {
    US
}

/// The first address past the user half (px09).
pub fn user_top() -> u64 {
    USER_TOP
}

// --- the registers ---------------------------------------------------------

/// CR3 now (the physical address of the live PML4, in bits 51:12).
pub fn cr3() -> u64 {
    // # Safety: cpu.S's MOV from CR3; reads nothing else.
    unsafe { pax_cr3() }
}

/// The live PML4's physical address (CR3's bits 51:12, px09).
pub fn live() -> u64 {
    cr3() & ADDR
}

/// Make the structures at `pml4` live: MOV to CR3, which flushes every
/// non-global TLB entry (px09: kernel/sched, at a switch to a thread in
/// another address space). Every structure `new_space` makes maps the
/// kernel half, so the code making the switch stays mapped.
pub fn load(pml4: u64) {
    // # Safety: cpu.S's MOV to CR3; `pml4` is the kernel's PML4 or one
    // `new_space` made from it.
    unsafe { pax_set_cr3(pml4) }
}

/// CR0 now.
pub fn cr0() -> u64 {
    // # Safety: cpu.S's MOV from CR0.
    unsafe { pax_cr0() }
}

/// CR4 now.
pub fn cr4() -> u64 {
    // # Safety: cpu.S's MOV from CR4.
    unsafe { pax_cr4() }
}

/// IA32_EFER now.
pub fn efer() -> u64 {
    // # Safety: cpu.S's RDMSR of IA32_EFER, an MSR every x86-64 CPU has.
    unsafe { pax_efer() }
}

/// The image's bounds, boot/kernel.ld's symbols named with `extern "c"
/// let` (kw10; boot/limine.S returned them before wolf-lang kw09): 0/1
/// the image's first and one-past-last address, 2/3 text, 4/5 rodata,
/// 6/7 data and bss, each a page boundary; 0 otherwise.
pub fn bound(which: int) -> u64 {
    // # Safety: link-time addresses; nothing is read.
    unsafe {
        if which == 0 {
            return __pax_image_start as u64
        }
        if which == 1 || which == 7 {
            return __pax_image_end as u64
        }
        if which == 2 {
            return __pax_text_start as u64
        }
        if which == 3 {
            return __pax_text_end as u64
        }
        if which == 4 {
            return __pax_rodata_start as u64
        }
        if which == 5 {
            return __pax_rodata_end as u64
        }
        if which == 6 {
            return __pax_data_start as u64
        }
    }
    0
}

// --- the structures --------------------------------------------------------

/// Entry `i` of the table at physical `t`, through the HHDM.
fn entry(t: u64, i: u64) -> u64 {
    // # Safety: `t` is a page table this module allocated (or the live
    // PML4), a usable frame mapped in the HHDM; i < 512 keeps it inside.
    unsafe { ((frames.hhdm() + t + i * ENTRY_BYTES) as *u64).read_volatile() }
}

/// Write entry `i` of the table at physical `t`.
fn set_entry(t: u64, i: u64, v: u64) {
    // # Safety: as `entry`.
    unsafe { ((frames.hhdm() + t + i * ENTRY_BYTES) as *u64).write_volatile(v) }
}

/// A fresh frame, zeroed, for a table; 0 when the allocator is empty
/// (frame 0 is never handed out: px02 withholds the first MiB).
fn table_frame() -> u64 {
    let t = frames.alloc() else 0
    if t == 0 {
        return 0
    }
    var i: u64 = 0
    while i < ENTRIES {
        set_entry(t, i, 0)
        i += 1
    }
    t
}

/// Index of `va` at `level` (4 PML4, 3 PDPT, 2 PD, 1 PT).
fn index(va: u64, level: u64) -> u64 {
    (va >> (PAGE_SHIFT + INDEX_BITS * (level - 1))) & (ENTRIES - 1)
}

/// Whether `va` is canonical (bits 63:47 all equal) for 4-level paging.
fn canonical(va: u64) -> bool {
    let top = va >> CANONICAL_SHIFT
    top == 0 || top == CANONICAL_HIGH
}

/// The table entry `i` of table `t` points to, made (zeroed, present,
/// writable) when absent. 0 when the allocator is empty; 1 when the
/// entry is a 2 MiB page, not a table (no table address is 1).
fn descend(t: u64, i: u64) -> u64 {
    descend_as(t, i, TABLE)
}

/// `descend`, an absent entry made with `flags` (TABLE, or USER_TABLE in
/// the user half, px09).
fn descend_as(t: u64, i: u64, flags: u64) -> u64 {
    let e = entry(t, i)
    if e & P == 0 {
        let n = table_frame()
        if n == 0 {
            return 0
        }
        set_entry(t, i, n | flags)
        return n
    }
    if e & PS != 0 {
        return 1
    }
    e & ADDR
}

/// The PD that maps `va` in the structures at `pml4`, made as needed;
/// 0 out of frames, 1 when the PDPT entry is a 1 GiB page.
fn pd_of(pml4: u64, va: u64) -> u64 {
    let pdpt = descend(pml4, index(va, 4))
    if pdpt <= 1 {
        return pdpt
    }
    descend(pdpt, index(va, 3))
}

/// Map the 4 KiB page at `va` to the frame at `pa` with `flags` (P is
/// added) in the structures whose PML4 is at physical `pml4`. Returns
/// how many table frames it allocated (0..3). Rows: `misaligned` (va or
/// pa not 4 KiB aligned), `not_canonical`, `out_of_memory` (a table
/// frame), `large_page` (a 2 MiB page already covers va),
/// `already_mapped`.
pub fn map(pml4: u64, va: u64, pa: u64, flags: u64) -> u64 ! MapError {
    if va % PAGE != 0 || pa % PAGE != 0 {
        return misaligned
    }
    if !canonical(va) {
        return not_canonical
    }
    let before = frames.free_count()
    let pd = pd_of(pml4, va)
    if pd == 0 {
        return out_of_memory
    }
    if pd == 1 {
        return large_page
    }
    let pt = descend(pd, index(va, 2))
    if pt == 0 {
        return out_of_memory
    }
    if pt == 1 {
        return large_page
    }
    let i = index(va, 1)
    if entry(pt, i) & P != 0 {
        return already_mapped
    }
    set_entry(pt, i, pa | flags | P)
    before - frames.free_count()
}

/// Map the 2 MiB page at `va` to `pa` (both 2 MiB aligned) with `flags`
/// (P and PS are added). Returns the table frames allocated (0..2).
/// Rows as `map`; `already_mapped` also when a page table is there.
pub fn map_large(pml4: u64, va: u64, pa: u64, flags: u64) -> u64 ! MapError {
    if va % LARGE != 0 || pa % LARGE != 0 {
        return misaligned
    }
    if !canonical(va) {
        return not_canonical
    }
    let before = frames.free_count()
    let pd = pd_of(pml4, va)
    if pd == 0 {
        return out_of_memory
    }
    if pd == 1 {
        return large_page
    }
    let i = index(va, 2)
    if entry(pd, i) & P != 0 {
        return already_mapped
    }
    set_entry(pd, i, pa | flags | P | PS)
    before - frames.free_count()
}

/// The physical address `va` translates to in the structures at
/// `pml4`, walked in software (4 KiB and 2 MiB pages). Row `not_mapped`.
pub fn translate(pml4: u64, va: u64) -> u64 ! MapError {
    if !canonical(va) {
        return not_canonical
    }
    let e4 = entry(pml4, index(va, 4))
    if e4 & P == 0 {
        return not_mapped
    }
    let e3 = entry(e4 & ADDR, index(va, 3))
    if e3 & P == 0 {
        return not_mapped
    }
    if e3 & PS != 0 {
        return large_page // a 1 GiB page: PAX makes none
    }
    let e2 = entry(e3 & ADDR, index(va, 2))
    if e2 & P == 0 {
        return not_mapped
    }
    if e2 & PS != 0 {
        return (e2 & ADDR_2M) + va % LARGE
    }
    let e1 = entry(e2 & ADDR, index(va, 1))
    if e1 & P == 0 {
        return not_mapped
    }
    (e1 & ADDR) + va % PAGE
}

/// Unmap the 4 KiB page at `va`: clear its entry and, when `pml4` is
/// the live structure, INVLPG it, so no stale translation survives.
/// Returns the frame it mapped (the caller's to free). Rows:
/// `misaligned`, `not_canonical`, `not_mapped`, `large_page` (a 2 MiB
/// page covers va; PAX never splits one). Tables left empty stay.
pub fn unmap(pml4: u64, va: u64) -> u64 ! MapError {
    if va % PAGE != 0 {
        return misaligned
    }
    if !canonical(va) {
        return not_canonical
    }
    let e4 = entry(pml4, index(va, 4))
    if e4 & P == 0 {
        return not_mapped
    }
    let e3 = entry(e4 & ADDR, index(va, 3))
    if e3 & P == 0 {
        return not_mapped
    }
    if e3 & PS != 0 {
        return large_page
    }
    let e2 = entry(e3 & ADDR, index(va, 2))
    if e2 & P == 0 {
        return not_mapped
    }
    if e2 & PS != 0 {
        return large_page
    }
    let pt = e2 & ADDR
    let i = index(va, 1)
    let e1 = entry(pt, i)
    if e1 & P == 0 {
        return not_mapped
    }
    set_entry(pt, i, 0)
    if cr3() & ADDR == pml4 {
        // # Safety: cpu.S's INVLPG; it only drops TLB entries.
        unsafe { pax_invlpg(va) }
    }
    e1 & ADDR
}

// --- the user half (px09) ---------------------------------------------------

/// A process's PML4: a fresh zeroed table with the kernel half (entries
/// 256-511) copied from the kernel's PML4 at `kernel`. Returns its
/// physical address; 0 when the allocator is empty.
pub fn new_space(kernel: u64) -> u64 {
    let t = table_frame()
    if t == 0 {
        return 0
    }
    var i: u64 = KERNEL_FIRST
    while i < ENTRIES {
        set_entry(t, i, entry(kernel, i))
        i += 1
    }
    t
}

/// How many of the kernel half's present PML4 entries `pml4` carries
/// unchanged (0) and how many the kernel's PML4 at `kernel` has present
/// (1).
pub fn kernel_half(pml4: u64, kernel: u64, which: int) -> u64 {
    var have: u64 = 0
    var same: u64 = 0
    var i: u64 = KERNEL_FIRST
    while i < ENTRIES {
        let k = entry(kernel, i)
        if k & P != 0 {
            have += 1
            if entry(pml4, i) == k {
                same += 1
            }
        }
        i += 1
    }
    if which == 0 {
        return same
    }
    have
}

/// Map the user page at `va` (4 KiB aligned, below 0x800000000000) to
/// the frame at `pa` with `flags` (P and U/S are added; RW and NX are
/// the caller's) in the process structures at `pml4`, upper levels made
/// P | RW | U/S. Returns the table frames it allocated. Rows as `map`;
/// `not_canonical` for an address outside the user half.
pub fn map_user(pml4: u64, va: u64, pa: u64, flags: u64) -> u64 ! MapError {
    if va % PAGE != 0 || pa % PAGE != 0 {
        return misaligned
    }
    if va >= USER_TOP {
        return not_canonical
    }
    let before = frames.free_count()
    let pdpt = descend_as(pml4, index(va, 4), USER_TABLE)
    if pdpt == 0 {
        return out_of_memory
    }
    if pdpt == 1 {
        return large_page
    }
    let pd = descend_as(pdpt, index(va, 3), USER_TABLE)
    if pd == 0 {
        return out_of_memory
    }
    if pd == 1 {
        return large_page
    }
    let pt = descend_as(pd, index(va, 2), USER_TABLE)
    if pt == 0 {
        return out_of_memory
    }
    if pt == 1 {
        return large_page
    }
    let i = index(va, 1)
    if entry(pt, i) & P != 0 {
        return already_mapped
    }
    set_entry(pt, i, pa | flags | US | P)
    before - frames.free_count()
}

/// Whether a user-mode read of `va` in the structures at `pml4` would
/// translate: below 0x800000000000, and present and U/S at every level
/// (4 KiB pages only: the user half has no large page).
pub fn user_ok(pml4: u64, va: u64) -> bool {
    if va >= USER_TOP {
        return false
    }
    let want = P | US
    let e4 = entry(pml4, index(va, 4))
    if e4 & want != want {
        return false
    }
    let e3 = entry(e4 & ADDR, index(va, 3))
    if e3 & want != want || e3 & PS != 0 {
        return false
    }
    let e2 = entry(e3 & ADDR, index(va, 2))
    if e2 & want != want || e2 & PS != 0 {
        return false
    }
    let e1 = entry(e2 & ADDR, index(va, 1))
    e1 & want == want
}

/// Give back everything in the user half of the structures at `pml4`
/// (every page's frame, every table) and the PML4 itself. The kernel
/// half is shared and left alone. `pml4` must not be live. Returns the
/// frames freed.
pub fn free_user(pml4: u64) -> u64 {
    if live() == pml4 {
        panic.fail("paging: free_user of the live PML4", pml4)
    }
    var n: u64 = 0
    var i4: u64 = 0
    while i4 < KERNEL_FIRST {
        let e4 = entry(pml4, i4)
        if e4 & P != 0 {
            let pdpt = e4 & ADDR
            var i3: u64 = 0
            while i3 < ENTRIES {
                let e3 = entry(pdpt, i3)
                if e3 & P != 0 {
                    let pd = e3 & ADDR
                    var i2: u64 = 0
                    while i2 < ENTRIES {
                        let e2 = entry(pd, i2)
                        if e2 & P != 0 {
                            let pt = e2 & ADDR
                            var i1: u64 = 0
                            while i1 < ENTRIES {
                                let e1 = entry(pt, i1)
                                if e1 & P != 0 {
                                    frames.free(e1 & ADDR)
                                    n += 1
                                }
                                i1 += 1
                            }
                            frames.free(pt)
                            n += 1
                        }
                        i2 += 1
                    }
                    frames.free(pd)
                    n += 1
                }
                i3 += 1
            }
            frames.free(pdpt)
            n += 1
        }
        i4 += 1
    }
    frames.free(pml4)
    n + 1
}

// --- the kernel's structures -----------------------------------------------

/// `map` or a named panic (the kernel's own structures cannot be half
/// built).
fn must_map(pml4: u64, va: u64, pa: u64, flags: u64) {
    let r = map(pml4, va, pa, flags) else 9
    if r == 9 {
        panic.fail("paging: cannot map the kernel's page at", va)
    }
}

/// `map_large` or a named panic.
fn must_map_large(pml4: u64, va: u64, pa: u64, flags: u64) {
    let r = map_large(pml4, va, pa, flags) else 9
    if r == 9 {
        panic.fail("paging: cannot map the kernel's 2 MiB page at", va)
    }
}

/// Map the image's pages [lo, hi) (virtual) at `flags`.
fn map_section(pml4: u64, lo: u64, hi: u64, flags: u64) {
    let virt = boot_info.image_virt()
    let phys = boot_info.image_phys()
    var va = lo
    while va < hi {
        must_map(pml4, va, va - virt + phys, flags)
        va += PAGE
    }
}

/// Map physical [lo, hi) (4 KiB aligned) in the HHDM, read-write
/// no-execute: 2 MiB pages where a whole aligned 2 MiB lies inside,
/// 4 KiB pages elsewhere.
fn map_run(pml4: u64, lo: u64, hi: u64) {
    let hhdm = frames.hhdm()
    let rw_nx = NX | RW
    var a = lo
    while a < hi {
        if a % LARGE == 0 && a + LARGE <= hi {
            must_map_large(pml4, hhdm + a, a, rw_nx)
            a += LARGE
        } else {
            must_map(pml4, hhdm + a, a, rw_nx)
            a += PAGE
        }
    }
}

/// Whether a memory-map type is mapped in PAX's HHDM: usable (0), ACPI
/// reclaimable (2), ACPI NVS (3), bootloader reclaimable (5), reserved
/// mapped (8). Not reserved (1), bad (4), executable and modules (6),
/// framebuffer (7).
fn in_hhdm(t: u64) -> bool {
    t == MEM_USABLE || t == MEM_ACPI_RECLAIMABLE || t == MEM_ACPI_NVS || t == MEM_BOOTLOADER_RECLAIMABLE || t == MEM_RESERVED_MAPPED
}

/// Build PAX's structures: a zeroed PML4, the image with W^X, the HHDM.
/// Returns the PML4's physical address. Panics by name when the
/// allocator runs dry or the image is not where the linker put it.
pub fn build() -> u64 {
    let pml4 = table_frame()
    if pml4 == 0 {
        panic.fail("paging: no frame for the PML4", 0)
        return 0
    }
    if boot_info.image_virt() != bound(0) || boot_info.image_phys() == 0 {
        panic.fail("paging: the image is not at its link address", boot_info.image_virt())
        return 0
    }
    // The image, W^X (each bound a page boundary, boot/kernel.ld).
    map_section(pml4, bound(2), bound(3), 0) // text: R-X
    map_section(pml4, bound(4), bound(5), NX) // rodata: R--
    map_section(pml4, bound(6), bound(7), NX | RW) // data, bss: RW-
    // The HHDM: the map's entries of the types above, merged into runs
    // (the map is sorted and its entries never overlap; an entry that is
    // not 4 KiB aligned is rounded out to whole pages, as Limine does).
    let n = boot_info.memmap_count()
    var have = false
    var rl: u64 = 0
    var rh: u64 = 0
    var i = 0
    while i < n {
        if in_hhdm(boot_info.memmap_type(i)) {
            let b = boot_info.memmap_base(i)
            let lo = b - b % PAGE
            let e = b + boot_info.memmap_length(i)
            let hi = (e + PAGE - 1) - (e + PAGE - 1) % PAGE
            if have && lo <= rh {
                if hi > rh {
                    rh = hi
                }
            } else {
                if have {
                    map_run(pml4, rl, rh)
                }
                rl = lo
                rh = hi
                have = true
            }
        }
        i += 1
    }
    if have {
        map_run(pml4, rl, rh)
    }
    map_modules(pml4)
    pml4
}

/// px10: each Limine module's pages, at their HHDM addresses, read-only
/// no-execute, 4 KiB pages. A module lies in memory-map type 6
/// (executable and modules), which the HHDM leaves out with the image,
/// and every 4 KiB it covers is its own (PROTOCOL.md, `struct
/// limine_file`), so no page here is mapped twice and none is
/// writable: the initramfs is read in place and never written.
fn map_modules(pml4: u64) {
    let hhdm = frames.hhdm()
    let n = boot_info.module_count()
    var m: u64 = 0
    while m < n {
        let va = boot_info.module_addr(m)
        let size = boot_info.module_size(m)
        if va < hhdm || va % PAGE != 0 {
            panic.fail("paging: a module is not a page in the HHDM:", va)
        }
        var off: u64 = 0
        while off < size {
            must_map(pml4, va + off, va - hhdm + off, NX)
            off += PAGE
        }
        m += 1
    }
}

/// Switch to the structures at `pml4`: NX on (EFER.NXE; panic without
/// the CPU's XD bit), CR0.WP required (a supervisor write to a
/// read-only page must fault), CR4.PGE required clear (no global entry
/// may outlive the switch), the stack required mapped in them; then
/// MOV to CR3.
pub fn switch_to(pml4: u64) {
    let e = efer()
    if e & EFER_NXE == 0 {
        // # Safety: cpu.S's CPUID.
        if unsafe { pax_cpuid_nx() } == 0 {
            panic.fail("paging: the CPU has no execute-disable bit; EFER", e)
            return
        }
        // # Safety: cpu.S's WRMSR of IA32_EFER, NXE added to its bits.
        unsafe { pax_set_efer(e | EFER_NXE) }
    }
    if cr0() & CR0_WP == 0 {
        panic.fail("paging: CR0.WP is clear; CR0", cr0())
        return
    }
    if cr4() & CR4_PGE != 0 {
        panic.fail("paging: CR4.PGE is set; CR4", cr4())
        return
    }
    // # Safety: cpu.S returns the caller's stack pointer; reads nothing.
    let sp = unsafe { pax_rsp() }
    let probe = translate(pml4, sp - sp % PAGE) else 0
    if probe == 0 {
        panic.fail("paging: the stack is not mapped in the new structures", sp)
        return
    }
    // # Safety: `pml4` maps the image (so this code), the HHDM (the
    // stack, the allocator, Limine's responses) and nothing the kernel
    // still needs is outside them; cpu.S's MOV to CR3.
    unsafe { pax_set_cr3(pml4) }
}

/// Build PAX's structures from the allocator's frames and switch to them.
/// Returns the PML4's physical address.
pub fn start() -> u64 {
    let pml4 = build()
    switch_to(pml4)
    pml4
}

/// Write the switch's line:
/// `paging: limine cr3 0x<A>, pax cr3 0x<B>, <P> table frames`, where
/// A is CR3 before `start`, B is CR3 now and P the frames `start` took
/// (`free_before`, the allocator's free count before it).
pub fn report(limine_cr3: u64, free_before: u64) {
    log.put("paging: limine cr3 ")
    log.hex(limine_cr3)
    log.put(", pax cr3 ")
    log.hex(cr3())
    log.put(", ")
    log.dec((free_before - frames.free_count()) as int)
    log.put(" table frames")
    log.end()
}
