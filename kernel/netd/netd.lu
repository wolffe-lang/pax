//! netd — the network's two thread bodies and the one place a datagram
//! goes to its protocol (px20, px21, px22, px23).
//!
//! `pax_netd` is the kernel thread the device's interrupt wakes
//! (kernel/net's `wait`, kernel/sched's `block_net`/`wake_net`): it
//! takes every frame the device has returned, one at a time, in thread
//! context with interrupts on, hands it by its type — the two bytes at
//! 12, big-endian (RFC 894) — to the protocol that speaks it, and gives
//! the buffer back to the device:
//!
//!     0x0806  kernel/arp's `input`
//!     0x0800  kernel/ip's `input`, which judges the header and says
//!             whose the datagram is: kernel/icmp's `input` for
//!             protocol 1 (and, px23, kernel/tcp's `unreached` for a
//!             destination unreachable that quotes a TCP segment of
//!             this station's); kernel/tcp's `input` for protocol 6
//!             (px23); kernel/udp's `input` for protocol 17, and
//!             kernel/icmp's `unreachable` (code 3) when it says no
//!             socket takes the datagram (px22); kernel/icmp's
//!             `unreachable` (code 2) for a protocol nothing speaks;
//!             nothing more for one it dropped (px21)
//!     others  counted and dropped (kernel/net's `drop_type`)
//!
//! A protocol may write in the frame while it has it (an echo reply is
//! made in place) and must copy what it keeps.
//!
//! **`deliver`** (px23) is that table's 0x0800 row as a function, for a
//! frame from the wire or one off kernel/ip's loopback queue.
//! **`drain`** empties that queue: each datagram a protocol sent to
//! this machine is delivered, with IF clear from the moment it is
//! looked at until it is done, so two drains (a system call's and the
//! clock's) never deliver out of order; what a delivery sends in turn
//! (an echo's reply, a port unreachable) joins the queue and is
//! delivered by the same loop. kernel/user runs it at the end of every
//! system call, so what a call sent to this machine has arrived when
//! the call returns; the clock runs it every tick, for what nothing
//! else would deliver. No device is needed for any of it.
//!
//! `pax_net_clock` (px21) is the network's clock: a second thread that
//! turns every tick (px23; every ten before), runs kernel/tcp's `tick`
//! (its timers) on every turn and kernel/arp's `tick` on every tenth — the retries, the giving up, the ageing
//! — which nothing else would do while no frame arrives; then `drain`.
//! A kernel with no network device runs it alone.
//!
//! The bodies live here and a kernel names them with `extern "c" let
//! pax_netd: *u8` (wolf-lang#520; E0302 in the export's own module,
//! as px07's schedtest); `turns` keeps this module imported.
//!
//! No Linux source; no other kernel's or network stack's source.

use arp
use icmp
use ip
use net
use sched
use sync
use tcp
use udp

extern "c" let pax_net_stats: *u64

/// Times the thread has gone round its loop (word 31 of kernel/net's
/// counters).
pub fn turns() -> u64 {
    // # Safety: word 31 of boot/net.S's pax_net_stats.
    unsafe { ((pax_net_stats as u64 + 31 * 8) as *u64).read_volatile() }
}

/// Times the clock has run kernel/arp's `tick` (word 30).
pub fn clock_turns() -> u64 {
    // # Safety: word 30 of boot/net.S's pax_net_stats.
    unsafe { ((pax_net_stats as u64 + 30 * 8) as *u64).read_volatile() }
}

/// A datagram's frame (type 0x0800) to the protocol it is for:
/// kernel/ip judges the header, and the protocol it names — or
/// kernel/icmp, for one nothing takes — gets the frame. `looped`: it
/// came off the loopback queue, not the wire.
pub fn deliver(frame: u64, len: u64, looped: bool) {
    let (what, ihl, total) = ip.input(frame, len, looped)
    if what == ip.TO_ICMP {
        if icmp.input(frame, ihl, total, looped) == icmp.ERROR {
            // px23: a destination unreachable goes to the protocol whose
            // datagram it quotes, when that datagram was this station's.
            let (code, proto, src, dst, a, b) = icmp.quoted(frame, ihl)
            if proto == ip.TCP && ip.local(src) {
                tcp.unreached(code, src, a >> 16, dst, a & 0xffff, b)
            }
        }
    } else if what == ip.TO_TCP {
        tcp.input(frame, ihl, total, looped)
    } else if what == ip.TO_UDP {
        // px22: a datagram no socket takes draws a port unreachable,
        // and kernel/udp counts what became of the wire's.
        if udp.input(frame, ihl, total, looped) == udp.NO_PORT {
            let r = icmp.unreachable(frame, ihl, total, icmp.CODE_PORT, looped)
            if !looped {
                udp.unreached(r)
            }
        }
    } else if what == ip.NO_PROTOCOL {
        let _r = icmp.unreachable(frame, ihl, total, icmp.CODE_PROTOCOL, looped)
    }
}

/// Deliver every datagram on kernel/ip's loopback queue, and what
/// those deliveries send there in turn. Returns how many. Any context.
pub fn drain() -> u64 {
    var n: u64 = 0
    var more = true
    while more {
        let saved = sync.irq_save()
        let (frame, len) = ip.loop_peek()
        if len == 0 {
            more = false
        } else {
            deliver(frame, len, true)
            ip.loop_done()
            n += 1
        }
        sync.irq_restore(saved)
    }
    n
}

export fn pax_netd(_arg: u64) {
    while true {
        net.wait()
        // # Safety: as `turns`; only this thread writes the word.
        unsafe { ((pax_net_stats as u64 + 31 * 8) as *u64).write_volatile(turns() + 1) }
        var more = true
        while more {
            let (frame, len, buffer) = net.rx_take()
            if len == 0 {
                more = false
            } else {
                // # Safety: bytes 12 and 13 of a received frame of at
                // least 14 bytes, in its receive buffer.
                let (hi, lo) = unsafe { (((frame + 12) as *u8).read_volatile(), ((frame + 13) as *u8).read_volatile()) }
                let ethertype = (hi as u64) << 8 | lo as u64
                if ethertype == 0x0806 {
                    arp.input(frame, len)
                } else if ethertype == 0x0800 {
                    deliver(frame, len, false)
                } else {
                    net.drop_type()
                }
                net.rx_give(buffer)
            }
        }
        // What the wire's frames made this machine send to itself.
        let _n = drain()
    }
}

export fn pax_net_clock(_arg: u64) {
    var turn: u64 = 0
    while true {
        let _s = sched.sleep(1)
        turn += 1
        tcp.tick()
        if turn % 10 == 0 {
            arp.tick()
            // # Safety: as `clock_turns`; only this thread writes the word.
            unsafe { ((pax_net_stats as u64 + 30 * 8) as *u64).write_volatile(clock_turns() + 1) }
        }
        let _n = drain()
    }
}
