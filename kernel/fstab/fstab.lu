//! fstab — the volumes the kernel mounts before the first program
//! (px63; R-px63-1, recommended and implemented, not decided).
//!
//! **The table** is the initramfs's `/etc/fstab` (the repository's
//! `user/fstab`), read once by kmain_console after the tree is made and
//! the disks are up, before `/etc/pax-run`'s first command: PAX's init is
//! the kernel's run list, and no program of PAX's mounts anything, so the
//! kernel does what a distribution's init does with the same file. A
//! line is fstab(5)'s, its fields separated by spaces or tabs, `#` a
//! comment:
//!
//!     <spec> <file> <vfstype> <mntops> [<freq> [<passno>]]
//!
//! `spec` names a disk or a partition as Linux would (`/dev/vda`,
//! `/dev/vda2`, or `vda2`), or (px66) a volume by the names blkid(8)
//! prints and fstab(5) takes: `PARTUUID=` (a GPT partition's unique
//! GUID, or an MBR partition's `ssssssss-nn`: kernel/block's
//! `by_partuuid`), `PARTLABEL=` (a GPT partition's name), `UUID=` and
//! `LABEL=` (the ext2 superblock's s_uuid and s_volume_name, asked of
//! each device in kernel/block's order, the disk first, by kernel/ext2's
//! `probe`). A UUID's hex digits match in either case, hyphens anywhere;
//! a label matches byte for byte. `file` is an absolute path to a
//! directory of the in-memory tree (not `/`). `vfstype` is `ext2` (any
//! other refused by name). `mntops` is a comma list: `defaults`, `rw`,
//! `ro`, `sync` (every change written before the system call returns:
//! write-through), `async` (the default: write-back, below), `nofail` (a disk that is not there is not said),
//! `relatime`, `nosuid`, `nodev`, `noexec` (named in the line and not
//! acted on: PAX honours no set-ID bit and has no device nodes); anything
//! else is named as ignored. `freq` and `passno` are read and ignored
//! (PAX runs no fsck: the host's `e2fsck` is the check).
//!
//! **Write-back (R-px63-3).** A volume mounted `async` (or by default)
//! keeps its changed blocks in kernel/block's cache until fsync, sync,
//! syncfs, the halt or a reboot writes them; and every FLUSH_TICKS (5 s,
//! Linux's default writeback interval) the flusher thread (`pax_flushd`,
//! which kmain_console starts when a volume is write-back) writes them
//! too, so a machine switched off without a halt loses at most the last
//! five seconds. The flusher writes with interrupts off, as a system call
//! does, so no system call sees a volume half written. A volume mounted
//! `sync` is written through: every change on the disk before its system
//! call returns.
//!
//! One line a mount, and one for a line that mounts nothing:
//!
//!     fstab: /dev/vda on /home: ext2, read-write, write-through
//!     ext2: vda: <kernel/ext2's mount line>
//!     fstab: PARTUUID=<guid> (vda2) on /home: ext2, read-write, write-back
//!     fstab: /dev/vda for /home: no such disk; /home stays the tree's
//!
//! **The root (px67).** Before the table, `root=` on the kernel command
//! line (Limine's `cmdline`, kernel/boot_info) names the volume `/` is,
//! in bootparam(7)'s spellings: `/dev/vda2` or `vda2`, a device's numbers
//! (`0xfe02` or `fe02`, the major in the high byte, or `254:2`: each
//! measured on Linux 7.2.8), `PARTUUID=…` (in
//! either case, as Linux reads it), and `UUID=…` and `LABEL=…`, which
//! the Linux kernel alone refuses (measured: `VFS: Cannot open root
//! device "UUID=…"`, a panic: an initramfs serves them there) and PAX
//! serves as this table does (a named drift). `rootfstype=` is `ext2` or
//! absent; `rw` mounts it read-write, else it is read-only (Linux 7.2.8's
//! answer with neither word, measured, where bootparam(7) says `rw` is
//! the default). The volume is mounted over the memory's root
//! (kernel/tree's `mount_root`) and every path starts there; /proc, /sys
//! and /dev are the kernel's, over the disk's directories of those names
//! (kernel/files; one line when the disk has none), and the table below
//! is then the disk's `/etc/fstab`. Without `root=`, `/` is the
//! initramfs in memory, as before. A `root=` that names no volume, or
//! one that does not mount, leaves `/` the initramfs's when Limine loaded
//! one (R-px67-2: the rescue), said once; with none it is the end, as
//! Linux's `Unable to mount root fs` is (a panic by name):
//!
//!     root: PARTUUID=<guid> (vda2) on /: ext2, read-write, write-back
//!     ext2: vda2: <kernel/ext2's mount line>
//!
//! **The table** is read from the tree (`/etc/fstab` under `/`, px67: on
//! the disk when `/` is). A line for `/` is the root's: it names the
//! root's volume or is said not to (`/` stays as `root=` mounted it), and
//! its `ro` or `rw` remounts the root when it differs. A `tmpfs` line
//! (R-px67-1) mounts a directory of the memory over its `file` (`/tmp`:
//! its files gone at the next boot, as a distribution's tmpfs), mode 1777
//! or its `mode=`; `nosuid`, `nodev` and `noexec` are kept for
//! /proc/self/mounts' line. A line's `file` may now be a directory of
//! the disk's.
//!
//! Written from fstab(5) and mount(8)'s option names, and px67's
//! bootparam(7). No Linux source; no other system's init or mount source.

use block
use boot_info
use ext2
use initramfs
use log
use panic
use sched
use sync
use tree

const PATH: str = "/etc/fstab"

/// The options a line asks for.
const O_RO: u64 = 1
const O_SYNC: u64 = 2
const O_ASYNC: u64 = 4
const O_NOFAIL: u64 = 8
const O_NOSUID: u64 = 16 // px67: kept for /proc/self/mounts
const O_NODEV: u64 = 32
const O_NOEXEC: u64 = 64
const O_RW: u64 = 128 // px67: `rw` said (a `/` line's remount)

/// The flusher's interval, in the timer's ticks (10 ms).
pub const FLUSH_TICKS: u64 = 500

/// Whether a mount asked for write-back (kmain_console starts the
/// flusher then), and how many times the flusher found something to
/// write.
var write_back: u64 = 0
var flushed: u64 = 0

/// Whether a volume is mounted write-back.
pub fn wants_flusher() -> bool {
    // # Safety: a scalar module var, written at boot.
    unsafe { write_back != 0 }
}

/// How many of the flusher's turns wrote something.
pub fn flushes() -> u64 {
    // # Safety: a scalar module var, written by the flusher with IF clear.
    unsafe { flushed }
}

/// The flusher (a kernel thread): every FLUSH_TICKS, when the cache has
/// a dirty block, every volume written (kernel/tree's `sync_all`) with
/// interrupts off.
export fn pax_flushd(_arg: u64) {
    while true {
        let _s = sched.sleep(FLUSH_TICKS)
        let saved = sync.irq_save()
        if block.counter(block.K_DIRTY) != 0 {
            let _e = tree.sync_all()
            // # Safety: a scalar module var, IF clear.
            unsafe { flushed = flushed + 1 }
        }
        sync.irq_restore(saved)
    }
}

fn byte(a: u64) -> u64 {
    // # Safety: a byte of the initramfs's /etc/fstab, mapped read-only in
    // the HHDM for the kernel's life.
    let v = unsafe { (a as *u8).read_volatile() }
    v as u64
}

fn blank(b: u64) -> bool {
    b == 32 || b == 9
}

fn is(a: u64, n: u64, s: str) -> bool {
    var k: u64 = 0
    for c in s.bytes() {
        if k >= n || byte(a + k) != c as int as u64 {
            return false
        }
        k += 1
    }
    k == n
}

/// px67: four octal digits (a mode).
fn put_oct(v: u64) {
    var sh: u64 = 9
    var k: u64 = 0
    while k < 4 {
        log.put_byte((48 + ((v >> sh) & 7)) as int)
        if sh >= 3 {
            sh -= 3
        }
        k += 1
    }
}

fn put_span(a: u64, n: u64) {
    var k: u64 = 0
    while k < n {
        log.put_byte(byte(a + k) as int)
        k += 1
    }
}

/// The directory the absolute path [a, a + n) names (px67: from `/`,
/// on the disk when `/` is, through mounts), or NONE.
fn walk(a: u64, n: u64) -> u64 {
    if n == 0 || byte(a) != 47 {
        return tree.NONE
    }
    var d = tree.top()
    var s: u64 = 1
    while s < n {
        var e = s
        while e < n && byte(a + e) != 47 {
            e += 1
        }
        if e > s {
            let c = tree.lookup(d, a + s, e - s)
            if c == tree.NONE || !tree.is_dir(c) {
                return tree.NONE
            }
            d = c
        }
        s = e + 1
    }
    d
}

/// px66: the device a line's `spec` (the `n` bytes at `a`) names, and
/// whether it named a volume by `PARTUUID=`, `PARTLABEL=`, `UUID=` or
/// `LABEL=` (else a device name): (block.DEVS when none matches).
fn spec_device(a: u64, n: u64) -> (u64, bool) {
    if n > 9 && is(a, 9, "PARTUUID=") {
        return (block.by_partuuid(a + 9, n - 9), true)
    }
    if n > 10 && is(a, 10, "PARTLABEL=") {
        return (block.by_partlabel(a + 10, n - 10), true)
    }
    if n > 5 && is(a, 5, "UUID=") {
        let (ok, hi, lo) = block.uuid_text(a + 5, n - 5)
        if !ok {
            return (block.DEVS, true)
        }
        var d: u64 = 0
        while d < block.count() {
            let (has, h, l) = ext2.probe(d)
            if has && h == hi && l == lo {
                return (d, true)
            }
            d += 1
        }
        return (block.DEVS, true)
    }
    if n > 6 && is(a, 6, "LABEL=") {
        if n - 6 > 16 {
            return (block.DEVS, true)
        }
        var d: u64 = 0
        while d < block.count() {
            let (has, _h, _l) = ext2.probe(d)
            if has {
                var k: u64 = 0
                while k < n - 6 && ext2.probed_label(k) == byte(a + 6 + k) {
                    k += 1
                }
                if k == n - 6 && ext2.probed_label(k) == 0 {
                    return (d, true)
                }
            }
            d += 1
        }
        return (block.DEVS, true)
    }
    (block.by_name(a, n), false)
}

/// px67: whether the kernel command line names a root (`root=`): then
/// kmain_console needs no initramfs.
pub fn root_asked() -> bool {
    let (_a, n) = boot_info.cmdline_value("root")
    n != 0
}

fn mh_of(opts: u64) -> u64 {
    var h: u64 = 0
    if opts & O_SYNC != 0 {
        h = h | tree.MH_SYNC
    }
    if opts & O_NOSUID != 0 {
        h = h | tree.MH_NOSUID
    }
    if opts & O_NODEV != 0 {
        h = h | tree.MH_NODEV
    }
    if opts & O_NOEXEC != 0 {
        h = h | tree.MH_NOEXEC
    }
    h
}

/// px67: `root=`'s volume mounted as `/` (kmain_console, after
/// `block.start`, before `mount_all` and the first program): 1 when it
/// is, 0 when no root was asked or `/` stays the initramfs's (the
/// rescue, said once); panics by name when a root was asked, cannot be
/// had, and no initramfs is there to stay on.
pub fn mount_root() -> u64 {
    let (ra, rl) = boot_info.cmdline_value("root")
    if rl == 0 {
        return 0
    }
    let (ta, tl) = boot_info.cmdline_value("rootfstype")
    if tl != 0 && !is(ta, tl, "ext2") && !is(ta, tl, "ext3") {
        return no_root(ra, rl, "rootfstype= names a file system PAX does not mount (ext2 and ext3 are the ones)")
    }
    let asked = if tl == 0 { 0 } else if is(ta, tl, "ext3") { 3 } else { 2 } // px68
    let ro = !boot_info.cmdline_has("rw")
    var (d, named) = spec_device(ra, rl)
    if d == block.DEVS {
        d = by_numbers(ra, rl) // px67: bootparam(7)'s numeric root=
    }
    if d == block.DEVS {
        return no_root(ra, rl, if named { "no such volume" } else { "no such disk" })
    }
    if asked == 3 && !ext2.has_journal(d) {
        // px68: Linux 7.3.0's `couldn't mount as ext3 due to feature incompatibilities`
        return no_root(ra, rl, "rootfstype=ext3 names a volume with no journal")
    }
    let _old = block.set_policy(block.WRITE_BACK)
    let m = tree.mount_root(d, ro, 0)
    if ext2.failed(m) {
        log.put("root: ")
        put_span(ra, rl)
        log.put(" (")
        block.put_name(d)
        log.put("): not mounted, -")
        log.dec((!m + 1) as int)
        log.end()
        return no_root(ra, rl, "the volume did not mount")
    }
    // # Safety: a scalar module var, written at boot with IF clear.
    unsafe { write_back = 1 }
    let v = tree.mounted(m)
    ext2.ask_type(v, asked)
    log.put("root: ")
    put_span(ra, rl)
    log.put(" (")
    block.put_name(d)
    log.put(") on /: ")
    put_kind(v, false)
    log.end()
    ext2.report(v)
    covers()
    1
}

/// px68: how a volume is mounted, in its line: `ext2, read-write,
/// write-back` (or `write-through`, `read-only`); a journalled one
/// `ext3, read-write, data=ordered` (Linux 7.3.0's `with ordered data
/// mode`), named `ext2` when the mount asked for that type, and
/// `data=ordered, write-through` with `sync` (its file data written
/// through; its metadata still at the journal's commits).
fn put_kind(v: u64, wt: bool) {
    log.put(if ext2.fstype(v) == 3 { "ext3, " } else { "ext2, " })
    log.put(if ext2.read_only(v) != 0 { "read-only" } else { "read-write" })
    if ext2.journalled(v) {
        log.put(if wt { ", data=ordered, write-through" } else { ", data=ordered" })
    } else {
        log.put(if wt { ", write-through" } else { ", write-back" })
    }
}

/// px67: the names the kernel's own trees are mounted over at `/` on the
/// disk (kernel/files serves them whatever the disk holds): one line for
/// those the disk has no directory for.
fn covers() {
    let (ok_dev, ok_proc, ok_sys) = (tree.top_has("dev"), tree.top_has("proc"), tree.top_has("sys"))
    if ok_dev && ok_proc && ok_sys {
        return
    }
    log.put("root: no directory on the volume for")
    if !ok_dev {
        log.put(" /dev")
    }
    if !ok_proc {
        log.put(" /proc")
    }
    if !ok_sys {
        log.put(" /sys")
    }
    log.put("; the kernel's trees are mounted at those names all the same")
    log.end()
}

/// px67: the device a numeric `root=` names (bootparam(7)): `MMmm` in
/// hex, `0x` before it or not, the major in the bits above the low byte
/// (`fe02`: 254, 2), or `major:minor` in decimal (`254:2`); block.DEVS
/// when it is neither or no device has those numbers.
fn by_numbers(a: u64, n: u64) -> u64 {
    var ma: u64 = 0
    var mi: u64 = 0
    var colon = false
    var k: u64 = 0
    while k < n && byte(a + k) != 58 {
        k += 1
    }
    if k < n {
        // major:minor, decimal
        var i: u64 = 0
        while i < n {
            let c = byte(a + i)
            if c == 58 {
                if colon || i == 0 || i + 1 == n {
                    return block.DEVS
                }
                colon = true
            } else if c >= 48 && c <= 57 {
                if colon { mi = mi * 10 + (c - 48) } else { ma = ma * 10 + (c - 48) }
                if ma > 4095 || mi > 1048575 {
                    return block.DEVS
                }
            } else {
                return block.DEVS
            }
            i += 1
        }
    } else {
        var i: u64 = 0
        if n > 2 && byte(a) == 48 && (byte(a + 1) == 120 || byte(a + 1) == 88) {
            i = 2
        }
        if i >= n || n - i > 8 {
            return block.DEVS
        }
        var v: u64 = 0
        while i < n {
            let c = byte(a + i)
            let h = if c >= 48 && c <= 57 { c - 48 } else if c >= 97 && c <= 102 { c - 87 } else if c >= 65 && c <= 70 { c - 55 } else { 16 }
            if h == 16 {
                return block.DEVS
            }
            v = v * 16 + h
            i += 1
        }
        ma = v >> 8
        mi = v & 0xff
    }
    var d: u64 = 0
    while d < block.count() {
        let (x, y) = block.numbers(d)
        if x == ma && y == mi {
            return d
        }
        d += 1
    }
    block.DEVS
}

/// px67: a root asked and not had: the initramfs stays `/` when Limine
/// loaded one (R-px67-2, the rescue), said once; else a panic by name.
fn no_root(ra: u64, rl: u64, why: str) -> u64 {
    if initramfs.bytes() != 0 && initramfs.problem() == 0 {
        log.put("root: ")
        put_span(ra, rl)
        log.put(": ")
        log.put(why)
        log.put("; / stays the initramfs in memory")
        log.end()
        return 0
    }
    log.put("root: ")
    put_span(ra, rl)
    log.put(": ")
    log.put(why)
    log.put("; no initramfs to stay on")
    log.end()
    panic.fail("root: no root file system, root= bytes", rl)
}

/// Mount what `/etc/fstab` lists (kmain_console, after `user.start` and
/// `block.start`, before the first program): how many were mounted.
/// px67: read from the tree (`/etc/fstab` under `/`: the disk's when `/`
/// is on one), a page at most.
pub fn mount_all() -> u64 {
    let (base, size, why) = tree.small_file(PATH)
    if why == 2 {
        log.put("fstab: refused: /etc/fstab is longer than a page, bytes ")
        log.dec(size as int)
        log.end()
        return 0
    }
    if why != 0 {
        return 0
    }
    var mounted: u64 = 0
    var i: u64 = 0
    while i < size {
        var j = i
        while j < size && byte(base + j) != 10 {
            j += 1
        }
        if mount_line(base + i, j - i) {
            mounted += 1
        }
        i = j + 1
    }
    mounted
}

/// One line of the table: whether it mounted a volume.
fn mount_line(a: u64, n: u64) -> bool {
    // The fields' starts and lengths: up to four are read.
    var fa: u64 = 0
    var fl: u64 = 0
    var ga: u64 = 0
    var gl: u64 = 0
    var ta: u64 = 0
    var tl: u64 = 0
    var oa: u64 = 0
    var ol: u64 = 0
    var k: u64 = 0
    var field: u64 = 0
    while k < n {
        while k < n && blank(byte(a + k)) {
            k += 1
        }
        if k >= n {
            break
        }
        if field == 0 && byte(a + k) == 35 {
            return false // a comment
        }
        let s = k
        while k < n && !blank(byte(a + k)) {
            k += 1
        }
        if field == 0 {
            fa = a + s
            fl = k - s
        } else if field == 1 {
            ga = a + s
            gl = k - s
        } else if field == 2 {
            ta = a + s
            tl = k - s
        } else if field == 3 {
            oa = a + s
            ol = k - s
        }
        field += 1
    }
    if field == 0 {
        return false
    }
    if field < 3 {
        log.put("fstab: refused: a line of fewer than three fields: ")
        put_span(a, n)
        log.end()
        return false
    }
    // The options.
    var opts: u64 = 0
    var mode: u64 = 0x3ff // px67: a tmpfs line's directory, 1777 unless `mode=` says
    var p: u64 = 0
    var ignored: u64 = 0
    var ia: u64 = 0
    var il: u64 = 0
    while p < ol {
        var q = p
        while q < ol && byte(oa + q) != 44 {
            q += 1
        }
        let w = oa + p
        let wl = q - p
        if is(w, wl, "ro") {
            opts = (opts | O_RO) & !O_RW
        } else if is(w, wl, "rw") {
            opts = (opts & !O_RO) | O_RW
        } else if is(w, wl, "nosuid") {
            opts = opts | O_NOSUID
        } else if is(w, wl, "nodev") {
            opts = opts | O_NODEV
        } else if is(w, wl, "noexec") {
            opts = opts | O_NOEXEC
        } else if wl > 5 && is(w, 5, "mode=") {
            var mv: u64 = 0
            var q2: u64 = 5
            while q2 < wl && byte(w + q2) >= 48 && byte(w + q2) <= 55 {
                mv = mv * 8 + byte(w + q2) - 48
                q2 += 1
            }
            if q2 == wl && q2 > 5 {
                mode = mv & 0xfff
            } else {
                if ignored == 0 {
                    ia = w
                    il = wl
                }
                ignored += 1
            }
        } else if is(w, wl, "sync") {
            opts = (opts | O_SYNC) & !O_ASYNC
        } else if is(w, wl, "async") {
            opts = (opts | O_ASYNC) & !O_SYNC
        } else if is(w, wl, "nofail") {
            opts = opts | O_NOFAIL
        } else if !(is(w, wl, "defaults") || is(w, wl, "relatime") || wl == 0) {
            if ignored == 0 {
                ia = w
                il = wl
            }
            ignored += 1
        }
        p = q + 1
    }
    if is(ga, gl, "/") {
        return root_line(fa, fl, opts)
    }
    if is(ta, tl, "tmpfs") {
        return tmpfs_line(fa, fl, ga, gl, opts, mode)
    }
    if !is(ta, tl, "ext2") && !is(ta, tl, "ext3") {
        log.put("fstab: refused: ")
        put_span(fa, fl)
        log.put(" on ")
        put_span(ga, gl)
        log.put(": a file system type PAX does not mount (")
        put_span(ta, tl)
        log.put("; ext2, ext3 and tmpfs are the ones)")
        log.end()
        return false
    }
    let t3 = is(ta, tl, "ext3") // px68
    let (d, named) = spec_device(fa, fl)
    if d == block.DEVS {
        if opts & O_NOFAIL == 0 {
            log.put("fstab: ")
            put_span(fa, fl)
            log.put(" for ")
            put_span(ga, gl)
            log.put(if named { ": no such volume; " } else { ": no such disk; " })
            put_span(ga, gl)
            log.put(" stays the tree's")
            log.end()
        }
        return false
    }
    let point = walk(ga, gl)
    if point == tree.NONE {
        log.put("fstab: ")
        put_span(fa, fl)
        log.put(" for ")
        put_span(ga, gl)
        log.put(": no such directory; not mounted")
        log.end()
        return false
    }
    if t3 && !ext2.has_journal(d) {
        log.put("fstab: refused: ")
        put_span(fa, fl)
        log.put(" on ")
        put_span(ga, gl)
        log.put(": ext3 asked of a volume with no journal")
        log.end()
        return false
    }
    let wt = opts & O_SYNC != 0
    let _old = block.set_policy(if wt { block.WRITE_THROUGH } else { block.WRITE_BACK })
    if !wt {
        // # Safety: a scalar module var, written at boot with IF clear.
        unsafe { write_back = 1 }
    }
    let m = tree.mount(point, d, opts & O_RO != 0, mh_of(opts))
    if ext2.failed(m) {
        log.put("fstab: ")
        put_span(fa, fl)
        if named {
            log.put(" (")
            block.put_name(d)
            log.put(")")
        }
        log.put(" on ")
        put_span(ga, gl)
        log.put(": not mounted, -")
        log.dec((!m + 1) as int)
        log.end()
        return false
    }
    let v = tree.mounted(m)
    ext2.ask_type(v, if t3 { 3 } else { 2 })
    log.put("fstab: ")
    put_span(fa, fl)
    if named {
        log.put(" (")
        block.put_name(d)
        log.put(")")
    }
    log.put(" on ")
    put_span(ga, gl)
    log.put(": ")
    put_kind(v, wt)
    if ignored != 0 {
        log.put(", ignored: ")
        put_span(ia, il)
        if ignored > 1 {
            log.put(" and ")
            log.dec((ignored - 1) as int)
            log.put(" more")
        }
    }
    log.end()
    ext2.report(v)
    true
}

/// px67: a line for `/`: the root's when it names the root's volume (its
/// `ro` or `rw` then remounts `/` when it differs, its `sync` writes it
/// through); else said, and `/` stays as `root=` mounted it (or, without
/// `root=`, the initramfs).
fn root_line(fa: u64, fl: u64, opts: u64) -> bool {
    var rm = tree.MOUNTS
    var k: u64 = 0
    while k < tree.MOUNTS {
        if tree.in_use(k) && tree.is_root_mount(k) {
            rm = k
        }
        k += 1
    }
    let (d, named) = spec_device(fa, fl)
    if rm == tree.MOUNTS {
        log.put("fstab: ")
        put_span(fa, fl)
        log.put(" for /: / is the initramfs in memory; not mounted")
        log.end()
        return false
    }
    if d != tree.mount_dev(rm) {
        log.put("fstab: ")
        put_span(fa, fl)
        log.put(" for /: not the root's volume (")
        block.put_name(tree.mount_dev(rm))
        log.put("); / stays as root= mounted it")
        log.end()
        return false
    }
    let v = tree.mounted(rm)
    let ro_now = ext2.read_only(v) != 0
    var e: u64 = 0
    if opts & O_RO != 0 && !ro_now {
        e = tree.remount(rm, true)
    } else if opts & O_RW != 0 && ro_now {
        e = tree.remount(rm, false)
    }
    if opts & O_SYNC != 0 {
        let _old = block.set_policy(block.WRITE_THROUGH)
    }
    tree.set_how(rm, mh_of(opts) | tree.MH_ROOT)
    log.put("fstab: ")
    put_span(fa, fl)
    if named {
        log.put(" (")
        block.put_name(d)
        log.put(")")
    }
    log.put(" is /: ")
    put_kind(v, opts & O_SYNC != 0)
    if e != 0 {
        log.put("; the remount: -")
        log.dec((!e + 1) as int)
    }
    log.end()
    false
}

/// px67 (R-px67-1): a `tmpfs` line: a directory of the memory mounted
/// over its `file` (kernel/tree's `mount_mem`), mode `mode`.
fn tmpfs_line(fa: u64, fl: u64, ga: u64, gl: u64, opts: u64, mode: u64) -> bool {
    let point = walk(ga, gl)
    if point == tree.NONE {
        log.put("fstab: ")
        put_span(fa, fl)
        log.put(" for ")
        put_span(ga, gl)
        log.put(": no such directory; not mounted")
        log.end()
        return false
    }
    let m = tree.mount_mem(point, mode)
    if ext2.failed(m) {
        log.put("fstab: ")
        put_span(fa, fl)
        log.put(" on ")
        put_span(ga, gl)
        log.put(": not mounted, -")
        log.dec((!m + 1) as int)
        log.end()
        return false
    }
    tree.set_how(m, mh_of(opts))
    tree.set_mode_of(m, mode)
    log.put("fstab: tmpfs on ")
    put_span(ga, gl)
    log.put(": the memory's, mode ")
    put_oct(mode)
    log.end()
    true
}
