//! frames — the physical page-frame allocator (px02, M-PX2's first
//! piece).
//!
//! A frame is 4 KiB of physical memory, named by its physical address
//! (`pa`, a multiple of 4096) or its number (`pa / 4096`). The
//! allocator is built from Limine's memory map (kernel/boot_info) and
//! hands out exactly the frames of the map's USABLE entries at or above
//! 1 MiB, less the few it keeps for its own state. Everything else —
//! the first MiB, the kernel image (an executable-and-modules entry),
//! bootloader-reclaimable memory (Limine's page tables, its stack and
//! the responses the kernel still reads), ACPI, reserved — is never
//! handed out.
//!
//! **Why a bitmap, not a free list.** A free list threads the free
//! frames through themselves: O(1) both ways, no state of its own. But
//! it cannot tell a double free from a free (a frame pushed twice is
//! handed out twice, silently, later), nor a frame that was never
//! usable from one that was, without a second structure; and it writes
//! into every free frame to build it. Two bitmaps — FREE (bit set: the
//! frame may be handed out) and USABLE (bit set: the frame lies in a
//! usable entry; written once, at `init`) — cost two bits per frame of
//! the span (16 KiB for 256 MiB), catch both faults in O(1) and touch
//! no frame they do not own. `alloc` is next-fit: it scans the FREE
//! words from a hint (the last word it allocated from), so a run of
//! allocations is O(1) amortised and one is O(span / 64) at worst.
//!
//! **Where the state lives.** wolf has no allocator (K8(b)) and module
//! state holds scalars only (`[mem.static.3]`), so the state is memory
//! this module takes for itself: the first usable run at or above 1 MiB
//! long enough for it, reached through the HHDM. Its virtual address is
//! the module `var` `state`, set once by `init` and read through one
//! unsafe accessor, `st()` (px05; px02 returned it from `init` and
//! threaded it through every call, because wolf had no module state
//! until kw09, wolf-lang#529). Layout: a `#[repr(c)]` header,
//! `FrameState`, its fields read and written in place through a
//! `*FrameState` (px16; px05 read and wrote them as `u64`s at their
//! `offset_of`, px02 at literal offsets before kw08), then the bitmaps:
//!
//!     FrameState (64 bytes)
//!       magic   0x50415846524d4553 ("PAXFRMES")
//!       hhdm    the HHDM offset
//!       span    frames 0 .. span-1 are covered (span * 4096 is the
//!               end of the highest usable entry)
//!       usable  frames in usable entries (T)
//!       low     usable frames below 1 MiB, withheld (L)
//!       own     frames holding this state, withheld (S)
//!       free    frames that may be handed out now
//!       hint    the FREE word `alloc` scans first
//!     FREE bitmap at size_of(FrameState), ceil(span / 64) words
//!     then the USABLE bitmap, as many words
//!
//! The state is ordinary memory the kernel owns, so it is read and
//! written with ordinary raw accesses (`*p`); only Limine's words are
//! read volatile (kernel/boot_info).
//!
//! Faults, each `panic.fail` by name (`PANIC frames: … 0x<pa>`, halt):
//! a double free, a free of a frame never usable, a free of a usable
//! frame the allocator withholds (the first MiB, its own state), a free
//! of an address that is not 4 KiB aligned.
//!
//! Written from Limine's PROTOCOL.md (limine-protocol 3a0526b7: the
//! memory map's types, its sorting, usable entries 4 KiB aligned and
//! never overlapping; usable memory mapped in the HHDM at base revision
//! 3 and later) and the author's own knowledge of bitmap allocators. No
//! Linux source; no other kernel consulted.

use boot_info
use log
use panic

/// The allocator's header, at the start of its state (above).
#[repr(c)]
struct FrameState {
    magic: u64,
    hhdm: u64,
    span: u64,
    usable: u64,
    low: u64,
    own: u64,
    free: u64,
    hint: u64,
}

const MAGIC: u64 = 0x50415846524d4553 // "PAXFRMES"
const FRAME: u64 = 4096
const LOW_END: u64 = 1048576 // 1 MiB: below it nothing is handed out
const LOW_FRAMES: u64 = LOW_END / FRAME
const WORD_BITS: u64 = 64
const WORD_BYTES: u64 = 8
const USABLE: u64 = 0 // Limine's memory-map type for usable memory

/// The state's virtual address; 0 until `init`.
var state: u64 = 0

/// The state's virtual address: the one read of `state`.
fn st() -> u64 {
    // # Safety: a read of the module's own `var`, written once by `init`
    // before any other function runs; the kernel is one thread with
    // interrupts off while it allocates.
    unsafe { state }
}

/// One 64-bit word of the allocator's state at virtual address `a`.
fn rd(a: u64) -> u64 {
    // # Safety: `a` is inside the state `init` placed in a usable run
    // it took for itself, mapped by the HHDM and 8-aligned.
    unsafe { *(a as *u64) }
}

/// Write one 64-bit word of the allocator's state.
fn wr(a: u64, v: u64) {
    // # Safety: as `rd`.
    unsafe {
        let p = a as *u64
        *p = v
    }
}

/// The header, at the state's first byte. Its fields are read and
/// written in place, `hdr()[0].free -= 1` (wolf 0.2.26's field store,
/// wolf-lang#577; px05 to px15 went through `offset_of` and a `*u64`).
fn hdr() -> *FrameState {
    // # Safety: a cast only; `st()` is the state `init` placed.
    unsafe { st() as *FrameState }
}

/// The words of one bitmap over `span` frames.
fn words_of(span: u64) -> u64 {
    (span + WORD_BITS - 1) / WORD_BITS
}

fn free_map() -> u64 {
    st() + size_of(FrameState) as u64
}

fn usable_map() -> u64 {
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    free_map() + words_of(unsafe { hdr()[0].span }) * WORD_BYTES
}

/// Bit `f` of the bitmap at `map`.
fn bit(map: u64, f: u64) -> bool {
    (rd(map + f / WORD_BITS * WORD_BYTES) >> (f % WORD_BITS)) & 1 == 1
}

/// Set bit `f` of the bitmap at `map`.
fn set_bit(map: u64, f: u64) {
    let a = map + f / WORD_BITS * WORD_BYTES
    let one: u64 = 1
    wr(a, rd(a) | (one << (f % WORD_BITS)))
}

/// Clear bit `f` of the bitmap at `map` (which must be set).
fn clear_bit(map: u64, f: u64) {
    let a = map + f / WORD_BITS * WORD_BYTES
    let one: u64 = 1
    wr(a, rd(a) ^ (one << (f % WORD_BITS)))
}

/// Why `init` can fail: Limine gave no HHDM response, no memory-map
/// response, or no usable run at or above 1 MiB holds the state.
pub error InitError = {no_hhdm, no_memory_map, no_room}

/// Build the allocator from Limine's memory map and record where its
/// state is (`state`). Returns the state's virtual address. Rows:
/// `no_hhdm` and `no_memory_map` when Limine gave no such response;
/// `no_room` when no usable run at or above 1 MiB holds the state.
pub fn init() -> u64 ! InitError {
    let hhdm = boot_info.hhdm()
    if hhdm == 0 {
        return no_hhdm
    }
    let n = boot_info.memmap_count()
    if n <= 0 {
        return no_memory_map
    }
    // The span: one past the highest usable frame.
    var top: u64 = 0
    var i = 0
    while i < n {
        if boot_info.memmap_type(i) == USABLE {
            let end = boot_info.memmap_base(i) + boot_info.memmap_length(i)
            if end > top {
                top = end
            }
        }
        i += 1
    }
    let span = top / FRAME
    let words = words_of(span)
    let own = (size_of(FrameState) as u64 + words * 2 * WORD_BYTES + FRAME - 1) / FRAME
    // The state's place: the first usable run at or above 1 MiB that
    // holds `own` frames (the map is sorted; usable entries are 4 KiB
    // aligned, so the run's start is a frame).
    var spa: u64 = 0
    i = 0
    while i < n && spa == 0 {
        if boot_info.memmap_type(i) == USABLE {
            var b = boot_info.memmap_base(i)
            let e = b + boot_info.memmap_length(i)
            if b < LOW_END {
                b = LOW_END
            }
            if b < e && e - b >= own * FRAME {
                spa = b
            }
        }
        i += 1
    }
    if spa == 0 {
        return no_room
    }
    // # Safety: the module's own `var`, written here once, before any
    // other function of the module runs.
    unsafe {
        state = hhdm + spa
    }
    // # Safety: the state's first frame, taken above, mapped by the HHDM.
    unsafe { hdr()[0].span = span }
    var w: u64 = 0
    while w < words * 2 {
        wr(free_map() + w * WORD_BYTES, 0)
        w += 1
    }
    let fmap = free_map()
    let umap = usable_map()
    let s0 = spa / FRAME
    let s1 = s0 + own
    var usable: u64 = 0
    var low: u64 = 0
    var held: u64 = 0
    var free_n: u64 = 0
    i = 0
    while i < n {
        if boot_info.memmap_type(i) == USABLE {
            let base = boot_info.memmap_base(i)
            var f = base / FRAME
            let fe = (base + boot_info.memmap_length(i)) / FRAME
            while f < fe {
                set_bit(umap, f)
                usable += 1
                if f < LOW_FRAMES {
                    low += 1
                } else if f >= s0 && f < s1 {
                    held += 1
                } else {
                    set_bit(fmap, f)
                    free_n += 1
                }
                f += 1
            }
        }
        i += 1
    }
    if held != own {
        panic.fail("frames: the allocator's own frames are not all usable at", spa)
    }
    // # Safety: as the `span` store above.
    unsafe {
        let h = hdr()
        h[0].magic = MAGIC
        h[0].hhdm = hhdm
        h[0].usable = usable
        h[0].low = low
        h[0].own = own
        h[0].free = free_n
        h[0].hint = 0
    }
    st()
}

/// `init`, or a named panic for each of its rows: the kernels' entry.
/// Returns the state's virtual address (callers need not keep it: every
/// other function finds the state through `st()`).
pub fn start() -> u64 {
    init() else |e| match e {
        no_hhdm => panic.fail("frames: no HHDM response", 0),
        no_memory_map => panic.fail("frames: no memory map response", 0),
        no_room => panic.fail("frames: no usable run above 1 MiB holds the state", 0),
    }
}

/// Write the totals line:
/// `frames: T usable, L below 1 MiB, S allocator, F free`.
pub fn report() {
    log.put("frames: ")
    log.dec(usable() as int)
    log.put(" usable, ")
    log.dec(low() as int)
    log.put(" below 1 MiB, ")
    log.dec(own() as int)
    log.put(" allocator, ")
    log.dec(free_count() as int)
    log.put(" free")
    log.end()
}

/// Hand out one free frame: its physical address, a multiple of 4096,
/// at or above 1 MiB, inside a usable entry, never one already handed
/// out and not freed since. Row `out_of_memory` when no frame is free.
pub fn alloc() -> u64 ! {out_of_memory} {
    let h = hdr()
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    let words = words_of(unsafe { h[0].span })
    let fmap = free_map()
    // # Safety: as above.
    var w = unsafe { h[0].hint }
    var k: u64 = 0
    while k < words {
        if w >= words {
            w = 0
        }
        let x = rd(fmap + w * WORD_BYTES)
        if x != 0 {
            var b: u64 = 0
            while (x >> b) & 1 == 0 {
                b += 1
            }
            let f = w * WORD_BITS + b
            clear_bit(fmap, f)
            // # Safety: as above.
            unsafe {
                h[0].free -= 1
                h[0].hint = w
            }
            return f * FRAME
        }
        w += 1
        k += 1
    }
    return out_of_memory
}

/// Give frame `pa` back. Panics by name (and never returns) on an
/// address that is not 4 KiB aligned, a frame never usable, a usable
/// frame the allocator withholds (below 1 MiB, its own state), and a
/// frame that is already free (a double free).
pub fn free(pa: u64) {
    if pa % FRAME != 0 {
        panic.fail("frames: free of an unaligned address", pa)
    }
    let f = pa / FRAME
    if f >= span() || !bit(usable_map(), f) {
        panic.fail("frames: free of a frame never usable", pa)
    }
    let spa = state_phys()
    if pa < LOW_END || (pa >= spa && pa < spa + own() * FRAME) {
        panic.fail("frames: free of a withheld frame", pa)
    }
    if bit(free_map(), f) {
        panic.fail("frames: double free", pa)
    }
    set_bit(free_map(), f)
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    unsafe { hdr()[0].hint += 1 }
}

/// Frames in the map's usable entries (T).
pub fn usable() -> u64 {
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    unsafe { hdr()[0].usable }
}

/// Usable frames below 1 MiB, never handed out (L).
pub fn low() -> u64 {
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    unsafe { hdr()[0].low }
}

/// Frames holding the allocator's own state, never handed out (S).
pub fn own() -> u64 {
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    unsafe { hdr()[0].own }
}

/// Frames that may be handed out now.
pub fn free_count() -> u64 {
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    unsafe { hdr()[0].free }
}

/// The physical address of the allocator's state (its first frame).
pub fn state_phys() -> u64 {
    st() - hhdm()
}

/// The HHDM offset the allocator reaches its state and frames through
/// (px03: kernel/paging reaches page tables the same way).
pub fn hhdm() -> u64 {
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    unsafe { hdr()[0].hhdm }
}

/// The span: frame numbers below it are covered by the bitmaps.
pub fn span() -> u64 {
    // # Safety: the header `init` wrote (`hdr`), mapped by the HHDM.
    unsafe { hdr()[0].span }
}
