//! Pure USB topology fields shared by the driver and invariant kernel.
//! Keeping these independent of MMIO avoids compiling the whole OS for
//! arithmetic/report invariants; the hardware suite still builds the OS.

/// USB3 §8.9; xHCI §6.2.2 requires this for every device speed.
/// 0x100000 is an invalid route sentinel, never handed to the controller.
pub fn route_child(route: u64, depth: u64, port: u64) -> u64 {
    if depth >= 5 || port == 0 || port > 255 { return 0x100000 }
    route | ((if port > 15 { 15 } else { port }) << (depth * 4))
}

/// xHCI §6.2.2: low/full-speed descendants inherit the closest high-speed
/// transaction translator and its physical downstream port. High-speed
/// devices themselves do not name a TT. Hubs use their default single-TT
/// alternate setting; MTT remains clear.
pub fn tt_route(speed: u64, parent_speed: u64, parent_slot: u64, port: u64, inherited: u64) -> u64 {
    if speed != 1 && speed != 2 { return 0 }
    if parent_speed == 3 { parent_slot | (port << 8) } else { inherited }
}

