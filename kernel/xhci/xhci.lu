//! xHCI 1.2 host controller, USB 2 hubs and HID boot keyboards (px74).
//! Written from xHCI 1.2 §§4.2–4.3, 4.9, 4.17, 4.20, 5–7; USB 2.0
//! §§9,11; USB 3.2 §8.9; HID 1.11 §§7.2 and appendices B/C. No driver
//! source consulted. One event ring/interrupter per controller, INTx.
//! Enumeration runs in a kernel thread; IRQs allocate nothing. All DMA
//! accesses are volatile; x86 coherent memory and ordered stores publish
//! a TRB's cycle word last. A timeout quarantines DMA memory, never frees
//! a buffer the controller might still own. Bounds: four controllers,
//! 32 slots each, five hub hops, one boot keyboard interface per device.
//! px78: USB mass storage's transport, the Bulk-Only Transport's pipes
//! (USB Mass Storage Class Bulk-Only Transport 1.0 §§3, 5, 6; xHCI 1.2
//! §§4.6.6, 4.6.8, 4.6.10, 4.11.2.1, 4.11.5.1, 6.2.3 and 6.4.1.1; USB 3.2
//! §9.6.7): an interface of class 08h, subclass 06h (SCSI transparent),
//! protocol 50h at any speed, SuperSpeed included, its bulk IN and OUT
//! endpoints configured (the SuperSpeed companion's bMaxBurst), one TD
//! at a time a pipe, polled to a kernel/clock deadline with IF clear as
//! kernel/ahci's commands are; the SCSI commands are kernel/usb_storage's.
//! At most four storage devices, found at enumeration; a halted pipe is
//! reset (Reset Endpoint, Set TR Dequeue Pointer, CLEAR_FEATURE).
use apic
use clock
use console
use frames
use log
use paging
use pci
use sched
use sync
use timer
use usb_keys
use usb_topology

extern "c" fn pax_outb(port: u16, value: u8)
extern "c" fn pax_inb(port: u16) -> u8

var first: u64 = 0
var initialized: u64 = 0
var held: u64 = 0

const BASE: u64 = 0xffffb00004000000
const WINDOW: u64 = 0x100000
const SLOTS: u64 = 32
// Controller words; slot pointers begin at byte 512.
const NEXT: u64 = 0
const CAP: u64 = 1
const OP: u64 = 2
const RT: u64 = 3
const DB: u64 = 4
const PORTS: u64 = 5
const NSLOT: u64 = 6
const CSZ: u64 = 7
const CMD: u64 = 8
const CI: u64 = 9
const CC: u64 = 10
const EVENT: u64 = 11
const EI: u64 = 12
const EC: u64 = 13
const DCBAA: u64 = 14
const VECTOR: u64 = 15
const DONE: u64 = 16
const WAIT: u64 = 17
const RESULT: u64 = 18
const LIVE: u64 = 19
const NUMBER: u64 = 20
// Device words; controller owns a page per slot, reused only after Disable Slot.
const SLOT: u64 = 0
const HOST: u64 = 1
const PARENT: u64 = 2
const PORT: u64 = 3
const ROOT: u64 = 4
const ROUTE: u64 = 5
const DEPTH: u64 = 6
const SPEED: u64 = 7
const OUTPUT: u64 = 8
const INPUT: u64 = 9
const CTRL: u64 = 10
const TI: u64 = 11
const TC: u64 = 12
const INTR: u64 = 13
const II: u64 = 14
const IC: u64 = 15
const BUFFER: u64 = 16
const ENDPOINT: u64 = 17
const PACKET: u64 = 18
const INTERVAL: u64 = 19
const KIND: u64 = 20 // 1 keyboard, 2 USB2 hub, 3 not driven, 4 failed, 5 mass storage (px78), 6 storage gone
const PREVIOUS: u64 = 21
const REPEAT: u64 = 22
const DEADLINE: u64 = 23
const TDONE: u64 = 24
const COMPLETION: u64 = 25
const EXPECT: u64 = 26
const HUBPORTS: u64 = 27
const TT: u64 = 28
const ACTIVE: u64 = 29
const RESIDUE: u64 = 30
const ACTUAL: u64 = 31
// px78: a mass-storage device's words (KIND 5). The bulk IN pipe's DCI,
// ring, enqueue index and cycle, max packet; the OUT pipe's; the TD in
// flight: its pipe's DCI, the physical TRB its event names, done, the
// event's completion code and residue; the interface; the endpoint
// addresses (CLEAR_FEATURE's index); the configuration value.
const BIN: u64 = 32
const BIRING: u64 = 33
const BII: u64 = 34
const BIC: u64 = 35
const BIMPS: u64 = 36
const BOUT: u64 = 37
const BORING: u64 = 38
const BOI: u64 = 39
const BOC: u64 = 40
const BOMPS: u64 = 41
const BEP: u64 = 42
const BFIRST: u64 = 43 // the TD's first TRB (physical)
const BEXPECT: u64 = 44 // the TD's last TRB (physical)
const BDONE: u64 = 45
const BCODE: u64 = 46
const BREST: u64 = 47
const IFACE: u64 = 48
const BIADDR: u64 = 49
const BOADDR: u64 = 50
const BBURST: u64 = 51 // bulk IN burst << 8 | bulk OUT burst
// px78: the storage devices found (at most four), a page: count at 0,
// device records from 1.
var storage: u64 = 0
const STORAGE_MAX: u64 = 4

fn r8(a: u64) -> u64 { unsafe { (a as *u8).read_volatile() as u64 } }
fn r32(a: u64) -> u64 { unsafe { (a as *u32).read_volatile() as u64 } }
fn r64(a: u64) -> u64 { unsafe { (a as *u64).read_volatile() } }
fn w8(a: u64, v: u64) { unsafe { (a as *u8).write_volatile((v & 255) as u8) } }
fn w32(a: u64, v: u64) { unsafe { (a as *u32).write_volatile((v & 0xffffffff) as u32) } }
fn w64(a: u64, v: u64) { unsafe { (a as *u64).write_volatile(v) } }
fn get(a: u64, i: u64) -> u64 { r64(a + i * 8) }
fn put(a: u64, i: u64, v: u64) { w64(a + i * 8, v) }
fn pa(a: u64) -> u64 { a - frames.hhdm() }
fn zero(a: u64, n: u64) {
    var i: u64 = 0
    while i < n { w64(a + i, 0); i += 8 }
}
fn page() -> u64 {
    let saved = sync.irq_save()
    let p = frames.alloc() else 0
    if p == 0 { sync.irq_restore(saved); return 0 }
    // A common low-DMA allocation policy also covers AC64=0 controllers.
    // The allocator currently hands out low frames first. Never truncate.
    if p >= 0x100000000 { frames.free(p); sync.irq_restore(saved); return 0 }
    let a = p + frames.hhdm()
    zero(a, 4096)
    sync.irq_restore(saved)
    a
}
fn head() -> u64 { unsafe { first } }
fn device(c: u64, slot: u64) -> u64 {
    if slot == 0 || slot > get(c, NSLOT) { return 0 }
    r64(c + 512 + slot * 8)
}
fn say_error(c: u64, why: str, detail: u64) {
    let s = sync.acquire(sync.console())
    log.put("xhci "); log.dec(get(c, NUMBER) as int)
    log.put(": "); log.put(why); log.put(" "); log.hex(detail); log.end()
    sync.release(sync.console(), s)
}

fn trb(a: u64, parameter: u64, status: u64, control: u64) {
    w64(a, parameter)
    w32(a + 8, status)
    w32(a + 12, control)
}

// 255 payload TRBs plus a Link TRB. At most one TD outstanding on a ring;
// no full-ring ambiguity. The link toggles the consumer cycle (TC=1).
fn enqueue(owner: u64, ringword: u64, indexword: u64, cycleword: u64,
           parameter: u64, status: u64, control: u64) -> u64 {
    let ring = get(owner, ringword)
    var index = get(owner, indexword)
    var cycle = get(owner, cycleword)
    if index == 255 {
        trb(ring + 255 * 16, pa(ring), 0, (6 << 10) | 2 | cycle)
        index = 0
        cycle ^= 1
        put(owner, cycleword, cycle)
    }
    let at = ring + index * 16
    trb(at, parameter, status, control | cycle)
    put(owner, indexword, index + 1)
    pa(at)
}

fn key(usage: u64, down: bool) {
    let a = unsafe { held }
    let code = usb_keys.code(usage)
    if a == 0 || usage > 255 || code == 0 { return }
    let count = r64(a + usage * 8)
    if down {
        w64(a + usage * 8, count + 1)
        if count == 0 { console.key_event(code, true, true) }
    } else if count > 0 {
        w64(a + usage * 8, count - 1)
        if count == 1 { console.key_event(code, false, true) }
    }
}

fn report(d: u64, value: u64) {
    if !usb_keys.valid(value) { return }
    let old = get(d, PREVIOUS)
    var i: u64 = 0
    // Releases first; modifiers before new ordinary keys. Reordered arrays
    // and duplicate usages do not generate repeated presses.
    while i < 6 {
        let usage = usb_keys.key_at(old, i)
        if usage != 0 && !usb_keys.contains(value, usage) {
            var earlier = false
            var j: u64 = 0
            while j < i { if usb_keys.key_at(old, j) == usage { earlier = true }; j += 1 }
            if !earlier { key(usage, false) }
        }
        i += 1
    }
    i = 0
    while i < 8 {
        let mask: u64 = 1 << i
        if old & mask != value & mask { key(0xe0 + i, value & mask != 0) }
        i += 1
    }
    if !usb_keys.contains(value, get(d, REPEAT)) { put(d, REPEAT, 0) }
    i = 0
    while i < 6 {
        let usage = usb_keys.key_at(value, i)
        if usage != 0 && !usb_keys.contains(old, usage) {
            var earlier = false
            var j: u64 = 0
            while j < i { if usb_keys.key_at(value, j) == usage { earlier = true }; j += 1 }
            if !earlier {
                key(usage, true)
                if usb_keys.repeats(usage) {
                    put(d, REPEAT, usage)
                    put(d, DEADLINE, timer.ticks() * 10 + 250)
                }
            }
        }
        i += 1
    }
    put(d, PREVIOUS, value)
}

fn arm(d: u64) {
    let c = get(d, HOST)
    let at = enqueue(d, INTR, II, IC, pa(get(d, BUFFER) + 2048), 8, (1 << 10) | 32 | 4)
    put(d, EXPECT, at)
    w32(get(c, DB) + get(d, SLOT) * 4, get(d, ENDPOINT))
}

/// Drain events with IF clear, both from IRQ and command waiter. The ERDP
/// write clears Event Handler Busy; USBSTS.EINT precedes IMAN.IP (RW1C).
fn drain(c: u64) {
    if get(c, LIVE) == 0 { return }
    var count: u64 = 0
    var index = get(c, EI)
    var cycle = get(c, EC)
    while count < 256 {
        let e = get(c, EVENT) + index * 16
        let control = r32(e + 12)
        if control & 1 != cycle { break }
        let param = r64(e)
        let status = r32(e + 8)
        let kind = (control >> 10) & 63
        let code = status >> 24
        if kind == 33 && param & !15 == get(c, WAIT) {
            put(c, RESULT, (control & 0xff000000) | code)
            put(c, DONE, 1)
        } else if kind == 32 {
            let d = device(c, control >> 24)
            if d != 0 && get(d, ACTIVE) != 0 {
                let ep = (control >> 16) & 31
                if ep == 1 {
                    if code == 13 { put(d, RESIDUE, status & 0xffffff) }
                    else if code != 1 || param & !15 == get(d, COMPLETION) {
                        put(d, COMPLETION, code)
                        put(d, TDONE, 1)
                    }
                } else if get(d, KIND) == 5 && ep == get(d, BEP) && get(d, BDONE) == 0 {
                    bulk_event(d, param & !15, code, status & 0xffffff)
                } else if ep == get(d, ENDPOINT) && param & !15 == get(d, EXPECT) {
                    if get(d, KIND) == 1 && (code == 1 || code == 13) && status & 0xffffff == 0 {
                        report(d, r64(get(d, BUFFER) + 2048))
                    }
                    if get(d, KIND) == 1 && (code == 1 || code == 13) { arm(d) }
                    else if get(d, KIND) == 1 {
                        report(d, 0)
                        put(d, KIND, 4) // no repeat or stuck modifier after a halted endpoint
                    }
                }
            }
        }
        // Port Status Change events are consumed here; the enumeration
        // thread reads PORTSC and hub status, so no sleeping in an IRQ.
        index += 1
        if index == 256 { index = 0; cycle ^= 1 }
        count += 1
    }
    // §5.5.2.3.3 forbids consecutive identical ERDP writes unless a
    // complete ring was consumed. A polling waiter often finds no event.
    if count == 0 { return }
    put(c, EI, index); put(c, EC, cycle)
    w32(get(c, OP) + 4, 8)
    w32(get(c, RT), 3)
    w64(get(c, RT) + 24, pa(get(c, EVENT) + index * 16) | 8)
}

pub fn irq(v: u64) -> bool {
    var matched = false
    var c = head()
    while c != 0 {
        if get(c, LIVE) != 0 && get(c, VECTOR) == v { drain(c); matched = true }
        c = get(c, NEXT)
    }
    matched
}

/// 100 Hz tick: software repeat, not repeated identical HID reports.
pub fn tick() {
    var c = head()
    while c != 0 {
        if get(c, LIVE) != 0 {
            var slot: u64 = 1
            while slot <= get(c, NSLOT) {
                let d = device(c, slot)
                if d != 0 && get(d, ACTIVE) != 0 && get(d, KIND) == 1 {
                    let usage = get(d, REPEAT)
                    let now = timer.ticks() * 10
                    if usage != 0 && now >= get(d, DEADLINE) {
                        console.key_event(usb_keys.code(usage), true, true)
                        // Linux's measured 33ms setting, on a 10ms clock:
                        // carry the fractional tick rather than round to 30.
                        // Never emit a burst to catch up after a long stall.
                        let next = get(d, DEADLINE) + 33
                        put(d, DEADLINE, if next <= now { now + 33 } else { next })
                    }
                }
                slot += 1
            }
        }
        c = get(c, NEXT)
    }
}

fn command(c: u64, parameter: u64, control: u64) -> u64 {
    if get(c, LIVE) == 0 { return 0 }
    let saved = sync.irq_save()
    put(c, DONE, 0)
    let at = enqueue(c, CMD, CI, CC, parameter, 0, control)
    put(c, WAIT, at)
    w32(get(c, DB), 0)
    sync.irq_restore(saved)
    let until = timer.ticks() + 200
    while timer.ticks() < until {
        let s = sync.irq_save()
        drain(c)
        let done = get(c, DONE)
        let result = get(c, RESULT)
        sync.irq_restore(s)
        if done != 0 { return result }
        let _n = sched.sleep(1)
    }
    // Stop submissions on a command timeout: a late completion must never
    // be confused with another command, nor may DMA memory be recycled.
    put(c, LIVE, 0)
    w32(get(c, OP), 0)
    say_error(c, "command timeout; controller quarantined", control)
    0
}

fn control(d: u64, request_type: u64, request: u64, value: u64, index: u64, length: u64) -> bool {
    let c = get(d, HOST)
    if length > 1024 || get(c, LIVE) == 0 || get(d, ACTIVE) == 0 { return false }
    let buffer = get(d, BUFFER)
    zero(buffer, 1024)
    let saved = sync.irq_save()
    put(d, TDONE, 0); put(d, RESIDUE, 0)
    let setup = request_type | (request << 8) | (value << 16) | (index << 32) | (length << 48)
    let direction = request_type & 128 != 0
    let trt: u64 = if length == 0 { 0 } else { if direction { 3 } else { 2 } }
    let _setup = enqueue(d, CTRL, TI, TC, setup, 8, (2 << 10) | 64 | (trt << 16))
    if length != 0 {
        let _data = enqueue(d, CTRL, TI, TC, pa(buffer), length, (3 << 10) | 4 | (if direction { 1 << 16 } else { 0 }))
    }
    let end = enqueue(d, CTRL, TI, TC, 0, 0, (4 << 10) | 32 | (if length == 0 || !direction { 1 << 16 } else { 0 }))
    put(d, COMPLETION, end)
    w32(get(c, DB) + get(d, SLOT) * 4, 1)
    sync.irq_restore(saved)
    let until = timer.ticks() + 200
    var completed = false
    var completion: u64 = 0
    while timer.ticks() < until {
        let s = sync.irq_save()
        drain(c)
        let done = get(d, TDONE)
        let code = get(d, COMPLETION)
        sync.irq_restore(s)
        if done != 0 {
            completed = true
            completion = code
            break
        }
        let _n = sched.sleep(1)
    }
    if completed {
        let remaining = get(d, RESIDUE)
        put(d, ACTUAL, if remaining <= length { length - remaining } else { 0 })
        if completion == 1 { return true }
    } else {
        put(d, KIND, 4)
    }
    // One formatter site for both failure paths; no change to timeout or
    // completion handling, and successful transfers still report nothing.
    say_error(c, if completed { "control transfer completion" } else { "control transfer timeout" },
              if completed { completion } else { get(d, SLOT) })
    false
}

fn copy_context(dst: u64, src: u64, n: u64) {
    var i: u64 = 0
    while i < n { w64(dst + i, r64(src + i)); i += 8 }
}
fn input_slot(d: u64, entries: u64) {
    let c = get(d, HOST)
    let at = get(d, INPUT) + get(c, CSZ)
    w32(at, get(d, ROUTE) | (get(d, SPEED) << 20) | (entries << 27))
    w32(at + 4, get(d, ROOT) << 16)
    w32(at + 8, get(d, TT))
}
fn endpoint(at: u64, ring: u64, size: u64, kind: u64, interval: u64) {
    w32(at, interval << 16)
    w32(at + 4, (size << 16) | (kind << 3) | 6)
    w64(at + 8, pa(ring) | 1)
    w32(at + 16, if kind == 4 { 8 } else { (size << 16) | size })
}
fn path(d: u64) {
    let c = get(d, HOST)
    log.put("usb"); log.dec(get(c, NUMBER) as int); log.put("-")
    log.dec(get(d, ROOT) as int)
    var i: u64 = 0
    while i < get(d, DEPTH) {
        log.put("."); log.dec(((get(d, ROUTE) >> (i * 4)) & 15) as int)
        i += 1
    }
}

fn configure(d: u64) -> bool {
    let c = get(d, HOST)
    let buf = get(d, BUFFER)
    if !control(d, 128, 6, 0x100, 0, 8) || get(d, ACTUAL) < 8 { return false }
    let mps = r8(buf + 7)
    if get(d, SPEED) == 1 && (mps == 8 || mps == 16 || mps == 32 || mps == 64) {
        let input = get(d, INPUT)
        zero(input, 4096)
        w32(input + 4, 2)
        let ep = input + get(c, CSZ) * 2
        copy_context(ep, get(d, OUTPUT) + get(c, CSZ), get(c, CSZ))
        w32(ep + 4, (r32(ep + 4) & 0xffff) | (mps << 16))
        if command(c, pa(input), (13 << 10) | (get(d, SLOT) << 24)) & 255 != 1 { return false }
    }
    if !control(d, 128, 6, 0x100, 0, 18) || get(d, ACTUAL) < 18 { return false }
    let device_class = r8(buf + 4)
    let product = r8(buf + 15)
    // String 0 supplies a language, then iProduct is fetched in that
    // language. Optional string failures are not silently recovered by
    // writing a halted endpoint; unsupported strings are simply not asked
    // for when the device advertises iProduct = 0.
    if product != 0 {
        if !control(d, 128, 6, 0x300, 0, 255) { return false }
        if get(d, ACTUAL) >= 4 && r8(buf + 1) == 3 {
            let language = r8(buf + 2) | (r8(buf + 3) << 8)
            if !control(d, 128, 6, 0x300 | product, language, 255) { return false }
        }
    }
    if !control(d, 128, 6, 0x200, 0, 9) || get(d, ACTUAL) < 9 { return false }
    let total = r8(buf + 2) | (r8(buf + 3) << 8)
    if total < 9 || total > 1024 { return false }
    if !control(d, 128, 6, 0x200, 0, total) || get(d, ACTUAL) != total { return false }
    let config = r8(buf + 5)
    // px78: a mass-storage interface is driven at every speed.
    let (is_storage, iface, ia, im, oa, om, bursts) = storage_interface(buf, total)
    if is_storage { return drive_storage(d, config, iface, ia, im, oa, om, bursts) }
    if get(d, SPEED) >= 4 {
        put(d, KIND, 3)
        let s = sync.acquire(sync.console())
        log.put("xhci: "); path(d); log.line(" SuperSpeed enumerated, not driven")
        sync.release(sync.console(), s)
        return true
    }
    var interface: u64 = 0
    var selected: u64 = 0
    var kind: u64 = 0
    var at: u64 = 0
    var ep: u64 = 0
    var packet: u64 = 0
    var interval: u64 = 0
    while at + 2 <= total {
        let length = r8(buf + at)
        let dtype = r8(buf + at + 1)
        if length < 2 || at + length > total { return false }
        if dtype == 4 && length >= 9 {
            selected = 0
            if r8(buf + at + 3) == 0 {
                if r8(buf + at + 5) == 9 || device_class == 9 { selected = 2 }
                if r8(buf + at + 5) == 3 && r8(buf + at + 6) == 1 && r8(buf + at + 7) == 1 { selected = 1 }
                if selected != 0 && kind == 0 { interface = r8(buf + at + 2) }
            }
        } else if dtype == 5 && length >= 7 && selected != 0 && kind == 0 {
            let address = r8(buf + at + 2)
            if address & 128 != 0 && address & 15 != 0 && r8(buf + at + 3) & 3 == 3 {
                ep = (address & 15) * 2 + 1
                packet = r8(buf + at + 4) | (r8(buf + at + 5) << 8)
                interval = r8(buf + at + 6)
                kind = selected
            }
        }
        at += length
    }
    if kind == 0 { put(d, KIND, 3); return true }
    if interval == 0 || packet == 0 || (kind == 1 && packet < 8) || packet > 1024 { return false }
    if !control(d, 0, 9, config, 0, 0) { return false }
    var ports: u64 = 0
    var think: u64 = 0
    var power: u64 = 0
    if kind == 2 {
        if !control(d, 0xa0, 6, 0x2900, 0, 9) || get(d, ACTUAL) < 7 { return false }
        ports = r8(buf + 2)
        if ports == 0 || ports > 31 { return false }
        think = (r8(buf + 3) >> 5) & 3
        power = r8(buf + 5)
        put(d, HUBPORTS, ports)
    }
    let input = get(d, INPUT)
    zero(input, 4096)
    w32(input + 4, 1 | (1 << ep))
    input_slot(d, ep)
    let slot = input + get(c, CSZ)
    if kind == 2 {
        w32(slot, r32(slot) | (1 << 26))
        w32(slot + 4, r32(slot + 4) | (ports << 24))
        if get(d, SPEED) == 3 { w32(slot + 8, r32(slot + 8) | (think << 16)) }
    }
    var exponent: u64 = 3
    if get(d, SPEED) == 3 {
        if interval > 16 { return false }
        exponent = interval - 1
    } else {
        var n: u64 = 1
        while n * 2 <= interval { n *= 2; exponent += 1 }
    }
    endpoint(input + (ep + 1) * get(c, CSZ), get(d, INTR), packet, 7, exponent)
    if command(c, pa(input), (12 << 10) | (get(d, SLOT) << 24)) & 255 != 1 { return false }
    put(d, ENDPOINT, ep); put(d, PACKET, packet); put(d, INTERVAL, exponent)
    if kind == 1 {
        if !control(d, 0x21, 11, 0, interface, 0) { return false }
        if !control(d, 0x21, 10, 0, interface, 0) { return false }
        let s = sync.irq_save()
        put(d, KIND, 1)
        arm(d)
        sync.irq_restore(s)
        let saved = sync.acquire(sync.console())
        log.put("xhci: keyboard "); path(d); log.put(" speed ")
        log.dec(get(d, SPEED) as int); log.line(" boot report 8")
        sync.release(sync.console(), saved)
    } else {
        put(d, KIND, 2)
        var p: u64 = 1
        while p <= ports {
            if !control(d, 0x23, 3, 8, p, 0) { return false }
            p += 1
        }
        let _n = sched.sleep((power * 2 + 9) / 10 + 1)
        let saved = sync.acquire(sync.console())
        log.put("xhci: hub "); path(d); log.put(" ports "); log.dec(ports as int); log.end()
        sync.release(sync.console(), saved)
    }
    true
}

// --- px78: mass storage's pipes ------------------------------------------

/// The TD in flight on a storage device's pipe ends at its last TRB's
/// event (success, or a short packet there) or at an error event on any
/// of its TRBs (a stall, babble or transaction error halts the pipe,
/// xHCI §4.10.2). TDs never cross the ring's link (`room`), so the TD's
/// TRBs are BFIRST..BEXPECT in order.
fn bulk_event(d: u64, trb: u64, code: u64, residue: u64) {
    if trb < get(d, BFIRST) || trb > get(d, BEXPECT) { return }
    if trb == get(d, BEXPECT) || code != 1 {
        put(d, BCODE, code)
        put(d, BREST, residue)
        put(d, BDONE, 1)
    }
}

/// Make room for `n` TRBs before the ring's end: when they would not fit
/// before entry 255, a Link TRB (TC set) at the enqueue index sends the
/// controller back to the ring's start now, so no TD crosses a link
/// (xHCI §4.11.5.1 would need the chain bit on it). The entries after
/// that link are written empty with this lap's cycle bit: the next lap's
/// cycle is the other one, so none of them (TRBs two laps old, whose bit
/// would match it again) can ever be taken for a new TRB (§4.9.2).
fn room(owner: u64, ringword: u64, indexword: u64, cycleword: u64, n: u64) {
    let index = get(owner, indexword)
    if index + n <= 255 { return }
    let ring = get(owner, ringword)
    let cycle = get(owner, cycleword)
    var k = index + 1
    while k <= 255 { trb(ring + k * 16, 0, 0, cycle); k += 1 }
    trb(ring + index * 16, pa(ring), 0, (6 << 10) | 2 | cycle)
    put(owner, indexword, 0)
    put(owner, cycleword, cycle ^ 1)
}

/// Whether `d` is a storage device whose pipes take transfers.
fn storage_live(d: u64) -> bool {
    d != 0 && get(d, ACTIVE) != 0 && get(d, KIND) == 5 && get(get(d, HOST), LIVE) != 0
}

/// How many storage devices enumeration found (each a device record).
fn storage_count() -> u64 {
    let t = unsafe { storage }
    if t == 0 { 0 } else { get(t, 0) }
}

/// Storage device `i`'s record, 0 past the last.
fn storage_dev(i: u64) -> u64 {
    if i >= storage_count() { 0 } else { get(unsafe { storage }, 1 + i) }
}

/// One bulk transfer on storage device `d`: `n` bytes in (`inward`) or
/// out, over the pages listed at kernel address `list` (physical
/// addresses, the data page after page), or with `list` 0 the physical
/// range at `at` inside one page. Normal TRBs, one a page piece, chained,
/// the last with IOC (and ISP inward), TD Size counting the packets left
/// (xHCI §4.11.2.4); the doorbell names the pipe's DCI. Polled with IF
/// clear to a kernel/clock deadline `us` microseconds away. (completion
/// code, bytes moved): 1 success, 13 short packet, 6 stall, any other
/// code the controller's; 0 a timeout, a dead controller or a bad buffer.
fn bulk(d: u64, inward: bool, list: u64, at: u64, n: u64, us: u64) -> (u64, u64) {
    if !storage_live(d) || n == 0 || n > 0x100000 { return (0, 0) }
    let c = get(d, HOST)
    let ring = if inward { BIRING } else { BORING }
    let index = if inward { BII } else { BOI }
    let cycle = if inward { BIC } else { BOC }
    let dci = get(d, if inward { BIN } else { BOUT })
    let mps = get(d, if inward { BIMPS } else { BOMPS })
    // kernel/block's pieces, as kernel/ahci takes them: a page each (the
    // last the rest), each inside its page; with no list, one range.
    if list == 0 && n > 4096 - at % 4096 { return (0, 0) }
    let pieces = if list == 0 { 1 } else { (n + 4095) / 4096 }
    if pieces > 64 { return (0, 0) }
    var left = n
    var p: u64 = 0
    while p < pieces {
        let a = if list == 0 { at } else { r64(list + p * 8) }
        let k = if left < 4096 { left } else { 4096 }
        if a == 0 || k > 4096 - a % 4096 { return (0, 0) }
        if a >= 0x100000000 && r32(get(c, CAP) + 0x10) & 1 == 0 { return (0, 0) }
        left -= k
        p += 1
    }
    let saved = sync.irq_save()
    room(d, ring, index, cycle, pieces)
    put(d, BDONE, 0); put(d, BCODE, 0); put(d, BREST, 0); put(d, BEP, dci)
    left = n
    var i: u64 = 0
    var last: u64 = 0
    while i < pieces {
        let a = if list == 0 { at } else { r64(list + i * 8) }
        let k = if left < 4096 { left } else { 4096 }
        let after = left - k
        let packets = (after + mps - 1) / mps
        let size = if packets > 31 { 31 } else { packets }
        let end = i + 1 == pieces
        let flags = (1 << 10) | (if end { 32 | (if inward { 4 } else { 0 }) } else { 16 })
        let t = enqueue(d, ring, index, cycle, a, k | (size << 17), flags)
        if i == 0 { put(d, BFIRST, t) }
        last = t
        left = after
        i += 1
    }
    put(d, BEXPECT, last)
    w32(get(c, DB) + get(d, SLOT) * 4, dci)
    let deadline = clock.deadline_us(us)
    while get(d, BDONE) == 0 && !clock.expired(deadline) && get(c, LIVE) != 0 {
        drain(c)
        if get(d, BDONE) == 0 { sync.relax() }
    }
    let done = get(d, BDONE) != 0
    let code = get(d, BCODE)
    let residue = get(d, BREST)
    // A late event for this TD must never complete the next one.
    put(d, BEP, 0)
    if !done {
        // The endpoint's output context names its state and dequeue
        // pointer (xHCI §6.2.3): what a timeout's line reports.
        let ctx = get(d, OUTPUT) + dci * get(c, CSZ)
        log.put("xhci: storage "); path(d)
        log.put(if get(c, LIVE) == 0 { ": controller quarantined" } else { ": bulk transfer timeout" })
        log.put(", DCI "); log.dec(dci as int)
        log.put(" state "); log.dec((r32(ctx) & 7) as int)
        log.put(" dequeue "); log.hex(r64(ctx + 8))
        log.put(" TD "); log.hex(get(d, BFIRST)); log.put(".."); log.hex(get(d, BEXPECT))
        log.put(" USBSTS "); log.hex(r32(get(c, OP) + 4))
        log.end()
    }
    sync.irq_restore(saved)
    if !done { return (0, 0) }
    // The event's length is the last TRB's residue (xHCI §4.10.1.1); a
    // short TD of one piece moved its length less that; a short TD of
    // several pieces is refused as a whole by kernel/usb_storage.
    let moved = if code == 1 { n } else if code == 13 && pieces == 1 && residue <= n { n - residue } else { 0 }
    (code, moved)
}

/// A command on the command ring, polled with IF clear to a kernel/clock
/// deadline (`command` sleeps between looks, which a system call with IF
/// clear cannot). Its completion's (slot << 24 | code), 0 on a timeout,
/// which quarantines the controller as `command`'s does.
fn command_now(c: u64, parameter: u64, control: u64) -> u64 {
    if get(c, LIVE) == 0 { return 0 }
    let saved = sync.irq_save()
    put(c, DONE, 0)
    let at = enqueue(c, CMD, CI, CC, parameter, 0, control)
    put(c, WAIT, at)
    w32(get(c, DB), 0)
    let deadline = clock.deadline_us(2000000)
    while get(c, DONE) == 0 && !clock.expired(deadline) { drain(c); sync.relax() }
    let done = get(c, DONE) != 0
    let result = get(c, RESULT)
    sync.irq_restore(saved)
    if done { return result }
    put(c, LIVE, 0)
    w32(get(c, OP), 0)
    say_error(c, "command timeout; controller quarantined", control)
    0
}

/// A control request with no data stage, polled with IF clear to a
/// kernel/clock deadline (CLEAR_FEATURE, the Bulk-Only reset): whether it
/// completed with success.
fn control_now(d: u64, request_type: u64, request: u64, value: u64, index: u64) -> bool {
    let c = get(d, HOST)
    if get(c, LIVE) == 0 || get(d, ACTIVE) == 0 { return false }
    let saved = sync.irq_save()
    put(d, TDONE, 0); put(d, RESIDUE, 0)
    let setup = request_type | (request << 8) | (value << 16) | (index << 32)
    let _setup = enqueue(d, CTRL, TI, TC, setup, 8, (2 << 10) | 64)
    let end = enqueue(d, CTRL, TI, TC, 0, 0, (4 << 10) | 32 | (1 << 16))
    put(d, COMPLETION, end)
    w32(get(c, DB) + get(d, SLOT) * 4, 1)
    let deadline = clock.deadline_us(2000000)
    while get(d, TDONE) == 0 && !clock.expired(deadline) { drain(c); sync.relax() }
    let ok = get(d, TDONE) != 0 && get(d, COMPLETION) == 1
    sync.irq_restore(saved)
    ok
}

/// Clear a halted pipe of storage device `d` (BOT §6.6.2 and §5.3.4): the
/// controller's Reset Endpoint (xHCI §4.6.8, TSP 0), its dequeue moved to
/// the ring's enqueue position with the ring's cycle (Set TR Dequeue
/// Pointer, §4.6.10), then the device's CLEAR_FEATURE(ENDPOINT_HALT)
/// (USB 2.0 §9.4.1). Whether all three completed.
fn clear_halt(d: u64, inward: bool) -> bool {
    if !storage_live(d) { return false }
    let c = get(d, HOST)
    let dci = get(d, if inward { BIN } else { BOUT })
    let slot = get(d, SLOT)
    let reset = command_now(c, 0, (14 << 10) | (dci << 16) | (slot << 24))
    // A pipe that was not halted answers Context State Error (19): go on.
    if reset & 255 != 1 && reset & 255 != 19 { return false }
    let ring = get(d, if inward { BIRING } else { BORING })
    let index = get(d, if inward { BII } else { BOI })
    let cycle = get(d, if inward { BIC } else { BOC })
    let moved = command_now(c, pa(ring + index * 16) | cycle, (16 << 10) | (dci << 16) | (slot << 24))
    if moved & 255 != 1 { return false }
    control_now(d, 2, 1, 0, get(d, if inward { BIADDR } else { BOADDR }))
}

/// The Bulk-Only Mass Storage Reset (BOT §3.1: class request FFh to the
/// interface), then both pipes cleared (§5.3.4's reset recovery).
fn bot_reset(d: u64) -> bool {
    if !storage_live(d) { return false }
    if !control_now(d, 0x21, 0xff, 0, get(d, IFACE)) { return false }
    clear_halt(d, true) && clear_halt(d, false)
}

/// The bulk pipes of a storage interface, configured (xHCI §4.6.6, the
/// Configure Endpoint command first, then SET_CONFIGURATION, §4.3.5),
/// and the device recorded among the storage devices. Each endpoint's
/// context: Bulk OUT 2 or Bulk IN 6, CErr 3, its max packet, the
/// SuperSpeed companion's bMaxBurst, Average TRB Length 3 KiB (§4.14.1.1).
fn bulk_context(at: u64, ring: u64, mps: u64, kind: u64, burst: u64) {
    w32(at, 0)
    w32(at + 4, (mps << 16) | (burst << 8) | (kind << 3) | 6)
    w64(at + 8, pa(ring) | 1)
    w32(at + 16, 3072)
}

fn drive_storage(d: u64, config: u64, iface: u64, inaddr: u64, inmps: u64, outaddr: u64, outmps: u64, bursts: u64) -> bool {
    let c = get(d, HOST)
    if storage_count() >= STORAGE_MAX { return false }
    let ir = page()
    let orr = page()
    if ir == 0 || orr == 0 { return false }
    let ind = (inaddr & 15) * 2 + 1
    let outd = (outaddr & 15) * 2
    put(d, BIRING, ir); put(d, BII, 0); put(d, BIC, 1); put(d, BIN, ind); put(d, BIMPS, inmps); put(d, BIADDR, inaddr)
    put(d, BORING, orr); put(d, BOI, 0); put(d, BOC, 1); put(d, BOUT, outd); put(d, BOMPS, outmps); put(d, BOADDR, outaddr)
    put(d, IFACE, iface); put(d, BBURST, bursts)
    let input = get(d, INPUT)
    zero(input, 4096)
    w32(input + 4, 1 | (1 << ind) | (1 << outd))
    input_slot(d, if ind > outd { ind } else { outd })
    let csz = get(c, CSZ)
    bulk_context(input + (ind + 1) * csz, ir, inmps, 6, bursts >> 8)
    bulk_context(input + (outd + 1) * csz, orr, outmps, 2, bursts & 255)
    if command(c, pa(input), (12 << 10) | (get(d, SLOT) << 24)) & 255 != 1 { return false }
    if !control(d, 0, 9, config, 0, 0) { return false }
    let t0 = unsafe { storage }
    if t0 == 0 {
        let t = page()
        if t == 0 { return false }
        unsafe { storage = t }
    }
    let t = unsafe { storage }
    let k = get(t, 0)
    put(t, 1 + k, d)
    put(t, 0, k + 1)
    put(d, KIND, 5)
    let saved = sync.acquire(sync.console())
    log.put("xhci: storage "); path(d); log.put(" speed "); log.dec(get(d, SPEED) as int)
    log.put(" interface "); log.dec(iface as int)
    log.put(" bulk in "); log.hex_n(inaddr, 2); log.put("/"); log.dec(inmps as int)
    log.put(" out "); log.hex_n(outaddr, 2); log.put("/"); log.dec(outmps as int)
    log.put(" burst "); log.dec((bursts >> 8) as int); log.put("/"); log.dec((bursts & 255) as int)
    log.line(" Bulk-Only")
    sync.release(sync.console(), saved)
    true
}

/// px78: the configuration descriptor at `buf` (`total` bytes) as a
/// storage device's: the first interface (alternate setting 0) of class
/// 08h, subclass 06h, protocol 50h, its bulk IN and OUT endpoints and
/// each one's SuperSpeed companion's bMaxBurst. (found, interface, in
/// address, in max packet, out address, out max packet, bursts in << 8
/// | out).
fn storage_interface(buf: u64, total: u64) -> (bool, u64, u64, u64, u64, u64, u64) {
    var at: u64 = 0
    var inside = false
    var found = false
    var iface: u64 = 0
    var ia: u64 = 0
    var im: u64 = 0
    var oa: u64 = 0
    var om: u64 = 0
    var bursts: u64 = 0
    var last: u64 = 0 // 1 the previous descriptor was the IN endpoint, 2 the OUT
    while at + 2 <= total {
        let length = r8(buf + at)
        let dtype = r8(buf + at + 1)
        if length < 2 || at + length > total { return (false, 0, 0, 0, 0, 0, 0) }
        if dtype == 4 && length >= 9 {
            inside = !found && r8(buf + at + 3) == 0 && r8(buf + at + 5) == 8 && r8(buf + at + 6) == 6 && r8(buf + at + 7) == 0x50
            if inside { found = true; iface = r8(buf + at + 2) }
            last = 0
        } else if dtype == 5 && length >= 7 && inside {
            let address = r8(buf + at + 2)
            let mps = (r8(buf + at + 4) | (r8(buf + at + 5) << 8)) & 0x7ff
            last = 0
            if r8(buf + at + 3) & 3 == 2 && address & 15 != 0 {
                if address & 128 != 0 && ia == 0 { ia = address; im = mps; last = 1 }
                if address & 128 == 0 && oa == 0 { oa = address; om = mps; last = 2 }
            }
        } else if dtype == 48 && length >= 6 && inside && last != 0 {
            let burst = r8(buf + at + 2) & 15
            bursts = bursts | (if last == 1 { burst << 8 } else { burst })
            last = 0
        } else {
            last = 0
        }
        at += length
    }
    (found && ia != 0 && oa != 0 && im != 0 && om != 0, iface, ia, im, oa, om, bursts)
}

// px78: kernel/usb_storage's way in, called by address through boot/io.S's
// pax_call5: kernel/block, which kernel/usb_storage serves, sits below
// kernel/console, which this module uses, so kernel/usb_storage cannot
// import this one (wolf refuses the cycle). Each takes and gives words:
// booleans are 0 or 1; `bulk`'s pair is code | moved << 8.

/// How many storage devices enumeration found.
export fn pax_xhci_storage_count() -> u64 { storage_count() }

/// Storage device `i`'s record, 0 past the last.
export fn pax_xhci_storage_dev(i: u64) -> u64 { storage_dev(i) }

/// 1 while device `d`'s pipes take transfers.
export fn pax_xhci_storage_live(d: u64) -> u64 { if storage_live(d) { 1 } else { 0 } }

/// Device `d`'s path on the log (`usb1-1`, `usb1-3.2`); 0.
export fn pax_xhci_put_path(d: u64) -> u64 { path(d); 0 }

/// A zeroed page below 4 GiB (its kernel address) for a storage device's
/// own DMA (its CBW, CSW and short replies), 0 with none.
export fn pax_xhci_dma_page() -> u64 { page() }

/// `bulk` with `mode` the deadline in microseconds << 1 | 1 inward:
/// code | moved << 8.
export fn pax_xhci_bulk(d: u64, mode: u64, list: u64, at: u64, n: u64) -> u64 {
    let (code, moved) = bulk(d, mode & 1 != 0, list, at, n, mode >> 1)
    code | (moved << 8)
}

/// `clear_halt`: 1 when the pipe is clear.
export fn pax_xhci_clear_halt(d: u64, inward: u64) -> u64 { if clear_halt(d, inward != 0) { 1 } else { 0 } }

/// `bot_reset`: 1 when the reset recovery completed.
export fn pax_xhci_bot_reset(d: u64) -> u64 { if bot_reset(d) { 1 } else { 0 } }

fn discard_allocations(d: u64) {
    // Only before Address Device, or after successful Disable Slot.
    let saved = sync.irq_save()
    var word = OUTPUT
    while word <= BUFFER {
        if word == OUTPUT || word == INPUT || word == CTRL || word == INTR || word == BUFFER {
            if get(d, word) != 0 { frames.free(pa(get(d, word))) }
        }
        word += 1
    }
    frames.free(pa(d))
    sync.irq_restore(saved)
}

// Keep diagnostic formatting outside the branch-heavy setup routine. Wolf
// 0.2.35 inlines each small formatter loop before range analysis (#983).
// One report site preserves every diagnostic without multiplying those loops.
fn attach(c: u64, parent: u64, port: u64, speed: u64) {
    let (why, detail) = try_attach(c, parent, port, speed)
    if why == 0 { return }
    let message = match why {
        1 => "hub depth exceeds five",
        2 => "enable slot failed",
        3 => "no device record memory",
        4 => "no DMA memory",
        _ => "device enumeration failed",
    }
    say_error(c, message, detail)
}

fn try_attach(c: u64, parent: u64, port: u64, speed: u64) -> (u64, u64) {
    var route: u64 = 0
    var depth: u64 = 0
    var root = port
    var tt: u64 = 0
    if parent != 0 {
        depth = get(parent, DEPTH) + 1
        route = usb_topology.route_child(get(parent, ROUTE), get(parent, DEPTH), port)
        if route > 0xfffff { return (1, port) }
        root = get(parent, ROOT)
        tt = usb_topology.tt_route(speed, get(parent, SPEED), get(parent, SLOT), port, get(parent, TT))
    }
    let result = command(c, 0, 9 << 10)
    let slot = result >> 24
    if result & 255 != 1 || slot == 0 || slot > get(c, NSLOT) { return (2, result) }
    let d = page()
    if d == 0 {
        let _disabled = command(c, 0, (10 << 10) | (slot << 24))
        return (3, slot)
    }
    put(d, SLOT, slot); put(d, HOST, c); put(d, PARENT, parent)
    put(d, PORT, port); put(d, ROOT, root); put(d, ROUTE, route)
    put(d, DEPTH, depth); put(d, SPEED, speed); put(d, TT, tt)
    var word = OUTPUT
    while word <= BUFFER {
        if word == OUTPUT || word == INPUT || word == CTRL || word == INTR || word == BUFFER {
            let a = page()
            if a == 0 {
                let _disabled = command(c, 0, (10 << 10) | (slot << 24))
                discard_allocations(d)
                return (4, slot)
            }
            put(d, word, a)
        }
        word += 1
    }
    put(d, TC, 1); put(d, IC, 1); put(d, ACTIVE, 1)
    w64(c + 512 + slot * 8, d)
    w64(get(c, DCBAA) + slot * 8, pa(get(d, OUTPUT)))
    let input = get(d, INPUT)
    w32(input + 4, 3)
    input_slot(d, 1)
    let packet: u64 = if speed >= 4 { 512 } else { if speed == 3 { 64 } else { 8 } }
    endpoint(input + get(c, CSZ) * 2, get(d, CTRL), packet, 4, 0)
    let result2 = command(c, pa(input), (11 << 10) | (slot << 24))
    if result2 & 255 != 1 || !configure(d) {
        put(d, KIND, 4)
        return (5, slot)
    }
    (0, 0)
}

fn child(c: u64, parent: u64, port: u64) -> u64 {
    var slot: u64 = 1
    while slot <= get(c, NSLOT) {
        let d = device(c, slot)
        if d != 0 && get(d, ACTIVE) != 0 && get(d, PARENT) == parent && get(d, PORT) == port { return d }
        slot += 1
    }
    0
}

fn detach(d: u64) {
    let c = get(d, HOST)
    var slot: u64 = 1
    while slot <= get(c, NSLOT) {
        let other = device(c, slot)
        if other != 0 && get(other, ACTIVE) != 0 && get(other, PARENT) == d { detach(other) }
        slot += 1
    }
    let saved = sync.irq_save()
    let was_storage = get(d, KIND) == 5
    report(d, 0)
    put(d, KIND, if was_storage { 6 } else { 3 })
    sync.irq_restore(saved)
    if was_storage {
        // px78: kernel/usb_storage keeps this record; it refuses I/O now.
        let s = sync.acquire(sync.console())
        log.put("xhci: storage "); path(d); log.line(" removed; its disk refuses I/O")
        sync.release(sync.console(), s)
    }
    let result = command(c, 0, (10 << 10) | (get(d, SLOT) << 24))
    if result & 255 != 1 { say_error(c, "disable slot failed; DMA quarantined", result); return }
    let s = sync.irq_save()
    drain(c)
    put(d, ACTIVE, 0)
    w64(c + 512 + get(d, SLOT) * 8, 0)
    w64(get(c, DCBAA) + get(d, SLOT) * 8, 0)
    // Disable Slot completion proves these DMA buffers are no longer owned.
    // px78: a storage device's record is kept (named by kernel/usb_storage).
    if !was_storage { discard_allocations(d) }
    sync.irq_restore(s)
}

fn root_scan(c: u64) {
    var port: u64 = 1
    while port <= get(c, PORTS) && get(c, LIVE) != 0 {
        let address = get(c, OP) + 0x400 + (port - 1) * 16
        var status = r32(address)
        let existing = child(c, 0, port)
        if existing != 0 && (status & 1 == 0 || status & 0x20000 != 0) { detach(existing) }
        // PORTSC has mixed RW/RW1C semantics. Preserve PP only; never
        // echo PED=1 (write-one-disable) or a link-state strobe.
        w32(address, (status & 0x200) | (status & 0xfe0000))
        if status & 1 != 0 && child(c, 0, port) == 0 {
            let _debounce = sched.sleep(11)
            status = r32(address)
            if status & 1 != 0 {
                if status & 2 == 0 {
                    w32(address, (status & 0x200) | 16)
                    let until = timer.ticks() + 100
                    while timer.ticks() < until && r32(address) & 16 != 0 { let _n = sched.sleep(1) }
                }
                status = r32(address)
                w32(address, (status & 0x200) | (status & 0xfe0000))
                if status & 3 == 3 {
                    let _recovery = sched.sleep(2)
                    attach(c, 0, port, (status >> 10) & 15)
                }
            }
        }
        port += 1
    }
}

fn hub_scan(d: u64) {
    let c = get(d, HOST)
    var port: u64 = 1
    while port <= get(d, HUBPORTS) && get(c, LIVE) != 0 {
        if !control(d, 0xa3, 0, 0, port, 4) || get(d, ACTUAL) < 4 { return }
        var status = r32(get(d, BUFFER))
        let existing = child(c, d, port)
        if existing != 0 && (status & 1 == 0 || status & 0x10000 != 0) { detach(existing) }
        var bit: u64 = 0
        while bit < 5 {
            if status & (1 << (bit + 16)) != 0 {
                if !control(d, 0x23, 1, 16 + bit, port, 0) { return }
            }
            bit += 1
        }
        if status & 1 != 0 && child(c, d, port) == 0 {
            let _debounce = sched.sleep(11)
            if !control(d, 0x23, 3, 4, port, 0) { return }
            let until = timer.ticks() + 100
            while timer.ticks() < until {
                let _n = sched.sleep(1)
                if !control(d, 0xa3, 0, 0, port, 4) { return }
                status = r32(get(d, BUFFER))
                if status & 16 == 0 && status & 2 != 0 { break }
            }
            if status & 3 == 3 && status & 16 == 0 {
                if !control(d, 0x23, 1, 20, port, 0) { return }
                let _recovery = sched.sleep(2)
                let speed: u64 = if status & 0x200 != 0 { 2 } else { if status & 0x400 != 0 { 3 } else { 1 } }
                attach(c, d, port, speed)
            }
        }
        port += 1
    }
}

export fn pax_usbd(_arg: u64) {
    while true {
        var c = head()
        while c != 0 {
            if get(c, LIVE) != 0 {
                root_scan(c)
                // Slots are assigned in order by QEMU, but not required to
                // be: five passes find every allowed hub depth at startup.
                var pass: u64 = 0
                while pass < 5 {
                    var slot: u64 = 1
                    while slot <= get(c, NSLOT) {
                        let d = device(c, slot)
                        if d != 0 && get(d, ACTIVE) != 0 && get(d, KIND) == 2 && get(d, DEPTH) == pass { hub_scan(d) }
                        slot += 1
                    }
                    pass += 1
                }
            }
            c = get(c, NEXT)
        }
        unsafe { initialized = 1 }
        let _n = sched.sleep(10)
    }
}

fn wait_bits(a: u64, mask: u64, value: u64, ticks: u64) -> bool {
    let deadline = clock.deadline_us(ticks * 10000)
    while !clock.expired(deadline) {
        if r32(a) & mask == value { return true }
    }
    r32(a) & mask == value
}

fn controller(pml4: u64, index: u64, number: u64) -> u64 {
    let bdf = pci.bdf(index)
    let (kind, physical) = pci.bar(bdf, 0)
    if (kind != pci.BAR_MEM32 && kind != pci.BAR_MEM64) || physical == 0 { return 0 }
    let line = pci.line(index)
    let has_msi = pci.capability(bdf, 5) != 0
    if !has_msi && (pci.pin(index) == 0 || line < 3 || line > 15 || line == 4 || line == 8 || line == 13) { return 0 }
    let base = BASE + (number - 1) * WINDOW
    var off: u64 = 0
    while off < WINDOW {
        let answer = paging.map(pml4, base + off, (physical & !4095) + off, paging.NX | paging.RW | 24) else 9
        if answer == 9 { return 0 }
        off += 4096
    }
    let cap = base + (physical & 4095)
    // HCRST does not reset firmware's PCI interrupt enables.
    pci.interrupts_off(bdf)
    pci.set_command(bdf, pci.command(bdf) | pci.CMD_MEMORY | pci.CMD_MASTER)
    let c = page()
    if c == 0 { return 0 }
    put(c, NUMBER, number); put(c, CAP, cap)
    let op = cap + r8(cap)
    let runtime = r32(cap + 0x18) & !31
    let doorbell = r32(cap + 0x14) & !3
    if runtime + 64 >= WINDOW || doorbell + 1024 >= WINDOW { return 0 }
    put(c, OP, op); put(c, RT, cap + runtime + 32); put(c, DB, cap + doorbell)
    put(c, PORTS, r32(cap + 4) >> 24)
    let maxslots = r32(cap + 4) & 255
    put(c, NSLOT, if maxslots > SLOTS { SLOTS } else { maxslots })
    let hcc = r32(cap + 0x10)
    put(c, CSZ, if hcc & 4 != 0 { 64 } else { 32 })
    put(c, VECTOR, if has_msi { 79 + number } else { timer.MASTER_BASE + line })
    var extended = (hcc >> 16) * 4
    var legacy_found = false
    var guard: u64 = 0
    while extended != 0 && extended + 16 < WINDOW && guard < 256 {
        let header = r32(cap + extended)
        if header & 255 == 1 {
            legacy_found = true
            w8(cap + extended + 3, r8(cap + extended + 3) | 1)
            if !wait_bits(cap + extended, 0x1010000, 0x1000000, 500) { say_error(c, "firmware ownership timeout", header); return 0 }
            let legacy = r32(cap + extended + 4)
            w32(cap + extended + 4, (legacy & 0x1fee) | 0xe0000000)
        }
        let next = (header >> 8) & 255
        if next == 0 { break }
        extended += next * 4
        guard += 1
    }
    if !wait_bits(op + 4, 0x800, 0, 100) { return 0 }
    w32(op, r32(op) & !1)
    if !wait_bits(op + 4, 1, 1, 100) { return 0 }
    w32(op, 2)
    if !wait_bits(op, 2, 0, 100) || !wait_bits(op + 4, 0x800, 0, 100) { return 0 }
    if r32(op + 8) & 1 == 0 { say_error(c, "4KiB pages unsupported", r32(op + 8)); return 0 }
    let dcbaa = page(); let cmd = page(); let event = page(); let erst = page()
    if dcbaa == 0 || cmd == 0 || event == 0 || erst == 0 { return 0 }
    put(c, DCBAA, dcbaa); put(c, CMD, cmd); put(c, EVENT, event)
    put(c, CC, 1); put(c, EC, 1)
    let hcs2 = r32(cap + 8)
    let scratch = ((hcs2 >> 27) & 31) | (((hcs2 >> 21) & 31) << 5)
    if scratch > 512 { say_error(c, "scratchpad bound exceeded", scratch); return 0 }
    if scratch != 0 {
        let array = page()
        if array == 0 { return 0 }
        w64(dcbaa, pa(array))
        var i: u64 = 0
        while i < scratch {
            let buffer = page()
            if buffer == 0 { return 0 }
            w64(array + i * 8, pa(buffer)); i += 1
        }
    }
    // AC64=0 controllers may only DMA below 4GiB; never truncate a pointer.
    if hcc & 1 == 0 && (pa(dcbaa) >> 32 != 0 || pa(erst) >> 32 != 0) {
        say_error(c, "32-bit DMA controller needs low memory", pa(dcbaa)); return 0
    }
    w64(op + 0x30, pa(dcbaa)); w64(op + 0x18, pa(cmd) | 1)
    w32(op + 0x38, get(c, NSLOT))
    let rt = get(c, RT)
    w64(erst, pa(event)); w32(erst + 8, 256)
    w32(rt + 8, 1); w64(rt + 24, pa(event)); w64(rt + 16, pa(erst))
    w32(rt + 4, 0); w32(rt, 3)
    if has_msi {
        if !pci.enable_msi(bdf, apic.id(), get(c, VECTOR)) { say_error(c, "MSI setup failed", bdf); return 0 }
    } else {
        pci.set_command(bdf, pci.command(bdf) & !pci.CMD_INTX_OFF)
        timer.level(line); timer.unmask_line(line)
    }
    put(c, LIVE, 1)
    w32(op, 5)
    if !wait_bits(op + 4, 1, 0, 100) { put(c, LIVE, 0); return 0 }
    var port: u64 = 1
    while port <= get(c, PORTS) {
        let address = op + 0x400 + (port - 1) * 16
        w32(address, 0x200)
        port += 1
    }
    log.put("xhci "); log.dec(number as int); log.put(": BAR0 "); log.hex(physical); log.end()
    log.put("xhci "); log.dec(number as int); log.put(": ports ")
    log.dec(get(c, PORTS) as int)
    log.put(if has_msi { " MSI vector " } else { " INTx " })
    log.dec((if has_msi { get(c, VECTOR) } else { line }) as int)
    log.put(" context "); log.dec(get(c, CSZ) as int)
    log.put(if legacy_found { " legacy owned" } else { " legacy absent" })
    log.put(" speeds")
    port = 1
    while port <= get(c, PORTS) {
        let st = r32(op + 0x400 + (port - 1) * 16)
        if st & 1 != 0 { log.put(" "); log.dec(port as int); log.put("="); log.dec(((st >> 10) & 15) as int) }
        port += 1
    }
    log.end()
    c
}

/// After PCI scan, scheduler/timer/console start, with IF clear. Returns
/// the number of immortal kernel threads created (zero when no controller).
pub fn start(pml4: u64, entry: u64) -> u64 {
    var index: u64 = 0
    var number: u64 = 0
    while index < pci.count() && number < 4 {
        if pci.read32(pci.bdf(index), 8) >> 8 == 0x0c0330 {
            let c = controller(pml4, index, number + 1)
            if c != 0 { put(c, NEXT, head()); unsafe { first = c }; number += 1 }
        }
        index += 1
    }
    if head() == 0 { unsafe { initialized = 1 }; return 0 }
    let keys = page()
    if keys == 0 { unsafe { initialized = 1 }; return 0 }
    unsafe { held = keys }
    let id = sched.create(entry, 0)
    if id == 0 { unsafe { initialized = 1 }; return 0 }
    1
}

pub fn wait_ready() {
    while unsafe { initialized == 0 } { let _n = sched.sleep(1) }
}
