//! member: false
// kmain_timer.lu — the timer ticks (kw10, tests/mpx2-interrupts I5).
// The kernel switches to PAX's paging structures, loads its GDT, TSS
// and IDT, maps the local APIC and unmasks its LINT0 as ExtINT
// (kernel/apic: Limine leaves it masked), remaps and masks the 8259s,
// and (px76) starts the firmware's clock first (kernel/clock: the HPET,
// else the ACPI PM timer, else the PIT read back; its ACPI and clock
// lines come before the APIC's), then calibrates the local APIC timer
// against it and ticks at 100 Hz on vector 32 (kernel/timer), then
// sleeps with interrupts enabled only inside each wait (boot/isr.S's
// STI; HLT; CLI) until 20 ticks have been handled, stops the tick and
// halts with interrupts off:
//
//     PAX interrupts: timer
//     paging: limine cr3 0x<A>, pax cr3 0x<B>, <P> table frames
//     firmware: …, memory: …, acpi: … (a line a table), clock: …
//     apic: 0x00000000fee00000 at 0xffffb00000000000, id 0, svr 0x<s>, lint0 0x<old> -> 0x0000000000008700
//     timer: LAPIC calibrated by HPET|PM|PIT divide16 <rate> Hz, tick 100 Hz vector 32; PIT IRQ masked
//     timer: 20 ticks on vector 32, 0 spurious
//     halt
use apic
use clock
use frames
use interrupts
use log
use paging
use panic
use serial
use timer

export fn kmain() {
    serial.init()
    log.line("PAX interrupts: timer")
    frames.start()
    let limine = paging.cr3()
    let before = frames.free_count()
    let pml4 = paging.start()
    paging.report(limine, before)
    interrupts.start()
    clock.start() // px76: its lines before the APIC's; timer.start reuses it
    apic.start(pml4)
    apic.report()
    timer.start()
    while timer.ticks() < 20 {
        timer.wait()
    }
    timer.stop()
    log.put("timer: ")
    log.dec(timer.ticks() as int)
    log.put(" ticks on vector 32, ")
    log.dec(timer.spurious_count() as int)
    log.put(" spurious")
    log.end()
    log.line("halt")
    panic.halt()
}
