//! interrupts — where every routed vector lands (kw10, M-PX2's
//! interrupt piece).
//!
//! Wolf has no interrupt calling convention ([abi.interrupt], wolf-lang
//! kw10): boot/isr.S's trampoline for each vector 0-47 saves the
//! registers, builds a `Frame` and calls `pax_interrupt` under the C
//! convention, then resumes the frame `pax_interrupt` RETURNS (px07):
//! its argument to go on where the interrupt landed, or another
//! thread's saved frame to switch (kernel/sched). Interrupts are off
//! throughout (every gate is an interrupt gate, kernel/idt).
//!
//! - vector 3, the breakpoint (`int3`, a trap: the saved RIP is the next
//!   instruction): one line, `int3: breakpoint vector 3, rip 0x<rip>`,
//!   and it returns — the kernel continues after the `int3`;
//! - vector 32, the timer (kernel/timer, the 8259's line 0): a tick,
//!   then kernel/sched's `preempt`, which returns the frame to resume
//!   (the same one until the scheduler is started);
//! - vector 0x100, PAX_SYSCALL (px09): no gate routes it; boot/user.S's
//!   `pax_syscall_entry` builds the frame for a `syscall` in ring 3, and
//!   kernel/user's `syscall` returns the frame to resume (the caller's,
//!   its %rax the result, or after `exit` the next thread's);
//! - an exception 0-31 from ring 3 (the frame's CS has RPL 3), except
//!   the double fault and the machine check (px09): kernel/user's `kill`
//!   ends the program by name and returns the next thread's frame — the
//!   kernel goes on;
//! - vector 0x81, PAX_SWITCH (px07): no gate routes it; boot/sched.S's
//!   `pax_switch` builds the frame by hand for a thread that yields,
//!   sleeps, waits or exits, and kernel/sched's `switched` returns the
//!   next thread's frame;
//! - vectors 39 and 47, an 8259 line 7 or 15: a spurious request
//!   (kernel/timer reads the in-service register) returns; a real one
//!   is unexpected (every other line is masked) and panics;
//! - every other exception, 0-31: a named panic — the vector's name
//!   (Intel SDM vol. 3A Table 6-1 and §6.15; AMD64 APM vol. 2 Table 8-1
//!   for 28-30), its number, the error code (0 for a vector whose CPU
//!   pushes none: boot/isr.S pushes the zero), the saved RIP and RSP,
//!   the frame's own address (on IST1 for the double fault), and for a
//!   page fault CR2, the linear address that faulted (SDM vol. 3A §6.15,
//!   interrupt 14; §4.7):
//!
//!     PANIC <name> vector <v> error 0x<e> rip 0x<r> rsp 0x<s> frame 0x<f>[ cr2 0x<a>[ (heap)]]
//!
//!   (` (heap)` when CR2 lies in kernel/heap's PML4 slot, px06), then
//!   halt (kernel/panic: `cli; hlt`, forever). A double fault or
//!   page fault whose CR2 lies in a thread's stack guard (kernel/sched)
//!   is a stack overflow, and says so (px07):
//!
//!     PANIC stack overflow thread <id> cr2 0x<a> guard 0x<lo> to 0x<hi>
//!
//! The frame is boot/isr.S's: 22 eight-byte words, lowest address
//! first (`[abi.interrupt]`). The handler only reads it here; a handler
//! that resumes past a fault writes `rip` through `f as *u64` at
//! `offset_of(Frame, rip) / 8`, because a store to a field of a raw
//! element (`f[0].rip = v`) is refused by wolf (wolf-lang#577).
//!
//! No Linux source; no other kernel's source.

use gdt
use idt
use log
use panic
use sched
use timer
use user

extern "c" fn pax_cr2() -> u64

/// What boot/isr.S hands `pax_interrupt`.
#[repr(c)]
struct Frame {
    r15: u64,
    r14: u64,
    r13: u64,
    r12: u64,
    r11: u64,
    r10: u64,
    r9: u64,
    r8: u64,
    rbp: u64,
    rdi: u64,
    rsi: u64,
    rdx: u64,
    rcx: u64,
    rbx: u64,
    rax: u64,
    vector: u64,
    error: u64,
    rip: u64,
    cs: u64,
    rflags: u64,
    rsp: u64,
    ss: u64,
}

/// Breakpoints taken (vector 3).
var breakpoint_count: u64 = 0

/// kernel/heap's PML4 slot, 384 (px06), as an address range: a page
/// fault there is named ` (heap)` after CR2. kernel/heap is not
/// imported here (every kernel would carry the allocator hook); its
/// `slot()` and this agree in tests/mpx2-heap H9. A range, not
/// `cr2 >> 39 == 0x1ffff80`: the release tier deletes a branch on the
/// top half of a `u64 >> k` (wolf-lang#600).
const HEAP_LO: u64 = 0xffffc00000000000 // slot 384's first address
const HEAP_HI: u64 = 0xffffc08000000000 // slot 385's

/// The name of exception vector `v` (0-31).
pub fn name(v: u64) -> str {
    if v == 0 { return "divide error" }
    if v == 1 { return "debug" }
    if v == 2 { return "nmi" }
    if v == 3 { return "breakpoint" }
    if v == 4 { return "overflow" }
    if v == 5 { return "bound range exceeded" }
    if v == 6 { return "invalid opcode" }
    if v == 7 { return "device not available" }
    if v == 8 { return "double fault" }
    if v == 9 { return "coprocessor segment overrun" }
    if v == 10 { return "invalid tss" }
    if v == 11 { return "segment not present" }
    if v == 12 { return "stack-segment fault" }
    if v == 13 { return "general protection" }
    if v == 14 { return "page fault" }
    if v == 16 { return "x87 floating-point error" }
    if v == 17 { return "alignment check" }
    if v == 18 { return "machine check" }
    if v == 19 { return "simd floating-point exception" }
    if v == 20 { return "virtualization exception" }
    if v == 21 { return "control protection exception" }
    if v == 28 { return "hypervisor injection exception" }
    if v == 29 { return "vmm communication exception" }
    if v == 30 { return "security exception" }
    if v < 32 { return "reserved" }
    "unexpected interrupt"
}

/// Load the kernel's own GDT and TSS (kernel/gdt) and IDT (kernel/idt):
/// from here on every exception reaches `pax_interrupt`. Every kernel
/// calls this first: boot/isr.S is on the package's `asm` list, so every
/// kernel links the trampolines, and they call this module.
pub fn start() {
    gdt.start()
    idt.start()
}

/// Write the tables' two lines (kernel/gdt's and kernel/idt's).
pub fn report() {
    gdt.report()
    idt.report()
}

/// Breakpoints taken since boot.
pub fn breakpoints() -> u64 {
    // # Safety: a read of the counter; the kernel's interrupts are off.
    unsafe { breakpoint_count }
}

/// PAX_SWITCH: the vector boot/sched.S's `pax_switch` writes into the
/// frame it builds (no gate routes it).
const SWITCH: u64 = 0x81

/// A stack overflow (px07): CR2 in thread `id`'s guard. Halts.
fn overflow(id: u64, cr2: u64) {
    log.put("PANIC stack overflow thread ")
    log.dec(id as int)
    log.put(" cr2 ")
    log.hex(cr2)
    log.put(" guard ")
    log.hex(sched.guard_lo(id))
    log.put(" to ")
    log.hex(sched.stack_lo(id))
    log.end()
    panic.halt()
}

/// Write the panic line for the frame at `f` and halt.
fn fatal(f: *Frame) {
    // # Safety: `f` is the trampoline's frame, live for this call.
    let (v, e, rip, rsp) = unsafe { (f[0].vector, f[0].error, f[0].rip, f[0].rsp) }
    if v == 8 || v == 14 {
        // # Safety: cpu.S's MOV from CR2: the last page fault's address,
        // the one that raised this (or, for #DF, the fault inside it).
        let a = unsafe { pax_cr2() }
        let t = sched.guard_of(a)
        if t != 0 {
            overflow(t - 1, a)
        }
    }
    log.put("PANIC ")
    log.put(name(v))
    log.put(" vector ")
    log.dec(v as int)
    log.put(" error ")
    log.hex(e)
    log.put(" rip ")
    log.hex(rip)
    log.put(" rsp ")
    log.hex(rsp)
    log.put(" frame ")
    // # Safety: the frame's address; nothing is read.
    log.hex(unsafe { f as u64 })
    if v == 14 {
        // # Safety: cpu.S's MOV from CR2; the fault being reported set it.
        let a = unsafe { pax_cr2() }
        log.put(" cr2 ")
        log.hex(a)
        if a >= HEAP_LO && a < HEAP_HI {
            log.put(" (heap)")
        }
    }
    log.end()
    panic.halt()
}

/// boot/isr.S's common path calls this for every routed vector (and
/// boot/sched.S's `pax_switch` for PAX_SWITCH), and resumes the frame it
/// returns.
export fn pax_interrupt(f: *Frame) -> *Frame {
    // # Safety: `f` is the trampoline's frame, live for this call.
    let v = unsafe { f[0].vector }
    if v == 3 {
        // # Safety: as above.
        let rip = unsafe { f[0].rip }
        // # Safety: the counter is touched with interrupts off.
        unsafe {
            breakpoint_count += 1
        }
        log.put("int3: breakpoint vector 3, rip ")
        log.hex(rip)
        log.end()
        return f
    }
    if v == timer.master_base() {
        timer.tick()
        // # Safety: the frame's address; nothing is read here.
        if user.from_user(unsafe { f as u64 }) {
            user.count_tick() // px09: a tick that landed in ring 3
        }
        // # Safety: the frame's address, and the one sched hands back is
        // a saved frame on a live thread's stack.
        return unsafe { sched.preempt(f as u64) as *Frame }
    }
    if v == SWITCH {
        // # Safety: as above.
        return unsafe { sched.switched(f as u64) as *Frame }
    }
    if v == user.vector() {
        // # Safety: as above; the frame user.syscall returns is this one
        // or a saved frame on a live thread's stack.
        return unsafe { user.syscall(f as u64) as *Frame }
    }
    if (v == 39 || v == 47) && timer.spurious(v) {
        return f
    }
    // # Safety: the frame's address; nothing is read here.
    if v < 32 && v != 8 && v != 18 && user.from_user(unsafe { f as u64 }) {
        // # Safety: as above.
        return unsafe { user.kill(f as u64, name(v)) as *Frame }
    }
    fatal(f)
    f
}
