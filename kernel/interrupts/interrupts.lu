//! interrupts — where every routed vector lands (kw10, M-PX2's
//! interrupt piece).
//!
//! Wolf has no interrupt calling convention ([abi.interrupt], wolf-lang
//! kw10): boot/isr.S's trampoline for each vector 0-47 saves the
//! registers, builds a `Frame` and calls `pax_interrupt` under the C
//! convention, then resumes the frame `pax_interrupt` RETURNS (px07):
//! its argument to go on where the interrupt landed, or another
//! thread's saved frame to switch (kernel/sched). Interrupts are off
//! throughout (every gate is an interrupt gate, kernel/idt).
//!
//! - px161: on an application processor (kernel/percpu's index not 0)
//!   the NMI is counted in its record with no line. px166: kernel/smp's
//!   `ap_early` then answers its spurious vector and stops it on a vector
//!   it never takes, before the kernel lock; everything else it takes
//!   under the lock as below: its own tick (vector 32: counted and
//!   acknowledged at its local APIC, then kernel/sched's `preempt` for its
//!   running thread; none of CPU 0's tick duties), RESCHED, and the
//!   switches, system calls and faults of the threads it runs;
//! - vector 48, RESCHED (px166, from another processor, on any one):
//!   acknowledged and counted (kernel/smp's `took_resched`), then
//!   kernel/sched's `kick`: an idle processor takes the queue's head;
//! - vector 2, the NMI (px77d; its gate on IST2): one line for each of
//!   the first eight, `nmi: <n> at rip 0x<r> reason 0x<p>, continuing`,
//!   and the interrupted code resumes, whatever ring it was in; nothing
//!   else runs on its way out. A machine check (vector 18, on IST3) is
//!   still a named panic, its banks printed first (`mce: …`). `early`
//!   loads the tables and sets CR4.MCE as a kernel's first act;
//! - vector 3, the breakpoint (`int3`, a trap: the saved RIP is the next
//!   instruction): one line, `int3: breakpoint vector 3, rip 0x<rip>`,
//!   and it returns — the kernel continues after the `int3`;
//! - vector 32, the timer (kernel/timer, the 8259's line 0): a tick,
//!   then kernel/sched's `preempt`, which returns the frame to resume
//!   (the same one until the scheduler is started);
//! - vector 0x100, PAX_SYSCALL (px09): no gate routes it; boot/user.S's
//!   `pax_syscall_entry` builds the frame for a `syscall` in ring 3, and
//!   kernel/user's `syscall` returns the frame to resume (the caller's,
//!   its %rax the result, or after `exit` the next thread's);
//! - an exception 0-31 from ring 3 (the frame's CS has RPL 3), except
//!   the double fault and the machine check (px09): kernel/user's `kill`
//!   ends the program by name and returns the next thread's frame — the
//!   kernel goes on;
//! - vector 0x81, PAX_SWITCH (px07): no gate routes it; boot/sched.S's
//!   `pax_switch` builds the frame by hand for a thread that yields,
//!   sleeps, waits or exits, and kernel/sched's `switched` returns the
//!   next thread's frame;
//! - whichever frame is to be resumed, when it returns to ring 3
//!   (px26): kernel/signal's `on_return` takes the thread's pending
//!   signals first — a handler's frame laid on its stack, or its
//!   process ended and the next thread's frame resumed instead;
//! - vectors 33 and 36 (px13), the i8042's keyboard and COM1's
//!   receiver: kernel/console takes the bytes into its line discipline
//!   and acknowledges the 8259; a thread waiting for input is made
//!   ready when a read would answer, and run at once if the CPU was
//!   idle (kernel/sched's `kick`). Before kernel/console's `start` both
//!   lines stay masked, so neither arrives;
//! - the network device's vector (px20; 32 + the 8259 line the firmware
//!   routed its pin to, none until kernel/net's `start`): kernel/net
//!   reads the cause and acknowledges, the network thread is made
//!   ready, and run at once if the CPU was idle. No frame is touched
//!   here;
//! - the sound device's vector (px30; kernel/sound's `start` routed it
//!   as net's is): kernel/sound takes back the periods the device has
//!   played and its events, net's handler runs too when the two share
//!   the line, the 8259 is acknowledged once, and every thread waiting
//!   on a pipe, a socket or the sound device is made ready;
//! - vectors 39 and 47, an 8259 line 7 or 15: a spurious request
//!   (kernel/timer reads the in-service register) returns; a real one
//!   is unexpected (every other line is masked) and panics;
//! - every other exception, 0-31: a named panic — the vector's name
//!   (Intel SDM vol. 3A Table 6-1 and §6.15; AMD64 APM vol. 2 Table 8-1
//!   for 28-30), its number, the error code (0 for a vector whose CPU
//!   pushes none: boot/isr.S pushes the zero), the saved RIP and RSP,
//!   the frame's own address (on IST1 for the double fault), and for a
//!   page fault CR2, the linear address that faulted (SDM vol. 3A §6.15,
//!   interrupt 14; §4.7):
//!
//!     PANIC <name> vector <v> error 0x<e> rip 0x<r> rsp 0x<s> frame 0x<f>[ cr2 0x<a>[ (heap)]]
//!
//!   (` (heap)` when CR2 lies in kernel/heap's PML4 slot, px06), then
//!   halt (kernel/panic: `cli; hlt`, forever). A double fault or
//!   page fault in ring 3 on a page of a MAP_NORESERVE range not yet
//!   backed is backed and resumed (px34, kernel/user's `fault_in`); a
//!   page fault whose CR2 lies in a thread's stack guard (kernel/sched)
//!   is a stack overflow, and says so (px07):
//!
//!     PANIC stack overflow thread <id> cr2 0x<a> guard 0x<lo> to 0x<hi>
//!
//! The frame is boot/isr.S's: 22 eight-byte words, lowest address
//! first (`[abi.interrupt]`). The handler only reads it here, as
//! `f[0].rip`; a handler that resumed past a fault could write
//! `f[0].rip = v` (wolf 0.2.26, wolf-lang#577).
//!
//! No Linux source; no other kernel's source.

use console
use apic
use gdt
use idt
use klock
use log
use net
use panic
use percpu
use sched
use signal
use sync
use smp
use sound
use speaker
use timer
use testwords
use tlb
use trace
use triage
use user
use xhci

extern "c" fn pax_cr2() -> u64
extern "c" fn pax_cr4() -> u64
extern "c" fn pax_set_cr4(v: u64)
extern "c" fn pax_cpuid(leaf: u64, sub: u64, reg: u64) -> u64
extern "c" fn pax_rdmsr(msr: u64) -> u64
extern "c" fn pax_inb(port: u16) -> u8

/// What boot/isr.S hands `pax_interrupt`.
#[repr(c)]
struct Frame {
    r15: u64,
    r14: u64,
    r13: u64,
    r12: u64,
    r11: u64,
    r10: u64,
    r9: u64,
    r8: u64,
    rbp: u64,
    rdi: u64,
    rsi: u64,
    rdx: u64,
    rcx: u64,
    rbx: u64,
    rax: u64,
    vector: u64,
    error: u64,
    rip: u64,
    cs: u64,
    rflags: u64,
    rsp: u64,
    ss: u64,
}

/// Breakpoints taken (vector 3).
var breakpoint_count: u64 = 0

/// px77d: NMIs taken (vector 2), and whether the tables are loaded.
var nmi_count: u64 = 0
var loaded: bool = false

/// NMIs logged one line each; later ones are only counted.
const NMI_LINES: u64 = 8
const CR4_MCE: u64 = 0x40 // CR4 bit 6
const CPUID1_MCE: u64 = 0x80 // EDX bit 7
const CPUID1_MCA: u64 = 0x4000 // EDX bit 14

/// kernel/heap's PML4 slot, 384 (px06), as an address range: a page
/// fault there is named ` (heap)` after CR2. kernel/heap is not
/// imported here (every kernel would carry the allocator hook); its
/// `SLOT` and this agree in tests/mpx2-heap H9. A range, not
/// `cr2 >> 39 == 0x1ffff80`: the release tier deletes a branch on the
/// top half of a `u64 >> k` (wolf-lang#600).
const HEAP_LO: u64 = 0xffffc00000000000 // slot 384's first address
const HEAP_HI: u64 = 0xffffc08000000000 // slot 385's

/// The name of exception vector `v` (0-31).
pub fn name(v: u64) -> str {
    if v == 0 { return "divide error" }
    if v == 1 { return "debug" }
    if v == 2 { return "nmi" }
    if v == 3 { return "breakpoint" }
    if v == 4 { return "overflow" }
    if v == 5 { return "bound range exceeded" }
    if v == 6 { return "invalid opcode" }
    if v == 7 { return "device not available" }
    if v == 8 { return "double fault" }
    if v == 9 { return "coprocessor segment overrun" }
    if v == 10 { return "invalid tss" }
    if v == 11 { return "segment not present" }
    if v == 12 { return "stack-segment fault" }
    if v == 13 { return "general protection" }
    if v == 14 { return "page fault" }
    if v == 16 { return "x87 floating-point error" }
    if v == 17 { return "alignment check" }
    if v == 18 { return "machine check" }
    if v == 19 { return "simd floating-point exception" }
    if v == 20 { return "virtualization exception" }
    if v == 21 { return "control protection exception" }
    if v == 28 { return "hypervisor injection exception" }
    if v == 29 { return "vmm communication exception" }
    if v == 30 { return "security exception" }
    if v < 32 { return "reserved" }
    "unexpected interrupt"
}

/// Load the kernel's own GDT and TSS (kernel/gdt) and IDT (kernel/idt):
/// from here on every exception reaches `pax_interrupt`. Every kernel
/// calls this first: boot/isr.S is on the package's `asm` list, so every
/// kernel links the trampolines, and they call this module.
pub fn start() {
    // # Safety: a scalar module var, read and written with IF clear.
    if unsafe { loaded } {
        return // px77d: `early` loaded them already
    }
    gdt.start()
    idt.start()
    // # Safety: as above.
    unsafe { loaded = true }
}

/// px77d: the tables (`start`) and CR4.MCE as a kernel's first act,
/// before any page table, framebuffer or memory map is touched. Limine
/// hands over with an empty IDT and CR4.MCE clear (docs/BOOT.md clause
/// 7, base revision 5 and later), so until `start` ran an NMI or any
/// exception was a triple fault and a machine check a shutdown: a reset
/// with nothing on the screen (kasumi, px77/px77d, once in two plain
/// boots, with the window 337 console lines long). From here an NMI is
/// logged and survived (`nmi`), a machine check is a named panic with
/// its banks, and every exception is named. `start` later does nothing.
pub fn early() {
    start()
    // # Safety: CPUID reads nothing; CR4 gains only MCE, which CPUID
    // says the processor has (SDM vol. 3A §2.5).
    unsafe {
        if pax_cpuid(1, 0, 3) & CPUID1_MCE != 0 {
            pax_set_cr4(pax_cr4() | CR4_MCE)
        }
    }
}

/// px77d: an NMI (vector 2, on IST2): one line, `nmi: <n> at rip 0x<r>
/// reason 0x<p>` (port 0x61's bits 7 and 6, the PC's SERR# and IOCHK
/// NMI sources), for the first eight, and the interrupted code resumes.
/// The firmware leaves LINT1 an NMI line and the chipset may raise one
/// (SERR#, IOCHK, a watchdog); PAX enables no NMI source itself.
fn nmi(f: *Frame) {
    // # Safety: the counter is touched with NMIs blocked (until IRETQ).
    let n = unsafe {
        nmi_count += 1
        nmi_count
    }
    if n > NMI_LINES {
        return
    }
    // # Safety: io.S's `inb` of the NMI status port; a read changes nothing.
    let reason = unsafe { pax_inb(0x61) } as u64
    log.put("nmi: ")
    log.dec(n as int)
    log.put(" at rip ")
    // # Safety: `f` is the trampoline's frame, live for this call.
    log.hex(unsafe { f[0].rip })
    log.put(" reason ")
    log.hex(reason & 0xc0)
    log.put(if n == NMI_LINES { ", continuing (later NMIs only counted)" } else { ", continuing" })
    log.end()
}

/// NMIs taken since boot (px77d).
pub fn nmis() -> u64 {
    // # Safety: a read of the counter.
    unsafe { nmi_count }
}

/// px77d: a machine check's banks, one line each that holds a valid
/// error, before its named panic (SDM vol. 3A ch. 15: IA32_MCG_CAP's
/// count, IA32_MCG_STATUS, each IA32_MCi_STATUS with VAL, and its ADDR
/// and MISC when ADDRV and MISCV say they are valid).
fn machine_check_banks() {
    // # Safety: CPUID reads nothing.
    if unsafe { pax_cpuid(1, 0, 3) } & CPUID1_MCA == 0 {
        return
    }
    // # Safety: cpu.S's RDMSR of the architectural MCA registers, which
    // CPUID.1:EDX's MCA bit says exist; bank i < IA32_MCG_CAP's count.
    unsafe {
        let cap = pax_rdmsr(0x179)
        log.put("mce: MCG_CAP ")
        log.hex(cap)
        log.put(" MCG_STATUS ")
        log.hex(pax_rdmsr(0x17a))
        log.end()
        let banks = if cap & 0xff > 32 { 32 } else { cap & 0xff }
        var i: u64 = 0
        while i < banks {
            let status = pax_rdmsr(0x401 + 4 * i)
            if status >> 63 != 0 {
                log.put("mce: bank ")
                log.dec(i as int)
                log.put(" status ")
                log.hex(status)
                if (status >> 58) & 1 != 0 {
                    log.put(" addr ")
                    log.hex(pax_rdmsr(0x402 + 4 * i))
                }
                if (status >> 59) & 1 != 0 {
                    log.put(" misc ")
                    log.hex(pax_rdmsr(0x403 + 4 * i))
                }
                log.end()
            }
            i += 1
        }
    }
}

/// Write the tables' two lines (kernel/gdt's and kernel/idt's).
pub fn report() {
    gdt.report()
    idt.report()
}

/// Breakpoints taken since boot.
pub fn breakpoints() -> u64 {
    // # Safety: a read of the counter; the kernel's interrupts are off.
    unsafe { breakpoint_count }
}

/// PAX_SWITCH: the vector boot/sched.S's `pax_switch` writes into the
/// frame it builds (no gate routes it).
const SWITCH: u64 = 0x81

/// A stack overflow (px07): CR2 in thread `id`'s guard. Halts.
fn overflow(id: u64, cr2: u64) {
    log.put("PANIC stack overflow thread ")
    log.dec(id as int)
    log.put(" cr2 ")
    log.hex(cr2)
    log.put(" guard ")
    log.hex(sched.guard_lo(id))
    log.put(" to ")
    log.hex(sched.stack_lo(id))
    log.end()
    panic.halt()
}

/// Write the panic line for the frame at `f` and halt.
fn fatal(f: *Frame) {
    // # Safety: `f` is the trampoline's frame, live for this call.
    let (v, e, rip, rsp) = unsafe { (f[0].vector, f[0].error, f[0].rip, f[0].rsp) }
    if v == 8 || v == 14 {
        // # Safety: cpu.S's MOV from CR2: the last page fault's address,
        // the one that raised this (or, for #DF, the fault inside it).
        let a = unsafe { pax_cr2() }
        let t = sched.guard_of(a)
        if t != 0 {
            overflow(t - 1, a)
        }
    }
    if v == 18 {
        machine_check_banks() // px77d: what the hardware logged, first
    }
    log.put("PANIC ")
    log.put(name(v))
    log.put(" vector ")
    log.dec(v as int)
    log.put(" error ")
    log.hex(e)
    log.put(" rip ")
    log.hex(rip)
    log.put(" rsp ")
    log.hex(rsp)
    log.put(" frame ")
    // # Safety: the frame's address; nothing is read.
    log.hex(unsafe { f as u64 })
    if v == 14 {
        // # Safety: cpu.S's MOV from CR2; the fault being reported set it.
        let a = unsafe { pax_cr2() }
        log.put(" cr2 ")
        log.hex(a)
        if a >= HEAP_LO && a < HEAP_HI {
            log.put(" (heap)")
        }
    }
    log.end()
    // px77d: in triage mode the fault in large hex too, then the halt.
    // # Safety: the frame's CS; cpu.S's MOV from CR2.
    triage.fatal(v, e, rip, rsp, unsafe { pax_cr2() }, unsafe { f[0].cs })
    panic.halt()
}

/// boot/isr.S's common path calls this for every routed vector (and
/// boot/sched.S's `pax_switch` for PAX_SWITCH), and resumes the frame it
/// returns. px26: whatever frame `route` picks is first shown to
/// kernel/signal, which, when it returns to ring 3 and its thread has a
/// signal to take, points it at a handler or ends the process and hands
/// back the next thread's.
export fn pax_interrupt(f: *Frame) -> *Frame {
    // plant: an application processor allocates (the runtime's List) before kernel/klock's `enter`, NMIs and
    // shootdowns excepted (red at SMP-NOHEAP and SMP-LOCK by `PANIC heap: alloc before heap.start`)
    if percpu.index() != 0 && unsafe { f[0].vector } != 2 && unsafe { f[0].vector } != tlb.VECTOR {
        var xs = List[int]()
        (mut xs).push(1)
    }
    // px77d: an NMI resumes where it landed, whatever ring, and nothing
    // else is done on its way out (it can land anywhere, even inside the
    // scheduler with IF clear).
    // # Safety: `f` is the trampoline's frame, live for this call.
    if unsafe { f[0].vector } == 2 {
        // px161: each processor's own count; CPU 0's line as before, none
        // from an application processor (CPU 0 writes the log unlocked).
        if percpu.index() == 0 {
            percpu.count(percpu.NMIS)
            nmi(f)
        } else {
            smp.ap_nmi(unsafe { f as u64 })
        }
        return f
    }
    // px166: the shootdown (kernel/tlb's vector 49), answered before the
    // kernel lock and kernel/smp's `ap_early`: its requester holds the lock
    // and spins for this answer. `answer` touches this processor's own
    // mailbox, counter, TLB and CR3 alone; the frame resumes as it came.
    if unsafe { f[0].vector } == tlb.VECTOR {
        tlb.answer()
        apic.eoi()
        return f
    }
    // px161: an application processor's spurious vector, or a vector it
    // never takes, is kernel/smp's alone (px166: `ap_early`; 0 for every
    // other, taken under the lock below).
    if percpu.index() != 0 {
        // # Safety: the frame's address; kernel/smp hands back `f` itself.
        let e = unsafe { smp.ap_early(f as u64) }
        if e != 0 {
            // # Safety: `e` is `f`.
            return unsafe { e as *Frame }
        }
    }
    // px166: the kernel lock (kernel/klock), taken by every entry the two
    // returns above do not answer, before any kernel state is read; a fresh
    // hold gives the running thread its ambient region back. A processor
    // that comes in from ring 3 must not hold it already: every way into
    // ring 3 gives it back (klock's header), so a hold carried out is a bug,
    // named here rather than healed (the other processors would have spun).
    // # Safety: the frame's address, read by kernel/user.
    if user.from_user(unsafe { f as u64 }) && klock.held_here() {
        panic.fail("klock: entered from ring 3 holding it, cpu ", percpu.index())
    }
    let fresh = klock.enter()
    if fresh {
        sched.ambient_resume()
    }
    // px166: a test kernel's `pax.slowleave=MS` (kernel/testwords; no hold as
    // shipped, so nothing below runs there). An application processor that
    // comes in from ring 3 with its thread ended in place by another processor
    // (an exec's or an exit_group's sibling, `ended_here`) gives the lock back
    // and holds that many of CPU 0's ticks, interrupts off, answering
    // shootdowns, before it takes the lock again and switches the thread off:
    // what a host that has not run this processor's vCPU does. Its thread stays
    // current here meanwhile (its slot's processor word), so nothing reaps it;
    // tests/mpx6-smp's leave kind (SMP-EXEC-LEAVE) makes the window every time.
    let hold = testwords.hold()
    // # Safety: the frame's address; nothing is read here.
    if hold != 0 && fresh && percpu.index() != 0 && user.from_user(unsafe { f as u64 }) && sched.ended_here() {
        klock.leave()
        let until = timer.ticks() + hold
        while timer.ticks() < until {
            tlb.answer()
            sync.relax()
        }
        if klock.enter() {
            sched.ambient_resume()
        }
        testwords.held(percpu.index(), sched.self_slot(), sched.self_pid())
    }
    let g = route(f)
    // # Safety: the frame `route` returned is this one or a saved frame
    // on a live thread's stack; what kernel/signal returns is one too.
    let h = unsafe { signal.on_return(g as u64) }
    // px166: the lock given back whole when `h` resumes ring 3 or the idle
    // loop, kept one level up otherwise (kernel/user's `hand_back`).
    let r = user.hand_back(h)
    // # Safety: `r` is `h`, the frame kernel/signal returned.
    unsafe { r as *Frame }
}

/// The vector's own work: the frame to resume.
fn route(f: *Frame) -> *Frame {
    // # Safety: `f` is the trampoline's frame, live for this call.
    let v = unsafe { f[0].vector }
    // px166 (step 5a): the door. A thread another processor ended in place
    // (exit_group, exec) while it ran in ring 3 or spun for the lock leaves
    // here: its system call or ring-3 fault is never routed. Its ticks and
    // RESCHEDs switch it off in kernel/sched (`preempt`, `kick`); CPU 0's
    // devices are routed as ever, and the ender's RESCHED follows.
    // # Safety: the frame's address; nothing is read here.
    if (v == user.SYSCALL || (v < 32 && user.from_user(unsafe { f as u64 }))) && sched.ended_here() {
        // # Safety: the frame sched hands back is a saved frame on a live
        // thread's stack or an idle loop's.
        return unsafe { sched.leave_ended(f as u64) as *Frame }
    }
    // px166: a thread owed its group exit's PTRACE_EVENT_EXIT (another
    // processor's exit_group found it running here) takes it here: its
    // system call or ring-3 fault is never routed.
    // # Safety: the frame's address; nothing is read here.
    if (v == user.SYSCALL || (v < 32 && user.from_user(unsafe { f as u64 }))) && sched.owes_exit_stop() {
        // # Safety: as above.
        return unsafe { sched.take_exit_stop(f as u64) as *Frame }
    }
    // px102: the DPL-3 INT3 gate delivers #BP, not #GP. A traced
    // user receives a stop; an untraced user takes SIGTRAP normally.
    if v == 1 && !user.from_user(unsafe { f as u64 }) && trace.kernel_debug(unsafe { f as u64 }) { return f }
    if (v == 1 || v == 3) && user.from_user(unsafe { f as u64 }) {
        // #DB arrives on shared IST4: never park a pointer into it.
        let owned = if v == 1 { sched.trace_own_frame(unsafe { f as u64 }) } else { unsafe { f as u64 } }
        let stopped = trace.exception(owned, v)
        if stopped != 0 { return unsafe { stopped as *Frame } }
        return unsafe { user.kill(owned, name(v)) as *Frame }
    }
    if v == 3 {
        // # Safety: as above.
        let rip = unsafe { f[0].rip }
        // # Safety: the counter is touched with interrupts off.
        unsafe {
            breakpoint_count += 1
        }
        log.put("int3: breakpoint vector 3, rip ")
        log.hex(rip)
        log.end()
        return f
    }
    if v == timer.MASTER_BASE {
        // px166: an application processor's tick is its own: counted and
        // acknowledged, then its running thread's quantum; every duty below
        // is CPU 0's.
        if percpu.index() != 0 {
            // # Safety: the frame's address; nothing is read here.
            smp.ap_tick(user.from_user(unsafe { f as u64 }))
            // # Safety: as below.
            return unsafe { sched.preempt(f as u64) as *Frame }
        }
        timer.tick()
        testwords.tick(timer.ticks()) // px166: nothing as shipped (a test build's test panic)
        smp.report_stops() // px161: an application processor stopped since, named once
        speaker.tick(timer.ticks()) // px18: a KDMKTONE tone's end
        xhci.tick()
        console.pointer_drain() // px117: the pointers' records, the pointer drawn, the reports typed
        let sg = console.take_signals(console.CON)
        if sg != 0 { signal.tty(sg) }
        if console.started() && console.readable(console.CON) { let _n = sched.wake_input() }
        // # Safety: the frame's address; nothing is read here.
        if user.from_user(unsafe { f as u64 }) {
            user.count_tick() // px09: a tick that landed in ring 3
            percpu.count(percpu.USER) // px166: CPU 0's own count of them
        }
        // # Safety: the frame's address, and the one sched hands back is
        // a saved frame on a live thread's stack.
        return unsafe { sched.preempt(f as u64) as *Frame }
    }
    if v == smp.RESCHED_VECTOR {
        smp.took_resched()
        // # Safety: the frame's address, and the one sched hands back is
        // a saved frame on a live thread's stack or an idle loop's.
        return unsafe { sched.kick(f as u64) as *Frame }
    }
    if v == SWITCH {
        // # Safety: as above.
        return unsafe { sched.switched(f as u64) as *Frame }
    }
    if v == user.SYSCALL {
        // # Safety: as above; the frame user.syscall returns is this one
        // or a saved frame on a live thread's stack.
        return unsafe { user.syscall(f as u64) as *Frame }
    }
    if v == console.com1_vector() || v == console.kbd_vector() {
        console.irq(v)
        // px26: Ctrl-C, Ctrl-\ and Ctrl-Z are signals for every process
        // (kernel/console's ISIG, kernel/signal's `tty`).
        let sg = console.take_signals(console.CON)
        if sg != 0 {
            signal.tty(sg)
        }
        if console.readable(console.CON) {
            let _n = sched.wake_input()
        }
        // # Safety: as above.
        return unsafe { sched.kick(f as u64) as *Frame }
    }
    if (v == 39 || v == 47) && timer.spurious(v) {
        return f
    }
    let usb = xhci.irq(v)
    let snd = sound.vector() != 0 && v == sound.vector()
    let network = net.vector() != 0 && v == net.vector()
    if usb || snd || network {
        // INTx is shared: drain every device before one PIC EOI. net.irq
        // already acknowledges, so do not acknowledge a second time.
        if snd { let _back = sound.irq(); sched.wake_pipes() }
        if network { net.irq(v); let _n = sched.wake_net() }
        else { timer.eoi(v) }
        if usb {
            let sg = console.take_signals(console.CON)
            if sg != 0 { signal.tty(sg) }
            if console.readable(console.CON) { let _n = sched.wake_input() }
        }
        return unsafe { sched.kick(f as u64) as *Frame }
    }
    // # Safety: the frame's address; nothing is read here.
    if v == 14 && user.from_user(unsafe { f as u64 }) {
        // px34: a page of a MAP_NORESERVE range touched for the first
        // time is backed now and the instruction runs again.
        // # Safety: cpu.S's MOV from CR2: this page fault's address.
        let cr2 = unsafe { pax_cr2() }
        // # Safety: the trampoline's frame, live for this call.
        let e = unsafe { f[0].error }
        if user.fault_in(cr2, e) {
            return f
        }
    }
    // # Safety: the frame's address; nothing is read here.
    if v < 32 && v != 8 && v != 18 && user.from_user(unsafe { f as u64 }) {
        // # Safety: as above.
        return unsafe { user.kill(f as u64, name(v)) as *Frame }
    }
    fatal(f)
    f
}
