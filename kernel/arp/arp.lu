//! arp — the Address Resolution Protocol for IPv4 over Ethernet, and
//! the cache kernel/ip sends through (px20; the cache is px21's).
//!
//! An ARP packet rides in an Ethernet frame of type 0x0806 (RFC 826;
//! RFC 894 for the frame), every field big-endian:
//!
//!     0  destination address (6)      6  source address (6)     12  type 0x0806
//!     14 hardware type 1 (Ethernet)   16 protocol type 0x0800 (IPv4)
//!     18 hardware length 6            19 protocol length 4
//!     20 opcode: 1 request, 2 reply
//!     22 sender hardware address (6)  28 sender protocol address (4)
//!     32 target hardware address (6)  38 target protocol address (4)
//!
//! 42 bytes; kernel/net pads a sent one to 60 with zeros, and a
//! received one may carry padding, which is not read.
//!
//! **The cache.** `ENTRIES` (8) entries, each free, incomplete (asked
//! for, not yet answered) or resolved.
//!
//! - *Ageing.* A resolved entry is good for `age` ticks (`start`'s
//!   argument; 6000, a minute, unless a test shortens it: RFC 1122
//!   §2.3.2.1 asks for a timeout "on the order of a minute") from the
//!   last ARP packet that named its sender. Past that it is not used:
//!   `send` makes it incomplete and asks again, and `tick` frees one
//!   nobody has used.
//! - *Retry.* An incomplete entry is asked for at once and then once
//!   every `RETRY` ticks (a second: the rate RFC 1122 §2.3.2.1
//!   recommends as the most a host should ask), `TRIES` (3) requests
//!   in all; a second after the third the entry is freed and the
//!   frames that waited are dropped, counted `unresolved`.
//! - *The pending queue.* `PENDING` (2) frames per unresolved address
//!   (RFC 1122 §2.3.2.2 asks that at least the latest be kept); one
//!   more pushes out the oldest, counted `pushed out`. The reply sends
//!   what waits, oldest first.
//! - *Eviction.* A new address takes a free entry, else the resolved
//!   entry confirmed longest ago, never an incomplete one: with eight
//!   addresses all being asked for, a frame for a ninth is dropped,
//!   counted `table full`.
//! - *Learning* is RFC 826's reception algorithm: a packet whose
//!   hardware type, protocol type, lengths or opcode are not the ones
//!   above is discarded (`bad`); if the sender's protocol address has
//!   an entry, its hardware address is replaced and the entry is
//!   confirmed (the merge); if the target protocol address is this
//!   station's, the sender gets an entry unless it was merged, and a
//!   request is answered. So a gratuitous announcement (target not
//!   this station's address) changes an entry that exists and creates
//!   none. Three senders teach nothing: 0.0.0.0 (an address probe; a
//!   request from one is still answered), the limited broadcast, and
//!   this station's own address (`conflict`: someone else claims it;
//!   counted and not answered). A sender hardware address that is zero
//!   or a group address is `bad`. Nothing is learned from an IP
//!   datagram.
//!
//! `send(hop, frame, len)` is kernel/ip's way out: the frame is whole
//! but for its destination address, which the cache fills in; with no
//! usable entry the frame is copied onto the entry's queue and a
//! request goes out. `query(ip)` starts a resolution with no frame;
//! `lookup(ip)` reads the cache; `tick()` is the cache's clock, called
//! every ten ticks by kernel/netd's second thread.
//!
//! State is words of boot/net.S's `pax_arp_state`, one frame the
//! packets are composed in and eight frames for the queues (two
//! 2048-byte halves each), all taken once at `start` and all under
//! `sync.arp()`, which is taken before `sync.net()`. Nothing here
//! allocates from the heap.
//!
//! Written from RFC 826 (the packet, the reception algorithm), RFC 894
//! and RFC 1122 §2.3.2 (the cache: its timeout, the request rate, the
//! saved packet). No Linux source; no other kernel's or network
//! stack's source.

use frames
use log
use net
use sync
use timer

extern "c" fn pax_fb_copy(dst: u64, src: u64, bytes: u64)

extern "c" let pax_arp_state: *u64

const ETHERTYPE: u64 = 0x0806
const PACKET: u64 = 42

/// Entries in the cache.
pub const ENTRIES: u64 = 8
/// Frames that may wait on one unresolved address.
pub const PENDING: u64 = 2
/// Ticks between two requests for one address.
pub const RETRY: u64 = 100
/// Requests sent for one address before it is given up.
pub const TRIES: u64 = 3
/// The default age, in ticks, past which a resolved entry is not used.
pub const AGE: u64 = 6000
const HALF: u64 = 2048

// pax_arp_state's words.
const A_IP: u64 = 0 // this station's protocol address
const A_FRAME: u64 = 1 // where a packet is composed (HHDM)
const A_AGE: u64 = 2 // ticks a resolved entry is good for
const A_ASKER_IP: u64 = 16 // the last station whose request was answered
const A_ASKER_HW: u64 = 17
const A_GAVE_IP: u64 = 18 // the last address given up on
const A_GAVE_FRAMES: u64 = 19 // and how many frames waited for it
const A_SLOTS: u64 = 24 // eight words: each entry's queue frame (HHDM)
const A_TABLE: u64 = 32 // eight entries of eight words

// An entry's words.
const E_STATE: u64 = 0
const E_IP: u64 = 1
const E_HW: u64 = 2
const E_STAMP: u64 = 3 // resolved: the tick it was confirmed; incomplete: the last request's
const E_TRIES: u64 = 4 // requests sent while incomplete
const E_PENDING: u64 = 5 // frames waiting
const E_LEN: u64 = 6 // two words: their lengths

const FREE: u64 = 0
const INCOMPLETE: u64 = 1
const RESOLVED: u64 = 2

/// The counters (`count`): requests sent.
pub const C_REQUESTS_OUT: u64 = 3
/// Replies addressed to this station.
pub const C_REPLIES_IN: u64 = 4
/// Requests for this station's address.
pub const C_REQUESTS_IN: u64 = 5
/// Replies sent.
pub const C_REPLIES_OUT: u64 = 6
/// Packets that are not Ethernet/IPv4 ARP, too short, of an opcode that is neither, or from no single station.
pub const C_BAD: u64 = 7
/// Packets whose sender claims this station's protocol address.
pub const C_CONFLICT: u64 = 8
/// Frames put on an unresolved address's queue.
pub const C_QUEUED: u64 = 9
/// Queued frames sent when the reply came.
pub const C_FLUSHED: u64 = 10
/// Queued frames pushed out by a later one.
pub const C_PUSHED: u64 = 11
/// Queued frames dropped when their address was given up.
pub const C_UNRESOLVED: u64 = 12
/// Addresses given up after `TRIES` requests.
pub const C_GAVE_UP: u64 = 13
/// Frames dropped for want of an entry.
pub const C_TABLE_FULL: u64 = 14
/// Resolved entries that aged out.
pub const C_AGED: u64 = 15
/// Entries created by a packet for this station.
pub const C_LEARNED: u64 = 20
/// Entries confirmed or changed by a packet from their address.
pub const C_UPDATED: u64 = 21

/// `send`'s answers: the frame went to the device.
pub const SENT: u64 = 0
/// It waits for its address.
pub const QUEUED: u64 = 1
/// It was dropped: no entry could be had.
pub const DROPPED: u64 = 2
/// kernel/net refused it.
pub const FAILED: u64 = 3

fn aw(i: u64) -> u64 {
    // # Safety: i < 128, a word of boot/net.S's pax_arp_state.
    unsafe { ((pax_arp_state as u64 + i * 8) as *u64).read_volatile() }
}

fn put_aw(i: u64, v: u64) {
    // # Safety: as `aw`.
    unsafe { ((pax_arp_state as u64 + i * 8) as *u64).write_volatile(v) }
}

fn bump(i: u64, by: u64) {
    put_aw(i, aw(i) + by)
}

fn ew(e: u64, f: u64) -> u64 {
    aw(A_TABLE + e * 8 + f)
}

fn put_ew(e: u64, f: u64, v: u64) {
    put_aw(A_TABLE + e * 8 + f, v)
}

/// Counter `i` (C_*).
pub fn count(i: u64) -> u64 {
    aw(i)
}

fn octet(a: u64) -> u64 {
    // # Safety: a byte of a frame the caller owns (a receive buffer, or
    // this module's own frame), through the HHDM.
    let v = unsafe { (a as *u8).read_volatile() }
    v as u64
}

fn put_byte(a: u64, v: u64) {
    // # Safety: a byte of a frame this module or its caller owns.
    unsafe { (a as *u8).write_volatile((v & 0xff) as u8) }
}

fn be16(a: u64) -> u64 {
    octet(a) << 8 | octet(a + 1)
}

fn be32(a: u64) -> u64 {
    be16(a) << 16 | be16(a + 2)
}

fn put_be16(a: u64, v: u64) {
    put_byte(a, v >> 8)
    put_byte(a + 1, v)
}

fn put_be32(a: u64, v: u64) {
    put_be16(a, v >> 16)
    put_be16(a + 2, v)
}

/// The six bytes at `a` as one word, byte i in bits 8i..8i+7
/// (kernel/net's form).
fn hw(a: u64) -> u64 {
    var m: u64 = 0
    var i: u64 = 0
    while i < 6 {
        m = m | octet(a + i) << (i * 8)
        i += 1
    }
    m
}

fn put_hw(a: u64, m: u64) {
    var i: u64 = 0
    while i < 6 {
        put_byte(a + i, m >> (i * 8))
        i += 1
    }
}

fn own_hw() -> u64 {
    var m: u64 = 0
    var i: u64 = 0
    while i < 6 {
        m = m | net.mac_byte(i) << (i * 8)
        i += 1
    }
    m
}

/// Take `ip` (a.b.c.d as a << 24 | b << 16 | c << 8 | d) as this
/// station's protocol address and `age` ticks as a resolved entry's
/// life; take the frames the packets and the queues live in. IF clear.
pub fn start(ip: u64, age: u64) {
    var i: u64 = 0
    while i < 128 {
        put_aw(i, 0)
        i += 1
    }
    put_aw(A_IP, ip)
    put_aw(A_AGE, age)
    let pa = frames.alloc() else 0
    if pa != 0 {
        put_aw(A_FRAME, pa + frames.hhdm())
    }
    var e: u64 = 0
    while e < ENTRIES {
        let q = frames.alloc() else 0
        if q != 0 {
            put_aw(A_SLOTS + e, q + frames.hhdm())
        }
        e += 1
    }
}

/// This station's protocol address.
pub fn ip() -> u64 {
    aw(A_IP)
}

/// Frames this module holds (one to compose in, one per entry).
pub fn frames_held() -> u64 {
    var n: u64 = if aw(A_FRAME) != 0 { 1 } else { 0 }
    var e: u64 = 0
    while e < ENTRIES {
        if aw(A_SLOTS + e) != 0 {
            n += 1
        }
        e += 1
    }
    n
}

/// The entry holding `ip`, in any state but free; ENTRIES when none.
fn find(ip: u64) -> u64 {
    var i: u64 = 0
    while i < ENTRIES {
        if ew(i, E_STATE) != FREE && ew(i, E_IP) == ip {
            return i
        }
        i += 1
    }
    ENTRIES
}

/// An entry for a new address: a free one, else the resolved one
/// confirmed longest ago; ENTRIES when every entry is incomplete.
fn claim() -> u64 {
    var best: u64 = ENTRIES
    var i: u64 = 0
    while i < ENTRIES {
        if ew(i, E_STATE) == FREE {
            return i
        }
        if ew(i, E_STATE) == RESOLVED && (best == ENTRIES || ew(i, E_STAMP) < ew(best, E_STAMP)) {
            best = i
        }
        i += 1
    }
    best
}

fn clear(e: u64) {
    var f: u64 = 0
    while f < 8 {
        put_ew(e, f, 0)
        f += 1
    }
}

/// Compose one packet in the module's frame and send it. The ARP lock
/// held.
fn emit(to: u64, op: u64, tha: u64, tpa: u64) {
    let f = aw(A_FRAME)
    if f == 0 {
        return
    }
    put_hw(f, to)
    put_hw(f + 6, own_hw())
    put_be16(f + 12, ETHERTYPE)
    put_be16(f + 14, 1)
    put_be16(f + 16, 0x0800)
    put_byte(f + 18, 6)
    put_byte(f + 19, 4)
    put_be16(f + 20, op)
    put_hw(f + 22, own_hw())
    put_be32(f + 28, aw(A_IP))
    put_hw(f + 32, tha)
    put_be32(f + 38, tpa)
    let sent = net.send(f, PACKET) else 0
    if sent != 0 {
        bump(if op == 1 { C_REQUESTS_OUT } else { C_REPLIES_OUT }, 1)
    }
}

/// Broadcast a request for entry `e`'s address and note when. The ARP
/// lock held.
fn ask(e: u64, now: u64) {
    emit(0xffffffffffff, 1, 0, ew(e, E_IP))
    put_ew(e, E_TRIES, ew(e, E_TRIES) + 1)
    put_ew(e, E_STAMP, now)
}

/// Make entry `e` an incomplete one for `ip`, with nothing waiting,
/// and ask. The ARP lock held.
fn begin(e: u64, ip: u64, now: u64) {
    clear(e)
    put_ew(e, E_STATE, INCOMPLETE)
    put_ew(e, E_IP, ip)
    ask(e, now)
}

/// Send what waits on entry `e`, oldest first, to its hardware
/// address. The ARP lock held.
fn flush(e: u64) {
    let base = aw(A_SLOTS + e)
    var s: u64 = 0
    while s < ew(e, E_PENDING) {
        let f = base + s * HALF
        put_hw(f, ew(e, E_HW))
        let _sent = net.send(f, ew(e, E_LEN + s)) else 0
        bump(C_FLUSHED, 1)
        s += 1
    }
    put_ew(e, E_PENDING, 0)
}

/// Send the `len`-byte frame at `frame` to the station whose protocol
/// address is `hop`: bytes 0-5, the destination address, are written
/// here; the rest is the caller's. With a resolved entry of an age to
/// be used the frame goes out now (SENT, or FAILED when kernel/net
/// refuses it); otherwise it is copied onto the address's queue and a
/// request is out or goes out (QUEUED), or there is no entry to be had
/// (DROPPED). `len` is at most 1514.
pub fn send(hop: u64, frame: u64, len: u64) -> u64 {
    let saved = sync.acquire(sync.arp())
    let now = timer.ticks()
    var e = find(hop)
    if e < ENTRIES && ew(e, E_STATE) == RESOLVED {
        if now - ew(e, E_STAMP) <= aw(A_AGE) {
            put_hw(frame, ew(e, E_HW))
            let q = net.send(frame, len) else 0
            sync.release(sync.arp(), saved)
            return if q != 0 { SENT } else { FAILED }
        }
        bump(C_AGED, 1)
        begin(e, hop, now)
    }
    if e == ENTRIES {
        e = claim()
        if e == ENTRIES || aw(A_SLOTS + e) == 0 {
            bump(C_TABLE_FULL, 1)
            sync.release(sync.arp(), saved)
            return DROPPED
        }
        begin(e, hop, now)
    }
    let base = aw(A_SLOTS + e)
    if base == 0 || len > HALF {
        bump(C_TABLE_FULL, 1)
        sync.release(sync.arp(), saved)
        return DROPPED
    }
    if ew(e, E_PENDING) == PENDING {
        // The oldest gives way: the later frame moves down.
        // # Safety: both halves of this entry's queue frame, which the
        // module owns; the length is at most 1514.
        unsafe { pax_fb_copy(base, base + HALF, ew(e, E_LEN + 1)) }
        put_ew(e, E_LEN, ew(e, E_LEN + 1))
        put_ew(e, E_PENDING, PENDING - 1)
        bump(C_PUSHED, 1)
    }
    let s = ew(e, E_PENDING)
    // # Safety: a half of this entry's queue frame; `len` <= 2048 bytes
    // of the caller's frame.
    unsafe { pax_fb_copy(base + s * HALF, frame, len) }
    put_ew(e, E_LEN + s, len)
    put_ew(e, E_PENDING, s + 1)
    bump(C_QUEUED, 1)
    sync.release(sync.arp(), saved)
    QUEUED
}

/// Start resolving `ip` with no frame waiting, unless an entry of an
/// age to be used, or a request, is already there.
pub fn query(ip: u64) {
    let saved = sync.acquire(sync.arp())
    let now = timer.ticks()
    var e = find(ip)
    if e < ENTRIES && ew(e, E_STATE) == RESOLVED && now - ew(e, E_STAMP) > aw(A_AGE) {
        bump(C_AGED, 1)
        begin(e, ip, now)
    }
    if e == ENTRIES {
        e = claim()
        if e < ENTRIES {
            begin(e, ip, now)
        } else {
            bump(C_TABLE_FULL, 1)
        }
    }
    sync.release(sync.arp(), saved)
}

/// The hardware address the cache holds for `ip`, if it is resolved
/// and of an age to be used: `(true, address)`, or `(false, 0)`.
pub fn lookup(ip: u64) -> (bool, u64) {
    let saved = sync.acquire(sync.arp())
    let e = find(ip)
    var m: u64 = 0
    var known = false
    if e < ENTRIES && ew(e, E_STATE) == RESOLVED && timer.ticks() - ew(e, E_STAMP) <= aw(A_AGE) {
        m = ew(e, E_HW)
        known = true
    }
    sync.release(sync.arp(), saved)
    (known, m)
}

/// The cache's clock (kernel/netd's second thread, every ten ticks):
/// ask again for what is still unanswered after `RETRY` ticks, give an
/// address up after `TRIES` requests, free a resolved entry past its
/// age.
pub fn tick() {
    let saved = sync.acquire(sync.arp())
    let now = timer.ticks()
    var e: u64 = 0
    while e < ENTRIES {
        let st = ew(e, E_STATE)
        if st == INCOMPLETE && now - ew(e, E_STAMP) >= RETRY {
            if ew(e, E_TRIES) >= TRIES {
                bump(C_UNRESOLVED, ew(e, E_PENDING))
                bump(C_GAVE_UP, 1)
                put_aw(A_GAVE_IP, ew(e, E_IP))
                put_aw(A_GAVE_FRAMES, ew(e, E_PENDING))
                clear(e)
            } else {
                ask(e, now)
            }
        } else if st == RESOLVED && now - ew(e, E_STAMP) > aw(A_AGE) {
            bump(C_AGED, 1)
            clear(e)
        }
        e += 1
    }
    sync.release(sync.arp(), saved)
}

/// A received frame of type 0x0806, `len` bytes at `frame` (RFC 826's
/// reception algorithm; kernel/netd calls this in thread context).
pub fn input(frame: u64, len: u64) {
    let saved = sync.acquire(sync.arp())
    if len < PACKET || be16(frame + 14) != 1 || be16(frame + 16) != 0x0800 || octet(frame + 18) != 6 || octet(frame + 19) != 4 {
        bump(C_BAD, 1)
        sync.release(sync.arp(), saved)
        return
    }
    let op = be16(frame + 20)
    let sha = hw(frame + 22)
    let spa = be32(frame + 28)
    let tpa = be32(frame + 38)
    // A sender is one station: not zero, not a group address (the low
    // bit of the first byte).
    if (op != 1 && op != 2) || sha == 0 || sha & 1 == 1 {
        bump(C_BAD, 1)
        sync.release(sync.arp(), saved)
        return
    }
    if spa == aw(A_IP) {
        bump(C_CONFLICT, 1)
        sync.release(sync.arp(), saved)
        return
    }
    let now = timer.ticks()
    let teaches = spa != 0 && spa != 0xffffffff
    var merged = false
    if teaches {
        let e = find(spa)
        if e < ENTRIES {
            put_ew(e, E_HW, sha)
            put_ew(e, E_STATE, RESOLVED)
            put_ew(e, E_STAMP, now)
            put_ew(e, E_TRIES, 0)
            bump(C_UPDATED, 1)
            merged = true
            flush(e)
        }
    }
    if tpa == aw(A_IP) {
        if teaches && !merged {
            let n = claim()
            if n < ENTRIES {
                clear(n)
                put_ew(n, E_STATE, RESOLVED)
                put_ew(n, E_IP, spa)
                put_ew(n, E_HW, sha)
                put_ew(n, E_STAMP, now)
                bump(C_LEARNED, 1)
            }
        }
        if op == 1 {
            bump(C_REQUESTS_IN, 1)
            put_aw(A_ASKER_IP, spa)
            put_aw(A_ASKER_HW, sha)
            emit(sha, 2, sha, spa)
        } else {
            bump(C_REPLIES_IN, 1)
        }
    }
    sync.release(sync.arp(), saved)
}

/// The last station whose request for this station's address was
/// answered: its protocol and hardware addresses (0, 0 before any).
pub fn asker() -> (u64, u64) {
    (aw(A_ASKER_IP), aw(A_ASKER_HW))
}

/// The last address given up on and how many frames had waited for it
/// (0, 0 before any).
pub fn gave_up() -> (u64, u64) {
    (aw(A_GAVE_IP), aw(A_GAVE_FRAMES))
}

/// Write `ip` as a.b.c.d.
pub fn put_ip(ip: u64) {
    log.dec(((ip >> 24) & 0xff) as int)
    log.put(".")
    log.dec(((ip >> 16) & 0xff) as int)
    log.put(".")
    log.dec(((ip >> 8) & 0xff) as int)
    log.put(".")
    log.dec((ip & 0xff) as int)
}

/// Write a hardware address (kernel/net's form) as aa:bb:cc:dd:ee:ff.
pub fn put_hw_text(m: u64) {
    var i: u64 = 0
    while i < 6 {
        if i > 0 {
            log.put(":")
        }
        log.hex_n(m >> (i * 8), 2)
        i += 1
    }
}

/// The cache, one line per entry in use:
///
///     arp: entry <i>: <a.b.c.d> at <aa:bb:cc:dd:ee:ff>, confirmed <t> ticks ago
///     arp: entry <i>: <a.b.c.d> incomplete, <n> requests, <p> frames waiting
pub fn report() {
    let saved = sync.acquire(sync.arp())
    let now = timer.ticks()
    var e: u64 = 0
    while e < ENTRIES {
        let st = ew(e, E_STATE)
        if st != FREE {
            log.put("arp: entry ")
            log.dec(e as int)
            log.put(": ")
            put_ip(ew(e, E_IP))
            if st == RESOLVED {
                log.put(" at ")
                put_hw_text(ew(e, E_HW))
                log.put(", confirmed ")
                log.dec((now - ew(e, E_STAMP)) as int)
                log.put(" ticks ago")
            } else {
                log.put(" incomplete, ")
                log.dec(ew(e, E_TRIES) as int)
                log.put(" requests, ")
                log.dec(ew(e, E_PENDING) as int)
                log.put(" frames waiting")
            }
            log.end()
        }
        e += 1
    }
    sync.release(sync.arp(), saved)
}

/// The counters' two lines:
///
///     arp: <a> requests sent, <b> replies received, <c> requests answered (<d> replies sent), <e> bad, <f> conflict
///     arp: cache <l> learned, <u> updated, <g> aged; pending <q> queued, <s> sent, <p> pushed out, <x> unresolved (<y> addresses given up), <t> table full
pub fn counters() {
    log.put("arp: ")
    log.dec(aw(C_REQUESTS_OUT) as int)
    log.put(" requests sent, ")
    log.dec(aw(C_REPLIES_IN) as int)
    log.put(" replies received, ")
    log.dec(aw(C_REQUESTS_IN) as int)
    log.put(" requests answered (")
    log.dec(aw(C_REPLIES_OUT) as int)
    log.put(" replies sent), ")
    log.dec(aw(C_BAD) as int)
    log.put(" bad, ")
    log.dec(aw(C_CONFLICT) as int)
    log.put(" conflict")
    log.end()
    log.put("arp: cache ")
    log.dec(aw(C_LEARNED) as int)
    log.put(" learned, ")
    log.dec(aw(C_UPDATED) as int)
    log.put(" updated, ")
    log.dec(aw(C_AGED) as int)
    log.put(" aged; pending ")
    log.dec(aw(C_QUEUED) as int)
    log.put(" queued, ")
    log.dec(aw(C_FLUSHED) as int)
    log.put(" sent, ")
    log.dec(aw(C_PUSHED) as int)
    log.put(" pushed out, ")
    log.dec(aw(C_UNRESOLVED) as int)
    log.put(" unresolved (")
    log.dec(aw(C_GAVE_UP) as int)
    log.put(" addresses given up), ")
    log.dec(aw(C_TABLE_FULL) as int)
    log.put(" table full")
    log.end()
}
