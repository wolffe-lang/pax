//! trace — Linux ptrace(2) stops and x86-64 register access (px102).
//! Clean room: ptrace(2), wait(2), Intel SDM vol. 3A interrupt gates,
//! vol. 3B chapter 20, and the committed binary-only Linux witnesses.
use cred
use files
use fpu
use log
use paging
use sched
use trace_mem
use trace_state
use uaccess

extern "c" fn pax_debug_status() -> u64
extern "c" let pax_syscall_entry: *u8

const EPERM: u64 = 0xffffffffffffffff
const ESRCH: u64 = 0xfffffffffffffffd
const EIO: u64 = 0xfffffffffffffffb
const EFAULT: u64 = 0xfffffffffffffff2
const EINVAL: u64 = 0xffffffffffffffea
const TOP: u64 = 0x00007ffffffff000
const TF: u64 = 0x100
const ERESTARTSYS: u64 = 0xfffffffffffffe00 // -512
const ERESTARTNOHAND: u64 = 0xfffffffffffffdfe // -514
const ERESTART_RESTARTBLOCK: u64 = 0xfffffffffffffdfc // -516

fn refused(req: u64) -> u64 {
    log.put("ptrace: refused request ")
    log.hex(req)
    log.end()
    EIO
}

fn word(f: u64, i: u64) -> u64 {
    // # Safety: callers name one of the 22 words in a live saved frame.
    unsafe { ((f + i * 8) as *u64).read_volatile() }
}
fn put_word(f: u64, i: u64, v: u64) {
    // # Safety: same live frame and bounded index as word.
    unsafe { ((f + i * 8) as *u64).write_volatile(v) }
}

/// Linux user_regs_struct index to the PAX interrupt frame's word.
fn frame_index(i: u64) -> u64 {
    if i < 4 { return i }
    if i == 4 { return 8 } // rbp
    if i == 5 { return 13 } // rbx
    if i >= 6 && i <= 9 { return i - 2 } // r11, r10, r9, r8
    if i == 10 { return 14 } // rax
    if i == 11 { return 12 } // rcx
    if i == 12 { return 11 } // rdx
    if i == 13 { return 10 } // rsi
    if i == 14 { return 9 } // rdi
    if i == 16 { return 17 } // rip
    if i == 18 { return 19 } // flags
    20 // rsp (i == 19)
}

fn reg(s: u64, i: u64) -> u64 {
    if i == 15 { return sched.trace_orig(s) }
    // The external ABI is Linux amd64, not PAX's GDT numbering.
    if i == 17 { return 0x33 }
    if i == 20 { return 0x2b }
    if i == 21 { return sched.trace_fs(s) }
    if i >= 22 { return 0 } // GS base and the unused data selectors
    word(sched.trace_frame(s), frame_index(i))
}

fn getregs(s: u64, data: u64, bytes: u64) -> u64 {
    let pml4 = paging.live()
    if bytes != 0 && !uaccess.writable(pml4, data, bytes) { return EFAULT }
    var i: u64 = 0
    while i < bytes / 8 {
        uaccess.put(pml4, data + i * 8, reg(s, i), 8)
        i += 1
    }
    0
}

fn setregs(s: u64, data: u64) -> u64 {
    let pml4 = paging.live()
    if !uaccess.readable(pml4, data, 216) { return EFAULT }
    // Validate the complete image before changing any saved register.
    // Only the 64-bit ABI is supported: no compatibility-mode selectors,
    // GS-base switching or user data segments are enabled by this layer.
    if uaccess.get64(pml4, data + 17 * 8) != 0x33 || uaccess.get64(pml4, data + 20 * 8) != 0x2b { return EIO }
    if uaccess.get64(pml4, data + 16 * 8) >= TOP || uaccess.get64(pml4, data + 19 * 8) >= TOP || uaccess.get64(pml4, data + 21 * 8) >= TOP { return EIO }
    var i: u64 = 22
    while i < 27 {
        if uaccess.get64(pml4, data + i * 8) != 0 { return EIO }
        i += 1
    }
    let f = sched.trace_frame(s)
    i = 0
    while i < 15 {
        put_word(f, frame_index(i), uaccess.get64(pml4, data + i * 8))
        i += 1
    }
    sched.trace_set_orig(s, uaccess.get64(pml4, data + 15 * 8))
    put_word(f, 17, uaccess.get64(pml4, data + 16 * 8))
    put_word(f, 18, 0x23) // map the reported Linux CS back to PAX's
    put_word(f, 19, (uaccess.get64(pml4, data + 18 * 8) & 0x250dd5) | 0x202)
    put_word(f, 20, uaccess.get64(pml4, data + 19 * 8))
    put_word(f, 21, 0x1b) // likewise Linux SS 0x2b -> PAX SS 0x1b
    sched.trace_set_fs(s, uaccess.get64(pml4, data + 21 * 8))
    put_word(f, 15, 0x101) // IRETQ, preserving the requested RCX/R11
    0
}

fn fpregs(s: u64, data: u64, bytes: u64) -> u64 {
    let pml4 = paging.live()
    if bytes != 0 && !uaccess.writable(pml4, data, bytes) { return EFAULT }
    let a = fpu.area(s) // stopped: the switch saved this thread's state
    if a == 0 { return EIO }
    // # Safety: XSAVE areas include the header word at byte 512.
    let bv = if fpu.xsave() { unsafe { ((a + 512) as *u64).read_volatile() } } else { 3 }
    var i: u64 = 0
    while i < bytes {
        // # Safety: a is the thread's FXSAVE/XSAVE area, >= 512 bytes.
        var b = unsafe { ((a + i) as *u8).read_volatile() as u64 }
        // XSAVE may omit init-state components; stale bytes then have
        // no meaning. Export the architectural initial values instead.
        if bv & 1 == 0 && (i < 24 || (i >= 32 && i < 160)) {
            b = if i == 0 { 0x7f } else if i == 1 { 3 } else { 0 }
        }
        if bv & 2 == 0 && ((i >= 24 && i < 28) || (i >= 160 && i < 416)) {
            b = if i == 24 { 0x80 } else if i == 25 { 0x1f } else { 0 }
        }
        if i >= 416 { b = 0 } // user_fpregs_struct's reserved padding
        uaccess.put(pml4, data + i, b, 1)
        i += 1
    }
    0
}

fn getregset(s: u64, note: u64, data: u64) -> u64 {
    let pml4 = paging.live()
    if !uaccess.readable(pml4, data, 16) || !uaccess.writable(pml4, data + 8, 8) { return EFAULT }
    if note != 1 && note != 2 {
        log.put("ptrace: refused register set ")
        log.hex(note)
        log.end()
        return EINVAL
    }
    let dst = uaccess.get64(pml4, data)
    let n = uaccess.get64(pml4, data + 8)
    if n & 7 != 0 { return EINVAL }
    let max = if note == 1 { 216 } else { 512 }
    let bytes = if n < max { n } else { max }
    let err = if note == 1 { getregs(s, dst, bytes) } else { fpregs(s, dst, bytes) }
    if err == 0 { uaccess.put(pml4, data + 8, bytes, 8) }
    err
}

fn peekuser(s: u64, addr: u64, data: u64) -> u64 {
    if addr & 7 != 0 || addr >= 928 { return EIO }
    var v: u64 = 0
    if addr < 216 { v = reg(s, addr / 8) }
    else if addr >= 848 && addr < 912 { v = sched.trace_dr(s, (addr - 848) / 8) }
    let pml4 = paging.live()
    if !uaccess.writable(pml4, data, 8) { return EFAULT }
    uaccess.put(pml4, data, v, 8)
    0
}

fn dr7_valid(s: u64, dr7: u64, changed: u64, addr: u64) -> bool {
    if dr7 >> 32 != 0 { return false }
    var i: u64 = 0
    while i < 4 {
        if (dr7 >> (i * 2)) & 3 != 0 {
            let control = (dr7 >> (16 + 4 * i)) & 15
            let rw = control & 3
            let len = control >> 2
            if rw == 2 || (rw == 0 && len != 0) { return false }
            let n = if len == 0 { 1 } else if len == 1 { 2 } else if len == 2 { 8 } else { 4 }
            let a = if changed == i { addr } else { sched.trace_dr(s, i) }
            if a >= TOP || a & (n - 1) != 0 { return false }
        }
        i += 1
    }
    true
}

fn pokeuser(s: u64, addr: u64, data: u64) -> u64 {
    if addr & 7 != 0 || addr < 848 || addr >= 912 { return EIO }
    let n = (addr - 848) / 8
    if n == 4 || n == 5 { return EIO }
    if n < 4 {
        if data >= TOP { return EIO }
        if !dr7_valid(s, sched.trace_dr(s, 7), n, data) { return EINVAL }
    }
    if n == 7 && !dr7_valid(s, data, 8, 0) { return EINVAL }
    if n == 6 && data >> 32 != 0 { return EIO }
    sched.trace_set_dr(s, n, data)
    0
}

pub fn call(req: u64, pid: u64, addr: u64, data: u64) -> u64 {
    if req == 0 {
        let parent = sched.proc_slot(sched.self_ppid())
        if parent == sched.SLOTS || !files.may_trace_mode(sched.proc_area(parent), sched.proc_area(sched.self_slot()), true) { return EPERM }
        return if sched.trace_me() { 0 } else { EPERM }
    }
    let tid = pid & 0xffffffff
    if req == 16 || req == 0x4206 {
        let seized = req == 0x4206
        // SEIZE's argument failures are EIO, unlike SETOPTIONS' EINVAL.
        if seized && (addr != 0 || data & !0x10007f != 0) { return EIO }
        let target = sched.trace_live(tid)
        if target == sched.SLOTS { return ESRCH }
        if sched.trace_tgid(target) == sched.self_pid() || sched.tracer_of(target) != 0 { return EPERM }
        if !files.may_trace_mode(sched.proc_area(sched.self_slot()), sched.proc_area(target), true) { return EPERM }
        sched.trace_bind(target, seized, if seized { data } else { 0 })
        if !seized {
            // Measured ATTACH stop: SI_KERNEL, zero pid/uid union.
            sched.raise_thread(target, 19, sched.sig_info(sched.I_KERNEL, 0, 0, 0))
        }
        return 0
    }
    if req == 0x4207 {
        let target = sched.trace_live(tid)
        if target == sched.SLOTS || sched.tracer_of(target) != sched.self_tid() { return ESRCH }
        if trace_state.control(target) & trace_state.SEIZED == 0 { return EIO }
        if !sched.trace_is_stopped(target) { sched.trace_interrupt(target) }
        return 0
    }
    let s = sched.trace_target(tid)
    if s == sched.SLOTS { return ESRCH }
    if req == 1 || req == 2 {
        let (ok, value) = trace_mem.peek(s, addr)
        if !ok { return EIO }
        let pml4 = paging.live()
        if !uaccess.writable(pml4, data, 8) { return EFAULT }
        uaccess.put(pml4, data, value, 8)
        return 0
    }
    if req == 4 || req == 5 { return trace_mem.poke(s, addr, data) }
    if req == 12 { return getregs(s, data, 216) }
    if req == 13 { return setregs(s, data) }
    if req == 14 { return fpregs(s, data, 512) }
    if req == 3 { return peekuser(s, addr, data) }
    if req == 6 { return pokeuser(s, addr, data) }
    if req == 0x4204 { return getregset(s, addr, data) }
    if req == 17 {
        if data > 64 { return EIO }
        request_signal(s, data)
        sched.trace_detach(s)
        return 0
    }
    if req == 7 || req == 9 || req == 24 {
        if data > 64 { return EIO }
        request_signal(s, data)
        trace_state.set_mode(s, if req == 24 { 1 } else { 0 })
        let f = sched.trace_frame(s)
        put_word(f, 19, (word(f, 19) & !TF) | (if req == 9 { TF } else { 0 }))
        sched.trace_resume(s)
        return 0
    }
    if req == 8 {
        let _sent = sched.raise_tid(0, pid & 0xffffffff, 9, sched.sig_info(sched.I_KERNEL, 0, 0, 0))
        return 0
    }
    if req == 0x4200 {
        // TRACESYSGOOD, TRACEFORK/VFORK/CLONE/EXEC/VFORKDONE/EXIT, EXITKILL.
        if data & !0x10007f != 0 { return EINVAL }
        trace_state.set_options(s, data)
        return 0
    }
    if req == 0x4201 {
        let pml4 = paging.live()
        if !uaccess.writable(pml4, data, 8) { return EFAULT }
        uaccess.put(pml4, data, trace_state.event(s), 8)
        return 0
    }
    if req == 0x4202 {
        let pml4 = paging.live()
        if !uaccess.writable(pml4, data, 128) { return EFAULT }
        let (sig, code, at) = sched.trace_info(s)
        uaccess.zero(pml4, data, 128)
        let kind = trace_state.stop_kind(s)
        uaccess.put(pml4, data, if kind == 2 || kind == 3 { 5 } else { sig }, 4)
        uaccess.put(pml4, data + 8, code, 4)
        uaccess.put(pml4, data + 16, at, 8)
        if sig == 17 { uaccess.put(pml4, data + 24, trace_state.signal_status(s), 4) }
        return 0
    }
    refused(req)
}

pub fn exec_stop(f: u64) -> u64 {
    let s = sched.self_slot()
    if sched.tracer_of(s) == 0 { return f }
    let former = trace_state.exec_tid(s)
    trace_state.set_exec_tid(s, 0)
    if trace_state.options(s) & 0x10 != 0 { return event_stop(f, 4, if former != 0 { former } else { sched.self_tid() }) }
    if trace_state.control(s) & trace_state.SEIZED != 0 { return f }
    trace_state.set_phase(s, 0)
    trace_state.set_control(s, trace_state.control(s) & !(trace_state.FAULT | trace_state.INTERRUPT))
    trace_state.set_signal_info(s, sched.sig_info(sched.I_USER, sched.self_tid(), 0, cred.uid(sched.proc_area(s), cred.REAL)))
    trace_state.set_stop_kind(s, 1)
    trace_state.set_event(s, 0)
    sched.trace_stop(f, 5, 0, sender())
}

/// Only the single-step trap at the SYSCALL entry's first instruction is
/// consumed in ring 0. Other kernel #DB exceptions remain fatal.
pub fn kernel_debug(f: u64) -> bool {
    // # Safety: the entry symbol's address; MOV DR6 in this #DB handler.
    unsafe { word(f, 17) == pax_syscall_entry as u64 && pax_debug_status() & 0x4000 != 0 }
}

pub fn exception(f: u64, vector: u64) -> u64 {
    let s = sched.self_slot()
    if sched.tracer_of(s) == 0 { return 0 }
    sched.trace_set_orig(s, 0xffffffffffffffff)
    // A user-mode exception is beyond any previously completed syscall,
    // including one which resumed directly from a blocking wait.
    trace_state.set_phase(s, 0)
    trace_state.set_finish_pending(s, 0)
    trace_state.set_stop_kind(s, 1)
    trace_state.set_event(s, 0)
    trace_state.set_control(s, (trace_state.control(s) & !trace_state.INTERRUPT) | trace_state.FAULT)
    trace_state.set_fault_vector(s, vector)
    trace_state.set_fault_error(s, word(f, 16))
    put_word(f, 19, word(f, 19) & !TF)
    if vector == 3 { return sched.trace_stop(f, 5, 128, 0) }
    if vector == 1 {
        // # Safety: MOV DR6 from the debug exception that just arrived.
        let dr6 = unsafe { pax_debug_status() }
        sched.trace_set_dr(s, 6, (dr6 & 0xe00f) | 0xffff0ff0)
        put_word(f, 19, word(f, 19) & !TF)
        return sched.trace_stop(f, 5, if dr6 & 0x4000 != 0 { 2 } else { 4 }, word(f, 17))
    }
    0
}

/// SIGCHLD carries only the signal, while wait4/waitid retain event
/// tags. sender() is the signal-info union's pid/uid pair.
fn sender() -> u64 {
    sched.self_tid() | (cred.uid(sched.proc_area(sched.self_slot()), cred.REAL) << 32)
}

fn event_stop(f: u64, event: u64, message: u64) -> u64 {
    let s = sched.self_slot()
    trace_state.set_event(s, message)
    trace_state.set_control(s, trace_state.control(s) & !(trace_state.FAULT | trace_state.INTERRUPT))
    trace_state.set_stop_kind(s, 4)
    let tagged = 5 | (event << 8)
    sched.trace_stop(f, tagged, tagged, sender())
}

pub fn signal_stop(f: u64, sig: u64, code: u64, from: u64, status: u64, info: u64) -> u64 {
    async_snapshot(f)
    blocked_view(f)
    let s = sched.self_slot()
    trace_state.set_control(s, trace_state.control(s) & !(trace_state.FAULT | trace_state.INTERRUPT))
    trace_state.set_signal_info(s, info)
    trace_state.set_signal_status(sched.self_slot(), status)
    trace_state.set_stop_kind(sched.self_slot(), 1)
    trace_state.set_event(sched.self_slot(), 0)
    sched.trace_stop(f, sig, code, from)
}

fn syscall_stop(f: u64, kind: u64) -> u64 {
    let s = sched.self_slot()
    trace_state.set_stop_kind(s, kind)
    trace_state.set_control(s, trace_state.control(s) & !(trace_state.FAULT | trace_state.INTERRUPT))
    trace_state.set_event(s, 0)
    let sig = if trace_state.options(s) & 1 != 0 { 0x85 } else { 5 }
    sched.trace_stop(f, sig, sig, sender())
}

/// A new syscall stops before execution; a blocked syscall retry does
/// not produce a second entry stop. A zero result means serve it now.
pub fn syscall_enter(f: u64) -> u64 {
    let s = sched.self_slot()
    if sched.tracer_of(s) == 0 { return 0 }
    if trace_state.phase(s) == 2 { return 0 }
    trace_state.set_phase(s, 2)
    if trace_state.mode(s) != 1 { return 0 }
    trace_state.set_phase(s, 1)
    put_word(f, 14, 0xffffffffffffffda) // -ENOSYS at syscall entry
    syscall_stop(f, 2)
}

/// TRACEEXIT precedes destruction. Its continuation ignores register
/// edits that would attempt to turn the committed exit into another call.
pub fn before_exit(f: u64, nr: u64, status: u64) -> u64 {
    let s = sched.self_slot()
    if trace_state.exit_pending(s) == 2 {
        trace_state.set_exit_pending(s, 0)
        return 0
    }
    if sched.tracer_of(s) == 0 || trace_state.options(s) & 0x40 == 0 { return 0 }
    if nr == 231 { sched.trace_group_exit(status) } // exit_group: the others stop too
    trace_state.set_exit_pending(s, 1)
    trace_state.set_exit_nr(s, nr)
    trace_state.set_exit_status(s, status)
    event_stop(f, 6, status)
}

/// A syscall exit stop precedes user execution. A stepped syscall uses
/// Linux's measured TRAP_BRKPT, rather than an extra hardware instruction.
pub fn syscall_return(f: u64) -> u64 {
    let s = sched.self_slot()
    if word(f, 18) & 3 != 3 { return f }
    let completed = trace_state.phase(s) == 2
    if completed { trace_state.set_phase(s, 0) }
    if sched.tracer_of(s) == 0 { return f }
    if completed && trace_state.mode(s) == 1 { return syscall_stop(f, 3) }
    if word(f, 19) & TF == 0 { return f }
    put_word(f, 19, word(f, 19) & !TF)
    trace_state.set_control(s, trace_state.control(s) | trace_state.FAULT)
    trace_state.set_fault_vector(s, 1)
    trace_state.set_fault_error(s, 0)
    trace_state.set_stop_kind(s, 1)
    sched.trace_stop(f, 5, 1, word(f, 17))
}


/// Creation events bind the new child before either side can return to
/// user mode. The child's initial stop is taken on its first return.
pub fn created(f: u64, child: u64, event: u64) -> u64 {
    let s = sched.self_slot()
    if sched.tracer_of(s) == 0 { return 0 }
    if event == 2 { sched.trace_vfork_link(child) }
    let option = if event == 1 { 2 } else if event == 2 { 4 } else { 8 }
    if trace_state.options(s) & option == 0 { return 0 }
    sched.trace_inherit(child)
    event_stop(f, event, sched.slot_pid(child))
}

pub fn initial_stop(f: u64) -> u64 {
    let s = sched.self_slot()
    if sched.tracer_of(s) == 0 || trace_state.initial(s) != 1 || sched.kill_pending() { return 0 }
    trace_state.set_initial(s, 2)
    if trace_state.control(s) & trace_state.SEIZED != 0 { return event_stop(f, 128, 0) }
    trace_state.set_stop_kind(s, 1)
    trace_state.set_signal_info(s, 0)
    trace_state.set_event(s, 0)
    sched.trace_stop(f, 19, 0, 0)
}


/// A changed signal is newly attributed to the tracer (SI_USER), not
/// to the original sender. Non-signal-delivery stops do not inject.
fn request_signal(s: u64, sig: u64) {
    trace_state.set_inject_sig(s, 0)
    if sig == 0 || trace_state.stop_kind(s) != 1 { return }
    let (old, _code, _addr) = sched.trace_info(s)
    if old != sig {
        trace_state.set_control(s, trace_state.control(s) & !trace_state.FAULT)
        trace_state.set_signal_info(s, sched.sig_info(sched.I_USER, sched.self_tid(), 0, cred.uid(sched.proc_area(sched.self_slot()), cred.REAL)))
    }
    trace_state.set_inject_sig(s, sig)
}

/// Ring-3 asynchronous snapshots are outside the last completed syscall.
/// Saved syscall continuations keep orig_rax and their completion state.
fn async_snapshot(f: u64) {
    let v = word(f, 15)
    if v != 0x100 && v != 0x102 && v != 0x103 {
        let s = sched.self_slot()
        sched.trace_set_orig(s, 0xffffffffffffffff)
        trace_state.set_phase(s, 0)
        trace_state.set_finish_pending(s, 0)
    }
}

pub fn interrupt_stop(f: u64) -> u64 {
    let s = sched.self_slot()
    if sched.tracer_of(s) == 0 || trace_state.control(s) & trace_state.INTERRUPT == 0 || sched.kill_pending() { return 0 }
    async_snapshot(f)
    blocked_view(f)
    event_stop(f, 128, 0)
}

/// Synchronous faults stop before either a handler or the default action.
/// The original vector/error/address survive tracer syscalls and CR2 changes.
pub fn fault_stop(f: u64, sig: u64, code: u64, addr: u64, vector: u64, error: u64) -> u64 {
    let s = sched.self_slot()
    sched.trace_set_orig(s, 0xffffffffffffffff)
    trace_state.set_phase(s, 0)
    trace_state.set_finish_pending(s, 0)
    trace_state.set_stop_kind(s, 1)
    trace_state.set_event(s, 0)
    trace_state.set_control(s, (trace_state.control(s) & !trace_state.INTERRUPT) | trace_state.FAULT)
    trace_state.set_fault_vector(s, vector)
    trace_state.set_fault_error(s, error)
    put_word(f, 19, word(f, 19) & !TF)
    sched.trace_stop(f, sig, code, addr)
}


/// A tracing stop out of a waiting system call shows Linux's registers
/// (ptrace(2), measured): rip past the SYSCALL, rax a -ERESTART* code,
/// orig_rax the call. -512 for a rewound read/write/wait and an untimed
/// futex wait, -516 for a relative sleep (restart_syscall finishes it),
/// -514 for an absolute clock_nanosleep. kernel/signal settles the code
/// when the tracee resumes; other waits keep PAX's own settling.
fn blocked_view(f: u64) {
    let s = sched.self_slot()
    trace_state.set_restart(s, 0)
    let (w, arg) = sched.self_wait_peek()
    if w == sched.W_REWOUND {
        put_word(f, 17, word(f, 17) + 2)
        put_word(f, 14, ERESTARTSYS)
    } else if w == sched.W_FUTEX {
        put_word(f, 14, ERESTARTSYS)
    } else if w == sched.W_SLEEP {
        if sched.trace_orig(s) == 230 && word(f, 10) & 1 != 0 {
            put_word(f, 14, ERESTARTNOHAND) // TIMER_ABSTIME: run again as it was
        } else {
            put_word(f, 14, ERESTART_RESTARTBLOCK)
            trace_state.set_restart_wake(s, sched.self_wake())
            trace_state.set_restart_arg(s, arg)
        }
    } else {
        return
    }
    let _taken = sched.self_wait()
    trace_state.set_restart(s, word(f, 14))
    // Its restart is a new call to a tracer: a fresh syscall-entry stop.
    trace_state.set_phase(s, 0)
    trace_state.set_finish_pending(s, 0)
}
