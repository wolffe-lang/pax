//! timer — the 8259 interrupt controllers and the 8254 interval timer
//! (kw10, M-PX2's timer).
//!
//! **The tick is the local APIC timer (px76, R-px76-1 A).** kw10 ticked
//! the 8254 PIT through the 8259, which needs no calibration; a real
//! board may gate the 8254's clock in S0 (the Intel 500-series PCH can),
//! so the tick no longer depends on it. `start` calibrates the local
//! APIC timer against kernel/clock's monotonic nanoseconds (the HPET's
//! main counter, else the ACPI PM timer, else the PIT read back, in that
//! order) and runs it periodic at 100 Hz on vector 32. The 8259s stay
//! for the legacy lines that still use them (COM1's 4, the i8042's 1,
//! an INTx device's level line); the PIT's line 0 stays masked.
//!
//! `start`:
//! - the two 8259s are re-initialised (ICW1-ICW4: edge-triggered,
//!   cascaded, the slave on the master's line 2, 8086 mode) with their
//!   vector bases at 32 and 40, off the exception vectors 0-31 (the
//!   PC's power-on bases, 8 and 0x70, put IRQ 0-7 on vectors 8-15), and
//!   every line masked (OCW1 0xff on both);
//! - kernel/clock is started (a no-op when a kernel started it first);
//! - the local APIC timer is masked one-shot with divide-by-16 (DCR 3)
//!   and an initial count of 0xffffffff, counted down across 20 ms of
//!   the clock, and the rate (counts per second) is that difference over
//!   the elapsed nanoseconds; each end reads the count and then the clock
//!   back to back (`triple`, px107), after one read to warm the path, so
//!   the reads' own time cancels; windows are measured until two in a row
//!   agree within 0.1%, a window whose clock interval is not the PM
//!   timer's within 0.5% is set aside, each such window and disagreement
//!   is a `timer: LAPIC calibration: …` line, and after six the median of
//!   the last three kept is taken (`calibrate`); a count that did not
//!   move, or a rate under 100 Hz, panics by name;
//! - the LVT timer is set periodic, vector 32, unmasked, with an initial
//!   count of rate / 100: one tick every 10 ms;
//! - one line names the clock and the rate: `timer: LAPIC calibrated by
//!   HPET|PM|PIT divide16 <rate> Hz, tick 100 Hz vector 32; PIT IRQ
//!   masked`.
//! `drift` (px107, pax#308) prints the tick clock against the clock
//! since `mark` (else since the tick was armed): what every timeout counted
//! in ticks is off by.
//! `tick` (kernel/interrupts, vector 32) counts, samples the clock (so a
//! PIT-backed clock never misses its 54.9 ms wrap) and sends the local
//! APIC its end of interrupt. `eoi` acknowledges an 8259 line at the
//! 8259s and an MSI vector (80-83) at the local APIC. `stop` masks every
//! 8259 line and the LVT timer. `wait` sleeps until one interrupt has
//! been handled (boot/isr.S's STI; HLT; CLI): the kernel otherwise runs
//! with interrupts off.
//! `spurious` reads a controller's in-service register (OCW3 0x0b): a
//! line-7 (vector 39) or line-15 (vector 47) request whose in-service
//! bit is clear was withdrawn before it was acknowledged and must not be
//! acknowledged (the master is, for a spurious slave request, because it
//! did see line 2).
//!
//! Written from Intel's 8259A programmable interrupt controller data
//! sheet (ICW1-ICW4, OCW1-OCW3, the in-service register, the spurious
//! IR7 request) and Intel's 8254 programmable interval timer data sheet
//! (the control word, mode 2, the 1.193182 MHz input as the PC wires
//! it), and the I/O ports the PC assigns them (master 0x20/0x21, slave
//! 0xa0/0xa1, PIT 0x40-0x43); the edge/level control registers are
//! Intel's ICH9 data sheet's (ELCR1 and ELCR2, I/O ports 0x4d0 and
//! 0x4d1; px20); the local APIC timer's description is
//! the Intel SDM vol. 3A §11.5.4 ("APIC Timer": the divide
//! configuration, the initial and current counts, one-shot and periodic
//! modes) and §11.4.1, and its EOI register §11.8.5 (px76). No Linux
//! source; no other kernel's source.

use apic
use clock
use log
use panic

extern "c" fn pax_outb(port: u16, v: u8)
extern "c" fn pax_inb(port: u16) -> u8
extern "c" fn pax_wait()

extern "c" let pax_tick_count: *u64

const MASTER_CMD: u16 = 0x20
const MASTER_DATA: u16 = 0x21
const SLAVE_CMD: u16 = 0xa0
const SLAVE_DATA: u16 = 0xa1
const ELCR_MASTER: u16 = 0x4d0 // px20
const ELCR_SLAVE: u16 = 0x4d1

// The master 8259's vector base after `start` (its line 0, the PIT's,
// is 32, which the local APIC timer's tick also takes while line 0
// stays masked; px76) and the slave's. Other modules read them as
// `timer.MASTER_BASE` and so on (wolf 0.2.26, wolf-lang#579; px16
// retired the `pub fn`s that returned them; px76 retired the PIT's
// divisor with the PIT's tick).
/// The master 8259's vector base after `start`: 32, the tick's vector.
pub const MASTER_BASE: u64 = 32
/// The slave 8259's vector base after `start`: 40.
pub const SLAVE_BASE: u64 = 40

// Timer interrupts handled since `start`: boot/isr.S's `pax_tick_count`,
// read and written volatile (px07, #598). It was a module `var`; wolf
// 0.2.24's compiled tiers forward a module var's value across a call
// that writes it (wolf-lang#598), and the handler writes this one
// behind every call a polling loop makes (`wait`, a switch).
fn count() -> u64 {
    // # Safety: boot/isr.S's 8-byte word, written only here and by `tick`.
    unsafe { pax_tick_count.read_volatile() }
}

fn set_count(v: u64) {
    // # Safety: as `count`.
    unsafe { pax_tick_count.write_volatile(v) }
}

/// Spurious requests seen (vectors 39 and 47).
var spurious_seen: u64 = 0
var lapic_started: bool = false
var measured_hz: u64 = 0
var armed_ns: u64 = 0 // px107: the clock when the periodic tick was armed (`drift`)
var mark_ns: u64 = 0 // px107: the clock at `mark`, and the ticks then
var mark_ticks: u64 = 0
var marked: bool = false
var delivered_count: u64 = 0 // px131: tick interrupts delivered (`drift`, kernel/latency)
var follow: bool = false // px131: the count follows kernel/clock (`follow_clock`)
const PERIOD_NS: u64 = 10000000 // px131: the tick's period, as `start` arms it (100 Hz)

fn out(port: u16, v: u64) {
    // # Safety: io.S's OUT to an 8259 or 8254 port; v < 256.
    unsafe { pax_outb(port, v as u8) }
}

fn inp(port: u16) -> u64 {
    // # Safety: io.S's IN from an 8259 port.
    let v = unsafe { pax_inb(port) }
    v as u64
}

/// Remap and mask the 8259s, calibrate the local APIC timer against
/// kernel/clock, tick at 100 Hz on vector 32 and say so.
pub fn start() {
    set_count(0) // #598
    unsafe { delivered_count = 0 }
    // # Safety: the counter is touched with interrupts off.
    unsafe {
        spurious_seen = 0
    }
    out(MASTER_CMD, 0x11) // ICW1: initialise, ICW4 follows (edge, cascade)
    out(SLAVE_CMD, 0x11)
    out(MASTER_DATA, MASTER_BASE) // ICW2: vector base
    out(SLAVE_DATA, SLAVE_BASE)
    out(MASTER_DATA, 4) // ICW3: a slave on line 2
    out(SLAVE_DATA, 2) // ICW3: its cascade identity, 2
    out(MASTER_DATA, 1) // ICW4: 8086 mode
    out(SLAVE_DATA, 1)
    out(MASTER_DATA, 0xff) // OCW1: every line masked
    out(SLAVE_DATA, 0xff)
    clock.start()
    if !clock.started() { panic.fail("timer: no clock advances, so the LAPIC tick cannot be calibrated", 0) }
    // Intel SDM vol.3A §11.5.4: masked one-shot, divide by 16 (DCR=3).
    apic.write(0x320, (0x10000 | MASTER_BASE) as u32)
    apic.write(0x3e0, 3)
    apic.write(0x380, 0xffffffff)
    let rate = calibrate()
    if rate < 100 || rate / 100 > 0xffffffff { panic.fail("timer: LAPIC calibration rate", rate) }
    unsafe { measured_hz = rate; lapic_started = true }
    apic.write(0x320, (0x20000 | MASTER_BASE) as u32)
    apic.write(0x380, (rate / 100) as u32)
    unsafe { armed_ns = clock.now_ns() }
    report()
}

/// px107 (pax#308): the local APIC timer's current count, kernel/clock's
/// nanoseconds and the PM timer read directly (0 when there is none),
/// back to back by the same code. Both ends of a calibration window are
/// one, so the time between its reads is in both intervals and cancels.
/// Read the old way (the clock, the count; the count, the clock) it was in
/// the clock's interval alone: under emulation, where each read is a trip
/// to the emulator, the rate came out up to 2% low, the tick that much
/// short, and every timeout counted in ticks that much early (`drift`).
fn triple() -> (u64, u64, u64) {
    let c = apic.read(0x390)
    let t = clock.now_ns()
    (c, t, clock.pm_now())
}

const WINDOW_US: u64 = 20000 // one calibration window
const WINDOWS: u64 = 6 // at most, before the median of the last three kept

/// One window: the LAPIC timer's counts, the clock's nanoseconds and,
/// when a PM timer stands beside the HPET, the PM timer's (else 0).
fn window() -> (u64, u64, u64) {
    let (c0, t0, p0) = triple()
    clock.wait_us(WINDOW_US)
    let (c1, t1, p1) = triple()
    if t1 <= t0 || c1 >= c0 { panic.fail("timer: LAPIC calibration did not count", c1) }
    (c0 - c1, t1 - t0, if clock.pm_beside() { clock.pm_between(p0, p1) } else { 0 })
}

fn apart(a: u64, b: u64) -> u64 { if a >= b { a - b } else { b - a } }

fn median(a: u64, b: u64, c: u64) -> u64 {
    if (a <= b && b <= c) || (c <= b && b <= a) { return b }
    if (b <= a && a <= c) || (c <= a && a <= b) { return a }
    c
}

/// px107 (pax#308): the LAPIC timer's counts a second, from 20 ms windows
/// until two in a row agree within 0.1% (their mean). A window whose clock
/// interval is not the PM timer's within 0.5% is set aside: one counter
/// stood still or jumped inside it (a boot under KVM once calibrated at
/// 1.433 times the rate, and its clock, sleeps and timeouts ran at 0.70
/// of real time). After six, the median of the last three kept. Every
/// window set aside and every pair that disagrees is a boot line of its
/// own, `timer: LAPIC calibration: …`. With no PM timer beside the HPET
/// the agreement rule works alone, and a boot line says so: a stall in one
/// window is caught by the next, one alike in two windows in a row is not.
/// The same holds with the PM timer or the PIT as the clock, which their
/// own `clock:` line names.
fn calibrate() -> u64 {
    if clock.reads_hpet() && !clock.pm_beside() {
        // px107: the agreement rule alone, where the PM timer would have
        // held each window. A clock that stands still, or a count that
        // jumps, in one window is caught by the next; alike in two windows
        // in a row it would pass. With the PM timer or the PIT as the clock
        // the rule works alone too, and the clock's own line (`clock: PM
        // …`, `clock: PIT …`) already names the one counter there is: no
        // line here, so the timer's lines stay as every suite holds them.
        log.put("timer: LAPIC calibration: no second counter beside the "); log.put(clock.name())
        log.line(" to hold each window to; two windows off alike in a row would pass")
    }
    let (_c, _t, _p) = triple() // once first, so every window's ends run the same code the same way
    var last: u64 = 0 // the window before's rate, when it was kept
    var a: u64 = 0
    var b: u64 = 0
    var c: u64 = 0
    var r: u64 = 0
    var k: u64 = 0
    var loud = false
    while k < WINDOWS {
        k += 1
        let (counts, ns, pm) = window()
        r = counts * 1000000000 / ns
        if pm != 0 && apart(ns, pm) * 200 > ns {
            log.put("timer: LAPIC calibration: window "); log.dec(k as int); log.put(" set aside: ")
            log.dec(r as int); log.put(" Hz, the clock "); log.dec((ns / 1000) as int)
            log.put(" us against the PM timer's "); log.dec((pm / 1000) as int); log.line(" us")
            last = 0
            loud = true
            continue
        }
        if last != 0 && apart(r, last) * 1000 <= last {
            if loud {
                log.put("timer: LAPIC calibration: windows "); log.dec((k - 1) as int); log.put(" and ")
                log.dec(k as int); log.put(" of "); log.dec(WINDOWS as int); log.line(" agree")
            }
            return (r + last) / 2
        }
        if last != 0 {
            log.put("timer: LAPIC calibration: windows "); log.dec((k - 1) as int); log.put(" and ")
            log.dec(k as int); log.put(" disagree: "); log.dec(last as int); log.put(" and ")
            log.dec(r as int); log.line(" Hz")
            loud = true
        }
        a = b
        b = c
        c = r
        last = r
    }
    let m = if a != 0 { median(a, b, c) } else { if c != 0 { c } else { r } }
    log.put("timer: LAPIC calibration: no two windows in a row agreed in "); log.dec(WINDOWS as int)
    log.put("; took "); log.dec(m as int); log.line(" Hz")
    m
}

pub fn report() {
    log.put("timer: LAPIC calibrated by "); log.put(clock.name())
    log.put(" divide16 "); log.dec(unsafe { measured_hz } as int)
    log.line(" Hz, tick 100 Hz vector 32; PIT IRQ masked")
}

/// px107 (pax#308): where `drift` measures from, instead of the tick's
/// arming: a kernel marks the end of its boot's work. A tick that comes
/// while interrupts are off waits, and two that come in one such stretch
/// are one: a boot that keeps them off for more than 10 ms at a time loses
/// ticks, which is not the tick's rate.
pub fn mark() {
    let t = delivered()
    let ns = clock.now_ns()
    unsafe { mark_ticks = t; mark_ns = ns; marked = true }
}

/// px107 (pax#308): the tick clock against kernel/clock since the mark
/// (else since the tick was armed), one line: `timer: <n> ticks of 10 ms
/// in <us> us by HPET|PM|PIT since the mark|since the tick was armed: the
/// tick clock ahead|behind by <ppm> ppm`. Every timeout counted in ticks
/// (kernel/dhcp's lease, a sleep) runs that much early or late: ahead is a
/// tick too short (its calibration), behind a tick too long or ticks lost
/// with interrupts off. Nothing when the local APIC timer never started.
pub fn drift() {
    if !unsafe { lapic_started } { return }
    let m = unsafe { marked }
    let n = delivered() - (if m { unsafe { mark_ticks } } else { 0 })
    let ns = clock.now_ns() - (if m { unsafe { mark_ns } } else { unsafe { armed_ns } })
    let ticked = n * 10000000
    log.put("timer: "); log.dec(n as int)
    log.put(" ticks of 10 ms in "); log.dec((ns / 1000) as int)
    log.put(" us by "); log.put(clock.name())
    log.put(if m { " since the mark" } else { " since the tick was armed" })
    if ns == 0 { log.line(": no time yet"); return }
    if ticked >= ns {
        log.put(": the tick clock ahead by "); log.dec(((ticked - ns) * 1000000 / ns) as int)
    } else {
        log.put(": the tick clock behind by "); log.dec(((ns - ticked) * 1000000 / ns) as int)
    }
    log.line(" ppm")
}

/// Unmask master line `line` (px13: kernel/console's 1 and 4): a
/// read-modify-write of OCW1, IF clear.
pub fn unmask(line: u64) {
    let m = inp(MASTER_DATA)
    let bit: u64 = 1 << line
    if m & bit != 0 {
        out(MASTER_DATA, m - bit)
    }
}

/// Unmask line `line` (0-15) on either controller (px20: a PCI
/// function's line, kernel/net): a slave line also needs the master's
/// line 2, the cascade, unmasked. IF clear.
pub fn unmask_line(line: u64) {
    if line < 8 {
        unmask(line)
        return
    }
    let m = inp(SLAVE_DATA)
    let bit: u64 = 1 << (line - 8)
    if m & bit != 0 {
        out(SLAVE_DATA, m - bit)
    }
    unmask(2)
}

/// The edge/level control registers (ELCR, ports 0x4d0 and 0x4d1: bit
/// n of the pair set makes line n level-triggered) as they are.
pub fn elcr() -> u64 {
    inp(ELCR_SLAVE) << 8 | inp(ELCR_MASTER)
}

/// Make line `line` (3-15, not 8 or 13) level-triggered (px20): a PCI
/// interrupt is a level, held until the device's cause is read.
pub fn level(line: u64) {
    if line < 8 {
        out(ELCR_MASTER, inp(ELCR_MASTER) | 1 << line)
    } else {
        out(ELCR_SLAVE, inp(ELCR_SLAVE) | 1 << (line - 8))
    }
}

/// The master's mask register (OCW1) as it is.
pub fn master_mask() -> u64 {
    inp(MASTER_DATA)
}

/// Acknowledge vector `v` (px13): a non-specific EOI to the master, and
/// to the slave first for one of its lines (40-47).
pub fn eoi(v: u64) {
    if v >= 80 && v < 84 { apic.write(0xb0, 0); return }
    if v >= SLAVE_BASE {
        out(SLAVE_CMD, 0x20)
    }
    out(MASTER_CMD, 0x20)
}

/// Mask every line on both controllers.
pub fn stop() {
    out(MASTER_DATA, 0xff)
    out(SLAVE_DATA, 0xff)
    if unsafe { lapic_started } { apic.write(0x320, (0x10000 | MASTER_BASE) as u32) }
}

/// Vector 32: count the tick and acknowledge it (non-specific EOI).
/// px131: with `follow_clock`, the count is the larger of itself plus one
/// and the ticks kernel/clock says are due since the tick was armed, so a
/// stretch with interrupts off longer than a tick (whose further ticks the
/// APIC drops) costs every deadline counted in ticks its timeliness only,
/// never its correctness: CLOCK_MONOTONIC and CLOCK_REALTIME, sleeps, poll's,
/// epoll's, a receive's and a futex's timeouts, TCP's, ARP's and DHCP's
/// timers all read `ticks`. The interrupts themselves are counted apart
/// (`delivered`).
pub fn tick() {
    unsafe { delivered_count += 1 }
    let now = clock.now_ns() // sample wrapping counters at every tick
    var next = count() + 1 // #598
    let armed = unsafe { armed_ns }
    if unsafe { follow && lapic_started } && now > armed {
        let due = (now - armed) / PERIOD_NS
        if due > next {
            next = due
        }
    }
    set_count(next)
    apic.write(0xb0, 0)
}

/// px131: the count follows kernel/clock from now on (`tick`). The shipped
/// kernel asks for it (kmain_console); the timer's and the scheduler's own
/// test kernels count interrupts, as their rows do, and so does a kernel
/// that fakes its clock's readings for its rows (kmain_metal).
pub fn follow_clock() {
    unsafe { follow = true }
}

/// Timer interrupts handled since `start` (px131: with `follow_clock`,
/// the ticks kernel/clock says have passed, at least).
pub fn ticks() -> u64 {
    count() // #598: a volatile read, never a value from before a call
}

/// px131: tick interrupts delivered since `start`, whatever `ticks` says:
/// a stretch with interrupts off longer than a tick delivers one.
pub fn delivered() -> u64 {
    unsafe { delivered_count }
}

/// Spurious requests seen since `start`.
pub fn spurious_count() -> u64 {
    // # Safety: as `ticks`.
    unsafe { spurious_seen }
}

/// Sleep until one interrupt has been handled.
pub fn wait() {
    // # Safety: boot/isr.S's STI; HLT; CLI. Every routed vector has a
    // gate (kernel/idt) before the kernel calls this.
    unsafe { pax_wait() }
}

/// Whether vector `v` (39 or 47) is a spurious request: its line's
/// in-service bit is clear. A spurious slave request still
/// acknowledges the master's line 2.
pub fn spurious(v: u64) -> bool {
    let cmd = if v == 47 { SLAVE_CMD } else { MASTER_CMD }
    out(cmd, 0x0b) // OCW3: read the in-service register
    if inp(cmd) & 0x80 != 0 {
        return false
    }
    if v == 47 {
        out(MASTER_CMD, 0x20)
    }
    // # Safety: interrupts are off in a handler.
    unsafe {
        spurious_seen += 1
    }
    true
}
