//! ip — IPv4 over Ethernet: one place a received header is judged, one
//! way a datagram leaves (px21).
//!
//! A datagram rides in an Ethernet frame of type 0x0800 (RFC 894), its
//! header at byte 14 (RFC 791), every field big-endian:
//!
//!     0  version (4 bits) and IHL (4 bits: the header's 32-bit words)
//!     1  type of service              2  total length (header and data)
//!     4  identification               6  flags (3 bits: 0, DF, MF) and
//!                                        fragment offset (13 bits)
//!     8  time to live                 9  protocol (1 ICMP, 6 TCP, 17 UDP)
//!     10 header checksum              12 source address
//!     16 destination address          20 options, when IHL > 5
//!
//! **Receiving.** `input(frame, len)` holds a frame's datagram to the
//! rules below, in this order, and counts the first one it breaks; a
//! datagram that breaks one is dropped and nothing is sent about it.
//!
//!     short         fewer than 20 bytes after the frame header, or
//!                   fewer than the header says it has (IHL x 4)
//!     version       not 4
//!     ihl           under 5
//!     checksum      the header does not sum to 0xffff (RFC 1071;
//!                   RFC 1122 §3.2.1.2: verified on every datagram)
//!     length        a total length under the header's, or over the
//!                   bytes the frame holds (bytes after it are the
//!                   link's padding and are not read: QEMU pads to 60
//!                   or 64 bytes, or not at all)
//!     ttl           0, which RFC 1122 §3.2.1.7 forbids a host to
//!                   send. 1 is accepted: the same section forbids
//!                   dropping a datagram for a time to live under 2
//!     fragment      MF set or a fragment offset that is not 0: PAX
//!                   reassembles nothing
//!     source        a source that names no single host (RFC 1122
//!                   §3.2.1.3): 0.0.0.0, 127/8, the limited or this
//!                   subnet's broadcast, class D or E, or this
//!                   station's own address
//!     option        an option list that does not parse (a length
//!                   under 2, or one that runs past the header)
//!     source-route  a loose or strict source route (types 131 and
//!                   137): refused by name. RFC 1122 §3.2.1.8 has a
//!                   host carry a source route into its reply; PAX
//!                   does not follow routes a stranger writes. Every
//!                   other option is skipped, as the same section
//!                   allows of options a host does not implement
//!     other         a destination that is not this station's address,
//!                   the limited broadcast or this subnet's broadcast
//!     protocol      a protocol nothing here speaks (anything but
//!                   ICMP). Counted here; kernel/netd asks kernel/icmp
//!                   to say so to the sender
//!
//! What passes is delivered by its protocol number. `input` returns
//! what to do with it — kernel/netd makes the call, so this module does
//! not import the protocols above it.
//!
//! **Sending.** `send(dst, protocol, payload, len)` composes one
//! datagram in this module's frame — version 4, IHL 5, no options, DF
//! set, time to live 64, the identification a counter from boot, the
//! source this station's address — and routes it: a destination on
//! this station's subnet (`dst & mask == address & mask`) is its own
//! next hop, any other goes to the gateway, and the two broadcasts go
//! to ff:ff:ff:ff:ff:ff with no resolution. kernel/arp's `send` writes
//! the next hop's hardware address and sends the frame, or keeps it
//! until the address is known.
//!
//! **The MTU is 1500 bytes** (RFC 894). PAX never fragments: `send`
//! refuses a payload over 1480 bytes (`size`), and with DF set no
//! router may fragment what it sends either. An echo reply is as long
//! as its request, which came in one frame, so it always fits.
//!
//! The address, netmask and gateway are `start`'s arguments, given
//! once at boot. State is words of boot/net.S's `pax_ip_state` and one
//! frame, under `sync.ip()`, which is taken before `sync.arp()` and
//! `sync.net()`. Nothing here allocates from the heap.
//!
//! Written from RFC 791 (the header, the options' encoding), RFC 894,
//! RFC 1071 (the checksum), RFC 1122 §3.2.1 (what a host checks) and
//! RFC 1812 §5.3.7 (which sources are never valid). No Linux source;
//! no other kernel's or network stack's source.

use arp
use frames
use log
use net
use sync

extern "c" fn pax_fb_copy(dst: u64, src: u64, bytes: u64)

extern "c" let pax_ip_state: *u64

/// The frame header's length: where a datagram starts.
pub const ETH: u64 = 14
/// The greatest datagram (RFC 894).
pub const MTU: u64 = 1500
/// The greatest payload `send` takes: the MTU less a 20-byte header.
pub const PAYLOAD_MAX: u64 = 1480
/// The time to live of every datagram sent.
pub const TTL: u64 = 64
/// ICMP's protocol number.
pub const ICMP: u64 = 1

// pax_ip_state's words.
const I_ADDR: u64 = 0
const I_MASK: u64 = 1
const I_GATEWAY: u64 = 2
const I_IDENT: u64 = 3 // the next datagram's identification
const I_FRAME: u64 = 4 // where a datagram is composed (HHDM)

/// The counters (`count`): datagrams that passed every rule and were
/// delivered to their protocol.
pub const C_RX: u64 = 8
/// Dropped: shorter than its header.
pub const C_SHORT: u64 = 9
/// Dropped: a version that is not 4.
pub const C_VERSION: u64 = 10
/// Dropped: an IHL under 5.
pub const C_IHL: u64 = 11
/// Dropped: a header checksum that is wrong.
pub const C_CHECKSUM: u64 = 12
/// Dropped: a total length under the header's or over the frame's.
pub const C_LENGTH: u64 = 13
/// Dropped: a time to live of 0.
pub const C_TTL: u64 = 14
/// Dropped: a fragment.
pub const C_FRAGMENT: u64 = 15
/// Dropped: a source that names no single host.
pub const C_SOURCE: u64 = 16
/// Dropped: an option list that does not parse.
pub const C_OPTION: u64 = 17
/// Dropped: a source route.
pub const C_SOURCE_ROUTE: u64 = 18
/// Dropped: for another host.
pub const C_OTHER: u64 = 19
/// Dropped: a protocol nothing here speaks.
pub const C_PROTOCOL: u64 = 20
/// Datagrams handed to the link: sent, or waiting on an address.
pub const C_TX: u64 = 21
/// Not sent: a payload over 1480 bytes.
pub const C_TX_SIZE: u64 = 22
/// Not sent: the link refused it (no cache entry to be had, or no
/// transmit buffer).
pub const C_TX_DROPPED: u64 = 23
/// Of the datagrams whose header passed, how many carried options.
pub const C_WITH_OPTIONS: u64 = 24
/// Of the datagrams whose header passed, how many were for a broadcast
/// address.
pub const C_BROADCAST: u64 = 25

/// `input`'s answers: the datagram was dropped (and counted).
pub const DROP: u64 = 0
/// It is ICMP's.
pub const TO_ICMP: u64 = 1
/// Its protocol is unknown; the sender may be told.
pub const NO_PROTOCOL: u64 = 2

/// `send`'s answers beyond kernel/arp's SENT, QUEUED, DROPPED and
/// FAILED: the payload is over 1480 bytes.
pub const SIZE: u64 = 4
/// The module has no frame to compose in.
pub const DOWN: u64 = 5

fn iw(i: u64) -> u64 {
    // # Safety: i < 64, a word of boot/net.S's pax_ip_state.
    unsafe { ((pax_ip_state as u64 + i * 8) as *u64).read_volatile() }
}

fn put_iw(i: u64, v: u64) {
    // # Safety: as `iw`.
    unsafe { ((pax_ip_state as u64 + i * 8) as *u64).write_volatile(v) }
}

fn bump(i: u64) {
    let saved = sync.acquire(sync.ip())
    put_iw(i, iw(i) + 1)
    sync.release(sync.ip(), saved)
}

/// Counter `i` (C_*).
pub fn count(i: u64) -> u64 {
    iw(i)
}

/// The byte at `a`: of a frame the caller owns, through the HHDM.
pub fn octet(a: u64) -> u64 {
    // # Safety: a byte of a frame the caller owns (a receive buffer it
    // has not given back, or a module's own frame), through the HHDM.
    let v = unsafe { (a as *u8).read_volatile() }
    v as u64
}

/// Write the low byte of `v` at `a`, in a frame the caller owns.
pub fn put_byte(a: u64, v: u64) {
    // # Safety: as `octet`.
    unsafe { (a as *u8).write_volatile((v & 0xff) as u8) }
}

/// The big-endian 16-bit word at `a`.
pub fn be16(a: u64) -> u64 {
    octet(a) << 8 | octet(a + 1)
}

/// The big-endian 32-bit word at `a`.
pub fn be32(a: u64) -> u64 {
    be16(a) << 16 | be16(a + 2)
}

/// Write `v`'s low 16 bits at `a`, big-endian.
pub fn put_be16(a: u64, v: u64) {
    put_byte(a, v >> 8)
    put_byte(a + 1, v)
}

/// Write `v`'s low 32 bits at `a`, big-endian.
pub fn put_be32(a: u64, v: u64) {
    put_be16(a, v >> 16)
    put_be16(a + 2, v)
}

/// The Internet checksum of the `len` bytes at `a` (RFC 1071): the
/// one's complement of the one's-complement sum of its 16-bit
/// big-endian words, an odd last byte taken as a word's high byte. It
/// is what goes in a checksum field that was zero while it was summed;
/// over data that holds a right checksum it is 0.
pub fn sum(a: u64, len: u64) -> u64 {
    var s: u64 = 0
    var i: u64 = 0
    while i + 1 < len {
        s += be16(a + i)
        i += 2
    }
    if i < len {
        s += octet(a + i) << 8
    }
    // PLANT (px21, to be seen red and reverted): the carries are thrown
    // away instead of coming back in at the low end.
    s = s & 0xffff
    (!s) & 0xffff
}

/// Take the boot-time triple (each a.b.c.d as a << 24 | b << 16 | c <<
/// 8 | d) and a frame to compose in. IF clear, after `arp.start`.
pub fn start(address: u64, netmask: u64, gateway: u64) {
    var i: u64 = 0
    while i < 64 {
        put_iw(i, 0)
        i += 1
    }
    put_iw(I_ADDR, address)
    put_iw(I_MASK, netmask)
    put_iw(I_GATEWAY, gateway)
    let pa = frames.alloc() else 0
    if pa != 0 {
        put_iw(I_FRAME, pa + frames.hhdm())
    }
}

/// This station's address.
pub fn address() -> u64 {
    iw(I_ADDR)
}

/// The netmask.
pub fn netmask() -> u64 {
    iw(I_MASK)
}

/// The gateway.
pub fn gateway() -> u64 {
    iw(I_GATEWAY)
}

/// Frames this module holds.
pub fn frames_held() -> u64 {
    if iw(I_FRAME) != 0 { 1 } else { 0 }
}

/// This subnet's broadcast address.
pub fn subnet_broadcast() -> u64 {
    (iw(I_ADDR) | !iw(I_MASK)) & 0xffffffff
}

/// Whether `a` is the limited broadcast or this subnet's.
pub fn is_broadcast(a: u64) -> bool {
    a == 0xffffffff || a == subnet_broadcast()
}

/// Whether `a` is on this station's subnet.
pub fn on_link(a: u64) -> bool {
    a & iw(I_MASK) == iw(I_ADDR) & iw(I_MASK)
}

/// The next hop for `dst`: itself on this subnet, else the gateway.
pub fn next_hop(dst: u64) -> u64 {
    if on_link(dst) { dst } else { iw(I_GATEWAY) }
}

/// Whether `src` can be a datagram's source: one host, and not this
/// one.
fn source_ok(src: u64) -> bool {
    let top = src >> 24
    src != 0 && top != 127 && top < 224 && !is_broadcast(src) && src != iw(I_ADDR)
}

/// Walk the options at `a`, `n` bytes (RFC 791 §3.1: type 0 ends the
/// list, type 1 is one byte, every other is type, length, data): 0
/// when they parse, C_OPTION when they do not, C_SOURCE_ROUTE when one
/// is a source route.
fn options(a: u64, n: u64) -> u64 {
    var i: u64 = 0
    var verdict: u64 = 0
    var done = false
    while i < n && !done {
        let t = octet(a + i)
        if t == 0 {
            done = true
        } else if t == 1 {
            i += 1
        } else if i + 1 >= n {
            verdict = C_OPTION
            done = true
        } else {
            let l = octet(a + i + 1)
            if l < 2 || i + l > n {
                verdict = C_OPTION
                done = true
            } else if t == 131 || t == 137 {
                verdict = C_SOURCE_ROUTE
                done = true
            } else {
                i += l
            }
        }
    }
    verdict
}

/// Judge the datagram in the `len`-byte frame at `frame` (type 0x0800;
/// kernel/netd, thread context). Returns `(what, ihl, total)`: DROP
/// (the cause counted), TO_ICMP or NO_PROTOCOL, the header's length in
/// bytes and the datagram's total length.
pub fn input(frame: u64, len: u64) -> (u64, u64, u64) {
    let h = frame + ETH
    var cause: u64 = 0
    var ihl: u64 = 0
    var total: u64 = 0
    if len < ETH + 20 {
        cause = C_SHORT
    } else if octet(h) >> 4 != 4 {
        cause = C_VERSION
    } else {
        ihl = (octet(h) & 15) * 4
        total = be16(h + 2)
        if ihl < 20 {
            cause = C_IHL
        } else if len < ETH + ihl {
            cause = C_SHORT
        } else if sum(h, ihl) != 0 {
            cause = C_CHECKSUM
        } else if total < ihl || ETH + total > len {
            cause = C_LENGTH
        } else if octet(h + 8) == 0 {
            cause = C_TTL
        } else if be16(h + 6) & 0x3fff != 0 {
            cause = C_FRAGMENT
        } else if !source_ok(be32(h + 12)) {
            cause = C_SOURCE
        } else {
            cause = options(h + 20, ihl - 20)
            let dst = be32(h + 16)
            if cause == 0 && dst != iw(I_ADDR) && !is_broadcast(dst) {
                cause = C_OTHER
            }
        }
    }
    if cause != 0 {
        bump(cause)
        return (DROP, ihl, total)
    }
    if ihl > 20 {
        bump(C_WITH_OPTIONS)
    }
    if is_broadcast(be32(h + 16)) {
        bump(C_BROADCAST)
    }
    if octet(h + 9) == ICMP {
        bump(C_RX)
        return (TO_ICMP, ihl, total)
    }
    bump(C_PROTOCOL)
    (NO_PROTOCOL, ihl, total)
}

/// Send the `len` bytes at `payload` to `dst` as one datagram of
/// protocol `protocol`. Returns kernel/arp's SENT or QUEUED, or why
/// not: SIZE, DOWN, DROPPED, FAILED (each counted).
pub fn send(dst: u64, protocol: u64, payload: u64, len: u64) -> u64 {
    let saved = sync.acquire(sync.ip())
    let f = iw(I_FRAME)
    if f == 0 || !net.up() {
        put_iw(C_TX_DROPPED, iw(C_TX_DROPPED) + 1)
        sync.release(sync.ip(), saved)
        return DOWN
    }
    if len > PAYLOAD_MAX {
        put_iw(C_TX_SIZE, iw(C_TX_SIZE) + 1)
        sync.release(sync.ip(), saved)
        return SIZE
    }
    var i: u64 = 0
    while i < 6 {
        put_byte(f + i, 0xff)
        put_byte(f + 6 + i, net.mac_byte(i))
        i += 1
    }
    put_be16(f + 12, 0x0800)
    let h = f + ETH
    put_byte(h, 0x45)
    put_byte(h + 1, 0)
    put_be16(h + 2, 20 + len)
    put_be16(h + 4, iw(I_IDENT))
    put_iw(I_IDENT, (iw(I_IDENT) + 1) & 0xffff)
    put_be16(h + 6, 0x4000) // DF, offset 0
    put_byte(h + 8, TTL)
    put_byte(h + 9, protocol)
    put_be16(h + 10, 0)
    put_be32(h + 12, iw(I_ADDR))
    put_be32(h + 16, dst)
    put_be16(h + 10, sum(h, 20))
    // # Safety: this module's frame, 4096 bytes; 34 + len <= 1514 of
    // them are written; `payload` is the caller's, `len` bytes.
    unsafe { pax_fb_copy(h + 20, payload, len) }
    var r: u64 = 0
    if is_broadcast(dst) {
        // The destination address is already ff:ff:ff:ff:ff:ff.
        let q = net.send(f, ETH + 20 + len) else 0
        r = if q != 0 { arp.SENT } else { arp.FAILED }
    } else {
        r = arp.send(next_hop(dst), f, ETH + 20 + len)
    }
    if r == arp.SENT || r == arp.QUEUED {
        put_iw(C_TX, iw(C_TX) + 1)
    } else {
        put_iw(C_TX_DROPPED, iw(C_TX_DROPPED) + 1)
    }
    sync.release(sync.ip(), saved)
    r
}

/// The module's first line:
/// `ip: <a.b.c.d> netmask <m.m.m.m> gateway <g.g.g.g>, MTU 1500, TTL 64, DF set, no fragments either way`.
pub fn report() {
    log.put("ip: ")
    arp.put_ip(iw(I_ADDR))
    log.put(" netmask ")
    arp.put_ip(iw(I_MASK))
    log.put(" gateway ")
    arp.put_ip(iw(I_GATEWAY))
    log.put(", MTU 1500, TTL 64, DF set, no fragments either way")
    log.end()
}

fn item(v: u64, name: str) {
    log.put(" ")
    log.dec(iw(v) as int)
    log.put(" ")
    log.put(name)
}

/// The counters' two lines:
///
///     ip: rx <n> datagrams delivered (<o> with options, <b> broadcast), dropped <…> short <…> version <…> ihl <…> checksum <…> length <…> ttl <…> fragment <…> source <…> option <…> source-route <…> other <…> protocol
///     ip: tx <n> datagrams, not sent <s> size <d> dropped
pub fn counters() {
    log.put("ip: rx ")
    log.dec(iw(C_RX) as int)
    log.put(" datagrams delivered (")
    log.dec(iw(C_WITH_OPTIONS) as int)
    log.put(" with options, ")
    log.dec(iw(C_BROADCAST) as int)
    log.put(" broadcast), dropped")
    item(C_SHORT, "short")
    item(C_VERSION, "version")
    item(C_IHL, "ihl")
    item(C_CHECKSUM, "checksum")
    item(C_LENGTH, "length")
    item(C_TTL, "ttl")
    item(C_FRAGMENT, "fragment")
    item(C_SOURCE, "source")
    item(C_OPTION, "option")
    item(C_SOURCE_ROUTE, "source-route")
    item(C_OTHER, "other")
    item(C_PROTOCOL, "protocol")
    log.end()
    log.put("ip: tx ")
    log.dec(iw(C_TX) as int)
    log.put(" datagrams, not sent")
    item(C_TX_SIZE, "size")
    item(C_TX_DROPPED, "dropped")
    log.end()
}
