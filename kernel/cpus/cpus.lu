//! Read-only MADT processor census. ACPI 6.5 §§5.2.12.2, 5.2.12.12.
//! No AP startup, MP boot request, interrupt routing or CPU-local register writes.
//! A missing or unusable table means unknown, not a guessed processor count.
use log

var seen: bool = false
var known: bool = false
var ready: u64 = 0
var later: u64 = 0
var disabled: u64 = 0

fn byte(a: u64) -> u64 { unsafe { (a as *u8).read_volatile() as u64 } }
fn word(a: u64) -> u64 {
    byte(a) | (byte(a + 1) << 8) | (byte(a + 2) << 16) | (byte(a + 3) << 24)
}
fn flags(a: u64, kind: u64) -> u64 { word(a + (if kind == 0 { 4 } else { 8 })) }
fn id(a: u64, kind: u64) -> u64 { if kind == 0 { byte(a + 3) } else { word(a + 4) } }
fn uid(a: u64, kind: u64) -> u64 { if kind == 0 { byte(a + 2) } else { word(a + 12) } }

/// The caller supplies a readable, checksummed MADT of n bytes. Return no
/// partial count on a malformed record, duplicate usable ID/UID or empty table.
/// At most 4096 records: a bound on this allocation-free quadratic duplicate
/// check, not a promise that PAX can start that many processors.
pub fn count(a: u64, n: u64) -> (bool, u64, u64, u64) {
    if n < 44 { return (false, 0, 0, 0) }
    var off: u64 = 44
    var records: u64 = 0
    var yes: u64 = 0
    var hot: u64 = 0
    var no: u64 = 0
    while off < n {
        if n - off < 2 || records == 4096 { return (false, 0, 0, 0) }
        let kind = byte(a + off)
        let size = byte(a + off + 1)
        if size < 2 || size > n - off { return (false, 0, 0, 0) }
        if kind == 0 || kind == 9 {
            if (kind == 0 && size != 8) || (kind == 9 && size != 16) { return (false, 0, 0, 0) }
            let f = flags(a + off, kind)
            if f & 3 != 0 {
                var prev: u64 = 44
                while prev < off {
                    let pk = byte(a + prev)
                    if (pk == 0 || pk == 9) && flags(a + prev, pk) & 3 != 0 {
                        if id(a + prev, pk) == id(a + off, kind) || uid(a + prev, pk) == uid(a + off, kind) {
                            return (false, 0, 0, 0)
                        }
                    }
                    prev += byte(a + prev + 1)
                }
            }
            if f & 1 != 0 { yes += 1 }
            else if f & 2 != 0 { hot += 1 }
            else { no += 1 }
        }
        off += size
        records += 1
    }
    (yes != 0, yes, hot, no)
}

/// Called only after ACPI's complete table range and checksum checks.
pub fn observe(a: u64, n: u64) {
    if unsafe { seen } { unsafe { known = false }; return }
    unsafe { seen = true }
    let (ok, yes, hot, no) = count(a, n)
    unsafe { known = ok; ready = yes; later = hot; disabled = no }
}
pub fn valid() -> bool { unsafe { known } }
pub fn available() -> u64 { unsafe { ready } }
pub fn online_capable() -> u64 { unsafe { later } }
pub fn disabled_entries() -> u64 { unsafe { disabled } }
/// Only the boot processor runs PAX. Discovery changes no execution state.
pub fn active() -> u64 { 1 }
pub fn report() {
    log.put("processors: available ")
    if valid() { log.dec(available() as int) } else { log.put("unknown") }
    log.put(", active "); log.dec(active() as int)
    if valid() { log.line("; source ACPI MADT") } else { log.line("; source unavailable") }
}
