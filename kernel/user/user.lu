//! user — ring 3 (px09, M-PX3's first step): the SYSCALL MSRs, SMEP and
//! SMAP, a process's address space, the way in, the system calls and
//! the faults that kill.
//!
//! **The MSRs** (`start`; Intel SDM vol. 3A §5.8.8, vol. 4 for the
//! addresses; AMD64 APM vol. 2 §6.1.1): IA32_EFER.SCE (bit 0) enables
//! SYSCALL; STAR = 0x0010_0008 << 32, so SYSCALL loads CS 0x08 and SS
//! 0x10 (kernel/gdt's kernel code and data) and SYSRETQ loads CS 0x10 +
//! 16 = 0x20 and SS 0x10 + 8 = 0x18, each with RPL 3 (0x23, 0x1b:
//! kernel/gdt's user code and data, kw10 put them in SYSRET's order);
//! LSTAR = boot/user.S's `pax_syscall_entry`; FMASK = 0x44700 clears TF
//! (8), IF (9), DF (10), NT (14) and AC (18) on entry, so the kernel
//! runs with interrupts off, string operations forward and no access to
//! user pages until STAC says so.
//!
//! **SMEP and SMAP** (SDM vol. 3A §4.6.1; CPUID.(EAX=7,ECX=0):EBX bit 7
//! and bit 20): set in CR4 (bits 20 and 21) when the CPU has them, and
//! reported (`report`). With SMEP the kernel cannot execute a user page;
//! with SMAP it cannot read or write one except between STAC and CLAC,
//! which only boot/user.S's `pax_peek_user` issues, for `write`'s copy.
//! kmain_user_smap and kmain_user_smep are the witnesses.
//!
//! **A process** is a PML4 from `paging.new_space` (the kernel half
//! shared, the user half its own) holding its program's bytes at CODE
//! (0x400000), mapped read-execute user, as many pages as the blob
//! needs; a 16 KiB stack below STACK_TOP (0x7ffffffff000), read-write,
//! no-execute, user; and nothing else in the user half, so the page
//! below the stack (0x7fffffffa000) is a guard, and so is the page above
//! it. `load` builds one (12 frames for a one-page program: the PML4,
//! two PDPTs, two PDs, two PTs, one code page, four stack pages);
//! kernel/sched's `create_user` gives it to a new thread, whose body is
//! `pax_user_thread`: it enters ring 3 at CODE with RSP STACK_TOP by
//! `iretq` (boot/user.S's `pax_enter_user`). The thread's death, by
//! `exit` or by a fault, frees it (sched's `reap`). The programs are
//! user/programs.S's blobs, by number:
//!
//!     0 hello  1 segv  2 kread  3 textwrite  4 guard  5 priv
//!     6 badptr  7 spin1  8 spin2  9 after (hello's bytes)
//!
//! **System calls** (`syscall`, vector PAX_SYSCALL = 0x100 from
//! boot/user.S): Linux's x86-64 ABI, the psABI's A.2.1 (number in %rax,
//! arguments in %rdi, %rsi, %rdx, %r10, %r8, %r9, the result in %rax, an
//! error as -errno), numbers from `syscall_64.tbl`, errnos from the uapi
//! `errno-base.h`/`errno.h`:
//! - `write` (1): fd 1 or 2 only (else -EBADF, 9), to the serial
//!   console, each `\n` sent as CR LF (a terminal's ONLCR). Every page of
//!   [buf, buf + count) must lie below 0x800000000000 and be present and
//!   user-accessible in the caller's tables (`paging.user_ok`), checked
//!   before one byte is read; otherwise nothing is written, the kernel
//!   logs the refusal by name and returns -EFAULT (14), as Linux's
//!   `write(2)` does for a buffer "outside your accessible address
//!   space". Returns count. (Linux may write a prefix of a buffer that
//!   faults part-way; PAX writes all or nothing.)
//! - `exit` (60): ends the thread (one thread a process, so the process)
//!   with status `%rdi & 0xff`: `user: <name> pid <id> exit <code> after
//!   <r> runs`.
//! - anything else: -ENOSYS (38), logged `user: <name> pid <id> syscall
//!   <n>: -ENOSYS`.
//!
//! - `exit_group` (231, px10): ends the process, all of its threads (it
//!   has one): `user: <name> pid <id> exit_group <code> after <r> runs`.
//!
//! **The Linux calls** (px12, M-PX3: what static glibc programs and
//! boreutils make, measured by strace on Linux, `notes/px12/`):
//! - memory (kernel/vm): `brk` (12), `mmap` (9, anonymous private
//!   only), `munmap` (11), `mprotect` (10);
//! - TLS: `arch_prctl` (158) ARCH_SET_FS / ARCH_GET_FS, the FS base
//!   kept per thread (kernel/sched, IA32_FS_BASE at every switch);
//! - files (kernel/files): `read` (0), `pread64` (17), `open` (2),
//!   `openat` (257), `close` (3), `lseek` (8), `fstat` (5), `stat` (4),
//!   `lstat` (6), `newfstatat` (262), `statx` (332), `getdents64`
//!   (217), `ioctl` (16; -ENOTTY but on the console, px13),
//!   `getcwd` (79, "/"), `readlinkat`
//!   (267, nothing is a link); `write` (1) goes to the console for the
//!   console's descriptors, nowhere for `/dev/null`, -EBADF otherwise;
//! - the rest: `getrandom` (318, RDRAND, else the TSC mix), `clock_
//!   gettime` (228), `time` (201), `gettimeofday` (96) (the PIT's tick
//!   count: PAX has no wall clock and no vDSO), `clock_nanosleep` (230)
//!   and `nanosleep` (35) (the thread sleeps until the tick after the
//!   deadline, kernel/sched's `sleep_current`), `uname` (63, "PAX"),
//!   `prctl` (157) PR_GET_NAME, `prlimit64` (302, read-only: the stack
//!   PAX gives, kernel/files' descriptors, the rest unlimited), `getuid`, `getgid`,
//!   `geteuid`, `getegid` (0).
//! - processes (px14, kernel/process and kernel/sched): `clone` (56),
//!   `clone3` (435) and `vfork` (58) with CLONE_VM|CLONE_VFORK, `execve`
//!   (59), `wait4` (61), `waitid` (247), `getpid` (39), `getppid` (110),
//!   `gettid` (186) and `set_tid_address` (218) the pid; `dup` (32),
//!   `dup2` (33), `dup3` (292) (kernel/files); `rt_sigprocmask` (14) and
//!   `rt_sigaction` (13) recorded, nothing delivered; `kill` (62),
//!   `tkill` (200), `tgkill` (234) refused by name. `exit` and
//!   `exit_group` leave `code << 8` for the parent, a fault the
//!   signal's number (kernel/process's `fault_signal`). A `who` line's
//!   `pid` is the Linux pid: 1 for the first process, then 2, 3, …
//! - plumbing (px17, kernel/files, what pelt `3e7516c`'s pipelines,
//!   redirections and `cd` make on Linux, `notes/px17/`): `pipe` (22),
//!   `pipe2` (293), `socketpair` (53), `sendto` (44), `recvfrom` (45),
//!   `fcntl` (72), `chdir` (80), `fchdir` (81); `getcwd` (79) answers
//!   the working directory; `clone` without CLONE_VM is a fork
//!   (kernel/process). A read or write of a pipe that must wait parks
//!   the thread and runs the call again when a pipe changes; a write to
//!   a pipe with no reader ends the writer with SIGPIPE (status 13, a
//!   `killed: SIGPIPE` line) when its action is the default and it is
//!   not blocked and the writer is not pid 1, else answers -EPIPE. A
//!   process's end closes its descriptors.
//! - sockets (px22, kernel/socket and kernel/udp: what the UDP witnesses
//!   make on Linux, `notes/px22/`): `socket` (41), `bind` (49), `connect`
//!   (42), `sendto` (44), `recvfrom` (45), `getsockname` (51),
//!   `getpeername` (52), `setsockopt` (54), `getsockopt` (55) for
//!   AF_INET datagram sockets, `listen` (50), `accept` (43) and `accept4`
//!   (288) answered -EOPNOTSUPP on one; `read` and `write` on a socket
//!   are `recvfrom` and `sendto` with no address. A receive that must
//!   wait parks the thread as a pipe's read does, until a datagram or
//!   the socket's receive timeout. `sendmsg` (46), `recvmsg` (47) and
//!   `shutdown` (48) are not here.
//! - threads, futexes and signals (px26, what pelt `b32bebc` and a
//!   static glibc with pthreads make, `notes/px26/`): `clone`/`clone3`
//!   with CLONE_THREAD (kernel/process); `exit` (60) ends the calling
//!   thread alone while its process has others — its clear-child-tid
//!   word zeroed and that futex woken — and `exit_group` every thread;
//!   `gettid` (186) and `set_tid_address` (218) answer the thread's own
//!   id; `futex` (202, kernel/futex); `sched_yield` (24); `rt_sigaction`
//!   (13), `rt_sigprocmask` (14), `rt_sigpending` (127), `rt_sigreturn`
//!   (15), `kill` (62), `tkill` (200), `tgkill` (234) (kernel/signal,
//!   which also takes a thread's pending signals at every return to
//!   ring 3: kernel/interrupts); `madvise` (28, kernel/vm); `prctl`
//!   takes PR_SET_NAME; a sleep a signal ends writes the time left. A
//!   write to a pipe with no reader raises SIGPIPE for the writer and
//!   answers -EPIPE; an exception in ring 3 goes to a handler for its
//!   signal when the thread has one.
//! - bu20's boreutils (px26): `readlink` (89) and `readlinkat` answer
//!   `/proc/self/exe`; `sendfile` (40), `splice` (275) and
//!   `copy_file_range` (326) (kernel/files); CLOCK_REALTIME, `time` and
//!   `gettimeofday` answer the date (kernel/rtc's reading at `start`
//!   plus the ticks since), the other clocks the ticks.
//! - the writable tree (px27, kernel/tree and kernel/files: what
//!   boreutils' `mkdir`, `rmdir`, `rm`, `mv` and `cp`, pelt's
//!   redirections and lobo's logs and pid file make, and a probe of the
//!   rest, `notes/px27/`): `mkdir` (83), `mkdirat` (258), `rmdir` (84),
//!   `unlink` (87), `unlinkat` (263), `rename` (82), `renameat` (264),
//!   `renameat2` (316, no flag), `pwrite64` (18), `truncate` (76),
//!   `ftruncate` (77), `fsync` (74), `fdatasync` (75), `umask` (95),
//!   `access` (21), `faccessat` (269), `faccessat2` (439); `open` and
//!   `openat` create, truncate and open for writing; `write` writes a
//!   file; `copy_file_range` and `sendfile` copy between files. Refused
//!   by name: `link`, `linkat`, `symlink`, `symlinkat`, `mknod`,
//!   `mknodat` (-EPERM) and `chmod`, `fchmod`, `fchmodat`, `fchmodat2`,
//!   `chown`, `fchown`, `lchown`, `fchownat`, `utimensat`, `utimes`,
//!   `utime` (-EOPNOTSUPP). After a call, kernel/tree's lines: the
//!   books at every 2500th file removed, and the tree at its cap.
//! Every other number is -ENOSYS, logged once per program (`unknown`),
//! among them `set_robust_list` (273) and `rseq` (334), which glibc
//! tolerates (px09's hello asks `_sysctl` (156), which Linux answers
//! -ENOSYS too). A refusal by name (a file-backed or shared mapping, a
//! hard link, a fork, a signal sent) is a line
//! `user: <name> pid <pid> syscall <n>: refused: <why>, -<errno>`. User memory is reached through
//! kernel/uaccess (the process's own tables walked, then the HHDM).
//!
//! **ELF processes** (px10, `exec`; the code is kernel/process's since
//! px14, which also builds an `execve`'s image the same way): a static
//! x86-64 executable read from the initramfs (kernel/initramfs) and
//! loaded by kernel/elf into a fresh address space, with a stack of
//! ELF_STACK_PAGES pages below
//! STACK_TOP (the page below them the guard) holding what the x86-64
//! psABI §3.4.1 puts on a process's initial stack, from the top down:
//! eight zero bytes; the strings (argv's, envp's, then the path,
//! AT_EXECFN's), each with its NUL; sixteen random bytes (AT_RANDOM:
//! RDRAND when CPUID.1:ECX bit 30 says the CPU has it, else a mix of
//! the TSC: named, not cryptographic); then, 16-aligned at the bottom,
//! argc, the argv pointers and a NULL, the envp pointers and a NULL,
//! and the auxiliary vector's pairs (uapi `linux/auxvec.h`): AT_PHDR,
//! AT_PHENT, AT_PHNUM, AT_PAGESZ (4096), AT_BASE (0: no interpreter),
//! AT_FLAGS (0), AT_ENTRY, AT_UID, AT_EUID, AT_GID, AT_EGID (all 0),
//! AT_CLKTCK (100), AT_SECURE (0), AT_RANDOM, AT_EXECFN, AT_NULL. RSP
//! points at argc; every general register is zero (so %rdx, the psABI's
//! function for atexit, is none); the x87/SSE state is kernel/fpu's
//! template (FCW 0x037f, MXCSR 0x1f80), Linux's at execve. argv and
//! envp come from the kernel as space-separated strings, or (px14)
//! from an `execve` caller's vectors. A refusal
//! (no such file, not a static x86-64 ELF: kernel/elf's names) is a
//! line `user: exec <path>: refused: <why>`, and nothing of the space
//! survives.
//!
//! **Faults** (`kill`, from kernel/interrupts for an exception 0-31 whose
//! frame's CS has RPL 3, except #DF and #MC, which stay kernel panics):
//! `user: <name> pid <id> killed: <exception> vector <v> error 0x<e> rip
//! 0x<r>[ cr2 0x<a>] after <r> runs`, and the thread ends as `exit` ends
//! it (px14: its parent's wait reads the signal); the kernel resumes the
//! next thread.
//!
//! Every word of the frame is read and written at its index (boot/isr.S's
//! 22 words), volatile, the scheduler's rule since px07 (wolf 0.2.26's
//! `f[0].rax = v`, wolf-lang#577, is an ordinary access, which the
//! compiler may merge or move). State the handlers write is in boot/user.S's
//! `pax_syscall_state`, read volatile, not in module `var`s
//! (wolf-lang#598, not fixed in 0.2.24). No `region` is used anywhere
//! here: a system call that waits or ends gives up this stack, and a
//! region open there would never be left (kernel/sched, "Regions"). No
//! Linux source; no other kernel's source.

use boot_info
use console
use files
use frames
use futex
use log
use netd
use paging
use panic
use process
use ready
use rtc
use sched
use serial
use signal
use socket
use sound
use speaker
use timer
use tree
use uaccess
use vm

extern "c" fn pax_rdmsr(msr: u64) -> u64
extern "c" fn pax_wrmsr(msr: u64, v: u64)
extern "c" fn pax_set_cr4(v: u64)
extern "c" fn pax_cpuid7_ebx() -> u64
extern "c" fn pax_enter_user(rip: u64, rsp: u64)
extern "c" fn pax_peek_user(va: u64, smap: u64) -> u64
extern "c" fn pax_cr2() -> u64

extern "c" let pax_syscall_entry: *u8
extern "c" let pax_syscall_state: *u64
extern "c" let pax_uprogs: *u64

// The MSRs (SDM vol. 4) and their values.
const EFER: u64 = 0xc0000080
const STAR: u64 = 0xc0000081
const LSTAR: u64 = 0xc0000082
const FMASK: u64 = 0xc0000084
const EFER_SCE: u64 = 0x1
const STAR_VALUE: u64 = 0x0010000800000000 // SYSRET base 0x10, SYSCALL CS 0x08
const FMASK_VALUE: u64 = 0x44700 // TF, IF, DF, NT, AC
const CPUID7_SMEP: u64 = 0x80 // EBX bit 7
const CPUID7_SMAP: u64 = 0x100000 // EBX bit 20
const CR4_SMEP: u64 = 0x100000 // bit 20
const CR4_SMAP: u64 = 0x200000 // bit 21

/// PAX_SYSCALL: the vector boot/user.S's entry writes into its frame
/// (kernel/interrupts reads it as `user.SYSCALL`).
pub const SYSCALL: u64 = 0x100

// A process's user half.
const CODE: u64 = 0x400000
const STACK_TOP: u64 = 0x00007ffffffff000
const STACK_PAGES: u64 = 4
const PAGE: u64 = 4096
/// How many programs there are, numbered 0 .. PROGS - 1 (looking one
/// up by name would compare `str`s, which needs the hosted runtime on
/// this target).
pub const PROGS: u64 = 10
const ELF_STACK_PAGES: u64 = 32 // px10: an ELF process's stack, 128 KiB


// Linux's numbers (syscall_64.tbl) and -errno as the u64 %rax carries.
const SYS_WRITE: u64 = 1
const SYS_EXIT: u64 = 60
const SYS_EXIT_GROUP: u64 = 231
const NEG_EBADF: u64 = 0xfffffffffffffff7 // -9
const NEG_EFAULT: u64 = 0xfffffffffffffff2 // -14
const NEG_ENOSYS: u64 = 0xffffffffffffffda // -38

// boot/user.S's pax_syscall_state words.
const U_TICKS: u64 = 2
const U_SMAP: u64 = 3
const U_SMEP: u64 = 4
const U_LAST_EXIT: u64 = 5 // px13: the last exit's status + 1 (0: none yet)
const U_EPOCH: u64 = 6 // px26: CLOCK_REALTIME at tick 0, in seconds (kernel/rtc)

// boot/isr.S's frame, as word indices.
const W_R10: u64 = 5
const W_R9: u64 = 6 // px17: recvfrom's and sendto's sixth argument
const W_R8: u64 = 7
const W_RDI: u64 = 9
const W_RSI: u64 = 10
const W_RDX: u64 = 11
const W_RAX: u64 = 14
const W_VECTOR: u64 = 15
const W_ERROR: u64 = 16
const W_RIP: u64 = 17
const W_CS: u64 = 18

/// Word `i` of the frame at `f`.
fn word(f: u64, i: u64) -> u64 {
    // # Safety: `f` is the trampoline's frame (22 words), live for the
    // handler that passed it; i < 22.
    unsafe { ((f + i * 8) as *u64).read_volatile() }
}

fn put_word(f: u64, i: u64, v: u64) {
    // # Safety: as `word`.
    unsafe { ((f + i * 8) as *u64).write_volatile(v) }
}

/// boot/user.S's state word `i`, read volatile (#598).
fn state(i: u64) -> u64 {
    // # Safety: i < 8, inside the 64-byte pax_syscall_state.
    unsafe { ((pax_syscall_state as u64 + i * 8) as *u64).read_volatile() }
}

fn put_state(i: u64, v: u64) {
    // # Safety: as `state`.
    unsafe { ((pax_syscall_state as u64 + i * 8) as *u64).write_volatile(v) }
}

/// Program `p`'s name.
pub fn name(p: u64) -> str {
    if p == 0 { return "hello" }
    if p == 1 { return "segv" }
    if p == 2 { return "kread" }
    if p == 3 { return "textwrite" }
    if p == 4 { return "guard" }
    if p == 5 { return "priv" }
    if p == 6 { return "badptr" }
    if p == 7 { return "spin1" }
    if p == 8 { return "spin2" }
    if p == 9 { return "after" }
    "?"
}

/// Program `p`'s blob in user/programs.S's `pax_uprogs` table.
fn blob(p: u64) -> u64 {
    if p == 9 { return 0 } // after: hello's
    p
}

/// Program `p`'s bytes: their first address (0) or the first past them
/// (1), in the kernel's .rodata.
fn bounds(p: u64, which: int) -> u64 {
    let i = (blob(p) * 2) as int + which
    // # Safety: pax_uprogs holds 9 pairs; blob(p) < 9 for p < PROGS.
    unsafe { pax_uprogs[i] }
}

/// Pages program `p`'s bytes take.
fn code_pages(p: u64) -> u64 {
    (bounds(p, 1) - bounds(p, 0) + PAGE - 1) / PAGE
}

/// Turn on SYSCALL (EFER.SCE, STAR, LSTAR, FMASK) and, when the CPU has
/// them, SMEP and SMAP; and read `quiet` from the kernel command line
/// (px15, kernel/log).
pub fn start() {
    log.set_quiet(boot_info.cmdline_has("quiet"))
    // # Safety: cpu.S's RDMSR/WRMSR of architectural MSRs every x86-64
    // CPU has; LSTAR is boot/user.S's entry; CR4 gains only the bits
    // CPUID says exist, and nothing the kernel does touches a user page
    // outside `pax_peek_user`.
    unsafe {
        let e = pax_rdmsr(EFER)
        pax_wrmsr(EFER, e | EFER_SCE)
        pax_wrmsr(STAR, STAR_VALUE)
        pax_wrmsr(LSTAR, pax_syscall_entry as u64)
        pax_wrmsr(FMASK, FMASK_VALUE)
        let b = pax_cpuid7_ebx()
        var cr4 = paging.cr4()
        var smep: u64 = 0
        var smap: u64 = 0
        if b & CPUID7_SMEP != 0 {
            cr4 = cr4 | CR4_SMEP
            smep = 1
        }
        if b & CPUID7_SMAP != 0 {
            cr4 = cr4 | CR4_SMAP
            smap = 1
        }
        pax_set_cr4(cr4)
        put_state(U_SMEP, smep)
        put_state(U_SMAP, smap)
        put_state(U_TICKS, 0)
    }
    // px26: the wall clock, read once: the date now less the ticks so far.
    let wall = rtc.read()
    let up = timer.ticks() * NS_PER_TICK / NS_PER_SEC
    put_state(U_EPOCH, if wall > up { wall - up } else { 0 })
    tree.start() // px27: the file tree, before the first program and the first frame count
}

fn bit(v: u64, b: u64) -> int {
    if v & b != 0 {
        return 1
    }
    0
}

/// The MSRs and CR4 read back:
/// `user: syscall star 0x<S> lstar 0x<L> fmask 0x<F>, efer.sce <0|1>, smep <0|1>, smap <0|1>`.
pub fn report() {
    // # Safety: cpu.S's RDMSR, as `start`.
    let (star, lstar, fmask, efer) = unsafe { (pax_rdmsr(STAR), pax_rdmsr(LSTAR), pax_rdmsr(FMASK), pax_rdmsr(EFER)) }
    let cr4 = paging.cr4()
    log.put("user: syscall star ")
    log.hex(star)
    log.put(" lstar ")
    log.hex(lstar)
    log.put(" fmask ")
    log.hex(fmask)
    log.put(", efer.sce ")
    log.dec(bit(efer, EFER_SCE))
    log.put(", smep ")
    log.dec(bit(cr4, CR4_SMEP))
    log.put(", smap ")
    log.dec(bit(cr4, CR4_SMAP))
    log.end()
    if log.quiet() {
        log.line("user: quiet (the kernel command line): no exec, exit, -ENOSYS or frames line for a program")
    }
}

/// A frame, zeroed through the HHDM; a named panic when there is none.
fn fresh(p: u64) -> u64 {
    let pa = frames.alloc() else 0
    if pa == 0 {
        panic.fail("user: no frame for program", p)
    }
    let v = pa + frames.hhdm()
    var i: u64 = 0
    while i < PAGE / 8 {
        // # Safety: the frame just taken, through the HHDM.
        unsafe { ((v + i * 8) as *u64).write_volatile(0) }
        i += 1
    }
    pa
}

/// `paging.map_user` or a named panic.
fn must_map(pml4: u64, va: u64, pa: u64, flags: u64) {
    let r = paging.map_user(pml4, va, pa, flags) else 99
    if r == 99 {
        panic.fail("user: cannot map the user page at", va)
    }
}

/// Build program `p`'s address space: its bytes copied to fresh frames
/// at CODE (read-execute), a zeroed stack below STACK_TOP (read-write,
/// no-execute). Returns the PML4's physical address. Thread context, IF
/// clear (frames and paging are never entered with IF set).
pub fn load(p: u64) -> u64 {
    if p >= PROGS {
        panic.fail("user: no such program", p)
    }
    let pml4 = paging.new_space(sched.pml4())
    if pml4 == 0 {
        panic.fail("user: no frame for a PML4, program", p)
    }
    let lo = bounds(p, 0)
    let hi = bounds(p, 1)
    let n = code_pages(p)
    var k: u64 = 0
    while k < n {
        let pa = fresh(p)
        let dst = pa + frames.hhdm()
        var i: u64 = 0
        while i < PAGE && lo + k * PAGE + i < hi {
            // # Safety: the blob's bytes in the kernel's .rodata, and the
            // frame just taken, through the HHDM.
            unsafe {
                let b = ((lo + k * PAGE + i) as *u8).read_volatile()
                ((dst + i) as *u8).write_volatile(b)
            }
            i += 1
        }
        must_map(pml4, CODE + k * PAGE, pa, 0) // r-x
        k += 1
    }
    k = 0
    while k < STACK_PAGES {
        let pa = fresh(p)
        must_map(pml4, STACK_TOP - (k + 1) * PAGE, pa, paging.RW | paging.NX)
        k += 1
    }
    pml4
}

/// Program `p`'s address-space line, for thread `id`:
/// `user: <name> pid <id> cr3 0x<c> code 0x<CODE> <n> pages r-x, stack 0x<lo> to 0x<TOP> rw- nx, guard 0x<g>, kernel half <s> of <k> entries shared`.
pub fn describe(p: u64, id: u64, cr3: u64) {
    let lo = STACK_TOP - STACK_PAGES * PAGE
    log.put("user: ")
    log.put(name(p))
    log.put(" pid ")
    log.dec(sched.pid_of(id) as int) // px14: the Linux pid
    log.put(" cr3 ")
    log.hex(cr3)
    log.put(" code ")
    log.hex(CODE)
    log.put(" ")
    log.dec(code_pages(p) as int)
    log.put(" pages r-x, stack ")
    log.hex(lo)
    log.put(" to ")
    log.hex(STACK_TOP)
    log.put(" rw- nx, guard ")
    log.hex(lo - PAGE)
    log.put(", kernel half ")
    log.dec(paging.kernel_half(cr3, sched.pml4(), 0) as int)
    log.put(" of ")
    log.dec(paging.kernel_half(cr3, sched.pml4(), 1) as int)
    log.put(" entries shared")
    log.end()
}

/// A user thread's body (kernel/sched's `create_user` starts it in the
/// program's address space, already live): into ring 3 at CODE, the
/// stack's top as RSP. Never returns.
export fn pax_user_thread(p: u64) {
    if sched.self_prog() == sched.ELF_PROG {
        // # Safety: as below; an ELF process's entry and stack were
        // mapped user by `exec` (kernel/elf's segments, the stack).
        unsafe { pax_enter_user(sched.self_exec(0), sched.self_exec(1)) }
        panic.fail("user: pax_enter_user returned, an ELF process", p)
    }
    // # Safety: boot/user.S's IRETQ to CPL 3; CODE and the stack are
    // mapped user in the live tables (`load`), RSP0 and SYSCALL's stack
    // word are this thread's (sched's `enter_space`).
    unsafe { pax_enter_user(CODE, STACK_TOP) }
    panic.fail("user: pax_enter_user returned, program", p)
}

/// Whether the frame at `f` was pushed by an interrupt, exception or
/// system call in ring 3 (its CS's RPL).
pub fn from_user(f: u64) -> bool {
    word(f, W_CS) & 3 == 3
}

/// The status the last program to exit gave `exit` or `exit_group`
/// plus one; 0 when none has (px13: kmain_console says how init ended).
pub fn last_exit() -> u64 {
    state(U_LAST_EXIT)
}

/// A timer tick that landed in ring 3 (kernel/interrupts).
pub fn count_tick() {
    put_state(U_TICKS, state(U_TICKS) + 1)
}

/// Ticks that landed in ring 3 since `start`.
pub fn ticks() -> u64 {
    state(U_TICKS)
}

/// `n` in decimal when it fits in 31 bits, else in hex: a number ring 3
/// chose (a system call's number, a length) can be any u64, and a
/// narrowing cast traps (kernel/log's `dec` takes an int).
fn num(n: u64) {
    if n < 0x80000000 {
        log.dec(n as int)
    } else {
        log.hex(n)
    }
}

/// `user: <name> pid <id>`, for the running thread (kernel/process's,
/// since px26: kernel/signal writes it too).
fn who() {
    process.who()
}

/// ` after <r> runs`, for the running thread.
fn runs_tail() {
    log.put(" after ")
    log.dec(sched.self_runs() as int)
    log.put(" runs")
}

/// Whether every page of [buf, buf + len) (len > 0) is user-readable in
/// the live tables, the whole range below 0x800000000000.
fn readable(buf: u64, len: u64) -> bool {
    let top = paging.USER_TOP
    if buf >= top || len > top - buf {
        return false
    }
    let pml4 = paging.live()
    let end = buf + len
    var pg = buf & !(PAGE - 1)
    while pg < end {
        if !paging.user_ok(pml4, pg) {
            return false
        }
        pg += PAGE
    }
    true
}

/// `write(fd, buf, len)`: the result for %rax. The console's descriptors
/// (0-2 and any opened on `/dev/stdout`, `/dev/stderr`, `/dev/stdin`)
/// send the bytes to the serial console; `/dev/null` swallows them; a
/// pipe, a socket and (px27) a file of the tree take them; anything
/// else (closed, opened to read) is -EBADF.
fn write(fd: u64, buf: u64, len: u64) -> u64 {
    if socket.is_inet(area(), fd) {
        return socket.sendto(area(), paging.live(), fd, buf, len, 0, 0, 0) // px22
    }
    let t = files.write_target(area(), fd)
    if t == 2 {
        who()
        log.put(" write fd ")
        num(fd)
        log.put(": -EBADF")
        log.end()
        return NEG_EBADF
    }
    if t == 3 {
        return files.pipe_write(area(), paging.live(), fd, buf, len, false) // px17
    }
    if t == 4 {
        return files.file_write(area(), paging.live(), fd, buf, len) // px27
    }
    if t == 5 {
        return files.event_write(area(), paging.live(), fd, buf, len) // px24: an eventfd
    }
    if t == 6 {
        return NEG_EINVAL // px24: an epoll descriptor is not written
    }
    if t == 7 {
        // px30: /dev/dsp; a full queue answers WAIT (the call waits like
        // a full pipe's writer and runs again) or -EAGAIN.
        return sound.write(paging.live(), buf, len, files.nonblocking(area(), fd))
    }
    if t == 0 || len == 0 {
        return len
    }
    if !readable(buf, len) {
        who()
        log.put(" write fd ")
        num(fd)
        log.put(" buf ")
        log.hex(buf)
        log.put(" len ")
        num(len)
        log.put(": -EFAULT")
        log.end()
        return NEG_EFAULT
    }
    let smap = state(U_SMAP)
    var i: u64 = 0
    while i < len {
        // # Safety: buf + i lies in a page `readable` found present and
        // user in the live tables, and nothing unmaps it meanwhile (IF
        // is clear: one CPU, no switch); boot/user.S brackets the read
        // with STAC/CLAC under SMAP.
        let b = unsafe { pax_peek_user(buf + i, smap) }
        if b == 10 && console.onlcr() {
            serial.put(13)
        }
        serial.put((b & 0xff) as u8)
        i += 1
    }
    len
}

/// px24: `writev(fd, iov, iovcnt)` (`readv(2)`): the parts written one
/// after another as `write` writes each, and the bytes taken in all.
/// lobo sends a response's head and its body this way. A part that
/// must wait ends the call with what the earlier parts and that part
/// have taken so far (a short write, which a caller of `writev` reads
/// as one); with nothing taken yet the call waits, or answers the
/// first part's -errno. More than 1024 parts, or lengths whose sum
/// passes what a signed count holds, is -EINVAL.
fn writev(fd: u64, iov: u64, cnt: u64) -> u64 {
    if cnt > IOV_MAX {
        return NEG_EINVAL
    }
    let pml4 = paging.live()
    if cnt > 0 && !uaccess.readable(pml4, iov, cnt * 16) {
        return NEG_EFAULT
    }
    var sum: u64 = 0
    var i: u64 = 0
    while i < cnt {
        let l = uaccess.get64(pml4, iov + i * 16 + 8)
        if l >= 0x8000000000000000 || sum + l >= 0x8000000000000000 {
            return NEG_EINVAL
        }
        // Every part is the caller's to read before one byte is taken
        // (Linux answered -EFAULT for a bad second part and wrote nothing).
        if l > 0 && !uaccess.readable(pml4, uaccess.get64(pml4, iov + i * 16), l) {
            return NEG_EFAULT
        }
        sum += l
        i += 1
    }
    // A pipe takes a write of at most PIPE_BUF bytes whole or not at
    // all (pipe(7)), and to a pipe the parts are one write: the sum is
    // what the rule reads.
    let piped = files.write_target(area(), fd) == 3
    if piped && sum > 0 && sum <= PIPE_BUF && sched.self_done() == 0 && files.pipe_room(area(), fd) < sum {
        return if files.nonblocking(area(), fd) { NEG_EAGAIN } else { files.WAIT }
    }
    var total: u64 = 0
    i = 0
    while i < cnt {
        let base = uaccess.get64(pml4, iov + i * 16)
        let l = uaccess.get64(pml4, iov + i * 16 + 8)
        let r = if l == 0 && total > 0 { 0 } else if piped { files.pipe_write_part(area(), pml4, fd, base, l) } else { write(fd, base, l) }
        if r == files.WAIT {
            if total == 0 {
                return r // nothing taken: wait, and run the whole call again
            }
            // A later part must wait: what it took before it found no
            // room is the thread's count; answer the sum.
            let part = sched.self_done()
            sched.set_self_done(0)
            return total + part
        }
        if r >= 0x8000000000000000 {
            return if total > 0 { total } else { r }
        }
        total += r
        if r < l {
            return total
        }
        i += 1
    }
    total
}

// --- the Linux calls (px12) --------------------------------------------------

// Linux's numbers (syscall_64.tbl), px12's.
const SYS_READ: u64 = 0
const SYS_OPEN: u64 = 2
const SYS_CLOSE: u64 = 3
const SYS_STAT: u64 = 4
const SYS_FSTAT: u64 = 5
const SYS_LSTAT: u64 = 6
const SYS_LSEEK: u64 = 8
const SYS_MMAP: u64 = 9
const SYS_MPROTECT: u64 = 10
const SYS_MUNMAP: u64 = 11
const SYS_BRK: u64 = 12
const SYS_IOCTL: u64 = 16
const SYS_PREAD64: u64 = 17
const SYS_NANOSLEEP: u64 = 35
const SYS_UNAME: u64 = 63
const SYS_GETCWD: u64 = 79
const SYS_GETTIMEOFDAY: u64 = 96
const SYS_GETUID: u64 = 102
const SYS_GETGID: u64 = 104
const SYS_GETEUID: u64 = 107
const SYS_GETEGID: u64 = 108
const SYS_PRCTL: u64 = 157
const SYS_ARCH_PRCTL: u64 = 158
const SYS_GETTID: u64 = 186
const SYS_TIME: u64 = 201
const SYS_GETDENTS64: u64 = 217
const SYS_SET_TID_ADDRESS: u64 = 218
const SYS_CLOCK_GETTIME: u64 = 228
const SYS_CLOCK_NANOSLEEP: u64 = 230
const SYS_OPENAT: u64 = 257
const SYS_NEWFSTATAT: u64 = 262
const SYS_READLINKAT: u64 = 267
const SYS_PRLIMIT64: u64 = 302
const SYS_GETRANDOM: u64 = 318
const SYS_STATX: u64 = 332
// px14: processes.
const SYS_RT_SIGACTION: u64 = 13
const SYS_RT_SIGPROCMASK: u64 = 14
const SYS_DUP: u64 = 32
const SYS_DUP2: u64 = 33
const SYS_GETPID: u64 = 39
const SYS_CLONE: u64 = 56
const SYS_VFORK: u64 = 58
const SYS_EXECVE: u64 = 59
const SYS_WAIT4: u64 = 61
const SYS_KILL: u64 = 62
const SYS_GETPPID: u64 = 110
const SYS_TKILL: u64 = 200
const SYS_TGKILL: u64 = 234
const SYS_WAITID: u64 = 247
const SYS_DUP3: u64 = 292
const SYS_CLONE3: u64 = 435
const O_CLOEXEC: u64 = 0x80000
// px17: plumbing.
const SYS_PIPE: u64 = 22
const SYS_SENDTO: u64 = 44
const SYS_RECVFROM: u64 = 45
const SYS_SOCKETPAIR: u64 = 53
const SYS_FCNTL: u64 = 72
const SYS_CHDIR: u64 = 80
const SYS_FCHDIR: u64 = 81
const SYS_PIPE2: u64 = 293
const MSG_NOSIGNAL: u64 = 0x4000
// px22: AF_INET datagram sockets (kernel/socket).
const SYS_SOCKET: u64 = 41
const SYS_CONNECT: u64 = 42
const SYS_ACCEPT: u64 = 43
const SYS_BIND: u64 = 49
const SYS_SHUTDOWN: u64 = 48 // px23
const SYS_LISTEN: u64 = 50
const SYS_GETSOCKNAME: u64 = 51
const SYS_GETPEERNAME: u64 = 52
const SYS_SETSOCKOPT: u64 = 54
const SYS_GETSOCKOPT: u64 = 55
const SYS_ACCEPT4: u64 = 288
// px26: threads, futexes and signals.
const SYS_RT_SIGRETURN: u64 = 15
const SYS_SCHED_YIELD: u64 = 24
const SYS_MADVISE: u64 = 28
const SYS_RT_SIGPENDING: u64 = 127
const SYS_FUTEX: u64 = 202
const PR_SET_NAME: u64 = 15
// px26: what bu20's boreutils ask.
const SYS_SENDFILE: u64 = 40
const SYS_READLINK: u64 = 89
const SYS_SPLICE: u64 = 275
const SYS_COPY_FILE_RANGE: u64 = 326
// px27: the writable tree.
const SYS_PWRITE64: u64 = 18
const SYS_ACCESS: u64 = 21
const SYS_FSYNC: u64 = 74
const SYS_FDATASYNC: u64 = 75
const SYS_TRUNCATE: u64 = 76
const SYS_FTRUNCATE: u64 = 77
const SYS_RENAME: u64 = 82
const SYS_MKDIR: u64 = 83
const SYS_RMDIR: u64 = 84
const SYS_LINK: u64 = 86
const SYS_UNLINK: u64 = 87
const SYS_SYMLINK: u64 = 88
const SYS_CHMOD: u64 = 90
const SYS_FCHMOD: u64 = 91
const SYS_CHOWN: u64 = 92
const SYS_FCHOWN: u64 = 93
const SYS_LCHOWN: u64 = 94
const SYS_UMASK: u64 = 95
const SYS_UTIME: u64 = 132
const SYS_MKNOD: u64 = 133
const SYS_UTIMES: u64 = 235
const SYS_MKDIRAT: u64 = 258
const SYS_MKNODAT: u64 = 259
const SYS_FCHOWNAT: u64 = 260
const SYS_UNLINKAT: u64 = 263
const SYS_RENAMEAT: u64 = 264
const SYS_LINKAT: u64 = 265
const SYS_SYMLINKAT: u64 = 266
const SYS_FCHMODAT: u64 = 268
const SYS_FACCESSAT: u64 = 269
const SYS_UTIMENSAT: u64 = 280
const SYS_RENAMEAT2: u64 = 316
const SYS_FACCESSAT2: u64 = 439
const SYS_FCHMODAT2: u64 = 452
const AT_REMOVEDIR: u64 = 0x200
// px24: readiness, and the rest wolf's hosted runtime and lobo ask.
const SYS_POLL: u64 = 7
const SYS_WRITEV: u64 = 20
const SYS_SIGALTSTACK: u64 = 131
const SYS_SCHED_GETAFFINITY: u64 = 204
const SYS_EPOLL_WAIT: u64 = 232
const SYS_EPOLL_CTL: u64 = 233
const SYS_EVENTFD2: u64 = 290
const SYS_EPOLL_CREATE1: u64 = 291
const IOV_MAX: u64 = 1024 // uapi linux/uio.h's UIO_MAXIOV
const PIPE_BUF: u64 = 4096 // pipe(7)
const NEG_EAGAIN: u64 = 0xfffffffffffffff5 // -11
const GRND_NONBLOCK: u64 = 1 // uapi linux/random.h
const GRND_RANDOM: u64 = 2
const GRND_INSECURE: u64 = 4

const NEG_EPERM: u64 = 0xffffffffffffffff // -1
const NEG_ESRCH: u64 = 0xfffffffffffffffd // -3
const NEG_EINVAL: u64 = 0xffffffffffffffea // -22
const AT_FDCWD: u64 = 0xffffff9c // -100, as an int (`int32`)
const AT_SYMLINK_NOFOLLOW: u64 = 0x100
const ARCH_SET_FS: u64 = 0x1002 // uapi asm/prctl.h
const ARCH_GET_FS: u64 = 0x1003
const PR_GET_NAME: u64 = 16 // uapi linux/prctl.h
const RLIMIT_STACK: u64 = 3 // uapi asm-generic/resource.h
const RLIMIT_NOFILE: u64 = 7
const RLIM_NLIMITS: u64 = 16
const RLIM_INFINITY: u64 = 0xffffffffffffffff
const TIMER_ABSTIME: u64 = 1
const NS_PER_SEC: u64 = 1000000000
// The PIT ticks at 1193182 / 11932 Hz (kernel/timer): 10000150.8 ns a
// tick; CLOCK_* read the tick count, so they advance 10 ms at a time.
const NS_PER_TICK: u64 = 10000151
const GETRANDOM_MAX: u64 = 0x1ffffff // Linux's per-call cap, 33554431

// The area's words kernel/user keeps: the calls already logged (one bit
// each for 0-511), and the refusal word kernel/vm and kernel/files set.
const A_REFUSAL: u64 = 3
const A_LOGGED: u64 = 4 // 8 words

/// The running process's area (kernel/sched's `proc_area`).
fn area() -> u64 {
    sched.proc_area(sched.self_slot())
}

fn aword(i: u64) -> u64 {
    // # Safety: a process area's word i < 512 (sched.proc_area).
    unsafe { ((area() + i * 8) as *u64).read_volatile() }
}

fn put_aword(i: u64, v: u64) {
    // # Safety: as `aword`.
    unsafe { ((area() + i * 8) as *u64).write_volatile(v) }
}

/// `user: <name> pid <id> syscall <n>: -ENOSYS`, once per process and
/// number (numbers past 511 every time); nothing when the console is
/// quiet (px15).
fn unknown(nr: u64) {
    if nr < 512 {
        let w = A_LOGGED + nr / 64
        let bit: u64 = 1 << (nr % 64)
        if aword(w) & bit != 0 {
            return
        }
        put_aword(w, aword(w) | bit)
    }
    if log.quiet() {
        return
    }
    who()
    log.put(" syscall ")
    num(nr)
    log.put(": -ENOSYS")
    log.end()
}

/// After call `nr` answered `r`: a refusal by name, when kernel/vm or
/// kernel/files left one: `user: <name> pid <id> syscall <n>: refused:
/// <why>, -<errno>`.
fn refusal_line(nr: u64, r: u64) {
    let c = aword(A_REFUSAL)
    if c == 0 {
        return
    }
    put_aword(A_REFUSAL, 0)
    who()
    log.put(" syscall ")
    num(nr)
    log.put(": refused: ")
    if c >= ready.REFUSALS {
        log.put(ready.why(c)) // px24
    } else if c >= socket.REFUSALS {
        log.put(socket.why(c)) // px22
        socket.detail(area(), c)
    } else {
        log.put(if c < 16 { vm.why(c) } else if c < 32 { files.why(c) } else { process.why(c) })
    }
    log.put(", -")
    num(0xffffffffffffffff - r + 1)
    log.end()
}

/// Write the str `s` at user `va` and a NUL (checked by the caller).
fn put_str(va: u64, s: str) {
    var k: u64 = 0
    for b in s.bytes() {
        uaccess.put(paging.live(), va + k, b as int as u64, 1)
        k += 1
    }
    uaccess.put(paging.live(), va + k, 0, 1)
}

/// `uname(buf)`: struct new_utsname, six fields of 65 bytes.
fn uname(buf: u64) -> u64 {
    let pml4 = paging.live()
    if !uaccess.writable(pml4, buf, 390) {
        return NEG_EFAULT
    }
    uaccess.zero(pml4, buf, 390)
    put_str(buf, "PAX")
    put_str(buf + 65, "pax")
    put_str(buf + 130, "0.0.1")
    put_str(buf + 195, "#1 px12")
    put_str(buf + 260, "x86_64")
    put_str(buf + 325, "(none)")
    0
}

/// `arch_prctl(code, addr)`: ARCH_SET_FS and ARCH_GET_FS (FS per
/// thread, kernel/sched); anything else -EINVAL.
fn arch_prctl(code: u64, addr: u64) -> u64 {
    if code == ARCH_SET_FS {
        if addr >= paging.USER_TOP {
            return NEG_EPERM
        }
        sched.set_self_fs(addr)
        return 0
    }
    if code == ARCH_GET_FS {
        let pml4 = paging.live()
        if !uaccess.writable(pml4, addr, 8) {
            return NEG_EFAULT
        }
        uaccess.put(pml4, addr, sched.self_fs(), 8)
        return 0
    }
    NEG_EINVAL
}

/// `prctl(option, arg2, …)`: PR_GET_NAME (the thread's name, at most 15
/// bytes and a NUL, as Linux's 16-byte comm: the program's name until
/// the thread sets one) and, px26, PR_SET_NAME (the thread's own, cut
/// at 15 bytes); anything else -EINVAL.
fn prctl(option: u64, arg2: u64) -> u64 {
    let pml4 = paging.live()
    if option == PR_SET_NAME {
        var w0: u64 = 0
        var w1: u64 = 0
        var i: u64 = 0
        while i < 15 {
            if !uaccess.readable(pml4, arg2 + i, 1) {
                return NEG_EFAULT
            }
            let b = uaccess.get(pml4, arg2 + i, 1)
            if b == 0 {
                break
            }
            if i < 8 {
                w0 = w0 | (b << (i * 8))
            } else {
                w1 = w1 | (b << ((i - 8) * 8))
            }
            i += 1
        }
        if w0 == 0 {
            w1 = 0x8000000000000000 // an empty name is still a name set (byte 15 is never the name's)
        }
        sched.set_self_name(w0, w1)
        return 0
    }
    if option != PR_GET_NAME {
        return NEG_EINVAL
    }
    if !uaccess.writable(pml4, arg2, 16) {
        return NEG_EFAULT
    }
    uaccess.zero(pml4, arg2, 16)
    let n0 = sched.self_name(0)
    let n1 = sched.self_name(1)
    if n0 != 0 || n1 != 0 {
        uaccess.put(pml4, arg2, n0, 8)
        uaccess.put(pml4, arg2 + 8, n1 & 0x00ffffffffffffff, 7)
        return 0
    }
    if sched.self_prog() == sched.ELF_PROG {
        let a = sched.self_exec(2)
        let l = sched.self_exec(3)
        let n = if l < 15 { l } else { 15 }
        let _ok = uaccess.copy_out(pml4, arg2, a, n)
    }
    0
}

/// `prlimit64(pid, resource, new, old)`: the stack's limit is the
/// stack PAX gives (ELF_STACK_PAGES pages, fixed), the descriptors' the
/// table's (`files.FDS`), every other unlimited; setting one is -EPERM.
fn prlimit(pid: u64, res: u64, new: u64, old: u64) -> u64 {
    if pid != 0 && pid != sched.self_pid() {
        return NEG_ESRCH
    }
    if res >= RLIM_NLIMITS {
        return NEG_EINVAL
    }
    if new != 0 {
        return NEG_EPERM
    }
    if old != 0 {
        let pml4 = paging.live()
        if !uaccess.writable(pml4, old, 16) {
            return NEG_EFAULT
        }
        var v = RLIM_INFINITY
        if res == RLIMIT_STACK {
            v = ELF_STACK_PAGES * PAGE
        } else if res == RLIMIT_NOFILE {
            v = files.FDS // px24: 128
        }
        uaccess.put(pml4, old, v, 8)
        uaccess.put(pml4, old + 8, v, 8)
    }
    0
}

/// `getrandom(buf, len, flags)`: len bytes (at most Linux's cap) from
/// RDRAND, or the TSC mix on a CPU without it (`random_word`).
fn getrandom(buf: u64, len: u64, flags: u64) -> u64 {
    // px24: the flags are read (getrandom(2)): an unknown bit, or
    // GRND_RANDOM with GRND_INSECURE, is -EINVAL. PAX's source never
    // waits, so GRND_NONBLOCK changes nothing.
    if flags & !(GRND_NONBLOCK | GRND_RANDOM | GRND_INSECURE) != 0 || flags & (GRND_RANDOM | GRND_INSECURE) == (GRND_RANDOM | GRND_INSECURE) {
        return NEG_EINVAL
    }
    let n = if len < GETRANDOM_MAX { len } else { GETRANDOM_MAX }
    let pml4 = paging.live()
    if !uaccess.writable(pml4, buf, n) {
        return NEG_EFAULT
    }
    var i: u64 = 0
    while i < n {
        let w = process.random_word(i)
        let k = if n - i < 8 { n - i } else { 8 }
        uaccess.put(pml4, buf + i, w, k)
        i += k
    }
    n
}

/// Nanoseconds since the timer started (CLOCK_MONOTONIC and its
/// kin: the tick count).
fn now_ns() -> u64 {
    timer.ticks() * NS_PER_TICK
}

/// px26: nanoseconds since the epoch (CLOCK_REALTIME): the real-time
/// clock's reading at boot (kernel/rtc, `start`) plus the ticks since.
/// On a machine whose clock cannot be read it counts from the epoch.
fn wall_ns() -> u64 {
    state(U_EPOCH) * NS_PER_SEC + now_ns()
}

/// Whether clock `clk` is a wall clock: CLOCK_REALTIME (0),
/// CLOCK_REALTIME_COARSE (5), CLOCK_REALTIME_ALARM (8) and CLOCK_TAI
/// (11, answered as UTC: PAX keeps no leap-second offset).
fn is_wall(clk: u64) -> bool {
    clk == 0 || clk == 5 || clk == 8 || clk == 11
}

/// `clock_gettime(clock, tp)`: clocks 0-11; the wall clocks answer the
/// date (px26), the others the tick count.
fn clock_gettime(clk: u64, tp: u64) -> u64 {
    if clk > 11 {
        return NEG_EINVAL
    }
    let pml4 = paging.live()
    if !uaccess.writable(pml4, tp, 16) {
        return NEG_EFAULT
    }
    let ns = if is_wall(clk) { wall_ns() } else { now_ns() }
    uaccess.put(pml4, tp, ns / NS_PER_SEC, 8)
    uaccess.put(pml4, tp + 8, ns % NS_PER_SEC, 8)
    0
}

/// `time(tloc)` and `gettimeofday(tv, tz)` (px12: PAX has no vDSO, so
/// glibc makes the calls Linux answers in user space; busybox's `ls`
/// asks for the time): the wall clock's seconds (px26).
fn time(tloc: u64) -> u64 {
    let sec = wall_ns() / NS_PER_SEC
    if tloc != 0 {
        let pml4 = paging.live()
        if !uaccess.writable(pml4, tloc, 8) {
            return NEG_EFAULT
        }
        uaccess.put(pml4, tloc, sec, 8)
    }
    sec
}

fn gettimeofday(tv: u64, tz: u64) -> u64 {
    let pml4 = paging.live()
    if tv != 0 {
        if !uaccess.writable(pml4, tv, 16) {
            return NEG_EFAULT
        }
        let ns = wall_ns()
        uaccess.put(pml4, tv, ns / NS_PER_SEC, 8)
        uaccess.put(pml4, tv + 8, ns % NS_PER_SEC / 1000, 8)
    }
    if tz != 0 {
        if !uaccess.writable(pml4, tz, 8) {
            return NEG_EFAULT
        }
        uaccess.zero(pml4, tz, 8)
    }
    0
}

/// The tick a sleep of `req` (a user timespec) ends at, absolute when
/// `abs` (px26: on the wall clock when `wall`); 0 for a bad request
/// (-EINVAL or -EFAULT's case, in `bad`).
/// Returns (wake tick, errno result or 0).
fn sleep_until(req: u64, abs: bool, wall: bool) -> (u64, u64) {
    let pml4 = paging.live()
    if !uaccess.readable(pml4, req, 16) {
        return (0, NEG_EFAULT)
    }
    let sec = uaccess.get64(pml4, req)
    let nsec = uaccess.get64(pml4, req + 8)
    if nsec >= NS_PER_SEC || sec >= 0x8000000000000000 {
        return (0, NEG_EINVAL)
    }
    // Past about 58 years of ticks the sleep is forever; cap it there.
    let cap: u64 = 0x10000000000
    let s = if sec < cap { sec } else { cap }
    var target = s * NS_PER_SEC + nsec
    let now = now_ns()
    if !abs {
        target = target + now
    } else if wall {
        // px26: a date on the wall clock, as a count of ticks' worth.
        let w = wall_ns()
        target = if target > w { target - w + now } else { 0 }
    }
    if target <= now {
        return (0, 0)
    }
    let t = (target + NS_PER_TICK - 1) / NS_PER_TICK
    (t + 1, 0) // the tick after: a partial tick never shortens a sleep
}

/// A system call (kernel/interrupts, vector PAX_SYSCALL): the frame to
/// resume — `f` with %rax set, or, after `exit`, `exit_group` or a
/// sleep, the next thread's.
pub fn syscall(f: u64) -> u64 {
    let nr = word(f, W_RAX)
    let a0 = word(f, W_RDI)
    let a1 = word(f, W_RSI)
    let a2 = word(f, W_RDX)
    let a3 = word(f, W_R10)
    let a4 = word(f, W_R8)
    sched.syscall_begins() // px26: whatever wait the last call was in is over
    if nr == SYS_EXIT && sched.self_threads() > 1 {
        // px26: `exit` ends the calling thread alone while its process
        // has others: the clear-child-tid word zeroed and its futex
        // woken (`set_tid_address(2)`), which is what a join waits for.
        if !log.quiet() && sched.threads_made() <= 4 {
            who()
            log.put(" thread ")
            log.dec(sched.self_tid() as int)
            log.put(" exit ")
            log.dec((a0 & 0xff) as int)
            runs_tail()
            log.end()
        }
        let ct = sched.self_ctid()
        let pml4 = paging.live()
        if ct != 0 && uaccess.writable(pml4, ct, 4) {
            uaccess.put(pml4, ct, 0, 4)
            futex.wake_tid(pml4, ct)
        }
        return sched.end_thread(f)
    }
    if nr == SYS_EXIT || nr == SYS_EXIT_GROUP {
        if !log.quiet() { // px15
            who()
            log.put(if nr == SYS_EXIT { " exit " } else { " exit_group " })
            log.dec((a0 & 0xff) as int)
            runs_tail()
            log.end()
        }
        if sched.self_ppid() == 0 {
            put_state(U_LAST_EXIT, (a0 & 0xff) + 1) // px14: a program the kernel started
        }
        files.close_all(area()) // px17: its pipes' ends close now
        let _n = netd.drain() // px23: what its sockets' ends sent to this machine
        // The process ends (`exit` from its last thread ends it too);
        // the parent reads `code << 8` (px14).
        return sched.end_with(f, (a0 & 0xff) << 8)
    }
    // px26: the calls that hand back another frame.
    if nr == SYS_RT_SIGRETURN {
        return signal.sigreturn(f)
    }
    if nr == SYS_FUTEX {
        let g = futex.call(f, a0, a1, a2, a3, word(f, W_R9), wall_ns())
        if g == f {
            refusal_line(nr, word(f, W_RAX))
        }
        return g
    }
    if nr == SYS_SCHED_YIELD {
        put_word(f, W_RAX, 0)
        return sched.yield_current(f)
    }
    if nr == SYS_SIGALTSTACK {
        // px24: it reads the caller's stack pointer from the frame.
        let r = signal.sigaltstack(f, a0, a1)
        put_word(f, W_RAX, r)
        refusal_line(nr, r)
        return f
    }
    // px14: the calls that make, replace and wait for processes.
    if nr == SYS_CLONE || nr == SYS_CLONE3 || nr == SYS_VFORK {
        let g = process.clone(f, nr, a0, a1, a2, a3, a4)
        if g == f {
            refusal_line(nr, word(f, W_RAX))
        }
        return g
    }
    if nr == SYS_EXECVE {
        let r = process.execve(f, a0, a1, a2)
        if r != 0 {
            put_word(f, W_RAX, r)
            refusal_line(nr, r)
        }
        let _n = netd.drain() // px23: a close-on-exec socket's last words
        return f
    }
    if nr == SYS_WAIT4 {
        return process.wait4(f, nr, a0, a1, a2, a3)
    }
    if nr == SYS_WAITID {
        return process.waitid(f, nr, a0, a1, a2, a3, a4)
    }
    if nr == SYS_CLOCK_NANOSLEEP || nr == SYS_NANOSLEEP {
        var req = a0
        var abs = false
        var rem = a1 // px26: where the time left goes when a signal ends the sleep
        if nr == SYS_CLOCK_NANOSLEEP {
            req = a2
            abs = a1 & TIMER_ABSTIME != 0
            rem = if abs { 0 } else { a3 }
            if a0 > 11 {
                put_word(f, W_RAX, NEG_EINVAL)
                return f
            }
        }
        let (wake, r) = sleep_until(req, abs, nr == SYS_CLOCK_NANOSLEEP && is_wall(a0))
        put_word(f, W_RAX, r)
        if wake == 0 {
            return f
        }
        return sched.sleep_current_rem(f, wake, rem)
    }
    let a5 = word(f, W_R9)
    var r = dispatch(nr, a0, a1, a2, a3, a4, a5)
    // px23: what the call sent to this machine (kernel/ip's loopback
    // queue) is delivered before it returns, as a datagram over px22's
    // loopback was. A call that said "wait" while its answer was still
    // on that queue runs again now: the delivery's wake-up came before
    // the thread was parked.
    var looped = netd.drain()
    while r == files.WAIT && looped != 0 {
        r = dispatch(nr, a0, a1, a2, a3, a4, a5)
        looped = netd.drain()
    }
    if r == files.WAIT {
        // px17: a pipe or socket that cannot answer yet. As the console's
        // wait: the call runs again, in its own space, when a pipe changes.
        put_word(f, W_RIP, word(f, W_RIP) - 2)
        put_word(f, W_RAX, nr)
        // px22: a receive with a timeout waits until its deadline at most.
        let until = socket.deadline(area())
        if nr == SYS_POLL || nr == SYS_EPOLL_WAIT {
            // px24: a handled signal ends these with -EINTR, SA_RESTART
            // or not; a wait for good keeps `ready.FOREVER` as its mark.
            return sched.block_pipe_eintr(f, if until == ready.FOREVER { 0 } else { until })
        }
        if until != 0 {
            return sched.block_pipe_until(f, until)
        }
        return sched.block_pipe(f)
    }
    if r == files.EPIPE_R && (nr == SYS_WRITE || nr == SYS_WRITEV || nr == SYS_SENDFILE || nr == SYS_SPLICE || (nr == SYS_SENDTO && a3 & MSG_NOSIGNAL == 0)) {
        // px17, px26: SIGPIPE for the writer, taken as this call returns:
        // the default ends the process (kernel/signal's line), a handler
        // runs and the write answers -EPIPE, an ignored one just answers.
        // px23: a stream socket whose connection is over is the other
        // thing a write can find broken; the line says which.
        signal.pipe(socket.is_inet(area(), int32(a0)))
    }
    if r == console.RESTART {
        // px13: a read of the console with nothing ready. The thread
        // waits for input; the frame is rewound to the `syscall`
        // instruction (0f 05, two bytes) with %rax the call's number
        // again, so when the console's interrupt wakes it the read runs
        // afresh in its own address space.
        put_word(f, W_RIP, word(f, W_RIP) - 2)
        put_word(f, W_RAX, nr)
        return sched.block_input(f)
    }
    put_word(f, W_RAX, r)
    refusal_line(nr, r)
    tree_lines()
    f
}

/// px27: what kernel/tree has to say after a call, in the caller's
/// name: every 2500th file removed, the books (`user: <name> pid <pid>
/// tree: <n> files removed since boot; frames held <h>, inodes <i>,
/// frames free <f>`), which a soak holds flat; and, once each time it
/// happens, that the tree refused a frame (`… tree: full: frames held
/// <h> of <cap>, frames free <f>, reserve <r>`): the cap, or the
/// machine's last frames, which a write never takes. Nothing when the
/// console is quiet.
fn tree_lines() {
    let n = tree.census_due()
    let full = tree.full_news()
    if log.quiet() || (n == 0 && !full) {
        return
    }
    who()
    if n != 0 {
        log.put(" tree: ")
        log.dec(n as int)
        log.put(" files removed since boot; frames held ")
        log.dec(tree.held() as int)
        log.put(", inodes ")
        log.dec(tree.live() as int)
        log.put(", frames free ")
        log.dec(frames.free_count() as int)
    } else {
        log.put(" tree: full: frames held ")
        log.dec(tree.held() as int)
        log.put(" of ")
        log.dec(tree.cap() as int)
        log.put(", frames free ")
        log.dec(frames.free_count() as int)
        log.put(", reserve ")
        log.dec(tree.RESERVE as int)
    }
    log.end()
}

/// px27: the tree's line after a kernel's frames line: `tree: frames
/// <h> (<b> when made), <t> (<b>) of them the inode table's, inodes <i>
/// (<b>), cap <c>, refusals <n>`: what it holds now and held when the
/// initramfs was in. The inode table's frames grow with the most
/// inodes there have been and are never given back; every other frame
/// is, so a session that removed what it made shows the same count of
/// those, and the same inodes.
pub fn tree_report() {
    log.put("tree: frames ")
    log.dec(tree.held() as int)
    log.put(" (")
    log.dec(tree.base(0) as int)
    log.put(" when made), ")
    log.dec(tree.table_frames() as int)
    log.put(" (")
    log.dec(tree.base(2) as int)
    log.put(") of them the inode table's, inodes ")
    log.dec(tree.live() as int)
    log.put(" (")
    log.dec(tree.base(1) as int)
    log.put("), cap ")
    log.dec(tree.cap() as int)
    log.put(", refusals ")
    log.dec(tree.refusals() as int)
    log.end()
}

/// The low 32 bits of a register: an `int` argument (a descriptor, a
/// directory descriptor such as AT_FDCWD, flags, whence). The psABI
/// leaves a 32-bit argument's upper half undefined, and glibc passes
/// AT_FDCWD as 0x00000000ffffff9c (measured, px12): Linux reads the int.
fn int32(x: u64) -> u64 {
    x & 0xffffffff
}

/// Every call that answers in place: the result for %rax.
fn dispatch(nr: u64, r0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> u64 {
    let a = area()
    let pml4 = paging.live()
    // The calls whose first argument is an int (a descriptor), read as
    // one; the others take r0 whole.
    let a0 = if nr == SYS_READ || nr == SYS_WRITE || nr == SYS_PREAD64 || nr == SYS_OPENAT || nr == SYS_CLOSE || nr == SYS_LSEEK || nr == SYS_FSTAT || nr == SYS_NEWFSTATAT || nr == SYS_STATX || nr == SYS_GETDENTS64 || nr == SYS_IOCTL || nr == SYS_READLINKAT || nr == SYS_DUP || nr == SYS_DUP2 || nr == SYS_DUP3 || nr == SYS_FCNTL || nr == SYS_FCHDIR || nr == SYS_SENDFILE || nr == SYS_SPLICE || nr == SYS_COPY_FILE_RANGE || nr == SYS_SENDTO || nr == SYS_RECVFROM || nr == SYS_SOCKET || nr == SYS_CONNECT || nr == SYS_ACCEPT || nr == SYS_BIND || nr == SYS_LISTEN || nr == SYS_GETSOCKNAME || nr == SYS_GETPEERNAME || nr == SYS_SETSOCKOPT || nr == SYS_GETSOCKOPT || nr == SYS_ACCEPT4 || nr == SYS_WRITEV || nr == SYS_EPOLL_WAIT || nr == SYS_EPOLL_CTL || nr == SYS_EPOLL_CREATE1 { int32(r0) } else { r0 }
    if nr == SYS_WRITE {
        return write(a0, a1, a2)
    }
    if nr == SYS_READ {
        if socket.is_inet(a, a0) {
            return socket.recvfrom(a, pml4, a0, a1, a2, 0, 0, 0) // px22
        }
        return files.read(a, pml4, a0, a1, a2)
    }
    if nr == SYS_PREAD64 {
        return files.pread(a, pml4, a0, a1, a2, a3)
    }
    if nr == SYS_OPENAT {
        return files.openat(a, pml4, a0, a1, int32(a2), int32(a3)) // px27: the mode
    }
    if nr == SYS_OPEN {
        return files.openat(a, pml4, AT_FDCWD, a0, int32(a1), int32(a2))
    }
    if nr == SYS_CLOSE {
        // px30: the last blocking close of /dev/dsp plays out what is
        // queued first, as Linux's does: WAIT until the device is done.
        if files.closes_dsp(a, a0) && sound.drain() == sound.WAIT {
            return files.WAIT
        }
        return files.close(a, a0)
    }
    if nr == SYS_LSEEK {
        return files.lseek(a, a0, a1, int32(a2))
    }
    if nr == SYS_FSTAT {
        return files.fstat(a, pml4, a0, a1)
    }
    if nr == SYS_STAT {
        return files.fstatat(a, pml4, AT_FDCWD, a0, a1, 0)
    }
    if nr == SYS_LSTAT {
        return files.fstatat(a, pml4, AT_FDCWD, a0, a1, AT_SYMLINK_NOFOLLOW)
    }
    if nr == SYS_NEWFSTATAT {
        return files.fstatat(a, pml4, a0, a1, a2, int32(a3))
    }
    if nr == SYS_STATX {
        return files.statx(a, pml4, a0, a1, int32(a2), a4)
    }
    if nr == SYS_GETDENTS64 {
        return files.getdents(a, pml4, a0, a1, a2)
    }
    if nr == SYS_IOCTL {
        // px13: the console answers the terminal ioctls; a request it
        // refuses is named here and answered -ENOTTY.
        let req = int32(a1)
        let r = files.ioctl(a, pml4, a0, req, a2)
        if r == 0 && speaker.request(req) {
            speaker.own(sched.self_pid()) // px18: the tone stops when this process ends
        }
        if r == console.REFUSED {
            who()
            log.put(" syscall 16: refused: tty ioctl ")
            log.hex(req)
            log.put(", -ENOTTY")
            log.end()
            return console.NEG_ENOTTY
        }
        return r
    }
    if nr == SYS_GETCWD {
        return files.getcwd(a, pml4, a0, a1)
    }
    // px17: plumbing.
    if nr == SYS_PIPE {
        return files.pipe2(a, pml4, a0, 0)
    }
    if nr == SYS_PIPE2 {
        return files.pipe2(a, pml4, a0, int32(a1))
    }
    if nr == SYS_SOCKETPAIR {
        return files.socketpair(a, pml4, int32(a0), int32(a1), int32(a2), a3)
    }
    if nr == SYS_SENDTO {
        if socket.is_inet(a, a0) {
            return socket.sendto(a, pml4, a0, a1, a2, int32(a3), a4, int32(a5)) // px22
        }
        return files.sendto(a, pml4, a0, a1, a2, int32(a3), a4)
    }
    if nr == SYS_RECVFROM {
        if socket.is_inet(a, a0) {
            return socket.recvfrom(a, pml4, a0, a1, a2, int32(a3), a4, a5) // px22
        }
        return files.recvfrom(a, pml4, a0, a1, a2, int32(a3), a4, a5)
    }
    // px22: AF_INET datagram sockets.
    if nr == SYS_SOCKET {
        return socket.socket(a, a0, int32(a1), int32(a2))
    }
    if nr == SYS_BIND {
        return socket.bind(a, pml4, a0, a1, int32(a2))
    }
    if nr == SYS_CONNECT {
        return socket.connect(a, pml4, a0, a1, int32(a2))
    }
    if nr == SYS_GETSOCKNAME {
        return socket.getname(a, pml4, a0, a1, a2, false)
    }
    if nr == SYS_GETPEERNAME {
        return socket.getname(a, pml4, a0, a1, a2, true)
    }
    if nr == SYS_SETSOCKOPT {
        return socket.setsockopt(a, pml4, a0, int32(a1), int32(a2), a3, int32(a4))
    }
    if nr == SYS_GETSOCKOPT {
        return socket.getsockopt(a, pml4, a0, int32(a1), int32(a2), a3, a4)
    }
    if nr == SYS_LISTEN {
        return socket.listen(a, a0, int32(a1))
    }
    if nr == SYS_ACCEPT || nr == SYS_ACCEPT4 {
        return socket.accept(a, pml4, a0, a1, a2, if nr == SYS_ACCEPT4 { int32(a3) } else { 0 }, nr) // px23
    }
    if nr == SYS_SHUTDOWN {
        return socket.shutdown(a, int32(r0), int32(a1)) // px23
    }
    if nr == SYS_FCNTL {
        return files.fcntl(a, a0, int32(a1), a2)
    }
    if nr == SYS_CHDIR {
        return files.chdir(a, pml4, a0)
    }
    if nr == SYS_FCHDIR {
        return files.fchdir(a, a0)
    }
    if nr == SYS_READLINKAT {
        return files.readlinkat(a, pml4, a0, a1, a2, a3)
    }
    if nr == SYS_READLINK {
        return files.readlinkat(a, pml4, AT_FDCWD, a0, a1, a2) // px26
    }
    if nr == SYS_SENDFILE {
        return files.sendfile(a, pml4, a0, int32(a1), a2, a3) // px26
    }
    if nr == SYS_SPLICE {
        return files.splice(a, pml4, a0, a1, int32(a2), a3, a4, int32(a5)) // px26
    }
    if nr == SYS_COPY_FILE_RANGE {
        return files.copy_file_range(a, pml4, a0, a1, int32(a2), a3, a4, int32(a5)) // px26, px27
    }
    if nr == SYS_BRK {
        return vm.brk(a, pml4, a0)
    }
    if nr == SYS_MMAP {
        return vm.mmap(a, pml4, a0, a1, a2, a3)
    }
    if nr == SYS_MUNMAP {
        return vm.munmap(a, pml4, a0, a1)
    }
    if nr == SYS_MPROTECT {
        return vm.mprotect(a, pml4, a0, a1, a2)
    }
    if nr == SYS_MADVISE {
        return vm.madvise(a, pml4, a0, a1, a2) // px26
    }
    if nr == SYS_ARCH_PRCTL {
        return arch_prctl(a0, a1)
    }
    if nr == SYS_PRCTL {
        return prctl(a0, a1)
    }
    if nr == SYS_PRLIMIT64 {
        return prlimit(a0, a1, a2, a3)
    }
    if nr == SYS_GETRANDOM {
        return getrandom(a0, a1, int32(a2))
    }
    if nr == SYS_CLOCK_GETTIME {
        return clock_gettime(a0, a1)
    }
    if nr == SYS_TIME {
        return time(a0)
    }
    if nr == SYS_GETTIMEOFDAY {
        return gettimeofday(a0, a1)
    }
    if nr == SYS_UNAME {
        return uname(a0)
    }
    if nr == SYS_GETPID {
        return sched.self_pid()
    }
    if nr == SYS_GETTID {
        return sched.self_tid() // px26: the thread's own
    }
    if nr == SYS_SET_TID_ADDRESS {
        sched.set_self_ctid(a0) // px26: zeroed, and its futex woken, when the thread ends
        return sched.self_tid()
    }
    if nr == SYS_GETPPID {
        return sched.self_ppid()
    }
    if nr == SYS_DUP {
        return files.dup(a, a0, files.FDS, false)
    }
    if nr == SYS_DUP2 {
        let n = int32(a1)
        return files.dup(a, a0, if n >= files.FDS { files.FDS + 1 } else { n }, false)
    }
    if nr == SYS_DUP3 {
        let n = int32(a1)
        let fl = int32(a2)
        if a0 == n || (fl != 0 && fl != O_CLOEXEC) {
            return NEG_EINVAL
        }
        return files.dup(a, a0, if n >= files.FDS { files.FDS + 1 } else { n }, fl == O_CLOEXEC)
    }
    if nr == SYS_RT_SIGPROCMASK {
        return signal.sigprocmask(a0, a1, a2, a3)
    }
    if nr == SYS_RT_SIGACTION {
        return signal.sigaction(a0, a1, a2, a3)
    }
    if nr == SYS_RT_SIGPENDING {
        return signal.sigpending(a0, a1)
    }
    if nr == SYS_KILL {
        return signal.kill(a0, a1)
    }
    if nr == SYS_TGKILL {
        return signal.tgkill(a0, a1, a2, false)
    }
    if nr == SYS_TKILL {
        return signal.tgkill(0, a0, a1, true)
    }
    if nr == SYS_GETUID || nr == SYS_GETGID || nr == SYS_GETEUID || nr == SYS_GETEGID {
        return 0
    }
    // px27: the writable tree (kernel/files, kernel/tree).
    if nr == SYS_MKDIR {
        return files.mkdirat(a, pml4, AT_FDCWD, r0, int32(a1))
    }
    if nr == SYS_MKDIRAT {
        return files.mkdirat(a, pml4, int32(r0), a1, int32(a2))
    }
    if nr == SYS_RMDIR {
        return files.unlinkat(a, pml4, AT_FDCWD, r0, AT_REMOVEDIR)
    }
    if nr == SYS_UNLINK {
        return files.unlinkat(a, pml4, AT_FDCWD, r0, 0)
    }
    if nr == SYS_UNLINKAT {
        return files.unlinkat(a, pml4, int32(r0), a1, int32(a2))
    }
    if nr == SYS_RENAME {
        return files.renameat(a, pml4, AT_FDCWD, r0, AT_FDCWD, a1, 0)
    }
    if nr == SYS_RENAMEAT {
        return files.renameat(a, pml4, int32(r0), a1, int32(a2), a3, 0)
    }
    if nr == SYS_RENAMEAT2 {
        return files.renameat(a, pml4, int32(r0), a1, int32(a2), a3, int32(a4))
    }
    if nr == SYS_PWRITE64 {
        return files.pwrite(a, pml4, int32(r0), a1, a2, a3)
    }
    if nr == SYS_FTRUNCATE {
        return files.ftruncate(a, int32(r0), a1)
    }
    if nr == SYS_TRUNCATE {
        return files.truncate(a, pml4, r0, a1)
    }
    if nr == SYS_FSYNC || nr == SYS_FDATASYNC {
        return files.fsync(a, int32(r0))
    }
    if nr == SYS_UMASK {
        return files.umask(a, int32(r0))
    }
    if nr == SYS_ACCESS {
        return files.faccessat(a, pml4, AT_FDCWD, r0, int32(a1), 0)
    }
    if nr == SYS_FACCESSAT {
        return files.faccessat(a, pml4, int32(r0), a1, int32(a2), 0)
    }
    if nr == SYS_FACCESSAT2 {
        return files.faccessat(a, pml4, int32(r0), a1, int32(a2), int32(a3))
    }
    if nr == SYS_LINK || nr == SYS_SYMLINK || nr == SYS_LINKAT || nr == SYS_SYMLINKAT || nr == SYS_MKNOD || nr == SYS_MKNODAT {
        return files.refused(a, 0)
    }
    if nr == SYS_CHMOD || nr == SYS_FCHMOD || nr == SYS_FCHMODAT || nr == SYS_FCHMODAT2 || nr == SYS_CHOWN || nr == SYS_FCHOWN || nr == SYS_LCHOWN || nr == SYS_FCHOWNAT || nr == SYS_UTIMENSAT || nr == SYS_UTIMES || nr == SYS_UTIME {
        return files.refused(a, 1)
    }
    // px24: readiness (kernel/ready) and the gathered write, in a
    // function of their own (this one is long enough: wolf-lang#711).
    ready_calls(nr, a, pml4, a0, a1, a2, a3)
}

/// px24's calls that answer in place: `poll`, the three epoll calls,
/// `eventfd2`, `sched_getaffinity`, `writev`; anything else is
/// -ENOSYS, logged once a process.
fn ready_calls(nr: u64, a: u64, pml4: u64, a0: u64, a1: u64, a2: u64, a3: u64) -> u64 {
    if nr == SYS_POLL {
        return ready.poll(a, pml4, a0, a1, int32(a2))
    }
    if nr == SYS_EPOLL_WAIT {
        return ready.epoll_wait(a, pml4, a0, a1, int32(a2), int32(a3))
    }
    if nr == SYS_EPOLL_CTL {
        return ready.epoll_ctl(a, pml4, a0, int32(a1), int32(a2), a3)
    }
    if nr == SYS_EPOLL_CREATE1 {
        return ready.epoll_create1(a, a0)
    }
    if nr == SYS_EVENTFD2 {
        return ready.eventfd2(a, int32(a0), int32(a1))
    }
    if nr == SYS_SCHED_GETAFFINITY {
        return ready.sched_getaffinity(pml4, a0, a1, a2)
    }
    if nr == SYS_WRITEV {
        return writev(a0, a1, int32(a2))
    }
    unknown(nr)
    NEG_ENOSYS
}

/// An exception in ring 3 (kernel/interrupts; `what` its name): the
/// program is killed by name and the next thread's frame returned.
pub fn kill(f: u64, what: str) -> u64 {
    let v = word(f, W_VECTOR)
    // px26: a handler for the fault's signal runs instead (kernel/signal).
    let g = signal.fault(f, v)
    if g != 0 {
        return g
    }
    who()
    log.put(" killed: ")
    log.put(what)
    log.put(" vector ")
    log.dec(v as int)
    log.put(" error ")
    log.hex(word(f, W_ERROR))
    log.put(" rip ")
    log.hex(word(f, W_RIP))
    if v == 14 {
        log.put(" cr2 ")
        // # Safety: cpu.S's MOV from CR2; this page fault set it.
        log.hex(unsafe { pax_cr2() })
    }
    runs_tail()
    log.end()
    files.close_all(area()) // px17
    let _n = netd.drain() // px23
    sched.end_with(f, process.fault_signal(v)) // px14: the parent reads the signal
}

// --- ELF processes (px10; the image moved to kernel/process in px14) ------------

/// Load `path` from the initramfs as an ELF process with `argv` and
/// `envp` (space-separated words) and start its thread (kernel/process's
/// `exec`). Returns its id, or 0 when refused.
pub fn exec(body: u64, path: str, argv: str, envp: str) -> u64 {
    process.exec(body, path, argv, envp)
}

/// kernel/process's `exec_line` (px12).
pub fn exec_line(body: u64, pa: u64, pl: u64, aa: u64, al: u64, envp: str) -> u64 {
    process.exec_line(body, pa, pl, aa, al, envp)
}

/// kernel/process's `exec_span` (px12).
pub fn exec_span(body: u64, pa: u64, pl: u64, aa: u64, al: u64, ea: u64, el: u64) -> u64 {
    process.exec_span(body, pa, pl, aa, al, ea, el)
}
