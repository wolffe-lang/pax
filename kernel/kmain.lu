//! member: false
// kmain.lu — first light (px01, M-PX1). Limine enters boot/start.S,
// which checks the base revision and calls `kmain`. The kernel brings
// up COM1 (kernel/serial), then writes, one line each:
//
//     PAX first light
//     serial: 16550 at 0x3f8, 115200 8N1, scratch ok, loopback ok
//     boot: Limine <version>, base revision 6
//     boot: firmware bios | uefi64
//     mem: <entries> entries, <bytes> bytes usable
//     hhdm: 0x<offset>
//     frames: <T> usable, <L> below 1 MiB, <S> allocator, <F> free
//     halt
//
// and halts (kernel/panic, io.S's `cli; hlt`). tests/mpx1 asserts the
// transcript and proves the halt through QEMU's monitor; the frames line
// (px02, kernel/frames) is checked against the mem line by
// tests/mpx2-frames. Built `--target x86_64-unknown-none` on both
// tiers (tools/build-kernel). `member: false`: kmain_panic.lu,
// kmain_frames.lu, kmain_double_free.lu and kmain_free_unusable.lu
// beside it are kernels of their own.
use log
use serial
use boot_info
use frames
use panic

export fn kmain() {
    let st = serial.init()
    log.line("PAX first light")

    log.put("serial: 16550 at 0x3f8, 115200 8N1, scratch ")
    log.put(if st % 2 == 1 { "ok" } else { "FAILED" })
    log.put(", loopback ")
    log.put(if st / 2 % 2 == 1 { "ok" } else { "FAILED" })
    log.end()

    log.put("boot: ")
    loader_string(0)
    log.put(" ")
    loader_string(1)
    log.put(if boot_info.revision_ok() { ", base revision 6" } else { ", base revision NOT honoured" })
    log.end()

    log.put("boot: firmware ")
    log.put(boot_info.firmware_name(boot_info.firmware()))
    log.end()

    log.put("mem: ")
    log.dec(boot_info.memmap_count())
    log.put(" entries, ")
    log.dec(boot_info.usable_bytes() as int)
    log.put(" bytes usable")
    log.end()

    log.put("hhdm: ")
    log.hex(boot_info.hhdm())
    log.end()

    frames.report(frames.start())

    log.line("halt")
    panic.halt()
}

// The bootloader's name (0) or version (1), byte by byte; `?` when
// Limine gave no bootloader-info response.
fn loader_string(which: int) {
    var i = 0
    var b = boot_info.loader_byte(which, 0)
    if b < 0 {
        log.put("?")
    }
    while b >= 0 {
        log.put_byte(b)
        i = i + 1
        b = boot_info.loader_byte(which, i)
    }
}
