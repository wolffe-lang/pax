//! apic — the local APIC, mapped and set to pass the 8259 through
//! (kw10, M-PX2's timer).
//!
//! Measured (QEMU's monitor, `info lapic` and `info pic`, kasumi,
//! kw10): Limine hands over with the local APIC enabled (SVR 0x1ff) and
//! its LINT0 entry masked (LVT0 0x00018700: ExtINT, level, masked). An
//! 8259 request then never reaches the CPU: the master's IRR holds line
//! 0 forever and the kernel sleeps in HLT. A processor with an enabled
//! local APIC takes the 8259's INTR only through LINT0 programmed as
//! ExtINT and unmasked ("virtual wire": Intel SDM vol. 3A §11.5.1, the
//! LVT's delivery modes — ExtINT is always level-triggered — and the
//! mask bit 16). Globally disabling the APIC (IA32_APIC_BASE bit 11)
//! would pass INTR straight through as well, but the scheduler lane
//! wants the local APIC's timer and the SMP lanes its IPIs, so it stays
//! enabled.
//!
//! The APIC's registers are a 4 KiB page of memory-mapped I/O at the
//! physical base IA32_APIC_BASE names (bits 51:12; 0xfee00000 on every
//! machine PAX has met; SDM vol. 3A §11.4.1, §11.4.4). PAX's paging
//! maps no reserved memory (kernel/paging), so `start` maps that page
//! at DEVICE_VA, the first page of PML4 slot 352 (0xffffb00000000000,
//! outside the HHDM's 256, the scratch 320 and the image's 511), present,
//! writable, no-execute, with PCD and PWT set: uncached (PAT entry 3 at
//! its power-on value; SDM vol. 3A §11.12.3, §4.9.2). Each register is
//! one aligned 32-bit access (`read_volatile`/`write_volatile` of a
//! `u32`, kw07; SDM vol. 3A §11.4.1: 128-bit aligned registers,
//! accessed with 32-bit loads and stores).
//!
//! Registers used (offsets from the base, SDM vol. 3A Table 11-1): 0x20
//! the local APIC ID (bits 31:24), 0xf0 the spurious-interrupt vector
//! register (bit 8: software enable), 0x350 LVT LINT0; px76's tick
//! (kernel/timer) 0x320, 0x380, 0x390, 0x3e0 and the EOI 0xb0.
//!
//! **x2APIC at the handover (px76, R-px76-7 A).** A firmware may hand
//! over with IA32_APIC_BASE's EXTD (bit 10) set beside EN (bit 11): x2APIC
//! mode, where the MMIO page is not decoded and the same registers are
//! MSRs 0x800 + offset / 16 (SDM vol. 3A §11.12.1, Table 11-6), the ID
//! the whole of MSR 0x802 (§11.12.5.1) and the EOI a write of 0 to
//! 0x80b. `start` reads the mode once and `read`, `write` and `id` follow
//! it, so the tick and the MSI destination work in either; the APIC's
//! line is the same and x2APIC adds one line of its own. No Linux source;
//! no other kernel's source.

use log
use panic
use paging

extern "c" fn pax_apic_base() -> u64
extern "c" fn pax_rdmsr(msr: u64) -> u64
extern "c" fn pax_wrmsr(msr: u64, v: u64)

/// Where `start` maps the local APIC's page: PML4 slot 352's first page.
const DEVICE_VA: u64 = 0xffffb00000000000

/// LVT LINT0: ExtINT (delivery mode 0b111 in bits 10:8), level (bit 15),
/// unmasked (bit 16 clear), vector 0 (ignored for ExtINT).
const LINT0_EXTINT: u32 = 0x8700

/// LINT0's value as Limine left it (`start` records it).
var lint0_before: u64 = 0

/// px76: x2APIC mode, as `start` found it (IA32_APIC_BASE bits 10 and 11).
var x2mode: bool = false

/// The local APIC's physical base (IA32_APIC_BASE bits 51:12).
pub fn phys() -> u64 {
    // # Safety: cpu.S's RDMSR of IA32_APIC_BASE.
    let b = unsafe { pax_apic_base() }
    b & !0xfff & !(0xfff << 52)
}

/// Whether IA32_APIC_BASE's global enable (bit 11) is set.
pub fn enabled() -> bool {
    // # Safety: as `phys`.
    let b = unsafe { pax_apic_base() }
    ((b >> 11) & 1) == 1
}

/// Whether IA32_APIC_BASE says x2APIC mode (EXTD and EN, SDM vol. 3A
/// §11.12.1).
pub fn x2apic() -> bool {
    // # Safety: as `phys`.
    let b = unsafe { pax_apic_base() }
    (b >> 10) & 3 == 3
}

/// The register at `offset`: its MMIO word, or in x2APIC mode its MSR
/// (0x800 + offset / 16, the low 32 bits).
pub fn read(offset: u64) -> u64 {
    if unsafe { x2mode } {
        // # Safety: cpu.S's RDMSR of an x2APIC register (0x802-0x83f).
        return unsafe { pax_rdmsr(0x800 + offset / 16) } & 0xffffffff
    }
    // # Safety: DEVICE_VA maps the APIC's page once `start` has run;
    // offset < 4096, 16-aligned; one 32-bit access.
    let v = unsafe { ((DEVICE_VA + offset) as *u32).read_volatile() }
    v as u64
}

pub fn write(offset: u64, v: u32) {
    if unsafe { x2mode } {
        // # Safety: cpu.S's WRMSR of an x2APIC register (EOI: 0 only).
        unsafe { pax_wrmsr(0x800 + offset / 16, v as u64) }
        return
    }
    // # Safety: as `read`.
    unsafe { ((DEVICE_VA + offset) as *u32).write_volatile(v) }
}

/// This CPU's APIC ID: bits 31:24 of 0x20 in xAPIC mode, the whole MSR
/// 0x802 in x2APIC mode (SDM vol. 3A §11.12.5.1).
pub fn id() -> u64 {
    if unsafe { x2mode } { read(0x20) } else { read(0x20) >> 24 }
}

/// Map the APIC's page at DEVICE_VA in the structures at `pml4` (from
/// the frame allocator's frames: kernel/paging must have switched to them), and set
/// LINT0 to ExtINT, unmasked: the 8259's requests reach the CPU.
pub fn start(pml4: u64) {
    if !enabled() {
        panic.fail("apic: the local APIC is globally disabled; IA32_APIC_BASE", phys())
    }
    // # Safety: written once, interrupts off.
    unsafe { x2mode = x2apic() }
    let uncached: u64 = 24 // PWT (bit 3), PCD (bit 4)
    let n = paging.map(pml4, DEVICE_VA, phys(), paging.NX | paging.RW | uncached) else 9
    if n == 9 {
        panic.fail("apic: cannot map the local APIC's page at", DEVICE_VA)
    }
    // # Safety: the counter is written once, interrupts off.
    unsafe {
        lint0_before = read(0x350)
    }
    write(0x350, LINT0_EXTINT)
}

/// Write the APIC's line:
/// `apic: 0x<phys> at 0x<va>, id <n>, svr 0x<s>, lint0 0x<old> -> 0x<new>`.
pub fn report() {
    log.put("apic: ")
    log.hex(phys())
    log.put(" at ")
    log.hex(DEVICE_VA)
    log.put(", id ")
    log.dec(id() as int)
    log.put(", svr ")
    log.hex(read(0xf0))
    log.put(", lint0 ")
    // # Safety: a read of the recorded value; interrupts off.
    log.hex(unsafe { lint0_before })
    log.put(" -> ")
    log.hex(read(0x350))
    log.end()
    if unsafe { x2mode } {
        log.line("apic: x2APIC mode (IA32_APIC_BASE EXTD set at the handover): its registers by MSR")
    }
}
