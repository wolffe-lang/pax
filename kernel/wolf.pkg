// The PAX kernel's manifest. `asm` lists the assembly the kernel calls
// into (wolf assembles it for the kernel's target and refuses a call
// into anything off its roster, [abi.asm.roster]): io.S, the port I/O
// and the halt; cpu.S (px03), the control registers, EFER and INVLPG; isr.S
// (kw10), the interrupt trampolines, the descriptor tables' storage and
// LGDT/LTR/LIDT. The target
// is not set here: tools/build-kernel passes `--target
// x86_64-unknown-none`, so a build without the flag is a hosted one and
// is refused for want of a `main`.
pkg {
    name: "pax/kernel"
    version: "0.0.1"
    asm: ["../boot/io.S", "../boot/cpu.S", "../boot/isr.S", "../boot/sched.S"]
}
