//! socket — the socket system calls for AF_INET sockets: datagram
//! (px22) and stream (px23).
//!
//! What a static Linux program's UDP calls reach: `socket` (41),
//! `connect` (42), `accept` (43), `sendto` (44), `recvfrom` (45),
//! `bind` (49), `listen` (50), `getsockname` (51), `getpeername` (52),
//! `setsockopt` (54), `getsockopt` (55), `accept4` (288), and `read`
//! and `write` on a socket. glibc 2.39's `send` and `recv` are `sendto`
//! and `recvfrom` with no address; nothing the witnesses link calls
//! `sendmsg`, `recvmsg` or `shutdown`, which stay -ENOSYS.
//!
//! **A socket descriptor** is a descriptor of kernel/files whose open
//! file names one of kernel/udp's sockets: `dup` and a child's copy of
//! the table share the open file and so the socket, its port and its
//! queue; `O_NONBLOCK` is the open file's and `FD_CLOEXEC` the
//! descriptor's; the last close of the open file frees the socket
//! (kernel/files calls `udp.close`). `fstat` answers S_IFSOCK|0777,
//! `lseek` -ESPIPE, `ioctl` -ENOTTY.
//!
//! **An address** is a `struct sockaddr_in` (uapi `linux/in.h`), 16
//! bytes: the family (2, AF_INET) as the host's 16 bits, the port and
//! the address big-endian, eight bytes of zero.
//!
//! **What is refused, and with what** (each as Linux answered the
//! witness user/net/sockerr.c, `notes/px22/`): a family that is not
//! AF_INET -EAFNOSUPPORT; a type AF_INET has no sockets of here
//! (`SOCK_STREAM`, `SOCK_RAW`, `SOCK_RDM`, `SOCK_SEQPACKET`,
//! `SOCK_DCCP`, `SOCK_PACKET`) -ESOCKTNOSUPPORT, any other type
//! -EINVAL; a protocol that is not 0 or 17 -EPROTONOSUPPORT; `bind`
//! with under 16 bytes -EINVAL, a family in the address that is not
//! AF_INET -EAFNOSUPPORT, a socket that has a port -EINVAL, an address
//! that is not this station's -EADDRNOTAVAIL, a port held
//! -EADDRINUSE; `sendto` with no destination and no peer
//! -EDESTADDRREQ, over 65507 bytes -EMSGSIZE, to port 0 -EINVAL;
//! `getpeername` with no peer -ENOTCONN; `listen` and `accept`
//! -EOPNOTSUPP; an option or level PAX does not have -ENOPROTOOPT.
//! PAX's own, where Linux would go on: a datagram over 1472 bytes is
//! -EMSGSIZE (nothing here fragments), and one for a broadcast address
//! -EACCES (Linux's answer without `SO_BROADCAST`, an option PAX does
//! not have). A refusal PAX names is logged once a process
//! (`user: <name> pid <p> syscall <n>: refused: <why>, -<errno>`).
//!
//! **Options** (level 1, SOL_SOCKET; uapi `asm-generic/socket.h`):
//! `SO_RCVTIMEO_OLD` (20) set and read, a 16-byte `timeval`; `SO_TYPE`
//! (3) and `SO_ERROR` (4) read (2 and 0); `SO_ACCEPTCONN` (30, px24)
//! read: 1 for a stream socket that listens, else 0. Nothing else: no
//! witness asks.
//!
//! **Waiting.** `recvfrom` with nothing queued answers -EAGAIN under
//! `MSG_DONTWAIT` or `O_NONBLOCK`; otherwise it answers `files.WAIT`:
//! kernel/user rewinds the call and parks the thread, and a datagram's
//! arrival runs the call again (kernel/sched's `wake_pipes`). With a
//! receive timeout the first wait writes its deadline — now plus the
//! timeout's ticks — in the process's area, the thread is parked until
//! a datagram or that tick (`sched.block_pipe_until`), and the call
//! that finds the deadline passed answers -EAGAIN. PAX delivers no
//! signal, and no close can reach a socket a receive is parked on (a
//! process has one thread, and its own reference keeps the socket), so
//! these are the only ends a receive has.
//!
//! **Stream sockets** (px23; kernel/tcp's): `socket(AF_INET,
//! SOCK_STREAM, 0 or 6)`, `bind`, `listen` (50), `accept` (43) and
//! `accept4` (288; `SOCK_CLOEXEC` and `SOCK_NONBLOCK`, any other flag
//! -EINVAL), `connect`, `sendto`/`write`, `recvfrom`/`read`, `shutdown`
//! (48), `getsockname`, `getpeername`, `setsockopt` and `getsockopt`.
//! Each errno is the one Linux answered user/net/tcperr.c
//! (`notes/px23-tcp.md`): a protocol that is not TCP's
//! -EPROTONOSUPPORT, one over 255 -EINVAL; `accept` on a socket that
//! does not listen, `listen` and `bind` on one that is connected
//! -EINVAL; `connect` on one that is connected or listens -EISCONN;
//! not connected: `recv` and `getpeername` -ENOTCONN, `send` -EPIPE,
//! `shutdown` -ENOTCONN (a `how` over 2 -EINVAL first); after the
//! connection ended, the error it ended with once, then `send` -EPIPE
//! and `recv` 0. A write that answers -EPIPE is kernel/user's to turn
//! into SIGPIPE, as a pipe's (px17), unless `MSG_NOSIGNAL` is set.
//!
//! A stream call that cannot answer yet waits as a datagram receive
//! does (`files.WAIT`; kernel/tcp wakes every waiter on every change):
//! `accept` for a connection, `connect` for the handshake (the call run
//! again finds it done, refused or timed out), `recv` for a byte or
//! the end of the stream, `send` until every byte is in the send
//! buffer (what it has put there across waits is the process area's
//! word 13, a pipe write's too). Under `O_NONBLOCK` (`fcntl`, `accept4`
//! or `ioctl(FIONBIO)`) or `MSG_DONTWAIT` each answers -EAGAIN instead
//! (`connect` -EINPROGRESS), and nothing here can wait for more than
//! one socket: `poll` and `epoll` are not there.
//!
//! Stream options: `SO_REUSEADDR` (2), `SO_TYPE`, `SO_ERROR` (the error
//! a connection ended with, taken); at level 6 (IPPROTO_TCP, uapi
//! `linux/tcp.h`) `TCP_NODELAY` (1), `TCP_SYNCNT` (7; 1 to 255) and
//! `TCP_USER_TIMEOUT` (18, milliseconds). Every other -ENOPROTOOPT, by
//! name.
//!
//! **AF_UNIX path sockets** (px34): `socket(AF_UNIX, …)` and every call
//! here on a descriptor that names one go to kernel/files' `unix_*`,
//! which resolve its name in the tree; `sendto`, `recvfrom`, `read` and
//! `write` on one are kernel/files' as a socketpair's are.
//!
//! **What only root may do** (px45; `ip(7)`, `raw(7)`, measured on
//! Linux 7.2.8 as real root and as a user, px38's `priv` and px45's
//! `rights`): `bind` of a TCP or UDP port from 1 to 1023 by a process
//! that is not privileged (kernel/cred's `privileged`: effective user
//! id 0) is -EACCES, asked after the address is read and before
//! whether the port is taken; port 0 and 1024 and up are anyone's. A
//! raw socket is -EPERM to a user before PAX refuses its type by name.
//! **SO_PEERCRED** (17) on any socket is kernel/files' `peercred`: the
//! pid and effective ids of the peer, as `unix(7)` and `socket(7)` give
//! them (measured).
//!
//! Written from the man pages socket(2), bind(2), connect(2),
//! sendto(2), recvfrom(2), getsockname(2), getpeername(2),
//! getsockopt(2), listen(2), accept(2), shutdown(2), send(2), recv(2),
//! udp(7), tcp(7), ip(7), socket(7); the uapi headers `linux/in.h`,
//! `linux/tcp.h`, `linux/socket.h`, `linux/net.h`,
//! `asm-generic/socket.h`, `asm-generic/errno.h`; and black-box strace
//! of the witnesses on Linux. No Linux source; no other kernel's or
//! libc's source.

use arp
use cred
use files
use ip
use log
use sched
use tcp
use timer
use uaccess
use udp

const AF_UNSPEC: u64 = 0
const AF_UNIX: u64 = 1 // px34
const AF_INET: u64 = 2
const SOCK_STREAM: u64 = 1
const SOCK_DGRAM: u64 = 2
const SOCK_TYPE_MASK: u64 = 0xf
const SOCK_CLOEXEC: u64 = 0x80000 // O_CLOEXEC
const SOCK_NONBLOCK: u64 = 0x800 // O_NONBLOCK
const O_RDWR: u64 = 2
const ADDR: u64 = 16 // sizeof(struct sockaddr_in)
const DATAGRAM_MAX: u64 = 65507 // 65535 less the two headers

const MSG_PEEK: u64 = 0x2
const MSG_TRUNC: u64 = 0x20
const MSG_DONTWAIT: u64 = 0x40

const MSG_OOB: u64 = 0x1
const SOL_SOCKET: u64 = 1
const SO_REUSEADDR: u64 = 2
const TCP_NODELAY: u64 = 1 // uapi linux/tcp.h
const TCP_SYNCNT: u64 = 7
const TCP_USER_TIMEOUT: u64 = 18
const SO_TYPE: u64 = 3
const SO_ERROR: u64 = 4
const SO_RCVTIMEO_OLD: u64 = 20
const SO_ACCEPTCONN: u64 = 30 // px24: whether the socket listens (lobo asks its inherited listeners)
const SO_PEERCRED: u64 = 17 // px45: uapi asm-generic/socket.h
const SOCK_RAW: u64 = 3 // px45
const EPERM: u64 = 1 // px45
/// px45: the first port anyone may bind (`ip(7)`'s
/// net.ipv4.ip_unprivileged_port_start, 1024 on Linux, measured; fixed
/// on PAX and reported by /proc/sys/net/ipv4/ip_unprivileged_port_start).
pub const UNPRIVILEGED_PORT_START: u64 = 1024

// errnos (uapi asm-generic/errno-base.h, errno.h)
const EBADF: u64 = 9
const EAGAIN: u64 = 11
const EACCES: u64 = 13
const EFAULT: u64 = 14
const EINVAL: u64 = 22
const EPIPE: u64 = 32
const EDOM: u64 = 33
const ENOTSOCK: u64 = 88
const EMSGSIZE: u64 = 90
const ENOPROTOOPT: u64 = 92
const EPROTONOSUPPORT: u64 = 93
const ESOCKTNOSUPPORT: u64 = 94
const EOPNOTSUPP: u64 = 95
const EAFNOSUPPORT: u64 = 97
const ENOBUFS: u64 = 105
const ENOTCONN: u64 = 107
const EALREADY: u64 = 114
const EINPROGRESS: u64 = 115

// The process area's words this module keeps (kernel/sched's
// `proc_area`; 3 is the refusal word kernel/vm, kernel/files and
// kernel/process share).
const A_REFUSAL: u64 = 3
// words 13 and 14 were px23's count of bytes a waiting stream send has
// queued and px22's tick a waiting receive gives up at: px24 keeps both
// per thread (kernel/sched's `self_done` and `self_until`), since two
// threads of one process may each wait.
const A_NAMED: u64 = 15 // the refusals already logged, a bit each
const A_DETAIL: u64 = 144 // two words: the numbers a refusal's line names

// Refusal codes (64 and up: kernel/vm has 1-15, kernel/files 16-31,
// kernel/process 32-63).
const R_FAMILY: u64 = 64
const R_TYPE: u64 = 65
const R_PROTOCOL: u64 = 66
const R_OPTION: u64 = 67
const R_FRAGMENT: u64 = 68
const R_BROADCAST: u64 = 69
const R_UNIX: u64 = 70
const R_STREAM_PROTOCOL: u64 = 71
const R_SHUTDOWN: u64 = 72
const R_OOB: u64 = 73

/// The first refusal code that is this module's.
pub const REFUSALS: u64 = 64

// The PIT's tick in nanoseconds (kernel/timer: 1193182 / 11932 Hz).
const NS_PER_TICK: u64 = 10000151

fn neg(e: u64) -> u64 {
    0xffffffffffffffff - e + 1
}

fn get(a: u64, i: u64) -> u64 {
    // # Safety: `a` is a process area (sched.proc_area), 512 words; i < 512.
    unsafe { ((a + i * 8) as *u64).read_volatile() }
}

fn put(a: u64, i: u64, v: u64) {
    // # Safety: as `get`.
    unsafe { ((a + i * 8) as *u64).write_volatile(v) }
}

/// A refusal code's name ("" when not this module's).
pub fn why(r: u64) -> str {
    if r == R_FAMILY {
        return "a socket of a family PAX has none of: family"
    }
    if r == R_TYPE {
        return "an AF_INET socket that is neither a datagram nor a stream socket: type"
    }
    if r == R_STREAM_PROTOCOL {
        return "a stream socket of a protocol that is not TCP: protocol"
    }
    if r == R_SHUTDOWN {
        return "shutdown of a datagram socket: how"
    }
    if r == R_OOB {
        return "out-of-band data on a stream socket (PAX reads no urgent pointer): flags"
    }
    if r == R_PROTOCOL {
        return "a datagram socket of a protocol that is not UDP: protocol"
    }
    if r == R_OPTION {
        return "a socket option PAX does not have: level and option"
    }
    if r == R_FRAGMENT {
        return "a datagram over 1472 bytes (PAX does not fragment): bytes"
    }
    if r == R_BROADCAST {
        return "a datagram for a broadcast address (no SO_BROADCAST): address"
    }
    if r == R_UNIX {
        return "an AF_UNIX socketpair's end, which has no name or options: call"
    }
    ""
}

/// The numbers a refusal's line ends with (kernel/user prints them
/// after `why`): ` <a>` or ` <a> <b>`.
pub fn detail(a: u64, r: u64) {
    log.put(" ")
    if r == R_BROADCAST {
        arp.put_ip(get(a, A_DETAIL))
        return
    }
    log.dec((get(a, A_DETAIL) & 0x7fffffff) as int)
    if r == R_OPTION {
        log.put(" ")
        log.dec((get(a, A_DETAIL + 1) & 0x7fffffff) as int)
    }
}

/// Answer -`e` for a refusal PAX names; the first of its kind in this
/// process leaves its code and numbers for kernel/user's line.
fn refuse(a: u64, code: u64, e: u64, d0: u64, d1: u64) -> u64 {
    let bit: u64 = 1 << (code - REFUSALS)
    if get(a, A_NAMED) & bit == 0 {
        put(a, A_NAMED, get(a, A_NAMED) | bit)
        put(a, A_REFUSAL, code)
        put(a, A_DETAIL, d0)
        put(a, A_DETAIL + 1, d1)
    }
    neg(e)
}

/// Whether descriptor `fd` is an AF_INET socket, of either type.
pub fn is_inet(a: u64, fd: u64) -> bool {
    let k = files.sock_kind(a, fd)
    k == files.INET || k == files.TCP
}

fn is_stream(a: u64, fd: u64) -> bool {
    files.sock_kind(a, fd) == files.TCP
}

/// The tick the running receive gives up at; 0 when it has no deadline
/// (kernel/user chooses `block_pipe_until` by it).
pub fn deadline(_a: u64) -> u64 {
    sched.self_until()
}

/// Descriptor `fd`'s socket: `(0, s)`, or `(-errno, 0)`: -EBADF, or
/// -ENOTSOCK for what is no socket; an AF_UNIX pair's end is refused by
/// name (`nr`, the call's number, for the line), -EOPNOTSUPP.
fn sock(a: u64, fd: u64, nr: u64) -> (u64, u64) {
    let k = files.sock_kind(a, fd)
    if k == files.INET {
        return (0, files.inet_sock(a, fd))
    }
    if k == files.NOT_OPEN {
        return (neg(EBADF), 0)
    }
    if k == files.UNIX {
        return (refuse(a, R_UNIX, EOPNOTSUPP, nr, 0), 0)
    }
    (neg(ENOTSOCK), 0)
}

/// `socket(domain, type, protocol)`: the descriptor or -errno.
pub fn socket(a: u64, domain: u64, ty: u64, proto: u64) -> u64 {
    if domain == AF_UNIX {
        return files.unix_socket(a, ty, proto) // px34
    }
    if domain != AF_INET {
        return refuse(a, R_FAMILY, EAFNOSUPPORT, domain, 0)
    }
    let base = ty & SOCK_TYPE_MASK
    if ty & !(SOCK_TYPE_MASK | SOCK_CLOEXEC | SOCK_NONBLOCK) != 0 || base == 0 || base == 7 || base == 8 || base == 9 || base > 10 {
        // No such type (uapi linux/net.h: 1-6 and 10).
        return refuse(a, R_TYPE, EINVAL, ty, 0)
    }
    if base == SOCK_RAW && !cred.privileged(a) {
        return neg(EPERM) // px45: `raw(7)`, measured: a user is told -EPERM before PAX refuses the type by name
    }
    if base == SOCK_STREAM {
        // px23: a stream socket is one of kernel/tcp's blocks.
        if proto > 255 {
            return refuse(a, R_STREAM_PROTOCOL, EINVAL, proto, 0)
        }
        if proto != 0 && proto != tcp.PROTOCOL {
            return refuse(a, R_STREAM_PROTOCOL, EPROTONOSUPPORT, proto, 0)
        }
        let c = tcp.open()
        if c == tcp.CONNS {
            return neg(ENOBUFS)
        }
        let sfd = files.tcp_open(a, c, O_RDWR | (ty & (SOCK_CLOEXEC | SOCK_NONBLOCK)))
        if sfd >= 0x8000000000000000 {
            tcp.close(c)
        }
        return sfd
    }
    if base != SOCK_DGRAM {
        return refuse(a, R_TYPE, ESOCKTNOSUPPORT, base, 0)
    }
    if proto != 0 && proto != udp.PROTOCOL {
        return refuse(a, R_PROTOCOL, EPROTONOSUPPORT, proto, 0)
    }
    let s = udp.open()
    if s == udp.SOCKS {
        return neg(ENOBUFS)
    }
    let fd = files.inet_open(a, s, O_RDWR | (ty & (SOCK_CLOEXEC | SOCK_NONBLOCK)))
    if fd >= 0x8000000000000000 {
        udp.close(s)
    }
    fd
}

/// The `struct sockaddr_in` of `len` bytes at user `addr`: `(0,
/// address, port)`, or `(-errno, 0, 0)`: -EINVAL under 16 bytes,
/// -EFAULT, -EAFNOSUPPORT for a family that is not AF_INET.
fn addr_in(pml4: u64, addr: u64, len: u64) -> (u64, u64, u64) {
    if len < ADDR {
        return (neg(EINVAL), 0, 0)
    }
    if !uaccess.readable(pml4, addr, ADDR) {
        return (neg(EFAULT), 0, 0)
    }
    if uaccess.get(pml4, addr, 2) != AF_INET {
        return (neg(EAFNOSUPPORT), 0, 0)
    }
    let port = uaccess.get(pml4, addr + 2, 1) << 8 | uaccess.get(pml4, addr + 3, 1)
    let ip4 = uaccess.get(pml4, addr + 4, 1) << 24 | uaccess.get(pml4, addr + 5, 1) << 16 | uaccess.get(pml4, addr + 6, 1) << 8 | uaccess.get(pml4, addr + 7, 1)
    (0, ip4, port)
}

/// Whether a `struct sockaddr_in` can be written at user `addr` with its
/// length at `lenp` (getsockname(2)'s value-result pair): 0, or -errno.
fn addr_room(pml4: u64, addr: u64, lenp: u64) -> u64 {
    if !uaccess.readable(pml4, lenp, 4) || !uaccess.writable(pml4, lenp, 4) {
        return neg(EFAULT)
    }
    let cap = uaccess.get(pml4, lenp, 4)
    if cap >= 0x80000000 {
        return neg(EINVAL)
    }
    let n = if cap < ADDR { cap } else { ADDR }
    if !uaccess.writable(pml4, addr, n) {
        return neg(EFAULT)
    }
    0
}

/// Write `ip4`:`port` as a `struct sockaddr_in` at user `addr`, cut to
/// the length at `lenp`, and the whole length (16) there (checked by
/// `addr_room`).
fn addr_out(pml4: u64, addr: u64, lenp: u64, ip4: u64, port: u64) {
    let cap = uaccess.get(pml4, lenp, 4)
    var i: u64 = 0
    while i < ADDR && i < cap {
        var b: u64 = 0
        if i == 0 {
            b = AF_INET
        } else if i == 2 {
            b = port >> 8
        } else if i == 3 {
            b = port & 0xff
        } else if i >= 4 && i < 8 {
            b = (ip4 >> ((7 - i) * 8)) & 0xff
        }
        uaccess.put(pml4, addr + i, b, 1)
        i += 1
    }
    uaccess.put(pml4, lenp, ADDR, 4)
}

fn errno_of(e: u64) -> u64 {
    if e == 0 { 0 } else { neg(e) }
}

/// px34: whether descriptor `fd` is an AF_UNIX path socket.
fn is_path(a: u64, fd: u64) -> bool {
    files.sock_kind(a, fd) == files.PATH
}

/// px45: whether the process may bind `port` (`ip(7)`; measured: a
/// port below 1024 is the privileged's, -EACCES to anyone else, asked
/// before whether it is taken; port 0 asks for any free one).
fn may_bind(a: u64, port: u64) -> bool {
    port == 0 || port >= UNPRIVILEGED_PORT_START || cred.privileged(a)
}

/// `bind(fd, addr, len)`.
pub fn bind(a: u64, pml4: u64, fd: u64, addr: u64, len: u64) -> u64 {
    if is_path(a, fd) {
        return files.unix_bind(a, pml4, fd, addr, len) // px34
    }
    if is_stream(a, fd) {
        let (se, sip, sport) = addr_in(pml4, addr, len)
        if se != 0 {
            return se
        }
        if !may_bind(a, sport) {
            return neg(EACCES)
        }
        return errno_of(tcp.bind(files.inet_sock(a, fd), sip, sport))
    }
    let (e, s) = sock(a, fd, 49)
    if e != 0 {
        return e
    }
    let (ae, ip4, port) = addr_in(pml4, addr, len)
    if ae != 0 {
        return ae
    }
    if !may_bind(a, port) {
        return neg(EACCES)
    }
    errno_of(udp.bind(s, ip4, port))
}

/// `connect(fd, addr, len)`: the default peer; AF_UNSPEC forgets it. On
/// a stream socket: the handshake, waited for.
pub fn connect(a: u64, pml4: u64, fd: u64, addr: u64, len: u64) -> u64 {
    if is_path(a, fd) {
        return files.unix_connect(a, pml4, fd, addr, len) // px34
    }
    if is_stream(a, fd) {
        let (se, sip, sport) = addr_in(pml4, addr, len)
        if se != 0 {
            return se
        }
        if files.nonblocking(a, fd) && tcp.connecting(files.inet_sock(a, fd)) {
            return neg(EALREADY) // px24: connect(2), a non-blocking socket whose connect is under way
        }
        let r = tcp.connect(files.inet_sock(a, fd), sip, sport)
        if r == tcp.PENDING {
            if files.nonblocking(a, fd) {
                return neg(EINPROGRESS)
            }
            return files.WAIT
        }
        return errno_of(r)
    }
    let (e, s) = sock(a, fd, 42)
    if e != 0 {
        return e
    }
    if len < 2 {
        return neg(EINVAL)
    }
    if !uaccess.readable(pml4, addr, 2) {
        return neg(EFAULT)
    }
    if uaccess.get(pml4, addr, 2) == AF_UNSPEC {
        udp.disconnect(s)
        return 0
    }
    let (ae, ip4, port) = addr_in(pml4, addr, len)
    if ae != 0 {
        return ae
    }
    errno_of(udp.connect(s, ip4, port))
}

/// `sendto(fd, buf, n, flags, addr, len)` on an AF_INET socket, and
/// `write` (no flags, no address): `n`, or -errno. A datagram socket
/// reads no flag; a stream socket's are `stream_send`'s.
pub fn sendto(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, flags: u64, addr: u64, len: u64) -> u64 {
    if is_stream(a, fd) {
        return stream_send(a, pml4, fd, buf, n, flags)
    }
    let (e, s) = sock(a, fd, 44)
    if e != 0 {
        return e
    }
    var ip4: u64 = 0
    var port: u64 = 0
    let named = addr != 0
    if named {
        let (ae, i4, p) = addr_in(pml4, addr, len)
        if ae != 0 {
            return ae
        }
        ip4 = i4
        port = p
    } else {
        let (connected, pa, pp) = udp.peer(s)
        if !connected {
            return neg(udp.EDESTADDRREQ)
        }
        ip4 = pa
        port = pp
    }
    if n > DATAGRAM_MAX {
        return neg(EMSGSIZE)
    }
    if port == 0 {
        return neg(EINVAL)
    }
    if ip.is_broadcast(ip4) {
        return refuse(a, R_BROADCAST, EACCES, ip4, 0)
    }
    if n > udp.DATA_MAX {
        return refuse(a, R_FRAGMENT, EMSGSIZE, n, 0)
    }
    let r = udp.send(s, pml4, buf, n, true, ip4, port)
    if r != 0 {
        return neg(r)
    }
    n
}

/// `recvfrom(fd, buf, n, flags, addr, lenp)` on an AF_INET socket, and
/// `read` (no flags, no address): the bytes copied (the datagram's
/// whole length under MSG_TRUNC), -errno, or `files.WAIT`.
pub fn recvfrom(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, flags: u64, addr: u64, lenp: u64) -> u64 {
    if is_stream(a, fd) {
        if flags & MSG_OOB != 0 {
            return refuse(a, R_OOB, EINVAL, flags, 0)
        }
        let (got, re) = tcp.recv(files.inet_sock(a, fd), pml4, buf, n, flags & MSG_PEEK != 0)
        if re != 0 {
            return neg(re)
        }
        if got == tcp.EMPTY {
            if n == 0 {
                return 0
            }
            if flags & MSG_DONTWAIT != 0 || files.nonblocking(a, fd) {
                return neg(EAGAIN)
            }
            return files.WAIT
        }
        return got
    }
    let (e, s) = sock(a, fd, 45)
    if e != 0 {
        return e
    }
    let wants = addr != 0 && lenp != 0
    if wants {
        let ar = addr_room(pml4, addr, lenp)
        if ar != 0 {
            sched.set_self_until(0)
            return ar
        }
    }
    let (got, src, sport, whole) = udp.recv(s, pml4, buf, n, flags & MSG_PEEK != 0)
    if got == udp.EMPTY {
        if flags & MSG_DONTWAIT != 0 || files.nonblocking(a, fd) {
            sched.set_self_until(0)
            return neg(EAGAIN)
        }
        let t = udp.timeout(s)
        if t != 0 {
            let d = sched.self_until()
            let now = timer.ticks()
            if d == 0 {
                sched.set_self_until(now + t)
            } else if now >= d {
                sched.set_self_until(0)
                return neg(EAGAIN)
            }
        }
        return files.WAIT
    }
    sched.set_self_until(0)
    if got >= 0x8000000000000000 {
        return got
    }
    if wants {
        addr_out(pml4, addr, lenp, src, sport)
    }
    if flags & MSG_TRUNC != 0 { whole } else { got }
}

/// `getsockname(fd, addr, lenp)` (`peer` false) and `getpeername`.
pub fn getname(a: u64, pml4: u64, fd: u64, addr: u64, lenp: u64, peer: bool) -> u64 {
    if is_path(a, fd) {
        return files.unix_getname(a, pml4, fd, addr, lenp, peer) // px34
    }
    if is_stream(a, fd) {
        let c = files.inet_sock(a, fd)
        var sip: u64 = 0
        var sport: u64 = 0
        if peer {
            let (connected, pa, pp) = tcp.peer(c)
            if !connected {
                return neg(ENOTCONN)
            }
            sip = pa
            sport = pp
        } else {
            let (la, lp) = tcp.name(c)
            sip = la
            sport = lp
        }
        let sr = addr_room(pml4, addr, lenp)
        if sr != 0 {
            return sr
        }
        addr_out(pml4, addr, lenp, sip, sport)
        return 0
    }
    let (e, s) = sock(a, fd, if peer { 52 } else { 51 })
    if e != 0 {
        return e
    }
    var ip4: u64 = 0
    var port: u64 = 0
    if peer {
        let (connected, pa, pp) = udp.peer(s)
        if !connected {
            return neg(ENOTCONN)
        }
        ip4 = pa
        port = pp
    } else {
        let (la, lp) = udp.name(s)
        ip4 = la
        port = lp
    }
    let ar = addr_room(pml4, addr, lenp)
    if ar != 0 {
        return ar
    }
    addr_out(pml4, addr, lenp, ip4, port)
    0
}

/// `setsockopt(fd, level, option, value, len)`: SO_RCVTIMEO_OLD.
pub fn setsockopt(a: u64, pml4: u64, fd: u64, level: u64, option: u64, value: u64, len: u64) -> u64 {
    if is_path(a, fd) {
        return files.unix_setsockopt(a) // px34
    }
    if is_stream(a, fd) {
        let o = stream_option(level, option)
        if o == NO_OPTION {
            return refuse(a, R_OPTION, ENOPROTOOPT, level, option)
        }
        if len < 4 || len >= 0x80000000 {
            return neg(EINVAL)
        }
        if !uaccess.readable(pml4, value, 4) {
            return neg(EFAULT)
        }
        let v = uaccess.get(pml4, value, 4)
        if o == tcp.O_SYNCNT && (v < 1 || v > 255) {
            return neg(EINVAL)
        }
        if o == tcp.O_USER_TIMEOUT && v >= 0x80000000 {
            return neg(EINVAL)
        }
        tcp.set_option(files.inet_sock(a, fd), o, v)
        return 0
    }
    let (e, s) = sock(a, fd, 54)
    if e != 0 {
        return e
    }
    if level != SOL_SOCKET || option != SO_RCVTIMEO_OLD {
        return refuse(a, R_OPTION, ENOPROTOOPT, level, option)
    }
    if len < 16 {
        return neg(EINVAL)
    }
    if !uaccess.readable(pml4, value, 16) {
        return neg(EFAULT)
    }
    let sec = uaccess.get64(pml4, value)
    let usec = uaccess.get64(pml4, value + 8)
    if usec >= 1000000 || sec >= 0x8000000000000000 {
        return neg(EDOM)
    }
    // Past about 49 days the wait is for good in all but name.
    let capped = if sec < 0x400000 { sec } else { 0x400000 }
    let ns = capped * 1000000000 + usec * 1000
    // The tick after: a partial tick never shortens a wait.
    let ticks = if ns == 0 { 0 } else { (ns + NS_PER_TICK - 1) / NS_PER_TICK + 1 }
    udp.set_timeout(s, ticks, sec, usec)
    0
}

/// `getsockopt(fd, level, option, value, lenp)`: SO_TYPE, SO_ERROR,
/// SO_RCVTIMEO_OLD.
pub fn getsockopt(a: u64, pml4: u64, fd: u64, level: u64, option: u64, value: u64, lenp: u64) -> u64 {
    if level == SOL_SOCKET && option == SO_PEERCRED {
        return files.peercred(a, pml4, fd, value, lenp) // px45: every kind of socket
    }
    if is_path(a, fd) {
        return files.unix_getsockopt(a, pml4, fd, level, option, value, lenp) // px34
    }
    if is_stream(a, fd) {
        let c = files.inet_sock(a, fd)
        let o = stream_option(level, option)
        let plain = level == SOL_SOCKET && (option == SO_TYPE || option == SO_ERROR || option == SO_ACCEPTCONN)
        if o == NO_OPTION && !plain {
            return refuse(a, R_OPTION, ENOPROTOOPT, level, option)
        }
        if !uaccess.readable(pml4, lenp, 4) || !uaccess.writable(pml4, lenp, 4) {
            return neg(EFAULT)
        }
        let scap = uaccess.get(pml4, lenp, 4)
        if scap >= 0x80000000 {
            return neg(EINVAL)
        }
        let sn = if scap < 4 { scap } else { 4 }
        if !uaccess.writable(pml4, value, sn) {
            return neg(EFAULT)
        }
        var sv: u64 = 0
        if o != NO_OPTION {
            sv = tcp.option(c, o)
        } else if option == SO_TYPE {
            sv = SOCK_STREAM
        } else if option == SO_ACCEPTCONN {
            sv = if tcp.state(c) == tcp.LISTEN { 1 } else { 0 }
        } else {
            sv = tcp.take_error(c)
        }
        uaccess.put(pml4, value, sv, sn)
        uaccess.put(pml4, lenp, sn, 4)
        return 0
    }
    let (e, s) = sock(a, fd, 55)
    if e != 0 {
        return e
    }
    if level != SOL_SOCKET || (option != SO_TYPE && option != SO_ERROR && option != SO_RCVTIMEO_OLD && option != SO_ACCEPTCONN) {
        return refuse(a, R_OPTION, ENOPROTOOPT, level, option)
    }
    if !uaccess.readable(pml4, lenp, 4) || !uaccess.writable(pml4, lenp, 4) {
        return neg(EFAULT)
    }
    let cap = uaccess.get(pml4, lenp, 4)
    if cap >= 0x80000000 {
        return neg(EINVAL)
    }
    if option == SO_RCVTIMEO_OLD {
        if cap < 16 {
            return neg(EINVAL)
        }
        if !uaccess.writable(pml4, value, 16) {
            return neg(EFAULT)
        }
        let (sec, usec) = udp.timeval(s)
        uaccess.put(pml4, value, sec, 8)
        uaccess.put(pml4, value + 8, usec, 8)
        uaccess.put(pml4, lenp, 16, 4)
        return 0
    }
    let n = if cap < 4 { cap } else { 4 }
    if !uaccess.writable(pml4, value, n) {
        return neg(EFAULT)
    }
    uaccess.put(pml4, value, if option == SO_TYPE { SOCK_DGRAM } else { 0 }, n)
    uaccess.put(pml4, lenp, n, 4)
    0
}

/// `listen(fd, backlog)`: a stream socket takes connections from now
/// on; a datagram socket has none to take.
pub fn listen(a: u64, fd: u64, backlog: u64) -> u64 {
    if is_path(a, fd) {
        return files.unix_listen(a, fd, backlog) // px34
    }
    if is_stream(a, fd) {
        // A negative backlog is as large as one can be (listen(2)).
        return errno_of(tcp.listen(files.inet_sock(a, fd), backlog & 0x7fffffff))
    }
    let (e, _s) = sock(a, fd, 50)
    if e != 0 {
        return e
    }
    neg(EOPNOTSUPP)
}

/// `accept(fd, addr, lenp)` and `accept4(…, flags)` (`nr` the call's
/// number): the next established connection of a listening stream
/// socket as a descriptor of its own, its peer's address written when
/// asked for; `files.WAIT` (or -EAGAIN) while there is none.
pub fn accept(a: u64, pml4: u64, fd: u64, addr: u64, lenp: u64, flags: u64, nr: u64) -> u64 {
    if is_path(a, fd) {
        return files.unix_accept(a, pml4, fd, addr, lenp, flags) // px34
    }
    if !is_stream(a, fd) {
        let (e, _s) = sock(a, fd, nr)
        if e != 0 {
            return e
        }
        return neg(EOPNOTSUPP)
    }
    if flags & !(SOCK_CLOEXEC | SOCK_NONBLOCK) != 0 {
        return neg(EINVAL)
    }
    let l = files.inet_sock(a, fd)
    if tcp.state(l) != tcp.LISTEN {
        return neg(EINVAL)
    }
    let wants = addr != 0 && lenp != 0
    if wants {
        let ar = addr_room(pml4, addr, lenp)
        if ar != 0 {
            return ar
        }
    }
    let c = tcp.accept(l)
    if c == tcp.EMPTY {
        if files.nonblocking(a, fd) {
            return neg(EAGAIN)
        }
        return files.WAIT
    }
    let nfd = files.tcp_open(a, c, O_RDWR | flags)
    if nfd >= 0x8000000000000000 {
        tcp.close(c)
        return nfd
    }
    if wants {
        let (_connected, pa, pp) = tcp.peer(c)
        addr_out(pml4, addr, lenp, pa, pp)
    }
    nfd
}

/// `shutdown(fd, how)` on a stream socket.
pub fn shutdown(a: u64, fd: u64, how: u64) -> u64 {
    if is_path(a, fd) {
        return files.unix_shutdown(a, fd, how) // px34
    }
    if !is_stream(a, fd) {
        let (e, _s) = sock(a, fd, 48)
        if e != 0 {
            return e
        }
        return refuse(a, R_SHUTDOWN, EOPNOTSUPP, how, 0)
    }
    if how > 2 {
        return neg(EINVAL)
    }
    errno_of(tcp.shutdown(files.inet_sock(a, fd), how))
}

/// What `stream_option` answers for an option a stream socket has not.
const NO_OPTION: u64 = 99

/// kernel/tcp's name (`tcp.O_*`) for a stream socket's option, or
/// NO_OPTION.
fn stream_option(level: u64, option: u64) -> u64 {
    if level == SOL_SOCKET && option == SO_REUSEADDR {
        return tcp.O_REUSE
    }
    if level == tcp.PROTOCOL {
        if option == TCP_NODELAY {
            return tcp.O_NODELAY
        }
        if option == TCP_SYNCNT {
            return tcp.O_SYNCNT
        }
        if option == TCP_USER_TIMEOUT {
            return tcp.O_USER_TIMEOUT
        }
    }
    NO_OPTION
}

/// `send`, `sendto` and `write` on a stream socket: every one of the
/// `n` bytes at `buf` into the send buffer, waiting while it is full
/// (`flags`: MSG_DONTWAIT). `n`; what was queued before an error or
/// before -EAGAIN; `files.EPIPE_R` for -EPIPE (kernel/user decides
/// SIGPIPE); -errno; or `files.WAIT`.
pub fn stream_send(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, flags: u64) -> u64 {
    if flags & MSG_OOB != 0 {
        return refuse(a, R_OOB, EOPNOTSUPP, flags, 0)
    }
    let c = files.inet_sock(a, fd)
    var done = sched.self_done()
    if done > n {
        done = 0
    }
    if done == 0 && n > 0 && !uaccess.readable(pml4, buf, n) {
        return neg(EFAULT)
    }
    let (taken, e) = tcp.send(c, pml4, buf + done, n - done)
    if e != 0 {
        sched.set_self_done(0)
        if done > 0 {
            return done
        }
        return if e == EPIPE { files.EPIPE_R } else { neg(e) }
    }
    done += taken
    if done == n {
        sched.set_self_done(0)
        return n
    }
    if flags & MSG_DONTWAIT != 0 || files.nonblocking(a, fd) {
        sched.set_self_done(0)
        return if done > 0 { done } else { neg(EAGAIN) }
    }
    sched.set_self_done(done)
    files.WAIT
}
