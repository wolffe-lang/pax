//! procfs — the files of `/proc` and `/sys` lobo reads (px34), and
//! the directories they sit in: fixed text where PAX has no fact to
//! give, said so here file by file. Below kernel/files, which resolves
//! their paths, opens them and reads them; this module only names them
//! and makes their text.
//!
//! **The entries** are a fixed table (`ENTRIES`), each a name, the
//! entry it sits in (or the root), whether it is a directory, its mode
//! and the size `stat` answers. Two file systems, as on Linux: `/proc`
//! (procfs: every file's size 0) and `/sys` (sysfs, where a regular
//! attribute's size is 4096, and cgroupfs at `/sys/fs/cgroup`, where it
//! is 0): measured in `px13-ubuntu`, `notes/px34/linux/witness/`.
//!
//! **The text** is made when a file is opened (`make`), into a frame the
//! open file holds and gives back at its last close (kernel/files), so
//! a reader in pieces of 32, 32, 64, 128 … bytes — glibc's and lobo's
//! way — reads one text, never two halves of two. What each says:
//!
//! - `/proc/self/status` (`proc_pid_status(5)`): Linux 7.2.8's fields
//!   in its order and format; PAX's values where it keeps them — Name
//!   (the thread's, or the program's), Umask, State `R (running)` (the
//!   reader is running), Tgid, Pid, PPid, Uid, Gid and Groups (px39: the
//!   process's own, kernel/cred; 0 and no group before), FDSize (the
//!   table's size), NStgid and NSpid as Tgid and Pid, Threads, SigBlk
//!   (the thread's mask), SigIgn and SigCgt (the process's actions),
//!   VmRSS, VmHWM, VmSize, VmPeak, RssAnon and VmData the pages the
//!   process maps, VmPTE its page tables' frames (px25) — and fixed
//!   values where it keeps none: 0 for
//!   TracerPid, Ngid, Kthread, VmLck, VmPin, RssFile, RssShmem, VmLib,
//!   VmSwap, HugetlbPages, CoreDumping, the pending sets, NoNewPrivs,
//!   Seccomp and the context
//!   switches; NSpgid and NSsid 1; VmStk 132 kB and VmExe 0 kB; one CPU
//!   (`Cpus_allowed: 1`, `Cpus_allowed_list: 0`) and one memory node.
//!   The capability sets (px39, ruling #75 R9): PAX keeps none — a
//!   process is root by its ids, not by capability — and prints what
//!   Linux prints for a process with the same ids (kernel/cred's `cap`).
//! - px39: `/proc/self/setgroups` and `/proc/<pid>/setgroups`: `allow`
//!   (`user_namespaces(7)`: PAX has no user namespace, so the call is
//!   never switched off; mode 0644, measured).
//! - `/proc/self/cgroup`: `0::/` (cgroup v2, the root: `cgroups(7)`).
//! - `/proc/sys/vm/overcommit_memory`: `0` (the heuristic, Linux's
//!   default; glibc's malloc reads it).
//! - `/sys/fs/cgroup/cgroup.controllers`: `cpu` — fixed: the one
//!   controller whose file lobo reads (Linux's lists every controller
//!   the hierarchy has; PAX has none, and says the one it answers for).
//! - `/sys/fs/cgroup/cpu.max`: `max 100000` (no limit, `cgroups(7)`).
//! - `/sys/devices/system/cpu/online`: `0` (one CPU, `sysfs(5)`'s list
//!   format).
//!
//! - px25: `/proc/<pid>/status` for every process not yet reaped, and
//!   `/proc` lists their numbers after its fixed names (Linux's order):
//!   the same fields as `self`'s, of that process's leader — Name, its
//!   parent, its threads, the leader's mask, its resident pages — with
//!   `State` `S (sleeping)` (PAX keeps no finer state for a reader that
//!   is not the process itself: fixed, said so) or `Z (zombie)`.
//! - px25: the test's census files, Linux's format with PAX's values:
//!   `/proc/meminfo` (MemTotal, MemFree, MemAvailable only: the usable
//!   frames, the free ones, the free ones again), `/proc/sys/fs/file-nr`
//!   (open files in the table, 0, the table's size) and
//!   `/proc/net/sockstat` (`sockets: used` the AF_UNIX sockets live,
//!   `TCP: inuse` the blocks a descriptor or listener holds, `orphan 0`,
//!   `tw` the live time-wait entries, `alloc` every block in use, `mem`
//!   the frames kernel/tcp holds; `UDP: inuse` the datagram sockets
//!   open, `mem 0`; the other lines Linux prints left out). Linux's
//!   `/proc/net` is a link to `self/net`; here it is a directory
//!   (named drift).
//!
//! No region, no heap. Written from proc(5), proc_pid_status(5),
//! cgroups(7), sysfs(5) and black-box reads of the files on Linux. No
//! Linux source; no other kernel's source.

use cred
use frames
use paging
use sched
use tcp
use udp
use unix

const PAGE: u64 = 4096

/// How many entries there are; also `NONE`'s value.
pub const ENTRIES: u64 = 25
/// No entry.
pub const NONE: u64 = 25
/// px25: the entry `/proc/<pid>` (a reference carries the pid above
/// bit 16: `pid << 16 | PIDDIR`), and its `status`; px39: its
/// `setgroups` (entry 21 is `/proc/self/setgroups`: the fixed entries
/// are those below PIDDIR).
pub const PIDDIR: u64 = 22
const PSTATUS: u64 = 23
const PSETGROUPS: u64 = 24
const EMASK: u64 = 0xffff
/// An entry's parent when it sits in the root directory.
pub const ROOT: u64 = 0xffff

// What `make` writes for a file.
const G_STATUS: u64 = 1
const G_CGROUP: u64 = 2
const G_OVERCOMMIT: u64 = 3
const G_CONTROLLERS: u64 = 4
const G_CPUMAX: u64 = 5
const G_ONLINE: u64 = 6
const G_MEMINFO: u64 = 7 // px25
const G_FILENR: u64 = 8
const G_SOCKSTAT: u64 = 9
const G_PSTATUS: u64 = 10
const G_SETGROUPS: u64 = 11 // px39

const S_IFDIR: u64 = 0x4000
const S_IFREG: u64 = 0x8000

/// A reference's entry (px25: the low 16 bits; the pid above them).
pub fn entry(r: u64) -> u64 {
    r & EMASK
}

/// px25: the pid a reference carries (0: none, a fixed entry).
pub fn pid_of(r: u64) -> u64 {
    r >> 16
}

/// px25: the reference of `/proc/<pid>`.
pub fn pid_dir(pid: u64) -> u64 {
    (pid << 16) | PIDDIR
}

/// Fixed entry `e`'s name (not PIDDIR's, whose name is its pid).
pub fn name(e: u64) -> str {
    if e == 0 { return "proc" }
    if e == 1 { return "self" }
    if e == 2 || e == PSTATUS { return "status" }
    if e == 3 { return "cgroup" }
    if e == 4 { return "sys" }
    if e == 5 { return "vm" }
    if e == 6 { return "overcommit_memory" }
    if e == 7 { return "sys" }
    if e == 8 || e == 17 { return "fs" }
    if e == 9 { return "cgroup" }
    if e == 10 { return "cgroup.controllers" }
    if e == 11 { return "cpu.max" }
    if e == 12 { return "devices" }
    if e == 13 { return "system" }
    if e == 14 { return "cpu" }
    if e == 16 { return "meminfo" }
    if e == 18 { return "file-nr" }
    if e == 19 { return "net" }
    if e == 20 { return "sockstat" }
    if e == 21 || e == PSETGROUPS { return "setgroups" }
    "online"
}

fn digits(v: u64) -> u64 {
    var n: u64 = 1
    var t = v
    while t >= 10 {
        t /= 10
        n += 1
    }
    n
}

/// The length of reference `r`'s name.
pub fn name_len(r: u64) -> u64 {
    if entry(r) == PIDDIR {
        return digits(pid_of(r))
    }
    var n: u64 = 0
    for _b in name(entry(r)).bytes() {
        n += 1
    }
    n
}

/// Byte `i` of reference `r`'s name (i < name_len(r)).
pub fn name_byte(r: u64, i: u64) -> u64 {
    if entry(r) == PIDDIR {
        let p = pid_of(r)
        var d: u64 = 1
        var k = digits(p) - 1 - i
        while k > 0 {
            d *= 10
            k -= 1
        }
        return 48 + (p / d) % 10
    }
    var k: u64 = 0
    for b in name(entry(r)).bytes() {
        if k == i {
            return b as int as u64
        }
        k += 1
    }
    0
}

/// The reference `r` sits in, or ROOT.
pub fn parent(r: u64) -> u64 {
    let e = entry(r)
    if e == 0 || e == 7 { return ROOT }
    if e == 1 || e == 4 || e == 16 || e == 19 || e == PIDDIR { return 0 }
    if e == 2 || e == 3 || e == 21 { return 1 }
    if e == 5 || e == 17 { return 4 }
    if e == 6 { return 5 }
    if e == 18 { return 17 }
    if e == 20 { return 19 }
    if e == PSTATUS || e == PSETGROUPS { return pid_dir(pid_of(r)) }
    if e == 8 || e == 12 { return 7 }
    if e == 9 { return 8 }
    if e == 10 || e == 11 { return 9 }
    if e == 13 { return 12 }
    if e == 14 { return 13 }
    14
}

fn gen(r: u64) -> u64 {
    let e = entry(r)
    if e == 2 { return G_STATUS }
    if e == 16 { return G_MEMINFO }
    if e == 18 { return G_FILENR }
    if e == 20 { return G_SOCKSTAT }
    if e == PSTATUS { return G_PSTATUS }
    if e == 21 || e == PSETGROUPS { return G_SETGROUPS }
    if e == 3 { return G_CGROUP }
    if e == 6 { return G_OVERCOMMIT }
    if e == 10 { return G_CONTROLLERS }
    if e == 11 { return G_CPUMAX }
    if e == 15 { return G_ONLINE }
    0
}

/// Whether reference `r` is a directory.
pub fn is_dir(r: u64) -> bool {
    gen(r) == 0
}

/// Reference `r`'s mode, type and permission bits (measured).
pub fn mode(r: u64) -> u64 {
    let e = entry(r)
    if is_dir(r) {
        if e <= 7 || e == 17 || e == 19 || e == PIDDIR {
            return S_IFDIR | 0x16d // 0555: /proc, /proc/self, /proc/sys, /proc/sys/vm, /sys
        }
        return S_IFDIR | 0x1ed // 0755
    }
    if e == 6 || e == 11 || e == 21 || e == PSETGROUPS {
        return S_IFREG | 0x1a4 // 0644: overcommit_memory, cpu.max, setgroups
    }
    S_IFREG | 0x124 // 0444
}

/// The size `stat` answers: 4096 for a sysfs attribute, 0 for procfs's
/// and cgroupfs's files (measured), 0 for a directory.
pub fn size(r: u64) -> u64 {
    if entry(r) == 15 { 4096 } else { 0 }
}

/// Which file system reference `r` is in: 0 `/proc`, 1 `/sys`.
pub fn fs(r: u64) -> u64 {
    let e = entry(r)
    if e <= 6 || e >= 16 { 0 } else { 1 }
}

/// The `k`th reference (from 0) that sits in `d` (a reference, or
/// ROOT), or NONE past the last. px25: `/proc` lists its fixed names,
/// then each process's number in increasing order; `/proc/<pid>` its
/// `status` and (px39) its `setgroups`.
pub fn child_at(d: u64, k: u64) -> u64 {
    var seen: u64 = 0
    if d != ROOT && entry(d) == PIDDIR {
        if k == 0 {
            return (pid_of(d) << 16) | PSTATUS
        }
        return if k == 1 { (pid_of(d) << 16) | PSETGROUPS } else { NONE }
    }
    var e: u64 = 0
    while e < PIDDIR {
        if parent(e) == d {
            if seen == k {
                return e
            }
            seen += 1
        }
        e += 1
    }
    if d != 0 {
        return NONE
    }
    var p = sched.proc_after(0)
    while p != 0 {
        if seen == k {
            return pid_dir(p)
        }
        seen += 1
        p = sched.proc_after(p)
    }
    NONE
}

/// px25: the child of `d` named by a process number `v` (`/proc/<v>`),
/// or NONE when no process has it.
pub fn pid_child(d: u64, v: u64) -> u64 {
    if d != 0 || sched.proc_slot(v) == sched.SLOTS {
        return NONE
    }
    pid_dir(v)
}

// --- the text --------------------------------------------------------------------

fn put_b(base: u64, at: u64, b: u64) -> u64 {
    if at >= PAGE {
        return at
    }
    // # Safety: a byte of the frame `make` took, through the HHDM; at < 4096.
    unsafe { ((base + at) as *u8).write_volatile((b & 0xff) as u8) }
    at + 1
}

fn put_s(base: u64, at: u64, s: str) -> u64 {
    var k = at
    for b in s.bytes() {
        k = put_b(base, k, b as int as u64)
    }
    k
}

fn put_dec(base: u64, at: u64, v: u64) -> u64 {
    var d: u64 = 1
    while v / d >= 10 {
        d *= 10
    }
    var k = at
    while d > 0 {
        k = put_b(base, k, 48 + (v / d) % 10)
        d /= 10
    }
    k
}

/// `v` right-aligned in `width` columns.
fn put_dec_w(base: u64, at: u64, v: u64, width: u64) -> u64 {
    var digits: u64 = 1
    var t = v
    while t >= 10 {
        t /= 10
        digits += 1
    }
    var k = at
    var pad = digits
    while pad < width {
        k = put_b(base, k, 32)
        pad += 1
    }
    put_dec(base, k, v)
}

fn put_hex16(base: u64, at: u64, v: u64) -> u64 {
    var k = at
    var i: u64 = 0
    while i < 16 {
        let n = (v >> ((15 - i) * 4)) & 0xf
        k = put_b(base, k, if n < 10 { 48 + n } else { 87 + n })
        i += 1
    }
    k
}

/// A memory line: `<name>:\t<kB, eight wide> kB\n`, Linux's form.
fn put_kb(base: u64, at: u64, label: str, kb: u64) -> u64 {
    var k = put_s(base, at, label)
    k = put_s(base, k, ":\t")
    k = put_dec_w(base, k, kb, 8)
    put_s(base, k, " kB\n")
}

fn put_field(base: u64, at: u64, label: str, v: u64) -> u64 {
    var k = put_s(base, at, label)
    k = put_s(base, k, ":\t")
    k = put_dec(base, k, v)
    put_b(base, k, 10)
}

fn put_mask(base: u64, at: u64, label: str, v: u64) -> u64 {
    var k = put_s(base, at, label)
    k = put_s(base, k, ":\t")
    k = put_hex16(base, k, v)
    put_b(base, k, 10)
}

/// px39: an id line, `<name>:\t<real>\t<effective>\t<saved>\t<file-system>\n`.
fn put_ids(base: u64, at: u64, label: str, r: u64, e: u64, s: u64, f: u64) -> u64 {
    var k = put_s(base, at, label)
    k = put_s(base, k, ":\t")
    k = put_dec(base, k, r)
    k = put_b(base, k, 9)
    k = put_dec(base, k, e)
    k = put_b(base, k, 9)
    k = put_dec(base, k, s)
    k = put_b(base, k, 9)
    k = put_dec(base, k, f)
    put_b(base, k, 10)
}

/// A thread's name, as `prctl(PR_GET_NAME)` answers it (its own when
/// set, else its program's, at most 15 bytes): the running thread's when
/// `s` is sched.SLOTS, else the leader's in slot `s` (px25).
fn put_name(base: u64, at: u64, s: u64) -> u64 {
    let me = s == sched.SLOTS
    let w0 = if me { sched.self_name(0) } else { sched.proc_word(s, 4) }
    let w1 = if me { sched.self_name(1) } else { sched.proc_word(s, 5) }
    var k = at
    if w0 != 0 || w1 != 0 {
        var i: u64 = 0
        while i < 15 {
            let b = if i < 8 { (w0 >> (i * 8)) & 0xff } else { (w1 >> ((i - 8) * 8)) & 0xff }
            if b == 0 {
                return k
            }
            k = put_b(base, k, b)
            i += 1
        }
        return k
    }
    let a = if me { sched.self_exec(2) } else { sched.proc_word(s, 6) }
    let l = if me { sched.self_exec(3) } else { sched.proc_word(s, 7) }
    let n = if l < 15 { l } else { 15 }
    var j: u64 = 0
    while j < n {
        // # Safety: a byte of the program's name (kernel/sched's record of it).
        let v = unsafe { ((a + j) as *u8).read_volatile() }
        k = put_b(base, k, v as u64)
        j += 1
    }
    k
}

/// `/proc/self/status` (`s` sched.SLOTS) or px25's `/proc/<pid>/status`
/// (`s` the process's leader's slot, `pid` its pid) into the frame at
/// `base`: its length. `area` is the process's area (the signal
/// actions), `umask` its mask, `fds` the descriptor table's size.
fn status(base: u64, s: u64, pid0: u64, area: u64, umask: u64, fds: u64) -> u64 {
    let me = s == sched.SLOTS
    var k = put_s(base, 0, "Name:\t")
    k = put_name(base, k, s)
    k = put_s(base, k, "\nUmask:\t0")
    k = put_b(base, k, 48 + ((umask >> 6) & 7))
    k = put_b(base, k, 48 + ((umask >> 3) & 7))
    k = put_b(base, k, 48 + (umask & 7))
    if me {
        k = put_s(base, k, "\nState:\tR (running)\n")
    } else if sched.proc_word(s, 8) == 1 {
        k = put_s(base, k, "\nState:\tZ (zombie)\n")
    } else {
        k = put_s(base, k, "\nState:\tS (sleeping)\n")
    }
    let pid = if me { sched.self_pid() } else { pid0 }
    let tid = if me { sched.self_tid() } else { pid0 }
    k = put_field(base, k, "Tgid", pid)
    k = put_field(base, k, "Ngid", 0)
    k = put_field(base, k, "Pid", tid)
    k = put_field(base, k, "PPid", if me { sched.self_ppid() } else { sched.proc_word(s, 0) })
    k = put_field(base, k, "TracerPid", 0)
    // px39: who the process is (kernel/cred): real, effective, saved,
    // file-system; then its groups, each followed by a space, and one
    // space when there is none (Linux's line, measured both ways).
    k = put_ids(base, k, "Uid", cred.uid(area, cred.REAL), cred.uid(area, cred.EFFECTIVE), cred.uid(area, cred.SAVED), cred.uid(area, cred.FS))
    k = put_ids(base, k, "Gid", cred.gid(area, cred.REAL), cred.gid(area, cred.EFFECTIVE), cred.gid(area, cred.SAVED), cred.gid(area, cred.FS))
    k = put_field(base, k, "FDSize", fds)
    k = put_s(base, k, "Groups:\t")
    let ng = cred.ngroups(area)
    if ng == 0 {
        k = put_b(base, k, 32)
    }
    var gi: u64 = 0
    while gi < ng {
        k = put_dec(base, k, cred.group(area, gi))
        k = put_b(base, k, 32)
        gi += 1
    }
    k = put_b(base, k, 10)
    k = put_field(base, k, "NStgid", pid)
    k = put_field(base, k, "NSpid", tid)
    k = put_field(base, k, "NSpgid", 1)
    k = put_field(base, k, "NSsid", 1)
    k = put_field(base, k, "Kthread", 0)
    let space = if me { paging.live() } else { sched.proc_word(s, 3) }
    let rss = if space == 0 { 0 } else { paging.user_pages(space) * 4 }
    k = put_kb(base, k, "VmPeak", rss)
    k = put_kb(base, k, "VmSize", rss)
    k = put_kb(base, k, "VmLck", 0)
    k = put_kb(base, k, "VmPin", 0)
    k = put_kb(base, k, "VmHWM", rss)
    k = put_kb(base, k, "VmRSS", rss)
    k = put_kb(base, k, "RssAnon", rss)
    k = put_kb(base, k, "RssFile", 0)
    k = put_kb(base, k, "RssShmem", 0)
    k = put_kb(base, k, "VmData", rss)
    k = put_kb(base, k, "VmStk", 132)
    k = put_kb(base, k, "VmExe", 0)
    k = put_kb(base, k, "VmLib", 0)
    k = put_kb(base, k, "VmPTE", if space == 0 { 0 } else { paging.table_pages(space) * 4 }) // px25: the page tables
    k = put_kb(base, k, "VmSwap", 0)
    k = put_kb(base, k, "HugetlbPages", 0)
    k = put_field(base, k, "CoreDumping", 0)
    k = put_field(base, k, "THP_enabled", 0)
    k = put_s(base, k, "untag_mask:\t0xffffffffffffffff\n")
    k = put_field(base, k, "Threads", if me { sched.self_threads() } else { sched.proc_word(s, 1) })
    k = put_s(base, k, "SigQ:\t0/0\n")
    k = put_mask(base, k, "SigPnd", 0)
    k = put_mask(base, k, "ShdPnd", 0)
    k = put_mask(base, k, "SigBlk", if me { sched.self_sigmask() } else { sched.proc_word(s, 2) })
    var ign: u64 = 0
    var cgt: u64 = 0
    var sig: u64 = 1
    while sig <= 64 {
        // # Safety: the process's area, word 256 + (sig - 1) * 4 < 512 (its signal actions).
        let h = unsafe { ((area + (256 + (sig - 1) * 4) * 8) as *u64).read_volatile() }
        if h == 1 {
            ign = ign | (1 << (sig - 1))
        } else if h != 0 {
            cgt = cgt | (1 << (sig - 1))
        }
        sig += 1
    }
    k = put_mask(base, k, "SigIgn", ign)
    k = put_mask(base, k, "SigCgt", cgt)
    // px39: ruling #75 R9, in Linux's words (kernel/cred's `cap`).
    k = put_mask(base, k, "CapInh", cred.cap(area, 0))
    k = put_mask(base, k, "CapPrm", cred.cap(area, 1))
    k = put_mask(base, k, "CapEff", cred.cap(area, 2))
    k = put_mask(base, k, "CapBnd", cred.cap(area, 3))
    k = put_mask(base, k, "CapAmb", cred.cap(area, 4))
    k = put_field(base, k, "NoNewPrivs", 0)
    k = put_field(base, k, "Seccomp", 0)
    k = put_field(base, k, "Seccomp_filters", 0)
    k = put_s(base, k, "Speculation_Store_Bypass:\tunknown\n")
    k = put_s(base, k, "SpeculationIndirectBranch:\tunknown\n")
    k = put_s(base, k, "Cpus_allowed:\t1\nCpus_allowed_list:\t0\n")
    k = put_s(base, k, "Mems_allowed:\t1\nMems_allowed_list:\t0\n")
    k = put_field(base, k, "voluntary_ctxt_switches", 0)
    put_field(base, k, "nonvoluntary_ctxt_switches", 0)
}

/// px25: `/proc/meminfo`'s three lines (frames as kB).
fn meminfo(base: u64) -> u64 {
    var k = put_kb(base, 0, "MemTotal", frames.usable() * 4)
    k = put_kb(base, k, "MemFree", frames.free_count() * 4)
    put_kb(base, k, "MemAvailable", frames.free_count() * 4)
}

/// px25: `/proc/net/sockstat`, Linux's lines for the families PAX has.
fn sockstat(base: u64) -> u64 {
    var k = put_s(base, 0, "sockets: used ")
    k = put_dec(base, k, unix.live())
    let all = tcp.blocks()
    let fin = tcp.finishing()
    k = put_s(base, k, "\nTCP: inuse ")
    k = put_dec(base, k, all - fin)
    k = put_s(base, k, " orphan 0 tw ")
    k = put_dec(base, k, tcp.waiting())
    k = put_s(base, k, " alloc ")
    k = put_dec(base, k, all)
    k = put_s(base, k, " mem ")
    k = put_dec(base, k, tcp.frames_held())
    k = put_s(base, k, "\nUDP: inuse ")
    k = put_dec(base, k, udp.open_count())
    put_s(base, k, " mem 0\n")
}

/// Make reference `r`'s text in a fresh frame: (its physical address,
/// the text's length), or (0, 0) when no frame is free (the open is
/// then -ENOMEM), or (0, 1) when `/proc/<pid>`'s process has gone (the
/// open is -ENOENT). `area`, `umask` and `fds` are `status`'s (px25:
/// the named process's for `/proc/<pid>/status`); `files` the open
/// files in use and `files_max` the table's size, for `file-nr`.
pub fn make(r: u64, area: u64, umask: u64, fds: u64, files: u64, files_max: u64) -> (u64, u64) {
    let g = gen(r)
    var slot = sched.SLOTS
    if g == G_PSTATUS || (g == G_SETGROUPS && pid_of(r) != 0) {
        slot = sched.proc_slot(pid_of(r))
        if slot == sched.SLOTS {
            return (0, 1)
        }
    }
    let pa = frames.alloc() else 0
    if pa == 0 {
        return (0, 0)
    }
    let base = pa + frames.hhdm()
    var n: u64 = 0
    if g == G_STATUS {
        n = status(base, sched.SLOTS, 0, area, umask, fds)
    } else if g == G_PSTATUS {
        n = status(base, slot, pid_of(r), area, umask, fds)
    } else if g == G_MEMINFO {
        n = meminfo(base)
    } else if g == G_FILENR {
        n = put_dec(base, 0, files)
        n = put_s(base, n, "\t0\t")
        n = put_dec(base, n, files_max)
        n = put_b(base, n, 10)
    } else if g == G_SOCKSTAT {
        n = sockstat(base)
    } else if g == G_SETGROUPS {
        n = put_s(base, 0, "allow\n") // px39: no user namespace: `setgroups` is never switched off
    } else if g == G_CGROUP {
        n = put_s(base, 0, "0::/\n")
    } else if g == G_OVERCOMMIT {
        n = put_s(base, 0, "0\n")
    } else if g == G_CONTROLLERS {
        n = put_s(base, 0, "cpu\n")
    } else if g == G_CPUMAX {
        n = put_s(base, 0, "max 100000\n")
    } else {
        n = put_s(base, 0, "0\n")
    }
    (pa, n)
}
