//! member: false
// px76: real ACPI discovery and an independently timed scheduler tick.
// With `metal_x2apic` on its command line (tests/mpx6-metal's x2apic leg,
// R-px76-7) the kernel first switches the local APIC to x2APIC mode
// itself, as a firmware may hand it over (IA32_APIC_BASE EXTD, SDM vol.
// 3A §11.12.1; only where CPUID.1:ECX bit 21 says the CPU has it), so the
// tick and the rate row run through kernel/apic's MSR path.
use acpi
use apic
use boot_info
use clock
use fb
use frames
use interrupts
use log
use paging
use panic
use serial
use sync
use timer
extern "c" fn pax_exit(v: u8)
extern "c" fn pax_inl(port: u16) -> u32
extern "c" fn pax_cpuid(leaf: u64, sub: u64, reg: u64) -> u64
extern "c" fn pax_rdmsr(msr: u64) -> u64
extern "c" fn pax_wrmsr(msr: u64, v: u64)
fn check(ok: bool, name: str) {
    log.put(if ok { "PASS METAL " } else { "FAIL METAL " }); log.line(name)
    if !ok { unsafe { pax_exit(0x11) }; panic.halt() }
}
// The PIT-only leg (OVMF under `-machine acpi=off`: its own XSDT with no
// HPET table and no FADT, so no PM timer): the clock must fall to the
// PIT read back (tests/mpx6-metal holds its `clock: PIT` line), and the
// 20 ticks are timed by q35's HPET at its fixed 0xfed00000 read directly
// (HPET 1.0a §2.3.4 the period in femtoseconds, §2.3.6 the enable, §2.3.8
// the main counter), a reference the kernel's clock cannot be using here.
fn pit_only(pml4: u64) -> never {
    check(clock.started(), "the clock started")
    let va: u64 = 0xffffb00000004000
    let mapped = paging.map(pml4, va, 0xfed00000, paging.NX | paging.RW | 24) else 9
    check(mapped != 9, "the HPET reference mapped")
    let fs = unsafe { ((va + 4) as *u32).read_volatile() } as u64
    check(fs != 0 && fs <= 100000000, "the HPET reference's period")
    unsafe { ((va + 0x10) as *u32).write_volatile(((va + 0x10) as *u32).read_volatile() | 1) }
    let before = unsafe { ((va + 0xf0) as *u64).read_volatile() }
    let first = timer.ticks()
    while timer.ticks() - first < 20 { timer.wait() }
    let after = unsafe { ((va + 0xf0) as *u64).read_volatile() }
    let ns = (after - before) * fs / 1000000
    log.put("metal: 20 ticks took "); log.dec(ns as int); log.line(" ns by the HPET read directly")
    check(ns >= 150000000 && ns <= 300000000, "LAPIC tick rate 20 ticks in 150..300ms")
    timer.stop()
    log.line("PASS METAL firmware and clock")
    unsafe { pax_exit(0x10) }
    panic.halt()
}
// px107 (pax#293): kernel/clock's answers to a misread and at a rollover
// (tests/mpx6-metal's clock-* legs, each a word on the command line).
// clock-behind (the HPET, 64 bits, its readings 5 * 2^32 up): a reading
// one high word behind the one before, as a torn read gives, must leave
// the clock monotonic and counted; a reading of all ones (an absent
// device's) the same; a skip of 2^40 ticks counts forward exactly.
// clock-32 (the HPET read as a 32-bit counter) and clock-pmwrap (the PM
// timer's 24 bits): across a rollover the clock agrees with the PM timer
// read directly, and the largest step the mask allows (a reading one
// behind: a whole rollover less one tick) counts forward exactly.
// tests/mpx6-metal checks each `metal: step` line's nanoseconds against
// its ticks and period.
fn ticks20() { let first = timer.ticks(); while timer.ticks() - first < 20 { timer.wait() } }
fn step(what: str, before: u64, after: u64, t0: u64, t1: u64) {
    log.put("metal: step "); log.put(what); log.put(" "); log.put(clock.name())
    log.put(" from "); log.hex(before); log.put(" to "); log.hex(after) // log.hex writes the 0x
    log.put(" mask "); log.hex(clock.mask_of()); log.put(" read as "); log.dec((t1 - t0) as int); log.line(" ns")
}
fn behind() {
    check(clock.hpet_block() != 0, "the clock is the HPET, 64 bits")
    let flags = sync.irq_save()
    let t1 = clock.now_ns()
    let r1 = clock.last()
    clock.test_reading(r1 - 0x100000000) // one high word behind (HPET 1.0a §2.4.7's torn read)
    let t2 = clock.now_ns()
    sync.irq_restore(flags)
    ticks20()
    let t3 = clock.now_ns()
    log.put("metal: a reading 2^32 ticks behind "); log.hex(r1); log.put(": the clock read "); log.dec(t1 as int)
    log.put(", "); log.dec(t2 as int); log.put(", "); log.dec(t3 as int); log.put(" ns; ")
    log.dec(clock.refused_count() as int); log.line(" reading(s) taken as no time passing")
    check(t1 <= t2 && t2 <= t3 && t3 - t1 >= 150000000 && t3 - t1 <= 300000000, "the clock monotonic across a reading 2^32 ticks behind, 20 ticks in 150..300ms")
    check(clock.refused_count() == 1, "the reading behind counted once")
    let f4 = sync.irq_save()
    let t4 = clock.now_ns()
    clock.test_reading(0xffffffffffffffff)
    let t5 = clock.now_ns()
    sync.irq_restore(f4)
    check(t5 == t4 && clock.refused_count() == 2, "a reading of all ones taken as no time passing")
    let t6 = clock.now_ns()
    let r6 = clock.last()
    clock.test_skip(0x10000000000)
    let t7 = clock.now_ns()
    step("skip", r6, clock.last(), t6, t7)
    check(clock.refused_count() == 2, "a skip of 2^40 ticks taken as time")
}
fn rollover() {
    // The source the leg asks for (q35's HPET read as 32 bits, or the PM
    // timer's 24), by name before anything is measured (pax#314: under KVM
    // on a loaded host the HPET's check can refuse it).
    if boot_info.cmdline_has("metal_clock_pmwrap") { check(clock.mask_of() == 0xffffff, "the clock is the PM timer, 24 bits") }
    else { check(clock.reads_hpet() && clock.mask_of() == 0xffffffff, "the clock is the HPET, read as 32 bits") }
    let wraps = clock.wrapped()
    let port = acpi.pm_port()
    let p0 = unsafe { pax_inl(port as u16) as u64 } & 0xffffff
    // 100 ms of either: 357954 PM ticks, or 10^7 of q35's HPET (10 ns)
    clock.test_rollover_in(if boot_info.cmdline_has("metal_clock_pmwrap") { 357954 } else { 10000000 })
    let t0 = clock.now_ns()
    ticks20()
    let t1 = clock.now_ns()
    let p1 = unsafe { pax_inl(port as u16) as u64 } & 0xffffff
    let pm = ((p1 + 0x1000000 - p0) & 0xffffff) * 1000000000 / 3579545
    log.put("metal: across a rollover of the "); log.put(clock.name()); log.put(" (mask "); log.hex(clock.mask_of())
    log.put(") the clock read "); log.dec((t1 - t0) as int); log.put(" ns, the PM timer read directly "); log.dec(pm as int)
    log.put(" ns; rollovers "); log.dec((clock.wrapped() - wraps) as int); log.end()
    check(clock.wrapped() > wraps, "the counter rolled over inside the window")
    check((t1 - t0) * 100 >= pm * 98 && (t1 - t0) * 100 <= pm * 102, "the clock within 2% of the PM timer across the rollover")
    // With IF clear, so no tick's read comes between (the step is these
    // two reads' alone).
    let flags = sync.irq_save()
    let t2 = clock.now_ns()
    let r2 = clock.last()
    clock.test_reading((r2 + clock.mask_of()) & clock.mask_of()) // one behind: the largest step
    let t3 = clock.now_ns()
    let r3 = clock.last()
    sync.irq_restore(flags)
    step("largest", r2, r3, t2, t3)
    check(clock.refused_count() == 0, "a rollover is no misread")
}
// clock-torn (q35 as it is): the HPET's counter put 50 us before its low
// word rolls over, 20000 times, and read across each by the clock's own
// read: no reading may be below the one before (HPET 1.0a §2.4.7: a 64-bit
// read may be broken into two 32-bit ones, and QEMU's is).
fn r32(a: u64) -> u64 { unsafe { (a as *u32).read_volatile() as u64 } }
fn w32(a: u64, v: u64) { unsafe { (a as *u32).write_volatile(v as u32) } }
/// The HPET's main counter put `lead` ticks before its low word rolls over
/// (halted, written, enabled again: HPET 1.0a §2.3.8 rule 2) and read by the
/// clock's own read until its high word has moved on and 16 times more, `n`
/// times over, interrupts masked: (the crossings read across, those in which
/// a reading was below the one before, those whose first read came after
/// the rollover). The clock then goes on from the counter where it is.
fn crossings(n: u64, lead: u64) -> (u64, u64, u64) {
    let a = clock.hpet_block()
    if a == 0 || lead == 0 || lead > 0xffffffff { return (0, 0, 0) }
    let flags = sync.irq_save()
    let cfg = r32(a + 0x10)
    var spanned: u64 = 0
    var torn: u64 = 0
    var late: u64 = 0
    var i: u64 = 0
    while i < n {
        w32(a + 0x10, cfg & !1)
        w32(a + 0xf0, 0x100000000 - lead)
        w32(a + 0xf4, 5)
        w32(a + 0x10, cfg | 1)
        var last = clock.counter()
        if (last >> 32) != 5 { late += 1 } else {
            var bad = false
            var after: u64 = 0
            var k: u64 = 0
            while after < 16 && k < 10000000 {
                let v = clock.counter()
                if v < last { bad = true }
                if (v >> 32) == 6 || after > 0 { after += 1 }
                last = v
                k += 1
            }
            if after == 16 { spanned += 1 }
            if bad { torn += 1 }
        }
        i += 1
    }
    clock.test_rebase()
    sync.irq_restore(flags)
    (spanned, torn, late)
}
fn torn() {
    check(clock.hpet_block() != 0, "the clock is the HPET, 64 bits")
    let (spanned, bad, late) = crossings(20000, 5000)
    log.put("metal: the HPET read across 20000 rollovers of its low word: "); log.dec(spanned as int)
    log.put(" read across, "); log.dec(bad as int); log.put(" torn, "); log.dec(late as int); log.line(" first read after the rollover")
    check(spanned >= 18000, "the reads went across the rollovers")
    check(bad == 0, "no reading of the HPET torn across a rollover of its low word")
}
// px107 (pax#308): the tick against the PM timer read directly, 50 ticks
// from one tick's edge to another's, within 0.5% of 500 ms. The rate row
// below allows 150-300 ms for 20 ticks, which a tick 1.433 times long
// (286 ms) passes.
fn tick_rate() {
    check(acpi.pm_port() != 0, "a PM timer to time the tick by")
    let t0 = timer.ticks()
    while timer.ticks() == t0 { timer.wait() }
    let p0 = clock.pm_now()
    let first = timer.ticks()
    while timer.ticks() - first < 50 { timer.wait() }
    let ns = clock.pm_between(p0, clock.pm_now())
    log.put("metal: 50 ticks of 10 ms in "); log.dec((ns / 1000) as int); log.line(" us by the PM timer")
    check(ns >= 497500000 && ns <= 502500000, "the tick: 50 in 500 ms within 0.5% by the PM timer")
}
export fn kmain() {
    serial.init()
    frames.start()
    let pml4 = paging.start()
    let _screen = fb.start(pml4)
    interrupts.start()
    if boot_info.cmdline_has("metal_x2apic") {
        check(unsafe { pax_cpuid(1, 0, 2) } & (1 << 21) != 0, "x2APIC offered by CPUID")
        let base = unsafe { pax_rdmsr(0x1b) }
        unsafe { pax_wrmsr(0x1b, base | 0xc00) } // EN and EXTD: xAPIC to x2APIC
        check(apic.x2apic(), "x2APIC mode set")
    }
    apic.start(pml4)
    apic.report()
    // px85 (pax#260): the HPET's check under a stall, and with a period
    // that lies (tests/mpx6-metal's stall-* and hpet-* legs). 107386 PM
    // ticks are 30 ms of 3.579545 MHz; 17897725 are 5 s, past the 24-bit
    // PM timer's 4.69 s wrap.
    if boot_info.cmdline_has("metal_stall_window") { clock.test_stall(1, 107386) }
    if boot_info.cmdline_has("metal_stall_edge") { clock.test_stall(2, 107386) }
    if boot_info.cmdline_has("metal_stall_long") { clock.test_stall(1, 17897725) }
    if boot_info.cmdline_has("metal_hpet_fast") { clock.test_period(1250) }
    if boot_info.cmdline_has("metal_hpet_slow") { clock.test_period(800) }
    if boot_info.cmdline_has("metal_clock_behind") { clock.test_counter(0x500000000) }
    if boot_info.cmdline_has("metal_clock_32") { clock.test_32bit() }
    clock.start()
    let (windows, toolong, retaken, stalled) = clock.check_counts()
    log.put("metal: the HPET's check measured "); log.dec(windows as int)
    log.put(" window(s), "); log.dec(toolong as int); log.put(" too long, and took ")
    log.dec(retaken as int); log.put(" bracket(s) again, "); log.dec(stalled as int); log.line(" across the stall")
    // px107 (pax#308): the clock stands still 8.6 ms inside the LAPIC's
    // calibration (one reading 8.6 ms ahead, then the readings behind it
    // taken as no time passing), the shape of a boot under KVM that
    // calibrated at 89527688 Hz, 1.433 times the rate: its clock, sleeps
    // and timeouts ran at 0.70 of real time (tests/mpx6-metal's
    // timer-stall leg).
    if boot_info.cmdline_has("metal_timer_stall_nopm") { clock.test_no_pm() } // the agreement rule alone
    // timer-stall-shared: the PM timer answers from the clock, so it stands
    // still with it, as one stall of the emulator could hold both reads;
    // the PM timer cannot tell, and the next window must.
    if boot_info.cmdline_has("metal_timer_stall_shared") { clock.test_pm_follows_clock() }
    if boot_info.cmdline_has("metal_timer_stall") || boot_info.cmdline_has("metal_timer_stall_nopm") || boot_info.cmdline_has("metal_timer_stall_shared") {
        let fs = clock.hpet_period_fs()
        check(fs != 0, "the clock reads the HPET")
        clock.test_reading(clock.counter() + 8600000 * 1000000 / fs)
    }
    timer.start()
    fb.report()
    if boot_info.cmdline_has("metal_pitonly") {
        pit_only(pml4)
    }
    if boot_info.cmdline_has("metal_clock_behind") { behind() }
    if boot_info.cmdline_has("metal_clock_torn") { torn() }
    if boot_info.cmdline_has("metal_clock_32") || boot_info.cmdline_has("metal_clock_pmwrap") { rollover() }
    if boot_info.cmdline_has("metal_timer_stall") || boot_info.cmdline_has("metal_timer_stall_nopm") || boot_info.cmdline_has("metal_timer_stall_shared") { tick_rate() }
    check(acpi.tables() > 0, "ACPI checked tables")
    let port = acpi.pm_port()
    check(port != 0, "independent PM rate reference")
    let before = unsafe { pax_inl(port as u16) as u64 } & 0xffffff
    let first = timer.ticks()
    while timer.ticks() - first < 20 { timer.wait() }
    let after = unsafe { pax_inl(port as u16) as u64 } & 0xffffff
    let elapsed = (after + 0x1000000 - before) & 0xffffff
    check(elapsed >= 536931 && elapsed <= 1073864, "LAPIC tick rate 20 ticks in 150..300ms")
    timer.stop()
    log.line("PASS METAL firmware and clock")
    unsafe { pax_exit(0x10) }
    panic.halt()
}
