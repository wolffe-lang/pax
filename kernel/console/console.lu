//! console — what a person types reaches a program (px13): COM1's
//! receiver and the i8042's keyboard feed one input queue through one
//! line discipline, and `read(0, …)` on the console takes from it.
//!
//! **The two sources.** COM1's receive interrupt (the 16550's IER bit
//! 0, a receive trigger of one byte: kernel/serial's `receive_on`) is
//! the 8259 master's line 4, vector 36; that is what QEMU's `-serial`
//! delivers and what a serial terminal sends. The i8042's keyboard
//! interrupt is the master's line 1, vector 33: `start` reads the
//! controller's configuration byte (command 0x20), sets bit 0 (the
//! first port's interrupt) and bit 6 (translation to scancode set 1),
//! clears bit 4 (the first port's clock disable) and bit 1 (the second
//! port's interrupt), writes it back (command 0x60) and enables the
//! first port (0xae); each interrupt then drains port 0x60 while the
//! status register's bit 0 says a byte is there (bit 5 set: a byte from
//! the second port, dropped). Set 1 is decoded for a US layout: make
//! codes below 0x80, the same with bit 7 set on release, 0xe0 before an
//! extended key; both shifts, both controls and Caps Lock are tracked;
//! Ctrl with a letter or one of `@[\]^_` gives the control character;
//! Backspace gives DEL (0x7f, the erase character), Enter CR (0x0d),
//! keypad Enter CR and keypad `/ * - +` their characters; (px58) the
//! cursor and editing block (the E0-prefixed arrows, Home, End, PgUp,
//! PgDn, Insert, Delete) gives the sequences a Linux virtual terminal
//! gives (`ESC [ A` to `ESC [ D`, `ESC [ 1 ~` to `ESC [ 6 ~`, measured on
//! kasumi's kernel's VT: notes/px58-yew-on-pax.md §E), each byte through
//! the line discipline as if typed; (px59, measured the same way:
//! notes/px59/vt2.rows) an arrow with Shift, left Alt or Ctrl gives `ESC
//! [ 1 ; m X`, m = 1 + Shift 1 + Alt 2 + Ctrl 4 (left Alt alone on Left
//! or Right gives nothing: the VT's console switch); the editing block
//! takes no modifier (Shift with PgUp or PgDn gives nothing: the VT's
//! scrolling); F1-F12 give `ESC [ [ A` to `ESC [ [ E` and `ESC [ 17 ~` to
//! `ESC [ 24 ~`, Shift+F1-F10 the VT's F11-F20 (`ESC [ 23 ~` to `ESC [ 34
//! ~`), Ctrl the same as none, any Alt or Shift with Ctrl nothing; left
//! Alt with a character key sends ESC before it (with Shift too,
//! nothing); right Alt is tracked and adds nothing (R-px59-2: the VT's
//! AltGr enters a character by its code, not served); the keypad's
//! digits and point give nothing. `irq` takes
//! both vectors and acknowledges the 8259 (kernel/timer's `eoi`); both
//! lines are unmasked by `start` (kernel/timer's `unmask`: the master's
//! mask 0xfe becomes 0xec).
//!
//! **The line discipline** is POSIX's canonical and non-canonical
//! input processing as termios(3) describes it, the flags and control
//! characters a program reads with TCGETS and sets with TCSETS. The
//! settings at `start` are a Linux pseudo-terminal's, measured
//! (`notes/px13/`), with one difference named: IXON is clear, because
//! PAX has no output flow control, so Ctrl-S and Ctrl-Q are characters
//! like any other. ISIG is set since px26 (px13 left it clear and
//! delivered Ctrl-C as the byte 0x03):
//!
//!     c_iflag 0x100 ICRNL           (Linux's pty: 0x500, ICRNL|IXON)
//!     c_oflag 0x5   OPOST|ONLCR
//!     c_cflag 0xbf  B38400|CS8|CREAD
//!     c_lflag 0x8a3b ISIG|ICANON|ECHO|ECHOE|ECHOK|ECHOCTL|ECHOKE|IEXTEN
//!     c_cc    ^C ^\ DEL ^U ^D 0 1 0 ^Q ^S ^Z 0 ^R ^O ^W ^V 0 0 0
//!
//! **The terminal's signals** (px26, ISIG): VINTR (Ctrl-C) is SIGINT,
//! VQUIT (Ctrl-\) SIGQUIT and VSUSP (Ctrl-Z) SIGTSTP. Such a byte is
//! not queued: it is echoed (`^C`, by ECHO and ECHOCTL, with no newline:
//! measured on Linux), the line being edited and every byte not yet
//! read are discarded (NOFLSH clear), and the signal is noted for
//! kernel/interrupts to raise (`take_signals`) for every process —
//! PAX has one session and one process group, the console their
//! controlling terminal (kernel/signal's `tty`). Linux raises it for
//! the terminal's foreground process group only; a shell that makes no
//! process groups, as pelt makes none, sees the same on both.
//! Every such key is also counted (px28, `signal_keys`), for
//! kmain_session's closing lines.
//!
//! Honoured: ICRNL, INLCR and IGNCR on input; ICANON; ECHO, ECHOE,
//! ECHOK, ECHOKE, ECHOCTL and ECHONL; VERASE, VKILL, VEOF, VEOL and
//! (with IEXTEN) VWERASE; VMIN 0 against at least 1 in non-canonical
//! mode, and with VMIN 0 a VTIME above 0 (px46: a read with nothing
//! ready waits that many tenths of a second for a byte, then answers 0;
//! pelt's editor reads so since sh11); OPOST|ONLCR for the echo and for
//! every `write` to the console (kernel/user). Stored and answered but
//! not acted on: every other bit, VTIME with VMIN above 0 (Linux's
//! timer between bytes), VREPRINT, VLNEXT, VDISCARD, the speed. In canonical mode
//! a line is edited until NL (Enter, by ICRNL), VEOL or VEOF; VEOF on an
//! empty line is end of file (the next `read` answers 0), on a
//! non-empty one it hands the line over without a newline. A line
//! holds at most 4095 bytes and its newline; past that, bytes are
//! dropped (counted). Echo: a printable byte as itself, NL as CR NL, a
//! control byte as `^X` (ECHOCTL; DEL as `^?`), VERASE as `\b \b` (twice
//! for a byte echoed as two), VKILL as an erase of every byte (ECHOKE).
//!
//! **Reading**: `read` copies what is ready (in canonical mode up to and
//! including the first newline, so one line a call) and answers its
//! count; 0 at end of file; when nothing is ready it answers `RESTART`
//! and kernel/user puts the thread to sleep until `irq` makes something
//! ready (kernel/sched's input wait), then re-runs its `syscall`; a
//! descriptor opened O_NONBLOCK answers -EAGAIN instead.
//!
//! **Terminal ioctls** (`ioctl`), answered: TCGETS (0x5401), TCSETS,
//! TCSETSW and TCSETSF (0x5402-0x5404; TCSETSF discards unread input),
//! TIOCGWINSZ (0x5413; 0 rows and 0 columns, what a Linux serial line
//! and pseudo-terminal answer until someone sets them — or, px19, when
//! the screen is the console (kernel/screen attached before `start`),
//! the screen's rows and columns, its pixel fields 0; px48, pax#68: the
//! size of the device input last came from, `typed_at`) and TIOCSWINSZ
//! (0x5414); and (px18) the speaker's KIOCSOUND (0x4B2F) and KDMKTONE
//! (0x4B30), kernel/speaker's; px48's controlling-terminal five; px49
//! (pax#74): TCFLSH (0x540b), TCSBRK (0x5409) and TIOCSTI (0x5412),
//! measured on Linux. Every other request is refused by name (kernel/user
//! writes `refused: tty ioctl 0x<req>`, -ENOTTY). `struct termios` is
//! 36 bytes: four 32-bit flag words, the line discipline byte, 19
//! control characters (measured: what TCGETS writes on Linux, and the
//! names strace gives each bit and index).
//!
//! **Terminals** (px111): the line discipline is the console's and every
//! pty slave's (kernel/pty), each routine taking the terminal's id (`CON`,
//! or `PTY0` + the pty's number), each terminal's state and ring its own;
//! a slave's echo and output go into its pty's OQ for the master, and the
//! master's bytes wait in IQ until the line discipline takes them
//! (`feed`). A pty starts with Linux's pty's settings, IXON included, and
//! honours it (R-px111-2); the console keeps IXON clear. Its
//! foreground group's signals are raised in the master's write
//! (`pty_signals`); a hung-up slave reads end of file and answers -EIO.
//!
//! **The pointer and the mouse's reports** (px117): the console reads a
//! kernel/mouse queue of its own, opened when the first pointer attaches
//! (`pointer_arrived`, from kernel/xhci's enumeration: /dev/mouse0 still
//! appears only once a pointer came), and takes what it holds on every
//! tick and before every key (`pointer_drain`: USB, the i8042, COM1), so
//! a report is never behind a key the devices sent after it. One pointer
//! for every device: a relative one moves it a pixel a count (no
//! acceleration), an absolute one puts it at its 0..32767 scaled to the
//! grid, both held to the grid's pixels; its cell is the pixel's. It is
//! drawn (kernel/screen's `pointer`) from the first record that is not
//! an arrival or a departure, whether or not a program asked for
//! reports; with none asked for, the buttons and the wheel do nothing
//! (no selection, no paste). Reports are what the XTerm Control
//! Sequences document's "Mouse Tracking" gives for button-event tracking
//! (DECSET 1002) in the SGR encoding (1006), both set, nothing else:
//! `ESC [ < Cb ; Cx ; Cy M` for a press or a motion, `m` for a release,
//! Cx and Cy the 1-based cell; Cb 0 left, 1 middle, 2 right (HID's
//! buttons 1, 3 and 2), 32 more for a motion into another cell with a
//! button held (the lowest of those held), 64 and 65 a wheel detent away
//! from and towards the user (at most eight a record), and Shift 4, Alt 8
//! and Ctrl 16 from the keyboard's state. Buttons 4 and 5, motion with no
//! button, X10's bytes and the other modes and encodings type nothing.
//! A report is typed through the line discipline whole or not at all
//! (no room: dropped, counted). The modes belong to the process whose
//! console write set them (`after_write`); they end when it ends (an
//! exit or a signal, seen at the next tick or key) and are withheld,
//! not queued, while it is not in the console's foreground process group
//! (`reporting`). A pty's program is its master's: its DECSET never
//! reaches this screen.
//!
//! Before `start` the console is px12's: `read` answers end of file and
//! every ioctl -ENOTTY (kmain_boreutils and every earlier kernel never
//! start it, so a batch program's descriptors are not a terminal there,
//! as Linux's pipe is not).
//!
//! The state is boot/console.S's `pax_con_state` and `pax_con_ring`,
//! read and written volatile: `irq` writes them behind every thread's
//! back (wolf-lang#598's shape). Every entry runs with IF clear (a
//! handler or a system call), so nothing else touches them meanwhile.
//! No region, no heap: the interrupt handlers write this state, and
//! none allocates (kernel/sched, "Regions").
//!
//! Written from the PC16550D data sheet (IER, FCR, LSR, RBR), the IBM
//! PC AT keyboard controller (8042) command set and status bits and the
//! scancode set 1 table for the US layout as published in the PS/2
//! hardware documentation, POSIX.1-2024's General Terminal Interface
//! (XBD chapter 11), man-pages termios(3) and ioctl_tty(2), and
//! black-box runs on Linux (`notes/px13/`). The uapi termios header was
//! not read (§2 of the note). No Linux source; no other kernel's source.

use cred
use frames
use log
use mouse
use sched
use screen
use serial
use speaker
use timer
use uaccess

extern "c" fn pax_outb(port: u16, v: u8)
extern "c" fn pax_inb(port: u16) -> u8

extern "c" let pax_con_state: *u64
extern "c" let pax_con_ring: *u8
extern "c" let pax_pty_table: *u64

/// px111: the terminals, by the ids kernel/sched's sessions use too: the
/// console 1, pty n's slave PTY0 + n (n < PTYS; kernel/pty's).
pub const CON: u64 = 1
pub const PTY0: u64 = 2
pub const PTYS: u64 = 256
/// kernel/pty's record: PT_WORDS words a pty in pax_pty_table; word
/// PT_STATE the physical address of its state frame (0: no pty), words
/// PT_F0 to PT_F0 + 10 its eleven frames (the state's, the ring's, IQ's
/// four, OQ's five).
pub const PT_WORDS: u64 = 32
pub const PT_STATE: u64 = 0
pub const PT_F0: u64 = 16

// The state's words.
const C_STARTED: u64 = 0
const C_R: u64 = 1 // bytes read so far
const C_C: u64 = 2 // bytes committed (readable below this)
const C_E: u64 = 3 // bytes queued (the line being edited above C_C)
const C_EOF: u64 = 4 // a pending end of file: its position + 1; 0 none
const C_IFLAG: u64 = 5
const C_OFLAG: u64 = 6
const C_CFLAG: u64 = 7
const C_LFLAG: u64 = 8
const C_CC: u64 = 9 // three words, c_cc[0..19] little-endian
const C_LINE: u64 = 12 // c_line
const C_WINSZ: u64 = 13 // struct winsize, 8 bytes
const C_KEYS: u64 = 14 // the keyboard's state (K_* bits)
const C_RX_COM1: u64 = 15 // bytes from COM1
const C_RX_KBD: u64 = 16 // characters from the keyboard
const C_SCANCODES: u64 = 17 // bytes from the i8042, releases included
const C_KBD_BEFORE: u64 = 18 // the i8042's configuration byte as found (+ 0x100 when absent)
const C_KBD_AFTER: u64 = 19
const C_DROPPED: u64 = 20 // bytes dropped on a full line
const C_READS: u64 = 21 // reads answered
const C_WAITS: u64 = 22 // reads that waited
const C_SIGNALS: u64 = 23 // px26: the signals keys have raised and nobody has taken (bit n - 1)
const C_SIG_KEYS: u64 = 24 // px28: keys that raised a signal, since boot
const C_LAST: u64 = 25 // px48: the tick the last byte was queued at (VTIME's timer between bytes, pax#66)
const C_SRC: u64 = 26 // px48: the device the last input came from: 0 none yet, 1 COM1, 2 the keyboard (pax#68)
const C_ANSWERS: u64 = 27 // px59: bytes of the screen's answers typed into the input
const C_UNANSWERED: u64 = 28 // px59: bytes of the screen's answers dropped (input last from COM1, or none yet)

const C_ENTRY: u64 = 29 // Alt decimal/AltGr hex: bit32 pending, low32 accumulator
// px111: a pty slave's own words (the console's stay 0)
const C_IQ_R: u64 = 40 // bytes of IQ the line discipline has taken
const C_IQ_W: u64 = 41 // bytes the master has written into IQ
const C_OQ_R: u64 = 42 // bytes of OQ the master has read
const C_OQ_W: u64 = 43 // bytes put in OQ (the slave's output and the echo)
const C_STOP: u64 = 44 // 1 while IXON's VSTOP holds the output
const C_HUNG: u64 = 45 // 1 once the master has closed: reads answer end of file
const C_BATCH: u64 = 46 // OQ's write count when the current feed began (a signal key's flush)
const C_OQ_BASE: u64 = 47 // OQ's read count when it last went from empty to not (a read's stretch counts from it)
pub const C_RINGF: u64 = 48 // the ring's frame (physical)
pub const C_IQF: u64 = 49 // IQ's four frames, 49 to 52
pub const C_OQF: u64 = 53 // OQ's five frames, 53 to 57
// px117: the console's own words, 64 on (a pty's stay 0): the pointer.
const C_MREADER: u64 = 64 // the console's kernel/mouse reader (0: none opened yet)
const C_PXY: u64 = 65 // the pointer's pixel, x | y << 32
const C_PSEEN: u64 = 66 // 1 once a pointer moved (the pointer is drawn from then)
const C_PCELL: u64 = 67 // the pointer's cell at the last record, column | row << 32
const C_PBTN: u64 = 68 // the buttons held, every pointer's together (HID's buttons 1-3, bits 0-2)
const C_MOWNER: u64 = 69 // the pid whose console write set the mouse modes (0: nobody)
const C_MSETS: u64 = 70 // kernel/screen's `mouse_sets` when the owner was last taken
const C_MTYPED: u64 = 71 // reports typed
const C_MWITHHELD: u64 = 72 // reports withheld: the owner not in the foreground group
const C_MDROPPED: u64 = 73 // reports dropped: no room for the whole of one
const C_MENDED: u64 = 74 // the modes ended with their owner
const C_MREC: u64 = 76 // the record being read, four words, 76 to 79
const C_PDEV: u64 = 80 // sixteen pointers' buttons: number | buttons << 32 (number 0: free), 80 to 95
const PDEVS: u64 = 16

const RING: u64 = 4096
const LINE_MAX: u64 = 4095 // bytes before the newline

// termios bits (black-box: strace's names, notes/px13/bits.strace).
const IGNCR: u64 = 0x80
const ICRNL: u64 = 0x100
const IXON: u64 = 0x400 // px111: a pty's output flow control (the console keeps it clear)
const INLCR: u64 = 0x40
const OPOST: u64 = 0x1
const ONLCR: u64 = 0x4
const ICANON: u64 = 0x2
const ECHO: u64 = 0x8
const ECHOE: u64 = 0x10
const ECHOK: u64 = 0x20
const ECHONL: u64 = 0x40
const ECHOCTL: u64 = 0x200
const ECHOKE: u64 = 0x800
const IEXTEN: u64 = 0x8000
const ISIG: u64 = 0x1 // px26
const NOFLSH: u64 = 0x80
const TOSTOP: u64 = 0x100 // px48: a background write is SIGTTOU's
const VINTR: u64 = 0
const VQUIT: u64 = 1
const VSUSP: u64 = 10
const VSTART: u64 = 8 // px111
const VSTOP: u64 = 9
const SIGINT: u64 = 2
const SIGQUIT: u64 = 3
const SIGTSTP: u64 = 20
// c_cc indices.
const VEOF: u64 = 4
const VERASE: u64 = 2
const VKILL: u64 = 3
const VMIN: u64 = 6
const VTIME: u64 = 5
const VEOL: u64 = 11
const VWERASE: u64 = 14

const TERMIOS_BYTES: u64 = 36

// ioctl requests (black-box: strace's names, notes/px13/termios.strace).
const TCGETS: u64 = 0x5401
const TCSETS: u64 = 0x5402
const TCSETSW: u64 = 0x5403
const TCSETSF: u64 = 0x5404
const TIOCGWINSZ: u64 = 0x5413
const TIOCSWINSZ: u64 = 0x5414
// px48: the controlling terminal's (uapi asm-generic/ioctls.h, ioctl_tty(2)).
const TIOCSCTTY: u64 = 0x540e
const TIOCGPGRP: u64 = 0x540f
const TIOCSPGRP: u64 = 0x5410
const TIOCNOTTY: u64 = 0x5422
const TIOCGSID: u64 = 0x5429
const TCSBRK: u64 = 0x5409 // px49 (pax#74): tcdrain (arg not 0), tcsendbreak (0)
const TCFLSH: u64 = 0x540b // px49: tcflush
const TIOCSTI: u64 = 0x5412 // px49: a byte put in the input as if typed
pub const FIONREAD: u64 = 0x541b // px111
pub const TIOCOUTQ: u64 = 0x5411 // px111
const TCIFLUSH: u64 = 0
const TCIOFLUSH: u64 = 2
const SIGHUP: u64 = 1
const SIGTTIN: u64 = 21
const SIGTTOU: u64 = 22
const SIGWINCH: u64 = 28

// What `read` and `ioctl` answer besides a count.
/// What `read` answers when the thread must wait (kernel/user rewinds
/// the system call and sleeps the thread on input).
pub const RESTART: u64 = 0xfffffffffffffe00 // -512: never seen by ring 3
/// px46: what `read` answers when nothing is ready, VMIN is 0 and VTIME
/// is not, and the wait's deadline has not come: kernel/files answers
/// its `WAIT`, and the thread waits as a pipe's reader does, until a
/// key or the deadline (the thread's own word, `sched.self_until`).
pub const TIMED: u64 = 0xfffffffffffffdfd // -515: never seen by ring 3
/// A PIT tick in nanoseconds (kernel/ready's NS_PER_TICK).
const NS_PER_TICK: u64 = 10000151
/// What `ioctl` answers for a request refused by name (kernel/user
/// logs it and answers -ENOTTY).
pub const REFUSED: u64 = 0xfffffffffffffdff // -513: an ioctl refused by name
const NEG_EFAULT: u64 = 0xfffffffffffffff2 // -14
const NEG_EAGAIN: u64 = 0xfffffffffffffff5 // -11
const NEG_EPERM: u64 = 0xffffffffffffffff // -1
const NEG_ESRCH: u64 = 0xfffffffffffffffd // -3
const NEG_EIO: u64 = 0xfffffffffffffffb // -5
const NEG_EINVAL: u64 = 0xffffffffffffffea // -22
/// px48: what a read, a write or a setting of the console answers when
/// the caller is in the background and the console has just sent its
/// group SIGTTIN or SIGTTOU (`job`): kernel/user rewinds the call to run
/// again once the group is continued (or a handler has run: then as a
/// waiting call, SA_RESTART's).
pub const JOB_STOP: u64 = 0xfffffffffffffdfc // -516: never seen by ring 3
/// -ENOTTY, what a refused request answers ring 3.
pub const NEG_ENOTTY: u64 = 0xffffffffffffffe7 // -25

// The UART's and the i8042's lines and vectors.
const COM1_LINE: u64 = 4
const KBD_LINE: u64 = 1
const KBD_DATA: u16 = 0x60
const KBD_CMD: u16 = 0x64
const KBD_OBF: u64 = 0x1
const KBD_IBF: u64 = 0x2
const KBD_AUX: u64 = 0x20
const POLLS: u64 = 100000

// The keyboard's state bits (C_KEYS).
const K_LSHIFT: u64 = 1
const K_RSHIFT: u64 = 2
const K_LCTRL: u64 = 4
const K_RCTRL: u64 = 8
const K_CAPS: u64 = 16
const K_E0: u64 = 32
const K_LALT: u64 = 64 // px59
const K_RALT: u64 = 128 // AltGr: hexadecimal entry and measured symbol keys
const K_NUM: u64 = 256 // NumLock, initially off as on the measured VT

/// px111: where terminal `t`'s state words are: boot/console.S's
/// pax_con_state for the console, the first frame pty `t - PTY0` holds
/// (kernel/pty's record's word PT_STATE, a physical address) for a slave.
fn base(t: u64) -> u64 {
    if t == CON {
        // # Safety: the address only.
        return unsafe { pax_con_state as u64 }
    }
    frames.hhdm() + pty_word(t - PTY0, PT_STATE)
}

/// px111: word `w` of pty `n`'s record in boot/console.S's
/// pax_pty_table (kernel/pty's; the state frame is the word this
/// module reads).
pub fn pty_word(n: u64, w: u64) -> u64 {
    // # Safety: n < PTYS and w < PT_WORDS: inside the table's PTYS * PT_WORDS words.
    unsafe { ((pax_pty_table as u64 + (n * PT_WORDS + w) * 8) as *u64).read_volatile() }
}

pub fn put_pty_word(n: u64, w: u64, v: u64) {
    // # Safety: as `pty_word`.
    unsafe { ((pax_pty_table as u64 + (n * PT_WORDS + w) * 8) as *u64).write_volatile(v) }
}

fn sv(t: u64, i: u64) -> u64 {
    // # Safety: i < 128: inside boot/console.S's 1024-byte pax_con_state, or
    // the first 1024 bytes of the pty's state frame (mapped in the HHDM).
    unsafe { ((base(t) + i * 8) as *u64).read_volatile() }
}

fn put_sv(t: u64, i: u64, v: u64) {
    // # Safety: as `sv`.
    unsafe { ((base(t) + i * 8) as *u64).write_volatile(v) }
}

fn bump(t: u64, i: u64) {
    put_sv(t, i, sv(t, i) + 1)
}

/// The address of byte `p` of terminal `t`'s input ring: boot/console.S's
/// pax_con_ring, or the ring frame a pty holds (its state word C_RINGF).
fn ring_at(t: u64, p: u64) -> u64 {
    if t == CON {
        // # Safety: the address only.
        return unsafe { pax_con_ring as u64 } + p % RING
    }
    frames.hhdm() + sv(t, C_RINGF) + p % RING
}

fn ring(t: u64, p: u64) -> u64 {
    // # Safety: p % RING < 4096, inside pax_con_ring or the pty's ring frame.
    unsafe { (ring_at(t, p) as *u8).read_volatile() as u64 }
}

fn put_ring(t: u64, p: u64, b: u64) {
    // # Safety: as `ring`.
    unsafe { (ring_at(t, p) as *u8).write_volatile((b & 0xff) as u8) }
}

// --- px111: a pty's two queues ---------------------------------------------
//
// The master's writes wait in IQ (16384 bytes, four frames) until the line
// discipline takes them (`feed`); the slave's output, echo included, waits
// in OQ (20480 bytes, five frames) until the master reads it. Each is a
// ring over its frames, read and written by counters that only grow
// (C_IQ_R/C_IQ_W, C_OQ_R/C_OQ_W), the frames' physical addresses in the
// state words C_IQF.. and C_OQF...

pub const IQ_CAP: u64 = 16384
pub const OQ_CAP: u64 = 20480

fn q_at(t: u64, fw: u64, cap: u64, p: u64) -> u64 {
    let o = p % cap
    frames.hhdm() + sv(t, fw + o / 4096) + o % 4096
}

fn q_get(t: u64, fw: u64, cap: u64, p: u64) -> u64 {
    // # Safety: q_at's address is inside one of the queue's frames.
    unsafe { (q_at(t, fw, cap, p) as *u8).read_volatile() as u64 }
}

fn q_put(t: u64, fw: u64, cap: u64, p: u64, b: u64) {
    // # Safety: as `q_get`.
    unsafe { (q_at(t, fw, cap, p) as *u8).write_volatile((b & 0xff) as u8) }
}

/// Bytes the master has not read yet.
pub fn oq_count(t: u64) -> u64 {
    sv(t, C_OQ_W) - sv(t, C_OQ_R)
}

/// Room left in OQ.
pub fn oq_room(t: u64) -> u64 {
    OQ_CAP - oq_count(t)
}

/// One byte of the slave's output for the master (dropped when OQ is
/// full: an echo nobody reads).
fn oq_put(t: u64, b: u64) {
    let w = sv(t, C_OQ_W)
    if w - sv(t, C_OQ_R) >= OQ_CAP {
        bump(t, C_DROPPED)
        return
    }
    if w == sv(t, C_OQ_R) {
        put_sv(t, C_OQ_BASE, w) // the queue was empty: a new stretch begins here
    }
    q_put(t, C_OQF, OQ_CAP, w, b)
    put_sv(t, C_OQ_W, w + 1)
}

/// The master's read: up to `n` bytes of OQ copied to user `buf`, no
/// further than the end of the 4096-byte stretch the first is in (from
/// where OQ last filled from empty); the count, or -EFAULT.
pub fn oq_take(t: u64, pml4: u64, buf: u64, n: u64) -> u64 {
    var k = oq_count(t)
    if k > n {
        k = n
    }
    // One read takes at most to the end of the 4096-byte stretch it starts
    // in, the stretches counted from where the queue was last empty
    // (measured: after one byte of a full buffer, a read of 4096 took
    // 4095, whatever was read before the buffer filled).
    let edge = 4096 - (sv(t, C_OQ_R) - sv(t, C_OQ_BASE)) % 4096
    if k > edge {
        k = edge
    }
    if !uaccess.writable(pml4, buf, k) {
        return NEG_EFAULT
    }
    let r = sv(t, C_OQ_R)
    var j: u64 = 0
    while j < k {
        uaccess.put(pml4, buf + j, q_get(t, C_OQF, OQ_CAP, r + j), 1)
        j += 1
    }
    put_sv(t, C_OQ_R, r + k)
    k
}

/// TCIFLUSH on the master: what the slave wrote and the master did not read.
pub fn oq_flush(t: u64) {
    put_sv(t, C_OQ_R, sv(t, C_OQ_W))
}

/// Bytes the master wrote that the line discipline has not taken.
pub fn iq_count(t: u64) -> u64 {
    sv(t, C_IQ_W) - sv(t, C_IQ_R)
}

pub fn iq_room(t: u64) -> u64 {
    IQ_CAP - iq_count(t)
}

/// Whether the line discipline takes byte `b` now: in raw mode while
/// the ring has room; in canonical mode while the line being edited is
/// under LINE_MAX, a line's end while the ring has room, and any byte
/// when no whole line waits to be read (the line discipline drops what
/// is past LINE_MAX, as it does for the console); the keys that edit or
/// signal, and IXON's, always.
fn takes(t: u64, b: u64) -> bool {
    let used = sv(t, C_E) - sv(t, C_R)
    if b != 0 && ((lflag(t, ISIG) && (b == cc(t, VINTR) || b == cc(t, VQUIT) || b == cc(t, VSUSP))) || (sv(t, C_IFLAG) & IXON != 0 && (b == cc(t, VSTOP) || b == cc(t, VSTART)))) {
        return true
    }
    if !lflag(t, ICANON) {
        return used < RING
    }
    if b != 0 && (b == cc(t, VERASE) || b == cc(t, VKILL) || (b == cc(t, VWERASE) && lflag(t, IEXTEN))) {
        return true
    }
    if used < LINE_MAX {
        return true
    }
    if (b == 10 || b == 13 || (b != 0 && (b == cc(t, VEOL) || b == cc(t, VEOF)))) && used < RING {
        return true
    }
    sv(t, C_C) == sv(t, C_R)
}

/// Hand what waits in IQ to the line discipline while it takes it; true
/// when a byte moved.
pub fn feed(t: u64) -> bool {
    var moved = false
    put_sv(t, C_BATCH, sv(t, C_OQ_W)) // where this feed's echo starts
    while iq_count(t) > 0 {
        let r = sv(t, C_IQ_R)
        let b = q_get(t, C_IQF, IQ_CAP, r)
        if !takes(t, b) {
            return moved
        }
        put_sv(t, C_IQ_R, r + 1)
        input(t, b)
        moved = true
    }
    moved
}

/// The master's write: up to `n` bytes of user `buf` into IQ, then fed;
/// the count taken (0 when IQ is full), or -EFAULT.
pub fn master_write(t: u64, pml4: u64, buf: u64, n: u64) -> u64 {
    var k = iq_room(t)
    if k > n {
        k = n
    }
    if !uaccess.readable(pml4, buf, k) {
        return NEG_EFAULT
    }
    let w = sv(t, C_IQ_W)
    var j: u64 = 0
    while j < k {
        q_put(t, C_IQF, IQ_CAP, w + j, uaccess.get(pml4, buf + j, 1))
        j += 1
    }
    put_sv(t, C_IQ_W, w + k)
    let _m = feed(t)
    k
}

/// The slave's write: user `buf`'s bytes through OPOST/ONLCR into OQ
/// while they fit whole; the count of `buf`'s bytes taken (0: none
/// fit, or IXON has stopped the output), or -EFAULT.
pub fn slave_write(t: u64, pml4: u64, buf: u64, n: u64) -> u64 {
    if sv(t, C_STOP) != 0 {
        return 0
    }
    if !uaccess.readable(pml4, buf, n) {
        return NEG_EFAULT
    }
    let nl = onlcr(t)
    var j: u64 = 0
    while j < n {
        let b = uaccess.get(pml4, buf + j, 1)
        let need: u64 = if b == 10 && nl { 2 } else { 1 }
        if oq_room(t) < need {
            return j
        }
        if need == 2 {
            oq_put(t, 13)
        }
        oq_put(t, b)
        j += 1
    }
    n
}

/// Whether IXON has stopped the slave's output (^S).
pub fn stopped(t: u64) -> bool {
    sv(t, C_STOP) != 0
}

/// The master's hangup of the slave (its last close): what was typed
/// and not read goes, the output stops being held, and every read of
/// the slave answers end of file from here (`hung`).
pub fn hang(t: u64) {
    put_sv(t, C_HUNG, 1)
    put_sv(t, C_R, sv(t, C_E))
    put_sv(t, C_C, sv(t, C_E))
    put_sv(t, C_EOF, 0)
    put_sv(t, C_IQ_R, sv(t, C_IQ_W))
    put_sv(t, C_STOP, 0)
}

pub fn hung(t: u64) -> bool {
    t != CON && sv(t, C_HUNG) != 0
}

/// A new pty's slave: its state words zeroed, the frames kernel/pty
/// took for it (its record's PT_F0 + 1 to PT_F0 + 10) noted, and a Linux
/// pty's settings (measured: notes/px111/prediction.txt §A, T1): iflag
/// 0x500 (ICRNL|IXON), oflag 0x5, cflag 0xbf, lflag 0x8a3b, the
/// console's c_cc, 0 by 0.
pub fn pty_start(t: u64) {
    var i: u64 = 0
    while i < 64 {
        put_sv(t, i, 0)
        i += 1
    }
    let n = t - PTY0
    put_sv(t, C_RINGF, pty_word(n, PT_F0 + 1))
    i = 0
    while i < 4 {
        put_sv(t, C_IQF + i, pty_word(n, PT_F0 + 2 + i))
        i += 1
    }
    i = 0
    while i < 5 {
        put_sv(t, C_OQF + i, pty_word(n, PT_F0 + 6 + i))
        i += 1
    }
    defaults(t)
    put_sv(t, C_IFLAG, ICRNL | IXON)
    put_sv(t, C_STARTED, 1)
}

/// The settings both the console and a pty start with (the console
/// clears IXON's bit: px13).
fn defaults(t: u64) {
    put_sv(t, C_IFLAG, ICRNL)
    put_sv(t, C_OFLAG, OPOST | ONLCR)
    put_sv(t, C_CFLAG, 0xbf)
    put_sv(t, C_LFLAG, ISIG | ICANON | ECHO | ECHOE | ECHOK | ECHOCTL | ECHOKE | IEXTEN)
    // c_cc: VINTR ^C, VQUIT ^\, VERASE DEL, VKILL ^U, VEOF ^D, VTIME 0,
    // VMIN 1, VSWTC 0 | VSTART ^Q, VSTOP ^S, VSUSP ^Z, VEOL 0, VREPRINT
    // ^R, VDISCARD ^O, VWERASE ^W, VLNEXT ^V | VEOL2 0, two spare.
    put_sv(t, C_CC, 0x00010004157f1c03)
    put_sv(t, C_CC + 1, 0x16170f12001a1311)
    put_sv(t, C_CC + 2, 0)
}

/// The slave's window size, struct winsize's 8 bytes (kernel/pty's
/// TIOCGWINSZ on the master).
pub fn winsz(t: u64) -> u64 {
    sv(t, C_WINSZ)
}

/// c_cc[i].
fn cc(t: u64, i: u64) -> u64 {
    (sv(t, C_CC + i / 8) >> ((i % 8) * 8)) & 0xff
}

fn lflag(t: u64, bit: u64) -> bool {
    sv(t, C_LFLAG) & bit != 0
}

fn out(port: u16, v: u64) {
    // # Safety: io.S's OUT to an i8042 port; v < 256.
    unsafe { pax_outb(port, (v & 0xff) as u8) }
}

fn inp(port: u16) -> u64 {
    // # Safety: io.S's IN from an i8042 port.
    let v = unsafe { pax_inb(port) }
    v as u64
}

// --- output --------------------------------------------------------------

/// Whether a `write` to terminal `t` turns NL into CR NL (OPOST and
/// ONLCR; for the console always before `start`, px09's behaviour).
pub fn onlcr(t: u64) -> bool {
    if t == CON && sv(t, C_STARTED) == 0 {
        return true
    }
    let o = sv(t, C_OFLAG)
    o & OPOST != 0 && o & ONLCR != 0
}

/// px111: one byte out of terminal `t` as it is: to COM1 (and the
/// screen) for the console, into OQ for a pty's slave.
fn raw_out(t: u64, b: u64) {
    if t == CON {
        serial.put((b & 0xff) as u8)
    } else {
        oq_put(t, b)
    }
}

/// One byte of echo, with the output processing a `write` gets.
fn emit(t: u64, b: u64) {
    if b == 10 && onlcr(t) {
        raw_out(t, 13)
    }
    raw_out(t, b)
}

/// px26: the `n` bytes of kernel memory at `src` written to the console
/// with a `write`'s output processing (kernel/files' `sendfile`).
pub fn put_kernel(src: u64, n: u64) {
    let nl = onlcr(CON)
    var i: u64 = 0
    while i < n {
        // # Safety: [src, src + n) is the caller's kernel memory (a
        // file's bytes in the initramfs, mapped read-only in the HHDM).
        let b = unsafe { ((src + i) as *u8).read_volatile() }
        if b as u64 == 10 && nl {
            serial.put(13)
        }
        serial.put(b)
        i += 1
    }
    after_write()
    let _a = answered()
}

/// Whether byte `b` echoes as two columns (`^X`).
fn wide(t: u64, b: u64) -> bool {
    lflag(t, ECHOCTL) && ((b < 32 && b != 9 && b != 10) || b == 127)
}

/// Echo input byte `b` (ECHO set).
fn echo(t: u64, b: u64) {
    if wide(t, b) {
        raw_out(t, 94) // ^
        raw_out(t, if b == 127 { 63 } else { b + 64 })
    } else {
        emit(t, b)
    }
}

/// Erase the last queued byte from the screen (ECHO and ECHOE set).
fn rub(t: u64, b: u64) {
    var n: u64 = if wide(t, b) { 2 } else { 1 }
    while n > 0 {
        raw_out(t, 8)
        raw_out(t, 32)
        raw_out(t, 8)
        n -= 1
    }
}

// --- input ---------------------------------------------------------------

/// Hand everything queued to readers.
fn commit(t: u64) {
    put_sv(t, C_C, sv(t, C_E))
}

/// Queue byte `b` if the line has room (`nl`: room for a line end).
fn queue(t: u64, b: u64, nl: bool) -> bool {
    let e = sv(t, C_E)
    let used = e - sv(t, C_R)
    if used >= RING || (!nl && used >= LINE_MAX) {
        bump(t, C_DROPPED)
        return false
    }
    put_ring(t, e, b)
    put_sv(t, C_E, e + 1)
    put_sv(t, C_LAST, timer.ticks()) // px48: VTIME's timer runs from the last byte
    true
}

/// Remove the last byte of the line being edited, erasing its echo.
/// False when the line is empty.
fn erase_one(t: u64) -> bool {
    let e = sv(t, C_E)
    if e == sv(t, C_C) {
        return false
    }
    let b = ring(t, e - 1)
    put_sv(t, C_E, e - 1)
    if lflag(t, ECHO) && lflag(t, ECHOE) {
        rub(t, b)
    }
    true
}

fn is_blank(b: u64) -> bool {
    b == 32 || b == 9
}

/// One input byte through the line discipline.
fn input(t: u64, b0: u64) {
    var b = b0 & 0xff
    let ifl = sv(t, C_IFLAG)
    if b == 13 {
        if ifl & IGNCR != 0 {
            return
        }
        if ifl & ICRNL != 0 {
            b = 10
        }
    } else if b == 10 && ifl & INLCR != 0 {
        b = 13
    }
    if t != CON && ifl & IXON != 0 && b != 0 && (b == cc(t, VSTOP) || b == cc(t, VSTART)) {
        // px111: a pty's output flow control (measured: ^S and ^Q are
        // taken out of the input, VSTOP holds the slave's writes, VSTART
        // lets them go; the console keeps IXON clear, px13).
        put_sv(t, C_STOP, if b == cc(t, VSTOP) { 1 } else { 0 })
        return
    }
    if lflag(t, ISIG) && b != 0 {
        // px26: the terminal's signals, in either mode.
        var sig: u64 = 0
        if b == cc(t, VINTR) {
            sig = SIGINT
        } else if b == cc(t, VQUIT) {
            sig = SIGQUIT
        } else if b == cc(t, VSUSP) {
            sig = SIGTSTP
        }
        if sig != 0 {
            if !lflag(t, NOFLSH) {
                put_sv(t, C_R, sv(t, C_E))
                put_sv(t, C_C, sv(t, C_E))
                put_sv(t, C_EOF, 0)
                if t != CON && sv(t, C_BATCH) >= sv(t, C_OQ_R) {
                    // px111: and the echo of what the same write typed, not yet
                    // the master's (measured: `ab^C` in one write echoes `^C`,
                    // `ab^C` with NOFLSH `ab^C`; a program's output stays)
                    put_sv(t, C_OQ_W, sv(t, C_BATCH))
                }
            }
            if lflag(t, ECHO) {
                echo(t, b)
            }
            put_sv(t, C_SIGNALS, sv(t, C_SIGNALS) | (1 << (sig - 1)))
            put_sv(t, C_SIG_KEYS, sv(t, C_SIG_KEYS) + 1)
            return
        }
    }
    if !lflag(t, ICANON) {
        if queue(t, b, true) {
            commit(t)
            if lflag(t, ECHO) {
                echo(t, b)
            }
        }
        return
    }
    if b != 0 && b == cc(t, VERASE) {
        let _e = erase_one(t)
        if lflag(t, ECHO) && !lflag(t, ECHOE) {
            echo(t, b)
        }
        return
    }
    if b != 0 && b == cc(t, VKILL) {
        if lflag(t, ECHO) && lflag(t, ECHOKE) && lflag(t, ECHOE) {
            while erase_one(t) {}
            return
        }
        put_sv(t, C_E, sv(t, C_C))
        if lflag(t, ECHO) {
            echo(t, b)
            if lflag(t, ECHOK) {
                emit(t, 10)
            }
        }
        return
    }
    if b != 0 && b == cc(t, VWERASE) && lflag(t, IEXTEN) {
        while sv(t, C_E) > sv(t, C_C) && is_blank(ring(t, sv(t, C_E) - 1)) {
            let _e = erase_one(t)
        }
        while sv(t, C_E) > sv(t, C_C) && !is_blank(ring(t, sv(t, C_E) - 1)) {
            let _e = erase_one(t)
        }
        return
    }
    if b != 0 && b == cc(t, VEOF) {
        if sv(t, C_E) == sv(t, C_C) {
            put_sv(t, C_EOF, sv(t, C_C) + 1)
        }
        commit(t)
        return
    }
    if b == 10 || (b != 0 && b == cc(t, VEOL)) {
        if queue(t, b, true) {
            if lflag(t, ECHO) || (b == 10 && lflag(t, ECHONL)) {
                echo(t, b)
            }
            commit(t)
        }
        return
    }
    if queue(t, b, false) && lflag(t, ECHO) {
        echo(t, b)
    }
}

/// px26: the signals keys have raised since this was last asked (bit
/// n - 1 for signal n), for kernel/interrupts to hand to kernel/signal.
pub fn take_signals(t: u64) -> u64 {
    let m = sv(t, C_SIGNALS)
    if m != 0 {
        put_sv(t, C_SIGNALS, 0)
    }
    m
}

/// px28: how many keys have raised a signal since boot (Ctrl-C,
/// Ctrl-\ and Ctrl-Z, through COM1 or the keyboard), whether or not
/// a process was there to receive it.
pub fn signal_keys() -> u64 {
    sv(CON, C_SIG_KEYS)
}

/// px59: the screen's answers to a program's queries (kernel/screen's
/// `answer`: DA1's `ESC [ ? 6 c`, the cursor-position report), typed
/// into the input through the line discipline as a Linux VT types its
/// own (so canonical mode echoes `^[[?6c` there as here) — when the
/// person is at the screen, the keyboard being the device input last
/// came from (`typed_at`, C_SRC 2). Before any input, and after COM1's,
/// they are dropped and counted: a serial terminal answers for itself
/// (two answers would reach the program), and pelt, once answered,
/// asks before every prompt, so an answer at boot would change every
/// session typed over COM1 (R-px59-4). kernel/user calls this after
/// every write to the console; `readable` and `read` too. True when
/// bytes were typed (a waiting reader to wake).
pub fn answered() -> bool {
    var any = false
    var b = screen.answer()
    while b < 256 {
        if sv(CON, C_STARTED) != 0 && sv(CON, C_SRC) == 2 {
            input(CON, b)
            bump(CON, C_ANSWERS)
            any = true
        } else {
            bump(CON, C_UNANSWERED)
        }
        b = screen.answer()
    }
    any
}

/// px59: the bytes of the screen's answers typed, and dropped, since
/// boot (`answers <typed> typed, <dropped> dropped`).
pub fn answers() -> (u64, u64) {
    (sv(CON, C_ANSWERS), sv(CON, C_UNANSWERED))
}

/// Whether there is something for a `read` to take: data, or a pending
/// end of file. px46: not "a read would not wait": with VMIN 0 a read
/// answers 0 at once, but `poll` and `select` still wait for a byte, as
/// Linux's terminal does (measured: notes/px46-the-accounts.md §B), and
/// pelt's editor polls before it reads.
/// px111: in non-canonical mode with VMIN above 0 and VTIME 0, VMIN
/// bytes (measured: two bytes with VMIN 3 are not readable under poll,
/// with VTIME 5 they are); a hung-up slave always (its reads answer end
/// of file).
pub fn readable(t: u64) -> bool {
    if t == CON && sv(t, C_STARTED) == 0 {
        return true
    }
    if hung(t) {
        return true
    }
    if t == CON {
        let _a = answered()
    }
    let r = sv(t, C_R)
    let c = sv(t, C_C)
    if c > r {
        if !lflag(t, ICANON) && cc(t, VTIME) == 0 && cc(t, VMIN) > 1 {
            return c - r >= cc(t, VMIN)
        }
        return true
    }
    sv(t, C_EOF) == r + 1
}

/// `read(fd, buf, n)` on terminal `t`: the count, 0 at end of file,
/// `RESTART` to wait, -EAGAIN for a non-blocking descriptor with
/// nothing ready, -EFAULT. px46: `until` is the calling thread's
/// deadline word (0: this read has not waited yet); the second value is
/// what that word must hold after the call. With VMIN 0 and VTIME above
/// 0 and nothing ready, the first run sets a deadline VTIME tenths of a
/// second away and answers `TIMED`, and a run past it answers 0.
pub fn read(t: u64, pml4: u64, buf: u64, n: u64, nonblock: bool, until: u64) -> (u64, u64) {
    if t == CON && sv(t, C_STARTED) == 0 {
        return (0, 0) // px12: end of file until the console is started
    }
    if hung(t) {
        return (0, 0) // px111: a hung-up slave reads end of file (measured, again and again)
    }
    if t == CON {
        let _a = answered()
    }
    let r = sv(t, C_R)
    let c = sv(t, C_C)
    if c == r {
        if sv(t, C_EOF) == r + 1 {
            put_sv(t, C_EOF, 0)
            bump(t, C_READS)
            return (0, 0)
        }
        if !lflag(t, ICANON) && cc(t, VMIN) == 0 {
            let vt = cc(t, VTIME)
            if vt != 0 && !nonblock {
                let now = timer.ticks()
                if until == 0 {
                    // The tick after: a partial tick never shortens a wait.
                    return (TIMED, now + (vt * 100000000 + NS_PER_TICK - 1) / NS_PER_TICK + 1)
                }
                if now < until {
                    return (TIMED, until)
                }
            }
            bump(t, C_READS)
            return (0, 0)
        }
        if nonblock {
            return (NEG_EAGAIN, 0)
        }
        bump(t, C_WAITS)
        return (RESTART, 0)
    }
    if n == 0 {
        return (0, 0)
    }
    var k = c - r
    if lflag(t, ICANON) {
        var i: u64 = 0
        while i < k && ring(t, r + i) != 10 {
            i += 1
        }
        if i < k {
            k = i + 1
        }
    } else {
        // px48 (pax#66): VMIN m above 0 waits for min(m, n) bytes; with
        // VTIME t above 0, a read that has some answers them once t
        // tenths of a second pass after the last byte came (termios(3),
        // measured: notes/px48-job-control.md §F).
        let m = cc(t, VMIN)
        let want = if m < n { m } else { n }
        if m > 0 && k < want && !nonblock {
            let vt = cc(t, VTIME)
            if vt == 0 {
                bump(t, C_WAITS)
                return (RESTART, 0)
            }
            let end = sv(t, C_LAST) + (vt * 100000000 + NS_PER_TICK - 1) / NS_PER_TICK + 1
            if timer.ticks() < end {
                return (TIMED, end)
            }
        }
    }
    if k > n {
        k = n
    }
    if !uaccess.writable(pml4, buf, k) {
        return (NEG_EFAULT, 0)
    }
    var j: u64 = 0
    while j < k {
        uaccess.put(pml4, buf + j, ring(t, r + j), 1)
        j += 1
    }
    put_sv(t, C_R, r + k)
    if sv(t, 31) != 0 && sv(t, 32) == 0 { put_sv(t, 32, timer.ticks() + 1) }
    bump(t, C_READS)
    (k, 0)
}

// --- the terminal's ioctls ----------------------------------------------

pub fn termios_out(t: u64, pml4: u64, arg: u64) -> u64 {
    if !uaccess.writable(pml4, arg, TERMIOS_BYTES) {
        return NEG_EFAULT
    }
    uaccess.put(pml4, arg, sv(t, C_IFLAG), 4)
    uaccess.put(pml4, arg + 4, sv(t, C_OFLAG), 4)
    uaccess.put(pml4, arg + 8, sv(t, C_CFLAG), 4)
    uaccess.put(pml4, arg + 12, sv(t, C_LFLAG), 4)
    uaccess.put(pml4, arg + 16, sv(t, C_LINE), 1)
    uaccess.put(pml4, arg + 17, sv(t, C_CC), 8)
    uaccess.put(pml4, arg + 25, sv(t, C_CC + 1), 8)
    uaccess.put(pml4, arg + 33, sv(t, C_CC + 2), 3)
    0
}

pub fn termios_in(t: u64, pml4: u64, arg: u64, flush: bool) -> u64 {
    if !uaccess.readable(pml4, arg, TERMIOS_BYTES) {
        return NEG_EFAULT
    }
    let was_canon = lflag(t, ICANON)
    put_sv(t, C_IFLAG, uaccess.get(pml4, arg, 4))
    put_sv(t, C_OFLAG, uaccess.get(pml4, arg + 4, 4))
    put_sv(t, C_CFLAG, uaccess.get(pml4, arg + 8, 4))
    put_sv(t, C_LFLAG, uaccess.get(pml4, arg + 12, 4))
    put_sv(t, C_LINE, uaccess.get(pml4, arg + 16, 1))
    put_sv(t, C_CC, uaccess.get(pml4, arg + 17, 8))
    put_sv(t, C_CC + 1, uaccess.get(pml4, arg + 25, 8))
    put_sv(t, C_CC + 2, uaccess.get(pml4, arg + 33, 3))
    if flush {
        put_sv(t, C_R, sv(t, C_E))
        put_sv(t, C_C, sv(t, C_E))
        put_sv(t, C_EOF, 0)
        if t != CON {
            put_sv(t, C_IQ_R, sv(t, C_IQ_W)) // px111: and what waits for the line discipline
        }
    } else if was_canon && !lflag(t, ICANON) {
        commit(t) // the line being edited becomes readable bytes
    }
    if t != CON {
        if sv(t, C_IFLAG) & IXON == 0 {
            put_sv(t, C_STOP, 0) // px111: IXON cleared lets held output go
        }
        let _m = feed(t)
    }
    0
}

/// px45: whether the console is the calling process's controlling
/// terminal; px48: kernel/sched's sessions (`self_tty`). kernel/user
/// asks it before the speaker's ioctls, which Linux gives only to the
/// privileged and to a terminal's own session (measured,
/// notes/px45/devs.c under tools/linux-sound: a user on its controlling
/// terminal 0, on a virtual terminal that is not its controlling
/// terminal -EPERM, whether or not it owns it).
pub fn controlling() -> bool {
    sched.self_tty()
}

/// px48: what the console's background rules say to the running
/// process (XBD 11.1.4, termios(3)'s TOSTOP, measured on Linux:
/// notes/px48-job-control.md §D). Nothing to a process whose
/// controlling terminal the console is not, or that is in the
/// foreground group. `kind` J_READ: SIGTTIN for the caller's group
/// (`JOB_STOP`), or -EIO when the caller blocks or ignores it or its
/// group is orphaned. J_WRITE: with TOSTOP set, SIGTTOU likewise, but a
/// caller that blocks or ignores it writes. J_SET (a setting changed:
/// TCSETS*, TIOCSPGRP): SIGTTOU whatever TOSTOP says, by the same rule.
/// 0: go ahead.
pub const J_READ: u64 = 1
pub const J_WRITE: u64 = 2
pub const J_SET: u64 = 3

pub fn job(t: u64, kind: u64) -> u64 {
    if (t == CON && sv(t, C_STARTED) == 0) || sched.self_ctty() != t {
        return 0
    }
    let g = sched.self_pgid()
    if g == sched.tty_pgrp_of(t) {
        return 0
    }
    if kind == J_WRITE && !lflag(t, TOSTOP) {
        return 0
    }
    let sig = if kind == J_READ { SIGTTIN } else { SIGTTOU }
    if sched.self_refuses(sig) {
        return if kind == J_READ { NEG_EIO } else { 0 }
    }
    if sched.self_orphaned() || sched.self_pid() == 1 {
        return NEG_EIO
    }
    let _n = sched.raise_pgrp(g, sig, sched.sig_info(sched.I_KERNEL, 0, 0, 0))
    sched.self_rewound()
    JOB_STOP
}

/// px48: an int the caller gives (TIOCSPGRP's), or None-ish: (ok, v).
fn int_in(pml4: u64, arg: u64) -> (bool, u64) {
    if !uaccess.readable(pml4, arg, 4) {
        return (false, 0)
    }
    (true, uaccess.get(pml4, arg, 4))
}

/// px111: TIOCSPGRP on terminal `t` by the running process (through
/// the slave or the master: measured, the same), `arg` its user int:
/// the result for %rax.
pub fn set_pgrp(t: u64, pml4: u64, arg: u64) -> u64 {
    if sched.self_ctty() != t {
        return NEG_ENOTTY
    }
    let j = job(t, J_SET)
    if j == NEG_EIO {
        return NEG_ENOTTY // measured: an orphaned background group is told -ENOTTY
    }
    if j != 0 {
        return j
    }
    let (ok, v) = int_in(pml4, arg)
    if !ok {
        return NEG_EFAULT
    }
    if v >= 0x80000000 {
        return NEG_EINVAL
    }
    if !sched.group_exists(v, 0) {
        return NEG_ESRCH
    }
    if !sched.group_exists(v, sched.tty_session_of(t)) {
        return NEG_EPERM
    }
    sched.set_tty_pgrp_of(t, v)
    0
}

/// px111: TIOCSWINSZ on terminal `t` (its slave or its master): the
/// size from user `arg`; a new one is SIGWINCH for the foreground group
/// of the session that holds the terminal (px48, measured on a pty: a
/// change of the pixel fields alone counts, the same size again sends
/// nothing, a terminal no session holds signals nobody).
pub fn set_winsz(t: u64, pml4: u64, arg: u64) -> u64 {
    if !uaccess.readable(pml4, arg, 8) {
        return NEG_EFAULT
    }
    let w = uaccess.get(pml4, arg, 8)
    let old = sv(t, C_WINSZ)
    put_sv(t, C_WINSZ, w)
    let g = sched.tty_pgrp_of(t)
    if w != old && g != 0 && sched.tty_session_of(t) != 0 {
        let _n = sched.raise_pgrp(g, SIGWINCH, sched.sig_info(sched.I_KERNEL, 0, 0, 0))
    }
    0
}

/// px111: the signals the keys written into pty slave `t` raised, raised
/// now for its foreground group (a system call's, where the console's
/// wait for kernel/interrupts' tick: kernel/signal's `tty`).
pub fn pty_signals(t: u64) {
    let m = take_signals(t)
    let g = sched.tty_pgrp_of(t)
    if m == 0 || g == 0 || sched.tty_session_of(t) == 0 {
        return
    }
    var sig: u64 = 1
    while sig <= 32 {
        if m & (1 << (sig - 1)) != 0 {
            let _n = sched.raise_pgrp(g, sig, sched.sig_info(sched.I_KERNEL, 0, 0, 0))
        }
        sig += 1
    }
}

/// A terminal ioctl on terminal `t` (the console, or a pty's slave) by
/// the process whose area is `a`: the result for %rax, or `REFUSED` for
/// a request PAX does not answer. -ENOTTY for everything before `start`
/// (px12's console); px111: -EIO for everything on a hung-up slave
/// (measured). px48: the controlling terminal's requests (TIOCSCTTY,
/// TIOCNOTTY, TIOCGPGRP, TIOCSPGRP, TIOCGSID: -ENOTTY to a process whose
/// controlling terminal `t` is not, but TIOCSCTTY), and the background
/// rule for a setting (`job`).
pub fn ioctl(t: u64, a: u64, pml4: u64, req: u64, arg: u64) -> u64 {
    if t == CON && sv(t, C_STARTED) == 0 {
        return NEG_ENOTTY
    }
    if hung(t) {
        return NEG_EIO
    }
    if req == TCGETS {
        return termios_out(t, pml4, arg)
    }
    if req == TCSETS || req == TCSETSW || req == TCSETSF {
        let j = job(t, J_SET)
        if j != 0 {
            return j
        }
        let r = termios_in(t, pml4, arg, req == TCSETSF)
        if t != CON {
            sched.wake_pipes()
        }
        return r
    }
    if req == TCFLSH {
        // px49 (pax#74): tcflush(3). The background rule first (measured:
        // SIGTTOU, as TCSETS); TCIFLUSH and TCIOFLUSH discard what was
        // typed and not read, the line being edited too (px111: and on a
        // pty what waits for the line discipline); TCOFLUSH has nothing
        // to discard (the console's output is written as it is asked
        // for; a slave's is the master's once written, measured); any
        // other -EINVAL.
        let j = job(t, J_SET)
        if j != 0 {
            return j
        }
        let q = arg & 0xffffffff
        if q > TCIOFLUSH {
            return NEG_EINVAL
        }
        if q == TCIFLUSH || q == TCIOFLUSH {
            put_sv(t, C_R, sv(t, C_E))
            put_sv(t, C_C, sv(t, C_E))
            put_sv(t, C_EOF, 0)
            if t != CON {
                put_sv(t, C_IQ_R, sv(t, C_IQ_W))
                sched.wake_pipes()
            }
        }
        return 0
    }
    if req == TCSBRK {
        // px49: tcdrain (arg not 0) and tcsendbreak (arg 0), after the
        // background rule (measured: SIGTTOU for both). Nothing waits to
        // be drained (writes are synchronous) and no break is put on
        // COM1 (named: Linux's pseudo-terminal, the reference, answers 0
        // at once too).
        let j = job(t, J_SET)
        if j != 0 {
            return j
        }
        return 0
    }
    if req == FIONREAD {
        // px111: the bytes a read would find (in canonical mode the
        // whole lines: a line being edited is not counted, measured).
        if !uaccess.writable(pml4, arg, 4) {
            return NEG_EFAULT
        }
        uaccess.put(pml4, arg, sv(t, C_C) - sv(t, C_R), 4)
        return 0
    }
    if req == TIOCOUTQ {
        // px111: nothing waits to be sent (measured on a pty: 0 with the
        // master's bytes unread too).
        if !uaccess.writable(pml4, arg, 4) {
            return NEG_EFAULT
        }
        uaccess.put(pml4, arg, 0, 4)
        return 0
    }
    if req == TIOCSTI {
        // px49: a byte put in the input as if it had been typed (echoed,
        // edited, a line committed, by the line discipline). Measured on
        // Linux with dev.tty.legacy_tiocsti 0, PAX's fixed setting: -EIO
        // to anyone not privileged, before anything else; the privileged
        // may put a byte in a terminal that is not their own; a bad
        // pointer -EFAULT. A key that raises a signal is raised at the
        // next interrupt (named; px111: on a pty at once).
        if !cred.privileged(a) {
            return NEG_EIO
        }
        if !uaccess.readable(pml4, arg, 1) {
            return NEG_EFAULT
        }
        input(t, uaccess.get(pml4, arg, 1))
        if t != CON {
            pty_signals(t)
            sched.wake_pipes()
        } else if readable(t) {
            let _n = sched.wake_input()
        }
        return 0
    }
    if req == 0x80045430 || req == 0x40045431 || req == 0x80045439 {
        // px111: TIOCGPTN, TIOCSPTLCK, TIOCGPTLCK are a master's: -ENOTTY
        // on a terminal (measured on a slave), as Linux answers
        return NEG_ENOTTY
    }
    if req == TIOCSCTTY {
        // ioctl_tty(2): a session leader with no controlling terminal
        // takes it; another session's, only with arg 1 by the privileged.
        return if sched.take_tty_of(t, (arg & 0xffffffff) == 1 && cred.privileged(a)) == 0 { 0 } else { NEG_EPERM }
    }
    if req == TIOCNOTTY {
        return if sched.drop_tty_of(t) == 0 { 0 } else { NEG_ENOTTY }
    }
    if req == TIOCGPGRP || req == TIOCGSID {
        if sched.self_ctty() != t {
            return NEG_ENOTTY
        }
        if !uaccess.writable(pml4, arg, 4) {
            return NEG_EFAULT
        }
        uaccess.put(pml4, arg, if req == TIOCGPGRP { sched.tty_pgrp_of(t) } else { sched.tty_session_of(t) }, 4)
        return 0
    }
    if req == TIOCSPGRP {
        return set_pgrp(t, pml4, arg)
    }
    if req == TIOCGWINSZ {
        if !uaccess.writable(pml4, arg, 8) {
            return NEG_EFAULT
        }
        uaccess.put(pml4, arg, sv(t, C_WINSZ), 8)
        return 0
    }
    if req == TIOCSWINSZ {
        return set_winsz(t, pml4, arg)
    }
    if t == CON && speaker.request(req) {
        // px18: KIOCSOUND and KDMKTONE, the console's speaker (kernel/speaker).
        return speaker.ioctl(req, arg, timer.ticks())
    }
    if (req >> 8) & 0xff == 0x45 {
        // px21a: an input-device request (the uapi's EVIOC*, type 'E';
        // a Linux beep program asks EVIOCGSND of the device it was
        // given) is not a terminal's: plain -ENOTTY, as a Linux tty
        // answers (measured on a pty), with nothing to report.
        return NEG_ENOTTY
    }
    REFUSED
}

// --- the keyboard --------------------------------------------------------

/// Scancode set 1's make code `k` on a US layout, unshifted; 0 for a
/// key that gives no character.
fn key_base(k: u64) -> u64 {
    match k {
        0x01 => 27,
        0x02 => 49,
        0x03 => 50,
        0x04 => 51,
        0x05 => 52,
        0x06 => 53,
        0x07 => 54,
        0x08 => 55,
        0x09 => 56,
        0x0a => 57,
        0x0b => 48,
        0x0c => 45,
        0x0d => 61,
        0x0e => 127,
        0x0f => 9,
        0x10 => 113,
        0x11 => 119,
        0x12 => 101,
        0x13 => 114,
        0x14 => 116,
        0x15 => 121,
        0x16 => 117,
        0x17 => 105,
        0x18 => 111,
        0x19 => 112,
        0x1a => 91,
        0x1b => 93,
        0x1c => 13,
        0x1e => 97,
        0x1f => 115,
        0x20 => 100,
        0x21 => 102,
        0x22 => 103,
        0x23 => 104,
        0x24 => 106,
        0x25 => 107,
        0x26 => 108,
        0x27 => 59,
        0x28 => 39,
        0x29 => 96,
        0x2b => 92,
        0x2c => 122,
        0x2d => 120,
        0x2e => 99,
        0x2f => 118,
        0x30 => 98,
        0x31 => 110,
        0x32 => 109,
        0x33 => 44,
        0x34 => 46,
        0x35 => 47,
        0x37 => 42,
        0x39 => 32,
        0x4a => 45,
        0x4e => 43,
        _ => 0,
    }
}

/// What Shift makes of the unshifted character `c` (a letter is
/// upper-cased by the caller).
fn shifted(c: u64) -> u64 {
    match c {
        49 => 33, // 1 !
        50 => 64, // 2 @
        51 => 35, // 3 #
        52 => 36, // 4 $
        53 => 37, // 5 %
        54 => 94, // 6 ^
        55 => 38, // 7 &
        56 => 42, // 8 *
        57 => 40, // 9 (
        48 => 41, // 0 )
        45 => 95, // - _
        61 => 43, // = +
        91 => 123, // [ {
        93 => 125, // ] }
        59 => 58, // ; :
        39 => 34, // ' "
        96 => 126, // ` ~
        92 => 124, // \ |
        44 => 60, // , <
        46 => 62, // . >
        47 => 63, // / ?
        _ => c,
    }
}

fn is_lower(c: u64) -> bool {
    c >= 97 && c <= 122
}

/// px58: an E0-prefixed set-1 make code's CSI sequence, as a Linux
/// virtual terminal sends it (measured black-box, notes/px58 §E): the
/// arrows `ESC [ A` to `ESC [ D` (the final byte), Home, Insert, Delete,
/// End, PgUp and PgDn `ESC [ 1 ~` to `ESC [ 6 ~` (the digit, with 0x100
/// for the `~`); 0 for any other key, which gives nothing. Modifiers
/// change none of them (named).
fn cursor_key(k: u64) -> u64 {
    match k {
        0x4c => 71, // keypad centre: CSI G
        0x48 => 65, // up
        0x50 => 66, // down
        0x4d => 67, // right
        0x4b => 68, // left
        0x47 => 0x100 + 49, // Home
        0x52 => 0x100 + 50, // Insert
        0x53 => 0x100 + 51, // Delete
        0x4f => 0x100 + 52, // End
        0x49 => 0x100 + 53, // PgUp
        0x51 => 0x100 + 54, // PgDn
        _ => 0,
    }
}

/// px59: function key `n` (1-20)'s sequence after `ESC [`, as a Linux
/// VT gives it (notes/px59/vt.rows, vt2.rows; console_codes(4) and
/// terminfo's `linux` entry agree): F1-F5 `[ A` to `[ E` (0x100 marks the
/// second `[`), F6-F20 the number then `~`; 0 for none.
fn fkey(n: u64) -> u64 {
    match n {
        1 => 0x100 + 65,
        2 => 0x100 + 66,
        3 => 0x100 + 67,
        4 => 0x100 + 68,
        5 => 0x100 + 69,
        6 => 17,
        7 => 18,
        8 => 19,
        9 => 20,
        10 => 21,
        11 => 23,
        12 => 24,
        13 => 25,
        14 => 26,
        15 => 28,
        16 => 29,
        17 => 31,
        18 => 32,
        19 => 33,
        20 => 34,
        _ => 0,
    }
}

/// The function key a set-1 make code (no E0) is: F1-F10 0x3b-0x44, F11
/// 0x57, F12 0x58; 0 for another key.
fn fkey_number(k: u64) -> u64 {
    if k >= 0x3b && k <= 0x44 {
        k - 0x3a
    } else if k == 0x57 {
        11
    } else if k == 0x58 {
        12
    } else {
        0
    }
}

/// `v` (< 100) in decimal through the line discipline.
fn input_dec(v: u64) {
    if v >= 10 {
        input(CON, 48 + v / 10)
    }
    input(CON, 48 + v % 10)
}

/// px59: function key `k` (its make code) with the modifiers held, as
/// the measured VT gives it: Shift makes F1-F10 the VT's F11-F20 (F11
/// and F12 stay themselves), Ctrl changes nothing, and any Alt (a VT's
/// console switch) or Shift with Ctrl gives nothing.
fn function_key(k: u64, keys: u64) {
    var n = fkey_number(k)
    let shift = keys & (K_LSHIFT | K_RSHIFT) != 0
    let ctrl = keys & (K_LCTRL | K_RCTRL) != 0
    if keys & (K_LALT | K_RALT) != 0 || (shift && ctrl) {
        return
    }
    if shift && n <= 10 {
        n += 10
    }
    let f = fkey(n)
    bump(CON, C_RX_KBD)
    input(CON, 27)
    input(CON, 91)
    if f > 0xff {
        input(CON, 91)
        input(CON, f & 0xff)
    } else {
        input_dec(f)
        input(CON, 126)
    }
}

/// The numeric keypad's digit; 16 marks a non-digit scan code.
fn keypad_digit(k: u64) -> u64 {
    match k {
        0x52 => 0, 0x4f => 1, 0x50 => 2, 0x51 => 3, 0x4b => 4,
        0x4c => 5, 0x4d => 6, 0x47 => 7, 0x48 => 8, 0x49 => 9,
        _ => 16,
    }
}

/// Character entry is completed on Alt release, not on a digit's make.
/// A bounded 32-bit accumulator cannot overflow the kernel's arithmetic.
fn entry_digit(digit: u64, base: u64) {
    let value = ((sv(CON, C_ENTRY) & 0xffffffff) * base + digit) & 0xffffffff
    put_sv(CON, C_ENTRY, value | 0x100000000)
}

fn finish_entry() {
    let pending = sv(CON, C_ENTRY)
    put_sv(CON, C_ENTRY, 0)
    if pending & 0x100000000 == 0 { return }
    let cp = pending & 0xffffffff
    if cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff) { return }
    bump(CON, C_RX_KBD)
    if cp < 0x80 { input(CON, cp) }
    else if cp < 0x800 {
        input(CON, 0xc0 | (cp >> 6)); input(CON, 0x80 | (cp & 63))
    } else if cp < 0x10000 {
        input(CON, 0xe0 | (cp >> 12)); input(CON, 0x80 | ((cp >> 6) & 63)); input(CON, 0x80 | (cp & 63))
    } else {
        input(CON, 0xf0 | (cp >> 18)); input(CON, 0x80 | ((cp >> 12) & 63))
        input(CON, 0x80 | ((cp >> 6) & 63)); input(CON, 0x80 | (cp & 63))
    }
}

/// Shared navigation mapping. Shift+PgUp/PgDn is suppressed only for the
/// extended editing block, not for the keypad (measured in keys-hex.rows).
fn navigation_key(k: u64, keys: u64, keypad: bool) {
    let f = cursor_key(k)
    if f == 0 { return }
    let shift = keys & (K_LSHIFT | K_RSHIFT) != 0
    let ctrl = keys & (K_LCTRL | K_RCTRL) != 0
    let alt = keys & K_LALT != 0
    if !keypad && f > 0xff && shift && (k == 0x49 || k == 0x51) { return }
    var m: u64 = 1
    if f >= 65 && f <= 68 {
        m = 1 + (if shift { 1 } else { 0 }) + (if alt { 2 } else { 0 }) + (if ctrl { 4 } else { 0 })
        if m == 3 && (k == 0x4b || k == 0x4d) { return }
    }
    bump(CON, C_RX_KBD)
    input(CON, 27); input(CON, 91)
    if m > 1 { input(CON, 49); input(CON, 59); input(CON, 48 + m) }
    input(CON, f & 0xff)
    if f > 0xff { input(CON, 126) }
}

/// One byte from the i8042 (set 1).
fn scancode(b: u64) {
    bump(CON, C_SCANCODES)
    var keys = sv(CON, C_KEYS)
    if b == 0xe0 {
        put_sv(CON, C_KEYS, keys | K_E0)
        return
    }
    let ext = keys & K_E0 != 0
    if ext {
        keys = keys - K_E0
    }
    put_sv(CON, C_KEYS, keys)
    key_event((b & 0x7f) | (if ext { 0x100 } else { 0 }), b & 0x80 == 0, false)
}

/// One physical key through the shared character/sequence table. USB input
/// never manufactures i8042 bytes or increments its scancode counter.
/// The adapters retain separate modifier state; unplugging USB cannot release
/// a Shift still held on PS/2. Caller holds IF clear.
pub fn key_event(code: u64, pressed: bool, usb: bool) {
    if sv(CON, C_STARTED) == 0 || code == 0 { return }
    pointer_drain() // px117: the reports the pointers sent before this key go first
    typed_at(2)
    if usb && pressed && sv(CON, 31) == 0 { put_sv(CON, 31, timer.ticks() + 1) }
    let state = if usb { 30 } else { C_KEYS }
    var keys = sv(CON, state)
    let ext = code & 0x100 != 0
    let brk = !pressed
    let k = code & 0x7f
    var bit: u64 = 0
    if k == 0x2a && !ext {
        bit = K_LSHIFT
    } else if k == 0x36 && !ext {
        bit = K_RSHIFT
    } else if k == 0x1d {
        bit = if ext { K_RCTRL } else { K_LCTRL }
    } else if k == 0x38 {
        bit = if ext { K_RALT } else { K_LALT } // px59
    }
    if bit != 0 {
        if brk {
            if keys & bit != 0 {
                keys = keys - bit
            }
        } else {
            keys = keys | bit
        }
        put_sv(CON, state, keys)
        if brk && (bit == K_LALT || bit == K_RALT) { finish_entry() }
        return
    }
    keys = sv(CON, C_KEYS) | sv(CON, 30)
    if k == 0x45 && !ext {
        if !brk { put_sv(CON, C_KEYS, sv(CON, C_KEYS) ^ K_NUM) }
        return
    }
    if k == 0x3a && !ext {
        if !brk { put_sv(CON, C_KEYS, sv(CON, C_KEYS) ^ K_CAPS) }
        return
    }
    if brk {
        return
    }
    var c: u64 = 0
    if ext {
        if k == 0x1c {
            c = 13 // keypad Enter
        } else if k == 0x35 {
            c = 47 // keypad /
        } else {
            navigation_key(k, keys, false)
            return
        }
    } else {
        let digit = keypad_digit(k)
        let alt = keys & (K_LALT | K_RALT) != 0
        let modified = keys & (K_LSHIFT | K_RSHIFT | K_LCTRL | K_RCTRL) != 0
        if digit < 10 && alt {
            if !modified { entry_digit(digit, if keys & K_RALT != 0 { 16 } else { 10 }) }
            return
        }
        if digit < 10 || k == 0x53 {
            if keys & K_NUM == 0 { navigation_key(k, keys, true) }
            else { bump(CON, C_RX_KBD); input(CON, if k == 0x53 { 46 } else { 48 + digit }) }
            return
        }
        c = key_base(k)
        if keys & K_RALT != 0 {
            if c >= 97 && c <= 102 {
                if !modified { entry_digit(c - 97 + 10, 16) }
                return
            }
            if c >= 48 && c <= 57 {
                if modified { return }
                c = match c {
                    48 => 125, 50 => 64, 52 => 36, 55 => 123, 56 => 91, 57 => 93,
                    _ => 0,
                }
            }
        }
        if c == 0 && fkey_number(k) != 0 {
            function_key(k, keys)
            return
        }
    }
    if c == 0 {
        return
    }
    // px59 (R-px59-2): left Alt sends ESC before the key's character, as
    // the VT's Meta does; with Shift too it gives nothing (measured on
    // `a` and `1`); the keypad's keys take no prefix (keypad Enter
    // measured). Right Alt's hexadecimal entry and symbols were handled
    // above; other character keys retain their measured normal mapping.
    let meta = keys & K_LALT != 0 && !ext && k != 0x37 && k != 0x4a && k != 0x4e
    if meta && keys & (K_LSHIFT | K_RSHIFT) != 0 {
        return
    }
    let shift = keys & (K_LSHIFT | K_RSHIFT) != 0
    if is_lower(c) {
        let caps = keys & K_CAPS != 0
        if shift != caps {
            c = c - 32
        }
    } else if shift {
        c = shifted(c)
    }
    if keys & (K_LCTRL | K_RCTRL) != 0 {
        if is_lower(c) {
            c = c - 96
        } else if c >= 64 && c <= 95 {
            c = c - 64
        } else if c == 63 {
            c = 127
        }
    }
    bump(CON, C_RX_KBD)
    if meta {
        input(CON, 27)
    }
    input(CON, c)
}

/// Wait for the i8042's input buffer to drain (status bit 1 clear).
fn kbd_wait_in() -> bool {
    var n: u64 = 0
    while n < POLLS {
        if inp(KBD_CMD) & KBD_IBF == 0 {
            return true
        }
        n += 1
    }
    false
}

/// Wait for a byte from the i8042 (status bit 0 set).
fn kbd_wait_out() -> bool {
    var n: u64 = 0
    while n < POLLS {
        if inp(KBD_CMD) & KBD_OBF != 0 {
            return true
        }
        n += 1
    }
    false
}

fn kbd_flush() {
    var n: u64 = 0
    while n < 64 && inp(KBD_CMD) & KBD_OBF != 0 {
        let _b = inp(KBD_DATA)
        n += 1
    }
}

/// Set the i8042 up for set-1 interrupts on its first port. Records the
/// configuration byte before and after; 0x100 + status when there is no
/// controller (status 0xff) or it does not answer.
fn kbd_start() {
    let st = inp(KBD_CMD)
    if st == 0xff {
        put_sv(CON, C_KBD_BEFORE, 0x100 + st)
        put_sv(CON, C_KBD_AFTER, 0x100 + st)
        return
    }
    kbd_flush()
    if !kbd_wait_in() {
        put_sv(CON, C_KBD_BEFORE, 0x200)
        return
    }
    out(KBD_CMD, 0x20) // read the configuration byte
    if !kbd_wait_out() {
        put_sv(CON, C_KBD_BEFORE, 0x300)
        put_sv(CON, C_KBD_AFTER, 0x300)
        return
    }
    let cfg = inp(KBD_DATA)
    put_sv(CON, C_KBD_BEFORE, cfg)
    // bit 0 on (port 1 interrupt), bit 1 off (port 2 interrupt), bit 4
    // off (port 1 clock enabled), bit 6 on (translation to set 1).
    var want = cfg | 0x41
    if want & 0x02 != 0 {
        want = want - 0x02
    }
    if want & 0x10 != 0 {
        want = want - 0x10
    }
    let _w1 = kbd_wait_in()
    out(KBD_CMD, 0x60) // write the configuration byte
    let _w2 = kbd_wait_in()
    out(KBD_DATA, want)
    let _w3 = kbd_wait_in()
    out(KBD_CMD, 0xae) // enable the first port
    let _w4 = kbd_wait_in()
    out(KBD_CMD, 0x20)
    if kbd_wait_out() {
        put_sv(CON, C_KBD_AFTER, inp(KBD_DATA))
    } else {
        put_sv(CON, C_KBD_AFTER, 0x300)
    }
    kbd_flush()
}

// --- start, the interrupt, the reports ------------------------------------

/// Start the console's input: the terminal's settings (a Linux
/// pseudo-terminal's, less IXON; the window size the screen's
/// grid when the screen is attached, px19), COM1's receiver, the i8042,
/// and their two 8259 lines. After kernel/timer's `start` (the 8259s
/// remapped) and before interrupts are enabled.
pub fn start() {
    var i: u64 = 0
    while i < 64 {
        put_sv(CON, i, 0)
        i += 1
    }
    defaults(CON)
    if screen.on() {
        // px19: struct winsize {ws_row, ws_col, ws_xpixel, ws_ypixel},
        // four little-endian 16-bit words.
        put_sv(CON, C_WINSZ, screen.rows() | (screen.cols() << 16))
    }
    serial.receive_on()
    kbd_start()
    put_sv(CON, C_STARTED, 1)
    sched.tty_on() // px48: the next process the kernel starts takes it as its controlling terminal
    if serial.available() { timer.unmask(COM1_LINE) }
    if sv(CON, C_KBD_AFTER) < 256 { timer.unmask(KBD_LINE) }
}

/// Whether `start` has run.
pub fn started() -> bool {
    sv(CON, C_STARTED) != 0
}

/// COM1's receive vector, 36: the 8259 master's line 4 once kernel/timer
/// has remapped it.
pub fn com1_vector() -> u64 {
    timer.MASTER_BASE + COM1_LINE
}

/// The i8042 keyboard's vector, 33: the master's line 1.
pub fn kbd_vector() -> u64 {
    timer.MASTER_BASE + KBD_LINE
}

/// Vector 36 or 33 (kernel/interrupts): drain the source into the line
/// discipline, then acknowledge the 8259. kernel/interrupts wakes a
/// waiting reader when `readable` says so.
pub fn irq(v: u64) {
    pointer_drain() // px117: the pointers' reports before these bytes
    if v == com1_vector() {
        var n: u64 = 0
        while serial.ready() && n < 4096 {
            let b = serial.receive()
            bump(CON, C_RX_COM1)
            if sv(CON, C_STARTED) != 0 {
                typed_at(1)
                input(CON, b)
            }
            n += 1
        }
    } else {
        var n: u64 = 0
        while inp(KBD_CMD) & KBD_OBF != 0 && n < 64 {
            let st = inp(KBD_CMD)
            let b = inp(KBD_DATA)
            if st & KBD_AUX == 0 && sv(CON, C_STARTED) != 0 {
                typed_at(2)
                scancode(b)
            }
            n += 1
        }
    }
    timer.eoi(v)
}

/// px48 (pax#68): the window's size follows the device a person types
/// at. PAX's one console is a serial line and, when there is a screen,
/// a screen at once, where Linux has two terminals (ttyS0, answered 0
/// rows 0 columns until someone sets it, and a virtual terminal, its
/// screen's grid). So when input comes from another device than the
/// last input did (`src` 1 COM1, 2 the keyboard), the size becomes that
/// device's: a serial line's 0 by 0 for COM1, the screen's grid for the
/// keyboard; before any input it is the screen's grid when there is a
/// screen (px19). A size a program sets (TIOCSWINSZ) holds until the
/// person moves to the other device. No SIGWINCH is sent for the move
/// (named: no program here redraws for it).
fn typed_at(src: u64) {
    if sv(CON, C_SRC) == src {
        return
    }
    put_sv(CON, C_SRC, src)
    if screen.on() {
        put_sv(CON, C_WINSZ, if src == 1 { 0 } else { screen.rows() | (screen.cols() << 16) })
    }
}

/// `console: com1 irq 4 vector 36, i8042 0x<cfg> -> 0x<cfg> irq 1 vector
/// 33, 8259 master mask 0x<m>; ICANON ECHO, iflag … lflag …`; with no
/// UART (px76: kernel/serial's probe found none, so line 4 stays masked)
/// `console: com1 absent, i8042 …`.
pub fn report() {
    if serial.available() {
        log.put("console: com1 irq 4 vector ")
        log.dec((com1_vector()) as int)
    } else {
        log.put("console: com1 absent")
    }
    log.put(", i8042 ")
    put_hex8(sv(CON, C_KBD_BEFORE))
    log.put(" -> ")
    put_hex8(sv(CON, C_KBD_AFTER))
    log.put(" irq 1 vector ")
    log.dec((kbd_vector()) as int)
    log.put(", 8259 master mask ")
    put_hex8(timer.master_mask())
    log.put("; iflag ")
    put_hex8(sv(CON, C_IFLAG))
    log.put(" oflag ")
    put_hex8(sv(CON, C_OFLAG))
    log.put(" cflag ")
    put_hex8(sv(CON, C_CFLAG))
    log.put(" lflag ")
    put_hex8(sv(CON, C_LFLAG))
    log.end()
}

/// `console: <n> bytes from com1, <k> keys (<s> scancodes) from the
/// keyboard, <r> reads, <w> waited, <d> dropped`.
pub fn summary() {
    log.put("console: ")
    log.dec((sv(CON, C_RX_COM1)) as int)
    log.put(" bytes from com1, ")
    log.dec((sv(CON, C_RX_KBD)) as int)
    log.put(" keys (")
    log.dec((sv(CON, C_SCANCODES)) as int)
    log.put(" scancodes) from the keyboard, ")
    log.dec((sv(CON, C_READS)) as int)
    log.put(" reads, ")
    log.dec((sv(CON, C_WAITS)) as int)
    log.put(" waited, ")
    log.dec((sv(CON, C_DROPPED)) as int)
    log.put(" dropped")
    log.end()
    pointer_summary()
    if sv(CON, 31) != 0 && sv(CON, 32) != 0 {
        log.put("console: usb first read latency ")
        log.dec((sv(CON, 32) - sv(CON, 31)) as int)
        log.line(" ticks (10ms resolution)")
    }
}

// --- px117: the pointer and the mouse's reports ---------------------------

/// px117: the console's reader of kernel/mouse, opened when the first
/// pointer attaches (kernel/xhci, from its enumeration thread: `open`
/// takes a frame, which no tick may), so /dev/mouse0 still appears only
/// once a pointer came (px109's R-3). Later pointers find it open.
pub fn pointer_arrived() {
    if sv(CON, C_MREADER) == 0 {
        put_sv(CON, C_MREADER, mouse.open())
    }
}

/// px117: after a write to the console (kernel/user's `write`, and
/// `put_kernel`): a DECSET of a mouse mode among its bytes makes the
/// writing process the modes' owner.
pub fn after_write() {
    let n = screen.mouse_sets()
    if n != sv(CON, C_MSETS) {
        put_sv(CON, C_MSETS, n)
        put_sv(CON, C_MOWNER, sched.self_pid())
    }
}

/// px117: what a report does now: 0 nothing (no mode served), 1 typed, 2
/// withheld (the owner is not in the console's foreground process group).
/// Modes set outside a console write (an echo) have no owner; modes whose
/// owner has ended (its pid gone or a zombie) end here, counted.
fn reporting() -> u64 {
    let proto = screen.mouse_protocol()
    let enc = screen.mouse_encoding()
    if proto == 0 && enc == 0 {
        return 0
    }
    let n = screen.mouse_sets()
    if n != sv(CON, C_MSETS) {
        put_sv(CON, C_MSETS, n)
        put_sv(CON, C_MOWNER, 0)
    }
    let o = sv(CON, C_MOWNER)
    let s = if o == 0 { sched.SLOTS } else { sched.proc_slot(o) }
    if s == sched.SLOTS || sched.proc_word(s, 8) == 1 {
        screen.mouse_reset()
        put_sv(CON, C_MOWNER, 0)
        if o != 0 {
            bump(CON, C_MENDED)
        }
        return 0
    }
    if proto != 1002 || enc != 1006 {
        return 0
    }
    let fg = sched.tty_pgrp_of(CON)
    if fg != 0 && sched.proc_word(s, 9) != fg {
        return 2
    }
    1
}

fn rd32(a: u64) -> u64 {
    // # Safety: a word of C_MREC, inside pax_con_state.
    unsafe { (a as *u32).read_volatile() as u64 }
}

/// The low `bits` bits of `v` as a two's complement word.
fn signed(v: u64, bits: u64) -> u64 {
    let m = (1 << bits) - 1
    let x = v & m
    if x & (1 << (bits - 1)) != 0 { x | !m } else { x }
}

/// `a < b` as signed words.
fn slt(a: u64, b: u64) -> bool {
    (a ^ 0x8000000000000000) < (b ^ 0x8000000000000000)
}

/// Pixel `p + d` (d a two's complement word, at most 2^31 either way)
/// held to 0 .. `n - 1`, without a wrap (wolf's arithmetic is checked).
fn nudge(p: u64, d: u64, n: u64) -> u64 {
    if slt(d, 0) {
        let back = !d + 1
        return if back >= p { 0 } else { p - back }
    }
    if p + d >= n { n - 1 } else { p + d }
}

/// Pointer `dev`'s buttons are `b` now (`gone`: it left): every pointer's
/// buttons together, HID's buttons 1 to 3.
fn held(dev: u64, b: u64, gone: bool) -> u64 {
    var i: u64 = 0
    var at = PDEVS
    var free = PDEVS
    while i < PDEVS {
        let w = sv(CON, C_PDEV + i)
        if w & 0xffff == dev && at == PDEVS {
            at = i
        } else if w == 0 && free == PDEVS {
            free = i
        }
        i += 1
    }
    if at == PDEVS {
        at = free
    }
    if at < PDEVS {
        put_sv(CON, C_PDEV + at, if gone { 0 } else { dev | (b << 32) })
    }
    var all: u64 = 0
    i = 0
    while i < PDEVS {
        all = all | (sv(CON, C_PDEV + i) >> 32)
        i += 1
    }
    all & 7
}

/// The lowest button of `b` held, as the document numbers it (0 left, 1
/// middle, 2 right; HID's 1, 3, 2); 3 for none.
fn lowest(b: u64) -> u64 {
    if b & 1 != 0 { 0 } else if b & 4 != 0 { 1 } else if b & 2 != 0 { 2 } else { 3 }
}

/// The modifiers the keyboard holds, as the document adds them to Cb:
/// Shift 4, Meta (either Alt) 8, Control 16.
fn mods() -> u64 {
    let k = sv(CON, C_KEYS) | sv(CON, 30)
    let shift: u64 = if k & (K_LSHIFT | K_RSHIFT) != 0 { 4 } else { 0 }
    let meta: u64 = if k & (K_LALT | K_RALT) != 0 { 8 } else { 0 }
    let ctrl: u64 = if k & (K_LCTRL | K_RCTRL) != 0 { 16 } else { 0 }
    shift + meta + ctrl
}

fn digits(v: u64) -> u64 {
    if v >= 10 { 1 + digits(v / 10) } else { 1 }
}

fn input_num(v: u64) {
    if v >= 10 {
        input_num(v / 10)
    }
    input(CON, 48 + v % 10)
}

/// One SGR report, `ESC [ < cb ; col+1 ; row+1 M` (`m` for a release),
/// through the line discipline whole, or counted: withheld (`how` 2) or
/// dropped (the line or the ring has no room for all of it).
fn sgr_report(how: u64, cb: u64, col: u64, row: u64, press: bool) {
    if how == 2 {
        bump(CON, C_MWITHHELD)
        return
    }
    let n = 6 + digits(cb) + digits(col + 1) + digits(row + 1)
    let cap = if lflag(CON, ICANON) { LINE_MAX } else { RING }
    if sv(CON, C_E) - sv(CON, C_R) + n > cap {
        bump(CON, C_MDROPPED)
        return
    }
    input(CON, 27)
    input(CON, 91)
    input(CON, 60)
    input_num(cb)
    input(CON, 59)
    input_num(col + 1)
    input(CON, 59)
    input_num(row + 1)
    input(CON, if press { 77 } else { 109 })
    bump(CON, C_MTYPED)
}

/// One record of the console's reader (C_MREC): the pointer moved, then
/// what the modes say of it reported: a motion into another cell with a
/// button held, each button that changed, the wheel.
fn pointer_record() {
    let cols = screen.cols()
    let rows = screen.rows()
    if cols == 0 || rows == 0 {
        return // no screen: no grid to point at
    }
    let cw = 8 * screen.scale()
    let ch = 16 * screen.scale()
    let w = cols * cw
    let h = rows * ch
    let rec = base(CON) + C_MREC * 8
    let dk = rd32(rec + mouse.R_DEV)
    let dev = dk & 0xffff
    let kind = (dk >> 16) & 0xff
    let flags = (dk >> 24) & 0xff
    let x = signed(rd32(rec + mouse.R_X), 32)
    let y = signed(rd32(rec + mouse.R_Y), 32)
    let bw = rd32(rec + mouse.R_BUTTONS)
    let buttons = bw & 0x1f
    let wheel = signed(bw >> 16, 16)
    let gone = flags & mouse.GONE != 0
    var px = sv(CON, C_PXY) & 0xffffffff
    var py = sv(CON, C_PXY) >> 32
    if sv(CON, C_PSEEN) == 0 {
        px = w / 2
        py = h / 2
    }
    if flags & (mouse.NEW | mouse.GONE) == 0 {
        if kind == mouse.ABS {
            px = (x & 0x7fff) * w / 32768
            py = (y & 0x7fff) * h / 32768
        } else {
            px = nudge(px, x, w)
            py = nudge(py, y, h)
        }
        put_sv(CON, C_PSEEN, 1)
    }
    if px >= w { px = w - 1 }
    if py >= h { py = h - 1 }
    put_sv(CON, C_PXY, px | (py << 32))
    if flags & mouse.NEW != 0 {
        return
    }
    let old = sv(CON, C_PBTN)
    let now = held(dev, buttons, gone)
    put_sv(CON, C_PBTN, now)
    let col = px / cw
    let row = py / ch
    let cell = col | (row << 32)
    let was = sv(CON, C_PCELL)
    put_sv(CON, C_PCELL, cell)
    let how = reporting()
    if how == 0 {
        return
    }
    let m = mods()
    if cell != was && lowest(old) < 3 {
        sgr_report(how, 32 + lowest(old) + m, col, row, true)
    }
    if (old ^ now) & 1 != 0 {
        sgr_report(how, 0 + m, col, row, now & 1 != 0)
    }
    if (old ^ now) & 4 != 0 {
        sgr_report(how, 1 + m, col, row, now & 4 != 0)
    }
    if (old ^ now) & 2 != 0 {
        sgr_report(how, 2 + m, col, row, now & 2 != 0)
    }
    var n: u64 = 0
    let up = !slt(wheel, 0)
    let detents = if up { wheel } else { !wheel + 1 }
    while n < detents && n < 8 {
        sgr_report(how, (if up { 64 } else { 65 }) + m, col, row, true)
        n += 1
    }
}

/// px117: what the console's reader holds, in order (`pointer_record`),
/// then the pointer drawn at its cell. kernel/interrupts' tick, and the
/// start of `key_event` and `irq`: a report before any key that came
/// after it. With nothing waiting, the modes' owner is still looked at
/// (`reporting`), so a dead owner's modes end at the next tick.
pub fn pointer_drain() {
    let r = sv(CON, C_MREADER)
    if r == 0 || sv(CON, C_STARTED) == 0 {
        return
    }
    if mouse.pending(r) == 0 {
        let _how = reporting()
        return
    }
    while mouse.pull(r, base(CON) + C_MREC * 8) {
        pointer_record()
    }
    if sv(CON, C_PSEEN) != 0 {
        let c = sv(CON, C_PCELL)
        screen.pointer(c & 0xffffffff, c >> 32)
    }
}

/// px117: `console: pointer <m> moves, <c> cycles a move (least <l>),
/// reports <t> typed, <w> withheld, <d> dropped, modes ended <e>` — once
/// the console's reader is open (a pointer came).
fn pointer_summary() {
    if sv(CON, C_MREADER) == 0 {
        return
    }
    let (moves, cycles, least) = screen.pointer_cost()
    log.put("console: pointer ")
    log.dec(moves as int)
    log.put(" moves, ")
    log.dec((if moves == 0 { 0 } else { cycles / moves }) as int)
    log.put(" cycles a move (least ")
    log.dec(least as int)
    log.put("), reports ")
    log.dec((sv(CON, C_MTYPED)) as int)
    log.put(" typed, ")
    log.dec((sv(CON, C_MWITHHELD)) as int)
    log.put(" withheld, ")
    log.dec((sv(CON, C_MDROPPED)) as int)
    log.put(" dropped, modes ended ")
    log.dec((sv(CON, C_MENDED)) as int)
    log.end()
}

/// `0x` and the hex digits of `v`, at least two, no other leading zeros.
fn put_hex8(v: u64) {
    log.put("0x")
    var n: u64 = 2
    while n < 16 && (v >> (n * 4)) != 0 {
        n += 1
    }
    while n > 0 {
        n -= 1
        let d = (v >> (n * 4)) & 0xf
        log.put_byte((if d < 10 { d + 48 } else { d + 87 }) as int)
    }
}
