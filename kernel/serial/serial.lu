//! serial — the 16550 UART driver on COM1 (px01, M-PX1).
//!
//! The kernel's console. `init` programs the UART (no interrupts,
//! 115200 baud, 8 data bits, no parity, one stop bit, FIFOs on), proves
//! the chip is there through its scratch register and its loopback
//! mode, and leaves it in normal mode; `put` waits for the transmit
//! holding register to be empty (LSR bit 5) before each byte. All port
//! I/O goes through boot/io.S (`pax_outb`, `pax_inb`): wolf has no
//! inline assembly yet (KWC kw13).
//!
//! px19: every byte `put` writes is handed to kernel/screen first, which
//! draws it once the screen is attached (and keeps it for the replay
//! before): the serial console and the screen show the same bytes.
//!
//! px118: and to kernel/bootlog, which keeps the boot's bytes in memory
//! a warm reset may leave alone (until the first program starts).
//!
//! px129 (R-px129-15): a writer never waits on the UART. Once kernel/console
//! has started (`tx_irq_on`), `put` adds the byte to a transmit ring
//! (boot/io.S's pax_serial_tx, 64 KiB, about 5.7 s of a 115200 line).
//! When the ring was idle it moves what the transmit FIFO takes (LSR bit
//! 5, the FIFO empty: up to 16 bytes); COM1's THRE interrupt (IER bit 1,
//! armed while the ring holds bytes; kernel/console's vector 36 calls
//! `tx_irq`) moves the rest, so while it is armed a byte costs a store
//! and no port access. A full ring drops the byte and counts it
//! (`dropped`). Before that, at boot, `put` waits per byte as it always
//! has (the kernel's own early lines, never a program's). `drain`
//! (kernel/panic's halt, kernel/power's reboot and power-off) sends what
//! the ring holds, waiting. A user program's terminal output (`put_tty`:
//! kernel/user's console `write`, kernel/console's output and echo) is
//! mirrored to COM1 unless the command line says `pax.serial=log`: then
//! COM1 carries the kernel's own lines alone. Under QEMU the FIFO empties
//! as it is written unless the far end pushes back, so the ring stays
//! empty and COM1's bytes are what they were, in order, none dropped.
//!
//! Written from the PC16550D register map (public datasheet facts:
//! the register offsets, the DLAB bit, LCR/FCR/MCR/LSR bit meanings, the
//! 1.8432 MHz clock's divisor 1 for 115200 baud; px129: IER bit 1, the
//! transmitter holding register empty interrupt, raised when the FIFO
//! empties with it enabled and cleared by a write to THR). No Linux source.

use boot_info
use bootlog
use screen

extern "c" fn pax_outb(port: u16, v: u8)
extern "c" fn pax_inb(port: u16) -> u8
extern "c" fn pax_irq_save() -> u64
extern "c" fn pax_irq_restore(flags: u64)
extern "c" let pax_serial_log_count: *u64
extern "c" let pax_serial_log: *u8
extern "c" let pax_serial_tx: *u8

// COM1's I/O base and its registers, as offsets from it (PC16550D).
// Module `const`s since px05 (wolf 0.2.23; 0.2.22 refused them,
// wolf-lang#560, so px01 wrote them as commented literals).
const COM1: int = 0x3f8
const THR: int = 0 // transmit holding (write) / receive buffer (read); DLL under DLAB
const IER: int = 1 // interrupt enable; DLM under DLAB
const FCR: int = 2 // FIFO control (write)
const LCR: int = 3 // line control (bit 7 DLAB)
const MCR: int = 4 // modem control (bit 4 loopback)
const LSR: int = 5 // line status (bit 0 data ready, bit 5 THR empty)
const SCR: int = 7 // scratch
const DLL: int = 0
const DLM: int = 1

const LCR_DLAB: int = 0x80 // offsets 0 and 1 are the divisor latch
const LCR_8N1: int = 0x03 // DLAB off; 8 data bits, no parity, 1 stop bit
const DIVISOR: int = 1 // 115200 baud (1.8432 MHz / 16)
const FCR_ON: int = 0xc7 // FIFOs on, both cleared, receive trigger 14 bytes
const MCR_LOOPBACK: int = 0x1e // loopback, OUT1, OUT2, RTS
const MCR_NORMAL: int = 0x0b // DTR, RTS, OUT2
const LSR_DATA_READY: int = 0x01
const LSR_THR_EMPTY: int = 0x20

// What `init` writes to prove the chip: two scratch patterns and a
// byte sent round the loopback.
const SCRATCH_A: int = 0x5a
const SCRATCH_B: int = 0xa5
const LOOPBACK_BYTE: int = 0xae

// `put` polls LSR at most this many times before giving a byte up: a
// UART that never drains must not hang the kernel (on QEMU the first
// poll succeeds). `init`'s loopback wait has the same bound.
const POLLS: int = 1048576

// Absent hardware reads all ones. Never poll it as a ready UART.
var present: bool = false
pub fn available() -> bool { unsafe { present } }

// px129: the transmit ring (pax_serial_tx): `tx_tail` bytes queued and
// `tx_head` sent since boot, so the ring holds tx_tail - tx_head; `dropped`
// the bytes a full ring refused; `irq_tx` whether `put` queues (after
// kernel/console's start) or waits; `ier` what IER holds; `tty` whether a
// program's terminal output goes to COM1. Touched with IF clear.
const TX_SIZE: u64 = 65536
const TX_FIFO: u64 = 16 // the 16550's transmit FIFO
const IER_TX: int = 0x02 // transmit holding register empty
const DROP_TRY: u64 = 256 // a full ring tries the FIFO once in this many drops
var tx_head: u64 = 0
var tx_tail: u64 = 0
var tx_dropped: u64 = 0
var irq_tx: bool = false
var ier: int = 0
var tty: bool = true

fn out(reg: int, v: int) {
    // # Safety: io.S's `outb` on a COM1 register; the port and the value
    // are in range by construction (the narrowing casts trap otherwise).
    unsafe { pax_outb((COM1 + reg) as u16, v as u8) }
}

fn inp(reg: int) -> int {
    // # Safety: io.S's `inb` on a COM1 register.
    let v = unsafe { pax_inb((COM1 + reg) as u16) }
    v as int
}

/// Initialise COM1: interrupts off, 115200 8N1, FIFOs enabled and
/// cleared, DTR/RTS/OUT2 up. Returns a bit set: 1 if the scratch
/// register holds what was written (a UART is there), 2 if a byte sent
/// in loopback mode came back (the transmitter and receiver work). It
/// never traps.
pub fn init() -> int {
    screen.early_start()
    out(IER, 0) // no interrupts, the kernel polls
    out(LCR, LCR_DLAB)
    out(DLL, DIVISOR)
    out(DLM, 0)
    out(LCR, LCR_8N1)
    out(FCR, FCR_ON)
    var status = 0
    out(SCR, SCRATCH_A)
    if inp(SCR) == SCRATCH_A {
        out(SCR, SCRATCH_B)
        if inp(SCR) == SCRATCH_B {
            status = status + 1
        }
    }
    out(MCR, MCR_LOOPBACK)
    out(THR, LOOPBACK_BYTE)
    var spins = 0
    while inp(LSR) & LSR_DATA_READY == 0 && spins < POLLS {
        spins = spins + 1
    }
    if inp(THR) == LOOPBACK_BYTE { // RBR
        status = status + 2
    }
    out(MCR, MCR_NORMAL)
    let mirrored = !boot_info.cmdline_has("pax.serial=log") // px129: programs' output kept off COM1
    // # Safety: module flags, written here alone, before anything reads them.
    unsafe {
        present = status == 3
        tty = mirrored
    }
    status
}

/// px129: whether a program's terminal output is mirrored to COM1 (no
/// `pax.serial=log` on the command line).
pub fn tty_mirrored() -> bool {
    // # Safety: a module flag written once by `init`.
    unsafe { tty }
}

/// px129: the bytes a full transmit ring refused since boot.
pub fn dropped() -> u64 {
    // # Safety: a module word, read alone.
    unsafe { tx_dropped }
}

fn set_ier(v: int) {
    // # Safety: a module word, written with IF clear (its callers).
    unsafe { ier = v }
    out(IER, v)
}

/// What IER holds (`set_ier` the only writer).
fn ier_held() -> int {
    // # Safety: as `set_ier`.
    unsafe { ier }
}

/// px129: the ring's counts, (sent, queued) since boot: it holds their
/// difference.
fn ring() -> (u64, u64) {
    // # Safety: module words, touched only with IF clear (every caller).
    unsafe { (tx_head, tx_tail) }
}

/// px129: from here `put` queues (kernel/console's `start`, once COM1's
/// interrupt is unmasked): a writer never waits on the UART again.
pub fn tx_irq_on() {
    if !available() { return }
    // # Safety: a module flag, written with IF clear (kernel/console's start).
    unsafe { irq_tx = true }
}

/// px129: what the transmit FIFO takes, from the ring, when LSR says it
/// is empty: up to 16 bytes. IF clear.
fn kick() {
    let (h0, t) = ring()
    if h0 == t || inp(LSR) & LSR_THR_EMPTY == 0 {
        return
    }
    var h = h0
    var n: u64 = 0
    while n < TX_FIFO && h != t {
        // # Safety: h % TX_SIZE lies inside pax_serial_tx (TX_SIZE bytes);
        // io.S's `outb` on COM1's THR.
        unsafe { pax_outb((COM1 + THR) as u16, ((pax_serial_tx as u64 + h % TX_SIZE) as *u8).read_volatile()) }
        h += 1
        n += 1
    }
    // # Safety: a module word, IF clear (the callers).
    unsafe { tx_head = h }
}

/// px129: one byte into the ring (dropped and counted when it is full).
/// While the THRE interrupt is armed it moves the ring and a byte costs a
/// store, no port access; else what the FIFO takes is moved at once and
/// the interrupt armed while bytes wait. A full ring tries the FIFO at its
/// first drop and every 256th after (a lost interrupt never stops COM1
/// for good). Never waits; every byte refused is counted.
fn queue(b: u8) {
    // # Safety: io.S's pushfq and cli; restored below.
    let flags = unsafe { pax_irq_save() }
    let (h, t) = ring()
    let full = t - h >= TX_SIZE
    var try_fifo = false
    if full {
        // # Safety: a module word, IF clear.
        let d = unsafe { tx_dropped } + 1
        // # Safety: as above.
        unsafe { tx_dropped = d }
        // A lost interrupt never stops COM1 for good: the FIFO is tried at
        // the first drop and every 256th after it, so a flood into a full
        // ring costs a port read per 256 bytes, not one a byte (C11).
        try_fifo = d % DROP_TRY == 1
    } else {
        // # Safety: t % TX_SIZE lies inside pax_serial_tx; a module word,
        // IF clear.
        unsafe {
            ((pax_serial_tx as u64 + t % TX_SIZE) as *u8).write_volatile(b)
            tx_tail = t + 1
        }
        try_fifo = ier_held() & IER_TX == 0
    }
    if try_fifo {
        kick()
        let (h2, t2) = ring()
        if h2 != t2 && ier_held() & IER_TX == 0 {
            set_ier(ier_held() | IER_TX)
        }
    }
    // # Safety: the flags pax_irq_save gave above.
    unsafe { pax_irq_restore(flags) }
}

/// px129: COM1's interrupt (kernel/console's vector 36, IF clear): the
/// FIFO refilled from the ring; the THRE interrupt off once it is empty.
pub fn tx_irq() {
    if !available() { return }
    kick()
    let (h, t) = ring()
    if h == t && ier_held() & IER_TX != 0 {
        set_ier(ier_held() & !IER_TX)
    }
}

/// px129: every byte the ring holds sent, waiting on THRE (each wait
/// bounded as `put`'s was): the halt's, the reboot's and the power-off's,
/// so a kernel's last lines reach the wire before it stops.
pub fn drain() {
    if !available() { return }
    // # Safety: io.S's pushfq and cli; restored below.
    let flags = unsafe { pax_irq_save() }
    var guard: u64 = 0
    while guard < TX_SIZE {
        let (h, t) = ring()
        if h == t { break }
        var spins = 0
        while inp(LSR) & LSR_THR_EMPTY == 0 && spins < POLLS {
            spins = spins + 1
        }
        if spins >= POLLS { break }
        kick()
        guard += 1
    }
    // # Safety: the flags pax_irq_save gave above.
    unsafe { pax_irq_restore(flags) }
}

/// Write one byte to the screen (px19, kernel/screen), then to COM1: into
/// the transmit ring once kernel/console has started (px129: `queue`),
/// before that once the transmit holding register is empty; without a
/// UART, into the in-memory transcript. The screen first: when a
/// byte has reached the wire, the screen has already drawn it, so a
/// harness that sees a kernel's last line on the serial port and then
/// finds the machine halted (tools/qemu-halt) never catches the screen
/// still drawing that line. A UART that stays busy for 1048576 polls
/// loses the byte rather than hang the kernel. It never traps.
///
/// px129: the whole body stays here, not behind a helper. A `put` of three
/// calls is small enough for wolf's release tier to inline into kernel/log's
/// `put` and `dec`, which it then inlines, loop and all, at every call
/// (wolf-lang#1104, #983): with `put` split that way the release build of
/// kmain_heap_fault took 603 s against trunk's 488 on one core, its IR 3312
/// back edges against 2900.
pub fn put(b: u8) {
    screen.put(b)
    bootlog.put(b)
    if !available() {
        // px129: the transcript keeps its first 64 KiB; past them a byte
        // costs nothing more here (the count stops at 65537).
        // # Safety: io.S's eight-byte count, read alone (a stale read only
        // sends this byte on to the locked path below).
        if unsafe { pax_serial_log_count.read_volatile() } > 65536 {
            return
        }
        let flags = unsafe { pax_irq_save() }
        let n = unsafe { pax_serial_log_count.read_volatile() }
        if n < 65536 {
            unsafe { ((pax_serial_log as u64 + n) as *u8).write_volatile(b) }
        }
        if n <= 65536 { unsafe { pax_serial_log_count.write_volatile(n + 1) } }
        unsafe { pax_irq_restore(flags) }
        return
    }
    // # Safety: a module flag written once with IF clear.
    if unsafe { irq_tx } {
        queue(b)
        return
    }
    var spins = 0
    while spins < POLLS {
        let lsr = inp(LSR)
        if lsr & LSR_THR_EMPTY != 0 {
            // # Safety: io.S's `outb` on COM1's THR.
            unsafe { pax_outb((COM1 + THR) as u16, b) }
            return
        }
        spins = spins + 1
    }
}

/// px129: a user program's terminal output (kernel/user's console `write`,
/// kernel/console's output and echo): as `put`, but to COM1 only while
/// `tty_mirrored` (without a UART, the transcript as `put`).
pub fn put_tty(b: u8) {
    if tty_mirrored() || !available() {
        put(b)
        return
    }
    screen.put(b)
    bootlog.put(b)
}

// --- receiving (px13) ----------------------------------------------------

const IER_RX: int = 0x01 // received data available
const FCR_RX1: int = 0x07 // FIFOs on, both cleared, receive trigger 1 byte

/// Turn the receiver's interrupt on (px13, kernel/console): a receive
/// trigger of one byte, so each keystroke raises it at once (px01's
/// trigger of 14 would wait for the FIFO's character timeout), and IER
/// bit 0, received data available. MCR's OUT2, the PC's gate on the
/// UART's interrupt line, is already up (`init`). The 8259 line (4) is
/// kernel/console's to unmask.
pub fn receive_on() {
    if !available() { return }
    out(FCR, FCR_RX1)
    var n = 0
    while n < POLLS && inp(LSR) & LSR_DATA_READY != 0 {
        let _b = inp(THR) // RBR: whatever arrived before
        n += 1
    }
    set_ier(IER_RX | (ier_held() & IER_TX)) // px129: a transmit interrupt armed stays armed
}

/// Whether a received byte is waiting (LSR bit 0).
pub fn ready() -> bool {
    available() && inp(LSR) & LSR_DATA_READY != 0
}

/// The received byte (RBR); call after `ready` (`take` is a keyword).
pub fn receive() -> u64 {
    inp(THR) as u64
}
