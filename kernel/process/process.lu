//! process — processes (px14): a new program's image and stack (moved here
//! from kernel/user, px10/px12's), and the system calls that make,
//! replace and wait for processes, with the signal calls a spawn makes
//! answered minimally.
//!
//! Written from man-pages `clone(2)` (clone3's `struct clone_args`),
//! `vfork(2)`, `execve(2)`, `wait4(2)`, `waitid(2)`, `wait(2)`,
//! `getpid(2)`, `rt_sigprocmask(2)` (`sigprocmask(2)`), `sigaction(2)`,
//! `kill(2)`, `signal(7)`, `credentials(7)`; the uapi headers
//! `linux/sched.h` (CLONE_*, `struct clone_args`), `linux/wait.h`
//! (WNOHANG, WEXITED, P_*), `asm-generic/siginfo.h` (the SIGCHLD
//! siginfo's layout, CLD_*), `arch/x86/include/uapi/asm/signal.h`
//! (signal numbers) and `asm-generic/errno-base.h`; the x86-64 psABI
//! §3.4.1 (the initial stack); and black-box strace of pelt starting a
//! child on Linux (`notes/px14/`). No Linux source; no other kernel's
//! source; no libc's.
//!
//! **A program's image** (`exec_span` for a program the kernel starts,
//! `execve` for one a process starts): the file from the initramfs,
//! checked and loaded by kernel/elf into a fresh address space; a stack
//! of ELF_STACK_PAGES pages below STACK_TOP (the page below them the
//! guard) holding what the psABI puts on a process's initial stack,
//! from the top down: eight zero bytes; the strings (argv's, envp's,
//! then the path, AT_EXECFN's), each with its NUL; sixteen random bytes
//! (AT_RANDOM); then, 16-aligned at the bottom, argc, the argv pointers
//! and a NULL, the envp pointers and a NULL, and the auxiliary vector
//! (px10's sixteen pairs; px39: AT_UID, AT_EUID, AT_GID, AT_EGID and
//! AT_SECURE are the process's own, kernel/cred). The strings are staged first in boot/user.S's
//! `pax_argbuf`, NUL-terminated one after another: the kernel's
//! space-separated words for `exec_span`, the caller's vectors (copied
//! out of its memory before anything else changes) for `execve`.
//!
//! **clone, clone3, vfork** (56, 435, 58): PAX makes the child pelt's
//! spawn makes (measured: `clone3({flags=CLONE_VM|CLONE_VFORK|
//! CLONE_CLEAR_SIGHAND, exit_signal=SIGCHLD, stack, stack_size})`): a
//! new process sharing the caller's address space, which the caller
//! keeps owning, on the stack the call names (or the caller's own when
//! none), resuming after the `syscall` with %rax 0 (kernel/sched's
//! `clone_current`); the caller is suspended until the child execs or
//! ends and then resumes with the child's pid. CLONE_CLEAR_SIGHAND
//! resets the child's handled signals to SIG_DFL.
//! px17: **a fork** — a clone without CLONE_VM, as glibc's `fork` makes
//! it (`clone(CLONE_CHILD_SETTID|CLONE_CHILD_CLEARTID|SIGCHLD)`, measured:
//! wolf 0.2.26's spawn, which pelt `3e7516c` uses, forks) — gives the
//! child a copy of the caller's address space (kernel/paging's
//! `copy_user`: every user page copied, nothing shared), its own; the
//! child resumes after the `syscall` with %rax 0 on the stack the call
//! names (or the copy of the caller's), the caller at once with the
//! child's pid. CLONE_CHILD_SETTID writes the child's pid into the
//! child's copy, CLONE_PARENT_SETTID into the caller's; CLONE_CHILD_
//! CLEARTID is taken and not kept (nothing in PAX waits on that word:
//! no futex, no threads). Both kinds of child take their own references
//! to the open files they inherit (kernel/files' `inherit`). Refused by
//! name: CLONE_VM without CLONE_VFORK (a thread or a process sharing
//! memory while both run and is not a thread, -ENOSYS), any other flag
//! (-EINVAL), no free slot or (px34) no frame for its kernel stack
//! (-EAGAIN, each by name), no frames for the copy (-ENOMEM).
//!
//! **execve** (59): path, argv and envp read out of the caller's memory
//! first; then the file (kernel/files' `exec_lookup`: -ENOENT, -EACCES
//! for a directory, a device or a file with no execute bit), the image
//! (-ENOEXEC for what kernel/elf refuses, logged by name), and only then
//! the point of no return: descriptors with close-on-exec closed,
//! handled signals reset (the mask kept), the saved and file-system ids
//! made the effective ids (px39, kernel/cred: no id is ever raised, the
//! file's set-ID bits are not read), the break and mmap cursor
//! fresh, the x87/SSE state the template, FS 0, the new space live and
//! the old one given back (or handed back to a vfork parent, which
//! resumes); the frame becomes the new program's first: RIP the entry,
//! RSP the vector, every general register 0, RFLAGS IF, left by IRETQ.
//!
//! **wait4, waitid** (61, 247): a child that has ended (a zombie,
//! kernel/sched) is reaped: its pid returned, its status word written
//! (Linux's encoding: `code << 8` after an exit, the signal's number
//! after a kill), rusage zeroed; with none ended, WNOHANG answers 0 and
//! otherwise the caller blocks, its frame rewound to run the call
//! again when a child ends; no child at all is -ECHILD. waitid fills
//! the SIGCHLD siginfo (si_signo 17, si_code CLD_EXITED or CLD_KILLED,
//! si_pid, si_status) and keeps the zombie under WNOWAIT. px48: wait4's
//! 0 and -pgid and waitid's P_PGID select a process group (0: the
//! caller's), and WUNTRACED (WSTOPPED) and WCONTINUED report a stop and
//! a continue once each (kernel/sched's `wait_find`); no such child at
//! all is -ECHILD.
//!
//! **Groups and sessions** (px48): `setpgid` (109), `getpgrp` (111),
//! `setsid` (112), `getpgid` (121), `getsid` (124), by kernel/sched's
//! words, as Linux answers them (measured, notes/px48-job-control.md).
//!
//! **Signals** are kernel/signal's since px26 (the calls, the frame,
//! delivery); this module keeps what `execve` and `clone` do to the
//! actions (`reset_handlers`: a handled signal goes back to the
//! default, an ignored one stays ignored) and which signal a CPU
//! exception stands for (`fault_signal`). The actions are four words a
//! signal in the process area (handler, flags, restorer, mask).
//!
//! **Threads** (px26): `clone`/`clone3` with CLONE_THREAD makes a
//! thread of the caller's process, as glibc's `pthread_create` asks
//! (measured on pelt's second thread: `CLONE_VM|CLONE_FS|CLONE_FILES|
//! CLONE_SIGHAND|CLONE_THREAD|CLONE_SYSVSEM|CLONE_SETTLS|
//! CLONE_PARENT_SETTID|CLONE_CHILD_CLEARTID`, a stack and a TLS
//! pointer): a slot of its own in the caller's group (kernel/sched's
//! `clone_thread`), sharing the address space, the descriptors, the
//! working directory and the signal actions, with its own tid, stack,
//! FS base, signal mask and x87/SSE state, resuming after the `syscall`
//! with %rax 0. CLONE_PARENT_SETTID and CLONE_CHILD_SETTID write the
//! tid; CLONE_CHILD_CLEARTID names the word that is zeroed and whose
//! futex is woken when the thread ends (kernel/user's `exit`), which is
//! how `pthread_join` learns of it. Refused: CLONE_THREAD without
//! CLONE_SIGHAND, or CLONE_SIGHAND without CLONE_VM (-EINVAL,
//! `clone(2)`); a thread that would not share descriptors and working
//! directory, or one with no stack of its own (by name, -EINVAL); a
//! flag PAX does not take (-EINVAL); no free slot or no frame for its
//! kernel stack (-EAGAIN, px34). Every
//! 2500th thread made since boot writes a census line (`user: <name>
//! pid <n> threads: <k> made since boot; slots busy <b>, frames free
//! <f>`), which tests/mpx3-threads' soak holds flat. `execve` from a
//! process with threads ends the others first (`sched.exec_alone`).
//! `set_robust_list` (273) and `rseq` (334) stay -ENOSYS, which glibc
//! tolerates for a thread as for a process (a robust mutex's owner
//! dying is then not told to its waiters: named).
//!
//! **Ids** (kernel/sched): `getpid` (39) the process's pid, `getppid`
//! (110) its parent's (0 for one the kernel started, as Linux gives
//! init), `gettid` (186) and `set_tid_address` (218) the thread's tid
//! (the first thread's is the pid).
//!
//! State lives in kernel/sched's thread records and process areas,
//! read and written volatile; no `region`, no heap (these calls give up
//! their kernel stack when they wait or end: kernel/sched, "Regions").

use cred
use elf
use files
use fpu
use frames
use initramfs
use log
use paging
use panic
use procfs
use sched
use tree
use uaccess
use vm

extern "c" fn pax_cpuid(leaf: u64, sub: u64, reg: u64) -> u64
extern "c" fn pax_rdtsc() -> u64
extern "c" fn pax_rdrand() -> u64

extern "c" let pax_execbuf: *u8
extern "c" let pax_argbuf: *u8

const PAGE: u64 = 4096
const STACK_TOP: u64 = 0x00007ffffffff000
const ELF_STACK_PAGES: u64 = 32 // px10: an ELF process's stack, 128 KiB
const CPUID1_RDRAND: u64 = 0x40000000 // ECX bit 30

// pax_argbuf: the strings at [0, ARG_BYTES), the path at [PATH_AT, +4096).
const ARG_BYTES: u64 = 65536
const PATH_AT: u64 = 65536
const PATH_MAX: u64 = 4095
const MAX_STRINGS: u64 = 4096 // argv's and envp's pointers, each

// The auxiliary vector's types (include/uapi/linux/auxvec.h).
const AT_NULL: u64 = 0
const AT_PHDR: u64 = 3
const AT_PHENT: u64 = 4
const AT_PHNUM: u64 = 5
const AT_PAGESZ: u64 = 6
const AT_BASE: u64 = 7
const AT_FLAGS: u64 = 8
const AT_ENTRY: u64 = 9
const AT_UID: u64 = 11
const AT_EUID: u64 = 12
const AT_GID: u64 = 13
const AT_EGID: u64 = 14
const AT_CLKTCK: u64 = 17
const AT_SECURE: u64 = 23
const AT_RANDOM: u64 = 25
const AT_EXECFN: u64 = 31
const AUX_PAIRS: u64 = 16 // AT_NULL's included

// boot/isr.S's frame, as word indices.
const FRAME_WORDS: u64 = 22
const W_RAX: u64 = 14
const W_VECTOR: u64 = 15
const W_RIP: u64 = 17
const W_CS: u64 = 18
const W_RFLAGS: u64 = 19
const W_RSP: u64 = 20
const W_SS: u64 = 21
const USER_CS: u64 = 0x23
const USER_SS: u64 = 0x1b
const RFLAGS_IF: u64 = 0x202
// A vector no gate has and boot/isr.S does not take for SYSRETQ's: an
// exec'd frame leaves by IRETQ, so %rcx and %r11 start 0 too.
const EXEC_VECTOR: u64 = 0x102

// Linux's numbers (syscall_64.tbl).
const SYS_CLONE: u64 = 56
const SYS_VFORK: u64 = 58
const SYS_CLONE3: u64 = 435

// clone flags (uapi linux/sched.h).
const CSIGNAL: u64 = 0xff
const CLONE_VM: u64 = 0x100
const CLONE_VFORK: u64 = 0x4000
const CLONE_CLEAR_SIGHAND: u64 = 0x100000000
const CLONE_PARENT_SETTID: u64 = 0x00100000 // px17
const CLONE_CHILD_CLEARTID: u64 = 0x00200000 // px17
const CLONE_CHILD_SETTID: u64 = 0x01000000 // px17
const CLONE_ARGS_VER0: u64 = 64
// px26: a thread's flags.
const CLONE_FS: u64 = 0x200
const CLONE_FILES: u64 = 0x400
const CLONE_SIGHAND: u64 = 0x800
const CLONE_THREAD: u64 = 0x10000
const CLONE_SYSVSEM: u64 = 0x40000
const CLONE_SETTLS: u64 = 0x80000
const CLONE_DETACHED: u64 = 0x400000 // ignored, as Linux ignores it

// wait options and idtypes (uapi linux/wait.h).
const WNOHANG: u64 = 0x1
const WUNTRACED: u64 = 0x2 // px48: wait4's; waitid's WSTOPPED is the same bit
const WEXITED: u64 = 0x4
const WCONTINUED: u64 = 0x8 // px48
const WNOWAIT: u64 = 0x01000000
const WAIT4_KNOWN: u64 = 0xe000000b // WNOHANG WUNTRACED WCONTINUED __WNOTHREAD __WALL __WCLONE
const WAITID_KNOWN: u64 = 0xe100000f // + WEXITED, WNOWAIT
const P_ALL: u64 = 0
const P_PID: u64 = 1
const P_PGID: u64 = 2

// signals (arch/x86/include/uapi/asm/signal.h, asm-generic/siginfo.h).
const SIGCHLD: u64 = 17
const NSIG: u64 = 64
const SIG_DFL: u64 = 0
const SIG_IGN: u64 = 1
const CLD_EXITED: u64 = 1
const CLD_KILLED: u64 = 2
const CLD_STOPPED: u64 = 5 // px48
const CLD_CONTINUED: u64 = 6
const SIGCONT: u64 = 18

// -errno as %rax carries it (uapi asm-generic/errno-base.h).
const NEG_ENOENT: u64 = 0xfffffffffffffffe // -2
const NEG_E2BIG: u64 = 0xfffffffffffffff9 // -7
const NEG_ENOEXEC: u64 = 0xfffffffffffffff8 // -8
const NEG_ECHILD: u64 = 0xfffffffffffffff6 // -10
const NEG_EAGAIN: u64 = 0xfffffffffffffff5 // -11
const NEG_ENOMEM: u64 = 0xfffffffffffffff4 // -12
const NEG_EFAULT: u64 = 0xfffffffffffffff2 // -14
const NEG_EINVAL: u64 = 0xffffffffffffffea // -22
const NEG_ENOSYS: u64 = 0xffffffffffffffda // -38
const NEG_ENAMETOOLONG: u64 = 0xffffffffffffffdc // -36 (px56)
const NEG_ELOOP: u64 = 0xffffffffffffffd8 // -40 (px56)

// px56 (pax#96): `#!` lines and `execveat`, measured on Linux 7.2.8
// (`user/elf/execs.c`'s S and X rows, real root's guest).
const AT_FDCWD: u64 = 0xffffff9c // -100 as the 32-bit int
const AT_SYMLINK_NOFOLLOW: u64 = 0x100
const AT_EMPTY_PATH: u64 = 0x1000
const HEAD: u64 = 256 // the bytes of a file read to tell what it is: a `#!` line ends by its 256th byte
const SCRIPTS: u64 = 5 // scripts in a chain, each the one before's interpreter: a sixth is -ELOOP

// The process area's words this module keeps (kernel/sched's
// `proc_area`): the refusal word (kernel/vm's and kernel/files' too);
// kernel/user's logged-calls bitmap, made fresh at execve; and the
// signal records, four words a signal from SIG_WORDS.
const A_REFUSAL: u64 = 3
const A_LOGGED: u64 = 4 // 8 words, kernel/user's
const SIG_WORDS: u64 = 256
// px45: the nice value (two's complement, -20 to 19; 0 for a fresh
// process), the scheduling policy and its priority (SCHED_OTHER, 0). A
// fork's child has its parent's (the area is copied), `execve` keeps
// them. (Words 205 to 207 are kernel/procfs's: where a program's strings
// are, set here at each exec.)
const A_NICE: u64 = 202
const A_POLICY: u64 = 203
const A_RTPRIO: u64 = 204

// Refusal codes (32 and up: kernel/vm uses 1-15, kernel/files 16-31).
const R_FORK: u64 = 32
const R_SHARED: u64 = 33
const R_FLAGS: u64 = 34
const R_SLOTS: u64 = 35
const R_STACK: u64 = 36 // px34
const R_NOT_ELF: u64 = 37
const R_NOMEM: u64 = 38 // px17
const R_FUTEX: u64 = 39 // px26 (kernel/futex's R_OPERATION)
const R_THREAD: u64 = 40 // px26
// px45 (41 is kernel/cred's R_GROUPS).
const R_PRIO_WHICH: u64 = 42
const R_POLICY: u64 = 43
const R_CHROOT: u64 = 44
const R_REBOOT: u64 = 45
const R_HOSTNAME: u64 = 46
const R_CLOCK: u64 = 47
const R_MOUNT: u64 = 48

/// A refusal code's name ("" when not this module's).
pub fn why(r: u64) -> str {
    if r == R_FORK {
        return "a fork without CLONE_VM (PAX copies no address space yet)"
    }
    if r == R_SHARED {
        return "CLONE_VM without CLONE_VFORK or CLONE_THREAD (no process sharing memory with another)"
    }
    if r == R_FUTEX {
        return "a futex operation PAX does not have (wait and wake only)"
    }
    if r == R_THREAD {
        return "a thread that does not share descriptors and working directory, or has no stack of its own"
    }
    if r == R_FLAGS {
        return "a clone flag PAX does not take"
    }
    if r == R_SLOTS {
        return "no free process slot"
    }
    if r == R_STACK {
        return "no frame for a thread's kernel stack"
    }
    if r == R_NOT_ELF {
        return "not a static x86-64 ELF executable PAX runs"
    }
    if r == R_NOMEM {
        return "no frames for a copy of the address space"
    }
    if r == R_PRIO_WHICH {
        return "a priority of a process group or of a user's processes (PAX sets one process's)"
    }
    if r == R_POLICY {
        return "a scheduling policy PAX does not record (SCHED_DEADLINE, SCHED_RESET_ON_FORK)"
    }
    if r == R_CHROOT {
        return "a root directory that is not the tree's (PAX keeps one root for every process)"
    }
    if r == R_REBOOT {
        return "a reboot or a halt by system call (PAX halts when init ends)"
    }
    if r == R_HOSTNAME {
        return "a host or domain name set (PAX's uname is fixed)"
    }
    if r == R_CLOCK {
        return "the time of day set (PAX reads the clock at boot and counts its ticks)"
    }
    if r == R_MOUNT {
        return "a mount or an unmount (PAX's file systems are fixed)"
    }
    ""
}

fn word(f: u64, i: u64) -> u64 {
    // # Safety: `f` is the trampoline's frame (22 words), live for the
    // handler that passed it; i < 22.
    unsafe { ((f + i * 8) as *u64).read_volatile() }
}

fn put_word(f: u64, i: u64, v: u64) {
    // # Safety: as `word`.
    unsafe { ((f + i * 8) as *u64).write_volatile(v) }
}

fn area() -> u64 {
    sched.proc_area(sched.self_slot())
}

fn aget(a: u64, i: u64) -> u64 {
    // # Safety: a process area (sched.proc_area), 512 words; i < 512.
    unsafe { ((a + i * 8) as *u64).read_volatile() }
}

fn aput(a: u64, i: u64, v: u64) {
    // # Safety: as `aget`.
    unsafe { ((a + i * 8) as *u64).write_volatile(v) }
}

/// `user: <name> pid <pid>` for the running thread (kernel/user's and
/// kernel/signal's lines; moved here in px26 so both can write it).
pub fn who() {
    let p = sched.self_prog()
    log.put("user: ")
    if p == 0 {
        log.put("kernel")
    } else if p == sched.ELF_PROG {
        put_bytes(sched.self_exec(2), sched.self_exec(3))
    } else {
        log.put(blob_name(p - 1))
    }
    log.put(" pid ")
    log.dec(sched.self_pid() as int) // px14: the Linux pid
}

/// A px09 program's name by number (kernel/user's `name`).
pub fn blob_name(p: u64) -> str {
    if p == 0 { return "hello" }
    if p == 1 { return "segv" }
    if p == 2 { return "kread" }
    if p == 3 { return "textwrite" }
    if p == 4 { return "guard" }
    if p == 5 { return "priv" }
    if p == 6 { return "badptr" }
    if p == 7 { return "spin1" }
    if p == 8 { return "spin2" }
    if p == 9 { return "after" }
    "?"
}

fn refuse_with(code: u64, r: u64) -> u64 {
    aput(area(), A_REFUSAL, code)
    r
}

// --- the image (px10, px12; moved from kernel/user) -----------------------------

/// Write the `n` bytes at `a` (kernel memory: a name in the initramfs, a
/// staged path) to the log.
pub fn put_bytes(a: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        // # Safety: [a, a + n) is kernel memory the caller names (the
        // initramfs, mapped read-only in the HHDM, or pax_argbuf).
        let b = unsafe { ((a + i) as *u8).read_volatile() }
        log.put_byte(b as int)
        i += 1
    }
}

/// Byte `i` of the kernel bytes at `a`.
fn sb(a: u64, i: u64) -> u64 {
    // # Safety: [a, a + n) is the caller's kernel memory and i < n.
    unsafe { ((a + i) as *u8).read_volatile() as u64 }
}

fn put_sb(a: u64, i: u64, b: u64) {
    // # Safety: as `sb`, a byte of pax_argbuf or pax_execbuf.
    unsafe { ((a + i) as *u8).write_volatile((b & 0xff) as u8) }
}

fn argbuf() -> u64 {
    // # Safety: the address only.
    unsafe { pax_argbuf as u64 }
}

/// The space-separated words of the `n` bytes at `a`, staged at `dst`
/// as NUL-terminated strings one after another: (how many, their bytes
/// with the NULs).
fn stage_words(dst: u64, a: u64, n: u64) -> (u64, u64) {
    var w: u64 = 0
    var k: u64 = 0
    var inw = false
    var i: u64 = 0
    while i < n {
        let c = sb(a, i)
        if c == 32 {
            if inw {
                put_sb(dst, k, 0)
                k += 1
            }
            inw = false
        } else {
            if !inw {
                w += 1
            }
            inw = true
            put_sb(dst, k, c)
            k += 1
        }
        i += 1
    }
    if inw {
        put_sb(dst, k, 0)
        k += 1
    }
    (w, k)
}

/// User address `va` of the space at `pml4` (not live), through the
/// HHDM: the frame the image builder mapped there.
fn kva(pml4: u64, va: u64) -> u64 {
    let pa = paging.translate(pml4, va) else 0
    if pa == 0 {
        panic.fail("user: exec: a stack byte is not mapped at", va)
    }
    pa + frames.hhdm()
}

fn poke8(pml4: u64, va: u64, b: u64) {
    // # Safety: kva's frame, one the builder mapped in this space's stack.
    unsafe { (kva(pml4, va) as *u8).write_volatile((b & 0xff) as u8) }
}

fn poke64(pml4: u64, va: u64, v: u64) {
    // # Safety: as poke8; va is 8-aligned, so the word is in one page.
    unsafe { (kva(pml4, va) as *u64).write_volatile(v) }
}

/// Copy the `n` staged bytes at `src` to user `va` of the space at
/// `pml4`; the address past them.
fn put_block(pml4: u64, va: u64, src: u64, n: u64) -> u64 {
    var i: u64 = 0
    while i < n {
        poke8(pml4, va + i, sb(src, i))
        i += 1
    }
    va + n
}

/// Write a pointer to each of the `count` NUL-terminated strings staged
/// at `src` (laid out from user `strs` by `put_block`) from `va` up,
/// then a NULL; the address past it.
fn put_ptrs(pml4: u64, va: u64, strs: u64, src: u64, count: u64) -> u64 {
    var p = va
    var off: u64 = 0
    var k: u64 = 0
    while k < count {
        poke64(pml4, p, strs + off)
        p += 8
        while sb(src, off) != 0 {
            off += 1
        }
        off += 1
        k += 1
    }
    poke64(pml4, p, 0)
    p + 8
}

/// One auxiliary-vector pair at `a`; the address past it.
fn put_aux(pml4: u64, a: u64, t: u64, v: u64) -> u64 {
    poke64(pml4, a, t)
    poke64(pml4, a + 8, v)
    a + 16
}

/// Eight bytes for AT_RANDOM and getrandom: RDRAND when the CPU has it
/// (every PAX host: QEMU's `-cpu max` and the KVM hosts), else the TSC
/// folded on itself (named, not cryptographic: a CPU without RDRAND gets
/// bytes that differ per boot and per word, nothing more).
pub fn random_word(k: u64) -> u64 {
    // # Safety: CPUID reads nothing and writes only its registers.
    let has = unsafe { pax_cpuid(1, 0, 2) } & CPUID1_RDRAND != 0
    if has {
        // # Safety: RDRAND exists (CPUID.1:ECX bit 30).
        let r = unsafe { pax_rdrand() }
        if r != 0 {
            return r
        }
    }
    // # Safety: RDTSC reads the time-stamp counter, nothing else.
    let t = unsafe { pax_rdtsc() }
    (t ^ (t >> 17) ^ (t >> 31)) + k
}

/// A frame, zeroed through the HHDM; 0 when there is none.
fn fresh() -> u64 {
    let pa = frames.alloc() else 0
    if pa == 0 {
        return 0
    }
    let v = pa + frames.hhdm()
    var i: u64 = 0
    while i < PAGE / 8 {
        // # Safety: the frame just taken, through the HHDM.
        unsafe { ((v + i * 8) as *u64).write_volatile(0) }
        i += 1
    }
    pa
}

/// The stack of the space at `pml4`: ELF_STACK_PAGES pages below
/// STACK_TOP, read-write, no-execute; the page below them never mapped.
/// False when frames ran out (what was mapped stays in the space, for
/// `free_user`).
fn map_stack(pml4: u64) -> bool {
    var k: u64 = 0
    while k < ELF_STACK_PAGES {
        let pa = fresh()
        if pa == 0 {
            return false
        }
        let r = paging.map_user(pml4, STACK_TOP - (k + 1) * PAGE, pa, paging.RW | paging.NX) else 99
        if r == 99 {
            frames.free(pa)
            return false
        }
        k += 1
    }
    true
}

/// The psABI's initial stack in the space at `pml4` for the file at
/// `file` (loaded, entry `entry`): argc strings staged at `av` (`ab`
/// bytes), envc at `ev` (`eb` bytes), the path's `pl` bytes at `pa`.
/// px39: `ca` is the process area whose ids the vector tells (the
/// caller's for `execve`; 0 for a program the kernel starts, which is
/// root: every id 0, AT_SECURE 0).
/// Returns the stack pointer (argc's address).
fn build_stack(pml4: u64, file: u64, entry: u64, av: u64, argc: u64, ab: u64, ev: u64, envc: u64, eb: u64, pa: u64, pl: u64, ca: u64) -> u64 {
    // The strings' block, under eight zero bytes at the top: argv's,
    // envp's, the path's.
    let sbytes = ab + eb + pl + 1
    let strs = STACK_TOP - 8 - sbytes
    let env_at = put_block(pml4, strs, av, ab)
    let path_at = put_block(pml4, env_at, ev, eb)
    var i: u64 = 0
    while i < pl {
        poke8(pml4, path_at + i, sb(pa, i))
        i += 1
    }
    poke8(pml4, path_at + pl, 0)
    if path_at + pl + 1 != STACK_TOP - 8 {
        panic.fail("user: exec: the strings' block ends at", path_at + pl + 1)
    }
    // AT_RANDOM's sixteen bytes, 16-aligned below the strings.
    let rnd = (strs - 16) & !15
    poke64(pml4, rnd, random_word(1))
    poke64(pml4, rnd + 8, random_word(2))
    // The vector: argc, argv + NULL, envp + NULL, the pairs; its first
    // word (argc, where RSP points) 16-aligned.
    let nwords = 1 + (argc + 1) + (envc + 1) + 2 * AUX_PAIRS
    let sp = (rnd - nwords * 8) & !15
    poke64(pml4, sp, argc)
    let after_argv = put_ptrs(pml4, sp + 8, strs, av, argc)
    var a = put_ptrs(pml4, after_argv, env_at, ev, envc)
    a = put_aux(pml4, a, AT_PHDR, elf.aux(file, 0))
    a = put_aux(pml4, a, AT_PHENT, elf.aux(file, 2))
    a = put_aux(pml4, a, AT_PHNUM, elf.aux(file, 1))
    a = put_aux(pml4, a, AT_PAGESZ, PAGE)
    a = put_aux(pml4, a, AT_BASE, 0)
    a = put_aux(pml4, a, AT_FLAGS, 0)
    a = put_aux(pml4, a, AT_ENTRY, entry)
    // px39: who the new program is (kernel/cred): the real and effective
    // ids, which `execve` keeps, and whether they call for care.
    let known = ca != 0
    a = put_aux(pml4, a, AT_UID, if known { cred.uid(ca, cred.REAL) } else { 0 })
    a = put_aux(pml4, a, AT_EUID, if known { cred.uid(ca, cred.EFFECTIVE) } else { 0 })
    a = put_aux(pml4, a, AT_GID, if known { cred.gid(ca, cred.REAL) } else { 0 })
    a = put_aux(pml4, a, AT_EGID, if known { cred.gid(ca, cred.EFFECTIVE) } else { 0 })
    a = put_aux(pml4, a, AT_CLKTCK, 100)
    a = put_aux(pml4, a, AT_SECURE, if known { cred.at_secure(ca) } else { 0 })
    a = put_aux(pml4, a, AT_RANDOM, rnd)
    a = put_aux(pml4, a, AT_EXECFN, path_at)
    a = put_aux(pml4, a, AT_NULL, 0)
    if a > rnd {
        panic.fail("user: exec: the vector runs into AT_RANDOM's bytes at", a)
    }
    sp
}

/// The highest byte + 1 of the file's PT_LOADs: where the break starts.
fn image_top(file: u64) -> u64 {
    var top: u64 = 0
    var s: u64 = 0
    while s < elf.loads(file) {
        let hi = elf.seg(file, s, 1)
        if hi > top {
            top = hi
        }
        s += 1
    }
    top
}

/// px56: a program's name, as Linux's is (measured: `comm`,
/// PR_GET_NAME): the last component of the path at [p, p + n), its
/// first 15 bytes, as two words (the rest zero) and its length.
fn comm_of(p: u64, n: u64) -> (u64, u64, u64) {
    var base: u64 = 0
    var i: u64 = 0
    while i < n {
        if sb(p, i) == 47 {
            base = i + 1
        }
        i += 1
    }
    var l = n - base
    if l > 15 {
        l = 15
    }
    var w0: u64 = 0
    var w1: u64 = 0
    var k: u64 = 0
    while k < l {
        let b = sb(p, base + k)
        if k < 8 {
            w0 = w0 | (b << (k * 8))
        } else {
            w1 = w1 | (b << ((k - 8) * 8))
        }
        k += 1
    }
    (w0, w1, l)
}

/// `user: exec <path>: refused: <why>` (the path the `n` bytes at `p`).
fn refuse_line(p: u64, n: u64, why: str) {
    log.put("user: exec ")
    put_bytes(p, n)
    log.put(": refused: ")
    log.put(why)
    log.end()
}

/// Copy `s` into `pax_execbuf` at `off` (at most `cap` bytes); its
/// length.
fn stage(s: str, off: u64, cap: u64) -> u64 {
    var k: u64 = 0
    for b in s.bytes() {
        if k >= cap {
            panic.fail("user: exec: an argument string longer than", cap)
        }
        // # Safety: off + k < 4096, inside boot/user.S's pax_execbuf.
        unsafe { ((pax_execbuf as u64 + off + k) as *u8).write_volatile((b as int as u64) as u8) }
        k += 1
    }
    k
}

/// Load `path` from the initramfs as an ELF process with `argv` and
/// `envp` (space-separated words) and start its thread, whose body is
/// `body` (kernel/user's `pax_user_thread`). Returns its id, or 0 when
/// refused (a line says why; nothing of the space is kept). Thread
/// context, IF clear.
pub fn exec(body: u64, path: str, argv: str, envp: str) -> u64 {
    // # Safety: the address only.
    let buf = unsafe { pax_execbuf as u64 }
    let pl = stage(path, 0, 1024)
    let al = stage(argv, 1024, 1024)
    let el = stage(envp, 2048, 2048)
    exec_span(body, buf, pl, buf + 1024, al, buf + 2048, el)
}

/// `exec_span` with the environment given as a string (px12: a run-list
/// line from the initramfs, the environment a const).
pub fn exec_line(body: u64, pa: u64, pl: u64, aa: u64, al: u64, envp: str) -> u64 {
    // # Safety: the address only.
    let buf = unsafe { pax_execbuf as u64 }
    let el = stage(envp, 2048, 2048)
    exec_span(body, pa, pl, aa, al, buf + 2048, el)
}

/// A program the kernel starts (px12): the path the `pl` bytes at `pa`,
/// argv the words of the `al` bytes at `aa`, envp the words of the `el`
/// bytes at `ea`. Its parent is the kernel (ppid 0). Returns its thread
/// id, or 0 when refused. px56: the file is the tree's (kernel/files'
/// `exec_kernel`: the path from the root, no mode asked, as px10's
/// archive lookup asked none), read through the tree; refused by the
/// archive's words when the archive has no such file, else as a file
/// of the tree that is gone.
pub fn exec_span(body: u64, pa: u64, pl: u64, aa: u64, al: u64, ea: u64, el: u64) -> u64 {
    let (o, bad) = files.exec_kernel(pa, pl)
    if bad != 0 {
        let why = if initramfs.lookup_span(pa, pl) == initramfs.END { initramfs.lookup_why_span(pa, pl) } else { "not a file of the tree (removed since boot)" }
        refuse_line(pa, pl, why)
        return 0
    }
    let file = files.exec_inode(o)
    let size = tree.bytes(file)
    let r = elf.refusal(file, size)
    if r != 0 {
        refuse_line(pa, pl, elf.why(r))
        files.exec_drop(o)
        return 0
    }
    let pml4 = paging.new_space(sched.pml4())
    if pml4 == 0 {
        panic.fail("user: exec: no frame for a PML4", 0)
    }
    let entry = elf.load(file, size, pml4)
    if entry == 0 || !map_stack(pml4) {
        refuse_line(pa, pl, "out of frames")
        let _freed = paging.free_user(pml4)
        files.exec_drop(o)
        return 0
    }
    let av = argbuf()
    let (argc, ab) = stage_words(av, aa, al)
    let (envc, eb) = stage_words(av + ab, ea, el)
    let sp = build_stack(pml4, file, entry, av, argc, ab, av + ab, envc, eb, pa, pl, 0)
    let (w0, w1, nl) = comm_of(pa, pl)
    let id = sched.create_process(body, sched.ELF_PROG - 1, pml4, entry, sp, 0, nl)
    sched.set_xname_of(id, w0, w1) // px56: the name is the record's own words
    set_args(sched.area_of(id), ab, eb, pl)
    vm.start(sched.area_of(id), image_top(file))
    files.set_exe(sched.area_of(id), o) // px26: /proc/self/exe; px56: its open file
    describe_elf(file, sched.pid_of(id), pml4, entry, sp, argc, envc)
    id
}

/// An ELF process's line:
/// `user: exec pid <pid> cr3 0x<c> entry 0x<e> rsp 0x<s> argc <a> envc <n>, <k> PT_LOAD: 0x<lo>-0x<hi> <rwx> …, stack <pages> pages below 0x<TOP>`.
/// Nothing when the console is quiet (px15, kernel/log).
fn describe_elf(file: u64, pid: u64, cr3: u64, entry: u64, sp: u64, argc: u64, envc: u64) {
    if log.quiet() {
        return
    }
    log.put("user: exec pid ")
    log.dec(pid as int)
    log.put(" cr3 ")
    log.hex(cr3)
    log.put(" entry ")
    log.hex(entry)
    log.put(" rsp ")
    log.hex(sp)
    log.put(" argc ")
    log.dec(argc as int)
    log.put(" envc ")
    log.dec(envc as int)
    log.put(", ")
    let n = elf.loads(file)
    log.dec(n as int)
    log.put(" PT_LOAD:")
    var k: u64 = 0
    while k < n {
        log.put(" ")
        log.hex(elf.seg(file, k, 0))
        log.put("-")
        log.hex(elf.seg(file, k, 1))
        log.put(" ")
        let pf = elf.seg(file, k, 2)
        log.put(if pf & 4 != 0 { "r" } else { "-" })
        log.put(if pf & 2 != 0 { "w" } else { "-" })
        log.put(if pf & 1 != 0 { "x" } else { "-" })
        k += 1
    }
    log.put(", stack ")
    log.dec(ELF_STACK_PAGES as int)
    log.put(" pages below ")
    log.hex(STACK_TOP)
    log.end()
}

// --- execve (px14) ------------------------------------------------------------

/// Copy the NULL-terminated vector of string pointers at user `vec` into
/// pax_argbuf from `off` (each string with its NUL): (how many, the
/// offset past them, 0) or (0, 0, -errno): -EFAULT for an unreadable
/// pointer or string, -E2BIG past MAX_STRINGS or ARG_BYTES.
fn copy_vector(pml4: u64, vec: u64, off: u64) -> (u64, u64, u64) {
    if vec == 0 {
        return (0, off, 0) // Linux takes a NULL vector as an empty one
    }
    var n: u64 = 0
    var at = off
    while n <= MAX_STRINGS {
        let pv = vec + n * 8
        if !uaccess.readable(pml4, pv, 8) {
            return (0, 0, NEG_EFAULT)
        }
        let p = uaccess.get64(pml4, pv)
        if p == 0 {
            return (n, at, 0)
        }
        if n == MAX_STRINGS || at >= ARG_BYTES - 1 {
            return (0, 0, NEG_E2BIG)
        }
        let room = ARG_BYTES - 1 - at
        let l = uaccess.string_in(pml4, p, argbuf() + at, room)
        if l == room + 2 {
            return (0, 0, NEG_EFAULT)
        }
        if l == room + 1 {
            return (0, 0, NEG_E2BIG)
        }
        at += l + 1
        n += 1
    }
    (0, 0, NEG_E2BIG)
}

/// Every handled signal (not SIG_DFL, not SIG_IGN) of the area `a` back
/// to SIG_DFL (execve; clone's CLONE_CLEAR_SIGHAND).
fn reset_handlers(a: u64) {
    var k: u64 = 0
    while k < NSIG {
        let h = aget(a, SIG_WORDS + k * 4)
        if h != SIG_DFL && h != SIG_IGN {
            aput(a, SIG_WORDS + k * 4, 0)
            aput(a, SIG_WORDS + k * 4 + 1, 0)
            aput(a, SIG_WORDS + k * 4 + 2, 0)
            aput(a, SIG_WORDS + k * 4 + 3, 0)
        }
        k += 1
    }
}

/// `execve(path, argv, envp)` from the frame `f`: 0 when the program was
/// replaced (the frame is the new one's), else -errno with nothing of
/// the caller changed. px56: `execveat` with AT_FDCWD and no flags.
pub fn execve(f: u64, path: u64, argv: u64, envp: u64) -> u64 {
    run_file(f, AT_FDCWD, path, argv, envp, 0)
}

/// px56: `execveat(dirfd, path, argv, envp, flags)` (322): the file at
/// `path` from directory descriptor `dirfd` (an absolute path ignores
/// it), AT_EMPTY_PATH for the descriptor itself (`fexecve(3)`),
/// AT_SYMLINK_NOFOLLOW to refuse a last link (-ELOOP); any other flag
/// -EINVAL, before anything else (measured).
pub fn execveat(f: u64, dirfd: u64, path: u64, argv: u64, envp: u64, flags: u64) -> u64 {
    if flags & 0xffffffff & !(AT_EMPTY_PATH | AT_SYMLINK_NOFOLLOW) != 0 {
        return NEG_EINVAL
    }
    run_file(f, dirfd & 0xffffffff, path, argv, envp, flags & 0xffffffff)
}

/// Byte `k` of file `i` (an inode; k < its size), through the tree.
fn fbyte(i: u64, k: u64) -> u64 {
    let (at, _c) = tree.span(i, k, 1)
    // # Safety: `span` answers where byte k of the file is in kernel
    // memory (k inside the file: the caller's check).
    unsafe { (at as *u8).read_volatile() as u64 }
}

fn blank(c: u64) -> bool {
    c == 32 || c == 9
}

/// px56: the filename `execve` was given, as AT_EXECFN shows it and a
/// script's interpreter is handed it (measured): the user path at `va`
/// as it is for an absolute path or AT_FDCWD, else `/dev/fd/<dirfd>/`
/// and the path, or `/dev/fd/<dirfd>` alone for an empty path
/// (AT_EMPTY_PATH), staged at `dst` (PATH_MAX bytes and a NUL): (its
/// length, 0, whether it names the descriptor, whether it is the
/// descriptor itself) or (0, -errno, …). The walk read the path already.
fn filename(pml4: u64, dirfd: u64, va: u64, dst: u64) -> (u64, u64, bool, bool) {
    let c0 = if uaccess.readable(pml4, va, 1) { uaccess.get(pml4, va, 1) } else { 0 }
    var k: u64 = 0
    if dirfd != AT_FDCWD && c0 != 47 {
        for b in "/dev/fd/".bytes() {
            put_sb(dst, k, b as int as u64)
            k += 1
        }
        // the descriptor's number in decimal
        var d = dirfd
        var div: u64 = 1
        while div * 10 <= d {
            div = div * 10
        }
        while div > 0 {
            put_sb(dst, k, 48 + d / div)
            d = d % div
            div = div / 10
            k += 1
        }
        if c0 == 0 {
            put_sb(dst, k, 0)
            return (k, 0, true, true)
        }
        put_sb(dst, k, 47)
        k += 1
    }
    let room = PATH_MAX - k
    let l = uaccess.string_in(pml4, va, dst + k, room)
    if l == room + 2 {
        return (0, NEG_EFAULT, false, false)
    }
    if l == room + 1 {
        return (0, NEG_ENAMETOOLONG, false, false)
    }
    (k + l, 0, k != 0, false)
}

/// px56 (pax#96): the `#!` line of script `i` (`size` bytes), as Linux
/// reads one (measured, `user/elf/execs.c`'s S rows): the first HEAD
/// bytes; the line ends at the first newline among them, else at the
/// file's end when it is shorter, else (cut) at byte HEAD - 1. Blanks
/// and tabs after `#!` are skipped; the interpreter runs to the next
/// blank, tab or NUL; the rest, its blanks and tabs at both ends
/// stripped, is ONE argument (inner blanks and tabs kept, a carriage
/// return a byte like another) when it is not empty, its text ending at
/// a NUL in it (so a NUL first gives the empty string). Answers (the
/// interpreter's offset, its length, the argument's offset, its length,
/// whether there is one, 0) or the errno: -ENOEXEC for no interpreter
/// on a line that has a newline or is cut, and for an interpreter the
/// cut ends. An empty interpreter in a short file with no newline is
/// looked up as the empty name is (the working directory: -EACCES,
/// measured), so it is answered with length 0.
fn shebang(i: u64, size: u64) -> (u64, u64, u64, u64, bool, u64) {
    let n = if size < HEAD { size } else { HEAD }
    var end = n
    var nl = false
    var k: u64 = 2
    while k < n {
        if fbyte(i, k) == 10 {
            end = k
            nl = true
            break
        }
        k += 1
    }
    let cut = !nl && n == HEAD
    if cut {
        end = HEAD - 1
    }
    var p: u64 = 2
    while p < end && blank(fbyte(i, p)) {
        p += 1
    }
    if p >= end || fbyte(i, p) == 0 {
        if nl || cut {
            return (0, 0, 0, 0, false, NEG_ENOEXEC)
        }
        return (p, 0, 0, 0, false, 0)
    }
    var q = p
    while q < end && !blank(fbyte(i, q)) && fbyte(i, q) != 0 {
        q += 1
    }
    if cut && q >= end {
        return (0, 0, 0, 0, false, NEG_ENOEXEC) // the interpreter's name runs past what is read
    }
    var r = q
    if r < end && fbyte(i, r) == 0 {
        return (p, q - p, 0, 0, false, 0) // a NUL ends the line
    }
    while r < end && blank(fbyte(i, r)) {
        r += 1
    }
    var t = end
    while t > r && blank(fbyte(i, t - 1)) {
        t -= 1
    }
    let some = t > r
    var z = r
    while z < t && fbyte(i, z) != 0 {
        z += 1
    }
    (p, q - p, r, z - r, some, 0) // a NUL ends the argument's text (measured: a NUL first is "")
}

/// Move pax_argbuf's bytes [from, to) by `delta` (signed, as a u64):
/// backwards when they move up.
fn shift(from: u64, to: u64, up: bool, delta: u64) {
    let av = argbuf()
    if up {
        var k = to
        while k > from {
            k -= 1
            put_sb(av, k + delta, sb(av, k))
        }
    } else {
        var k = from
        while k < to {
            put_sb(av, k - delta, sb(av, k))
            k += 1
        }
    }
}

/// The length of the NUL-terminated string at pax_argbuf + `at`.
fn slen(at: u64) -> u64 {
    var l: u64 = 0
    while sb(argbuf(), at + l) != 0 {
        l += 1
    }
    l
}

/// px56 (pax#96): the argument vector a script's interpreter is given
/// (`execve(2)`, measured): `interp [arg] <path> argv[1]…` — for the
/// first script its path is the filename (`pa`, `pl`) in place of
/// argv[0], which is dropped; for a script that is another's
/// interpreter its path is already argv[0], the interpreter's name as
/// the line before wrote it. The interpreter and the argument are bytes
/// of script `i`. Rewrites pax_argbuf's argv and envp in place: (argc,
/// the end of argv's bytes, the end of envp's, 0) or -E2BIG.
fn interp_args(i: u64, ip: u64, il: u64, ap: u64, al: u64, arg: bool, first: bool, pa: u64, pl: u64, argc: u64, ae: u64, ee: u64) -> (u64, u64, u64, u64) {
    var keep: u64 = 0 // where the strings that stay begin
    var drop: u64 = 0 // argv's strings dropped (argv[0], the first time)
    if first && argc > 0 {
        keep = slen(0) + 1
        drop = 1
    }
    var front = il + 1
    if arg {
        front += al + 1
    }
    if first {
        front += pl + 1
    }
    let tail = ee - keep
    if front + tail > ARG_BYTES - 1 {
        return (0, 0, 0, NEG_E2BIG)
    }
    if front > keep {
        shift(keep, ee, true, front - keep)
    } else if front < keep {
        shift(keep, ee, false, keep - front)
    }
    let av = argbuf()
    var k: u64 = 0
    var j: u64 = 0
    while j < il {
        put_sb(av, k, fbyte(i, ip + j))
        k += 1
        j += 1
    }
    put_sb(av, k, 0)
    k += 1
    if arg {
        j = 0
        while j < al {
            put_sb(av, k, fbyte(i, ap + j))
            k += 1
            j += 1
        }
        put_sb(av, k, 0)
        k += 1
    }
    if first {
        j = 0
        while j < pl {
            put_sb(av, k, sb(pa, j))
            k += 1
            j += 1
        }
        put_sb(av, k, 0)
        k += 1
    }
    var nc = argc - drop + 1
    if arg {
        nc += 1
    }
    if first {
        nc += 1
    }
    (nc, front + (ae - keep), front + tail, 0)
}

/// px56 (pax#95, #96): `execve` and `execveat`. The file first
/// (kernel/files' `exec_open`: the walk's answers, -EACCES for what is
/// no regular file or has no execute bit for the caller's class,
/// -ETXTBSY while it is open for writing), then the filename and the
/// vectors out of the caller's memory (which a vfork child shares with
/// its parent) before anything changes. Then what the file is, from its
/// first bytes read through the tree: a `#!` line (`shebang`) makes its
/// interpreter the file, with the vector rebuilt (`interp_args`), to
/// SCRIPTS deep (-ELOOP past it; a script named by a close-on-exec
/// descriptor -ENOENT, as its interpreter could not open it: measured);
/// an ELF is loaded (kernel/elf, through the tree); anything else is
/// -ENOEXEC — with no `refused:` line when it has no ELF magic or is
/// shorter than an ELF header (Linux's own answer: measured), with one
/// for an ELF PAX does not run (ET_DYN, PT_INTERP, a 32-bit file).
/// Only then the point of no return: the program's name (the
/// filename's last component; the file's own name for AT_EMPTY_PATH:
/// measured), its open file (`/proc/self/exe`), and px14's resets.
fn run_file(f: u64, dirfd: u64, path: u64, argv: u64, envp: u64, flags: u64) -> u64 {
    let a = area()
    let pml4 = paging.live()
    let (o0, e0) = files.exec_open(a, pml4, dirfd, path, 0, flags)
    if e0 != 0 {
        return e0
    }
    var o = o0
    let av = argbuf()
    let pa = av + PATH_AT
    let (pl, fe, viafd, itself) = filename(pml4, dirfd, path, pa)
    if fe != 0 {
        files.exec_drop(o)
        return fe
    }
    // a filename /dev/fd/<dirfd>… names a descriptor the new program
    // will not have when it is close-on-exec: a script's interpreter
    // could not open it (execveat(2): -ENOENT)
    let unreachable = viafd && files.is_cloexec(a, dirfd)
    let (argc0, ae0, r1) = copy_vector(pml4, argv, 0)
    if r1 != 0 {
        files.exec_drop(o)
        return r1
    }
    let (envc, ee0, r2) = copy_vector(pml4, envp, ae0)
    if r2 != 0 {
        files.exec_drop(o)
        return r2
    }
    var argc = argc0
    var ae = ae0
    var ee = ee0
    var scripts: u64 = 0
    while true {
        let i = files.exec_inode(o)
        let size = tree.bytes(i)
        if size < 2 || fbyte(i, 0) != 35 || fbyte(i, 1) != 33 {
            break
        }
        scripts += 1
        if scripts > SCRIPTS {
            files.exec_drop(o)
            return NEG_ELOOP
        }
        let (ip, il, ap, al, arg, se) = shebang(i, size)
        if se != 0 {
            files.exec_drop(o)
            return se
        }
        if scripts == 1 && unreachable {
            files.exec_drop(o)
            return NEG_ENOENT
        }
        let (nc, nae, nee, ae2) = interp_args(i, ip, il, ap, al, arg, scripts == 1, pa, pl, argc, ae, ee)
        if ae2 != 0 {
            files.exec_drop(o)
            return ae2
        }
        argc = nc
        ae = nae
        ee = nee
        // the interpreter's name into pax_kbuf, looked up from the
        // working directory (an empty one: the directory itself)
        let kb = files.kbuf()
        var j: u64 = 0
        while j < il {
            put_sb(kb, j, fbyte(i, ip + j))
            j += 1
        }
        put_sb(kb, il, 0)
        files.exec_drop(o)
        let (o2, e2) = files.exec_open(a, pml4, AT_FDCWD, 0, il, if il == 0 { AT_EMPTY_PATH } else { 0 })
        if e2 != 0 {
            return e2
        }
        o = o2
    }
    let file = files.exec_inode(o)
    let size = tree.bytes(file)
    let rc = elf.refusal(file, size)
    if rc != 0 {
        files.exec_drop(o)
        if rc == 1 || rc == 2 {
            return NEG_ENOEXEC // shorter than an ELF header, or no ELF magic: Linux's own answer, no refusal
        }
        refuse_line(pa, pl, elf.why(rc))
        return refuse_with(R_NOT_ELF, NEG_ENOEXEC)
    }
    let space = paging.new_space(sched.pml4())
    if space == 0 {
        files.exec_drop(o)
        return NEG_ENOMEM
    }
    let entry = elf.load(file, size, space)
    if entry == 0 || !map_stack(space) {
        let _freed = paging.free_user(space)
        files.exec_drop(o)
        return NEG_ENOMEM
    }
    let sp = build_stack(space, file, entry, av, argc, ae, av + ae, envc, ee - ae, pa, pl, a)
    let (w0, w1, nl) = if itself { files.exe_name(o) } else { comm_of(pa, pl) }
    // The point of no return. px26: every other thread of the process
    // ends first, and the caller is its leader from here (the area is
    // then its own slot's: `a` is read again).
    let others = sched.self_threads() - 1
    if others > 0 && !log.quiet() {
        who()
        log.put(" execve: ")
        log.dec(others as int)
        log.put(" other thread(s) ended")
        log.end()
    }
    sched.exec_alone()
    let na = area()
    cred.exec(na) // px39: the saved and file-system ids become the effective ids; nothing is raised
    files.exec_close(na)
    reset_handlers(na)
    set_args(na, ae, ee - ae, pl)
    var k: u64 = 0
    while k < 8 {
        aput(na, A_LOGGED + k, 0)
        k += 1
    }
    vm.start(na, image_top(file))
    files.set_exe(na, o) // px26: /proc/self/exe; px56: the program's open file
    sched.exec_current(space, entry, sp, 0, nl)
    sched.set_self_xname(w0, w1) // px56: its name, the record's own words
    fpu.exec(sched.self_slot())
    k = 0
    while k < FRAME_WORDS {
        put_word(f, k, 0)
        k += 1
    }
    put_word(f, W_VECTOR, EXEC_VECTOR)
    put_word(f, W_RIP, entry)
    put_word(f, W_CS, USER_CS)
    put_word(f, W_RFLAGS, RFLAGS_IF)
    put_word(f, W_RSP, sp)
    put_word(f, W_SS, USER_SS)
    describe_elf(file, sched.self_pid(), space, entry, sp, argc, envc)
    0
}

// --- clone, clone3, vfork (px14) ------------------------------------------------

/// `clone`, `clone3` or `vfork` (`nr`) from the frame `f`: the frame to
/// resume — the next thread's while the caller waits for its vfork
/// child, `f` with %rax the child's pid after a fork (px17), or `f` with
/// %rax -errno when refused. `a0`, `a1`, `a2`, `a3`: clone's flags,
/// stack, parent_tid and child_tid (clone3's come from its struct).
pub fn clone(f: u64, nr: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64 {
    var flags: u64 = CLONE_VM | CLONE_VFORK
    var usp: u64 = 0
    var ptid: u64 = a2
    var ctid: u64 = a3
    var tls: u64 = a4 // px26: clone's fifth argument on x86-64
    if nr == SYS_CLONE {
        flags = a0 & !CSIGNAL // the exit signal: SIGCHLD is what a parent is sent
        usp = a1
    } else if nr == SYS_CLONE3 {
        let pml4 = paging.live()
        if a1 < CLONE_ARGS_VER0 || a1 > PAGE {
            put_word(f, W_RAX, NEG_EINVAL)
            return f
        }
        let n = if a1 < 88 { a1 } else { 88 }
        if !uaccess.readable(pml4, a0, n) {
            put_word(f, W_RAX, NEG_EFAULT)
            return f
        }
        flags = uaccess.get64(pml4, a0)
        ctid = uaccess.get64(pml4, a0 + 16)
        ptid = uaccess.get64(pml4, a0 + 24)
        let stack = uaccess.get64(pml4, a0 + 40)
        let size = uaccess.get64(pml4, a0 + 48)
        if stack != 0 {
            usp = stack + size
        }
        tls = uaccess.get64(pml4, a0 + 56)
        if n >= 80 && (uaccess.get64(pml4, a0 + 64) != 0 || uaccess.get64(pml4, a0 + 72) != 0) {
            put_word(f, W_RAX, refuse_with(R_FLAGS, NEG_EINVAL)) // set_tid
            return f
        }
    } else {
        ptid = 0
        ctid = 0
    }
    if flags & CLONE_THREAD != 0 || (flags & CLONE_SIGHAND != 0 && flags & CLONE_VM == 0) {
        return thread(f, flags, usp, ptid, ctid, tls) // px26
    }
    if flags & CLONE_VM == 0 {
        return fork(f, flags, usp, ptid, ctid)
    }
    if flags & CLONE_VFORK == 0 {
        put_word(f, W_RAX, refuse_with(R_SHARED, NEG_ENOSYS))
        return f
    }
    if flags & !(CLONE_VM | CLONE_VFORK | CLONE_CLEAR_SIGHAND) != 0 {
        put_word(f, W_RAX, refuse_with(R_FLAGS, NEG_EINVAL))
        return f
    }
    let s = sched.clone_current(f, usp, 0)
    if s == sched.SLOTS || s == sched.NO_STACK {
        put_word(f, W_RAX, refuse_with(if s == sched.NO_STACK { R_STACK } else { R_SLOTS }, NEG_EAGAIN))
        return f
    }
    files.inherit(sched.proc_area(s)) // px17: shared open files
    if flags & CLONE_CLEAR_SIGHAND != 0 {
        reset_handlers(sched.proc_area(s))
    }
    sched.vfork_wait(f, s)
}

/// px17: a fork (a clone without CLONE_VM) from the frame `f`: the child
/// on a copy of the caller's space, both running; `f` with %rax the
/// child's pid, or -errno.
fn fork(f: u64, flags: u64, usp: u64, ptid: u64, ctid: u64) -> u64 {
    let known = CLONE_CHILD_SETTID | CLONE_CHILD_CLEARTID | CLONE_PARENT_SETTID | CLONE_CLEAR_SIGHAND
    if flags & !known != 0 {
        put_word(f, W_RAX, refuse_with(R_FLAGS, NEG_EINVAL))
        return f
    }
    let pml4 = paging.live()
    if flags & CLONE_PARENT_SETTID != 0 && !uaccess.writable(pml4, ptid, 4) {
        put_word(f, W_RAX, NEG_EFAULT)
        return f
    }
    let space = paging.copy_user(pml4, sched.pml4())
    if space == 0 {
        put_word(f, W_RAX, refuse_with(R_NOMEM, NEG_ENOMEM))
        return f
    }
    let s = sched.clone_current(f, usp, space)
    if s == sched.SLOTS || s == sched.NO_STACK {
        let _freed = paging.free_user(space)
        put_word(f, W_RAX, refuse_with(if s == sched.NO_STACK { R_STACK } else { R_SLOTS }, NEG_EAGAIN))
        return f
    }
    let a = sched.proc_area(s)
    files.inherit(a)
    if flags & CLONE_CLEAR_SIGHAND != 0 {
        reset_handlers(a)
    }
    let pid = sched.slot_pid(s)
    if flags & CLONE_CHILD_SETTID != 0 && uaccess.writable(space, ctid, 4) {
        uaccess.put(space, ctid, pid, 4)
    }
    if flags & CLONE_PARENT_SETTID != 0 {
        uaccess.put(pml4, ptid, pid, 4)
    }
    put_word(f, W_RAX, pid)
    f
}

/// px26: a thread (a clone with CLONE_THREAD) from the frame `f`: `f`
/// with %rax the new thread's tid, or -errno.
fn thread(f: u64, flags: u64, usp: u64, ptid: u64, ctid: u64, tls: u64) -> u64 {
    if flags & CLONE_THREAD != 0 && flags & CLONE_SIGHAND == 0 || flags & CLONE_SIGHAND != 0 && flags & CLONE_VM == 0 {
        put_word(f, W_RAX, NEG_EINVAL) // clone(2)
        return f
    }
    let shape = CLONE_VM | CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD
    let extra = CLONE_SYSVSEM | CLONE_SETTLS | CLONE_PARENT_SETTID | CLONE_CHILD_SETTID | CLONE_CHILD_CLEARTID | CLONE_DETACHED
    if flags & !(shape | extra) != 0 {
        put_word(f, W_RAX, refuse_with(R_FLAGS, NEG_EINVAL))
        return f
    }
    if flags & shape != shape || usp == 0 {
        put_word(f, W_RAX, refuse_with(R_THREAD, NEG_EINVAL))
        return f
    }
    let pml4 = paging.live()
    if flags & CLONE_SETTLS != 0 && tls >= paging.USER_TOP {
        put_word(f, W_RAX, 0xffffffffffffffff) // -EPERM, as arch_prctl answers such a base
        return f
    }
    if (flags & CLONE_PARENT_SETTID != 0 && !uaccess.writable(pml4, ptid, 4)) || (flags & CLONE_CHILD_SETTID != 0 && !uaccess.writable(pml4, ctid, 4)) {
        put_word(f, W_RAX, NEG_EFAULT)
        return f
    }
    let s = sched.clone_thread(f, usp, flags & CLONE_SETTLS != 0, tls, if flags & CLONE_CHILD_CLEARTID != 0 { ctid } else { 0 })
    if s == sched.SLOTS || s == sched.NO_STACK {
        put_word(f, W_RAX, refuse_with(if s == sched.NO_STACK { R_STACK } else { R_SLOTS }, NEG_EAGAIN))
        return f
    }
    let t = sched.slot_pid(s)
    if flags & CLONE_PARENT_SETTID != 0 {
        uaccess.put(pml4, ptid, t, 4)
    }
    if flags & CLONE_CHILD_SETTID != 0 {
        uaccess.put(pml4, ctid, t, 4)
    }
    let n = sched.threads_made()
    if !log.quiet() && (n <= 4 || n % 2500 == 0) {
        who()
        if n % 2500 == 0 {
            // The census line (tests/mpx3-threads' soak reads four of them).
            log.put(" threads: ")
            log.dec(n as int)
            log.put(" made since boot; slots busy ")
            log.dec(sched.slots_busy() as int)
            log.put(", frames free ")
            log.dec(frames.free_count() as int)
        } else {
            log.put(" thread ")
            log.dec(t as int)
            log.put(" started: stack below ")
            log.hex(usp)
            log.put(", tls ")
            log.hex(tls)
        }
        log.end()
    }
    put_word(f, W_RAX, t)
    f
}

// --- wait4, waitid (px14; px48: groups, stops, continues) -------------------------

/// px48: wait4's pid as Linux reads it (an int): (how, sel) for
/// kernel/sched's `wait_find` — > 0 that child, -1 any child, 0 the
/// children in the caller's process group, < -1 those in group -pid.
fn pid_sel(x: u64) -> (u64, u64) {
    let p = x & 0xffffffff
    if p == 0 {
        return (2, sched.self_pgid())
    }
    if p == 0xffffffff {
        return (0, 0)
    }
    if p >= 0x80000000 {
        return (2, 0x100000000 - p)
    }
    (1, p)
}

/// What a wait's options want (kernel/sched's W_*).
fn wants(o: u64, exited: bool) -> u64 {
    var w: u64 = if exited { sched.W_EXITED } else { 0 }
    if o & WUNTRACED != 0 {
        w = w | sched.W_STOPPED
    }
    if o & WCONTINUED != 0 {
        w = w | sched.W_CONTINUED
    }
    w
}

/// Run the call in `f` again when a child ends (number `nr`).
fn block(f: u64, nr: u64) -> u64 {
    put_word(f, W_RIP, word(f, W_RIP) - 2)
    put_word(f, W_RAX, nr)
    sched.wait_child(f)
}

/// `wait4(pid, wstatus, options, rusage)` (`nr` 61) from `f`. px48: a
/// stop is reported under WUNTRACED as `(sig << 8) | 0x7f` and a
/// continue under WCONTINUED as `0xffff`, each once (measured).
pub fn wait4(f: u64, nr: u64, pid: u64, wstatus: u64, options: u64, rusage: u64) -> u64 {
    let o = options & 0xffffffff
    if o & (0xffffffff ^ WAIT4_KNOWN) != 0 {
        put_word(f, W_RAX, NEG_EINVAL)
        return f
    }
    let pml4 = paging.live()
    let (how, sel) = pid_sel(pid)
    let (any, s, what) = sched.wait_find(how, sel, wants(o, true))
    if !any {
        put_word(f, W_RAX, NEG_ECHILD)
        return f
    }
    if s == sched.SLOTS {
        if o & WNOHANG != 0 {
            put_word(f, W_RAX, 0)
            return f
        }
        return block(f, nr)
    }
    if (wstatus != 0 && !uaccess.writable(pml4, wstatus, 4)) || (rusage != 0 && !uaccess.writable(pml4, rusage, 144)) {
        put_word(f, W_RAX, NEG_EFAULT)
        return f
    }
    var cp: u64 = 0
    var st: u64 = 0
    if what == sched.W_EXITED {
        let (zp, zs) = sched.zombie(s, true)
        cp = zp
        st = zs
    } else {
        let (rp, sig) = sched.wait_report(s, what, true)
        cp = rp
        st = if what == sched.W_STOPPED { (sig << 8) | 0x7f } else { 0xffff }
    }
    if wstatus != 0 {
        uaccess.put(pml4, wstatus, st, 4)
    }
    if rusage != 0 {
        uaccess.zero(pml4, rusage, 144)
    }
    put_word(f, W_RAX, cp)
    f
}

/// `waitid(idtype, id, infop, options, rusage)` (`nr` 247) from `f`.
/// px48: P_PGID with 0 is the caller's group; WSTOPPED and WCONTINUED
/// report a stop (CLD_STOPPED, the signal) and a continue
/// (CLD_CONTINUED, SIGCONT); one of WEXITED, WSTOPPED, WCONTINUED is
/// needed (else -EINVAL).
pub fn waitid(f: u64, nr: u64, idtype: u64, id: u64, infop: u64, options: u64, rusage: u64) -> u64 {
    let o = options & 0xffffffff
    let t = idtype & 0xffffffff
    if o & (0xffffffff ^ WAITID_KNOWN) != 0 || o & (WEXITED | WUNTRACED | WCONTINUED) == 0 || (t != P_ALL && t != P_PID && t != P_PGID) {
        put_word(f, W_RAX, NEG_EINVAL)
        return f
    }
    let pml4 = paging.live()
    var how: u64 = 0
    var sel: u64 = 0
    if t == P_PID {
        how = 1
        sel = id & 0xffffffff
    } else if t == P_PGID {
        how = 2
        sel = if id & 0xffffffff == 0 { sched.self_pgid() } else { id & 0xffffffff }
    }
    let (any, s, what) = sched.wait_find(how, sel, wants(o, o & WEXITED != 0))
    if !any {
        put_word(f, W_RAX, NEG_ECHILD)
        return f
    }
    if (infop != 0 && !uaccess.writable(pml4, infop, 128)) || (rusage != 0 && !uaccess.writable(pml4, rusage, 144)) {
        put_word(f, W_RAX, NEG_EFAULT)
        return f
    }
    if s == sched.SLOTS {
        if o & WNOHANG != 0 {
            if infop != 0 {
                uaccess.zero(pml4, infop, 128)
            }
            put_word(f, W_RAX, 0)
            return f
        }
        return block(f, nr)
    }
    var cp: u64 = 0
    var code: u64 = 0
    var status: u64 = 0
    if what == sched.W_EXITED {
        let (zp, st) = sched.zombie(s, o & WNOWAIT == 0)
        let killed = st & 0x7f != 0
        cp = zp
        code = if killed { CLD_KILLED } else { CLD_EXITED }
        status = if killed { st & 0x7f } else { (st >> 8) & 0xff }
    } else {
        let (rp, sig) = sched.wait_report(s, what, o & WNOWAIT == 0)
        cp = rp
        code = if what == sched.W_STOPPED { CLD_STOPPED } else { CLD_CONTINUED }
        status = if what == sched.W_STOPPED { sig } else { SIGCONT }
    }
    if infop != 0 {
        uaccess.zero(pml4, infop, 128)
        uaccess.put(pml4, infop, SIGCHLD, 4)
        uaccess.put(pml4, infop + 8, code, 4)
        uaccess.put(pml4, infop + 16, cp, 4)
        uaccess.put(pml4, infop + 24, status, 4)
    }
    if rusage != 0 {
        uaccess.zero(pml4, rusage, 144)
    }
    put_word(f, W_RAX, 0)
    f
}

// --- px48: process groups and sessions --------------------------------------------

/// A 32-bit argument read as an int: (negative, magnitude).
fn int_arg(x: u64) -> (bool, u64) {
    let v = x & 0xffffffff
    if v >= 0x80000000 {
        return (true, 0x100000000 - v)
    }
    (false, v)
}

/// `setpgid(pid, pgid)` (109), `setpgid(2)`, XSH setpgid; measured
/// (notes/px48-job-control.md): a negative pgid -EINVAL; the target the
/// caller or a child of it, else -ESRCH; a child that has exec'd
/// -EACCES; a session leader, or a target or group of another session,
/// or a group that does not exist, -EPERM.
pub fn setpgid(pid: u64, pgid: u64) -> u64 {
    let (gneg, g) = int_arg(pgid)
    let (pneg, p0) = int_arg(pid)
    if gneg {
        return NEG_EINVAL
    }
    if pneg {
        return NEG_ESRCH
    }
    let p = if p0 == 0 { sched.self_pid() } else { p0 }
    let r = sched.setpgid(p, if g == 0 { p } else { g })
    if r == 0 {
        return 0
    }
    if r == 3 { NEG_ESRCH } else if r == 13 { NEG_EACCES } else { NEG_EPERM }
}

/// `getpgid(pid)` (121) and `getsid(pid)` (124): a process's group or
/// session (`pid` 0 the caller; any process, another session's too, a
/// zombie until reaped), -ESRCH when there is none. `getpgrp()` (111) is
/// `getpgid(0)`.
pub fn getpgid(pid: u64, session: bool) -> u64 {
    let (neg, p) = int_arg(pid)
    if neg {
        return NEG_ESRCH
    }
    if p == 0 {
        return if session { sched.self_sid() } else { sched.self_pgid() }
    }
    let sl = sched.proc_slot(p)
    if sl == sched.SLOTS {
        return NEG_ESRCH
    }
    if session { sched.sid_of(sl) } else { sched.pgid_of(sl) }
}

/// `setsid()` (112): the new session's id, or -EPERM for a process
/// that leads a process group (a session leader too).
pub fn setsid() -> u64 {
    let s = sched.setsid()
    if s == 0 { NEG_EPERM } else { s }
}

// --- signals: what an exception stands for (px14; the rest is kernel/signal's) ---

/// The signal a CPU exception in ring 3 stands for (signal(7)'s
/// meanings): the wait status of a process it killed. #DE, #MF, #XM
/// SIGFPE (8); #DB, #BP SIGTRAP (5); #UD SIGILL (4); #NP, #SS, #AC
/// SIGBUS (7); the rest (#PF, #GP, …) SIGSEGV (11).
pub fn fault_signal(v: u64) -> u64 {
    if v == 0 || v == 16 || v == 19 {
        return 8
    }
    if v == 1 || v == 3 {
        return 5
    }
    if v == 6 {
        return 4
    }
    if v == 11 || v == 12 || v == 17 {
        return 7
    }
    11
}

// --- px45: the arguments, priority and the scheduler, and root's calls ------------

/// px45: where `build_stack` put the strings of a program with `ab`
/// bytes of argv, `eb` of envp and a path of `pl` bytes (the strings'
/// block starts STACK_TOP - 8 - their bytes and the path's and its
/// NUL), for kernel/procfs's `cmdline` and `environ`.
fn set_args(a: u64, ab: u64, eb: u64, pl: u64) {
    procfs.set_args(a, STACK_TOP - 8 - (ab + eb + pl + 1), ab, eb)
}

const PRIO_PROCESS: u64 = 0
const PRIO_PGRP: u64 = 1
const PRIO_USER: u64 = 2
const NICE_MIN: int = -20
const NICE_MAX: int = 19
const NEG_EPERM: u64 = 0xffffffffffffffff // -1
const NEG_ESRCH: u64 = 0xfffffffffffffffd // -3
const NEG_EACCES: u64 = 0xfffffffffffffff3 // -13
const NEG_EOPNOTSUPP: u64 = 0xffffffffffffffa1 // -95
const SCHED_OTHER: u64 = 0
const SCHED_FIFO: u64 = 1
const SCHED_RR: u64 = 2
const SCHED_BATCH: u64 = 3
const SCHED_IDLE: u64 = 5
const SCHED_RESET_ON_FORK: u64 = 0x40000000

/// px45: the area of the process a priority or scheduler call names
/// (`who` 0: the caller), a zombie's too (measured: Linux sets a
/// zombie's nice); 0 when there is none.
fn target(who: u64) -> u64 {
    if who == 0 {
        return area()
    }
    let sl = sched.proc_slot(who)
    if sl == sched.SLOTS {
        return 0
    }
    sched.proc_area_of_leader(sl)
}

/// px45: may the process whose area is `me` change the priority or the
/// scheduling of the one whose area is `t` (`setpriority(2)`,
/// `sched_setscheduler(2)`; measured: the caller's effective user id
/// is the target's real or effective one, or the caller is privileged).
/// Not the signal rule: the target's effective id counts here, its
/// saved one does not.
fn may_change(me: u64, t: u64) -> bool {
    let e = cred.uid(me, cred.EFFECTIVE)
    cred.privileged(me) || e == cred.uid(t, cred.REAL) || e == cred.uid(t, cred.EFFECTIVE)
}

fn nice_of(t: u64) -> int {
    let v = aget(t, A_NICE)
    if v >= 0x8000000000000000 { -((!v + 1) as int) } else { v as int }
}

/// px45: `getpriority(which, who)` (140): 20 minus the nice value, as
/// the system call answers it (glibc turns it into the nice value).
/// PRIO_PROCESS: anyone may read anyone's (measured). The group's and
/// a user's are refused by name.
pub fn getpriority(which: u64, who: u64) -> u64 {
    let w = which & 0xffffffff
    if w == PRIO_PGRP || w == PRIO_USER {
        aput(area(), A_REFUSAL, R_PRIO_WHICH)
        return NEG_EINVAL
    }
    if w != PRIO_PROCESS {
        return NEG_EINVAL
    }
    let t = target(who & 0xffffffff)
    if t == 0 {
        return NEG_ESRCH
    }
    (20 - nice_of(t)) as u64
}

/// px45: `setpriority(which, who, prio)` (141), PRIO_PROCESS: the value
/// is cut to -20..19; another process's needs `may_change` (-EPERM); a
/// value below the target's current one needs privilege (-EACCES:
/// RLIMIT_NICE is 0, measured: a user may raise its nice, never lower
/// it). PAX's scheduler gives every thread the same turn: the value is
/// kept and reported, and changes nothing else (named drift).
pub fn setpriority(which: u64, who: u64, prio: u64) -> u64 {
    let w = which & 0xffffffff
    if w == PRIO_PGRP || w == PRIO_USER {
        aput(area(), A_REFUSAL, R_PRIO_WHICH)
        return NEG_EINVAL
    }
    if w != PRIO_PROCESS {
        return NEG_EINVAL
    }
    let me = area()
    let t = target(who & 0xffffffff)
    if t == 0 {
        return NEG_ESRCH
    }
    let p0 = prio & 0xffffffff
    var v: int = if p0 >= 0x80000000 { -((0x100000000 - p0) as int) } else { p0 as int }
    if v < NICE_MIN {
        v = NICE_MIN
    }
    if v > NICE_MAX {
        v = NICE_MAX
    }
    if !may_change(me, t) {
        return NEG_EPERM
    }
    if v < nice_of(t) && !cred.privileged(me) {
        return NEG_EACCES
    }
    aput(t, A_NICE, if v < 0 { 0xffffffffffffffff - ((0 - v) as u64) + 1 } else { v as u64 })
    0
}

/// px45: `sched_getscheduler(pid)` (145): the policy PAX keeps for the
/// process (SCHED_OTHER until one is set).
pub fn sched_getscheduler(pid: u64) -> u64 {
    let p = pid & 0xffffffff
    if p >= 0x80000000 {
        return NEG_EINVAL
    }
    let t = target(p)
    if t == 0 {
        return NEG_ESRCH
    }
    aget(t, A_POLICY)
}

/// px45: `sched_setscheduler(pid, policy, param)` (144): SCHED_OTHER,
/// SCHED_BATCH and SCHED_IDLE with priority 0, SCHED_FIFO and SCHED_RR
/// with 1 to 99 (else -EINVAL, asked first: measured); another
/// process's needs `may_change` (-EPERM); a real-time policy needs
/// privilege (-EPERM: RLIMIT_RTPRIO is 0, measured). Kept and
/// reported, as the nice value is: PAX's scheduler runs every thread
/// alike (named drift). SCHED_DEADLINE and SCHED_RESET_ON_FORK are
/// refused by name.
pub fn sched_setscheduler(pid: u64, policy: u64, param: u64) -> u64 {
    let p = pid & 0xffffffff
    let pol = policy & 0xffffffff
    if p >= 0x80000000 || param == 0 {
        return NEG_EINVAL
    }
    let pml4 = paging.live()
    if !uaccess.readable(pml4, param, 4) {
        return NEG_EFAULT
    }
    if pol & SCHED_RESET_ON_FORK != 0 || pol == 6 {
        aput(area(), A_REFUSAL, R_POLICY)
        return NEG_EINVAL
    }
    let rt = pol == SCHED_FIFO || pol == SCHED_RR
    if !rt && pol != SCHED_OTHER && pol != SCHED_BATCH && pol != SCHED_IDLE {
        return NEG_EINVAL
    }
    let prio = uaccess.get(pml4, param, 4)
    if (rt && (prio < 1 || prio > 99)) || (!rt && prio != 0) {
        return NEG_EINVAL
    }
    let me = area()
    let t = target(p)
    if t == 0 {
        return NEG_ESRCH
    }
    if !may_change(me, t) {
        return NEG_EPERM
    }
    if rt && !cred.privileged(me) {
        return NEG_EPERM
    }
    aput(t, A_POLICY, pol)
    aput(t, A_RTPRIO, prio)
    0
}

/// px45: a call only root may make that PAX does not do (`what` its
/// refusal code): -EPERM for anyone else (measured: Linux's answer to a
/// user, asked before the arguments where px45's `rights` shows it),
/// and refused by name for root (-EOPNOTSUPP), since PAX keeps no
/// such state to change.
fn root_only(what: u64) -> u64 {
    let a = area()
    if !cred.privileged(a) {
        return NEG_EPERM
    }
    aput(a, A_REFUSAL, what)
    NEG_EOPNOTSUPP
}

const REBOOT_MAGIC1: u64 = 0xfee1dead // uapi linux/reboot.h
const REBOOT_MAGIC2: u64 = 672274793
const REBOOT_MAGIC2A: u64 = 85072278
const REBOOT_MAGIC2B: u64 = 369367448
const REBOOT_MAGIC2C: u64 = 537993216
const HOST_NAME_MAX: u64 = 64
const CLOCK_REALTIME: u64 = 0

/// px45: what only root may do, beside files and signals (`chroot(2)`,
/// `reboot(2)`, `sethostname(2)`, `setdomainname(2)`,
/// `settimeofday(2)`, `clock_settime(2)`, `mount(2)`, `umount(2)`),
/// each answered to a user as Linux answers (measured, `rights` P):
/// - `chroot` (161): the path first (-ENOENT, -ENOTDIR, -EACCES), then
///   -EPERM; root: the tree's root is 0 (nothing changes), any other
///   directory refused by name;
/// - `reboot` (169): -EPERM first; root: a bad magic -EINVAL, else
///   refused by name (PAX halts when init ends);
/// - `sethostname` (170), `setdomainname` (171): -EPERM first; root: a
///   name over 64 bytes -EINVAL, else refused by name;
/// - `clock_settime` (227): a clock that cannot be set is -EINVAL first
///   (measured: CLOCK_MONOTONIC to a user too); CLOCK_REALTIME -EPERM,
///   root refused by name; `settimeofday` (164) the same;
/// - `mount` (165): -EPERM; root refused by name; `umount2` (166): the
///   path first, then -EPERM, root refused by name.
pub fn root_call(nr: u64, a0: u64, a1: u64, a2: u64) -> u64 {
    let a = area()
    let pml4 = paging.live()
    if nr == 161 {
        let (e, is_root) = files.chroot_dir(a, pml4, a0)
        if e != 0 {
            return e
        }
        if !cred.privileged(a) {
            return NEG_EPERM
        }
        if is_root {
            return 0
        }
        aput(a, A_REFUSAL, R_CHROOT)
        return NEG_EOPNOTSUPP
    }
    if nr == 169 {
        if !cred.privileged(a) {
            return NEG_EPERM
        }
        let m2 = a1 & 0xffffffff
        if a0 & 0xffffffff != REBOOT_MAGIC1 || (m2 != REBOOT_MAGIC2 && m2 != REBOOT_MAGIC2A && m2 != REBOOT_MAGIC2B && m2 != REBOOT_MAGIC2C) {
            return NEG_EINVAL
        }
        return root_only(R_REBOOT)
    }
    if nr == 170 || nr == 171 {
        if !cred.privileged(a) {
            return NEG_EPERM
        }
        if a1 > HOST_NAME_MAX {
            return NEG_EINVAL
        }
        return root_only(R_HOSTNAME)
    }
    if nr == 227 {
        if a0 & 0xffffffff != CLOCK_REALTIME {
            return NEG_EINVAL
        }
        return root_only(R_CLOCK)
    }
    if nr == 164 {
        return root_only(R_CLOCK)
    }
    if nr == 166 {
        let e = files.path_found(a, pml4, a0)
        if e != 0 {
            return e
        }
        return root_only(R_MOUNT)
    }
    let _unused = a2
    root_only(R_MOUNT) // 165, mount
}
