//! member: false
// kmain_console.lu — what a person types reaches a program (px13,
// tests/mpx3-console). The kernel starts as kmain_boreutils does (PAX's
// paging with the initramfs mapped, the timer, the FPU state, the
// scheduler, SYSCALL), then starts the console's input (kernel/console:
// COM1's receiver and the i8042's keyboard, the line discipline) and
// runs the archive's `/etc/pax-run` as kmain_boreutils does — one
// command a line, its words separated by single spaces, each waited
// for — but with descriptors 0-2 a terminal: the program reads what is
// typed. The first command is init, pid 1 (px14: processes have Linux
// pids of their own, numbered from 1; px13's log said `pid 2`, the
// kernel thread's id), and since px14 it can start programs of its own
// (clone, execve, wait4): the environment carries PATH=/bin, where a
// shell finds them. When the list is done, the kernel says how init
// ended and halts:
//
//     PAX: the console
//     kernel: <commit> sha256 <the file's digest>, <n> bytes   (px87, kernel/identity)
//     paging: …
//     console: com1 irq 4 vector 36, i8042 0x.. -> 0x.. irq 1 vector 33, 8259 master mask 0xec; …
//     boot: <n> ms from the kernel's entry to its first program; the console drew for <m> ms of it (…)   (px87)
//     run 1: /bin/pelt
//     user: exec pid 1 cr3 0x… …
//     $ echo hi
//     hi
//     $ cat /etc/motd
//     user: exec pid 2 cr3 0x… …          (pelt's child, px14)
//     PAX: this is /etc/motd, …
//     user: cat pid 2 exit_group 0 after <r> runs
//     $ …
//     user: pelt pid 1 exit_group 0 after <r> runs
//     user: frames free <A> before, <B> with 1 processes, <A> after
//     run: <k> commands
//     console: <n> bytes from com1, <k> keys (<s> scancodes) from the keyboard, …
//     PAX: init /bin/pelt ended with status 0; nothing left to run
//     halt
//
// px63: with a disk (`-drive … -device virtio-blk-pci`), kernel/block
// brings it up after the sound device and kernel/fstab mounts what the
// initramfs's /etc/fstab lists before the first command (the device's
// lines, a `fstab:` line and kernel/ext2's mount line); at the end every
// volume is written, marked clean and flushed before `halt`
// (kernel/tree's `halt_volumes`), and the disk's books are printed. With
// no disk nothing is printed and nothing moves. px67: the books come
// before init's line, so every log ends with that line and `halt`.
// px68: `init=PATH` on the command line (bootparam(7)'s) runs PATH alone
// as init in place of the run list, its only argument its own path (a
// journalled disk booted again after a power cut, its replay the point,
// not its session: tools/root-crash).
//
// px105: the network, as kmain_session has it (px28, px89), with the
// console's own bounds. After the PCI scan: kernel/net's device (virtio-
// net, else one of kernel/gbe's Intel controllers; none is no device,
// one line), then kernel/arp, kernel/ip, kernel/icmp, kernel/udp and
// kernel/tcp as 10.0.2.15/24 gateway 10.0.2.2, their lines, the network
// clock thread always (loopback's backstop, TCP's timers) and the
// receiving thread with a device; `nonet` on the command line starts no
// device (with or without `triage`: the metal escape hatch). After
// the disk is mounted, the tree's /etc/pax-net (an installed system's own
// file): `dhcp` starts kernel/dhcp and its thread, `static …` holds that
// address (kernel/dhcp's `take_static`). Before the identity line, the
// waits, each bounded and none a reason to stop:
//   - the first lease, at most the file's `wait=` (30 s by default), and
//     not at all when the device has no link (the client goes on asking);
//   - the kernel's echo to the lease's router or the static gateway, 3 s;
// then the two loopback echoes' line, and one line saying how long the
// console waited and the bound it held itself to:
//
//     net: the console waited <w> ms for the network (bound <b> ms: device <d>, lease <l>, echo <e>)
//
// d is the device's own start: 10 with none (the PCI table searched and
// its one line), 0 with `nonet`, 1000 for virtio-net, 12000 for an Intel
// controller (kernel/gbe: the reset's 1 s, the address's 0.5 s and the
// link's 10 s); l the lease wait's bound (0 with no client
// or no link); e 3000 when an echo is asked for. w is measured by
// kernel/clock over those three waits alone. With no device, no file and
// no `quiet` the console's other lines are what they were.
//
// px118: a boot that goes black is heard. A high beep at the entry,
// before any use of the framebuffer, and a low one when the console has
// drawn its first line (kernel/speaker's `boot_tone`; `pax.nobeep`
// silences both); no line is printed for either, so every transcript is
// what it was (tests/mpx6-bootlog holds QEMU's speaker capture).
use clock
use apic
use arp
use block
use boot_info
use bootlog
use bootmark
use console
use dhcp
use fb
use fpu
use frames
use fstab
use icmp
use identity
use initramfs
use interrupts
use ip
use log
use mouse
use net
use netd
use paging
use panic
use pci
use power
use process
use sched
use screen
use serial
use sound
use speaker
use sync
use tcp
use timer
use tree
use triage
use udp
use user
use xhci

extern "c" let pax_user_thread: *u8
extern "c" let pax_usbd: *u8
extern "c" let pax_flushd: *u8 // px63: kernel/fstab's flusher
extern "c" let pax_netd: *u8 // px105: kernel/netd's receiving thread
extern "c" let pax_net_clock: *u8 // px105: the network's clock
extern "c" let pax_dhcpd: *u8 // px105: kernel/dhcp's thread

const ENV: str = "HOME=/ TERM=linux PAX=1 PATH=/bin" // px14: PATH, for a shell's commands
const RUN_LIST: str = "/etc/pax-run"
// px105: the station's fixed address, as kmain_session's, until
// /etc/pax-net names another (a lease or a static address).
const OWN_IP: u64 = 0x0a00020f // 10.0.2.15
const NETMASK: u64 = 0xffffff00 // 255.255.255.0
const GATEWAY: u64 = 0x0a000202 // 10.0.2.2
// px105: the bound on each of the console's waits for the network, ms.
const BOUND_ABSENT: u64 = 10 // the PCI table searched, one line
const BOUND_VIRTIO: u64 = 1000
const BOUND_INTEL: u64 = 12000
const BOUND_ECHO: u64 = 3000



/// px63: kernel threads this kernel started that never end (the
/// flusher), which `run` does not wait for.
var kernel_threads: u64 = 0

fn kthreads() -> u64 {
    // # Safety: a scalar module var, written once at boot.
    unsafe { kernel_threads }
}

fn add_kthreads(n: u64) {
    // # Safety: a scalar module var, written at boot with IF clear.
    unsafe { kernel_threads = kernel_threads + n }
}

/// px105: the console's waits for the network, in kernel/clock's
/// nanoseconds, and the bound on each, ms.
var net_waited: u64 = 0
var bound_device: u64 = 0
var bound_lease: u64 = 0
var bound_echo: u64 = 0

fn waited(ns: u64) {
    // # Safety: a scalar module var, written by kmain alone.
    unsafe { net_waited = net_waited + ns }
}

/// Frames the protocols above the driver hold (as kmain_session's).
fn stack_frames() -> u64 {
    arp.frames_held() + ip.frames_held() + icmp.frames_held() + udp.frames_held() + tcp.frames_held()
}

/// Ping `dst`, an address of this machine, and say whether the reply
/// came back over kernel/ip's loopback queue (as kmain_session does).
fn ping_self(dst: u64, seq: u64) -> bool {
    let _r = icmp.ping(dst, seq, 56)
    let _n = netd.drain()
    let (got, _rtt, _ttl) = icmp.answer()
    got
}

/// px105: whether the network carried anything since the boot: a frame
/// either way, a datagram, a connection.
fn network_used() -> bool {
    net.count(net.C_RX_FRAMES) + net.count(net.C_TX_FRAMES) + udp.count(udp.C_RX) + udp.count(udp.C_TX) + tcp.count(tcp.C_ACCEPTED) + tcp.count(tcp.C_ACTIVE) != 0
}

/// px105: kmain_session's closing lines about the network, when it
/// carried anything (a console that never used it ends as it did):
///
///     network: frames <a> in, <b> out; udp datagrams <c> in, <d> out
///     network: tcp connections <e> accepted, <f> made, <g> open
fn network_lines() {
    if !network_used() {
        return
    }
    log.put("network: frames ")
    log.dec(net.count(net.C_RX_FRAMES) as int)
    log.put(" in, ")
    log.dec(net.count(net.C_TX_FRAMES) as int)
    log.put(" out; udp datagrams ")
    log.dec(udp.count(udp.C_RX) as int)
    log.put(" in, ")
    log.dec(udp.count(udp.C_TX) as int)
    log.put(" out")
    log.end()
    log.put("network: tcp connections ")
    log.dec(tcp.count(tcp.C_ACCEPTED) as int)
    log.put(" accepted, ")
    log.dec(tcp.count(tcp.C_ACTIVE) as int)
    log.put(" made, ")
    log.dec(tcp.blocks() as int)
    log.put(" open")
    log.end()
}

/// px105: the device (with `nonet` on the command line, none) and the
/// protocols over it, their lines, and the network's threads: the clock
/// always, the receiving thread with a device. After pci.scan, IF clear.
/// A device that is missing or refused is one line and loopback only.
/// The wait counted is the device's start alone, not its lines.
fn network_start(pml4: u64) {
    var up = false
    let none = boot_info.cmdline_has("nonet")
    if none {
        log.line("net: no device (nonet); loopback only")
    } else {
        let t0 = clock.now_ns()
        up = net.start(pml4) == net.UP
        waited(clock.now_ns() - t0)
        net.report()
    }
    // The device's own start: nothing to wait for without one; up to
    // kernel/gbe's waits for an Intel controller, refused or not.
    let d = if none { 0 } else if net.state() == net.ABSENT { BOUND_ABSENT } else if net.intel() { BOUND_INTEL } else { BOUND_VIRTIO }
    // # Safety: a scalar module var, written by kmain alone.
    unsafe { bound_device = d }
    arp.start(OWN_IP, arp.AGE)
    ip.start(OWN_IP, NETMASK, GATEWAY)
    icmp.start()
    udp.start()
    tcp.start(process.random_word(0))
    ip.report()
    // The ephemeral start, random each boot, is named and not printed:
    // the console's transcript reads the same every boot (mpx6-triage's
    // T2 holds a plain boot's to a triage boot's, line for line).
    udp.report_unnumbered()
    tcp.report_unnumbered()
    if stack_frames() != 333 {
        panic.fail("console: no frame for the stack, frames", stack_frames())
    }
    // # Safety: the addresses of kernel/netd's exports; nothing is read.
    let (nd, nc) = unsafe { (pax_netd as u64, pax_net_clock as u64) }
    if up {
        let _r = sched.create(nd, 0)
        add_kthreads(1)
    }
    let _c = sched.create(nc, 0)
    add_kthreads(1)
}

/// px105: the tree's /etc/pax-net (after the disk is mounted, so an
/// installed system's own file decides): a static address held now, or
/// the DHCP client and its thread started. IF clear.
fn network_address() {
    let want = dhcp.from_file()
    if dhcp.static_asked() {
        dhcp.take_static()
        // # Safety: a scalar module var, written by kmain alone.
        unsafe { bound_echo = BOUND_ECHO }
    } else if want && dhcp.start(process.random_word(1)) {
        // # Safety: the address of kernel/dhcp's export; nothing is read.
        let dt = unsafe { pax_dhcpd as u64 }
        let _t = sched.create(dt, 0)
        add_kthreads(1)
    }
}

/// px105: the console's waits for the network, IF set: the first lease
/// (at most the file's `wait=`; none when the device has no link) and
/// the kernel's echo to its router, or the static gateway's echo; then
/// the loopback line and the waited line.
fn network_wait() {
    if dhcp.on() {
        if net.link() {
            // # Safety: a scalar module var, written by kmain alone.
            unsafe { bound_lease = dhcp.wait_seconds() * 1000 }
            let t0 = clock.now_ns()
            let got = dhcp.wait_bound()
            waited(clock.now_ns() - t0)
            if got {
                unsafe { bound_echo = BOUND_ECHO }
                let t1 = clock.now_ns()
                dhcp.echo_router()
                waited(clock.now_ns() - t1)
            }
        } else {
            log.line("dhcp: no link; the console does not wait for a lease (the client goes on asking)")
        }
    } else if dhcp.static_asked() {
        let t0 = clock.now_ns()
        dhcp.echo_gateway()
        waited(clock.now_ns() - t0)
    }
    let wire0 = net.count(net.C_TX_FRAMES)
    let l1 = ping_self(ip.LOOPBACK, 1)
    let l2 = ping_self(ip.address(), 2)
    let s = sync.acquire(sync.console())
    log.put("loopback: 127.0.0.1 ")
    log.put(if l1 { "answers" } else { "does NOT answer" })
    log.put(" the kernel's echo, ")
    arp.put_ip(ip.address())
    log.put(" ")
    log.put(if l2 { "answers" } else { "does NOT answer" })
    log.put(", ")
    log.dec((net.count(net.C_TX_FRAMES) - wire0) as int)
    log.put(" frames on the wire")
    log.end()
    // # Safety: scalar module vars, written by kmain alone.
    let (w, d, l, e) = unsafe { (net_waited, bound_device, bound_lease, bound_echo) }
    log.put("net: the console waited ")
    log.dec((w / 1000000) as int)
    log.put(" ms for the network (bound ")
    log.dec((d + l + e) as int)
    log.put(" ms: device ")
    log.dec(d as int)
    log.put(", lease ")
    log.dec(l as int)
    log.put(", echo ")
    log.dec(e as int)
    log.put(")")
    log.end()
    sync.release(sync.console(), s)
}

/// The body ELF processes run (kernel/user's export).
fn body() -> u64 {
    // # Safety: the address of kernel/user's export; nothing is read.
    unsafe { pax_user_thread as u64 }
}

fn byte_at(a: u64) -> u64 {
    // # Safety: a byte of the run list, inside the frame kernel/tree's
    // `small_file` read it into (px67; the initramfs's pages before),
    // never given back; or (px68) of `init=`'s value in Limine's command
    // line (bootloader-reclaimable memory the kernel keeps mapped).
    unsafe { (a as *u8).read_volatile() as u64 }
}

/// Run line number `k`, the `n` bytes at `a`: one command, waited for;
/// the frames line. px67: the last command (`last`, init when it is the
/// only one) is waited for itself, and when it has ended, what it left
/// is ended (kernel/user's `end_processes`) before the wait for the rest; root's
/// reboot(2) ends any wait at once (kernel/user's `end_asked`: the end
/// is kmain's then).
fn run(k: u64, a: u64, n: u64, last: bool) {
    let s = sync.acquire(sync.console())
    log.put("run ")
    log.dec(k as int)
    log.put(": ")
    var i: u64 = 0
    while i < n {
        log.put_byte(byte_at(a + i) as int)
        i += 1
    }
    log.end()
    sync.release(sync.console(), s)
    if k == 1 {
        // px118: the first program starts; kernel/bootlog keeps no more
        bootmark.stage(bootmark.INIT)
        bootlog.seal()
    }
    let saved = sync.irq_save()
    let before = frames.free_count()
    var pl: u64 = 0
    while pl < n && byte_at(a + pl) != 32 {
        pl += 1
    }
    let id = user.exec_line(body(), a, pl, a, n, ENV)
    let during = frames.free_count()
    sync.irq_restore(saved)
    if last && id != 0 && user.end_asked() == 0 {
        sched.wait_pid_or_down(sched.pid_of(id), kthreads())
        if user.end_asked() == 0 {
            user.end_processes(true) // px67: the halt: init has ended; what it left ends too
        }
    }
    if user.end_asked() == 0 {
        sched.wait_down_to(kthreads()) // px63: the flusher, when there is one, never ends
    }
    if user.end_asked() != 0 {
        return // px67: reboot(2): the end is kmain's
    }
    // px105: a connection its process closed may still be saying goodbye
    // (a FIN to be acknowledged): up to thirty seconds for that, as
    // kmain_session waits, so the lines below are the run's. A run that
    // made no connection waits for nothing.
    let patience = timer.ticks() + 3000
    while tcp.finishing() != 0 && timer.ticks() < patience {
        let _s = sched.sleep(1)
    }
    let after = frames.free_count()
    if log.quiet() { // px15: the kernel command line said `quiet`
        return
    }
    let s2 = sync.acquire(sync.console())
    log.put("user: frames free ")
    log.dec(before as int)
    log.put(" before, ")
    log.dec(during as int)
    log.put(" with ")
    log.dec((if id != 0 { 1 } else { 0 }) as int)
    log.put(" processes, ")
    log.dec(after as int)
    log.put(" after")
    log.end()
    user.tree_report() // px27: what the file tree holds, beside what it held when made
    user.unix_report() // px34: the Unix sockets' books, when one was ever made
    sync.release(sync.console(), s2)
}

/// px66: one line, when the initramfs (the module Limine loaded) came
/// from a disk rather than an optical disc (an ISO: nothing is said, so
/// no image's serial moves): its path and where it lay, as Limine's
/// `struct limine_file` says:
///
///     boot: /boot/initramfs.cpio from a disk: partition 1, GPT disk <guid>, partition <guid>
fn boot_media() {
    if boot_info.module_count() == 0 || boot_info.module_media(0) == 1 {
        return
    }
    log.put("boot: ")
    var k: u64 = 0
    while k < 256 {
        let b = boot_info.module_path_byte(0, k)
        if b < 0 {
            break
        }
        log.put_byte(b)
        k += 1
    }
    let m = boot_info.module_media(0)
    log.put(if m == 2 { " from TFTP" } else { " from a disk" })
    let p = boot_info.module_partition(0)
    if p != 0 {
        log.put(": partition ")
        log.dec(p as int)
    }
    if boot_info.module_guid(0, false, 0) != 0 || boot_info.module_guid(0, false, 1) != 0 {
        log.put(", GPT disk ")
        block.put_guid(boot_info.module_guid(0, false, 0), boot_info.module_guid(0, false, 1))
        log.put(", partition ")
        block.put_guid(boot_info.module_guid(0, true, 0), boot_info.module_guid(0, true, 1))
    }
    log.end()
}

/// px82: image assembly generates this identity from the kernel ELF and
/// pin files. Older test roots without it keep their existing transcripts.
/// Like /etc/pax-run, small_file retains one page for the boot's lifetime.
fn release_identity() {
    let (data, size, why) = tree.small_file("/etc/pax-banner")
    if why != 0 {
        return
    }
    var i: u64 = 0
    while i < size && byte_at(data + i) != 10 {
        log.put_byte(byte_at(data + i) as int)
        i += 1
    }
    log.end()
}

// px118: the boot's two beeps (kernel/speaker's `boot_tone`), so a
// person at a machine whose screen stays black hears how far it came:
// a high one at the kernel's entry, before any use of the framebuffer,
// and a low one when the console has drawn its first line. One beep
// and black: the kernel ran, and either never drew or drew where no one
// sees. No beep: the kernel never started. `pax.nobeep` on the command
// line silences both. Each is 210 edges of channel 2's square wave:
// count 1140 (1046.6 Hz) for about 100 ms, count 2280 (523.3 Hz) for
// about 200 ms.
const BEEP_HIGH: u64 = 1140
const BEEP_LOW: u64 = 2280
const BEEP_HALVES: u64 = 210

/// px118: whether the low beep has sounded (once a boot).
var drawn_beep: u64 = 0

fn beep(count: u64) {
    if boot_info.cmdline_has("pax.nobeep") {
        return
    }
    let _edges = speaker.boot_tone(count, BEEP_HALVES)
}

/// px118: the low beep, the first time the console is drawn: after the
/// early screen's first line (Limine's mapping; kernel/bootmark's `drawn`
/// stage), or after kernel/fb's attach when the early screen did not
/// attach.
fn beep_drawn() {
    // # Safety: a scalar module var, written by kmain alone.
    let seen = unsafe { drawn_beep }
    if seen != 0 || !screen.on() {
        return
    }
    // # Safety: as above.
    unsafe { drawn_beep = 1 }
    beep(BEEP_LOW)
}

export fn kmain() {
    identity.mark_entry() // px87 (pax#253): the TSC at the entry, for the boot line
    beep(BEEP_HIGH) // px118: the kernel ran (before any use of the framebuffer)
    // px118: the previous boot's marks read, this boot's `entered` recorded
    // (kernel/bootlog's slot in memory, CMOS when it is PAX's, port 0x80).
    bootmark.start(bootlog.start())
    // px77d: with `triage` on the command line, boot/triage.S's IDT,
    // CR4.MCE and band first (box 1), then a numbered box at each step
    // below; without it every triage call returns at once.
    triage.start()
    if !triage.on() {
        // px77d: PAX's GDT, TSS and IDT (the NMI and the machine check each
        // on a stack of its own) and CR4.MCE before anything else: until
        // they are loaded an NMI or an exception is a reset, and on kasumi
        // that window held 337 console lines scrolled through the GPU's
        // BAR. Under `triage` its own tables cover the window instead.
        interrupts.early()
    }
    triage.step(2)
    serial.init()
    triage.step(3) // the early screen attached (or `nofb`)
    log.line("PAX: the console")
    if screen.on() {
        bootmark.stage(bootmark.DRAWN) // px118: the early screen drew that line
    }
    beep_drawn() // px118: the early screen drew that line (when it attached)
    frames.start()
    identity.report() // px87 (pax#176): the commit and the SHA-256 of the file Limine loaded
    triage.step(4)
    let limine = paging.cr3()
    let before = frames.free_count()
    let pml4 = paging.build() // paging.start's three steps, a box between each
    triage.step(5)
    screen.pause_early()
    paging.switch_to(pml4)
    bootmark.stage(bootmark.MEMORY) // px118
    triage.step(6) // PAX's page tables live
    paging.report(limine, before)
    let fb_on = if triage.off("nofb") { false } else { fb.start(pml4) } // px19: the screen, when there is one
    if fb_on {
        bootmark.stage(bootmark.FRAMEBUFFER) // px118
    }
    triage.step(7)
    // px76: its mode on a line (`screen: WxH …` or `screen: off, <why>`), for a photo
    fb.report()
    beep_drawn() // px118: kernel/fb's attach replayed the console (when the early screen did not draw)
    if initramfs.bytes() != 0 || !fstab.root_asked() {
        initramfs.report() // px67: with `root=` and no module, nothing to say
    }
    if !fstab.root_asked() {
        initramfs.require() // px67: with `root=` the programs may all be on the disk
    }
    triage.step(8)
    interrupts.start() // with `triage` the first load; otherwise `early` loaded them
    triage.step(9) // PAX's GDT and IDT live
    apic.start(pml4)
    triage.step(10)
    timer.start()
    triage.step(11)
    fpu.start()
    fpu.report()
    triage.step(12)
    sched.start(pml4)
    sched.report()
    triage.step(13)
    user.start()
    user.report()
    triage.step(14)
    console.start()
    console.report()
    triage.step(15)
    // px30: the sound device, when the machine has one (`/dev/dsp`);
    // silent when it has none, so no existing session's serial moves.
    clock.start() // bootstrap deadlines also work without a scheduler
    bootmark.check_century() // px118: the FADT's century byte never among the marks' CMOS bytes
    identity.calibrate() // px87: the TSC's rate against 10 ms of that clock
    triage.step(16)
    let _pci = pci.scan()
    network_start(pml4) // px105: the device, the protocols, the network's threads
    triage.step(17)
    let _snd = if triage.off("nosound") { 0 } else { sound.start(pml4) }
    triage.step(18)
    let usb = !triage.off("noxhci")
    let usb_threads = if usb { xhci.start(pml4, unsafe { pax_usbd as u64 }) } else { 0 }
    add_kthreads(usb_threads) // px105: after the network's own
    triage.step(19)
    // px63: the disk, when the machine has one, and what /etc/fstab mounts.
    if !triage.off("noblock") && block.start(pml4) != 0 {
        block.report()
    }
    bootmark.stage(bootmark.DEVICES) // px118
    triage.step(20)
    boot_media() // px66: where Limine found the initramfs, when not on an optical disc
    // px115: under `pax.staged=` the archive staged on the installed root is `/` (its attempt
    // counted, its sha256 held to the word's); refused, `/` is the installed root, as root= says.
    let staged = fstab.load_staged(pml4)
    if staged {
        tree.adopt_staged()
    }
    let _root = if staged { 0 } else { fstab.mount_root() } // px67: `/` on the disk, when the command line says `root=`
    let _mounted = fstab.mount_all()
    // px93: the stick's upgrade entry alone mounts the listed disk's root; px115: never over the
    // installed root a refused staged boot made `/`
    let _upgrade = if fstab.staged_refused() { 0 } else { fstab.mount_upgrade() }
    network_address() // px105: /etc/pax-net, on the disk when `/` is there
    bootmark.stage(bootmark.ROOT) // px118
    triage.step(21)
    release_identity() // px82: separate from the boot-medium line
    if fstab.wants_flusher() {
        // # Safety: the address of kernel/fstab's export; nothing is read.
        let fl = unsafe { pax_flushd as u64 }
        let _t = sched.create(fl, 0) // px63: a write-back volume's blocks written every 5 s
        add_kthreads(1)
    }
    triage.step(22)
    sync.enable()
    triage.step(23) // interrupts on
    if usb {
        xhci.wait_ready()
    }
    triage.step(24)
    // px78: the USB disks (a boot stick) once xHCI's first pass is done,
    // before init: kernel/usb_storage probes each, kernel/block names it.
    if usb {
        let usb_saved = sync.irq_save()
        let _usb = block.attach_usb()
        sync.irq_restore(usb_saved)
    }
    network_wait() // px105: the lease and the echo, bounded; the loopback and waited lines
    triage.step(25)

    // px67: the run list is the tree's (`/` on the disk when it is there,
    // else the initramfs's), read whole into a frame of its own. px68:
    // `init=` names the one command instead.
    let (ia, il0) = boot_info.cmdline_value("init")
    let il = if fstab.staged_refused() { 0 } else { il0 } // px115: a refused staged boot runs the installed system's own list
    var d: u64 = ia
    var size: u64 = il
    if il == 0 {
        let (fd, fsize, why) = tree.small_file(RUN_LIST)
        if why != 0 {
            panic.fail("console: no /etc/pax-run under / (a regular file of a page at most), why", why)
        }
        d = fd
        size = fsize
    }
    var total: u64 = 0 // px67: the commands, so the last is known
    var c: u64 = 0
    while c < size {
        var j = c
        while j < size && byte_at(d + j) != 10 {
            j += 1
        }
        if j > c && byte_at(d + c) != 35 {
            total += 1
        }
        c = j + 1
    }
    triage.step(26) // the run list read: init next
    bootmark.report() // px118: `marks: boot <n>; the previous boot …`, on the screen at the prompt
    identity.repeat() // px87 (pax#176): the identity line again, on the screen at the prompt
    identity.report_boot() // px87 (pax#253): `boot: <n> ms … the console drew for <m> ms …`
    var k: u64 = 0
    var i: u64 = 0
    var init_at: u64 = 0
    var init_len: u64 = 0
    var init_status: u64 = 0
    while i < size && user.end_asked() == 0 {
        var j = i
        while j < size && byte_at(d + j) != 10 {
            j += 1
        }
        if j > i && byte_at(d + i) != 35 {
            k += 1
            run(k, d + i, j - i, k == total)
            if k == 1 {
                init_at = d + i
                init_len = j - i
                init_status = user.last_exit()
            }
        }
        i = j + 1
    }
    if user.end_asked() != 0 {
        bootmark.stage(bootmark.END) // px118: the boot complete
        user.the_end() // px67: root's reboot(2)
    }

    let s = sync.acquire(sync.console())
    log.put("run: ")
    log.dec(k as int)
    log.put(" commands")
    log.end()
    console.summary()
    speaker.summary() // px18: only when a tone was started
    sound.summary() // px30: only when /dev/dsp was opened
    mouse.summary() // px109: only when a pointer arrived or /dev/mouse0 was opened
    network_lines() // px105: only when the network carried anything
    dhcp.counters() // px105: only when the client ran
    clock.report() // px107: only when a reading was taken as no time passing
    sync.release(sync.console(), s)

    let _off = sync.irq_save()
    // px63: every volume written, marked clean and flushed; the disk's books.
    if block.count() != 0 {
        let e = tree.halt_volumes()
        if e != 0 {
            log.put("PAX: writing the volumes at the end: an I/O error, -")
            log.dec((!e + 1) as int)
            log.end()
        }
        block.summary()
    }
    // px67: init's line the last before `halt`, a disk or none, so a
    // log ends the same way from the ISO and from a disk (the volumes
    // and their books above it).
    log.put("PAX: init ")
    var p: u64 = 0
    while p < init_len && byte_at(init_at + p) != 32 {
        log.put_byte(byte_at(init_at + p) as int)
        p += 1
    }
    let st = init_status
    if st == 0 {
        log.put(" ended without an exit status")
    } else {
        log.put(" ended with status ")
        log.dec((st - 1) as int)
    }
    log.put("; nothing left to run")
    log.end()
    timer.stop()
    bootmark.stage(bootmark.END) // px118: the boot complete
    if boot_info.cmdline_has("pax.logflip") {
        bootlog.test_flip() // px118: test-only, the next boot must refuse this log
    }
    if fstab.staged_loaded() {
        // px115: the staged program ended (its own reboot(2) is the usual end): reboot, never
        // halt, so the machine comes back by itself; the attempts file bounds the tries
        log.line("staged: the staged program ended; reboot")
        power.reboot()
    }
    log.line("halt")
    panic.halt()
}
