//! member: false
// kmain_console.lu — what a person types reaches a program (px13,
// tests/mpx3-console). The kernel starts as kmain_boreutils does (PAX's
// paging with the initramfs mapped, the timer, the FPU state, the
// scheduler, SYSCALL), then starts the console's input (kernel/console:
// COM1's receiver and the i8042's keyboard, the line discipline) and
// runs the archive's `/etc/pax-run` as kmain_boreutils does — one
// command a line, its words separated by single spaces, each waited
// for — but with descriptors 0-2 a terminal: the program reads what is
// typed. The first command is init, pid 1 (px14: processes have Linux
// pids of their own, numbered from 1; px13's log said `pid 2`, the
// kernel thread's id), and since px14 it can start programs of its own
// (clone, execve, wait4): the environment carries PATH=/bin, where a
// shell finds them. When the list is done, the kernel says how init
// ended and halts:
//
//     PAX: the console
//     paging: …
//     console: com1 irq 4 vector 36, i8042 0x.. -> 0x.. irq 1 vector 33, 8259 master mask 0xec; …
//     run 1: /bin/pelt
//     user: exec pid 1 cr3 0x… …
//     $ echo hi
//     hi
//     $ cat /etc/motd
//     user: exec pid 2 cr3 0x… …          (pelt's child, px14)
//     PAX: this is /etc/motd, …
//     user: cat pid 2 exit_group 0 after <r> runs
//     $ …
//     user: pelt pid 1 exit_group 0 after <r> runs
//     user: frames free <A> before, <B> with 1 processes, <A> after
//     run: <k> commands
//     console: <n> bytes from com1, <k> keys (<s> scancodes) from the keyboard, …
//     PAX: init /bin/pelt ended with status 0; nothing left to run
//     halt
use apic
use console
use fb
use fpu
use frames
use initramfs
use interrupts
use log
use paging
use panic
use sched
use serial
use speaker
use sync
use timer
use user

extern "c" let pax_user_thread: *u8

const ENV: str = "HOME=/ TERM=linux PAX=1 PATH=/bin" // px14: PATH, for a shell's commands
const RUN_LIST: str = "/etc/pax-run"

/// The body ELF processes run (kernel/user's export).
fn body() -> u64 {
    // # Safety: the address of kernel/user's export; nothing is read.
    unsafe { pax_user_thread as u64 }
}

fn byte_at(a: u64) -> u64 {
    // # Safety: a byte of the run list, inside the initramfs's pages
    // (mapped read-only in the HHDM for the kernel's life).
    unsafe { (a as *u8).read_volatile() as u64 }
}

/// Run line number `k`, the `n` bytes at `a`: one command, waited for;
/// the frames line.
fn run(k: u64, a: u64, n: u64) {
    let s = sync.acquire(sync.console())
    log.put("run ")
    log.dec(k as int)
    log.put(": ")
    var i: u64 = 0
    while i < n {
        log.put_byte(byte_at(a + i) as int)
        i += 1
    }
    log.end()
    sync.release(sync.console(), s)
    let saved = sync.irq_save()
    let before = frames.free_count()
    var pl: u64 = 0
    while pl < n && byte_at(a + pl) != 32 {
        pl += 1
    }
    let id = user.exec_line(body(), a, pl, a, n, ENV)
    let during = frames.free_count()
    sync.irq_restore(saved)
    sched.wait_all()
    let after = frames.free_count()
    if log.quiet() { // px15: the kernel command line said `quiet`
        return
    }
    let s2 = sync.acquire(sync.console())
    log.put("user: frames free ")
    log.dec(before as int)
    log.put(" before, ")
    log.dec(during as int)
    log.put(" with ")
    log.dec((if id != 0 { 1 } else { 0 }) as int)
    log.put(" processes, ")
    log.dec(after as int)
    log.put(" after")
    log.end()
    sync.release(sync.console(), s2)
}

export fn kmain() {
    serial.init()
    log.line("PAX: the console")
    frames.start()
    let limine = paging.cr3()
    let before = frames.free_count()
    let pml4 = paging.start()
    paging.report(limine, before)
    let _screen = fb.start(pml4) // px19: the screen, when there is one (no line: serial unchanged)
    initramfs.report()
    initramfs.require()
    interrupts.start()
    apic.start(pml4)
    timer.start()
    fpu.start()
    fpu.report()
    sched.start(pml4)
    sched.report()
    user.start()
    user.report()
    console.start()
    console.report()
    sync.enable()

    let e = initramfs.lookup(RUN_LIST)
    if e == initramfs.END {
        panic.fail("console: no /etc/pax-run in the initramfs, bytes", initramfs.bytes())
    }
    let d = initramfs.data(e)
    let size = initramfs.size(e)
    var k: u64 = 0
    var i: u64 = 0
    var init_at: u64 = 0
    var init_len: u64 = 0
    var init_status: u64 = 0
    while i < size {
        var j = i
        while j < size && byte_at(d + j) != 10 {
            j += 1
        }
        if j > i && byte_at(d + i) != 35 {
            k += 1
            run(k, d + i, j - i)
            if k == 1 {
                init_at = d + i
                init_len = j - i
                init_status = user.last_exit()
            }
        }
        i = j + 1
    }

    let s = sync.acquire(sync.console())
    log.put("run: ")
    log.dec(k as int)
    log.put(" commands")
    log.end()
    console.summary()
    speaker.summary() // px18: only when a tone was started
    log.put("PAX: init ")
    var p: u64 = 0
    while p < init_len && byte_at(init_at + p) != 32 {
        log.put_byte(byte_at(init_at + p) as int)
        p += 1
    }
    let st = init_status
    if st == 0 {
        log.put(" ended without an exit status")
    } else {
        log.put(" ended with status ")
        log.dec((st - 1) as int)
    }
    log.put("; nothing left to run")
    log.end()
    sync.release(sync.console(), s)

    let _off = sync.irq_save()
    timer.stop()
    log.line("halt")
    panic.halt()
}
