//! boot_info — what Limine handed the kernel (px01, M-PX1; px02).
//!
//! The requests are in boot/start.S. Limine writes each response
//! pointer after the image is built (docs/BOOT.md clause 5), so every
//! read of a bootloader-written word here is one `read_volatile`
//! (wolf-lang kw07), through an address cast to a pointer (`N as *T`,
//! kw06), afresh on every call. Each request's address is its symbol in
//! boot/start.S, named with `extern "c" let` (kw10, over wolf-lang
//! kw09: until then boot/limine.S returned the addresses, because wolf
//! could not name a symbol the assembler defines, wolf-lang#529).
//! Responses are bootloader memory (bootloader-
//! reclaimable, mapped in the HHDM); their pointers are virtual
//! addresses the kernel can follow as they are.
//!
//! Layouts, from Limine's PROTOCOL.md (limine-protocol 3a0526b7),
//! read word by word at fixed offsets until kw08's `offset_of`:
//!   request: id[4] (0..31), revision (32), response pointer (40)
//!   bootloader info: revision, name (8), version (16): C strings
//!   firmware type: revision, type (8)
//!   HHDM: revision, offset (8)
//!   memory map: revision, entry_count (8), entries (16): an array of
//!     pointers to {base (0), length (8), type (16)}
//!   executable address: revision, physical_base (8), virtual_base (16)
//!   base revision tag: three words; Limine zeroes the third (16)
//!   module (px10): revision, module_count (8), modules (16): an array
//!     of pointers to `struct limine_file` {revision (0), address (8),
//!     size (16), path (24), string (32), …}; the address is virtual
//!     (the HHDM) at base revision 6, 4 KiB aligned, and every 4 KiB
//!     the file covers is its own. No response when no module was
//!     loaded.
//!   executable command line (px15): revision, cmdline (8): a C
//!     string, the configuration's `cmdline` (empty without one).

extern "c" let limine_base_revision: *u64
extern "c" let limine_bootloader_info_request: *u64
extern "c" let limine_firmware_type_request: *u64
extern "c" let limine_memmap_request: *u64
extern "c" let limine_hhdm_request: *u64
extern "c" let limine_executable_address_request: *u64
extern "c" let limine_module_request: *u64
extern "c" let limine_executable_cmdline_request: *u64
extern "c" let __pax_image_start: *u8
extern "c" let __pax_image_end: *u8

/// The address of request `which` in boot/start.S: 0 the base revision
/// tag, 1 bootloader info, 2 firmware type, 3 memory map, 4 HHDM, 5
/// executable address, 6 modules (px10), 7 the executable command line
/// (px15); 0 for any other `which`.
fn request(which: int) -> u64 {
    // # Safety: link-time addresses; nothing is read.
    unsafe {
        if which == 0 {
            return limine_base_revision as u64
        }
        if which == 1 {
            return limine_bootloader_info_request as u64
        }
        if which == 2 {
            return limine_firmware_type_request as u64
        }
        if which == 3 {
            return limine_memmap_request as u64
        }
        if which == 4 {
            return limine_hhdm_request as u64
        }
        if which == 5 {
            return limine_executable_address_request as u64
        }
        if which == 6 {
            return limine_module_request as u64
        }
        if which == 7 {
            return limine_executable_cmdline_request as u64
        }
    }
    0
}

/// One bootloader-written 64-bit word at virtual address `a` (8-aligned).
fn word(a: u64) -> u64 {
    // # Safety: `a` is inside a Limine request or response (each read
    // below names which), mapped and 8-aligned by the protocol.
    unsafe { (a as *u64).read_volatile() }
}

/// Request `which`'s response pointer (`request`'s numbering: 1
/// bootloader info, 2 firmware type, 3 memory map, 4 HHDM, 5 executable
/// address), or 0 when Limine gave none.
fn response(which: int) -> u64 {
    let req = request(which)
    if req == 0 {
        return 0
    }
    word(req + 40)
}

/// The bootloader's name (`which` 0) or version (`which` 1): its byte
/// `i` (0..=255), or -1 past the end, past 255 or without a response.
pub fn loader_byte(which: int, i: int) -> int {
    let r = response(1)
    if r == 0 || i < 0 || i > 255 {
        return -1
    }
    let s = if which == 0 { word(r + 8) } else { word(r + 16) }
    if s == 0 {
        return -1
    }
    var k = 0
    while k <= i {
        // # Safety: a C string Limine wrote; bytes up to its NUL are
        // inside it, and k never passes the NUL (the loop stops there).
        let b = unsafe { ((s + k as u64) as *u8).read_volatile() } as int
        if b == 0 {
            return -1
        }
        if k == i {
            return b
        }
        k = k + 1
    }
    -1
}

/// Byte `i` of the C string at `s`.
fn cbyte(s: u64, i: u64) -> u64 {
    // # Safety: a C string Limine wrote (the command line); callers stop
    // at its NUL, so every byte read is inside it.
    unsafe { ((s + i) as *u8).read_volatile() as u64 }
}

/// Whether the kernel's command line (the Limine configuration's
/// `cmdline`, px15) holds `w` as a whole word, words separated by
/// spaces; false without a response or a line. Read afresh on every
/// call (bootloader-reclaimable memory, which the kernel keeps mapped
/// and never hands out).
pub fn cmdline_has(w: str) -> bool {
    let r = response(7)
    if r == 0 {
        return false
    }
    let s = word(r + 8)
    if s == 0 {
        return false
    }
    var i: u64 = 0
    while cbyte(s, i) != 0 {
        if cbyte(s, i) == 32 {
            i += 1
            continue
        }
        // A word starts at i: compare it with `w`, never reading past a
        // byte that differed (the NUL differs from every byte of `w`).
        var k: u64 = 0
        var same = true
        for b in w.bytes() {
            if same {
                if cbyte(s, i + k) == (b as int) as u64 {
                    k += 1
                } else {
                    same = false
                }
            }
        }
        let e = cbyte(s, i + k)
        if same && k > 0 && (e == 0 || e == 32) {
            return true
        }
        while cbyte(s, i) != 0 && cbyte(s, i) != 32 {
            i += 1
        }
    }
    false
}

/// Whether Limine honoured base revision 6 (boot/start.S refuses to
/// call kmain otherwise, so a running kernel sees true).
pub fn revision_ok() -> bool {
    let tag = request(0)
    tag != 0 && word(tag + 16) == 0
}

/// The firmware type: 0 x86 BIOS, 1 32-bit UEFI, 2 64-bit UEFI, 3 SBI;
/// -1 without a response.
pub fn firmware() -> int {
    let r = response(2)
    if r == 0 {
        return -1
    }
    word(r + 8) as int
}

/// The firmware type's name as the transcript prints it.
pub fn firmware_name(t: int) -> str {
    if t == 0 {
        return "bios"
    }
    if t == 1 {
        return "uefi32"
    }
    if t == 2 {
        return "uefi64"
    }
    if t == 3 {
        return "sbi"
    }
    "unknown"
}

/// The higher-half direct map's offset, or 0 without a response.
pub fn hhdm() -> u64 {
    let r = response(4)
    if r == 0 {
        return 0
    }
    word(r + 8)
}

/// The memory map's entry count, or -1 without a response.
pub fn memmap_count() -> int {
    let r = response(3)
    if r == 0 {
        return -1
    }
    word(r + 8) as int
}

/// Entry `i`'s field `f` (0 base, 1 length, 2 type), or 0 when `i` is
/// out of range or there is no response (so check `i` first).
fn memmap_field(i: int, f: int) -> u64 {
    let r = response(3)
    if r == 0 || i < 0 || i >= word(r + 8) as int {
        return 0
    }
    let e = word(word(r + 16) + i as u64 * 8)
    if e == 0 {
        return 0
    }
    word(e + f as u64 * 8)
}

/// Entry `i`'s physical base address (0 out of range).
pub fn memmap_base(i: int) -> u64 {
    memmap_field(i, 0)
}

/// Entry `i`'s length in bytes (0 out of range).
pub fn memmap_length(i: int) -> u64 {
    memmap_field(i, 1)
}

/// Entry `i`'s type (0 usable, 1 reserved, 2 ACPI reclaimable, 3 ACPI
/// NVS, 4 bad, 5 bootloader reclaimable, 6 executable and modules,
/// 7 framebuffer, 8 reserved mapped; 0 out of range, so check `i`).
pub fn memmap_type(i: int) -> u64 {
    memmap_field(i, 2)
}

/// The bytes of every usable entry, summed (0 without a response).
pub fn usable_bytes() -> u64 {
    var total: u64 = 0
    var i = 0
    let n = memmap_count()
    while i < n {
        if memmap_type(i) == 0 {
            total = total + memmap_length(i)
        }
        i = i + 1
    }
    total
}

/// The kernel image's physical base (the Executable Address response),
/// or 0 without one.
pub fn image_phys() -> u64 {
    let r = response(5)
    if r == 0 {
        return 0
    }
    word(r + 8)
}

/// The kernel image's virtual base (the Executable Address response),
/// or 0 without one.
pub fn image_virt() -> u64 {
    let r = response(5)
    if r == 0 {
        return 0
    }
    word(r + 16)
}

/// The kernel image's size in bytes, from its first byte to the end of
/// its .bss (boot/kernel.ld's bounds).
pub fn image_bytes() -> u64 {
    // # Safety: two link-time addresses; nothing is read.
    unsafe { __pax_image_end as u64 - __pax_image_start as u64 }
}

/// How many modules Limine loaded (px10): 0 without a response.
pub fn module_count() -> u64 {
    let r = response(6)
    if r == 0 {
        return 0
    }
    word(r + 8)
}

/// Module `i`'s `struct limine_file` (its virtual address), or 0 when
/// `i` is out of range or there is no response.
fn module_file(i: u64) -> u64 {
    let r = response(6)
    if r == 0 || i >= word(r + 8) {
        return 0
    }
    word(word(r + 16) + i * 8)
}

/// Module `i`'s first byte, a virtual address in the HHDM (0 out of
/// range).
pub fn module_addr(i: u64) -> u64 {
    let f = module_file(i)
    if f == 0 {
        return 0
    }
    word(f + 8)
}

/// Module `i`'s size in bytes (0 out of range).
pub fn module_size(i: u64) -> u64 {
    let f = module_file(i)
    if f == 0 {
        return 0
    }
    word(f + 16)
}

/// Module `i`'s path's byte `k` (its path within the boot volume, with a
/// leading slash), or -1 past its NUL, past 255, or out of range.
pub fn module_path_byte(i: u64, k: u64) -> int {
    let f = module_file(i)
    if f == 0 || k > 255 {
        return -1
    }
    let s = word(f + 24)
    if s == 0 {
        return -1
    }
    var j: u64 = 0
    while j <= k {
        // # Safety: a C string Limine wrote; j never passes its NUL.
        let b = unsafe { ((s + j) as *u8).read_volatile() } as int
        if b == 0 {
            return -1
        }
        if j == k {
            return b
        }
        j += 1
    }
    -1
}
