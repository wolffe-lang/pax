//! files — a process's descriptors, the open files they name, pipes,
//! socketpairs, the working directory, and the read-only file tree a
//! process sees (px12, M-PX3; px17, pelt's plumbing).
//!
//! Written from man-pages `open(2)`/`openat(2)`, `read(2)`, `pread(2)`,
//! `lseek(2)`, `close(2)`, `stat(2)`, `statx(2)`, `getdents64(2)`,
//! `getcwd(3)`'s system call, `readlinkat(2)`, `ioctl(2)` and
//! `path_resolution(7)`; px17: `pipe(2)`, `pipe(7)`, `dup(2)`,
//! `fcntl(2)`, `chdir(2)`, `getcwd(3)`, `socketpair(2)`, `unix(7)`,
//! `recv(2)`, `send(2)`, `open(2)`'s open file descriptions; the uapi
//! headers `asm-generic/fcntl.h` and
//! `linux/fcntl.h` (O_*, AT_*, F_*), `arch/x86/include/uapi/asm/stat.h`
//! (`struct stat`, 144 bytes), `linux/stat.h` (`struct statx`, 256
//! bytes, STATX_*), `asm-generic/errno-base.h`/`errno.h`,
//! `linux/socket.h` and `linux/net.h` (AF_UNIX, SOCK_*); and black-box
//! strace of the binaries under test on Linux (`notes/px17/`). No Linux
//! source; no other kernel's source.
//!
//! **The tree** (px27) is kernel/tree's: inodes in memory, every file
//! and directory writable, the initramfs's entries its first inodes
//! (their bytes read in place until written). A path is resolved a
//! directory at a time (`walk`): `.` stays, `..` goes to the parent and
//! never above the root, a component that is not a directory is
//! -ENOTDIR, a missing one -ENOENT, one longer than 255 bytes
//! -ENAMETOOLONG. Relative paths start at the working directory (px17:
//! the process's own, `chdir`/`fchdir`, inherited by a child and kept
//! across `execve`; `/` for a fresh process), or at a directory
//! descriptor. Beside the tree, a synthetic `/dev`, a second file
//! system (its own device number; nothing is made, removed or renamed
//! in it): `/dev/stdin`, `/dev/stdout` and `/dev/stderr` are symbolic
//! links to `/proc/self/fd/0`, `1` and `2` (px52, pax#83: 0777, root's,
//! 15 bytes, as a distribution's boot and a container runtime make them
//! on Linux; devtmpfs alone has none), so a walk through one goes on
//! through the caller's own descriptor (-ENOENT when it is closed);
//! px55 (pax#88): `/dev/fd` beside them is a link to `/proc/self/fd`
//! (13 bytes), so `/dev/fd/N` is the caller's descriptor N; and
//! `/dev/null`
//! reads end-of-file and swallows writes; `/dev/tty0` and
//! `/dev/console` (px21a) open the console itself, whatever descriptors
//! 0-2 have become: reads, writes and the console's ioctls (the
//! terminal's, and kernel/speaker's KIOCSOUND and KDMKTONE, which a
//! Linux beep program asks of `/dev/tty0`). px45: `/dev/tty` (the
//! controlling terminal, the console for every process) and
//! `/dev/ttyS0` open it too; `/dev/zero` and `/dev/full` read zeros
//! (`/dev/full`'s writes -ENOSPC), `/dev/random` and `/dev/urandom` are
//! `getrandom`'s (kernel/user). Every device has devtmpfs's mode and is
//! root's, and `open` and the access family ask the class rule of it
//! (`checked`): the memory devices and `/dev/tty` 0666, the terminals
//! and `/dev/dsp` 0600 (measured). Nothing is a symbolic link
//! but `/proc/self/exe` (px26: `readlink` answers the path the program
//! was loaded from; there is no `/proc` beside it), and none can be
//! made (px36: the tree's own links; px50: `/proc/<pid>/fd`'s entries,
//! below; px52: `/dev/std*`; px55: `/dev/fd`). `openat` creates, truncates and opens for writing; `write`,
//! `pwrite64`, `ftruncate`, `mkdir`, `rmdir`, `unlink` and `rename`
//! change the tree (px27, below); a hard link, a change of mode, owner
//! or times are refused by name.
//!
//! **The descriptors** (128 a process since px24; 32 before) are words in the process's area
//! (kernel/sched's `proc_area`): per descriptor a kind, the node it
//! names, the open file it shares (px17; 0 for the console and
//! `/dev/null`, which keep no offset) and its flags (O_CLOEXEC is the
//! descriptor's own). A zeroed area is a fresh
//! process: descriptors 0, 1 and 2 the serial console (read takes what
//! was typed once kernel/console is started, px13, and gives end-of-file
//! before; write goes to the console through kernel/user's `write`), the
//! rest free. `openat` takes the lowest free
//! number, as Linux does.
//!
//! **Open files** (px17; Linux's "open file description", `open(2)`):
//! 512 records (px24; 64 before) in boot/user.S's `pax_ofiles`, each a reference count, the
//! kind, the node, the offset and the open flags. `openat` (a file, a
//! directory), `pipe2` and `socketpair` make one per descriptor they
//! return; `dup`, `dup2`, `dup3`, `fcntl(F_DUPFD…)` and a child's copy
//! of the table (`inherit`) share it, so reads and seeks through any of
//! them move one offset; `close`, `execve`'s close-on-exec and the end
//! of a process (`close_all`) drop a reference, and the last one frees
//! the record. Reopening `/dev/stdin` (or stdout, stderr) makes a new
//! open file at offset 0 on what that descriptor names: px52, through
//! the link and `/proc/self/fd/N`'s entry, so with its rules (a file by
//! its mode, a socket -ENXIO).
//!
//! **Pipes** (px17, `pipe(7)`): 64 buffer records (px24; 16 before) in `pax_pipes`. A
//! pipe holds 65536 bytes (Linux's default capacity) in 16 frames taken
//! at `pipe2` and given back when its last end closes. `read` of an empty
//! pipe with a writer open waits (`WAIT`: kernel/user rewinds the call
//! and kernel/sched's `block_pipe` parks the thread until the next
//! change), with none answers 0; it returns what is there, up to what was
//! asked. `write` writes everything it is given, waiting while the pipe
//! is full (a write of at most PIPE_BUF, 4096 bytes, waits until it fits
//! whole: atomic); what it has written across waits is its thread's
//! `done` word (kernel/sched, px26). With no reader it is -EPIPE (`EPIPE`; kernel/user
//! decides SIGPIPE). O_NONBLOCK answers -EAGAIN instead of waiting. An
//! end's `fstat` is a FIFO (S_IFIFO|0600), `lseek` and `pread` -ESPIPE,
//! `ioctl` -ENOTTY.
//!
//! **FIFOs** (px62, pax#108; `fifo(7)`, `mknod(2)`, `mkfifo(3)`,
//! `open(2)`): `mknodat` makes a FIFO in the tree (kernel/tree's
//! `mkfifo`; a regular file too), stat and a listing call it one; its
//! open ends are a pipe's ends over one buffer the FIFO keeps while any
//! end is open (`fifo_open`, the rules there), so everything above holds
//! for them; `fstat` of an end answers the FIFO. Written from those pages
//! and a static probe's answers on Linux (user/elf/fifos.c).
//!
//! **flock** (px62; `flock(2)`): an advisory lock belongs to an open file
//! (a file's, a directory's, a pipe's or a FIFO's end): word O_LOCK, a
//! conflict found by looking at every other open file on the same node,
//! a waiting lock run again when a lock goes (`flock`).
//!
//! **What `mmap` maps** (px62, `map_target`): a regular file of the tree
//! (kernel/vm keeps the mapping), /dev/zero (anonymous memory); a file
//! cut by `ftruncate`, `truncate` or O_TRUNC is unmapped past its new end
//! in every process first (`resize`, kernel/vm's `cut_maps`).
//!
//! **Socketpairs** (px17, `socketpair(2)`, AF_UNIX, SOCK_STREAM or
//! SOCK_SEQPACKET: what wolf's spawn uses to hear an `execve` fail in
//! its child): two one-frame buffers, one each way; each end reads one
//! and writes the other, as a pipe's ends do, `recvfrom` and `sendto`
//! with no address being `read` and `write`. Named drift: a
//! SOCK_SEQPACKET's record boundaries are not kept (a read takes what is
//! there, up to what was asked; wolf's spawn sends one 8-byte record).
//! `fstat` S_IFSOCK|0777.
//!
//! **AF_UNIX path sockets** (px34, `unix(7)`; the records are
//! kernel/unix's, the calls kernel/socket's way in): a descriptor of kind
//! K_UNIX names a socket record. `bind` makes a name in the tree (an
//! inode of mode S_IFSOCK, kernel/tree's `mksock`) that the socket holds
//! while it lives; `connect` resolves a path as `open` does and, at a
//! listener with room on its queue, makes the server's end at once (a
//! second record, QUEUED) and two buffers of the kind a socketpair has,
//! one each way, so a connection reads, writes, waits and is polled as a
//! socketpair's end; `accept` gives the queue's head a descriptor. The
//! answers are what Linux answered user/unix/unixprobe.c
//! (`notes/px34/linux/witness/`): a name that exists -EADDRINUSE; a name
//! that is no socket, a socket that does not listen and the name a
//! closed socket left -ECONNREFUSED; a queue of backlog + 1; a queued
//! connection whose listener closes, and a connection closed with bytes
//! unread, -ECONNRESET once at the peer's next read; `shutdown`'s two
//! halves, each end's from both sides. **socketpair(SOCK_SEQPACKET)**
//! (px34) keeps its messages: each goes into its buffer whole, behind an
//! eight-byte length, and a read takes one, the rest of it discarded.
//!
//! **`/proc` and `/sys`** (px34): the files lobo reads, kernel/procfs's,
//! each made when it is opened into a frame the open file holds (its
//! words 5 and 6) and given back at its last close; two file systems of
//! their own beside `/dev`, which the root does not list.
//!
//! **A process's descriptors in `/proc`** (px50, pax#78; `proc_pid_fd(5)`,
//! `proc_pid_fdinfo(5)`, measured black-box on Linux 7.2.8 by
//! `user/elf/fdtab.c`): an entry of `/proc/<pid>/fd` is a magic link. A
//! walk follows it where it would follow a link (not as the last
//! component of `lstat`, `readlink` or O_NOFOLLOW) to what the descriptor
//! is open on — no text is read, so a file renamed or removed since is
//! still reached, and `stat`, `statx` and a walk through a directory's
//! entry answer the target — after `ptrace(2)`'s read mode
//! (`may_trace`). `open` through it makes a new open file (offset 0) as
//! /dev/std* does; a pipe's end opens as the end asked, by the pipe's
//! owner and mode; a socket's -ENXIO; an eventfd's and an epoll
//! object's -EACCES or -ENXIO. `readlink` reads `fd_text`: a file's path
//! (the open file keeps the directory it was opened in, words 5 and 6,
//! and the name that directory gives it now; a removed name reads
//! `<path> (deleted)`), `pipe:[N]`, `socket:[N]`, `anon_inode:[eventfd]`.
//! `fdinfo/N` is made at open (`fdinfo_of`). A lookup in another
//! process's `fd/` or `fdinfo/` asks ptrace(2)'s read mode; a process
//! enters its own whatever their owner.
//!
//! **Copies in the kernel** (px26, what bu20's `cat` asks; px27, what
//! bu21's `cp` does): `sendfile` writes a file to the console,
//! `/dev/null`, a pipe, a socketpair or another file; `splice` moves
//! what a pipe holds to any of those, or a file into a pipe;
//! `copy_file_range` copies between two files, and is -EINVAL when
//! either end is no regular file.
//!
//! **What stat answers**: an inode's mode, size, link count, blocks
//! and times (kernel/tree; px27: a directory's size is 40 and 20 an
//! entry and its link count 2 and one a subdirectory, tmpfs's numbers);
//! the console a character device 4:64 (`/dev/ttyS0`'s numbers),
//! `/dev/tty0` 4:0 and `/dev/console` 5:1 (Linux's, `stat` on a Linux
//! host; mode 0600 since px45, devtmpfs's, 0620 before), `/dev/tty`
//! 5:0, `/dev/null` 1:3, px45: `/dev/zero` 1:5, `/dev/full` 1:7,
//! `/dev/random` 1:8, `/dev/urandom` 1:9; uid and gid an
//! inode's own and a `/proc/<pid>` node's its process's (px42), 0 for
//! the rest; st_blksize 4096,
//! st_blocks eight for every page of a file that holds bytes (px26:
//! whole pages, as Linux's file systems count a file); st_dev 0:1 for
//! the tree, 0:5 for `/dev` and what is in it. px63: a file of an ext2
//! volume (kernel/tree's second store) answers its own inode number,
//! its disk's numbers (254:0 for vda, Linux's), `i_blocks` and the
//! volume's block size as st_blksize; `statfs` and `fstatfs` answer the
//! volume's counts (EXT2_SUPER_MAGIC) or tmpfs's for the tree; `fsync`,
//! `fdatasync`, `syncfs` and `sync` write a volume's dirty blocks and
//! flush its disk; a change to a volume mounted read-only is -EROFS.
//!
//! **AF_INET sockets** (px22): a descriptor may name one of kernel/udp's
//! sockets (kind K_INET, an open file whose node is the socket's
//! number): `dup`, `fcntl` and a child's table share it as they share
//! any open file, and the last close frees the socket (`udp.close`).
//! Its calls are kernel/socket's; here it is only a descriptor: `fstat`
//! S_IFSOCK|0777, `lseek` and `pread` -ESPIPE, `ioctl` -ENOTTY. A stream
//! socket (px23) is the same shape over one of kernel/tcp's blocks
//! (kind K_TCP; the last close calls `tcp.close`), and `ioctl(FIONBIO)`
//! sets or clears O_NONBLOCK on either kind's open file.
//!
//! Every user buffer goes through kernel/uaccess (checked whole, then
//! copied through the HHDM). A path is copied into boot/user.S's
//! `pax_kbuf` (one CPU, IF clear for the whole call). No region, no
//! heap: the records are `.bss` words read volatile, a pipe's bytes are
//! frames reached through the HHDM (a call that waits gives up its
//! kernel stack: kernel/sched, "Regions").

use block
use console
use cred
use ext2
use event
use frames
use procfs
use sched
use sound
use tcp
use tree
use uaccess
use udp
use unix
use vm

extern "c" let pax_kbuf: *u8
extern "c" let pax_ofiles: *u64
extern "c" let pax_pipes: *u64

const PAGE: u64 = 4096
const PATH_MAX: u64 = 4095 // bytes before the NUL
const FIONBIO: u64 = 0x5421 // uapi asm-generic/ioctls.h (px23)
/// The number dup3 and dup2 take as "too large" (px14): FDS + 1, so
/// FDS itself can mean "the lowest free" for `dup`.
pub const FDS: u64 = 1024 // px34: lobo's worker_connections 1024 (128 since px24, 32 before)
const A_REFUSAL: u64 = 3 // the area's refusal word (kernel/vm's too)
const A_CWD: u64 = 12 // px17: the working directory's node; 0 the root
// word 13 was px17's count of bytes a waiting pipe write has written; px26
// keeps it per thread (kernel/sched's `self_done`): two threads of one
// process may each wait in a write.
const A_UMASK: u64 = 254 // px27: the file mode creation mask, with bit 16 set once `umask` has set it (0: 022)
const A_CONFL: u64 = 146 // px24: the status flags (O_NONBLOCK, O_APPEND) of the console as descriptors 0-2 name it from the start: one open file on Linux, so one word here
const A_EXE: u64 = 255 // px26: the program's file; px56: its open file (`exec_open`) + 1 (0: none); words 14, 15, 144 and 145 are kernel/socket's
const A_FD: u64 = 512 // the first descriptor's word (px24: FDS * FD_WORDS words from here; px34: 4096 of them, kernel/vm's ranges after)
const FD_WORDS: u64 = 4
// A descriptor's words: kind, node, open file + 1 (0 none), flags.
const D_KIND: u64 = 0
const D_NODE: u64 = 1
const D_OF: u64 = 2
const D_FLAGS: u64 = 3

// px17: open files (boot/user.S's pax_ofiles, 8 words each) and pipe
// buffers (pax_pipes, 32 words each).
const OFILES: u64 = 2048 // px34: 512 since px24, 64 before
const OF_WORDS: u64 = 8
const O_REFS: u64 = 0
const O_KIND: u64 = 1
const O_NODE: u64 = 2
const O_POS: u64 = 3
const O_FLAGS: u64 = 4
const O_TEXT: u64 = 5 // px34: a /proc or /sys file's text: its frame (physical)
const O_TEXT_LEN: u64 = 6 // and its length
const O_OWNER: u64 = 7 // px49 (pax#58): an AF_INET or TCP socket's maker's file-system ids (P_OWNER's shape)
// px62: every other kind's word 7 is its `flock` lock (LK_*; a lock
// belongs to the open file, flock(2)): a socket's holds its owner, so a
// socket keeps none.
const O_LOCK: u64 = 7
const LK_SH: u64 = 1
const LK_EX: u64 = 2
// px50: a file's or a directory's open file uses words 5 and 6 (a /proc
// file's text's words) for what `/proc/<pid>/fd/N` reads: the directory
// the file was opened in (its inode + 1, held while the open file lives),
// and, once the name is gone, a frame holding the text the link reads
// (`<path> (deleted)`: its length in the first word, the bytes after).
const O_DIRI: u64 = 5
const O_GONE: u64 = 6
const O_LARGEFILE: u64 = 0x8000 // px50: what fdinfo's flags show for every file `open` made (x86-64, measured)
const PIPES: u64 = 512 // px34: Unix connections take two each (64 since px24, 16 before)
const PP_WORDS: u64 = 32
const P_PAGES: u64 = 0 // frames held; 0 a free record
const P_READERS: u64 = 1
const P_WRITERS: u64 = 2
const P_RD: u64 = 3 // bytes read since it was made
const P_WR: u64 = 4 // bytes written
const P_OGEN: u64 = 5 // px24: times a read gave a writer room it did not have (an edge-triggered registration's count)
const P_MSG: u64 = 6 // px34: 1 for a SOCK_SEQPACKET buffer: messages behind an eight-byte length
const P_FRAME: u64 = 8 // the frames' physical addresses, from here (16 at most: words 8 to 23)
const P_OWNER: u64 = 24 // px43 (pax#58): a pipe's or a socketpair's maker's file-system user id (low 32 bits) and group id (high 32)
const P_CPID: u64 = 25 // px45: a socketpair's maker's pid + 1, for SO_PEERCRED (0: a pipe's)
const P_CIDS: u64 = 26 // px45: and its effective user id (low 32 bits) and group id (high 32)
const P_FIFO: u64 = 27 // px62: a FIFO's buffer: the FIFO's inode + 1, held while the buffer lives (0: a pipe's or a socket's)
const PIPE_PAGES: u64 = 16 // 65536 bytes, Linux's default capacity
const SOCK_PAGES: u64 = 1
/// PIPE_BUF (`pipe(7)`): a write of at most this many bytes is atomic.
const PIPE_BUF: u64 = 4096
/// The answer that means "wait and run the call again" (px17): never seen
/// by ring 3 (kernel/user rewinds the call and parks the thread).
pub const WAIT: u64 = 0xfffffffffffffdfe // -514
/// -EPIPE: kernel/user decides whether SIGPIPE ends the writer.
pub const EPIPE_R: u64 = 0xffffffffffffffe0 // -32

// Descriptor kinds. A zero word is "never opened": the console for 0-2,
// free above.
const K_DEFAULT: u64 = 0
const K_CLOSED: u64 = 1
const K_CONSOLE: u64 = 2
const K_FILE: u64 = 3
const K_DIR: u64 = 4
const K_NULL: u64 = 5
const K_PIPE: u64 = 6 // px17: an end of a pipe (O_RDONLY reads, O_WRONLY writes)
const K_SOCK: u64 = 7 // px17: an end of a socketpair
const K_INET: u64 = 8 // px22: an AF_INET datagram socket (kernel/udp's)
const K_TCP: u64 = 9 // px23: an AF_INET stream socket (kernel/tcp's)
const K_EVENT: u64 = 10 // px24: an eventfd (kernel/event's counter)
const K_EPOLL: u64 = 11 // px24: an epoll object (kernel/event's)
const K_DSP: u64 = 12 // px30: /dev/dsp, the sound device (kernel/sound's)
const K_UNIX: u64 = 13 // px34: an AF_UNIX path socket (kernel/unix's record)
const K_SYN: u64 = 14 // px34: a file of /proc or /sys (kernel/procfs's)
const K_BLK: u64 = 15 // px79: a block device's node opened (kernel/block's device)

// Nodes: a type in the top byte, a reference below (an entry's offset).
const T_SHIFT: u64 = 56
const TTY0: u64 = 1 // px21a: T_CONSOLE's reference for /dev/tty0
const CONSOLE: u64 = 2 // px21a: and for /dev/console
const TTY: u64 = 3 // px45: /dev/tty; px48: the caller's controlling terminal, -ENXIO when it has none
const TTYS0: u64 = 4 // px45: /dev/ttyS0, the serial port the console is
// px45: T_NULL's references: /dev/null 0, and the memory devices
// `null(4)` and `random(4)` name beside it.
const ZERO: u64 = 1
const FULL: u64 = 2
const RANDOM: u64 = 3
const URANDOM: u64 = 4
const T_DEV: u64 = 2
const T_CONSOLE: u64 = 4 // the reference: 0 the console as 0-2 name it, TTY0, CONSOLE
const T_NULL: u64 = 5
const T_STD: u64 = 6 // /dev/stdin, stdout, stderr: the reference is 0, 1, 2; px52: links to /proc/self/fd/N
const FD_LINK: u64 = 3 // px55 (pax#88): T_STD's reference for /dev/fd, a link to /proc/self/fd
const T_PIPE: u64 = 7 // px17: a pipe; the reference its record
const T_SOCK: u64 = 8 // px17: a socketpair's end; the reference rx << 16 | tx (px34; << 8 before)
const T_INET: u64 = 9 // px22: an AF_INET socket; the reference kernel/udp's number
const T_TCP: u64 = 10 // px23: a stream socket; the reference kernel/tcp's block
const T_INO: u64 = 11 // px27: a file or a directory of the tree; the reference kernel/tree's inode
const T_EVENT: u64 = 12 // px24: an eventfd; the reference kernel/event's counter
const T_EPOLL: u64 = 13 // px24: an epoll object; the reference kernel/event's
const T_DSP: u64 = 14 // px30: /dev/dsp
const T_UNIX: u64 = 15 // px34: an AF_UNIX path socket; the reference kernel/unix's record
const T_SYN: u64 = 16 // px34: a directory or file of /proc or /sys; the reference kernel/procfs's entry
const T_BLK: u64 = 17 // px79: a block device in /dev; the reference kernel/block's device | its record's generation << 16
const T_ERR: u64 = 0xff // an errno below
const REF_MASK: u64 = 0x00ffffffffffffff

// errnos (uapi asm-generic/errno-base.h)
const ENOENT: u64 = 2
const EBADF: u64 = 9
const EFAULT: u64 = 14
const EEXIST: u64 = 17
const ENOTDIR: u64 = 20
const EISDIR: u64 = 21
const EINVAL: u64 = 22
const EMFILE: u64 = 24
const ENFILE: u64 = 23 // px17: the open-file table (or the pipes) full
const EAGAIN: u64 = 11 // px17
const ENXIO: u64 = 6 // px17: reopening a socket through /dev/std*
const ENOSPC: u64 = 28 // px45: a write to /dev/full
const ESRCH: u64 = 3 // px45: a zombie's environ read
const ENOTSOCK: u64 = 88 // px17
const EAFNOSUPPORT: u64 = 97 // px17
const EPROTONOSUPPORT: u64 = 93 // px17
const ESOCKTNOSUPPORT: u64 = 94 // px17
const EISCONN: u64 = 106 // px17
const ENOTTY: u64 = 25
const ESPIPE: u64 = 29
const ENODEV: u64 = 19 // px44: fallocate of what is not a file
const EFBIG: u64 = 27 // px44
const EROFS: u64 = 30
const ERANGE: u64 = 34
const ENAMETOOLONG: u64 = 36
const EACCES: u64 = 13 // px14: execve of what is not an executable file
const EPERM: u64 = 1 // px27
const EBUSY: u64 = 16
const ENOTBLK: u64 = 15 // px67: a mount's source that is no block device
const EIO: u64 = 5 // px79: a block device's error
const EXDEV: u64 = 18
const ELOOP: u64 = 40
const ENOTEMPTY: u64 = 39
const EOPNOTSUPP: u64 = 95
const ENOMEM: u64 = 12 // px34
const ETXTBSY: u64 = 26 // px56 (pax#95): a running program's file opened for writing, or a file open for writing run
const EMSGSIZE: u64 = 90 // px34
const EPROTOTYPE: u64 = 91
const ENOPROTOOPT: u64 = 92
const EADDRINUSE: u64 = 98
const ENOBUFS: u64 = 105
const ECONNRESET: u64 = 104
const ENOTCONN: u64 = 107
const ECONNREFUSED: u64 = 111

// open flags (uapi asm-generic/fcntl.h, linux/fcntl.h)
const O_ACCMODE: u64 = 3
const O_RDONLY: u64 = 0
const O_WRONLY: u64 = 1
const O_CREAT: u64 = 0x40
const O_EXCL: u64 = 0x80
const O_TRUNC: u64 = 0x200
const O_DIRECTORY: u64 = 0x10000
const O_NONBLOCK: u64 = 0x800
const O_CLOEXEC: u64 = 0x80000 // px14: closed by execve
const O_RDWR: u64 = 2
const O_APPEND: u64 = 0x400 // px17: F_GETFL / F_SETFL
const O_DIRECT: u64 = 0x4000 // px17: pipe2 refuses it by name (packet mode)
const O_NOFOLLOW: u64 = 0x20000 // px27
const O_NOCTTY: u64 = 0x100 // px48: the console opened by a session leader does not become its terminal
const O_DSYNC: u64 = 0x1000 // px27: refused by name, with the next five
const O_SYNC_BIT: u64 = 0x100000 // O_SYNC is this and O_DSYNC
const O_NOATIME: u64 = 0x40000
const O_PATH: u64 = 0x200000
const O_TMPFILE_BIT: u64 = 0x400000 // O_TMPFILE is this and O_DIRECTORY
// px56: an open file that is a process's program (`exec_open`: never a
// descriptor's; no open flag has the bit): its last close releases the
// inode's running count (tree.run_hold).
const O_EXE: u64 = 0x10000000000
const AT_REMOVEDIR: u64 = 0x200 // px27: unlinkat
const AT_EACCESS: u64 = 0x200 // px27: faccessat2
const AT_FDCWD: u64 = 0xffffff9c // -100 as the 32-bit int the caller passes (kernel/user masks)
const AT_SYMLINK_NOFOLLOW: u64 = 0x100
const AT_EMPTY_PATH: u64 = 0x1000

// mode bits
const S_IFDIR: u64 = 0x4000
const S_IFMT: u64 = 0xf000 // px42, with the next five
const S_IFREG: u64 = 0x8000
const S_ISUID: u64 = 0x800
const S_ISGID: u64 = 0x400
const S_ISVTX: u64 = 0x200
const S_IXGRP: u64 = 0x8
const S_IFCHR: u64 = 0x2000
const S_IFBLK: u64 = 0x6000 // px62, with the next two
const S_IFIFO: u64 = 0x1000
const S_IFSOCK: u64 = 0xc000
const ENOLCK: u64 = 37 // px62
const LOCK_SH: u64 = 1 // px62: uapi asm-generic/fcntl.h, with the next three
const LOCK_EX: u64 = 2
const LOCK_NB: u64 = 4
const LOCK_UN: u64 = 8
const MODE_DIR: u64 = 0x41ed // 040755
// px45: /dev's modes are devtmpfs's own (no udev), measured on Linux
// 7.2.8: the memory devices and /dev/tty 0666; the terminals and the
// sound card 0600 (root's alone: a user's `open` is -EACCES by the
// class rule; a distribution's udev gives some to a group instead,
// which PAX has no rule for). Everything in /dev is root's, 0:0.
const MODE_CONSOLE: u64 = 0x2180 // 020600 (020620 before px45)
const MODE_LINK: u64 = 0xa1ff // 0120777: /dev/std*'s links (px52, measured)
const MODE_NULL: u64 = 0x21b6 // 020666
const MODE_DSP: u64 = 0x2180 // 020600 (020666 before px45; px30: one user here)
// px79: a block device, devtmpfs's own mode with no udev (measured on
// Linux 7.3.0: `brw-------`, root's; a distribution's udev gives the
// disk group 0660 instead, which PAX has no rule for).
const MODE_BLK: u64 = 0x6180 // 060600
const MODE_FIFO: u64 = 0x1180 // 010600: a pipe's end (px17, measured)
const MODE_SOCK: u64 = 0xc1ff // 0140777: a socketpair's end (px17, measured)
const MODE_ANON: u64 = 0x180 // 0600 and no type: an eventfd, an epoll object (px24, measured)
const DT_CHR: u64 = 2
const DT_BLK: u64 = 6 // px79
const DT_FIFO: u64 = 1 // px62
const DT_DIR: u64 = 4
const DT_REG: u64 = 8
const DT_SOCK: u64 = 12 // px34
const DT_LNK: u64 = 10 // px36
const MAXLINKS: u64 = 40 // px36: links followed in one resolution (path_resolution(7))
// px36: what a walk does with a symbolic link as the last component
// (measured on tmpfs): F_YES follows it; F_NO does not, but does when a
// `/` comes after it (`lstat`, `readlink`); F_NEVER does not even then,
// and answers the link itself, the trailing `/` said (`mkdir`, `rmdir`,
// `unlink`, `rename`, a new name for `link` and `symlink`).
const F_NO: u64 = 0
const F_YES: u64 = 1
const F_NEVER: u64 = 2

fn fol(b: bool) -> u64 {
    if b { F_YES } else { F_NO }
}
const AT_SYMLINK_FOLLOW: u64 = 0x400 // px36: linkat
const UTIME_NOW: u64 = 0x3fffffff // px36: (1 << 30) - 1, uapi linux/stat.h
const UTIME_OMIT: u64 = 0x3ffffffe

// Refusal codes for the area's word (kernel/vm uses 1-15).
// 16 was px12's refusal of every write (the initramfs was read-only);
// px79 takes it for a block ioctl PAX does not serve.
const R_BLKIOCTL: u64 = 16
const R_DIRECT: u64 = 17 // px17
const R_SOCKTYPE: u64 = 18 // px17
const R_FCNTL: u64 = 19 // px17
// px27 (from 31 down):
const R_OFLAG: u64 = 31
// 23 was px44's R_FALLOC (a fallocate mode): px49 answers every mode as Linux does
const R_DEVRO: u64 = 30
const R_LINK: u64 = 29
const R_META: u64 = 28
const R_RENFLAG: u64 = 27
const R_ATFLAG: u64 = 26
// 25 was px27's R_EXEC (a program written since boot): px56 loads every file through the tree
const R_FIXED: u64 = 24 // px36
// 23 was px36's R_OWNER (an owner that is not root): px42 keeps any id
const R_SOCKNODE: u64 = 23 // px62
const R_FLOCK: u64 = 25 // px62

/// -e as %rax carries it.
pub fn neg(e: u64) -> u64 {
    0xffffffffffffffff - e + 1
}

fn get(a: u64, i: u64) -> u64 {
    // # Safety: `a` is a process area (sched.proc_area), 1024 words; i < 1024.
    unsafe { ((a + i * 8) as *u64).read_volatile() }
}

fn put(a: u64, i: u64, v: u64) {
    // # Safety: as `get`.
    unsafe { ((a + i * 8) as *u64).write_volatile(v) }
}

/// A refusal code's name ("" when not this module's).
pub fn why(r: u64) -> str {
    if r >= unix.R_ABSTRACT && r <= unix.R_OPTION {
        return unix.why(r) // px34: codes 20-22
    }
    if r == R_OFLAG {
        return "an open flag PAX does not honour (O_DIRECT, O_SYNC, O_DSYNC, O_NOATIME, O_PATH, O_TMPFILE; px79: the first three are taken on a block device)"
    }
    if r == R_BLKIOCTL {
        return "a block device ioctl PAX does not serve (BLKRAGET, BLKSECTGET, BLKDISCARD, BLKZEROOUT, BLKROSET, BLKPG_RESIZE_PARTITION and the rest of the 0x12 and HDIO families but those docs/CENSUS.md names served)"
    }
    if r == R_DEVRO {
        return "making or removing a name in /dev (PAX's /dev is fixed)"
    }
    if r == R_LINK {
        return "a device node (the tree makes none)"
    }
    if r == R_META {
        return "utime or utimes (in no strace: utimensat sets the times)"
    }
    if r == R_FIXED {
        return "a mode, an owner, times or a link of what PAX keeps fixed (/dev, /proc, /sys, a pipe, a socket)"
    }
    if r == R_SOCKNODE {
        return "a socket's name made by mknod (bind makes one)"
    }
    if r == R_FLOCK {
        return "flock of a descriptor PAX keeps no lock for (a socket, the console as a process starts with it, /dev/null, an eventfd, an epoll object)"
    }
    if r == R_RENFLAG {
        return "a renameat2 flag (RENAME_NOREPLACE, RENAME_EXCHANGE, RENAME_WHITEOUT)"
    }
    if r == R_ATFLAG {
        return "an unlinkat flag that is not AT_REMOVEDIR"
    }
    if r == R_DIRECT {
        return "a packet-mode pipe (O_DIRECT)"
    }
    if r == R_SOCKTYPE {
        return "a socketpair that is not AF_UNIX stream or seqpacket"
    }
    if r == R_FCNTL {
        return "an fcntl command PAX does not take"
    }
    ""
}

// --- open files and pipes (px17) ---------------------------------------------

fn ofw(i: u64, w: u64) -> u64 {
    // # Safety: i < OFILES, w < OF_WORDS: inside boot/user.S's pax_ofiles.
    unsafe { ((pax_ofiles as u64 + (i * OF_WORDS + w) * 8) as *u64).read_volatile() }
}

fn put_ofw(i: u64, w: u64, v: u64) {
    // # Safety: as `ofw`.
    unsafe { ((pax_ofiles as u64 + (i * OF_WORDS + w) * 8) as *u64).write_volatile(v) }
}

fn ppw(p: u64, w: u64) -> u64 {
    // # Safety: p < PIPES, w < PP_WORDS: inside boot/user.S's pax_pipes.
    unsafe { ((pax_pipes as u64 + (p * PP_WORDS + w) * 8) as *u64).read_volatile() }
}

fn put_ppw(p: u64, w: u64, v: u64) {
    // # Safety: as `ppw`.
    unsafe { ((pax_pipes as u64 + (p * PP_WORDS + w) * 8) as *u64).write_volatile(v) }
}

/// A pipe buffer of `pages` frames: its record, or PIPES when no record
/// or frame is free (nothing kept).
fn pipe_new(pages: u64) -> u64 {
    var p: u64 = 0
    while p < PIPES && ppw(p, P_PAGES) != 0 {
        p += 1
    }
    if p == PIPES {
        return PIPES
    }
    var k: u64 = 0
    while k < pages {
        let pa = frames.alloc() else 0
        if pa == 0 {
            while k > 0 {
                k -= 1
                frames.free(ppw(p, P_FRAME + k))
            }
            return PIPES
        }
        put_ppw(p, P_FRAME + k, pa)
        k += 1
    }
    put_ppw(p, P_READERS, 0)
    put_ppw(p, P_WRITERS, 0)
    put_ppw(p, P_RD, 0)
    put_ppw(p, P_WR, 0)
    put_ppw(p, P_MSG, 0)
    put_ppw(p, P_CPID, 0) // px45: a pipe's, until a socketpair sets it
    put_ppw(p, P_FIFO, 0) // px62: a pipe's, until a FIFO's open sets it
    put_ppw(p, P_PAGES, pages)
    p
}

/// Pipe `p`'s frames given back once neither end is open.
fn pipe_settle(p: u64) {
    if ppw(p, P_READERS) != 0 || ppw(p, P_WRITERS) != 0 {
        return
    }
    let n = ppw(p, P_PAGES)
    var k: u64 = 0
    while k < n {
        frames.free(ppw(p, P_FRAME + k))
        put_ppw(p, P_FRAME + k, 0)
        k += 1
    }
    put_ppw(p, P_PAGES, 0)
    let fi = ppw(p, P_FIFO)
    if fi != 0 {
        // px62: a FIFO's buffer goes with its last end (what was in it is
        // gone, fifo(7)), and its hold on the FIFO.
        put_ppw(p, P_FIFO, 0)
        tree.set_fifo_pipe(fi - 1, 0)
        tree.release(fi - 1)
    }
}

/// What an open file of kind `k` on node `n` with access `acc` adds to
/// (+1) or takes from (-1) its pipes' reader and writer counts.
fn pipe_ends(k: u64, n: u64, acc: u64, up: bool) {
    if k == K_PIPE {
        let p = rf(n)
        if acc != O_WRONLY {
            put_ppw(p, P_READERS, if up { ppw(p, P_READERS) + 1 } else { ppw(p, P_READERS) - 1 })
        }
        if acc != O_RDONLY {
            put_ppw(p, P_WRITERS, if up { ppw(p, P_WRITERS) + 1 } else { ppw(p, P_WRITERS) - 1 })
        }
        if !up {
            pipe_settle(p)
        }
    } else if k == K_SOCK {
        let rx = (rf(n) >> 16) & 0xffff
        let tx = rf(n) & 0xffff
        put_ppw(rx, P_READERS, if up { ppw(rx, P_READERS) + 1 } else { ppw(rx, P_READERS) - 1 })
        put_ppw(tx, P_WRITERS, if up { ppw(tx, P_WRITERS) + 1 } else { ppw(tx, P_WRITERS) - 1 })
        if !up {
            pipe_settle(rx)
            pipe_settle(tx)
        }
    } else {
        if k == K_INET && !up {
            udp.close(rf(n)) // px22: the socket goes with its last descriptor
        }
        if k == K_TCP && !up {
            tcp.close(rf(n)) // px23: the connection closes with its last descriptor
        }
        if k == K_EVENT && !up {
            event.ev_free(rf(n)) // px24
        }
        if k == K_EPOLL && !up {
            event.ep_free(rf(n)) // px24: its registrations go with it
        }
        if k == K_UNIX && !up {
            unix_close(rf(n)) // px34: the socket goes with its last descriptor
        }
        return
    }
    sched.wake_pipes() // an end opened or closed: a waiter's answer may change
}

/// A new open file (one reference): its index + 1, or 0 when the table
/// is full.
fn of_new(k: u64, n: u64, flags: u64) -> u64 {
    var i: u64 = 0
    while i < OFILES && ofw(i, O_REFS) != 0 {
        i += 1
    }
    if i == OFILES {
        return 0
    }
    put_ofw(i, O_REFS, 1)
    put_ofw(i, O_KIND, k)
    put_ofw(i, O_NODE, n)
    put_ofw(i, O_POS, 0)
    put_ofw(i, O_FLAGS, flags & !O_CLOEXEC)
    put_ofw(i, O_OWNER, 0)
    put_ofw(i, O_DIRI, 0) // px50 (O_TEXT's word)
    put_ofw(i, O_GONE, 0)
    pipe_ends(k, n, flags & O_ACCMODE, true)
    if ty(n) == T_INO {
        tree.hold(rf(n)) // px27: an open file keeps its inode, named or not
    }
    i + 1
}

fn of_ref(o: u64) {
    if o != 0 {
        put_ofw(o - 1, O_REFS, ofw(o - 1, O_REFS) + 1)
    }
}

/// Drop a reference to open file `o` (index + 1; 0 nothing); the last
/// one frees it and closes its pipe ends.
fn of_drop(o: u64) {
    if o == 0 {
        return
    }
    let i = o - 1
    let r = ofw(i, O_REFS)
    if r > 1 {
        put_ofw(i, O_REFS, r - 1)
        return
    }
    let k = ofw(i, O_KIND)
    let n = ofw(i, O_NODE)
    let acc = ofw(i, O_FLAGS) & O_ACCMODE
    let exe = ofw(i, O_FLAGS) & O_EXE != 0
    let excl = ofw(i, O_FLAGS) & O_EXCL != 0 // px79: a block device's exclusive open
    if locks(k) && ofw(i, O_LOCK) != 0 {
        put_ofw(i, O_LOCK, 0) // px62: the open file's lock goes with it
        sched.wake_pipes() // a waiting `flock` may have it now
    }
    // px24: a registration lasts as long as its open file (epoll(7)).
    if event.forget(o) != 0 {
        sched.wake_pipes()
    }
    put_ofw(i, O_REFS, 0)
    put_ofw(i, O_KIND, 0)
    put_ofw(i, O_NODE, 0)
    put_ofw(i, O_POS, 0)
    put_ofw(i, O_FLAGS, 0)
    pipe_ends(k, n, acc, false)
    if exe && ty(n) == T_INO {
        tree.run_release(rf(n)) // px56: one program fewer runs from it
    }
    if ty(n) == T_INO {
        tree.release(rf(n)) // px27: the last close of a file with no name gives its frames back
    }
    if k == K_SYN && ofw(i, O_TEXT) != 0 {
        frames.free(ofw(i, O_TEXT)) // px34: a /proc or /sys file's text
        put_ofw(i, O_TEXT, 0)
        put_ofw(i, O_TEXT_LEN, 0)
    }
    if k == K_FILE || k == K_DIR {
        // px50: the directory it was opened in, and a gone name's text
        let di = ofw(i, O_DIRI)
        let g = ofw(i, O_GONE)
        put_ofw(i, O_DIRI, 0)
        put_ofw(i, O_GONE, 0)
        if di != 0 {
            tree.release(di - 1)
        }
        if g != 0 {
            frames.free(g)
        }
    }
    if k == K_DSP {
        sound.release() // px30: the last close of /dev/dsp
    }
    if k == K_BLK {
        // px79: the last close of an open block device (an O_EXCL open's hold goes with it)
        block.close_dev(blk_dev(n), excl)
    }
}

/// Whether a kind keeps an open file (an offset, a pipe end).
fn has_of(k: u64) -> bool {
    k == K_FILE || k == K_DIR || k == K_PIPE || k == K_SOCK || k == K_INET || k == K_TCP || k == K_EVENT || k == K_EPOLL || k == K_DSP || k == K_UNIX || k == K_SYN || k == K_BLK
}

// --- descriptors -------------------------------------------------------------

fn fdw(fd: u64, w: u64) -> u64 {
    A_FD + fd * FD_WORDS + w
}

/// Descriptor `fd`'s kind (K_DEFAULT read as what it means).
fn kind(a: u64, fd: u64) -> u64 {
    if fd >= FDS {
        return K_CLOSED
    }
    let k = get(a, fdw(fd, D_KIND))
    if k == K_DEFAULT {
        if fd < 3 {
            return K_CONSOLE
        }
        return K_CLOSED
    }
    k
}

fn node_of(a: u64, fd: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CONSOLE {
        // px21a: a descriptor opened through /dev/tty0 or /dev/console
        // keeps which (for fstat); 0-2 as a process starts have no node.
        let n = get(a, fdw(fd, D_NODE))
        return if ty(n) == T_CONSOLE { n } else { T_CONSOLE << T_SHIFT }
    }
    if k == K_NULL {
        let n = get(a, fdw(fd, D_NODE)) // px45: which memory device
        return if ty(n) == T_NULL { n } else { T_NULL << T_SHIFT }
    }
    get(a, fdw(fd, D_NODE))
}

/// The open file descriptor `fd` shares (index + 1; 0 none).
fn of_of(a: u64, fd: u64) -> u64 {
    if kind(a, fd) == K_CLOSED {
        return 0
    }
    get(a, fdw(fd, D_OF))
}

/// The offset (of the open file: shared by every duplicate, px17).
fn pos(a: u64, fd: u64) -> u64 {
    let o = of_of(a, fd)
    if o == 0 {
        return 0
    }
    ofw(o - 1, O_POS)
}

fn set_pos(a: u64, fd: u64, p: u64) {
    let o = of_of(a, fd)
    if o != 0 {
        put_ofw(o - 1, O_POS, p)
    }
}

fn access(a: u64, fd: u64) -> u64 {
    if get(a, fdw(fd, D_KIND)) == K_DEFAULT {
        return 2 // O_RDWR: the console as Linux's terminal is opened
    }
    get(a, fdw(fd, D_FLAGS)) & O_ACCMODE
}

/// The status flags (O_NONBLOCK, O_APPEND): the open file's when there is
/// one (F_SETFL changes them for every duplicate), else the descriptor's.
fn status(a: u64, fd: u64) -> u64 {
    let o = of_of(a, fd)
    if o != 0 {
        return ofw(o - 1, O_FLAGS)
    }
    if get(a, fdw(fd, D_KIND)) == K_DEFAULT {
        return get(a, A_CONFL) // px24: the console as a process starts with it
    }
    get(a, fdw(fd, D_FLAGS))
}

/// Whether descriptor `fd` is open.
pub fn is_open(a: u64, fd: u64) -> bool {
    kind(a, fd) != K_CLOSED
}

/// What a `write` to descriptor `fd` reaches (kernel/user's `write`):
/// 1 the console (kernel/user sends the bytes), 0 a sink that swallows
/// them (/dev/null), 2 nothing writable (-EBADF), 3 a pipe or a socket
/// (px17: `pipe_write`), 4 a file of the tree (px27: `file_write`),
/// 5 an eventfd (px24: `event_write`), 6 an epoll object (px24: -EINVAL), 7
/// /dev/dsp (px30: kernel/sound's `write`), 9 a block device's node (px79:
/// `blk_write`); px34: an AF_UNIX path socket
/// is 3 (`pipe_write` answers for a socket that is not connected), a file
/// of /proc or /sys 6 (-EINVAL, as Linux answered a write to
/// /proc/self/cgroup).
pub fn write_target(a: u64, fd: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED || access(a, fd) == O_RDONLY {
        return 2
    }
    if k == K_CONSOLE {
        return 1
    }
    if k == K_NULL {
        return if rf(node_of(a, fd)) == FULL { 8 } else { 0 } // px45: /dev/full is always full
    }
    if k == K_PIPE || k == K_SOCK || k == K_UNIX {
        return 3
    }
    if k == K_FILE {
        return 4
    }
    if k == K_SYN {
        return 6
    }
    if k == K_EVENT {
        return 5
    }
    if k == K_EPOLL {
        return 6
    }
    if k == K_DSP {
        return 7 // px30: kernel/sound's `write`
    }
    if k == K_BLK {
        return 9 // px79: `blk_write`
    }
    2
}

/// Descriptor `fd` made to name kind `k`, node `node`, open file `o`
/// (index + 1, already counted; 0 none), with `flags`.
fn install(a: u64, fd: u64, k: u64, node: u64, o: u64, flags: u64) {
    put(a, fdw(fd, D_KIND), k)
    put(a, fdw(fd, D_NODE), node)
    put(a, fdw(fd, D_OF), o)
    put(a, fdw(fd, D_FLAGS), flags)
}

/// A new descriptor, the lowest free at or above `min`, naming a fresh
/// open file (when kind `k` keeps one) on `node` with `flags`: the
/// number, or -EMFILE / -ENFILE.
fn open_new(a: u64, min: u64, k: u64, node: u64, flags: u64) -> u64 {
    let fd = lowest_free(a, min)
    if fd == FDS {
        return neg(EMFILE)
    }
    var o: u64 = 0
    if has_of(k) {
        o = of_new(k, node, flags)
        if o == 0 {
            return neg(ENFILE)
        }
    }
    install(a, fd, k, node, o, flags)
    fd
}

fn lowest_free(a: u64, min: u64) -> u64 {
    var fd = min
    while fd < FDS {
        if kind(a, fd) == K_CLOSED {
            return fd
        }
        fd += 1
    }
    FDS
}

/// `close(fd)`.
pub fn close(a: u64, fd: u64) -> u64 {
    if kind(a, fd) == K_CLOSED {
        return neg(EBADF)
    }
    let o = get(a, fdw(fd, D_OF))
    if fd < 3 {
        install(a, fd, K_CLOSED, 0, 0, 0)
    } else {
        install(a, fd, K_DEFAULT, 0, 0, 0)
    }
    of_drop(o)
    0
}

/// px30: whether closing `fd` is the last close of /dev/dsp, which
/// waits for the device to play what is queued (its last reference,
/// O_NONBLOCK or not: Linux's close drains either way, measured):
/// kernel/user drains it (`sound.drain`) first.
pub fn closes_dsp(a: u64, fd: u64) -> bool {
    if kind(a, fd) != K_DSP {
        return false
    }
    let o = get(a, fdw(fd, D_OF))
    o != 0 && ofw(o - 1, O_REFS) == 1
}

/// The open flags descriptor `fd` (open) carries: the console's
/// default descriptors are O_RDWR, as Linux's terminal is opened.
fn flags_of(a: u64, fd: u64) -> u64 {
    if get(a, fdw(fd, D_KIND)) == K_DEFAULT {
        return O_RDWR
    }
    get(a, fdw(fd, D_FLAGS))
}

/// px14: `dup(old)` (`new` FDS: the lowest free number), `dup2(old,
/// new)` and `dup3(old, new, flags)` (`cloexec`: O_CLOEXEC on the copy).
/// The copy names what `old` names, without close-on-exec unless asked;
/// what `new` named is closed first. px17: the copy shares `old`'s open
/// file, so its offset and status flags are one (Linux's rule; px14
/// kept a position per descriptor).
pub fn dup(a: u64, old: u64, new: u64, cloexec: bool) -> u64 {
    if new == FDS {
        return dup_from(a, old, 0, cloexec)
    }
    let k = kind(a, old)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if new > FDS {
        return neg(EBADF)
    }
    if new == old {
        return new
    }
    if kind(a, new) != K_CLOSED {
        let _c = close(a, new)
    }
    copy_fd(a, old, new, cloexec)
    new
}

/// px17: `fcntl(old, F_DUPFD[_CLOEXEC], min)` (and `dup`): the lowest
/// free descriptor at or above `min` made a copy of `old`.
pub fn dup_from(a: u64, old: u64, min: u64, cloexec: bool) -> u64 {
    if kind(a, old) == K_CLOSED {
        return neg(EBADF)
    }
    if min >= FDS {
        return neg(EINVAL)
    }
    let to = lowest_free(a, min)
    if to == FDS {
        return neg(EMFILE)
    }
    copy_fd(a, old, to, cloexec)
    to
}

fn copy_fd(a: u64, old: u64, to: u64, cloexec: bool) {
    var fl = flags_of(a, old) & !O_CLOEXEC
    if cloexec {
        fl = fl | O_CLOEXEC
    }
    let o = of_of(a, old)
    of_ref(o)
    install(a, to, kind(a, old), node_of(a, old), o, fl)
}

/// px14: `execve` closes every descriptor opened with O_CLOEXEC (or
/// given it by dup3).
pub fn exec_close(a: u64) {
    var fd: u64 = 0
    while fd < FDS {
        if kind(a, fd) != K_CLOSED && flags_of(a, fd) & O_CLOEXEC != 0 {
            let _c = close(a, fd)
        }
        fd += 1
    }
}

/// px17: a child's descriptors (kernel/sched copied the parent's table
/// into its area `a`) take their own references to the open files they
/// share with the parent.
pub fn inherit(a: u64) {
    var fd: u64 = 0
    while fd < FDS {
        of_ref(of_of(a, fd))
        fd += 1
    }
    let c = get(a, A_CWD)
    if ty(c) == T_INO {
        tree.hold(rf(c)) // px27: the child works in the directory too
    }
    of_ref(get(a, A_EXE)) // px56: and runs the same program
}

/// px17: a process's end closes every descriptor it holds, so a pipe's
/// last writer gone reads as end-of-file at once.
pub fn close_all(a: u64) {
    var fd: u64 = 0
    while fd < FDS {
        if kind(a, fd) != K_CLOSED {
            let _c = close(a, fd)
        }
        fd += 1
    }
    let c = get(a, A_CWD)
    put(a, A_CWD, 0)
    if ty(c) == T_INO {
        tree.release(rf(c)) // px27: and leaves its working directory
    }
    let x = get(a, A_EXE)
    put(a, A_EXE, 0)
    of_drop(x) // px56: and its program's file
    vm.drop_all(a) // px62: and the files its mappings hold
    var w = sched.take_group_fifo()
    while w != 0 {
        abandon(w) // px62: and a FIFO open any of its threads waited in
        w = sched.take_group_fifo()
    }
}

/// px17: `fcntl(fd, cmd, arg)`: F_DUPFD (0), F_DUPFD_CLOEXEC (1030),
/// F_GETFD (1, FD_CLOEXEC), F_SETFD (2), F_GETFL (3: the access mode and
/// O_APPEND/O_NONBLOCK), F_SETFL (4: O_APPEND and O_NONBLOCK, on the
/// open file), F_GETPIPE_SZ (1032: 65536 on a pipe). Any other command
/// is refused by name, -EINVAL.
pub fn fcntl(a: u64, fd: u64, cmd: u64, arg: u64) -> u64 {
    if kind(a, fd) == K_CLOSED {
        return neg(EBADF)
    }
    if cmd == 0 || cmd == 1030 {
        return dup_from(a, fd, arg & 0xffffffff, cmd == 1030)
    }
    if cmd == 1 {
        return if flags_of(a, fd) & O_CLOEXEC != 0 { 1 } else { 0 }
    }
    if cmd == 2 {
        var fl = flags_of(a, fd) & !O_CLOEXEC
        if arg & 1 != 0 {
            fl = fl | O_CLOEXEC
        }
        if get(a, fdw(fd, D_KIND)) == K_DEFAULT {
            // The console's never-opened 0-2: made explicit to keep the bit.
            install(a, fd, K_CONSOLE, T_CONSOLE << T_SHIFT, 0, fl)
        } else {
            put(a, fdw(fd, D_FLAGS), fl)
        }
        return 0
    }
    if cmd == 3 {
        return access(a, fd) | (status(a, fd) & (O_APPEND | O_NONBLOCK))
    }
    if cmd == 4 {
        let keep = O_APPEND | O_NONBLOCK
        let o = of_of(a, fd)
        if o != 0 {
            put_ofw(o - 1, O_FLAGS, (ofw(o - 1, O_FLAGS) & !keep) | (arg & keep))
        } else if get(a, fdw(fd, D_KIND)) != K_DEFAULT {
            put(a, fdw(fd, D_FLAGS), (get(a, fdw(fd, D_FLAGS)) & !keep) | (arg & keep))
        } else {
            // px24: descriptors 0-2 as a process starts with them are
            // one open file on Linux: one word holds their flags.
            put(a, A_CONFL, (get(a, A_CONFL) & !keep) | (arg & keep))
        }
        return 0
    }
    if cmd == 1032 {
        if kind(a, fd) != K_PIPE {
            return neg(EBADF)
        }
        return PIPE_PAGES * PAGE
    }
    put(a, A_REFUSAL, R_FCNTL)
    neg(EINVAL)
}

/// px17: `pipe2(fds, flags)` (and `pipe`, flags 0): a pipe, its read end
/// at the lowest free descriptor and its write end at the next, the two
/// ints written at `va`. O_CLOEXEC and O_NONBLOCK are taken; O_DIRECT
/// (packet mode) is refused by name; anything else -EINVAL.
pub fn pipe2(a: u64, pml4: u64, va: u64, flags: u64) -> u64 {
    if flags & !(O_CLOEXEC | O_NONBLOCK | O_DIRECT) != 0 {
        return neg(EINVAL)
    }
    if flags & O_DIRECT != 0 {
        put(a, A_REFUSAL, R_DIRECT)
        return neg(EINVAL)
    }
    if !uaccess.writable(pml4, va, 8) {
        return neg(EFAULT)
    }
    let r = lowest_free(a, 0)
    if r == FDS || lowest_free(a, r + 1) == FDS {
        return neg(EMFILE)
    }
    let p = pipe_new(PIPE_PAGES)
    if p == PIPES {
        return neg(ENFILE)
    }
    put_ppw(p, P_OWNER, fs_ids(a)) // px43 (pax#58)
    let n = (T_PIPE << T_SHIFT) | p
    let fr = open_new(a, 0, K_PIPE, n, O_RDONLY | flags)
    if fr >= 0x8000000000000000 {
        pipe_settle(p)
        return fr
    }
    let fw = open_new(a, 0, K_PIPE, n, O_WRONLY | flags)
    if fw >= 0x8000000000000000 {
        let _c = close(a, fr)
        return fw
    }
    uaccess.put(pml4, va, fr, 4)
    uaccess.put(pml4, va + 4, fw, 4)
    0
}

/// px17: `socketpair(domain, type, protocol, sv)`: AF_UNIX (1) with
/// SOCK_STREAM (1) or SOCK_SEQPACKET (5), SOCK_CLOEXEC and SOCK_NONBLOCK
/// taken; two connected ends, the descriptors written at `sv`. Another
/// domain -EAFNOSUPPORT, a protocol -EPROTONOSUPPORT; another type
/// (SOCK_DGRAM) is refused by name, -ESOCKTNOSUPPORT.
pub fn socketpair(a: u64, pml4: u64, domain: u64, ty: u64, proto: u64, sv: u64) -> u64 {
    if domain != 1 {
        return neg(EAFNOSUPPORT)
    }
    let base = ty & 0xf
    if ty & !(0xf | O_CLOEXEC | O_NONBLOCK) != 0 {
        return neg(EINVAL)
    }
    if base != 1 && base != 5 {
        put(a, A_REFUSAL, R_SOCKTYPE)
        return neg(ESOCKTNOSUPPORT)
    }
    if proto != 0 {
        return neg(EPROTONOSUPPORT)
    }
    if !uaccess.writable(pml4, sv, 8) {
        return neg(EFAULT)
    }
    let s0 = lowest_free(a, 0)
    if s0 == FDS || lowest_free(a, s0 + 1) == FDS {
        return neg(EMFILE)
    }
    let c1 = pipe_new(SOCK_PAGES)
    if c1 == PIPES {
        return neg(ENFILE)
    }
    let c2 = pipe_new(SOCK_PAGES)
    if c2 == PIPES {
        pipe_settle(c1)
        return neg(ENFILE)
    }
    if base == 5 {
        // px34: SOCK_SEQPACKET keeps each message whole.
        put_ppw(c1, P_MSG, 1)
        put_ppw(c2, P_MSG, 1)
    }
    put_ppw(c1, P_OWNER, fs_ids(a)) // px43 (pax#58)
    put_ppw(c2, P_OWNER, fs_ids(a))
    // px45: SO_PEERCRED, both ends: the maker's pid and effective ids at
    // `socketpair` (measured: a child that changes its ids after is told
    // the same).
    let ids = (cred.uid(a, cred.EFFECTIVE) & 0xffffffff) | (cred.gid(a, cred.EFFECTIVE) << 32)
    put_ppw(c1, P_CPID, sched.self_pid() + 1)
    put_ppw(c2, P_CPID, sched.self_pid() + 1)
    put_ppw(c1, P_CIDS, ids)
    put_ppw(c2, P_CIDS, ids)
    let fl = O_RDWR | (ty & (O_CLOEXEC | O_NONBLOCK))
    let f0 = open_new(a, 0, K_SOCK, (T_SOCK << T_SHIFT) | (c2 << 16) | c1, fl)
    if f0 >= 0x8000000000000000 {
        pipe_settle(c1)
        pipe_settle(c2)
        return f0
    }
    let f1 = open_new(a, 0, K_SOCK, (T_SOCK << T_SHIFT) | (c1 << 16) | c2, fl)
    if f1 >= 0x8000000000000000 {
        let _c = close(a, f0)
        return f1
    }
    uaccess.put(pml4, sv, f0, 4)
    uaccess.put(pml4, sv + 4, f1, 4)
    0
}

/// px24: the least room a writer of buffer `p` must find for `poll` to
/// call it writable: PIPE_BUF for a pipe (measured on Linux: a full
/// pipe is writable again when 4096 bytes have been read, not 4095), a
/// byte for a socketpair's one-frame buffer.
fn room_wanted(p: u64) -> u64 {
    if ppw(p, P_PAGES) == SOCK_PAGES { 1 } else { PIPE_BUF }
}

/// `k` bytes of buffer `p` were read: its read count moves, and when
/// that gave a writer room it did not have, so does P_OGEN.
fn took(p: u64, k: u64) {
    let cap = ppw(p, P_PAGES) * PAGE
    let before = cap - (ppw(p, P_WR) - ppw(p, P_RD))
    put_ppw(p, P_RD, ppw(p, P_RD) + k)
    if before < room_wanted(p) && before + k >= room_wanted(p) {
        put_ppw(p, P_OGEN, ppw(p, P_OGEN) + 1)
    }
}

/// The buffer descriptor `fd` reads from (a pipe's, a socket's rx; px34:
/// a connected path socket's, from its record).
fn rx_of(a: u64, fd: u64) -> u64 {
    let n = node_of(a, fd)
    let k = kind(a, fd)
    if k == K_SOCK {
        return (rf(n) >> 16) & 0xffff
    }
    if k == K_UNIX {
        return unix.buf(rf(n), 0)
    }
    rf(n)
}

fn tx_of(a: u64, fd: u64) -> u64 {
    let n = node_of(a, fd)
    let k = kind(a, fd)
    if k == K_SOCK {
        return rf(n) & 0xffff
    }
    if k == K_UNIX {
        return unix.buf(rf(n), 1)
    }
    rf(n)
}

/// The kernel address of byte `at` (a count since the pipe was made) of
/// pipe `p`'s ring, and how many bytes follow it on its frame.
fn ring_at(p: u64, at: u64) -> (u64, u64) {
    let cap = ppw(p, P_PAGES) * PAGE
    let o = at % cap
    let pg = o / PAGE
    let off = o % PAGE
    (frames.hhdm() + ppw(p, P_FRAME + pg) + off, PAGE - off)
}

/// px17: a read of a pipe or socket: what is there (up to `n`), 0 when
/// it is empty and no writer is open, WAIT (or -EAGAIN) when it is empty
/// and a writer is.
fn pipe_read(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, nonblock: bool) -> u64 {
    pipe_recv(a, pml4, fd, buf, n, if nonblock { MSG_DONTWAIT } else { 0 })
}

const MSG_PEEK: u64 = 0x2 // px34: recv(2)'s flags a socket's read reads
const MSG_TRUNC: u64 = 0x20
const MSG_DONTWAIT: u64 = 0x40

/// px34: `pipe_read` with recv(2)'s flags: MSG_DONTWAIT as O_NONBLOCK,
/// MSG_PEEK (the bytes stay), and for a message buffer MSG_TRUNC (the
/// message's whole length answered). A path socket that is not connected
/// is -EINVAL; one whose connection was reset answers -ECONNRESET once;
/// one that can read no more answers 0 once its buffer is empty.
fn pipe_recv(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, flags: u64) -> u64 {
    var shut = false
    if kind(a, fd) == K_UNIX {
        let r = rf(node_of(a, fd))
        if unix.state(r) != unix.CONN {
            return neg(EINVAL) // measured: recv on a socket not connected
        }
        let e = unix.err(r)
        if e != 0 {
            unix.set_err(r, 0)
            return neg(e)
        }
        shut = unix_rcv_shut(r)
    }
    let p = rx_of(a, fd)
    let avail = ppw(p, P_WR) - ppw(p, P_RD)
    if avail == 0 {
        if ppw(p, P_WRITERS) == 0 || shut {
            return 0
        }
        if n == 0 && ppw(p, P_MSG) == 0 {
            return 0
        }
        if flags & MSG_DONTWAIT != 0 || status(a, fd) & O_NONBLOCK != 0 {
            return neg(EAGAIN)
        }
        return WAIT
    }
    if ppw(p, P_MSG) != 0 {
        return msg_read(p, pml4, buf, n, flags)
    }
    if n == 0 {
        return 0
    }
    let k = if n < avail { n } else { avail }
    if !uaccess.writable(pml4, buf, k) {
        return neg(EFAULT)
    }
    var done: u64 = 0
    while done < k {
        let (src, room) = ring_at(p, ppw(p, P_RD) + done)
        let c = if k - done < room { k - done } else { room }
        let _ok = uaccess.copy_out(pml4, buf + done, src, c)
        done += c
    }
    if flags & MSG_PEEK == 0 {
        took(p, k)
        sched.wake_pipes()
    }
    k
}

/// px34: byte `at` (a count since the buffer was made) of buffer `p`.
fn ring_byte(p: u64, at: u64) -> u64 {
    let (src, _room) = ring_at(p, at)
    // # Safety: a byte of the buffer's frame, through the HHDM.
    let v = unsafe { (src as *u8).read_volatile() }
    v as u64
}

fn ring_set(p: u64, at: u64, b: u64) {
    let (dst, _room) = ring_at(p, at)
    // # Safety: as `ring_byte`.
    unsafe { (dst as *u8).write_volatile((b & 0xff) as u8) }
}

/// px34: the length of the message at the head of message buffer `p`.
fn msg_len(p: u64) -> u64 {
    let at = ppw(p, P_RD)
    var m: u64 = 0
    var i: u64 = 0
    while i < 8 {
        m = m | (ring_byte(p, at + i) << (i * 8))
        i += 1
    }
    m
}

/// px34: read one message of buffer `p` (one is there): at most `n`
/// bytes of it to `buf`, the rest discarded (unless MSG_PEEK); the count,
/// or the whole length under MSG_TRUNC.
fn msg_read(p: u64, pml4: u64, buf: u64, n: u64, flags: u64) -> u64 {
    let m = msg_len(p)
    let k = if n < m { n } else { m }
    if k > 0 && !uaccess.writable(pml4, buf, k) {
        return neg(EFAULT)
    }
    let start = ppw(p, P_RD) + 8
    var done: u64 = 0
    while done < k {
        let (src, room) = ring_at(p, start + done)
        let c = if k - done < room { k - done } else { room }
        let _ok = uaccess.copy_out(pml4, buf + done, src, c)
        done += c
    }
    if flags & MSG_PEEK == 0 {
        took(p, 8 + m)
        sched.wake_pipes()
    }
    if flags & MSG_TRUNC != 0 { m } else { k }
}

/// px34: the room a message of `m` bytes needs in buffer `p`, and
/// whether it can ever fit (a frame less its length word).
fn msg_fits(p: u64, m: u64) -> bool {
    m + 8 <= ppw(p, P_PAGES) * PAGE
}

/// px34: one message into buffer `p` from the `cnt` parts of the iovec
/// array at user `iov` (`cnt` 0: the `m` bytes at `buf`), `m` bytes in
/// all, the length word first. The caller checked the room and the
/// parts.
fn msg_put(p: u64, pml4: u64, buf: u64, iov: u64, cnt: u64, m: u64) {
    let at = ppw(p, P_WR)
    var i: u64 = 0
    while i < 8 {
        ring_set(p, at + i, (m >> (i * 8)) & 0xff)
        i += 1
    }
    if cnt == 0 {
        ring_in(p, pml4, at + 8, buf, m)
    } else {
        var w = at + 8
        var j: u64 = 0
        while j < cnt {
            let l = uaccess.get64(pml4, iov + j * 16 + 8)
            ring_in(p, pml4, w, uaccess.get64(pml4, iov + j * 16), l)
            w += l
            j += 1
        }
    }
    put_ppw(p, P_WR, at + 8 + m)
    sched.wake_pipes()
}

/// px34: `n` bytes from user `src` into buffer `p` from byte `at` on.
fn ring_in(p: u64, pml4: u64, at: u64, src: u64, n: u64) {
    var off: u64 = 0
    while off < n {
        let (dst, room) = ring_at(p, at + off)
        let c = if n - off < room { n - off } else { room }
        let _ok = uaccess.copy_in(pml4, dst, src + off, c)
        off += c
    }
}

/// px34: `writev` to a SOCK_SEQPACKET socket: the parts are one message
/// (measured: two parts read as one). Called by kernel/user, which has
/// checked every part and summed them (`m`).
pub fn msg_writev(a: u64, pml4: u64, fd: u64, iov: u64, cnt: u64, m: u64) -> u64 {
    let p = tx_of(a, fd)
    if ppw(p, P_READERS) == 0 {
        return EPIPE_R
    }
    if !msg_fits(p, m) {
        return neg(EMSGSIZE)
    }
    let cap = ppw(p, P_PAGES) * PAGE
    if cap - (ppw(p, P_WR) - ppw(p, P_RD)) < m + 8 {
        if status(a, fd) & O_NONBLOCK != 0 {
            return neg(EAGAIN)
        }
        return WAIT
    }
    msg_put(p, pml4, 0, iov, cnt, m)
    m
}

/// px34: whether descriptor `fd` writes a message buffer (a
/// SOCK_SEQPACKET socketpair's end).
pub fn is_msg(a: u64, fd: u64) -> bool {
    kind(a, fd) == K_SOCK && ppw(tx_of(a, fd), P_MSG) != 0
}

/// px17: `write` to a pipe or socket (kernel/user's `write`): every byte
/// of [buf, buf + n), waiting (WAIT) while it is full; -EPIPE with no
/// reader (`EPIPE_R`; what was written across waits answered instead,
/// if any); -EAGAIN for O_NONBLOCK with no room.
pub fn pipe_write(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, nonblock: bool) -> u64 {
    pipe_put(a, pml4, fd, buf, n, nonblock, true)
}

/// px24: one part of a `writev` to a pipe or socket: `pipe_write`
/// without the rule that a write of at most PIPE_BUF bytes goes in
/// whole or not at all. The rule is the whole call's, and kernel/user
/// has applied it to the sum (`pipe_room`).
pub fn pipe_write_part(a: u64, pml4: u64, fd: u64, buf: u64, n: u64) -> u64 {
    pipe_put(a, pml4, fd, buf, n, false, false)
}

/// px24: the room in the buffer descriptor `fd` writes to (a pipe's, a
/// socketpair's); all of it when no reader is left (the write answers
/// -EPIPE, not "wait").
pub fn pipe_room(a: u64, fd: u64) -> u64 {
    if kind(a, fd) == K_UNIX {
        let r = rf(node_of(a, fd))
        if unix.state(r) != unix.CONN || unix_snd_shut(r) {
            return PIPE_PAGES * PAGE // the write answers why not, not "wait"
        }
    }
    let p = tx_of(a, fd)
    let cap = ppw(p, P_PAGES) * PAGE
    if ppw(p, P_READERS) == 0 {
        return cap
    }
    cap - (ppw(p, P_WR) - ppw(p, P_RD))
}

fn pipe_put(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, nonblock: bool, atomic: bool) -> u64 {
    if kind(a, fd) == K_UNIX {
        // px34: a path socket writes only while connected and not shut.
        let r = rf(node_of(a, fd))
        if unix.state(r) != unix.CONN {
            return neg(ENOTCONN)
        }
        if unix_snd_shut(r) {
            sched.set_self_done(0)
            return EPIPE_R
        }
    }
    let p = tx_of(a, fd)
    if ppw(p, P_MSG) != 0 {
        // px34: a message goes in whole, or waits.
        if ppw(p, P_READERS) == 0 {
            return EPIPE_R
        }
        if !msg_fits(p, n) {
            return neg(EMSGSIZE)
        }
        if n > 0 && !uaccess.readable(pml4, buf, n) {
            return neg(EFAULT)
        }
        let cap = ppw(p, P_PAGES) * PAGE
        if cap - (ppw(p, P_WR) - ppw(p, P_RD)) < n + 8 {
            if nonblock || status(a, fd) & O_NONBLOCK != 0 {
                return neg(EAGAIN)
            }
            return WAIT
        }
        msg_put(p, pml4, buf, 0, 0, n)
        return n
    }
    let done = sched.self_done()
    if ppw(p, P_READERS) == 0 {
        sched.set_self_done(0)
        if done > 0 {
            return done
        }
        return EPIPE_R
    }
    if n == 0 {
        return 0
    }
    if done == 0 && !uaccess.readable(pml4, buf, n) {
        return neg(EFAULT)
    }
    let nb = nonblock || status(a, fd) & O_NONBLOCK != 0
    let cap = ppw(p, P_PAGES) * PAGE
    let space = cap - (ppw(p, P_WR) - ppw(p, P_RD))
    let rest = n - done
    if (atomic && n <= PIPE_BUF && space < rest) || space == 0 {
        if nb {
            sched.set_self_done(0)
            return if done > 0 { done } else { neg(EAGAIN) }
        }
        sched.set_self_done(done)
        return WAIT
    }
    let k = if rest < space { rest } else { space }
    var c: u64 = 0
    while c < k {
        let (dst, room) = ring_at(p, ppw(p, P_WR) + c)
        let m = if k - c < room { k - c } else { room }
        let _ok = uaccess.copy_in(pml4, dst, buf + done + c, m)
        c += m
    }
    put_ppw(p, P_WR, ppw(p, P_WR) + k)
    sched.wake_pipes()
    if done + k == n || nb {
        sched.set_self_done(0)
        return done + k
    }
    sched.set_self_done(done + k)
    WAIT
}

/// px26: `sendfile(out, in, offset, count)`: up to `count` bytes of
/// the file `in` (a regular file: anything else is -EINVAL,
/// `sendfile(2)`), from its own offset or the one at `offset` (which
/// is then moved instead), written to `out`: the console, `/dev/null`,
/// a pipe, a socketpair, or (px27) another file at its offset, which
/// moves (-EINVAL when that file was opened with O_APPEND: measured,
/// `cat f >> g`). boreutils' `cat` copies a file to its output this
/// way (after `copy_file_range`). The count written, which may be less
/// than asked: a pipe takes what it has room for, and a full one waits
/// (WAIT) or answers -EAGAIN (O_NONBLOCK); -EPIPE with no reader
/// (`EPIPE_R`; kernel/user raises SIGPIPE). One call sends at most
/// 0x7ffff000 bytes, as Linux.
pub fn sendfile(a: u64, pml4: u64, out: u64, inf: u64, offp: u64, count: u64) -> u64 {
    if kind(a, inf) == K_CLOSED || access(a, inf) == O_WRONLY {
        return neg(EBADF)
    }
    let t = write_target(a, out)
    if t == 2 {
        return neg(EBADF)
    }
    if t == 8 {
        return neg(ENOSPC) // px45: /dev/full
    }
    if kind(a, inf) != K_FILE {
        return neg(EINVAL)
    }
    if t == 4 && status(a, out) & O_APPEND != 0 {
        return neg(EINVAL)
    }
    var off = pos(a, inf)
    if offp != 0 {
        if !uaccess.readable(pml4, offp, 8) || !uaccess.writable(pml4, offp, 8) {
            return neg(EFAULT)
        }
        off = uaccess.get64(pml4, offp)
    }
    let i = rf(node_of(a, inf))
    let size = tree.bytes(i)
    if off >= size || count == 0 {
        return 0
    }
    var k = if count < size - off { count } else { size - off }
    if k > 0x7ffff000 {
        k = 0x7ffff000
    }
    if t == 1 {
        // px49 (pax#76): the background rule, as `write` asks it (a
        // background group's write to its terminal under TOSTOP is
        // SIGTTOU's: measured for sendfile and splice too).
        let j = console.job(console.J_WRITE)
        if j != 0 {
            return j
        }
    }
    var done: u64 = 0
    if t == 4 {
        let q = pos(a, out)
        let r = file_put(rf(node_of(a, out)), q, i, off, k)
        if tree.failed(r) {
            return r
        }
        set_pos(a, out, q + r)
        wrote(a, rf(node_of(a, out))) // px44
        done = r
    } else {
        if t == 3 {
            let p = tx_of(a, out)
            if ppw(p, P_READERS) == 0 {
                return EPIPE_R
            }
            let space = ppw(p, P_PAGES) * PAGE - (ppw(p, P_WR) - ppw(p, P_RD))
            if space == 0 {
                if status(a, out) & O_NONBLOCK != 0 {
                    return neg(EAGAIN)
                }
                return WAIT
            }
            if k > space {
                k = space
            }
        }
        while done < k {
            let (src, c) = tree.span(i, off + done, k - done)
            if t == 1 {
                console.put_kernel(src, c)
            } else if t == 3 {
                ring_put(tx_of(a, out), src, c)
            }
            done += c
        }
        if t == 3 {
            sched.wake_pipes()
        }
    }
    tree.touch_read(i)
    if offp != 0 {
        uaccess.put(pml4, offp, off + done, 8)
    } else {
        set_pos(a, inf, off + done)
    }
    done
}

/// px27: `k` bytes of file `i` from offset `off` written into file `j`
/// at offset `q`: the count, less than `k` when the tree's frames ran
/// out part-way, or -errno when none could be written.
fn file_put(j: u64, q: u64, i: u64, off: u64, k: u64) -> u64 {
    var done: u64 = 0
    var e: u64 = 0
    while done < k && e == 0 {
        let (src, c) = tree.span(i, off + done, k - done)
        let r = tree.write(0, j, q + done, src, c)
        if tree.failed(r) {
            e = r
        } else {
            done += r
            if r < c {
                e = 1
            }
        }
    }
    if done == 0 && e > 1 {
        return e
    }
    done
}

/// The frame-by-frame copy of `k` kernel bytes at `src` into pipe `p`'s
/// ring at its write end (the caller has found room for them).
fn ring_put(p: u64, src: u64, k: u64) {
    var c: u64 = 0
    while c < k {
        let (dst, room) = ring_at(p, ppw(p, P_WR) + c)
        let m = if k - c < room { k - c } else { room }
        var j: u64 = 0
        while j < m {
            // # Safety: [dst, dst + m) is inside one of the pipe's frames
            // (ring_at); [src + c, src + c + m) is the caller's kernel
            // memory.
            unsafe { ((dst + j) as *u8).write_volatile(((src + c + j) as *u8).read_volatile()) }
            j += 1
        }
        c += m
    }
    put_ppw(p, P_WR, ppw(p, P_WR) + k)
}

/// px26: `splice(in, off_in, out, off_out, len, flags)`: bytes moved
/// between two descriptors of which at least one is a pipe
/// (`splice(2)`; -EINVAL when neither is, or when an offset is given
/// for a pipe). boreutils' `cat` asks it when its input is no regular
/// file (after `copy_file_range` and `sendfile` have said so). From a
/// pipe: what it holds, up to `len`, to the console, `/dev/null` or
/// another pipe; 0 at end of file; an empty pipe with a writer waits
/// (WAIT), or answers -EAGAIN under SPLICE_F_NONBLOCK (2) or
/// O_NONBLOCK. Into a pipe from a file of the initramfs: `sendfile`'s
/// way. The count moved; -EPIPE (`EPIPE_R`) into a pipe with no reader.
pub fn splice(a: u64, pml4: u64, inf: u64, offin: u64, out: u64, offout: u64, len: u64, flags: u64) -> u64 {
    if kind(a, inf) == K_CLOSED || access(a, inf) == O_WRONLY {
        return neg(EBADF)
    }
    let t = write_target(a, out)
    if t == 2 {
        return neg(EBADF)
    }
    let ki = kind(a, inf)
    let from_pipe = ki == K_PIPE || ki == K_SOCK
    if !from_pipe && t != 3 {
        return neg(EINVAL)
    }
    if (from_pipe && offin != 0) || (t == 3 && offout != 0) || offout != 0 {
        return neg(ESPIPE)
    }
    if !from_pipe {
        return sendfile(a, pml4, out, inf, offin, len)
    }
    let p = rx_of(a, inf)
    let avail = ppw(p, P_WR) - ppw(p, P_RD)
    if avail == 0 {
        if ppw(p, P_WRITERS) == 0 || len == 0 {
            return 0
        }
        if flags & 2 != 0 || status(a, inf) & O_NONBLOCK != 0 {
            return neg(EAGAIN)
        }
        return WAIT
    }
    var k = if len < avail { len } else { avail }
    if t == 4 && status(a, out) & O_APPEND != 0 {
        return neg(EINVAL) // px27: measured (`cat >> f <<E`)
    }
    if t == 3 {
        let q = tx_of(a, out)
        if ppw(q, P_READERS) == 0 {
            return EPIPE_R
        }
        let space = ppw(q, P_PAGES) * PAGE - (ppw(q, P_WR) - ppw(q, P_RD))
        if space == 0 {
            if flags & 2 != 0 || status(a, out) & O_NONBLOCK != 0 {
                return neg(EAGAIN)
            }
            return WAIT
        }
        if k > space {
            k = space
        }
    }
    if t == 1 {
        let j = console.job(console.J_WRITE) // px49 (pax#76), as sendfile
        if j != 0 {
            return j
        }
    }
    var done: u64 = 0
    var full = false
    while done < k && !full {
        let (src, room) = ring_at(p, ppw(p, P_RD) + done)
        var c = if k - done < room { k - done } else { room }
        if t == 1 {
            console.put_kernel(src, c)
        } else if t == 3 {
            ring_put(tx_of(a, out), src, c)
        } else if t == 4 {
            // px27: into a file, at its offset (pelt's `cat > f <<E`).
            let q = pos(a, out)
            let r = tree.write(0, rf(node_of(a, out)), q, src, c)
            if tree.failed(r) {
                if done == 0 {
                    return r
                }
                c = 0
                full = true
            } else {
                set_pos(a, out, q + r)
                wrote(a, rf(node_of(a, out))) // px44
                full = r < c
                c = r
            }
        }
        done += c
    }
    took(p, done)
    sched.wake_pipes()
    done
}

/// px26, px27: `copy_file_range(in, off_in, out, off_out, len, flags)`:
/// up to `len` bytes copied from one regular file to another, each at
/// its own offset (which moves) or at the one its pointer names (which
/// is moved instead): the count, 0 at the end of `in`. As measured on
/// Linux (`notes/px27/straces/`): -EBADF for a descriptor that is not
/// open the right way, and for an `out` opened with O_APPEND; -EISDIR
/// for a directory; -EINVAL when either is no regular file (a pipe, the
/// console: boreutils' `cat` and `cp` ask this first and go on to
/// `sendfile`), for a flag, and for one file onto itself where the two
/// ranges overlap. Never -EXDEV: one file system holds every regular
/// file there is. One call copies at most 0x7ffff000 bytes.
pub fn copy_file_range(a: u64, pml4: u64, inf: u64, offin: u64, out: u64, offout: u64, len: u64, flags: u64) -> u64 {
    if kind(a, inf) == K_CLOSED || access(a, inf) == O_WRONLY || write_target(a, out) == 2 {
        return neg(EBADF)
    }
    if kind(a, inf) == K_DIR {
        return neg(EISDIR)
    }
    if kind(a, inf) != K_FILE || kind(a, out) != K_FILE {
        return neg(EINVAL)
    }
    if status(a, out) & O_APPEND != 0 {
        return neg(EBADF)
    }
    if flags != 0 {
        return neg(EINVAL)
    }
    var off = pos(a, inf)
    var q = pos(a, out)
    if offin != 0 {
        if !uaccess.readable(pml4, offin, 8) || !uaccess.writable(pml4, offin, 8) {
            return neg(EFAULT)
        }
        off = uaccess.get64(pml4, offin)
    }
    if offout != 0 {
        if !uaccess.readable(pml4, offout, 8) || !uaccess.writable(pml4, offout, 8) {
            return neg(EFAULT)
        }
        q = uaccess.get64(pml4, offout)
    }
    if off >= 0x8000000000000000 || q >= 0x8000000000000000 {
        return neg(EINVAL)
    }
    let i = rf(node_of(a, inf))
    let j = rf(node_of(a, out))
    let size = tree.bytes(i)
    if off >= size || len == 0 {
        return 0
    }
    var k = if len < size - off { len } else { size - off }
    if k > 0x7ffff000 {
        k = 0x7ffff000
    }
    if i == j && off < q + k && q < off + k {
        return neg(EINVAL)
    }
    let r = file_put(j, q, i, off, k)
    if tree.failed(r) {
        return r
    }
    wrote(a, j) // px44
    tree.touch_read(i)
    if offin != 0 {
        uaccess.put(pml4, offin, off + r, 8)
    } else {
        set_pos(a, inf, off + r)
    }
    if offout != 0 {
        uaccess.put(pml4, offout, q + r, 8)
    } else {
        set_pos(a, out, q + r)
    }
    r
}

/// px17: `recvfrom(fd, buf, n, flags, addr, addrlen)` on a socketpair's
/// end: a read (MSG_DONTWAIT, 0x40, as O_NONBLOCK); no address is
/// reported (a connected pair's peer is unnamed: *addrlen 0).
pub fn recvfrom(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, flags: u64, addr: u64, alen: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k != K_SOCK && k != K_UNIX {
        return neg(ENOTSOCK)
    }
    if addr != 0 && alen != 0 {
        if !uaccess.writable(pml4, alen, 4) {
            return neg(EFAULT)
        }
        uaccess.put(pml4, alen, 0, 4)
    }
    // px34: MSG_PEEK, MSG_TRUNC and MSG_DONTWAIT read; a path socket's too.
    pipe_recv(a, pml4, fd, buf, n, flags & (MSG_PEEK | MSG_TRUNC | MSG_DONTWAIT))
}

/// px17: `sendto(fd, buf, n, flags, addr, addrlen)` on a socketpair's
/// end: a write; an address on a connected socket is -EISCONN.
/// MSG_NOSIGNAL (0x4000) is kernel/user's to read.
pub fn sendto(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, flags: u64, addr: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k != K_SOCK && k != K_UNIX {
        return neg(ENOTSOCK)
    }
    if addr != 0 {
        // px34: a path socket not connected is no datagram socket (measured).
        if k == K_UNIX && unix.state(rf(node_of(a, fd))) != unix.CONN {
            return neg(EOPNOTSUPP)
        }
        return neg(EISCONN)
    }
    pipe_write(a, pml4, fd, buf, n, flags & 0x40 != 0)
}

// --- AF_INET sockets (px22; the calls are kernel/socket's) --------------------

/// `sock_kind`'s answers: the descriptor is closed.
pub const NOT_OPEN: u64 = 0
/// It is open and no socket.
pub const NOT_SOCKET: u64 = 1
/// It is an end of an AF_UNIX socketpair (px17).
pub const UNIX: u64 = 2
/// It is an AF_INET datagram socket.
pub const INET: u64 = 3
/// It is an AF_INET stream socket (px23).
pub const TCP: u64 = 4
/// It is an AF_UNIX path socket (px34).
pub const PATH: u64 = 5

/// What descriptor `fd` is, to a socket call.
pub fn sock_kind(a: u64, fd: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return NOT_OPEN
    }
    if k == K_INET {
        return INET
    }
    if k == K_TCP {
        return TCP
    }
    if k == K_SOCK {
        return UNIX
    }
    if k == K_UNIX {
        return PATH
    }
    NOT_SOCKET
}

/// A new descriptor, the lowest free, on a new open file naming
/// kernel/udp's socket `s`, with `flags` (O_RDWR, O_CLOEXEC,
/// O_NONBLOCK): the number, or -EMFILE / -ENFILE (the socket is then
/// the caller's to free).
pub fn inet_open(a: u64, s: u64, flags: u64) -> u64 {
    owned(a, open_new(a, 0, K_INET, (T_INET << T_SHIFT) | s, flags))
}

/// px49 (pax#58): the open file new descriptor `fd` (or an -errno, passed
/// on) names keeps its maker's file-system ids, a socket's owner to
/// `fstat` (measured on Linux 7.2.8: an AF_INET datagram socket, a TCP
/// socket and the end `accept` makes are their maker's, the acceptor's
/// for the last; an eventfd and an epoll object 0:0, an anonymous inode
/// being the kernel's: PAX's 0 already).
fn owned(a: u64, fd: u64) -> u64 {
    if fd < FDS {
        let o = of_of(a, fd)
        if o != 0 {
            put_ofw(o - 1, O_OWNER, fs_ids(a))
        }
    }
    fd
}

/// px49: the owner word of the open file that names socket node `n` (an
/// AF_INET or TCP socket has one open file: a `dup` shares it).
fn sock_owner(n: u64) -> u64 {
    var i: u64 = 0
    while i < OFILES {
        if ofw(i, O_REFS) != 0 && ofw(i, O_NODE) == n {
            return ofw(i, O_OWNER)
        }
        i += 1
    }
    0
}

/// kernel/udp's socket, or kernel/tcp's block, behind descriptor `fd`
/// (an AF_INET socket).
pub fn inet_sock(a: u64, fd: u64) -> u64 {
    rf(node_of(a, fd))
}

/// px23: a new descriptor, the lowest free, on a new open file naming
/// kernel/tcp's block `c`, with `flags` (O_RDWR, O_CLOEXEC,
/// O_NONBLOCK): the number, or -EMFILE / -ENFILE (the block is then
/// the caller's to close).
pub fn tcp_open(a: u64, c: u64, flags: u64) -> u64 {
    owned(a, open_new(a, 0, K_TCP, (T_TCP << T_SHIFT) | c, flags))
}

/// px23: set or clear O_NONBLOCK on descriptor `fd`'s open file
/// (`ioctl(FIONBIO)`).
pub fn set_nonblocking(a: u64, fd: u64, on: bool) {
    let o = of_of(a, fd)
    if o != 0 {
        let fl = ofw(o - 1, O_FLAGS) & !O_NONBLOCK
        put_ofw(o - 1, O_FLAGS, if on { fl | O_NONBLOCK } else { fl })
    }
}

/// Whether descriptor `fd`'s open file has O_NONBLOCK set.
pub fn nonblocking(a: u64, fd: u64) -> bool {
    status(a, fd) & O_NONBLOCK != 0
}

/// Open files in use, of every process together (the books).
pub fn open_files() -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < OFILES {
        if ofw(i, O_REFS) != 0 {
            n += 1
        }
        i += 1
    }
    n
}

/// Pipe and socketpair buffers in use (the books).
pub fn pipes_held() -> u64 {
    var n: u64 = 0
    var p: u64 = 0
    while p < PIPES {
        if ppw(p, P_PAGES) != 0 {
            n += 1
        }
        p += 1
    }
    n
}

// --- eventfd, epoll and readiness (px24; the calls are kernel/ready's) --------

/// px24: a new descriptor, the lowest free, on a new open file naming
/// kernel/event's counter `v`, with `flags` (O_RDWR, O_CLOEXEC,
/// O_NONBLOCK): the number, or -EMFILE / -ENFILE (the counter is then
/// the caller's to free).
pub fn event_open(a: u64, v: u64, flags: u64) -> u64 {
    open_new(a, 0, K_EVENT, (T_EVENT << T_SHIFT) | v, flags)
}

/// px24: the same for kernel/event's epoll object `e`.
pub fn epoll_open(a: u64, e: u64, flags: u64) -> u64 {
    open_new(a, 0, K_EPOLL, (T_EPOLL << T_SHIFT) | e, flags)
}

/// px24: `read` of an eventfd (`eventfd(2)`): the counter's eight bytes,
/// and the counter is zero after (px52, pax#82: a semaphore's 1, and the
/// counter one less). A buffer under eight bytes is -EINVAL; a counter
/// that is zero waits (WAIT) or, under O_NONBLOCK, answers -EAGAIN.
fn event_read(a: u64, pml4: u64, fd: u64, buf: u64, n: u64) -> u64 {
    if n < 8 {
        return neg(EINVAL)
    }
    let v = rf(node_of(a, fd))
    if event.ev_value(v) == 0 {
        if status(a, fd) & O_NONBLOCK != 0 {
            return neg(EAGAIN)
        }
        return WAIT
    }
    if !uaccess.writable(pml4, buf, 8) {
        return neg(EFAULT)
    }
    uaccess.put(pml4, buf, event.ev_take(v), 8)
    sched.wake_pipes()
    8
}

/// px24: `write` to an eventfd (kernel/user's `write`): eight bytes
/// added to the counter. Fewer than eight bytes, or the value
/// 0xffffffffffffffff, is -EINVAL; a sum past 0xfffffffffffffffe waits
/// (WAIT) or, under O_NONBLOCK, answers -EAGAIN.
pub fn event_write(a: u64, pml4: u64, fd: u64, buf: u64, n: u64) -> u64 {
    if n < 8 {
        return neg(EINVAL)
    }
    if !uaccess.readable(pml4, buf, 8) {
        return neg(EFAULT)
    }
    let x = uaccess.get64(pml4, buf)
    if x == 0xffffffffffffffff {
        return neg(EINVAL)
    }
    if !event.ev_add(rf(node_of(a, fd)), x) {
        if status(a, fd) & O_NONBLOCK != 0 {
            return neg(EAGAIN)
        }
        return WAIT
    }
    sched.wake_pipes()
    8
}

// `poll`'s bits (uapi asm-generic/poll.h); kernel/tcp's are the same
// numbers.
const POLLIN: u64 = 0x1
const POLLOUT: u64 = 0x4
const POLLERR: u64 = 0x8
const POLLHUP: u64 = 0x10
const POLLRDHUP: u64 = 0x2000
const GONE: u64 = 0x4000000000000000 // in a count: the other end has closed

/// What `poll` says of a pipe's end or a socketpair's end, as Linux
/// answered user/net/pollprobe.c, and its two counts (below).
fn pipe_poll(k: u64, n: u64, acc: u64) -> (u64, u64, u64) {
    var m: u64 = 0
    var gin: u64 = 0
    var gout: u64 = 0
    if k == K_SOCK {
        let rx = (rf(n) >> 16) & 0xffff
        let tx = rf(n) & 0xffff
        let peer_gone = ppw(rx, P_WRITERS) == 0
        if ppw(rx, P_WR) > ppw(rx, P_RD) {
            m = POLLIN
        }
        if peer_gone {
            m = m | POLLIN | POLLOUT | POLLRDHUP | POLLHUP
        } else if ppw(tx, P_PAGES) * PAGE > ppw(tx, P_WR) - ppw(tx, P_RD) {
            m = m | POLLOUT
        }
        gin = ppw(rx, P_WR) + (if peer_gone { GONE } else { 0 })
        gout = ppw(tx, P_OGEN) + (if peer_gone { GONE } else { 0 })
        return (m, gin, gout)
    }
    let p = rf(n)
    if acc != O_WRONLY {
        let no_writer = ppw(p, P_WRITERS) == 0
        if ppw(p, P_WR) > ppw(p, P_RD) {
            m = POLLIN
        }
        if no_writer {
            m = m | POLLHUP
        }
        gin = ppw(p, P_WR) + (if no_writer { GONE } else { 0 })
    }
    if acc != O_RDONLY {
        let no_reader = ppw(p, P_READERS) == 0
        if no_reader {
            m = m | POLLOUT | POLLERR
        } else if ppw(p, P_PAGES) * PAGE - (ppw(p, P_WR) - ppw(p, P_RD)) >= room_wanted(p) {
            m = m | POLLOUT
        }
        gout = ppw(p, P_OGEN) + (if no_reader { GONE } else { 0 })
    }
    (m, gin, gout)
}

/// What `poll` says now of the thing of kind `k` at node `n`, opened
/// with access `acc`: its bits — POLLIN, POLLOUT, POLLERR, POLLHUP,
/// POLLRDHUP, whether or not the caller asks for each — and two counts
/// an edge-triggered registration compares: the first moves whenever
/// something new came to read, the second whenever room to write came
/// back. A file, a directory and `/dev/null` can always be read and
/// written; the console can be read when a `read` would answer.
fn node_poll(k: u64, n: u64, acc: u64) -> (u64, u64, u64) {
    if k == K_PIPE || k == K_SOCK {
        return pipe_poll(k, n, acc)
    }
    if k == K_UNIX {
        return unix_poll(rf(n)) // px34
    }
    if k == K_TCP {
        return tcp.poll(rf(n))
    }
    if k == K_INET {
        let (ready, got) = udp.poll(rf(n))
        return (if ready { POLLIN | POLLOUT } else { POLLOUT }, got, 0)
    }
    if k == K_EVENT {
        let v = rf(n)
        let x = event.ev_value(v)
        let (adds, takes) = event.ev_counts(v)
        var m: u64 = 0
        if x > 0 {
            m = POLLIN
        }
        if x < event.EV_MAX {
            m = m | POLLOUT
        }
        return (m, adds, takes)
    }
    if k == K_CONSOLE {
        return (if console.readable() { POLLIN | POLLOUT } else { POLLOUT }, 0, 0)
    }
    if k == K_DSP {
        // px30: room to write while a period is free; the room count
        // moves as the device hands periods back (its interrupt wakes
        // every waiter, kernel/interrupts).
        return (if sound.writable() { POLLOUT } else { 0 }, 0, sound.count(sound.C_RETURNED))
    }
    (POLLIN | POLLOUT, 0, 0)
}

/// px24: `poll`'s answer for descriptor `fd` (open): `node_poll`'s.
pub fn poll(a: u64, fd: u64) -> (u64, u64, u64) {
    node_poll(kind(a, fd), node_of(a, fd), access(a, fd))
}

/// px24: the same for open file `o` (index + 1, in use): what an epoll
/// registration watches.
pub fn poll_of(o: u64) -> (u64, u64, u64) {
    node_poll(ofw(o - 1, O_KIND), ofw(o - 1, O_NODE), ofw(o - 1, O_FLAGS) & O_ACCMODE)
}

/// `watch`'s answers: the descriptor is closed.
pub const W_CLOSED: u64 = 0
/// It is an epoll object (the value: kernel/event's number).
pub const W_EPOLL: u64 = 1
/// It is open and cannot be watched by an epoll object: a regular file
/// or a directory (-EPERM on Linux too).
pub const W_PLAIN: u64 = 2
/// It can be watched (the value: its open file, index + 1).
pub const W_OPEN: u64 = 3
/// It is the console or `/dev/null`, which keep no open file here: an
/// epoll object cannot hold it (kernel/ready refuses by name).
pub const W_NO_FILE: u64 = 4

/// px24: what descriptor `fd` is to `epoll_ctl` and `epoll_wait`:
/// `(W_*, value)`.
pub fn watch(a: u64, fd: u64) -> (u64, u64) {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return (W_CLOSED, 0)
    }
    if k == K_EPOLL {
        return (W_EPOLL, rf(node_of(a, fd)))
    }
    let o = of_of(a, fd)
    if k == K_FILE || k == K_DIR {
        return (W_PLAIN, 0)
    }
    if o == 0 {
        return (W_NO_FILE, 0)
    }
    (W_OPEN, o)
}

// --- AF_UNIX path sockets (px34; kernel/socket's calls reach here) -----------------

const AF_UNIX: u64 = 1
const SOCK_STREAM: u64 = 1
const UN_LEN: u64 = 110 // sizeof(struct sockaddr_un): the family and 108 bytes
const SOMAXCONN: u64 = 4096 // listen(2): a backlog is cut to this
const POLLIN_X: u64 = 0x1
const POLLOUT_X: u64 = 0x4
const POLLERR_X: u64 = 0x8
const POLLHUP_X: u64 = 0x10
const POLLRDHUP_X: u64 = 0x2000

/// Whether path socket `r` (connected) can read no more once its buffer
/// is empty: it shut its reading half, its peer shut its writing half,
/// or its peer is gone.
fn unix_rcv_shut(r: u64) -> bool {
    if unix.shut(r) & unix.RD != 0 {
        return true
    }
    let p = unix.peer(r)
    if p != unix.SOCKS && unix.shut(p) & unix.WR != 0 {
        return true
    }
    let rx = unix.buf(r, 0)
    rx == unix.NONE_BUF || ppw(rx, P_WRITERS) == 0
}

/// Whether path socket `r` (connected) can write no more: it shut its
/// writing half, its peer shut its reading half, or its peer is gone.
fn unix_snd_shut(r: u64) -> bool {
    if unix.shut(r) & unix.WR != 0 {
        return true
    }
    let p = unix.peer(r)
    if p != unix.SOCKS && unix.shut(p) & unix.RD != 0 {
        return true
    }
    let tx = unix.buf(r, 1)
    tx == unix.NONE_BUF || ppw(tx, P_READERS) == 0
}

/// What `poll` says of path socket `r`, as Linux answered unixprobe: a
/// socket neither listening nor connected POLLOUT|POLLHUP; a listener
/// POLLIN while a connection waits (its edge count the connections ever
/// queued); a connected one POLLIN with bytes to read or nothing more to
/// come, POLLRDHUP when nothing more will come, POLLHUP when it can
/// neither read nor write any more, POLLERR while a reset waits to be
/// read, POLLOUT while it can write or a write would answer at once.
fn unix_poll(r: u64) -> (u64, u64, u64) {
    let st = unix.state(r)
    if st == unix.LISTEN {
        return (if unix.qlen(r) > 0 { POLLIN_X } else { 0 }, unix.ever(r), 0)
    }
    if st != unix.CONN {
        return (POLLOUT_X | POLLHUP_X, 0, 0)
    }
    let rx = unix.buf(r, 0)
    let tx = unix.buf(r, 1)
    let rs = unix_rcv_shut(r)
    let ss = unix_snd_shut(r)
    var m: u64 = 0
    if ppw(rx, P_WR) > ppw(rx, P_RD) || rs {
        m = POLLIN_X
    }
    if rs {
        m = m | POLLRDHUP_X
    }
    if rs && ss {
        m = m | POLLHUP_X
    }
    if unix.err(r) != 0 {
        m = m | POLLERR_X
    }
    if ss || ppw(tx, P_PAGES) * PAGE > ppw(tx, P_WR) - ppw(tx, P_RD) {
        m = m | POLLOUT_X
    }
    let gin = ppw(rx, P_WR) + (if rs { GONE } else { 0 })
    let gout = ppw(tx, P_OGEN) + (if ss { GONE } else { 0 })
    (m, gin, gout)
}

/// One end `c` of a connection (CONN or QUEUED) closes: its peer is
/// told — reset (-ECONNRESET at its next read) when `reset` (its
/// listener closed before the end was accepted) or when bytes sent to
/// `c` were never read (measured both) — and its buffers' ends drop.
fn unix_end(c: u64, reset: bool) {
    let rx = unix.buf(c, 0)
    let tx = unix.buf(c, 1)
    let p = unix.peer(c)
    if p != unix.SOCKS {
        if reset || (rx != unix.NONE_BUF && ppw(rx, P_WR) > ppw(rx, P_RD)) {
            unix.set_err(p, ECONNRESET)
        }
        unix.set_peer(p, unix.SOCKS)
    }
    if rx != unix.NONE_BUF {
        put_ppw(rx, P_READERS, ppw(rx, P_READERS) - 1)
        pipe_settle(rx)
    }
    if tx != unix.NONE_BUF {
        put_ppw(tx, P_WRITERS, ppw(tx, P_WRITERS) - 1)
        pipe_settle(tx)
    }
    unix.set_bufs(c, unix.NONE_BUF, unix.NONE_BUF)
    unix.set_peer(c, unix.SOCKS)
}

/// Path socket `r`'s last descriptor closed: a listener's queued ends
/// go with it (their clients reset), a connection's end closes, its
/// name stays in the tree leading nowhere (`unix(7)`: until unlinked).
fn unix_close(r: u64) {
    let st = unix.state(r)
    if st == unix.LISTEN {
        var c = unix.dequeue(r)
        while c != unix.SOCKS {
            unix_end(c, true)
            unix.free(c)
            c = unix.dequeue(r)
        }
    }
    if st == unix.CONN {
        unix_end(r, false)
    }
    let i = unix.ino(r)
    if i != unix.NONE_INO {
        tree.sock_gone(i)
        unix.set_ino(r, unix.NONE_INO)
        tree.release(i)
    }
    unix.free(r)
    sched.wake_pipes()
}

/// `socket(AF_UNIX, ty, proto)`: a stream socket (SOCK_CLOEXEC and
/// SOCK_NONBLOCK taken); protocol 0 or 1 (PF_UNIX, measured), another
/// -EPROTONOSUPPORT; a type there is none of -EINVAL; SOCK_DGRAM,
/// SOCK_RAW, SOCK_SEQPACKET (Linux has them; no strace asks one on a
/// path) refused by name, -ESOCKTNOSUPPORT.
pub fn unix_socket(a: u64, ty: u64, proto: u64) -> u64 {
    let base = ty & 0xf
    if ty & !(0xf | O_CLOEXEC | O_NONBLOCK) != 0 || base == 0 || base == 7 || base == 8 || base == 9 || base > 10 {
        return neg(EINVAL)
    }
    if proto != 0 && proto != 1 {
        return neg(EPROTONOSUPPORT)
    }
    if base != SOCK_STREAM {
        put(a, A_REFUSAL, unix.R_TYPE)
        unix.refuse()
        return neg(ESOCKTNOSUPPORT)
    }
    let r = unix.new(SOCK_STREAM)
    if r == unix.SOCKS {
        return neg(ENFILE)
    }
    unix.owned(r, cred.uid(a, cred.FS), cred.gid(a, cred.FS)) // px43 (pax#58)
    let fd = open_new(a, 0, K_UNIX, (T_UNIX << T_SHIFT) | r, O_RDWR | (ty & (O_CLOEXEC | O_NONBLOCK)))
    if fd >= 0x8000000000000000 {
        unix.free(r)
    }
    fd
}

/// The `struct sockaddr_un` of `len` bytes at user `addr`: its path (the
/// bytes of `sun_path` up to the first NUL or the length's end) copied
/// into pax_kbuf[0..] with a NUL after it: (0, its length), or
/// (-errno, 0): a length under 2 or over 110 -EINVAL, -EFAULT, a family
/// that is not AF_UNIX -EINVAL (all measured); autobind (a length of
/// 2) and an abstract name refused by name, -EINVAL.
fn un_path(a: u64, pml4: u64, addr: u64, len: u64) -> (u64, u64) {
    if len < 2 || len > UN_LEN {
        return (neg(EINVAL), 0)
    }
    if !uaccess.readable(pml4, addr, len) {
        return (neg(EFAULT), 0)
    }
    if uaccess.get(pml4, addr, 2) != AF_UNIX {
        return (neg(EINVAL), 0)
    }
    if len == 2 || uaccess.get(pml4, addr + 2, 1) == 0 {
        put(a, A_REFUSAL, unix.R_ABSTRACT)
        unix.refuse()
        return (neg(EINVAL), 0)
    }
    var l: u64 = 0
    while l < len - 2 && uaccess.get(pml4, addr + 2 + l, 1) != 0 {
        put_kb(l, uaccess.get(pml4, addr + 2 + l, 1))
        l += 1
    }
    put_kb(l, 0)
    (0, l)
}

/// `bind(fd, addr, len)` on a path socket: the name made in the tree,
/// mode S_IFSOCK and `0777 & ~umask` (measured: 0755 under 022). A name
/// that exists, whatever it is, -EADDRINUSE; a missing directory
/// -ENOENT, a file on the way -ENOTDIR; a socket already bound, or
/// listening or connected, -EINVAL (measured, after the name's check);
/// in /dev refused by name, -EROFS, as px27 refuses every name there.
pub fn unix_bind(a: u64, pml4: u64, fd: u64, addr: u64, len: u64) -> u64 {
    let r = rf(node_of(a, fd))
    let (e, l) = un_path(a, pml4, addr, len)
    if e != 0 {
        return e
    }
    let (n, par, ns, nl, trail) = walk_k(a, AT_FDCWD, l, false, F_NO)
    if !is_err(n) {
        return neg(EADDRINUSE)
    }
    if rf(n) != ENOENT || is_err(par) {
        return neg(rf(n))
    }
    if !may_make(a, par) {
        return neg(EACCES) // px44: write and search of the directory (measured: before a bound socket's -EINVAL)
    }
    if unix.ino(r) != unix.NONE_INO || unix.state(r) != unix.FRESH {
        return neg(EINVAL)
    }
    if trail {
        return neg(EISDIR)
    }
    if ty(par) == T_SYN {
        return neg(ENOENT)
    }
    if ty(par) != T_INO {
        refuse(a, R_DEVRO)
        return neg(EROFS)
    }
    let (su, sg, _dg) = stamp(a, rf(par))
    let i = tree.mksock(rf(par), raw() + ns, nl, 0x1ff & !mask_of(a), r, su, sg)
    if tree.failed(i) {
        return i
    }
    tree.hold(i)
    unix.set_ino(r, i)
    unix.set_name(r, raw(), l)
    0
}

/// `listen(fd, backlog)` on a path socket: it takes connections from
/// now on, `backlog + 1` waiting at most (measured), a negative backlog
/// and one past SOMAXCONN as SOMAXCONN; again on a listener changes the
/// backlog. Unbound, or connected: -EINVAL (measured).
pub fn unix_listen(a: u64, fd: u64, backlog: u64) -> u64 {
    let r = rf(node_of(a, fd))
    let st = unix.state(r)
    if (st != unix.FRESH && st != unix.LISTEN) || unix.ino(r) == unix.NONE_INO {
        return neg(EINVAL)
    }
    let b = backlog & 0xffffffff
    unix.set_backlog(r, if b >= 0x80000000 || b > SOMAXCONN { SOMAXCONN } else { b })
    unix.set_state(r, unix.LISTEN)
    // px45: a listener's credentials, its own at `listen` (measured: what
    // SO_PEERCRED answers on it, and what a connector is told of it).
    unix.set_cred(r, sched.self_pid(), cred.uid(a, cred.EFFECTIVE), cred.gid(a, cred.EFFECTIVE))
    sched.wake_pipes() // a blocked connect may find room
    0
}

/// `connect(fd, addr, len)` on a path socket. The path resolved as
/// `open` resolves it (-ENOENT, -ENOTDIR); a name that is no socket, or
/// a socket that does not listen or has closed, -ECONNREFUSED (measured
/// all four); the caller listening -EINVAL, connected -EISCONN. At a
/// listener with room the server's end is made and queued and the call
/// answers 0 at once; with the queue full it waits for room, or answers
/// -EAGAIN under O_NONBLOCK (measured).
pub fn unix_connect(a: u64, pml4: u64, fd: u64, addr: u64, len: u64) -> u64 {
    let r = rf(node_of(a, fd))
    let (e, l) = un_path(a, pml4, addr, len)
    if e != 0 {
        return e
    }
    let st = unix.state(r)
    if st == unix.LISTEN {
        return neg(EINVAL)
    }
    if st == unix.CONN {
        return neg(EISCONN)
    }
    let n = resolve_k(a, AT_FDCWD, l)
    if is_err(n) {
        return neg(rf(n))
    }
    if ty(n) == T_INO && !may(a, cred.FS, n, MAY_W) {
        return neg(EACCES) // px44: write on the name (unix(7)), before whether anything listens
    }
    if ty(n) != T_INO || tree.sock_of(rf(n)) == 0 {
        return neg(ECONNREFUSED)
    }
    let lr = tree.sock_of(rf(n)) - 1
    if unix.state(lr) != unix.LISTEN {
        return neg(ECONNREFUSED)
    }
    if unix.kind(lr) != unix.kind(r) {
        return neg(EPROTOTYPE)
    }
    if !unix.room(lr) {
        if status(a, fd) & O_NONBLOCK != 0 {
            return neg(EAGAIN)
        }
        return WAIT
    }
    let srv = unix.new(unix.kind(r))
    if srv == unix.SOCKS {
        return neg(ENOBUFS)
    }
    let b1 = pipe_new(SOCK_PAGES)
    if b1 == PIPES {
        unix.free(srv)
        return neg(ENOBUFS)
    }
    let b2 = pipe_new(SOCK_PAGES)
    if b2 == PIPES {
        pipe_settle(b1)
        unix.free(srv)
        return neg(ENOBUFS)
    }
    // The client reads b1 and writes b2; the server's end the other way.
    put_ppw(b1, P_READERS, 1)
    put_ppw(b1, P_WRITERS, 1)
    put_ppw(b2, P_READERS, 1)
    put_ppw(b2, P_WRITERS, 1)
    unix.set_bufs(r, b1, b2)
    unix.set_bufs(srv, b2, b1)
    unix.set_peer(r, srv)
    unix.set_peer(srv, r)
    unix.copy_name(srv, lr) // an accepted end answers its listener's name
    // px45: SO_PEERCRED: the connector is told the listener's, the
    // server's end the connector's, at `connect` (measured).
    unix.copy_cred(r, lr)
    unix.set_cred(srv, sched.self_pid(), cred.uid(a, cred.EFFECTIVE), cred.gid(a, cred.EFFECTIVE))
    unix.set_state(srv, unix.QUEUED)
    unix.set_state(r, unix.CONN)
    unix.enqueue(lr, srv)
    sched.wake_pipes()
    0
}

/// Write path socket `who`'s name as a `struct sockaddr_un` at user
/// `addr`, cut to the room at `lenp`, and its whole length there: 2 for
/// an unnamed socket, else 2 + its length + 1 (`unix(7)`; measured,
/// with a NUL-less name too). -EFAULT, -EINVAL as getsockname(2).
fn un_out(pml4: u64, addr: u64, lenp: u64, who: u64) -> u64 {
    if !uaccess.readable(pml4, lenp, 4) || !uaccess.writable(pml4, lenp, 4) {
        return neg(EFAULT)
    }
    let cap = uaccess.get(pml4, lenp, 4)
    if cap >= 0x80000000 {
        return neg(EINVAL)
    }
    let nl = unix.name_len(who)
    let full = if nl == 0 { 2 } else { 2 + nl + 1 }
    let k = if cap < full { cap } else { full }
    if k > 0 && !uaccess.writable(pml4, addr, k) {
        return neg(EFAULT)
    }
    var i: u64 = 0
    while i < k {
        var b: u64 = 0
        if i == 0 {
            b = AF_UNIX
        } else if i >= 2 && i - 2 < nl {
            b = unix.name_byte(who, i - 2)
        }
        uaccess.put(pml4, addr + i, b, 1)
        i += 1
    }
    uaccess.put(pml4, lenp, full, 4)
    0
}

/// `accept4(fd, addr, lenp, flags)` on a path socket (and `accept`):
/// the queue's head as a descriptor (SOCK_CLOEXEC, SOCK_NONBLOCK;
/// another flag -EINVAL), its client's name written when asked; a socket
/// that does not listen -EINVAL; an empty queue waits, or -EAGAIN.
pub fn unix_accept(a: u64, pml4: u64, fd: u64, addr: u64, lenp: u64, flags: u64) -> u64 {
    if flags & !(O_CLOEXEC | O_NONBLOCK) != 0 {
        return neg(EINVAL)
    }
    let r = rf(node_of(a, fd))
    if unix.state(r) != unix.LISTEN {
        return neg(EINVAL)
    }
    if unix.qlen(r) == 0 {
        if status(a, fd) & O_NONBLOCK != 0 {
            return neg(EAGAIN)
        }
        return WAIT
    }
    if lowest_free(a, 0) == FDS {
        return neg(EMFILE)
    }
    if !of_room() {
        return neg(ENFILE)
    }
    let c = unix.dequeue(r)
    let nfd = open_new(a, 0, K_UNIX, (T_UNIX << T_SHIFT) | c, O_RDWR | flags)
    unix.set_state(c, unix.CONN)
    if addr != 0 && lenp != 0 {
        let p = unix.peer(c)
        let _w = un_out(pml4, addr, lenp, if p == unix.SOCKS { c } else { p })
    }
    sched.wake_pipes() // room on the queue for a waiting connect
    nfd
}

/// `getsockname` (`peer` false) and `getpeername` on a path socket:
/// its own name (an accepted end its listener's), or its peer's;
/// -ENOTCONN for a peer it has not (measured).
pub fn unix_getname(a: u64, pml4: u64, fd: u64, addr: u64, lenp: u64, peer: bool) -> u64 {
    let r = rf(node_of(a, fd))
    var who = r
    if peer {
        if unix.state(r) != unix.CONN || unix.peer(r) == unix.SOCKS {
            return neg(ENOTCONN)
        }
        who = unix.peer(r)
    }
    un_out(pml4, addr, lenp, who)
}

/// `getsockopt(fd, SOL_SOCKET, …)` on a path socket: SO_TYPE (3),
/// SO_ERROR (4: the reset waiting, taken) and SO_ACCEPTCONN (30); any
/// other -ENOPROTOOPT (measured for one Linux has not).
pub fn unix_getsockopt(a: u64, pml4: u64, fd: u64, level: u64, option: u64, value: u64, lenp: u64) -> u64 {
    let r = rf(node_of(a, fd))
    if level != 1 || (option != 3 && option != 4 && option != 30) {
        return neg(ENOPROTOOPT)
    }
    if !uaccess.readable(pml4, lenp, 4) || !uaccess.writable(pml4, lenp, 4) {
        return neg(EFAULT)
    }
    let cap = uaccess.get(pml4, lenp, 4)
    if cap >= 0x80000000 {
        return neg(EINVAL)
    }
    let k = if cap < 4 { cap } else { 4 }
    if !uaccess.writable(pml4, value, k) {
        return neg(EFAULT)
    }
    var v: u64 = 0
    if option == 3 {
        v = unix.kind(r)
    } else if option == 30 {
        v = if unix.state(r) == unix.LISTEN { 1 } else { 0 }
    } else {
        v = unix.err(r)
        unix.set_err(r, 0)
    }
    uaccess.put(pml4, value, v, k)
    uaccess.put(pml4, lenp, k, 4)
    0
}

/// px45: `getsockopt(fd, SOL_SOCKET, SO_PEERCRED, value, lenp)` on any
/// socket (`unix(7)`, `socket(7)`; measured on Linux 7.2.8): a `struct
/// ucred` (pid, uid, gid, four bytes each), cut to the room at `lenp`
/// (12 at most; the length written back is what was written, with no
/// error under 12). A socketpair's end answers its maker's pid and
/// effective ids at `socketpair`; a listening path socket its own at
/// `listen`; a connected one its peer's (kernel/unix's `cred`); one that
/// never connected, and every AF_INET socket, pid 0 and uid and gid -1.
/// -EBADF, -ENOTSOCK, -EFAULT, -EINVAL (a negative length).
pub fn peercred(a: u64, pml4: u64, fd: u64, value: u64, lenp: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k != K_SOCK && k != K_UNIX && k != K_INET && k != K_TCP {
        return neg(ENOTSOCK)
    }
    if !uaccess.readable(pml4, lenp, 4) || !uaccess.writable(pml4, lenp, 4) {
        return neg(EFAULT)
    }
    let cap = uaccess.get(pml4, lenp, 4)
    if cap >= 0x80000000 {
        return neg(EINVAL)
    }
    let n = if cap < 12 { cap } else { 12 }
    if n > 0 && !uaccess.writable(pml4, value, n) {
        return neg(EFAULT)
    }
    var pid: u64 = 0
    var uid: u64 = 0xffffffff
    var gid: u64 = 0xffffffff
    let r = rf(node_of(a, fd))
    if k == K_SOCK {
        let c = r & 0xffff
        if ppw(c, P_CPID) != 0 {
            pid = ppw(c, P_CPID) - 1
            uid = ppw(c, P_CIDS) & 0xffffffff
            gid = ppw(c, P_CIDS) >> 32
        }
    } else if k == K_UNIX {
        let (has, p, u, g) = unix.cred(r)
        if has {
            pid = p
            uid = u
            gid = g
        }
    }
    var i: u64 = 0
    while i < n {
        let word = if i < 4 { pid } else if i < 8 { uid } else { gid }
        uaccess.put(pml4, value + i, (word >> ((i % 4) * 8)) & 0xff, 1)
        i += 1
    }
    uaccess.put(pml4, lenp, n, 4)
    0
}

/// `setsockopt` on a path socket: refused by name, -ENOPROTOOPT (no
/// strace sets one; Linux takes SO_REUSEADDR, measured).
pub fn unix_setsockopt(a: u64) -> u64 {
    put(a, A_REFUSAL, unix.R_OPTION)
    unix.refuse()
    neg(ENOPROTOOPT)
}

/// `shutdown(fd, how)` on a path socket: SHUT_RD (0), SHUT_WR (1),
/// SHUT_RDWR (2) for this end, which its peer sees as the other half
/// (measured); `how` over 2 -EINVAL; on a socket that is not connected
/// it answers 0 and changes nothing (measured).
pub fn unix_shutdown(a: u64, fd: u64, how: u64) -> u64 {
    if how > 2 {
        return neg(EINVAL)
    }
    let r = rf(node_of(a, fd))
    if unix.state(r) == unix.CONN {
        unix.add_shut(r, if how == 0 { unix.RD } else if how == 1 { unix.WR } else { unix.RD | unix.WR })
        sched.wake_pipes()
    }
    0
}

// --- paths ------------------------------------------------------------------

fn kb(i: u64) -> u64 {
    // # Safety: i < 8192, inside boot/user.S's pax_kbuf.
    unsafe { ((pax_kbuf as u64 + i) as *u8).read_volatile() as u64 }
}

fn put_kb(i: u64, b: u64) {
    // # Safety: as `kb`.
    unsafe { ((pax_kbuf as u64 + i) as *u8).write_volatile((b & 0xff) as u8) }
}

fn raw() -> u64 {
    // # Safety: the address only.
    unsafe { pax_kbuf as u64 }
}

/// pax_kbuf's address (px14: `execve` reads the path `exec_lookup`
/// copied there).
pub fn kbuf() -> u64 {
    raw()
}

const NORM: u64 = 4096 // pax_kbuf's second half: a canonical path, a saved name
const KBUF_END: u64 = 8192

fn err(e: u64) -> u64 {
    (T_ERR << T_SHIFT) | e
}

fn is_err(n: u64) -> bool {
    n >> T_SHIFT == T_ERR
}

fn ty(n: u64) -> u64 {
    n >> T_SHIFT
}

fn rf(n: u64) -> u64 {
    n & REF_MASK
}

/// The node of the tree's inode `i` (px27).
fn ino_node(i: u64) -> u64 {
    (T_INO << T_SHIFT) | i
}

/// `/`'s node: the memory's ROOT, or (px67) the root volume's root
/// when `/` is on a disk (kernel/tree's `top`).
fn root_node() -> u64 {
    ino_node(tree.top())
}

/// A refusal by name: the area's word for kernel/user's line, and
/// kernel/tree's count.
fn refuse(a: u64, code: u64) {
    put(a, A_REFUSAL, code)
    tree.refuse()
}

/// Copy the user path at `va` into pax_kbuf[0..]; its length, or an
/// error node.
fn path_in(pml4: u64, va: u64) -> u64 {
    let n = uaccess.string_in(pml4, va, raw(), PATH_MAX)
    if n == PATH_MAX + 2 {
        return err(EFAULT)
    }
    if n == PATH_MAX + 1 {
        return err(ENAMETOOLONG)
    }
    n
}

/// Whether the canonical path [NORM, NORM + l) is `s`.
fn norm_is(l: u64, s: str) -> bool {
    var k: u64 = 0
    for b in s.bytes() {
        if k >= l || kb(NORM + k) != b as int as u64 {
            return false
        }
        k += 1
    }
    k == l
}

/// Whether the path component [s, s + n) of pax_kbuf is `name`.
fn comp_is(s: u64, n: u64, name: str) -> bool {
    var k: u64 = 0
    for b in name.bytes() {
        if k >= n || kb(s + k) != b as int as u64 {
            return false
        }
        k += 1
    }
    k == n
}

/// Make the absolute raw path [0, rl) canonical as text at NORM (`//`
/// and `.` dropped, `..` popping a component): its length, or an error
/// node (ENAMETOOLONG). Only `/proc/self/exe` is still found this way
/// (px26): every other path is walked a directory at a time (`walk`).
fn canon(rl: u64) -> u64 {
    var l: u64 = 0
    var i: u64 = 0
    while i < rl {
        while i < rl && kb(i) == 47 {
            i += 1
        }
        let s = i
        while i < rl && kb(i) != 47 {
            i += 1
        }
        let n = i - s
        if n == 0 || (n == 1 && kb(s) == 46) {
            continue
        }
        if n == 2 && kb(s) == 46 && kb(s + 1) == 46 {
            while l > 0 && kb(NORM + l - 1) != 47 {
                l -= 1
            }
            if l > 0 {
                l -= 1 // the '/'
            }
            continue
        }
        if l + 1 + n > PATH_MAX {
            return err(ENAMETOOLONG)
        }
        if l > 0 {
            put_kb(NORM + l, 47)
            l += 1
        }
        var j: u64 = 0
        while j < n {
            put_kb(NORM + l + j, kb(s + j))
            j += 1
        }
        l += n
    }
    l
}

/// Whether the user path at `va` is `/proc/self/exe`, however spelled
/// (px26: the one symbolic link there is).
fn is_proc_exe(pml4: u64, va: u64) -> bool {
    let rl = path_in(pml4, va)
    if is_err(rl) || rl == 0 || kb(0) != 47 {
        return false
    }
    let l = canon(rl)
    !is_err(l) && norm_is(l, "proc/self/exe")
}

fn is_dir_node(n: u64) -> bool {
    let t = ty(n)
    t == T_DEV || (t == T_INO && tree.is_dir(rf(n))) || (t == T_SYN && procfs.is_dir(rf(n)))
}

/// px34: the entry of /proc or /sys named [s, s + n) of pax_kbuf in `d`
/// (an entry, or procfs.ROOT), or an error node (ENOENT).
fn syn_child(d: u64, s: u64, n: u64) -> u64 {
    if d != procfs.ROOT && procfs.entry(d) == procfs.PIDDIR {
        if comp_is(s, n, "status") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 0) // px25
        }
        if comp_is(s, n, "setgroups") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 1) // px39
        }
        if comp_is(s, n, "cmdline") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 2) // px45
        }
        if comp_is(s, n, "environ") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 3)
        }
        if comp_is(s, n, "fd") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 4)
        }
        if comp_is(s, n, "stat") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 5) // px48
        }
        if comp_is(s, n, "fdinfo") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 6) // px50
        }
        if comp_is(s, n, "limits") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 7) // px55
        }
        if comp_is(s, n, "mounts") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 8) // px67
        }
        if comp_is(s, n, "mountinfo") {
            return (T_SYN << T_SHIFT) | procfs.child_at(d, 9)
        }
        return err(ENOENT)
    }
    if d == 1 && comp_is(s, n, "stat") {
        return (T_SYN << T_SHIFT) | procfs.self_stat() // px48: /proc/self/stat
    }
    if d == 1 && comp_is(s, n, "limits") {
        return (T_SYN << T_SHIFT) | procfs.self_limits() // px55: /proc/self/limits
    }
    if d == 1 && (comp_is(s, n, "mounts") || comp_is(s, n, "mountinfo")) {
        return (T_SYN << T_SHIFT) | procfs.self_mounts(n == 9) // px67
    }
    // px50: /proc/self/fd and /proc/self/fdinfo are the reader's own
    // (`/proc/<pid>`'s, its process's number in the reference).
    if d == 1 && comp_is(s, n, "fd") {
        return (T_SYN << T_SHIFT) | procfs.fd_dir(sched.self_pid(), 0)
    }
    if d == 1 && comp_is(s, n, "fdinfo") {
        return (T_SYN << T_SHIFT) | procfs.fd_dir(sched.self_pid(), 1)
    }
    if d != procfs.ROOT && (procfs.entry(d) == procfs.PFD || procfs.entry(d) == procfs.PFDINFO) {
        // px50: an open descriptor's number as Linux writes it (no sign,
        // no leading zero: `fd/01` is -ENOENT, measured) names its entry
        // (px45 listed them and found none).
        if n == 0 || n > 4 || (n > 1 && kb(s) == 48) {
            return err(ENOENT)
        }
        var v: u64 = 0
        var i: u64 = 0
        while i < n {
            let c = kb(s + i)
            if c < 48 || c > 57 {
                return err(ENOENT)
            }
            v = v * 10 + (c - 48)
            i += 1
        }
        let ta = pid_area(procfs.pid_of(d))
        if v >= FDS || ta == 0 || kind(ta, v) == K_CLOSED {
            return err(ENOENT)
        }
        let r = if procfs.entry(d) == procfs.PFD { procfs.fd_entry(procfs.pid_of(d), v) } else { procfs.fi_entry(procfs.pid_of(d), v) }
        return (T_SYN << T_SHIFT) | r
    }
    if procfs.searched(d) {
        // px79: /sys/block, /sys/class/block and a block device's
        // directory: their children are kernel/block's devices (procfs
        // finds them by kernel/block's name) and a device's attributes
        let c = procfs.dev_child(d, raw() + s, n)
        return if c == procfs.NONE { err(ENOENT) } else { (T_SYN << T_SHIFT) | c }
    }
    var e: u64 = 0
    while e < procfs.ENTRIES {
        if procfs.fixed(e) && procfs.parent(e) == d && comp_is(s, n, procfs.name(e)) {
            return (T_SYN << T_SHIFT) | e
        }
        e += 1
    }
    // px25: `/proc/<pid>`, a process's number as Linux writes it (no
    // sign, no leading zero), while the process is not yet reaped.
    if d == 0 && n >= 1 && n <= 10 && kb(s) != 48 {
        var v: u64 = 0
        var i: u64 = 0
        while i < n {
            let c = kb(s + i)
            if c < 48 || c > 57 {
                return err(ENOENT)
            }
            v = v * 10 + (c - 48)
            i += 1
        }
        let r = procfs.pid_child(0, v)
        if r != procfs.NONE {
            return (T_SYN << T_SHIFT) | r
        }
    }
    err(ENOENT)
}

/// px50: the area of process `pid`, or 0 when it is gone (reaped).
fn pid_area(pid: u64) -> u64 {
    let sl = sched.proc_slot(pid)
    if sl == sched.SLOTS {
        return 0
    }
    sched.proc_area_of_leader(sl)
}

/// px50: whether node `n` is an entry of a `/proc/<pid>/fd` (a magic
/// link: what it names is a descriptor's open file, not a path).
fn is_fd_entry(n: u64) -> bool {
    if is_err(n) || ty(n) != T_SYN {
        return false
    }
    let (isfd, _d) = procfs.fd_of(rf(n))
    isfd
}

// px50: the descriptor the last walk's last component led through, when
// it was an entry of `fd/` that was followed (openat reopens what it
// names: a pipe's end, the directory a file was opened in). One CPU,
// IF clear for the whole call: read by the call that walked.
var fdl_area: u64 = 0
var fdl_fd: u64 = 0
var fdl_last: bool = false

/// px50: the walk's note of the fd/ entry it followed (`last`: as the
/// path's last component).
fn fdl_note(ta: u64, fd: u64, last: bool) {
    // # Safety: one CPU, IF clear for the whole system call; the walk
    // and the open that reads the note are one call.
    unsafe {
        fdl_area = ta
        fdl_fd = fd
        fdl_last = last
    }
}

/// px50: the note (`fdl_note`): whether the last walk ended through an
/// fd/ entry, and its process's area and descriptor.
fn fdl_read() -> (bool, u64, u64) {
    // # Safety: as `fdl_note`.
    unsafe { (fdl_last, fdl_area, fdl_fd) }
}

/// px50: `ptrace(2)`'s read access mode with the file-system ids
/// (PTRACE_MODE_READ_FSCREDS, `proc_pid_fd(5)`; measured, px45's `sig`
/// and `rights` R and px50's `fdtab` P): may the process (area `a`) read
/// process `ta`'s descriptors, `environ`? Itself, a privileged one, or
/// one whose file-system user and group ids are each of the target's
/// real, effective and saved ones while the target is dumpable.
fn may_trace(a: u64, ta: u64) -> bool {
    if ta == a || cred.privileged(a) {
        return true
    }
    if cred.dumpable(ta) != 1 {
        return false
    }
    let u = cred.uid(a, cred.FS)
    let g = cred.gid(a, cred.FS)
    u == cred.uid(ta, cred.REAL) && u == cred.uid(ta, cred.EFFECTIVE) && u == cred.uid(ta, cred.SAVED) && g == cred.gid(ta, cred.REAL) && g == cred.gid(ta, cred.EFFECTIVE) && g == cred.gid(ta, cred.SAVED)
}

/// px50: what the `fd/` entry node `c` names, followed: (the node its
/// descriptor is open on, 0), or (0, an errno): -ENOENT when the process
/// or the descriptor is gone, -EACCES when `ptrace(2)`'s read mode says
/// no. Remembers the descriptor (`fdl_area`, `fdl_fd`).
fn fd_follow(a: u64, c: u64) -> (u64, u64) {
    let ta = pid_area(procfs.pid_of(rf(c)))
    let (_isfd, fd) = procfs.fd_of(rf(c))
    if ta == 0 || kind(ta, fd) == K_CLOSED {
        return (0, ENOENT)
    }
    if !may_trace(a, ta) {
        return (0, EACCES)
    }
    fdl_note(ta, fd, false)
    (node_of(ta, fd), 0)
}

/// px50: whether node `d` is the caller's own `/proc/<pid>/fd` or
/// `fdinfo` (Linux lets a process into its own even when it is not
/// dumpable and `fd/` is root's 0500: measured).
fn own_fd_dir(a: u64, d: u64) -> bool {
    if ty(d) != T_SYN {
        return false
    }
    let e = procfs.entry(rf(d))
    (e == procfs.PFD || e == procfs.PFDINFO) && pid_area(procfs.pid_of(rf(d))) == a
}

/// What the name [s, s + n) of pax_kbuf leads to in directory node `d`:
/// a node, or an error node (ENOENT). `/dev` is the root's `dev`, with
/// its six fixed names; everything else is the tree's.
fn child_named(d: u64, s: u64, n: u64) -> u64 {
    if ty(d) == T_DEV {
        if comp_is(s, n, "stdin") {
            return T_STD << T_SHIFT
        }
        if comp_is(s, n, "stdout") {
            return (T_STD << T_SHIFT) | 1
        }
        if comp_is(s, n, "stderr") {
            return (T_STD << T_SHIFT) | 2
        }
        if comp_is(s, n, "fd") {
            return (T_STD << T_SHIFT) | FD_LINK // px55
        }
        if comp_is(s, n, "null") {
            return T_NULL << T_SHIFT
        }
        if comp_is(s, n, "zero") {
            return (T_NULL << T_SHIFT) | ZERO // px45
        }
        if comp_is(s, n, "full") {
            return (T_NULL << T_SHIFT) | FULL
        }
        if comp_is(s, n, "random") {
            return (T_NULL << T_SHIFT) | RANDOM
        }
        if comp_is(s, n, "urandom") {
            return (T_NULL << T_SHIFT) | URANDOM
        }
        if comp_is(s, n, "tty0") {
            return (T_CONSOLE << T_SHIFT) | TTY0
        }
        if comp_is(s, n, "console") {
            return (T_CONSOLE << T_SHIFT) | CONSOLE
        }
        if comp_is(s, n, "tty") {
            return (T_CONSOLE << T_SHIFT) | TTY // px45
        }
        if comp_is(s, n, "ttyS0") {
            return (T_CONSOLE << T_SHIFT) | TTYS0
        }
        if comp_is(s, n, "dsp") && sound.up() {
            return T_DSP << T_SHIFT // px30: only with the device, as Linux without a card
        }
        // px79: a disk or a partition kernel/block has, by its name (the
        // nodes devtmpfs would have: made at boot and as a table is read
        // again, never written into an image: R-px79-2)
        let bd = block.by_name(raw() + s, n)
        if bd != block.DEVS {
            return blk_node(bd)
        }
        return err(ENOENT)
    }
    if ty(d) == T_SYN {
        return syn_child(rf(d), s, n) // px34
    }
    // px67: at `/`, whichever store it is in: with `/` on a disk these
    // are the memory's trees mounted over the disk's directories of the
    // same names, as a distribution's init mounts them (kernel/fstab
    // says once at boot when the disk has no such directory).
    if ty(d) == T_INO && rf(d) == tree.top() && comp_is(s, n, "dev") {
        return T_DEV << T_SHIFT
    }
    if ty(d) == T_INO && rf(d) == tree.top() && (comp_is(s, n, "proc") || comp_is(s, n, "sys")) {
        return syn_child(procfs.ROOT, s, n) // px34
    }
    let i = tree.lookup(rf(d), raw() + s, n)
    if i == tree.NONE {
        return err(ENOENT)
    }
    ino_node(i)
}

/// Directory node `d`'s parent (`..`): the root's is the root.
fn up(d: u64) -> u64 {
    if ty(d) == T_DEV {
        return root_node()
    }
    if ty(d) == T_SYN {
        let p = procfs.parent(rf(d)) // px34
        return if p == procfs.ROOT { root_node() } else { (T_SYN << T_SHIFT) | p }
    }
    ino_node(tree.parent(rf(d)))
}

// What `walk` says of a path's last component when it has no name of
// its own (its length is 0): which of these it was.
const LAST_ROOT: u64 = 0 // the path was `/` (or the directory it started in)
const LAST_DOT: u64 = 1 // `.`
const LAST_DOTDOT: u64 = 2 // `..`

/// px27: resolve (dirfd, path at va) a directory at a time
/// (`path_resolution(7)`): every component but the last must be a
/// directory that has it (-ENOENT, -ENOTDIR; `.` stays, `..` goes up,
/// and no further than the root), a component longer than 255 bytes is
/// -ENAMETOOLONG. Returns (the node the path names, or an error node —
/// ENOENT when only the last component is missing; the directory node
/// the last component is in; the component's offset in pax_kbuf; its
/// length, 0 when it has no name of its own, the offset then one of
/// LAST_*; whether a `/` follows it). A trailing `/` on what is not a
/// directory is -ENOTDIR. `empty_ok`: AT_EMPTY_PATH, an empty path
/// naming dirfd itself.
///
/// px36: a symbolic link met before the last component is followed;
/// the last one is followed when `follow` says so or a `/` comes after
/// it. Following rewrites the path in pax_kbuf in place — the target,
/// then what was left — and the walk goes on from the directory the
/// link is in (from `/` for an absolute target): so the offsets the
/// walk answers are into the rewritten path. The 41st link in one
/// resolution is -ELOOP; a rewritten path longer than PATH_MAX is
/// -ENAMETOOLONG. A link followed has its atime moved by relatime's
/// rule, as on tmpfs (measured).
///
/// px43: every directory a component is looked up in — `.` and `..`
/// and the last component's included, and the directory a relative
/// path starts in — must be searchable by the class rule (`may`,
/// MAY_X), else -EACCES; asked with the file-system ids (`walk_as`
/// takes the real ones for the access family).
fn walk(a: u64, pml4: u64, dirfd: u64, va: u64, empty_ok: bool, follow: u64) -> (u64, u64, u64, u64, bool) {
    walk_who(a, cred.FS, pml4, dirfd, va, empty_ok, follow)
}

/// px43: `walk`, asking with the ids `who`.
fn walk_who(a: u64, who: u64, pml4: u64, dirfd: u64, va: u64, empty_ok: bool, follow: u64) -> (u64, u64, u64, u64, bool) {
    let rl = path_in(pml4, va)
    if is_err(rl) {
        return (rl, rl, 0, 0, false)
    }
    walk_as(a, who, dirfd, rl, empty_ok, follow)
}

/// px52: whether node `c` is a symbolic link: the tree's (px36), or
/// `/dev/stdin`, `stdout`, `stderr` (pax#83); px55: and `/dev/fd`
/// (pax#88).
fn is_link_node(c: u64) -> bool {
    !is_err(c) && ((ty(c) == T_INO && tree.is_link(rf(c))) || ty(c) == T_STD || is_mounts_link(c))
}

/// px67: whether node `c` is `/proc/mounts`, a link to `self/mounts`.
fn is_mounts_link(c: u64) -> bool {
    ty(c) == T_SYN && procfs.entry(rf(c)) == procfs.MOUNTSLINK
}

/// px52: the length of link `c`'s target: the tree's, or 15 for
/// `/proc/self/fd/N`; px55: 13 for `/dev/fd`'s `/proc/self/fd`.
fn link_bytes(c: u64) -> u64 {
    if is_mounts_link(c) {
        return 11 // px67: `self/mounts`
    }
    if ty(c) == T_STD {
        return if rf(c) == FD_LINK { 13 } else { 15 }
    }
    tree.bytes(rf(c))
}

/// px52: link `c`'s target's first `k` bytes to kernel address `dst`
/// (px55: `/dev/fd`'s `k` is at most its 13, so neither the last `/` nor
/// a digit is written).
fn link_target(c: u64, dst: u64, k: u64) {
    if is_mounts_link(c) {
        var i: u64 = 0
        for b in "self/mounts".bytes() {
            if i < k {
                // # Safety: dst is pax_kbuf's (or its second half), at least k bytes.
                unsafe { ((dst + i) as *u8).write_volatile((b as int) as u8) }
            }
            i += 1
        }
        return
    }
    if ty(c) != T_STD {
        let _n = tree.target(rf(c), dst, k)
        return
    }
    let t = "/proc/self/fd/"
    var i: u64 = 0
    for b in t.bytes() {
        if i < k {
            // # Safety: dst is pax_kbuf's (or its second half), at least k bytes.
            unsafe { ((dst + i) as *u8).write_volatile(b as int as u8) }
        }
        i += 1
    }
    if i < k {
        // # Safety: as above.
        unsafe { ((dst + i) as *u8).write_volatile((48 + rf(c)) as u8) }
    }
}

/// px36: the link at node `c` replaces pax_kbuf[0..at) (the components
/// walked and the link's own name): the path becomes the link's target
/// and then pax_kbuf[at..len), NUL-ended. The new length, or an error
/// node (ENAMETOOLONG). px52: `/dev/std*`'s too.
fn follow_link(c: u64, at: u64, len: u64) -> u64 {
    let i = rf(c)
    let tl = link_bytes(c)
    let rest = len - at
    if tl + rest > PATH_MAX {
        return err(ENAMETOOLONG)
    }
    if tl > at {
        var k = rest
        while k > 0 {
            k -= 1
            put_kb(tl + k, kb(at + k))
        }
    } else if tl < at {
        var k: u64 = 0
        while k < rest {
            put_kb(tl + k, kb(at + k))
            k += 1
        }
    }
    link_target(c, raw(), tl)
    put_kb(tl + rest, 0)
    if ty(c) == T_INO {
        tree.touch_read(i)
    }
    tl + rest
}

/// px34: `walk` of the path already in pax_kbuf[0..rl) (a socket's
/// name, copied out of its `struct sockaddr_un`).
fn walk_k(a: u64, dirfd: u64, rl0: u64, empty_ok: bool, follow: u64) -> (u64, u64, u64, u64, bool) {
    walk_as(a, cred.FS, dirfd, rl0, empty_ok, follow)
}

/// px43: `walk_k`, asking with the ids `who` (cred.FS; cred.REAL for the
/// access family).
fn walk_as(a: u64, who: u64, dirfd: u64, rl0: u64, empty_ok: bool, follow: u64) -> (u64, u64, u64, u64, bool) {
    fdl_note(0, 0, false) // px50
    var rl = rl0
    if rl == 0 {
        if !empty_ok {
            return (err(ENOENT), err(ENOENT), 0, 0, false)
        }
        if dirfd == AT_FDCWD {
            return (cwd(a), err(EBUSY), LAST_ROOT, 0, false)
        }
        if kind(a, dirfd) == K_CLOSED {
            return (err(EBADF), err(EBADF), 0, 0, false)
        }
        return (stat_node(a, dirfd), err(EBUSY), LAST_ROOT, 0, false) // px62: a FIFO's end its FIFO
    }
    var cur = root_node()
    if kb(0) != 47 && dirfd == AT_FDCWD {
        cur = cwd(a) // px17
    }
    if kb(0) != 47 && dirfd != AT_FDCWD {
        if kind(a, dirfd) == K_CLOSED {
            return (err(EBADF), err(EBADF), 0, 0, false)
        }
        cur = node_of(a, dirfd)
        if !is_dir_node(cur) {
            return (err(ENOTDIR), err(ENOTDIR), 0, 0, false)
        }
    }
    var links: u64 = 0
    var i: u64 = 0
    while i < rl {
        while i < rl && kb(i) == 47 {
            i += 1
        }
        if i >= rl {
            break
        }
        let s = i
        while i < rl && kb(i) != 47 {
            i += 1
        }
        let n = i - s
        var j = i
        while j < rl && kb(j) == 47 {
            j += 1
        }
        let last = j >= rl
        if !is_dir_node(cur) {
            return (err(ENOTDIR), err(ENOTDIR), 0, 0, false)
        }
        // px43: the directory the component is looked up in is searched.
        // px50: a process's own fd/ and fdinfo/ whatever their owner; a
        // name looked up in another's asks ptrace(2)'s read mode (measured:
        // a 0555 fdinfo/ of a process not dumpable is -EACCES to a user).
        if !may(a, who, cur, MAY_X) && !own_fd_dir(a, cur) {
            return (err(EACCES), err(EACCES), 0, 0, false)
        }
        if ty(cur) == T_SYN && (procfs.entry(rf(cur)) == procfs.PFD || procfs.entry(rf(cur)) == procfs.PFDINFO) {
            let ta = pid_area(procfs.pid_of(rf(cur)))
            if ta != 0 && !may_trace(a, ta) {
                return (err(EACCES), err(EACCES), 0, 0, false)
            }
        }
        if n > tree.NAME_MAX {
            return (err(ENAMETOOLONG), err(ENAMETOOLONG), 0, 0, false)
        }
        var c = cur
        var dots: u64 = 0
        if n == 1 && kb(s) == 46 {
            dots = LAST_DOT
        } else if n == 2 && kb(s) == 46 && kb(s + 1) == 46 {
            dots = LAST_DOTDOT
            c = up(cur)
        } else {
            c = child_named(cur, s, n)
        }
        // px50: an entry of fd/ is followed where a link would be, to
        // what its descriptor is open on (`proc_pid_fd(5)`: no text is
        // read, no path is walked: a file removed or moved since is
        // still reached), after ptrace(2)'s read mode; it counts as a
        // link against MAXLINKS.
        if is_fd_entry(c) && (!last || follow == F_YES || (i < rl && follow == F_NO)) {
            let (tc, fe) = fd_follow(a, c)
            if fe != 0 {
                return (err(fe), err(fe), 0, 0, false)
            }
            links += 1
            if links > MAXLINKS {
                return (err(ELOOP), err(ELOOP), 0, 0, false)
            }
            if last {
                let trail = i < rl
                if trail && !is_dir_node(tc) {
                    return (err(ENOTDIR), err(ENOTDIR), 0, 0, false)
                }
                let (_l, fa, ff) = fdl_read()
                fdl_note(fa, ff, true)
                return (tc, cur, s, n, trail)
            }
            cur = tc
            continue
        }
        // px36: a symbolic link: followed unless it is the last
        // component, unfollowed and with no `/` after it. px52: /dev/std*.
        let link = is_link_node(c)
        if link && (!last || follow == F_YES || (i < rl && follow == F_NO)) {
            // px44: fs.protected_symlinks (R7): a link in a sticky
            // world-writable directory is followed, as the path's last
            // component, only by its owner or when the directory's owner
            // owns it (measured: one met in the middle of a path is
            // followed by anyone).
            if last && !may_follow(a, who, cur, c) {
                return (err(EACCES), err(EACCES), 0, 0, false)
            }
            links += 1
            if links > MAXLINKS {
                return (err(ELOOP), err(ELOOP), 0, 0, false)
            }
            let nl = follow_link(c, i, rl)
            if is_err(nl) {
                return (nl, nl, 0, 0, false)
            }
            rl = nl
            i = 0
            if kb(0) == 47 {
                cur = root_node()
            }
            continue
        }
        if last {
            let trail = i < rl
            if trail && !is_err(c) && !is_dir_node(c) && !link {
                c = err(ENOTDIR)
            }
            if dots != 0 {
                return (c, err(EBUSY), dots, 0, trail)
            }
            return (c, cur, s, n, trail)
        }
        if is_err(c) {
            return (c, c, 0, 0, false)
        }
        cur = c
    }
    (cur, err(EBUSY), LAST_ROOT, 0, false)
}

/// Resolve (dirfd, path at va) to a node (`walk`'s first answer).
/// px36: and `follow` says whether a last symbolic link is followed.
fn resolve(a: u64, pml4: u64, dirfd: u64, va: u64, empty_ok: bool, follow: u64) -> u64 {
    let (n, _p, _s, _l, _t) = walk(a, pml4, dirfd, va, empty_ok, follow)
    n
}

/// px43: `resolve`, asking with the ids `who`.
fn resolve_who(a: u64, who: u64, pml4: u64, dirfd: u64, va: u64, empty_ok: bool, follow: u64) -> u64 {
    let (n, _p, _s, _l, _t) = walk_who(a, who, pml4, dirfd, va, empty_ok, follow)
    n
}

/// px34: `resolve` of the path in pax_kbuf[0..rl) (px36: a last link
/// followed, as `connect` does).
fn resolve_k(a: u64, dirfd: u64, rl: u64) -> u64 {
    let (n, _p, _s, _l, _t) = walk_k(a, dirfd, rl, false, F_YES)
    n
}

/// px43 (pax#58): the process's file-system user id (low 32 bits) and
/// group id (high 32), one word, as a pipe's or a socket's maker.
fn fs_ids(a: u64) -> u64 {
    (cred.uid(a, cred.FS) & 0xffffffff) | (cred.gid(a, cred.FS) << 32)
}

/// px42: whether the process is in group `g` for a file's sake: its
/// file-system group id or one of its supplementary groups.
fn member(a: u64, g: u64) -> bool {
    member_as(a, cred.FS, g)
}

/// px43: the same, asking with the ids `who` (cred.FS, or cred.REAL for
/// the access family): that group id, or a supplementary group.
fn member_as(a: u64, who: u64, g: u64) -> bool {
    cred.gid(a, who) == g || cred.in_list(a, g)
}

// px43: what a check asks for (the low three bits of a mode's class,
// and of `access(2)`'s mode).
const MAY_X: u64 = 1
const MAY_W: u64 = 2
const MAY_R: u64 = 4

/// px43: THE class rule, the one place every permission check on a file
/// or a directory is decided (`inode(7)`, `path_resolution(7)`, POSIX
/// XBD 4.5; px38's `perm` A and B, measured): may the process, asking
/// with its ids `who` — the file-system ids (cred.FS) for every call but
/// the access family, the real ids (cred.REAL) for `access`,
/// `faccessat` and `faccessat2` without AT_EACCESS — have all of `want`
/// (MAY_R, MAY_W, MAY_X) of node `n`?
///
/// Privileged is that user id 0 (ruling #75 R9: file-system user id 0
/// for files): it reads and writes anything and searches every
/// directory, and executes what is not a directory only where some
/// execute bit is set. Anyone else is given exactly ONE class, chosen
/// once: the owner's bits when the user id is the node's owner — even
/// where they deny what the group's or the others' would allow — else
/// the group's when the group id or a supplementary group is the
/// node's group (`member_as`), else the others'. Callers: `walk_as`
/// (search, every directory a component is looked up in), `openat`,
/// `truncate`, `faccessat`, `exec_lookup`, `chdir`, `fchdir`; px44:
/// `may_make` and `unname` (write and search of a directory), `renameat`
/// (both directories, a moved directory's write), `may_hardlink` (read
/// and write), `utimensat` (write), `unix_connect` (write on the name).
fn may(a: u64, who: u64, n: u64, want: u64) -> bool {
    let m = n_mode(n)
    if cred.uid(a, who) == 0 {
        return want & MAY_X == 0 || is_dir_node(n) || m & 0x49 != 0 // 0o111
    }
    var bits = m & 7
    if cred.uid(a, who) == n_owner(a, n, 0) {
        bits = (m >> 6) & 7
    } else if member_as(a, who, n_owner(a, n, 1)) {
        bits = (m >> 3) & 7
    }
    want & 7 & !bits == 0
}

/// px44: the owner-or-privileged test (`chmod(2)`, `utimensat(2)`'s
/// explicit times): the process's file-system user id is node `n`'s
/// owner, or 0 (ruling #75 R9). Not a class rule: no mode bit is read.
fn owns(a: u64, n: u64) -> bool {
    let u = cred.uid(a, cred.FS)
    u == 0 || u == n_owner(a, n, 0)
}

/// px44: the sticky rule (`inode(7)`, `unlink(2)`, `rename(2)`; px38's
/// `perm` C): in a directory inode `d` with S_ISVTX, the name of inode
/// `i` may be removed, renamed or replaced only by its owner, the
/// directory's owner, or file-system user id 0 (R9); in any other
/// directory by whoever may write it.
fn sticky_ok(a: u64, d: u64, i: u64) -> bool {
    if tree.mode(d) & S_ISVTX == 0 {
        return true
    }
    let u = cred.uid(a, cred.FS)
    u == 0 || u == tree.uid(i) || u == tree.uid(d)
}

/// px44: whether a name of directory node `d` may be taken away or
/// replaced — the name of node `n`: 0, or EACCES when the class rule
/// gives no write and search of the directory (`may`), or EPERM when
/// the sticky rule refuses. Asked of the tree's directories (`/dev`'s
/// and `/proc`'s keep their own answers).
fn unname(a: u64, d: u64, n: u64) -> u64 {
    if ty(d) != T_INO || ty(n) != T_INO {
        return 0
    }
    if !may(a, cred.FS, d, MAY_W | MAY_X) {
        return EACCES
    }
    if !sticky_ok(a, rf(d), rf(n)) {
        return EPERM
    }
    0
}

/// px44: whether a name may be made in directory node `d` (`mkdir`,
/// `symlink`, `link`, `bind`): write and search by the class rule, as
/// `openat`'s O_CREAT asks (px43). The tree's directories, and px47:
/// `/dev` itself (root's 040755), asked BEFORE its fixed answer
/// (-EROFS by name), so a user is told -EACCES as Linux tells a user of
/// devtmpfs (measured: `tests/mpx3-tree`'s probes-user, a file, a
/// directory and a symbolic link made in /dev), and root still the
/// fixed answer.
fn may_make(a: u64, d: u64) -> bool {
    (ty(d) != T_INO && ty(d) != T_DEV) || may(a, cred.FS, d, MAY_W | MAY_X)
}

/// px44: `fs.protected_symlinks` = 1, fixed (ruling #75 R7;
/// `proc_sys_fs(5)`): a symbolic link `c` that is a path's last
/// component, whose name is in directory node `d`, may be followed
/// unless `d` is sticky and world-writable and neither the follower
/// (its user id `who`: the file-system one, or the real one for the
/// access family) nor the directory's owner owns the link — root
/// included (px38 measured root refused). A link met in the middle of a
/// path is followed by anyone (measured).
fn may_follow(a: u64, who: u64, d: u64, c: u64) -> bool {
    if ty(d) != T_INO || tree.mode(rf(d)) & 0x202 != 0x202 {
        return true // not sticky (01000) and world-writable (0002)
    }
    let lu = tree.uid(rf(c))
    cred.uid(a, who) == lu || tree.uid(rf(d)) == lu
}

/// px44: `fs.protected_regular` = 1, fixed (R7): `open` with O_CREAT of
/// an existing regular file `n` whose name is in a sticky
/// world-writable directory `d` is refused unless the opener's
/// file-system user id or the directory's owner owns the file — root
/// included. (`fs.protected_fifos` = 1 has nothing to act on: PAX makes
/// no FIFO, `mknod` is refused by name.)
fn may_creat_open(a: u64, d: u64, n: u64) -> bool {
    if ty(d) != T_INO || ty(n) != T_INO || tree.mode(rf(d)) & 0x202 != 0x202 || tree.mode(rf(n)) & S_IFMT != S_IFREG {
        return true
    }
    let fu = tree.uid(rf(n))
    cred.uid(a, cred.FS) == fu || tree.uid(rf(d)) == fu
}

/// px44: `fs.protected_hardlinks` = 1, fixed (R7): a hard link to node
/// `n` by one who is neither its owner nor file-system user id 0 is
/// refused (-EPERM) unless it is a regular file without S_ISUID and
/// without S_ISGID together with group execute, that the class rule
/// lets the caller read and write.
fn may_hardlink(a: u64, n: u64) -> bool {
    if owns(a, n) {
        return true
    }
    let m = n_mode(n)
    if ty(n) != T_INO || m & S_IFMT != S_IFREG || m & S_ISUID != 0 || m & (S_ISGID | S_IXGRP) == (S_ISGID | S_IXGRP) {
        return false
    }
    may(a, cred.FS, n, MAY_R | MAY_W)
}

/// px44: what a write by the process does to file inode `i`'s set-ID
/// bits (px38's `setid` `bits:` rows, vm-protected): unless its
/// file-system user id is 0 (R9; root keeps them), S_ISUID goes, and
/// S_ISGID when the file is group-executable or the writer is not in
/// its group (`member`). Called after a write of at least one byte, a
/// truncation (to any length) and `fallocate` succeed: the writer's ids
/// at that call decide, not the opener's.
fn wrote(a: u64, i: u64) {
    let m = tree.mode(i)
    if m & (S_ISUID | S_ISGID) == 0 || cred.uid(a, cred.FS) == 0 {
        return
    }
    var keep = m & !S_ISUID
    if m & S_IXGRP != 0 || !member(a, tree.gid(i)) {
        keep = keep & !S_ISGID
    }
    if keep != m {
        tree.set_mode(i, keep & 0xfff)
    }
}

/// px42: what a name made in directory inode `d` is stamped with: the
/// maker's file-system user id, and its file-system group id — or the
/// directory's group when the directory is set-group-ID: (the user id,
/// the group id, S_ISGID when the directory has it, else 0). Measured
/// on tmpfs for a file, a directory, a symbolic link and a socket's
/// name alike (px38's `perm` section H; `own` section S).
fn stamp(a: u64, d: u64) -> (u64, u64, u64) {
    let u = cred.uid(a, cred.FS)
    if tree.mode(d) & S_ISGID != 0 {
        return (u, tree.gid(d), S_ISGID)
    }
    (u, cred.gid(a, cred.FS), 0)
}

/// px42: a new file's permission bits: `perm` as asked (the umask
/// applied), without S_ISGID when the file is group-executable and its
/// maker is neither privileged (file-system user id 0) nor in the
/// group `g` it is given — which can only be a set-group-ID
/// directory's (measured: 06777 there by one outside the group is
/// 4755, 02666 keeps the bit, root keeps both).
fn file_perm(a: u64, perm: u64, g: u64) -> u64 {
    if perm & S_ISGID != 0 && perm & S_IXGRP != 0 && cred.uid(a, cred.FS) != 0 && !member(a, g) {
        return perm & !S_ISGID
    }
    perm
}

/// px27: the process's file mode creation mask (`umask(2)`): 022 until
/// it sets one.
fn mask_of(a: u64) -> u64 {
    let w = get(a, A_UMASK)
    if w == 0 {
        return 0x12 // 022
    }
    w & 0x1ff
}

/// px27: `umask(mask)`: the mask becomes `mask & 0777`; the old one is
/// answered. A child inherits it with the area; `execve` keeps it.
pub fn umask(a: u64, m: u64) -> u64 {
    let old = mask_of(a)
    put(a, A_UMASK, (m & 0x1ff) | 0x10000)
    old
}

// --- open, read, write, seek ---------------------------------------------------

/// Whether a new open file could be made now (the table has a record).
fn of_room() -> bool {
    var i: u64 = 0
    while i < OFILES && ofw(i, O_REFS) != 0 {
        i += 1
    }
    i < OFILES
}

/// px50: the new open file `o` (index + 1) of a file records the
/// directory it was opened in, held: the reopened open file's (`src`,
/// index + 1, when /dev/std* or an fd/ entry reopened it; its gone
/// name's text copied too), else `dir` (an inode + 1; 0 none).
fn opened_in(o: u64, src: u64, dir: u64) {
    var di = dir
    if src != 0 && (ofw(src - 1, O_KIND) == K_FILE || ofw(src - 1, O_KIND) == K_DIR) {
        di = ofw(src - 1, O_DIRI)
        let g = ofw(src - 1, O_GONE)
        if g != 0 {
            let c = frames.alloc() else 0
            if c != 0 {
                var w: u64 = 0
                while w < PAGE / 8 {
                    // # Safety: two frames through the HHDM, w < 512 words.
                    unsafe { ((c + frames.hhdm() + w * 8) as *u64).write_volatile(((g + frames.hhdm() + w * 8) as *u64).read_volatile()) }
                    w += 1
                }
                put_ofw(o - 1, O_GONE, c)
            }
        }
    }
    if di != 0 {
        tree.hold(di - 1)
        put_ofw(o - 1, O_DIRI, di)
    }
}

/// `openat(dirfd, path, flags, mode)`: the descriptor or -errno. px27:
/// O_CREAT makes the file when its name is missing (its permission bits
/// `mode & ~umask`; -EISDIR for a name with a trailing `/`; -ENOENT in
/// a directory that has been removed), O_EXCL with it is -EEXIST for a
/// name that exists, O_TRUNC cuts a file to nothing, O_WRONLY and
/// O_RDWR open it for `write`, O_APPEND makes every write go to its
/// end, O_NOFOLLOW is -ELOOP for the one link there is
/// (`/proc/self/exe`). A directory opens only to be read (-EISDIR
/// otherwise). O_DIRECT, O_SYNC, O_DSYNC, O_NOATIME and O_PATH are
/// refused by name, -EINVAL, and O_TMPFILE -EOPNOTSUPP: no strace asks
/// them and PAX would not honour them. Nothing can be made in `/dev`
/// (refused by name, -EROFS).
pub fn openat(a: u64, pml4: u64, dirfd: u64, va: u64, flags: u64, mode: u64) -> u64 {
    let acc = flags & O_ACCMODE
    if acc == 3 {
        return neg(EINVAL)
    }
    if flags & O_TMPFILE_BIT != 0 {
        refuse(a, R_OFLAG)
        return neg(EOPNOTSUPP)
    }
    if flags & (O_NOATIME | O_PATH) != 0 {
        refuse(a, R_OFLAG)
        return neg(EINVAL)
    }
    // px79: O_DIRECT, O_SYNC and O_DSYNC are taken on a block device's
    // node (its writes reach the device before they return: O_DIRECT's
    // alignment rules are not asked, named in docs/CENSUS.md) and refused
    // by name on anything else, as before.
    if flags & (O_DIRECT | O_DSYNC | O_SYNC_BIT) != 0 {
        let bn = resolve(a, pml4, dirfd, va, false, fol(flags & O_NOFOLLOW == 0))
        if is_err(bn) || ty(bn) != T_BLK {
            refuse(a, R_OFLAG)
            return neg(EINVAL)
        }
    }
    if flags & O_NOFOLLOW != 0 && is_proc_exe(pml4, va) {
        return neg(ELOOP)
    }
    // px36: a last symbolic link is followed but for O_NOFOLLOW (then
    // -ELOOP) and O_CREAT|O_EXCL (then -EEXIST, dangling or not).
    let excl = flags & O_CREAT != 0 && flags & O_EXCL != 0
    let (n0, par, ns, nl, trail) = walk(a, pml4, dirfd, va, false, fol(flags & O_NOFOLLOW == 0 && !excl))
    // px50: the last component was an entry of fd/, followed: what it
    // names is reopened (a new open file, as Linux's does).
    let (via, src_area, src_fd) = fdl_read()
    var n = n0
    if (is_link_node(n) || is_fd_entry(n)) && !excl {
        return neg(if flags & O_DIRECTORY != 0 { ENOTDIR } else { ELOOP }) // measured: O_DIRECTORY answers first; px50: an fd/ entry not followed too; px52: /dev/std*
    }
    var made = false
    if is_err(n) {
        if rf(n) != ENOENT || flags & O_CREAT == 0 || is_err(par) {
            return neg(rf(n))
        }
        if trail {
            return neg(EISDIR)
        }
        if ty(par) == T_SYN {
            return neg(ENOENT) // px34: nothing is made in /proc or /sys (measured: ENOENT)
        }
        if !may_make(a, par) {
            return neg(EACCES) // px47: a user's file in /dev, as a user's on Linux
        }
        if ty(par) != T_INO {
            refuse(a, R_DEVRO)
            return neg(EROFS)
        }
        // px43: a new name needs write and search of its directory.
        if !may(a, cred.FS, par, MAY_W | MAY_X) {
            return neg(EACCES)
        }
        if lowest_free(a, 0) == FDS {
            return neg(EMFILE)
        }
        if !of_room() {
            return neg(ENFILE)
        }
        let (su, sg, _dg) = stamp(a, rf(par))
        let i = tree.create(rf(par), raw() + ns, nl, file_perm(a, mode & !mask_of(a) & 0xfff, sg), su, sg)
        if tree.failed(i) {
            return i
        }
        n = ino_node(i)
        made = true
    } else if flags & O_CREAT != 0 && flags & O_EXCL != 0 {
        return neg(EEXIST)
    } else if flags & O_CREAT != 0 && !is_err(par) && !may_creat_open(a, par, n) {
        return neg(EACCES) // px44: fs.protected_regular (R7)
    }
    // px43: what the access mode asks of the class (`may`): read for
    // O_RDONLY, write for O_WRONLY, both for O_RDWR.
    var want = MAY_R
    if acc == O_WRONLY {
        want = MAY_W
    } else if acc == O_RDWR {
        want = MAY_R | MAY_W
    }
    var k = K_FILE
    // px43: a name of the tree, not /dev/std*'s descriptor; px45: /dev's
    // devices too, by their modes and owners (`checked`).
    let named = checked(n)
    var srcof: u64 = 0 // px50: the open file a reopen came from
    var sk = K_CLOSED
    if via {
        // px50 (measured): a socket's entry -ENXIO; an eventfd's and an
        // epoll object's -EACCES to whoever their 0600 (root's) mode
        // refuses, else -ENXIO; a pipe's end by its owner and 0600 mode
        // (`proc_pid_fd(5)`'s example), opened as the end asked.
        sk = kind(src_area, src_fd)
        srcof = of_of(src_area, src_fd)
        if sk == K_SOCK || sk == K_INET || sk == K_TCP || sk == K_UNIX {
            return neg(ENXIO)
        }
        if sk == K_EVENT || sk == K_EPOLL || sk == K_PIPE {
            if !may(a, cred.FS, n, want) {
                return neg(EACCES)
            }
            if sk != K_PIPE {
                return neg(ENXIO)
            }
        }
    }
    if ty(n) == T_BLK {
        return blk_open(a, n, flags, want) // px79
    }
    if ty(n) == T_CONSOLE {
        k = K_CONSOLE
    } else if ty(n) == T_NULL {
        k = K_NULL
    } else if ty(n) == T_DSP {
        if !may(a, cred.FS, n, want) {
            return neg(EACCES) // px45: 0600, root's (devtmpfs's, measured: a user is told -EACCES)
        }
        // px30: one opener, for writing (kernel/sound says why not).
        let r = sound.open(sched.self_pid(), acc)
        if r != 0 {
            return r
        }
        let fd = open_new(a, 0, K_DSP, n, flags)
        if fd >= 0x8000000000000000 {
            sound.release()
        }
        return fd
    } else if is_dir_node(n) {
        if acc != O_RDONLY || flags & O_CREAT != 0 {
            return neg(EISDIR)
        }
        if !may_read_of(a, n, MAY_R) {
            return neg(EACCES) // px45: /proc/<pid>/fd
        }
        k = K_DIR
    } else if ty(n) == T_INO && tree.is_sock(rf(n)) {
        if !may(a, cred.FS, n, want) {
            return neg(EACCES) // px43: the class is asked first (measured: a 0000 one is -EACCES to a user, -ENXIO to root)
        }
        return neg(ENXIO) // px34: a socket's name is not opened (measured)
    } else if ty(n) == T_INO && tree.is_fifo(rf(n)) {
        if flags & O_DIRECTORY != 0 {
            return neg(ENOTDIR)
        }
        if !may(a, cred.FS, n, want) {
            return neg(EACCES)
        }
        return fifo_open(a, rf(n), flags) // px62
    } else if ty(n) == T_SYN {
        k = K_SYN // px34: a file of /proc or /sys
    } else if sk == K_PIPE {
        k = K_PIPE // px50: a pipe's end, through its fd/ entry
    }
    if flags & O_DIRECTORY != 0 && k != K_DIR {
        return neg(ENOTDIR)
    }
    if k == K_SYN {
        if !may_read_of(a, n, want) {
            return neg(EACCES) // px45: /proc/<pid>/environ
        }
        return syn_open(a, n, flags)
    }
    // px43: a file or a directory of the tree opens only for what its
    // class allows (`want`, above), and O_TRUNC of a file asks write
    // whatever the access mode. A file this call made is exempt (its
    // first descriptor writes whatever its mode). px45: /dev's devices
    // the same, by their modes (measured on devtmpfs). /proc's guarded
    // files ask kernel/procfs's rule in `syn_open`. px52: what /dev/std*
    // reopens is what its fd/ entry reopens, by the same rules (it was
    // its own answer, no mode asked, until /dev/std* became links).
    if flags & O_TRUNC != 0 && k == K_FILE {
        want = want | MAY_W
    }
    if !made && named && !may(a, cred.FS, n, want) {
        return neg(EACCES)
    }
    if k == K_FILE && acc != O_RDONLY && running(n) {
        return neg(ETXTBSY) // px56 (pax#95): a running program's file, after the class rule (measured)
    }
    if k == K_FILE && (acc != O_RDONLY || flags & O_TRUNC != 0) && ty(n) == T_INO && tree.read_only(rf(n)) {
        return neg(EROFS) // px63: a file of a volume mounted read-only (open(2))
    }
    if k == K_CONSOLE && ty(n) == T_CONSOLE && rf(n) == TTY && !sched.self_tty() {
        return neg(ENXIO) // px48: /dev/tty is the caller's controlling terminal, and it has none (measured)
    }
    // px17: a new open file (offset 0), also when an fd/ entry (px50)
    // or /dev/std* (px52, through one) reopens a file or a pipe's end.
    let fd = open_new(a, 0, k, n, flags)
    if fd < 0x8000000000000000 && k == K_CONSOLE && !(ty(n) == T_CONSOLE && rf(n) == TTY) && flags & O_NOCTTY == 0 {
        sched.open_tty() // px48: a session leader with no terminal that opens the console takes it, when no session holds it
    }
    if fd < 0x8000000000000000 && k == K_FILE && ty(n) == T_INO {
        opened_in(of_of(a, fd), srcof, if !is_err(par) && ty(par) == T_INO { rf(par) + 1 } else { 0 })
    }
    if fd < 0x8000000000000000 && k == K_FILE && !made && flags & O_TRUNC != 0 && ty(n) == T_INO {
        if tree.bytes(rf(n)) != 0 {
            let _t = resize(rf(n), 0)
        }
        wrote(a, rf(n)) // px44: O_TRUNC takes the set-ID bits, as a write does
    }
    fd
}

/// px45: the lowest open descriptor at or above `from` of the process
/// whose `/proc/<pid>/fd` is node `d` (the reader's own for its own),
/// and the position after it; FDS when there is none (or the process is
/// gone).
fn fd_after(a: u64, d: u64, from: u64) -> (u64, u64) {
    let ta = syn_area(a, d)
    if ta == 0 {
        return (FDS, 0)
    }
    var f = from
    while f < FDS {
        if kind(ta, f) != K_CLOSED {
            return (f, f + 1)
        }
        f += 1
    }
    (FDS, 0)
}

/// px45: may the process read the guarded `/proc` node `n` (kernel/
/// procfs's `guarded`: a process's `environ` and `fd/`)? Its mode by the
/// class rule first (0400 and 0500, the target's effective ids while it
/// is dumpable and root's once it is not: kernel/procfs's `owner`); then
/// `ptrace(2)`'s access mode with the file-system ids (measured, px38's
/// `sig` and px45's `rights` R): the process itself, a privileged one
/// (effective user id 0), or one whose file-system user and group ids
/// are each of the target's real, effective and saved ones while the
/// target is dumpable. px47: every other node of /proc and /sys is asked
/// its mode by the class rule too, as Linux asks of procfs and sysfs
/// (measured: a user's open of its own 0444 `/proc/self/cgroup` to write
/// is -EACCES, root's 0; `tests/mpx4-unix`'s probes-user), where PAX
/// opened any of them for anyone.
fn may_read_of(a: u64, n: u64, want: u64) -> bool {
    if ty(n) != T_SYN {
        return true
    }
    if !may(a, cred.FS, n, want) && !(want == MAY_R && own_fd_dir(a, n)) {
        return false // px50: a process opens its own fd/ even when it is root's (not dumpable: measured)
    }
    if !procfs.guarded(rf(n)) {
        return true
    }
    let ta = syn_area(a, n)
    if ta == 0 {
        return false
    }
    may_trace(a, ta) // px50: the rule px45 wrote here, now shared with fd/'s links
}

/// px34: open a file of /proc or /sys: its text made now (kernel/procfs)
/// into a frame the new open file holds.
fn syn_open(a: u64, n: u64, flags: u64) -> u64 {
    if lowest_free(a, 0) == FDS {
        return neg(EMFILE)
    }
    if !of_room() {
        return neg(ENFILE)
    }
    // px25: /proc/<pid>/status reads the named process's area
    var ta = a
    let tp = procfs.pid_of(rf(n))
    if tp != 0 {
        let sl = sched.proc_slot(tp)
        if sl != sched.SLOTS {
            ta = sched.proc_area_of_leader(sl)
        }
    }
    var pa: u64 = 0
    var len: u64 = 0
    let (isfi, dn) = procfs.fi_of(rf(n))
    let mt = procfs.mount_text(rf(n))
    if mt != 0 {
        // px67: the mount table, made here (kernel/tree's mounts, the
        // kernel's own trees' fixed lines)
        let (p3, l3) = mounts_of(mt == 2)
        if p3 == 0 {
            return neg(ENOMEM)
        }
        pa = p3
        len = l3
    } else if isfi {
        // px50: fdinfo/N, made here from the descriptor (kernel/procfs
        // writes the lines)
        let fa = pid_area(tp)
        if fa == 0 || kind(fa, dn) == K_CLOSED {
            return neg(ENOENT)
        }
        let (p2, l2) = fdinfo_of(fa, dn)
        if p2 == 0 {
            return neg(ENOMEM)
        }
        pa = p2
        len = l2
    } else {
        let (p1, l1) = procfs.make(rf(n), ta, mask_of(ta), FDS, open_files(), OFILES)
        if p1 == 0 {
            return neg(if l1 == 1 { ENOENT } else { ENOMEM })
        }
        pa = p1
        len = l1
    }
    let fd = open_new(a, 0, K_SYN, n, flags)
    if fd >= 0x8000000000000000 {
        frames.free(pa)
        return fd
    }
    let o = of_of(a, fd)
    put_ofw(o - 1, O_TEXT, pa)
    put_ofw(o - 1, O_TEXT_LEN, len)
    fd
}

// --- px67: the mount table (/proc/self/mounts, mountinfo) -----------------------

/// A path in a mount table line, `proc(5)`'s escapes: a space, a tab, a
/// newline and a backslash as `\040`, `\011`, `\012`, `\134`. The
/// path of directory record `d` (`tpath`'s) is written first at `base +
/// at` and escaped in place, moving the rest right.
fn tpath_esc(base: u64, at: u64, cap: u64, d: u64) -> u64 {
    let end = tpath(base, at, cap, d)
    var k = at
    var e = if end < cap { end } else { cap }
    while k < e {
        // # Safety: a byte of the frame `mounts_of` writes, below cap.
        let b = unsafe { ((base + k) as *u8).read_volatile() as u64 }
        if b == 32 || b == 9 || b == 10 || b == 92 {
            if e + 3 > cap {
                return cap
            }
            var j = e
            while j > k + 1 {
                j -= 1
                // # Safety: as above; j + 3 < cap.
                let c = unsafe { ((base + j) as *u8).read_volatile() }
                unsafe { ((base + j + 3) as *u8).write_volatile(c) }
            }
            let _a = tput(base, k, cap, 92)
            let _b = tput(base, k + 1, cap, 48 + (b >> 6))
            let _c = tput(base, k + 2, cap, 48 + ((b >> 3) & 7))
            let _d = tput(base, k + 3, cap, 48 + (b & 7))
            k += 4
            e += 3
        } else {
            k += 1
        }
    }
    e
}

/// The options a mount's line says: `rw` or `ro`, then the flags kept
/// (MH_NOSUID, MH_NODEV, MH_NOEXEC), then `relatime` (PAX moves atimes
/// by relatime's rule everywhere, px36).
fn mount_opts(base: u64, at: u64, cap: u64, ro: bool, how: u64) -> u64 {
    var k = tstr(base, at, cap, if ro { "ro" } else { "rw" })
    if how & tree.MH_NOSUID != 0 {
        k = tstr(base, k, cap, ",nosuid")
    }
    if how & tree.MH_NODEV != 0 {
        k = tstr(base, k, cap, ",nodev")
    }
    if how & tree.MH_NOEXEC != 0 {
        k = tstr(base, k, cap, ",noexec")
    }
    tstr(base, k, cap, ",relatime")
}

/// A mount's id in mountinfo (and fdinfo's mnt_id, `mnt_of`): the
/// memory's tree 21 (`/` on the ISO way, or `/tmp`'s directory when `/`
/// is on a disk), /proc 22, /sys 23, /dev 24, volume v 26 + v; a second
/// memory mount 30 + its number.
fn mount_id(m: u64) -> u64 {
    let v = tree.mounted(m)
    if v != tree.NONE {
        return 26 + v
    }
    if tree.root_on_volume() { 21 } else { 30 + m }
}

/// The id of the mount directory record `d` lies in (the parent field
/// of a mount on it).
fn id_at(d: u64) -> u64 {
    mnt_of(ino_node(d))
}

/// px67: `/proc/self/mounts` (`info` false) or `mountinfo` (true), as
/// `proc(5)` describes them and Linux 7.2.8 writes them (measured on the
/// guest with `root=` on ext2 and with an initramfs:
/// tests/mpx6-root.d/linux/): `/` first — `/dev/root / ext2 rw,relatime
/// 0 0` when it is a volume (Linux names the root `root=` mounted
/// `/dev/root`), `rootfs / rootfs rw,size=…k,nr_inodes=… 0 0` when it is
/// the memory's — then the kernel's own trees, /dev, /proc and /sys,
/// with the flags a distribution's init gives them (measured; /dev's as
/// the kernel's own mount of devtmpfs has them), then kernel/tree's
/// mounts in the order they were made (`/tmp`'s memory, `/home`, a
/// mount(2)'s volume: its disk's `/dev/` name, the name Linux's mount(8)
/// passes). mountinfo's line: the mount's id, its parent's, the device's
/// numbers, `/`, the point, the options, `-`, the type, the source, the
/// super options (`rw` or `ro`; tmpfs's `size=`, devtmpfs' `mode=755`).
/// Named drifts: devtmpfs' and tmpfs' `size=`, `nr_inodes=`, `inode64`
/// and `huge=` (PAX's /dev holds nothing, its tmpfs is the tree's cap),
/// and on the ISO way the kernel's trees listed after `/` in that fixed
/// order. (the frame, its length)
fn mounts_of(info: bool) -> (u64, u64) {
    let f = frames.alloc() else 0
    if f == 0 {
        return (0, 0)
    }
    let base = f + frames.hhdm()
    let cap = PAGE
    var k: u64 = 0
    // `/`.
    var rm = tree.MOUNTS
    var m: u64 = 0
    while m < tree.MOUNTS {
        if tree.in_use(m) && tree.is_root_mount(m) {
            rm = m
        }
        m += 1
    }
    let top = tree.top()
    let rid = if rm != tree.MOUNTS { mount_id(rm) } else { 21 }
    if rm != tree.MOUNTS {
        let v = tree.mounted(rm)
        let ro = tree.read_only(top)
        let (ma, mi) = block.numbers(tree.mount_dev(rm))
        if info {
            k = tdec(base, k, cap, rid)
            k = tstr(base, k, cap, " 1 ")
            k = tdec(base, k, cap, ma)
            k = tput(base, k, cap, 58)
            k = tdec(base, k, cap, mi)
            k = tstr(base, k, cap, " / / ")
            k = mount_opts(base, k, cap, ro, tree.mount_how(rm))
            k = tstr(base, k, cap, if ext2.fstype(v) == 3 { " - ext3 /dev/root " } else { " - ext2 /dev/root " })
            k = tstr(base, k, cap, if ro { "ro" } else { "rw" })
        } else {
            // px68: a journalled root is `ext3`, as Linux 7.3.0 names it
            k = tstr(base, k, cap, if ext2.fstype(v) == 3 { "/dev/root / ext3 " } else { "/dev/root / ext2 " })
            k = mount_opts(base, k, cap, ro, tree.mount_how(rm))
            k = tstr(base, k, cap, " 0 0")
        }
        let _v = v
    } else {
        if info {
            k = tstr(base, k, cap, "21 1 0:1 / / rw - rootfs rootfs rw,size=")
        } else {
            k = tstr(base, k, cap, "rootfs / rootfs rw,size=")
        }
        k = tdec(base, k, cap, tree.cap() * 4)
        k = tstr(base, k, cap, "k,nr_inodes=")
        k = tdec(base, k, cap, tree.MAX_INODES)
        if !info {
            k = tstr(base, k, cap, " 0 0")
        }
    }
    k = tput(base, k, cap, 10)
    // The kernel's own trees, over `/`'s directories of their names.
    if info {
        k = tstr(base, k, cap, "24 ")
        k = tdec(base, k, cap, rid)
        k = tstr(base, k, cap, " 0:5 / /dev rw,nosuid,noexec,relatime - devtmpfs devtmpfs rw,mode=755\n22 ")
        k = tdec(base, k, cap, rid)
        k = tstr(base, k, cap, " 0:6 / /proc rw,nosuid,nodev,noexec,relatime - proc proc rw\n23 ")
        k = tdec(base, k, cap, rid)
        k = tstr(base, k, cap, " 0:7 / /sys rw,nosuid,nodev,noexec,relatime - sysfs sysfs rw\n")
    } else {
        k = tstr(base, k, cap, "devtmpfs /dev devtmpfs rw,nosuid,noexec,relatime,mode=755 0 0\nproc /proc proc rw,nosuid,nodev,noexec,relatime 0 0\nsysfs /sys sysfs rw,nosuid,nodev,noexec,relatime 0 0\n")
    }
    // The tree's, in the order they were made.
    var seq: u64 = 0
    var guard: u64 = 0
    while guard < tree.MOUNTS {
        let n = tree.mount_after(seq)
        if n == tree.MOUNTS {
            break
        }
        seq = tree.mount_seq(n)
        guard += 1
        if n == rm {
            continue
        }
        let v = tree.mounted(n)
        let r = tree.mount_root_rec(n)
        let pt = tree.mount_point(n)
        let ro = v != tree.NONE && tree.read_only(r)
        let how = tree.mount_how(n)
        if info {
            k = tdec(base, k, cap, mount_id(n))
            k = tput(base, k, cap, 32)
            k = tdec(base, k, cap, id_at(pt))
            k = tput(base, k, cap, 32)
            if v != tree.NONE {
                let (ma, mi) = block.numbers(tree.mount_dev(n))
                k = tdec(base, k, cap, ma)
                k = tput(base, k, cap, 58)
                k = tdec(base, k, cap, mi)
            } else {
                k = tstr(base, k, cap, "0:1")
            }
            k = tstr(base, k, cap, " / ")
            k = tpath_esc(base, k, cap, pt)
            k = tput(base, k, cap, 32)
            k = mount_opts(base, k, cap, ro, how)
            if v != tree.NONE {
                k = tstr(base, k, cap, if ext2.fstype(v) == 3 { " - ext3 /dev/" } else { " - ext2 /dev/" })
                k = block.name_into(tree.mount_dev(n), base, k, cap)
                k = tput(base, k, cap, 32)
                k = tstr(base, k, cap, if ro { "ro" } else { "rw" })
            } else {
                k = tstr(base, k, cap, " - tmpfs tmpfs rw")
                k = tmode(base, k, cap, n)
            }
        } else {
            if v != tree.NONE {
                k = tstr(base, k, cap, "/dev/")
                k = block.name_into(tree.mount_dev(n), base, k, cap)
                k = tput(base, k, cap, 32)
                k = tpath_esc(base, k, cap, pt)
                k = tstr(base, k, cap, if ext2.fstype(v) == 3 { " ext3 " } else { " ext2 " })
                k = mount_opts(base, k, cap, ro, how)
            } else {
                k = tstr(base, k, cap, "tmpfs ")
                k = tpath_esc(base, k, cap, pt)
                k = tstr(base, k, cap, " tmpfs ")
                k = mount_opts(base, k, cap, false, how)
                k = tmode(base, k, cap, n)
            }
            k = tstr(base, k, cap, " 0 0")
        }
        k = tput(base, k, cap, 10)
    }
    (f, if k < cap { k } else { cap })
}

/// A memory mount's `,mode=NNNN` when it is not tmpfs's 1777 (proc(5):
/// the options as mounted; measured: `mode=1777` is not shown).
fn tmode(base: u64, at: u64, cap: u64, m: u64) -> u64 {
    let md = tree.mode_of(m)
    if md == 0 || md == 0x3ff {
        return at
    }
    var k = tstr(base, at, cap, ",mode=")
    if md >= 0x200 {
        k = tput(base, k, cap, 48 + (md >> 9))
    }
    k = tput(base, k, cap, 48 + ((md >> 6) & 7))
    k = tput(base, k, cap, 48 + ((md >> 3) & 7))
    tput(base, k, cap, 48 + (md & 7))
}

/// px50: `fdinfo/<fd>` of process `ta` (`proc_pid_fdinfo(5)`, measured):
/// the offset; the access mode and the status flags as `open` kept them
/// (O_APPEND, O_NONBLOCK, O_DIRECTORY, O_NOFOLLOW; O_CREAT, O_EXCL,
/// O_TRUNC and O_NOCTTY are not kept), O_CLOEXEC while the descriptor
/// has it, O_LARGEFILE for what `open` made (not a pipe, a socket, an
/// eventfd or an epoll object); a mount number per file system
/// (`mnt_of`); the `st_ino` `fstat` answers; an eventfd's counter, an
/// AF_UNIX socket's `scm_fds: 0`. (the frame, its length).
fn fdinfo_of(ta: u64, fd: u64) -> (u64, u64) {
    let k = kind(ta, fd)
    let nd = node_of(ta, fd)
    var f = access(ta, fd) | (status(ta, fd) & (O_APPEND | O_NONBLOCK | O_DIRECTORY | O_NOFOLLOW))
    if flags_of(ta, fd) & O_CLOEXEC != 0 {
        f = f | O_CLOEXEC
    }
    if k == K_FILE || k == K_DIR || k == K_CONSOLE || k == K_NULL || k == K_SYN || k == K_DSP || k == K_BLK {
        f = f | O_LARGEFILE
    }
    let extra: u64 = if k == K_EVENT { 1 } else if k == K_SOCK || k == K_UNIX { 2 } else { 0 }
    let cnt = if k == K_EVENT { event.ev_value(rf(nd)) } else { 0 }
    let sem = k == K_EVENT && event.ev_semaphore(rf(nd)) // px52: pax#82
    procfs.fdinfo(pos(ta, fd), f, mnt_of(nd), n_ino(nd), extra, cnt, rf(nd), sem)
}

/// px50: the number fdinfo's `mnt_id` gives node `n`'s file system: one
/// for the tree, one each for /proc, /sys and /dev, and the kernel's own
/// for pipes, sockets and anonymous inodes (Linux's numbers are its
/// mounts' and differ from machine to machine; `fdtab` asks only which
/// are the same).
fn mnt_of(n: u64) -> u64 {
    let t = ty(n)
    if t == T_INO {
        return if tree.on_volume(rf(n)) { 25 + tree.store(rf(n)) } else { 21 } // px63: a volume's mount
    }
    if t == T_SYN {
        return 22 + procfs.fs(rf(n))
    }
    if t == T_DEV || t == T_NULL || t == T_CONSOLE || t == T_DSP || t == T_STD || t == T_BLK {
        return 24
    }
    if t == T_PIPE {
        return 13
    }
    if t == T_EVENT || t == T_EPOLL {
        return 15
    }
    14
}

/// px34: a read of a /proc or /sys file: its text from the offset on.
fn syn_read(a: u64, pml4: u64, fd: u64, buf: u64, n: u64) -> u64 {
    let o = of_of(a, fd)
    let r = rf(node_of(a, fd))
    if procfs.guarded(r) && procfs.gone(r) {
        return neg(ESRCH) // px45: a zombie's environ (measured: its open succeeds, its read does not)
    }
    let len = ofw(o - 1, O_TEXT_LEN)
    let off = ofw(o - 1, O_POS)
    if off >= len || n == 0 {
        if !uaccess.in_user(buf, 0) {
            return neg(EFAULT)
        }
        return 0
    }
    var k = if n < len - off { n } else { len - off }
    if procfs.entry(r) == procfs.PARTITIONS {
        // px66: /proc/partitions' bytes [off, off + k) made into the
        // file's frame for this read (a page at most: a shorter read).
        if k > 4096 {
            k = 4096
        }
        let va = ofw(o - 1, O_TEXT) + frames.hhdm()
        let w = block.partitions_slice(va, off, k)
        if !uaccess.copy_out(pml4, buf, va, w) {
            return neg(EFAULT)
        }
        put_ofw(o - 1, O_POS, off + w)
        return w
    }
    if !uaccess.copy_out(pml4, buf, ofw(o - 1, O_TEXT) + frames.hhdm() + off, k) {
        return neg(EFAULT)
    }
    put_ofw(o - 1, O_POS, off + k)
    k
}

/// Copy up to `n` bytes of file node `node` from offset `off` to user
/// `buf`: the count, or -EFAULT.
fn file_read(pml4: u64, node: u64, off: u64, buf: u64, n: u64) -> u64 {
    let i = rf(node)
    let size = tree.bytes(i)
    if off >= size || n == 0 {
        if !uaccess.in_user(buf, 0) {
            return neg(EFAULT)
        }
        return 0
    }
    let k = if n < size - off { n } else { size - off }
    if !uaccess.writable(pml4, buf, k) {
        return neg(EFAULT)
    }
    tree.read(pml4, i, off, buf, k)
}

/// px45: a read of a memory device (`null(4)`): /dev/null is at its
/// end; /dev/zero and /dev/full give zeros, as much as was asked,
/// checked whole first. (/dev/random and /dev/urandom are kernel/user's
/// `getrandom`: `is_random`.)
fn dev_read(pml4: u64, r: u64, buf: u64, n: u64) -> u64 {
    if r == 0 || n == 0 {
        return 0
    }
    if !uaccess.writable(pml4, buf, n) {
        return neg(EFAULT)
    }
    uaccess.zero(pml4, buf, n)
    n
}

/// px45: whether descriptor `fd` is the console (kernel/user asks it of
/// the speaker's ioctls).
pub fn is_console(a: u64, fd: u64) -> bool {
    kind(a, fd) == K_CONSOLE
}

/// px45: whether a read of descriptor `fd` is /dev/random's or
/// /dev/urandom's (`random(4)`): kernel/user answers it as `getrandom`
/// does, from PAX's one pool (RDRAND when the CPU has it), and neither
/// ever blocks, as Linux's do once their pool is ready.
pub fn is_random(a: u64, fd: u64) -> bool {
    if kind(a, fd) != K_NULL || access(a, fd) == O_WRONLY {
        return false
    }
    let r = rf(node_of(a, fd))
    r == RANDOM || r == URANDOM
}

/// `read(fd, buf, n)`.
pub fn read(a: u64, pml4: u64, fd: u64, buf: u64, n: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED || access(a, fd) == O_WRONLY {
        return neg(EBADF)
    }
    if k == K_DIR {
        return neg(EISDIR)
    }
    if k == K_NULL {
        return dev_read(pml4, rf(node_of(a, fd)), buf, n) // /dev/null's end-of-file; px45: zeros, random bytes
    }
    if k == K_CONSOLE {
        // px13: what was typed (kernel/console), or console.RESTART for
        // kernel/user to wait; end of file before the console is started.
        // px46: with VMIN 0 and VTIME above 0, console.TIMED: the read
        // waits as a pipe's does (WAIT), until a key or its deadline,
        // which it keeps in the thread's own word as `poll` does.
        // px48: a background reader of its controlling terminal is sent
        // SIGTTIN (or told -EIO): kernel/console's `job`.
        let j = console.job(console.J_READ)
        if j != 0 {
            return j
        }
        let (r, u) = console.read(pml4, buf, n, status(a, fd) & O_NONBLOCK != 0, sched.self_until())
        sched.set_self_until(u)
        if r == console.TIMED {
            return WAIT
        }
        return r
    }
    if k == K_PIPE || k == K_SOCK || k == K_UNIX {
        return pipe_read(a, pml4, fd, buf, n, false) // px17; px34: a path socket
    }
    if k == K_SYN {
        return syn_read(a, pml4, fd, buf, n) // px34
    }
    if k == K_INET || k == K_TCP {
        return neg(EINVAL) // px22: kernel/user sends a socket's read to kernel/socket
    }
    if k == K_EVENT {
        return event_read(a, pml4, fd, buf, n) // px24
    }
    if k == K_EPOLL {
        return neg(EINVAL) // px24: epoll(7): an epoll descriptor is not read
    }
    if k == K_BLK {
        let d = blk_dev(node_of(a, fd)) // px79
        let r = blk_in(pml4, d, pos(a, fd), buf, n)
        if r < 0x8000000000000000 {
            set_pos(a, fd, pos(a, fd) + r)
        }
        return r
    }
    let r = file_read(pml4, node_of(a, fd), pos(a, fd), buf, n)
    if r < 0x8000000000000000 {
        set_pos(a, fd, pos(a, fd) + r)
    }
    r
}

/// `pread64(fd, buf, n, off)`.
pub fn pread(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, off: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED || access(a, fd) == O_WRONLY {
        return neg(EBADF)
    }
    if k == K_DIR {
        return neg(EISDIR)
    }
    if k == K_BLK && off < 0x8000000000000000 {
        return blk_in(pml4, blk_dev(node_of(a, fd)), off, buf, n) // px79
    }
    if k != K_FILE && k != K_BLK {
        return neg(ESPIPE)
    }
    if off >= 0x8000000000000000 {
        return neg(EINVAL)
    }
    file_read(pml4, node_of(a, fd), off, buf, n)
}

/// px27: `write(fd, buf, n)` to a file of the tree (kernel/user's
/// `write`, for `write_target`'s 4): the bytes go in at the open file's
/// offset, or at the file's end when it was opened with O_APPEND (the
/// end as it is now: two descriptors appending never overwrite each
/// other), and the offset moves past them. The count written — less
/// than `n` when the tree's frames ran out part-way — or -EFAULT (the
/// whole buffer is checked first: nothing is written), -ENOSPC, -EFBIG.
/// One call writes at most 0x7ffff000 bytes, as Linux.
pub fn file_write(a: u64, pml4: u64, fd: u64, buf: u64, n: u64) -> u64 {
    if n == 0 {
        return 0
    }
    let k = if n < 0x7ffff000 { n } else { 0x7ffff000 }
    if !uaccess.readable(pml4, buf, k) {
        return neg(EFAULT)
    }
    let i = rf(node_of(a, fd))
    var p = pos(a, fd)
    if status(a, fd) & O_APPEND != 0 {
        p = tree.bytes(i)
    }
    let r = tree.write(pml4, i, p, buf, k)
    if !tree.failed(r) {
        set_pos(a, fd, p + r)
        wrote(a, i) // px44
    }
    r
}

/// px27: `pwrite64(fd, buf, n, off)`: as `write` at `off`, the open
/// file's offset left alone; a file opened with O_APPEND takes the
/// bytes at its end whatever `off` says (`pwrite(2)`, BUGS: Linux's
/// answer, measured). -EBADF for a descriptor not open for writing,
/// -ESPIPE for what has no offset, -EINVAL for a negative one.
pub fn pwrite(a: u64, pml4: u64, fd: u64, buf: u64, n: u64, off: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED || access(a, fd) == O_RDONLY || k == K_DIR {
        return neg(EBADF)
    }
    if k == K_BLK {
        if off >= 0x8000000000000000 {
            return neg(EINVAL)
        }
        return blk_out(pml4, blk_dev(node_of(a, fd)), off, buf, n) // px79
    }
    if k != K_FILE {
        return neg(ESPIPE)
    }
    if off >= 0x8000000000000000 {
        return neg(EINVAL)
    }
    if n == 0 {
        return 0
    }
    let c = if n < 0x7ffff000 { n } else { 0x7ffff000 }
    if !uaccess.readable(pml4, buf, c) {
        return neg(EFAULT)
    }
    let i = rf(node_of(a, fd))
    let p = if status(a, fd) & O_APPEND != 0 { tree.bytes(i) } else { off }
    let r = tree.write(pml4, i, p, buf, c)
    if !tree.failed(r) {
        wrote(a, i) // px44
    }
    r
}

/// `lseek(fd, off, whence)`: SEEK_SET 0, SEEK_CUR 1, SEEK_END 2. px27:
/// an offset past a file's end is allowed, and a write there leaves a
/// hole that reads as zeros.
pub fn lseek(a: u64, fd: u64, off: u64, whence: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k == K_CONSOLE || k == K_PIPE || k == K_SOCK || k == K_INET || k == K_TCP || k == K_DSP || k == K_UNIX {
        return neg(ESPIPE)
    }
    if k == K_NULL || k == K_EPOLL || k == K_EVENT {
        return 0 // px24: Linux answers 0 on an epoll descriptor and on an eventfd (user/net/epollprobe.c, evprobe.c)
    }
    if k == K_BLK {
        return blk_seek(a, fd, off, whence) // px79
    }
    var base: u64 = 0
    if whence == 1 {
        base = pos(a, fd)
    } else if whence == 2 {
        if k == K_FILE {
            base = tree.bytes(rf(node_of(a, fd)))
        }
    } else if whence != 0 {
        return neg(EINVAL)
    }
    var p: u64 = 0
    if off < 0x8000000000000000 {
        if off > 0x7fffffffffffffff - base {
            return neg(EINVAL)
        }
        p = base + off
    } else {
        let back = 0xffffffffffffffff - off + 1
        if back > base {
            return neg(EINVAL)
        }
        p = base - back
    }
    set_pos(a, fd, p)
    p
}

/// px27: `ftruncate(fd, len)`: the file is `len` bytes long: cut (every
/// frame past that given back at once) or longer by a hole. -EBADF for
/// a closed descriptor; -EINVAL for one that is not a file open for
/// writing (`ftruncate(2)`), and for a negative length; -EFBIG.
pub fn ftruncate(a: u64, fd: u64, len: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k != K_FILE || access(a, fd) == O_RDONLY || len >= 0x8000000000000000 {
        return neg(EINVAL)
    }
    let i = rf(node_of(a, fd))
    let r = resize(i, len)
    if r == 0 {
        wrote(a, i) // px44: to any length, the same one too
    }
    r
}

/// px62: file `i` made `size` bytes long: when that cuts it, every
/// mapping of it past the new end is unmapped first, in every process
/// (kernel/vm's `cut_maps`), so no space keeps a frame the tree gives
/// back; then the tree cuts or grows it.
fn resize(i: u64, size: u64) -> u64 {
    if size < tree.bytes(i) {
        vm.cut_maps(i, size)
    }
    tree.truncate(i, size)
}

/// px44: `fallocate(fd, mode, offset, len)` (`fallocate(2)`): the file
/// is at least `offset + len` bytes long afterwards (it grows by a hole:
/// the tree gives a frame when a page is written, so the space is not
/// set aside — named drift), and the call takes the set-ID bits as a
/// write does (px38's `setid`: `fallocate` by a user clears them, by
/// root keeps them). -EBADF for a closed descriptor and one not open for
/// writing; -EINVAL for a negative offset or a length not above 0;
/// -ESPIPE for a pipe; -ENODEV for what is no file; -EFBIG past the
/// largest file. px49 (pax#63): the modes as Linux serves them on tmpfs
/// (measured, notes/px49-the-small-gaps.md §G): FALLOC_FL_KEEP_SIZE
/// (1), the size kept (and nothing set aside); FALLOC_FL_PUNCH_HOLE with
/// it (3), the range inside the size reads as zero; each takes the
/// set-ID bits as a write does, past the end too. Every other mode,
/// PUNCH_HOLE alone, ZERO_RANGE, COLLAPSE_RANGE, INSERT_RANGE,
/// UNSHARE_RANGE, a mix or an unknown bit: -EOPNOTSUPP, Linux's answer
/// (no longer refused by name).
pub fn fallocate(a: u64, fd: u64, mode: u64, off: u64, len: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if off >= 0x8000000000000000 || len == 0 || len >= 0x8000000000000000 {
        return neg(EINVAL)
    }
    if access(a, fd) == O_RDONLY || k == K_DIR {
        return neg(EBADF)
    }
    if k == K_PIPE {
        return neg(ESPIPE)
    }
    if k != K_FILE {
        return neg(ENODEV)
    }
    let m = mode & 0xffffffff
    if m != 0 && m != FALLOC_KEEP && m != FALLOC_KEEP | FALLOC_PUNCH {
        return neg(EOPNOTSUPP)
    }
    let i = rf(node_of(a, fd))
    if len > 0x7fffffffffffffff - off {
        return neg(EFBIG)
    }
    if m == FALLOC_KEEP | FALLOC_PUNCH {
        tree.punch(i, off, len)
    } else if m == 0 && off + len > tree.bytes(i) {
        let r = tree.truncate(i, off + len)
        if r != 0 {
            return r
        }
    }
    wrote(a, i)
    0
}

const FALLOC_KEEP: u64 = 0x1 // uapi linux/falloc.h's FALLOC_FL_KEEP_SIZE
const FALLOC_PUNCH: u64 = 0x2 // FALLOC_FL_PUNCH_HOLE

/// px27: `truncate(path, len)`: as `ftruncate` for the file the path
/// names: -EISDIR for a directory, -EINVAL for what is no file; px43:
/// -EACCES unless the class rule gives write (`ftruncate` asks only
/// that its descriptor was opened for writing).
pub fn truncate(a: u64, pml4: u64, va: u64, len: u64) -> u64 {
    let n = resolve(a, pml4, AT_FDCWD, va, false, F_YES)
    if is_err(n) {
        return neg(rf(n))
    }
    if is_dir_node(n) {
        return neg(EISDIR)
    }
    if ty(n) != T_INO || !tree.is_regular(rf(n)) || len >= 0x8000000000000000 {
        return neg(EINVAL) // px62: a FIFO's or a socket's name is no file to cut
    }
    if !may(a, cred.FS, n, MAY_W) {
        return neg(EACCES) // px43: the class's write bit
    }
    if running(n) {
        return neg(ETXTBSY) // px56 (pax#95): a running program's file (measured)
    }
    let r = resize(rf(n), len)
    if r == 0 {
        wrote(a, rf(n)) // px44
    }
    r
}

/// px27: `fsync(fd)` and `fdatasync(fd)`: 0 for a file or a directory
/// (the tree is memory: what was written is as kept as it will ever
/// be), -EBADF for a closed descriptor, -EINVAL for what cannot be
/// synchronised (a pipe, a socket, the console: `fsync(2)`).
pub fn fsync(a: u64, fd: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k == K_FILE || k == K_DIR {
        let n = node_of(a, fd)
        return if ty(n) == T_INO { tree.sync_of(rf(n)) } else { 0 } // px63: a volume's blocks written, its disk flushed
    }
    if k == K_BLK {
        // px79: a node's writes are on the device when they return; what
        // the cache holds of it is written, then the disk flushed (measured:
        // 0, opened read-only too)
        let d = blk_dev(node_of(a, fd))
        return if d == block.DEVS { neg(ENXIO) } else { block.sync(d) }
    }
    neg(EINVAL)
}

/// px63: `syncfs(fd)` (`syncfs(2)`): the file system the descriptor's
/// file is in written (a volume: every dirty block, then a FLUSH; the
/// tree: nothing to write): 0, -EBADF, -EIO. Any open descriptor names a
/// file system (a pipe's, a socket's: 0).
pub fn syncfs(a: u64, fd: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    let n = node_of(a, fd)
    if (k == K_FILE || k == K_DIR) && ty(n) == T_INO {
        return tree.sync_of(rf(n))
    }
    0
}

// px63: statfs's numbers (uapi linux/magic.h; asm-generic/statfs.h's
// `struct statfs`, 120 bytes on x86-64).
const EXT2_SUPER_MAGIC: u64 = 0xef53
const TMPFS_MAGIC: u64 = 0x01021994
const PROC_SUPER_MAGIC: u64 = 0x9fa0
const SYSFS_MAGIC: u64 = 0x62656572
const ST_RDONLY: u64 = 1
const ST_VALID: u64 = 0x20
const ST_RELATIME: u64 = 0x1000

/// Write `struct statfs` for node `n` at user `buf`: an ext2 volume's
/// counts (kernel/ext2's superblock: blocks, free, a user's free, inodes,
/// free inodes, the UUID as the fsid, names of 255 bytes), the tree's
/// tmpfs numbers (the frames it may hold, those held, the inodes), or
/// /proc's and /sys's and /dev's magic with zero counts.
fn put_statfs(pml4: u64, buf: u64, n: u64) -> u64 {
    if !uaccess.writable(pml4, buf, 120) {
        return neg(EFAULT)
    }
    uaccess.zero(pml4, buf, 120)
    var flags = ST_VALID | ST_RELATIME
    if ty(n) == T_INO && tree.on_volume(rf(n)) {
        let i = rf(n)
        uaccess.put(pml4, buf, EXT2_SUPER_MAGIC, 8)
        uaccess.put(pml4, buf + 8, tree.vol_statfs(i, 0), 8)
        uaccess.put(pml4, buf + 16, tree.vol_statfs(i, 1), 8)
        uaccess.put(pml4, buf + 24, tree.vol_statfs(i, 2), 8)
        uaccess.put(pml4, buf + 32, tree.vol_statfs(i, 3), 8)
        uaccess.put(pml4, buf + 40, tree.vol_statfs(i, 4), 8)
        uaccess.put(pml4, buf + 48, tree.vol_statfs(i, 5), 8)
        uaccess.put(pml4, buf + 56, tree.vol_statfs(i, 6), 4)
        uaccess.put(pml4, buf + 60, tree.vol_statfs(i, 7), 4)
        uaccess.put(pml4, buf + 72, tree.vol_statfs(i, 0), 8)
        if tree.read_only(i) {
            flags = flags | ST_RDONLY
        }
    } else if ty(n) == T_INO {
        let cap = tree.cap()
        let held = tree.held()
        uaccess.put(pml4, buf, TMPFS_MAGIC, 8)
        uaccess.put(pml4, buf + 8, PAGE, 8)
        uaccess.put(pml4, buf + 16, cap, 8)
        uaccess.put(pml4, buf + 24, if cap > held { cap - held } else { 0 }, 8)
        uaccess.put(pml4, buf + 32, if cap > held { cap - held } else { 0 }, 8)
        uaccess.put(pml4, buf + 40, tree.MAX_INODES, 8)
        uaccess.put(pml4, buf + 48, tree.MAX_INODES - tree.live(), 8)
        uaccess.put(pml4, buf + 72, PAGE, 8)
    } else {
        let t = ty(n)
        uaccess.put(pml4, buf, if t == T_SYN { if procfs.fs(rf(n)) == 0 { PROC_SUPER_MAGIC } else { SYSFS_MAGIC } } else { TMPFS_MAGIC }, 8)
        uaccess.put(pml4, buf + 8, PAGE, 8)
        uaccess.put(pml4, buf + 72, PAGE, 8)
    }
    uaccess.put(pml4, buf + 64, 255, 8) // f_namelen
    uaccess.put(pml4, buf + 80, flags, 8)
    0
}

/// px63: `statfs(path, buf)` (`statfs(2)`): the path's own errors, then
/// the file system it is in.
pub fn statfs(a: u64, pml4: u64, va: u64, buf: u64) -> u64 {
    let n = resolve(a, pml4, AT_FDCWD, va, false, F_YES)
    if is_err(n) {
        return neg(rf(n))
    }
    put_statfs(pml4, buf, n)
}

/// px63: `fstatfs(fd, buf)`.
pub fn fstatfs(a: u64, pml4: u64, fd: u64, buf: u64) -> u64 {
    if kind(a, fd) == K_CLOSED {
        return neg(EBADF)
    }
    put_statfs(pml4, buf, stat_node(a, fd))
}

/// `ioctl(fd, request, arg)`: -EBADF for a closed descriptor; on the
/// console, kernel/console's answer (px13: the terminal ioctls once the
/// console is started, `console.REFUSED` for a request it refuses by
/// name, -ENOTTY for everything before); -ENOTTY on anything else
/// (a file, a directory, /dev/null), as Linux answers for a descriptor
/// that is not a terminal.
pub fn ioctl(a: u64, pml4: u64, fd: u64, req: u64, arg: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k == K_CONSOLE {
        return console.ioctl(a, pml4, req, arg)
    }
    if k == K_BLK {
        return blk_ioctl(a, pml4, fd, req, arg) // px79
    }
    if k == K_DSP {
        // px30: OSS's requests (kernel/sound); SNDCTL_DSP_NONBLOCK sets
        // the open file's O_NONBLOCK here.
        let r = sound.ioctl(pml4, req, arg)
        if r == 0 && req == 0x500e {
            set_nonblocking(a, fd, true)
        }
        return r
    }
    if req == FIONBIO && (k == K_INET || k == K_TCP || k == K_UNIX || k == K_SOCK) {
        // px23: what wolf's runtime does to every socket it makes.
        if !uaccess.readable(pml4, arg, 4) {
            return neg(EFAULT)
        }
        set_nonblocking(a, fd, uaccess.get(pml4, arg, 4) != 0)
        return 0
    }
    neg(ENOTTY)
}

/// px56 (pax#95): whether some open file has node `n` (a file of the
/// tree) open for writing: `execve` of it is then -ETXTBSY (`execve(2)`,
/// measured on Linux 7.2.8).
fn has_writer(n: u64) -> bool {
    var i: u64 = 0
    while i < OFILES {
        if ofw(i, O_REFS) != 0 && ofw(i, O_KIND) == K_FILE && ofw(i, O_NODE) == n && ofw(i, O_FLAGS) & O_ACCMODE != O_RDONLY {
            return true
        }
        i += 1
    }
    false
}

/// px56 (pax#95): whether node `n` is a file a running program was
/// loaded from (`tree.running`): opening it for writing, or `truncate`
/// of it, is then -ETXTBSY (`open(2)`, `truncate(2)`, measured).
fn running(n: u64) -> bool {
    ty(n) == T_INO && tree.running(rf(n)) != 0
}

/// px56 (pax#95, #96): what `execve` (and `execveat`) runs: the file
/// at the user path `va` from `dirfd` (`flags`: AT_EMPTY_PATH, the
/// descriptor itself for an empty path; AT_SYMLINK_NOFOLLOW, a last
/// link refused), or (`va` 0) at the kernel path pax_kbuf[0..rl), a
/// `#!` line's interpreter, from the working directory. The walk's
/// answers first (-ENOENT, -ENOTDIR, -ENAMETOOLONG, -ELOOP, and -EACCES
/// for a directory that may not be searched: px43); then -ELOOP for a
/// last link not followed; -EACCES for what is no regular file of the
/// tree (a directory, a device, a file of /proc, a socket's name); the
/// class's execute bit (px43: root's is any of the three; set-ID bits
/// are not honoured, ruling #75 R5); -ETXTBSY while it is open for
/// writing; then an open file of it (-ENFILE when the table is full),
/// O_RDONLY and O_EXE, the directory it was found in recorded (px50's
/// rules: the descriptor's own when it was reached through an fd/ entry
/// or AT_EMPTY_PATH), so `/proc/self/exe` reads its path as an fd/ entry
/// would, a rename and a removal followed. The open file counts itself a
/// runner of the inode (`tree.run_hold`). Returns (the open file + 1, 0)
/// or (0, -errno). The caller reads the file through `exec_inode` and
/// either makes it the process's (`set_exe`) or lets it go
/// (`exec_drop`). px27's limit (only an archive file, whole) is gone:
/// a program written, copied, rewritten or unlinked while open since
/// boot runs as Linux runs it.
pub fn exec_open(a: u64, pml4: u64, dirfd: u64, va: u64, rl: u64, flags: u64) -> (u64, u64) {
    let empty = flags & AT_EMPTY_PATH != 0
    let fl = if flags & AT_SYMLINK_NOFOLLOW != 0 { F_NO } else { F_YES }
    var n: u64 = 0
    var par: u64 = 0
    if va != 0 {
        let (n0, p0, _s, _l, _t) = walk(a, pml4, dirfd, va, empty, fl)
        n = n0
        par = p0
    } else {
        let (n0, p0, _s, _l, _t) = walk_k(a, AT_FDCWD, rl, empty, F_YES) // an empty name: the working directory (measured)
        n = n0
        par = p0
    }
    let (via, sa, sf) = fdl_read()
    if is_err(n) {
        return (0, neg(rf(n)))
    }
    if is_link_node(n) || is_fd_entry(n) {
        return (0, neg(ELOOP)) // AT_SYMLINK_NOFOLLOW at a link (execveat(2))
    }
    if ty(n) != T_INO || !tree.is_regular(rf(n)) {
        return (0, neg(EACCES))
    }
    if !may(a, cred.FS, n, MAY_X) {
        return (0, neg(EACCES)) // px43: the class's execute bit (root: any)
    }
    if has_writer(n) {
        return (0, neg(ETXTBSY))
    }
    if !of_room() {
        return (0, neg(ENFILE))
    }
    let o = of_new(K_FILE, n, O_RDONLY | O_EXE)
    tree.run_hold(rf(n))
    var src: u64 = 0
    if via {
        src = of_of(sa, sf) // reached through an fd/ entry: its open file's directory
    } else if va != 0 && empty && dirfd != AT_FDCWD && is_err(par) && rf(par) == EBUSY {
        src = of_of(a, dirfd) // AT_EMPTY_PATH: the descriptor's own
    }
    opened_in(o, src, if !is_err(par) && ty(par) == T_INO { rf(par) + 1 } else { 0 })
    (o, 0)
}

/// px56: the inode an `exec_open` open file is of.
pub fn exec_inode(o: u64) -> u64 {
    rf(ofw(o - 1, O_NODE))
}

/// px56: whether descriptor `fd` is open with close-on-exec (execveat's
/// script by a descriptor the new program will not have).
pub fn is_cloexec(a: u64, fd: u64) -> bool {
    kind(a, fd) != K_CLOSED && flags_of(a, fd) & O_CLOEXEC != 0
}

/// px56: the name `execveat(fd, "", AT_EMPTY_PATH)` gives a program
/// (measured on Linux 7.2.8: the file's own name, not the descriptor's
/// number): the last component of what its open file `o` reads as a
/// link, ` (deleted)` left off, its first 15 bytes as two words and
/// its length (kernel/process's `comm_of`'s shape).
pub fn exe_name(o: u64) -> (u64, u64, u64) {
    let cap = KBUF_END - NORM
    var l = ino_text(o, exec_inode(o), raw() + NORM, cap)
    if l > cap {
        l = cap
    }
    let gone = ofw(o - 1, O_GONE) != 0
    if gone && l >= 10 { // ` (deleted)`
        l -= 10
    }
    var base: u64 = 0
    var i: u64 = 0
    while i < l {
        if kb(NORM + i) == 47 {
            base = i + 1
        }
        i += 1
    }
    var n = l - base
    if n > 15 {
        n = 15
    }
    var w0: u64 = 0
    var w1: u64 = 0
    var k: u64 = 0
    while k < n {
        let b = kb(NORM + base + k)
        if k < 8 {
            w0 = w0 | (b << (k * 8))
        } else {
            w1 = w1 | (b << ((k - 8) * 8))
        }
        k += 1
    }
    (w0, w1, n)
}

/// px56: an `exec_open` open file not taken (a script's, once its
/// interpreter is found; one refused later): let go.
pub fn exec_drop(o: u64) {
    of_drop(o)
}

/// px56: a program the kernel starts (kernel/process's `exec_span`: init
/// and the run list, absolute paths of PAX's own): the file at the path
/// [pa, pa + pl) looked up in the tree from the root, a name at a time,
/// no mode asked (as px10's archive lookup asked none), no link
/// followed. Its open file as `exec_open` makes one: (the open file +
/// 1, 0), or (0, 1) for a path that is not a regular file of the tree.
pub fn exec_kernel(pa: u64, pl: u64) -> (u64, u64) {
    var d = tree.top() // px67: `/`, on the disk when it is there
    var i: u64 = 0
    var found = tree.NONE
    while i < pl {
        while i < pl && byte_at(pa, i) == 47 {
            i += 1
        }
        if i >= pl {
            break
        }
        let s = i
        while i < pl && byte_at(pa, i) != 47 {
            i += 1
        }
        if !tree.is_dir(d) {
            return (0, 1)
        }
        let c = tree.lookup(d, pa + s, i - s)
        if c == tree.NONE {
            return (0, 1)
        }
        var j = i
        while j < pl && byte_at(pa, j) == 47 {
            j += 1
        }
        if j >= pl {
            found = c
        } else {
            d = c
        }
    }
    if found == tree.NONE || !tree.is_regular(found) || !of_room() {
        return (0, 1)
    }
    let n = ino_node(found)
    let o = of_new(K_FILE, n, O_RDONLY | O_EXE)
    tree.run_hold(found)
    opened_in(o, 0, d + 1)
    (o, 0)
}

fn byte_at(p: u64, i: u64) -> u64 {
    // # Safety: a byte of the caller's kernel path (pax_execbuf, the run
    // list's line in the initramfs).
    unsafe { ((p + i) as *u8).read_volatile() as u64 }
}

/// The working directory's node (px17): the area's word, 0 the root.
fn cwd(a: u64) -> u64 {
    let c = get(a, A_CWD)
    if c == 0 {
        return root_node()
    }
    c
}

/// The working directory becomes node `n`; px27: the process holds the
/// inode (a directory removed under it lives on, empty, until it
/// leaves) and lets go of the one it had.
fn set_cwd(a: u64, n: u64) {
    if ty(n) == T_INO {
        tree.hold(rf(n))
    }
    let old = get(a, A_CWD)
    put(a, A_CWD, n)
    if ty(old) == T_INO {
        tree.release(rf(old))
    }
}

/// `getcwd(buf, size)` (px17: the process's working directory; "/" until
/// a `chdir`): the path and a NUL at `buf`, the length with the NUL;
/// -ERANGE when `size` is smaller. px27: the path is found by walking up
/// (each directory knows its parent, and the parent the name it gives
/// it), so a directory that was moved answers where it is now; one
/// that was removed is -ENOENT (`getcwd(3)`).
pub fn getcwd(a: u64, pml4: u64, buf: u64, size: u64) -> u64 {
    let c = cwd(a)
    var at = KBUF_END // the path is built backwards in pax_kbuf's second half
    if ty(c) == T_DEV {
        at -= 4
        put_kb(at, 47)
        put_kb(at + 1, 100)
        put_kb(at + 2, 101)
        put_kb(at + 3, 118)
    } else {
        var d = rf(c)
        if tree.nlink(d) == 0 {
            return neg(ENOENT)
        }
        let top = tree.top() // px67: `/`, on the disk when it is there
        while d != top {
            let p = tree.parent(d)
            let (na, nl) = tree.name_of(p, d)
            if na == 0 || p == d || at < NORM + nl + 1 {
                return neg(ENOENT)
            }
            at -= nl
            var k: u64 = 0
            while k < nl {
                // # Safety: a byte of a directory record's name (kernel/tree's `name_of`).
                put_kb(at + k, unsafe { ((na + k) as *u8).read_volatile() as u64 })
                k += 1
            }
            at -= 1
            put_kb(at, 47)
            d = p
        }
        if at == KBUF_END {
            at -= 1
            put_kb(at, 47)
        }
    }
    let l = KBUF_END - at
    if size < l + 1 {
        return neg(ERANGE)
    }
    if !uaccess.copy_out(pml4, buf, raw() + at, l) {
        return neg(EFAULT)
    }
    if !uaccess.writable(pml4, buf + l, 1) {
        return neg(EFAULT)
    }
    uaccess.put(pml4, buf + l, 0, 1)
    l + 1
}

/// px17: `chdir(path)`: the working directory becomes the directory the
/// path names (-ENOENT, -ENOTDIR, the path's own errors).
pub fn chdir(a: u64, pml4: u64, va: u64) -> u64 {
    let n = resolve(a, pml4, AT_FDCWD, va, false, F_YES)
    if is_err(n) {
        return neg(rf(n))
    }
    if !is_dir_node(n) {
        return neg(ENOTDIR)
    }
    if !may(a, cred.FS, n, MAY_X) {
        return neg(EACCES) // px43: the directory itself is searched
    }
    set_cwd(a, n)
    0
}

/// px45: what `chroot(path)` finds before it asks who the caller is
/// (measured on Linux: a missing directory -ENOENT and a file -ENOTDIR
/// to a user too): 0 and whether the directory is the tree's root, or
/// -errno — the walk's answers, -ENOTDIR, and -EACCES when the
/// directory may not be searched (as `chdir`; inferred, not measured).
pub fn chroot_dir(a: u64, pml4: u64, va: u64) -> (u64, bool) {
    let n = resolve(a, pml4, AT_FDCWD, va, false, F_YES)
    if is_err(n) {
        return (neg(rf(n)), false)
    }
    if !is_dir_node(n) {
        return (neg(ENOTDIR), false)
    }
    if !may(a, cred.FS, n, MAY_X) {
        return (neg(EACCES), false)
    }
    (0, n == root_node())
}

// px67: mount(2) and umount2(2) for root (uapi linux/mount.h's numbers;
// mount(2), umount2(2)). A user is -EPERM first (kernel/process's
// `root_call`, px45's rows), and umount2's path before that.
const MS_RDONLY: u64 = 1
const MS_NOSUID: u64 = 2
const MS_NODEV: u64 = 4
const MS_NOEXEC: u64 = 8
const MS_REMOUNT: u64 = 32
const MS_BIND: u64 = 4096
const MS_MOVE: u64 = 8192
const MS_PROPAGATION: u64 = 0x1e0000 // MS_UNBINDABLE, MS_PRIVATE, MS_SLAVE, MS_SHARED
const MS_MGC_VAL: u64 = 0xc0ed0000
const MNT_FLAGS: u64 = 15 // MNT_FORCE, MNT_DETACH, MNT_EXPIRE, UMOUNT_NOFOLLOW
const MNT_DETACH: u64 = 2
const UMOUNT_NOFOLLOW: u64 = 8
/// kernel/process's R_MOUNT (its text): a mount PAX does not make.
const R_MOUNT: u64 = 48

fn mh_of(fl: u64) -> u64 {
    var h: u64 = 0
    if fl & MS_NOSUID != 0 {
        h = h | tree.MH_NOSUID
    }
    if fl & MS_NODEV != 0 {
        h = h | tree.MH_NODEV
    }
    if fl & MS_NOEXEC != 0 {
        h = h | tree.MH_NOEXEC
    }
    h
}

/// px67: whether an open file of a volume (its store, kernel/tree's
/// `store`) is open for writing: a remount read-only is -EBUSY then
/// (measured on Linux 7.2.8: tests/mpx6-root.d/linux/).
fn writer_on(store: u64) -> bool {
    var i: u64 = 0
    while i < OFILES {
        let n = ofw(i, O_NODE)
        if ofw(i, O_REFS) != 0 && ofw(i, O_KIND) == K_FILE && ty(n) == T_INO && tree.store(rf(n)) == store && ofw(i, O_FLAGS) & O_ACCMODE != O_RDONLY {
            return true
        }
        i += 1
    }
    false
}

/// px67: the mount node `t` is the root of (a node of the tree's), or
/// tree.NONE.
fn mount_at(t: u64) -> u64 {
    if ty(t) != T_INO {
        return tree.NONE
    }
    tree.mount_of_root(rf(t))
}

/// px67: MS_REMOUNT of the mount whose root node `t` is: -EINVAL for a
/// directory that is no mount's root (measured: `/etc`); read-only while
/// a file of the volume is open for writing -EBUSY (measured); else
/// kernel/tree's `remount`, the flags MS_NOSUID, MS_NODEV, MS_NOEXEC
/// kept for /proc/self/mounts' line. The kernel's own trees (/dev,
/// /proc, /sys) and the memory's root on the ISO way have no read-only
/// form here: refused by name, -EINVAL.
fn remount_at(a: u64, t: u64, fl: u64) -> u64 {
    let m = mount_at(t)
    if m == tree.NONE {
        if mount_root(t) || (ty(t) == T_INO && rf(t) == tree.top()) {
            refuse(a, R_MOUNT)
        }
        return neg(EINVAL)
    }
    let ro = fl & MS_RDONLY != 0
    let v = tree.mounted(m)
    if v == tree.NONE {
        if ro {
            refuse(a, R_MOUNT)
            return neg(EINVAL)
        }
        return 0
    }
    if ro && writer_on(v + 1) {
        return neg(EBUSY)
    }
    let e = tree.remount(m, ro)
    if e != 0 {
        return e
    }
    tree.set_how(m, mh_of(fl) | (tree.mount_how(m) & tree.MH_SYNC))
    0
}

/// px67: whether the `n` bytes at kernel address `p` are `s`.
fn bytes_are(p: u64, n: u64, s: str) -> bool {
    var k: u64 = 0
    for b in s.bytes() {
        // # Safety: a byte of the frame `mount_call` read the string into.
        if k >= n || unsafe { ((p + k) as *u8).read_volatile() as u64 } != b as int as u64 {
            return false
        }
        k += 1
    }
    k == n
}

/// px67: `mount(source, target, filesystemtype, mountflags, data)` for
/// root (`mount(2)`), the answers the Linux guest gave
/// (tests/mpx6-root.d/linux/): the target first (its walk's errors);
/// MS_REMOUNT then remounts it (`remount_at`); a bind, a move or a
/// propagation change is refused by name, -EINVAL; a target that is no
/// directory -ENOTDIR; the type `ext2` (a volume) or `tmpfs` (a
/// directory of the memory's, R-px67-1), any other -ENODEV (`proc`,
/// `sysfs` and `devtmpfs`, mounted once at boot here, refused by name,
/// -EINVAL); the source of an ext2 mount is walked (px79: a block
/// device's node, by any path to it, is its disk or partition, as Linux
/// opens the node; px67's names before /dev had nodes are gone):
/// -ENOTBLK for what is there and is no block device, its walk's error
/// (-ENOENT) for what is not; then kernel/tree's `mount` (-EBUSY on a mount's root, a
/// volume mounted already, a covered directory). MS_RDONLY mounts it
/// read-only; MS_NOSUID, MS_NODEV, MS_NOEXEC are kept for its line, not
/// acted on (as kernel/fstab's). `data` is not read.
pub fn mount_call(a: u64, pml4: u64, src: u64, tgt: u64, typ: u64, flags: u64, data: u64) -> u64 {
    let _unused = data
    var fl = flags & 0xffffffff
    if fl & 0xffff0000 == MS_MGC_VAL {
        fl = fl & 0xffff // mount(2): the old magic in the top half, ignored
    }
    let t = resolve(a, pml4, AT_FDCWD, tgt, false, F_YES)
    if is_err(t) {
        return neg(rf(t))
    }
    if fl & MS_REMOUNT != 0 {
        return remount_at(a, t, fl)
    }
    if fl & (MS_BIND | MS_MOVE | MS_PROPAGATION) != 0 {
        refuse(a, R_MOUNT)
        return neg(EINVAL)
    }
    if !is_dir_node(t) {
        return neg(ENOTDIR)
    }
    let f = frames.alloc() else 0
    if f == 0 {
        return neg(ENOMEM)
    }
    let fb = f + frames.hhdm()
    let tl = uaccess.string_in(pml4, typ, fb, 63)
    var r: u64 = 0
    if tl >= 64 {
        r = neg(if tl == 65 { EFAULT } else { ENODEV })
    } else if bytes_are(fb, tl, "tmpfs") {
        if ty(t) != T_INO {
            refuse(a, R_MOUNT)
            r = neg(EINVAL)
        } else {
            let m = tree.mount_mem(rf(t), 0x3ff)
            if tree.failed(m) {
                r = m
            } else {
                tree.set_how(m, mh_of(fl))
                tree.set_mode_of(m, 0x3ff)
            }
        }
    } else if bytes_are(fb, tl, "proc") || bytes_are(fb, tl, "sysfs") || bytes_are(fb, tl, "devtmpfs") {
        refuse(a, R_MOUNT)
        r = neg(EINVAL)
    } else if !bytes_are(fb, tl, "ext2") && !bytes_are(fb, tl, "ext3") {
        r = neg(ENODEV)
    } else {
        // px68: `ext3` names a journalled volume (one without a journal is
        // refused, -EINVAL, as Linux 7.3.0's `couldn't mount as ext3`);
        // `ext2` mounts either, its journal still used (measured).
        let t3 = bytes_are(fb, tl, "ext3")
        let sb = fb + 128
        let sl = uaccess.string_in(pml4, src, sb, PATH_MAX)
        if sl > PATH_MAX {
            r = neg(if sl == PATH_MAX + 2 { EFAULT } else { ENAMETOOLONG })
        } else {
            // px79: the source is walked: a block device's node (any path
            // to one) is the device; what is no block device -ENOTBLK, what
            // is not there its walk's error (measured: `vdb2` from / -ENOENT,
            // /dev/null -ENOTBLK, /dev/vdz -ENOENT)
            let sn = resolve(a, pml4, AT_FDCWD, src, false, F_YES)
            let dev = if !is_err(sn) && ty(sn) == T_BLK { blk_dev(sn) } else { block.DEVS }
            if is_err(sn) {
                r = neg(rf(sn))
            } else if ty(sn) != T_BLK {
                r = neg(ENOTBLK)
            } else if dev == block.DEVS {
                r = neg(ENXIO)
            } else if ty(t) != T_INO {
                refuse(a, R_MOUNT)
                r = neg(EINVAL)
            } else if t3 && !ext2.has_journal(dev) {
                r = neg(EINVAL)
            } else {
                let m = tree.mount(rf(t), dev, fl & MS_RDONLY != 0, mh_of(fl))
                if tree.failed(m) {
                    r = m
                } else {
                    ext2.ask_type(tree.mounted(m), if t3 { 3 } else { 2 })
                }
            }
        }
    }
    frames.free(f)
    r
}

/// px67: `umount2(target, flags)` for root (`umount2(2)`), the guest's
/// answers: a flag outside MNT_FORCE, MNT_DETACH, MNT_EXPIRE and
/// UMOUNT_NOFOLLOW -EINVAL (measured, before the path); the target's
/// walk's errors (UMOUNT_NOFOLLOW: its last link not followed); a
/// directory that is no mount's root -EINVAL (measured: `/etc`); `/`
/// remounted read-only and 0, as Linux answers an unmount of the root
/// (measured: `re-mounted ro`, then the table says `ro`); MNT_DETACH
/// refused by name (-EINVAL: nothing PAX runs asks for it, px67's
/// census); the kernel's own trees refused by name, -EBUSY; else
/// kernel/tree's `unmount` (-EBUSY while anything of it is held).
pub fn umount_call(a: u64, pml4: u64, tgt: u64, flags: u64) -> u64 {
    let fl = flags & 0xffffffff
    if fl & !MNT_FLAGS != 0 {
        return neg(EINVAL)
    }
    let t = resolve(a, pml4, AT_FDCWD, tgt, false, if fl & UMOUNT_NOFOLLOW != 0 { F_NO } else { F_YES })
    if is_err(t) {
        return neg(rf(t))
    }
    if mount_root(t) && ty(t) != T_INO {
        refuse(a, R_MOUNT)
        return neg(EBUSY)
    }
    let m = mount_at(t)
    if m == tree.NONE {
        if ty(t) == T_INO && rf(t) == tree.top() {
            return remount_at(a, t, MS_REMOUNT | MS_RDONLY) // the ISO's `/`: refused by name there
        }
        return neg(EINVAL)
    }
    if tree.is_root_mount(m) {
        return remount_at(a, t, MS_REMOUNT | MS_RDONLY)
    }
    if fl & MNT_DETACH != 0 {
        refuse(a, R_MOUNT)
        return neg(EINVAL)
    }
    tree.unmount(m)
}

/// px45: whether a path resolves (`umount2(2)` asks it before who the
/// caller is: measured, a missing path -ENOENT to a user): 0 or the
/// walk's -errno.
pub fn path_found(a: u64, pml4: u64, va: u64) -> u64 {
    let n = resolve(a, pml4, AT_FDCWD, va, false, F_YES)
    if is_err(n) { neg(rf(n)) } else { 0 }
}

/// px17: `fchdir(fd)`: the directory descriptor `fd` names (-EBADF,
/// -ENOTDIR).
pub fn fchdir(a: u64, fd: u64) -> u64 {
    if kind(a, fd) == K_CLOSED {
        return neg(EBADF)
    }
    let n = node_of(a, fd)
    if !is_dir_node(n) {
        return neg(ENOTDIR)
    }
    if !may(a, cred.FS, n, MAY_X) {
        return neg(EACCES) // px43: as `chdir`, whatever the descriptor was opened for
    }
    set_cwd(a, n)
    0
}

/// px26: the running program (kernel/process, at `exec` and `execve`):
/// what `/proc/self/exe` answers. px56: `o` is its open file (+ 1,
/// `exec_open`'s or `exec_kernel`'s), the area's from here; the one it
/// had goes. A fork's child shares it (`inherit`), a process's end lets
/// it go (`close_all`).
pub fn set_exe(a: u64, o: u64) {
    let old = get(a, A_EXE)
    put(a, A_EXE, o)
    of_drop(old)
}

/// `readlinkat(dirfd, path, buf, size)` (and `readlink`, with
/// AT_FDCWD): PAX's tree has one symbolic link, `/proc/self/exe`
/// (px26), whose text is the absolute path of the file the process was
/// loaded from (`proc(5)`; wolf's runtime reads it before `main`, and
/// boreutils' `readlink` prints it): at most `size` bytes, no NUL, the
/// count answered, a longer path cut silently (`readlink(2)`). There is
/// no `/proc` directory beside it: every other path under it is
/// -ENOENT. Anything else that exists is not a link: -EINVAL. (px27:
/// the text is the path the program was loaded by; a program renamed
/// since still answers that. px56: the text is the program's open
/// file's, as an fd/ entry's: a rename is followed, a removal reads
/// `<path> (deleted)`.)
pub fn readlinkat(a: u64, pml4: u64, dirfd: u64, va: u64, buf: u64, size: u64) -> u64 {
    if is_proc_exe(pml4, va) {
        let x = get(a, A_EXE)
        if x == 0 {
            return neg(ENOENT)
        }
        if size == 0 || size >= 0x80000000 {
            return neg(EINVAL)
        }
        // px56: the program's open file's text, as an fd/ entry's: its
        // directory's path and the name it has there now, or `<path>
        // (deleted)` once it has none (measured on Linux 7.2.8).
        let cap = KBUF_END - NORM
        let l = ino_text(x, exec_inode(x), raw() + NORM, cap)
        let lk = if l < cap { l } else { cap }
        let k = if lk < size { lk } else { size }
        if !uaccess.writable(pml4, buf, k) {
            return neg(EFAULT)
        }
        if !uaccess.copy_out(pml4, buf, raw() + NORM, k) {
            return neg(EFAULT)
        }
        return k
    }
    // px36: a link of the tree: its target, at most `size` bytes, no
    // NUL; its atime moved by relatime's rule (measured).
    if size == 0 || size >= 0x80000000 {
        return neg(EINVAL)
    }
    let n = resolve(a, pml4, dirfd, va, false, F_NO)
    if is_err(n) {
        return neg(rf(n))
    }
    if is_fd_entry(n) {
        // px50: an entry of fd/ reads as what its descriptor is open on
        // (`proc_pid_fd(5)`), after ptrace(2)'s read mode.
        let tp = procfs.pid_of(rf(n))
        let ta = pid_area(tp)
        let (_x, fd) = procfs.fd_of(rf(n))
        if ta == 0 || kind(ta, fd) == K_CLOSED {
            return neg(ENOENT)
        }
        if !may_trace(a, ta) {
            return neg(EACCES)
        }
        let cap = KBUF_END - NORM
        let l = fd_text(ta, fd, tp, raw() + NORM, cap)
        let lk = if l < cap { l } else { cap }
        let k = if lk < size { lk } else { size }
        if !uaccess.writable(pml4, buf, k) {
            return neg(EFAULT)
        }
        if !uaccess.copy_out(pml4, buf, raw() + NORM, k) {
            return neg(EFAULT)
        }
        return k
    }
    if !is_link_node(n) {
        return neg(EINVAL)
    }
    // px52: /dev/std*'s target, `/proc/self/fd/N`, as the tree's.
    let k = if link_bytes(n) < size { link_bytes(n) } else { size }
    if !uaccess.writable(pml4, buf, k) {
        return neg(EFAULT)
    }
    link_target(n, raw() + NORM, k)
    if !uaccess.copy_out(pml4, buf, raw() + NORM, k) {
        return neg(EFAULT)
    }
    if ty(n) == T_INO {
        tree.touch_read(rf(n))
    }
    k
}

// --- what a descriptor's link reads (px50) ---------------------------------------

/// px50: byte `b` at kernel address `base + at` when `at < cap`; at + 1.
fn tput(base: u64, at: u64, cap: u64, b: u64) -> u64 {
    if at < cap {
        // # Safety: `base` is pax_kbuf's second half or a frame through
        // the HHDM, `cap` bytes long; at < cap.
        unsafe { ((base + at) as *u8).write_volatile((b & 0xff) as u8) }
    }
    at + 1
}

fn tstr(base: u64, at: u64, cap: u64, t: str) -> u64 {
    var k = at
    for b in t.bytes() {
        k = tput(base, k, cap, b as int as u64)
    }
    k
}

fn tdec(base: u64, at: u64, cap: u64, v: u64) -> u64 {
    var d: u64 = 1
    while v / d >= 10 {
        d *= 10
    }
    var k = at
    while d > 0 {
        k = tput(base, k, cap, 48 + (v / d) % 10)
        d /= 10
    }
    k
}

/// px50: directory inode `d`'s absolute path at `base + at`: the end.
/// Found by walking up, as `getcwd` does (each directory knows its
/// parent, and the parent the name it gives it).
fn tpath(base: u64, at: u64, cap: u64, d: u64) -> u64 {
    let top = tree.top() // px67
    if d == top {
        return tput(base, at, cap, 47)
    }
    var len: u64 = 0
    var x = d
    var up: u64 = 0
    while x != top && up < 2048 {
        let p = tree.parent(x)
        let (_na, nl) = tree.name_of(p, x)
        len += 1 + nl
        x = p
        up += 1
    }
    let end = at + len
    var k = end
    x = d
    up = 0
    while x != top && k > at && up < 2048 {
        let p = tree.parent(x)
        let (na, nl) = tree.name_of(p, x)
        k -= nl
        var j: u64 = 0
        while j < nl {
            // # Safety: a byte of a directory record's name (kernel/tree's `name_of`).
            let _w = tput(base, k + j, cap, unsafe { ((na + j) as *u8).read_volatile() as u64 })
            j += 1
        }
        k -= 1
        let _s = tput(base, k, cap, 47)
        x = p
        up += 1
    }
    end
}

/// px50: the path of /proc or /sys reference `r` at `base + at`, with
/// `/proc/self` written as the process `pid`'s number (Linux's
/// `/proc/self` is a link to it, so what was opened through it reads as
/// `/proc/<pid>/…`: measured).
fn syn_text(r: u64, pid: u64, base: u64, at: u64, cap: u64) -> u64 {
    let p = procfs.parent(r)
    var k = at
    if p != procfs.ROOT {
        k = syn_text(p, pid, base, k, cap)
    }
    k = tput(base, k, cap, 47)
    if procfs.entry(r) == 1 && procfs.pid_of(r) == 0 {
        return tdec(base, k, cap, pid)
    }
    let nl = procfs.name_len(r)
    var j: u64 = 0
    while j < nl {
        k = tput(base, k, cap, procfs.name_byte(r, j))
        j += 1
    }
    k
}

/// px50: what `/proc/<pid>/fd/<fd>` reads (`proc_pid_fd(5)`, measured on
/// Linux 7.2.8), process `ta`'s descriptor `fd` (of process `pid`), at
/// `base`: its length. A file: the directory it was opened in and the
/// name that directory gives it now (a rename is followed; a removed
/// name reads `<path> (deleted)`, kept when it went: `mark_gone`); a
/// directory: its path; /dev's nodes their names (the console as a
/// process starts with it is `/dev/ttyS0`, the serial port it is: its
/// numbers, 4:64); a pipe's end `pipe:[<st_ino>]`, every socket
/// `socket:[<st_ino>]`, an eventfd `anon_inode:[eventfd]`, an epoll
/// object `anon_inode:[eventpoll]`; a /proc or /sys file its path.
fn fd_text(ta: u64, fd: u64, pid: u64, base: u64, cap: u64) -> u64 {
    let nd = node_of(ta, fd)
    let t = ty(nd)
    let o = of_of(ta, fd)
    if t == T_INO {
        return ino_text(o, rf(nd), base, cap)
    }
    if t == T_DEV {
        return tstr(base, 0, cap, "/dev")
    }
    if t == T_CONSOLE {
        let r = rf(nd)
        let nm = if r == TTY0 { "/dev/tty0" } else if r == CONSOLE { "/dev/console" } else if r == TTY { "/dev/tty" } else { "/dev/ttyS0" }
        return tstr(base, 0, cap, nm)
    }
    if t == T_NULL || t == T_DSP {
        let k = tstr(base, 0, cap, "/dev/")
        return tstr(base, k, cap, fixed_name(nd))
    }
    if t == T_BLK {
        let k = tstr(base, 0, cap, "/dev/")
        return block.name_into(rf(nd) & 0xffff, base, k, cap) // px79
    }
    if t == T_PIPE || t == T_SOCK || t == T_INET || t == T_TCP || t == T_UNIX {
        var k = tstr(base, 0, cap, if t == T_PIPE { "pipe:[" } else { "socket:[" })
        k = tdec(base, k, cap, n_ino(nd))
        return tput(base, k, cap, 93)
    }
    if t == T_EVENT {
        return tstr(base, 0, cap, "anon_inode:[eventfd]")
    }
    if t == T_EPOLL {
        return tstr(base, 0, cap, "anon_inode:[eventpoll]")
    }
    if t == T_SYN {
        return syn_text(rf(nd), pid, base, 0, cap)
    }
    tstr(base, 0, cap, "/")
}

/// px50: the text of inode `i`'s link through open file `o` (+ 1; 0
/// none): a file's directory and the name it gives the file now, or
/// `<path> (deleted)`; a directory's path. px56: `fd_text`'s, and
/// `/proc/self/exe`'s through the program's open file.
fn ino_text(o: u64, i: u64, base: u64, cap: u64) -> u64 {
    let fk = if o != 0 { ofw(o - 1, O_KIND) } else { K_CLOSED }
    let g = if fk == K_FILE || fk == K_DIR { ofw(o - 1, O_GONE) } else { 0 }
    if g != 0 {
        // # Safety: the frame `mark_gone` filled: its length, then its bytes.
        let l = unsafe { ((g + frames.hhdm()) as *u64).read_volatile() }
        var j: u64 = 0
        while j < l {
            let _w = tput(base, j, cap, unsafe { ((g + frames.hhdm() + 8 + j) as *u8).read_volatile() as u64 })
            j += 1
        }
        return l
    }
    if tree.is_dir(i) {
        return tpath(base, 0, cap, i)
    }
    let di = if fk == K_FILE { ofw(o - 1, O_DIRI) } else { 0 }
    if di == 0 {
        return tput(base, 0, cap, 47) // named: a file whose directory was not kept (none is opened so)
    }
    var k: u64 = 0
    if di - 1 != tree.top() {
        k = tpath(base, 0, cap, di - 1)
    }
    k = tput(base, k, cap, 47)
    let (na, nl) = tree.name_of(di - 1, i)
    var j: u64 = 0
    while j < nl {
        // # Safety: a byte of a directory record's name.
        k = tput(base, k, cap, unsafe { ((na + j) as *u8).read_volatile() as u64 })
        j += 1
    }
    k
}

/// px50: once the last name of inode `child` (the name [na, na + nl) of
/// pax_kbuf in directory `par`) is gone, every open file of it keeps
/// what its link reads, `<path> (deleted)` (measured), in a frame of its
/// own (given back at its last close).
fn mark_gone(par: u64, child: u64, na: u64, nl: u64) {
    if tree.nlink(child) != 0 {
        return
    }
    var i: u64 = 0
    while i < OFILES {
        let k = ofw(i, O_KIND)
        if ofw(i, O_REFS) != 0 && (k == K_FILE || k == K_DIR) && ofw(i, O_NODE) == ino_node(child) && ofw(i, O_GONE) == 0 {
            let f = frames.alloc() else 0
            if f != 0 {
                let base = f + frames.hhdm() + 8
                let cap = PAGE - 8
                var t: u64 = 0
                if par != tree.top() {
                    t = tpath(base, 0, cap, par)
                }
                t = tput(base, t, cap, 47)
                var j: u64 = 0
                while j < nl {
                    t = tput(base, t, cap, kb(na + j))
                    j += 1
                }
                t = tstr(base, t, cap, " (deleted)")
                // # Safety: the frame's first word, through the HHDM.
                unsafe { ((f + frames.hhdm()) as *u64).write_volatile(if t < cap { t } else { cap }) }
                put_ofw(i, O_GONE, f)
            }
        }
        i += 1
    }
}

/// px50: a file renamed from directory `od` to `nd`: its open files that
/// were opened in `od` are now in `nd` (what their links read follows).
fn moved(file: u64, od: u64, nd: u64) {
    if od == nd {
        return
    }
    var i: u64 = 0
    while i < OFILES {
        if ofw(i, O_REFS) != 0 && ofw(i, O_KIND) == K_FILE && ofw(i, O_NODE) == ino_node(file) && ofw(i, O_DIRI) == od + 1 {
            tree.hold(nd)
            put_ofw(i, O_DIRI, nd + 1)
            tree.release(od)
        }
        i += 1
    }
}

// --- making, removing and renaming (px27) ----------------------------------------

/// `mkdirat(dirfd, path, mode)` (and `mkdir`, with AT_FDCWD): a new,
/// empty directory, its permission bits `mode & ~umask & 0777`. -EEXIST
/// for a name that leads anywhere (a file, a directory, `.`, `/`,
/// `/dev`), -ENOENT for a missing directory on the way or one that has
/// been removed, -ENOTDIR for a file on the way, -ENOSPC; in `/dev`
/// refused by name, -EROFS.
pub fn mkdirat(a: u64, pml4: u64, dirfd: u64, va: u64, mode: u64) -> u64 {
    let (n, par, ns, nl, _trail) = walk(a, pml4, dirfd, va, false, F_NEVER)
    if !is_err(n) {
        return neg(EEXIST)
    }
    if rf(n) != ENOENT || is_err(par) {
        return neg(rf(n))
    }
    if ty(par) == T_SYN {
        return neg(ENOENT) // px34: measured, mkdir in /proc/self
    }
    if !may_make(a, par) {
        return neg(EACCES) // px44: write and search of the directory; px47: /dev's too, first
    }
    if ty(par) != T_INO {
        refuse(a, R_DEVRO)
        return neg(EROFS)
    }
    // px42: a new directory keeps the sticky bit it is asked for and
    // never S_ISGID, which it has exactly when its parent has (measured:
    // 02777 in a plain directory is 0755 for root too; 01777 is 1755).
    let (su, sg, dg) = stamp(a, rf(par))
    let i = tree.mkdir(rf(par), raw() + ns, nl, (mode & ((0x1ff & !mask_of(a)) | S_ISVTX)) | dg, su, sg)
    if tree.failed(i) {
        return i
    }
    0
}

/// `unlinkat(dirfd, path, flags)` (and `unlink`, `rmdir`): flags 0
/// removes a file's name — the file lives on while a descriptor holds
/// it, and its frames go back at the last close — and is -EISDIR for a
/// directory (Linux's answer; POSIX says EPERM); AT_REMOVEDIR removes
/// an empty directory: -ENOTDIR for a file, -ENOTEMPTY for one with an
/// entry (and for `..`), -EINVAL for `.`, -EBUSY for `/` and for `/dev`.
/// A directory that is some process's working directory is removed
/// like any other. Any other flag is refused by name, -EINVAL; a name
/// in `/dev` -EROFS. px49 (pax#70): a name in a directory of the tree
/// that is no inode of it (`/dev`, `/proc`, `/sys`) asks the directory's
/// write and search before -EISDIR.
pub fn unlinkat(a: u64, pml4: u64, dirfd: u64, va: u64, flags: u64) -> u64 {
    if flags & !AT_REMOVEDIR != 0 {
        refuse(a, R_ATFLAG)
        return neg(EINVAL)
    }
    let (n, par, ns, nl, trail) = walk(a, pml4, dirfd, va, false, F_NEVER)
    if is_err(n) {
        return neg(rf(n))
    }
    if trail && ty(n) == T_INO && tree.is_link(rf(n)) {
        return neg(ENOTDIR) // px36: measured, `unlink("link/")` and `rmdir`
    }
    if flags & AT_REMOVEDIR != 0 {
        if nl == 0 && is_dir_node(n) {
            if ns == LAST_DOT {
                return neg(EINVAL)
            }
            if ns == LAST_DOTDOT {
                return neg(ENOTEMPTY)
            }
            return neg(EBUSY)
        }
        if mount_root(n) {
            // px47: /dev is a name in `/`: a user who may not write `/`
            // is told so before /dev is busy (measured: -EACCES for a
            // user, -EBUSY for root, `tests/mpx3-tree`'s probes-user).
            // px50 (pax#80): /proc and /sys the same (measured, `fdtab` X).
            if !may(a, cred.FS, par, MAY_W | MAY_X) {
                return neg(EACCES)
            }
            return neg(EBUSY)
        }
        if ty(par) == T_SYN {
            return neg(EPERM) // px50: nothing is removed in /proc or /sys (measured: rmdir of /proc/self/fd -EPERM to anyone)
        }
        // px44: write and search of the directory, then the sticky
        // rule, before what the name is (a file, a full directory).
        let e = unname(a, par, n)
        if e != 0 {
            return neg(e)
        }
        if !is_dir_node(n) {
            return neg(ENOTDIR)
        }
        let rr = tree.rmdir(rf(par), raw() + ns, nl)
        if rr == 0 {
            mark_gone(rf(par), rf(n), ns, nl) // px50
        }
        return rr
    }
    let e = unname(a, par, n) // px44
    if e != 0 {
        return neg(e)
    }
    if ty(par) == T_INO && ty(n) != T_INO && !may(a, cred.FS, par, MAY_W | MAY_X) {
        // px49 (pax#70): /dev, /proc and /sys are names in `/` too: a user
        // who may not write `/` is told so before what the name is
        // (measured: -EACCES for a user, `tests/mpx3-tree`; root -EISDIR).
        return neg(EACCES)
    }
    if is_dir_node(n) {
        return neg(EISDIR)
    }
    if ty(par) == T_DEV && !may(a, cred.FS, par, MAY_W | MAY_X) {
        return neg(EACCES) // px47: a user's unlink in /dev, as on Linux
    }
    if ty(n) != T_INO || ty(par) != T_INO {
        refuse(a, R_DEVRO)
        return neg(EROFS)
    }
    let r = tree.unlink(rf(par), raw() + ns, nl)
    if r == 0 {
        mark_gone(rf(par), rf(n), ns, nl) // px50
    }
    r
}

/// px50: whether node `n` is a file system's root that is a name in `/`
/// (`/dev`, `/proc`, `/sys`): removed or renamed, -EBUSY after `/`'s
/// write and search (px47's rule for /dev; pax#80 for the other two).
/// px67: and any mount's root in the tree (`/home`, `/tmp`, a volume
/// mount(2) put at a directory), wherever it is.
fn mount_root(n: u64) -> bool {
    !is_err(n) && (ty(n) == T_DEV || (ty(n) == T_SYN && procfs.parent(rf(n)) == procfs.ROOT) || (ty(n) == T_INO && tree.is_mount_root(rf(n))))
}

/// `renameat2(olddirfd, old, newdirfd, new, flags)` (and `rename`,
/// `renameat`): the old name becomes the new one, replacing what the
/// new one led to, all or nothing (kernel/tree's `rename`). -ENOENT for
/// a missing old name or a missing directory on the new one's way;
/// -EBUSY when either is `.`, `..`, `/` or `/dev`; -EXDEV when one is in
/// `/dev` and the other is not; -ENOTDIR for a trailing `/` on what is
/// no directory, and for a file moved to a missing name with one
/// (measured: `mv f nodir/`); -EISDIR, -ENOTEMPTY, -EINVAL (a directory
/// into itself) as `rename(2)`. A flag is refused by name, -EINVAL.
pub fn renameat(a: u64, pml4: u64, odfd: u64, ova: u64, ndfd: u64, nva: u64, flags: u64) -> u64 {
    if flags != 0 {
        refuse(a, R_RENFLAG)
        return neg(EINVAL)
    }
    let (on, op, os, ol, ot) = walk(a, pml4, odfd, ova, false, F_NEVER)
    if is_err(on) {
        return neg(rf(on))
    }
    if ot && ty(on) == T_INO && tree.is_link(rf(on)) {
        return neg(ENOTDIR) // px36: measured, a link renamed with a trailing slash
    }
    if ol == 0 {
        return neg(EBUSY)
    }
    // px47: /dev itself, renamed or replaced, is -EBUSY only after the
    // directories' write and search (measured: a user -EACCES, root
    // -EBUSY, `tests/mpx3-tree`'s probes-user); a name in /dev and one
    // out of it stay -EXDEV, which Linux answers first.
    let busy_o = mount_root(on) // px50: /proc and /sys too (pax#80)
    // The old name is kept in pax_kbuf's second half while the new
    // path is walked in its first.
    var k: u64 = 0
    while k < ol {
        put_kb(NORM + k, kb(os + k))
        k += 1
    }
    let (nn, np, ns, nl, nt) = walk(a, pml4, ndfd, nva, false, F_NEVER)
    if is_err(nn) && (rf(nn) != ENOENT || is_err(np)) {
        return neg(rf(nn))
    }
    if nl == 0 {
        return neg(EBUSY)
    }
    let busy_n = mount_root(nn)
    if busy_o && busy_n && nn == on {
        return 0 // px50: /proc renamed to itself, 0 to anyone (measured)
    }
    if (ty(on) != T_INO && !busy_o) || ty(op) != T_INO || ty(np) != T_INO {
        return neg(EXDEV)
    }
    if tree.store(rf(op)) != tree.store(rf(np)) {
        return neg(EXDEV) // px63: a name moved between the tree and a volume, or two volumes
    }
    if is_err(nn) && nt && !busy_o && !tree.is_dir(rf(on)) {
        return neg(ENOTDIR)
    }
    if !is_err(nn) && nt && ty(nn) == T_INO && tree.is_link(rf(nn)) {
        return neg(ENOTDIR) // px36: measured, a rename onto `link/`
    }
    // px44: two names of one file: nothing to do, and nothing asked
    // (measured: 0 in a 0555 directory; rename(2)).
    if !busy_o && !is_err(nn) && ty(nn) == T_INO && rf(nn) == rf(on) {
        return 0
    }
    // px44: write and search of BOTH directories; the sticky rule for
    // the name moved and for a name replaced; a directory that changes
    // parent needs write on itself (its `..`, rename(2)).
    if !may(a, cred.FS, op, MAY_W | MAY_X) || !may(a, cred.FS, np, MAY_W | MAY_X) {
        return neg(EACCES)
    }
    if busy_o || busy_n {
        return neg(EBUSY) // px47
    }
    if !sticky_ok(a, rf(op), rf(on)) || (!is_err(nn) && ty(nn) == T_INO && !sticky_ok(a, rf(np), rf(nn))) {
        return neg(EPERM)
    }
    if op != np && is_dir_node(on) && !may(a, cred.FS, on, MAY_W) {
        return neg(EACCES)
    }
    let rep_i = if !is_err(nn) && ty(nn) == T_INO { rf(nn) } else { tree.NONE }
    let r = tree.rename(rf(op), raw() + NORM, ol, rf(np), raw() + ns, nl)
    if r == 0 {
        // px50: a replaced file's open files read `(deleted)`; the moved
        // file's open files are in its new directory.
        if rep_i != tree.NONE {
            mark_gone(rf(np), rep_i, ns, nl)
        }
        if !tree.is_dir(rf(on)) {
            moved(rf(on), rf(op), rf(np))
        }
    }
    r
}

/// px27: `faccessat(dirfd, path, mode)` (and `access`; `faccessat2`
/// with flags 0 or AT_EACCESS, px49: AT_SYMLINK_NOFOLLOW and
/// AT_EMPTY_PATH too); -EINVAL for a mode outside R_OK|W_OK|X_OK or
/// another flag; the path's own errors. px43: the
/// path is walked and the node asked by the class rule with the REAL
/// user and group ids (privileged when the real user id is 0), or with
/// AT_EACCESS the file-system ones, as `open` asks (px38's `perm` G:
/// (0 1000 0) is told 0 for root's 0600 file it then cannot open).
/// What is not a node of the tree — /dev's and /proc's files — keeps
/// its present answer (0), but its directories are searched.
pub fn faccessat(a: u64, pml4: u64, dirfd: u64, va: u64, mode: u64, flags: u64) -> u64 {
    if mode & !7 != 0 || flags & !(AT_EACCESS | AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH) != 0 {
        return neg(EINVAL)
    }
    let who = if flags & AT_EACCESS != 0 { cred.FS } else { cred.REAL }
    // px49 (pax#60): AT_SYMLINK_NOFOLLOW asks of a last link itself (its
    // 0777 mode: every mode 0 for anyone, a dangling link's F_OK 0), and
    // AT_EMPTY_PATH of the descriptor's own file when the path is empty
    // (without it "" is -ENOENT), as measured on Linux
    // (notes/px49-the-small-gaps.md §F).
    let n = resolve_who(a, who, pml4, dirfd, va, flags & AT_EMPTY_PATH != 0, fol(flags & AT_SYMLINK_NOFOLLOW == 0))
    if is_err(n) {
        return neg(rf(n))
    }
    if checked(n) && !may(a, who, n, mode) {
        return neg(EACCES)
    }
    0
}

/// px45: whether `open` and the access family ask the class rule of
/// node `n`: an inode of the tree (px43), and /dev's devices (their
/// modes and owner 0:0, devtmpfs's: measured). Not /dev itself, not
/// /dev/std* (which reopen a descriptor), not /proc's and /sys's files
/// (kernel/procfs's rules, in `syn_open`).
fn checked(n: u64) -> bool {
    let t = ty(n)
    t == T_INO || t == T_NULL || t == T_CONSOLE || t == T_DSP || t == T_BLK
}

// --- the changes after a file is made (px36) ----------------------------------------

/// px36: what a change of mode, owner or times may be made to: a node of
/// the tree (0), else what PAX keeps fixed — `/dev` and what is in it,
/// `/proc`, `/sys`, a pipe, a socket — refused by name, -EROFS (root on
/// Linux may change them: named drift).
fn changeable(a: u64, n: u64) -> u64 {
    if ty(n) == T_INO {
        return if tree.read_only(rf(n)) { neg(EROFS) } else { 0 } // px63
    }
    refuse(a, R_FIXED)
    neg(EROFS)
}

/// px36: `fchmodat(dirfd, path, mode)` (and `chmod`; `fchmodat2` with
/// its flags; `fchmod` through `fchmod`): the twelve permission bits
/// become `mode & 07777`, the type is kept, ctime moves. A last link is
/// followed; `fchmodat2`'s AT_SYMLINK_NOFOLLOW on a link -EOPNOTSUPP (a
/// link keeps no mode of its own: measured on tmpfs), on anything else
/// as without it; any other flag -EINVAL.
pub fn fchmodat(a: u64, pml4: u64, dirfd: u64, va: u64, mode: u64, flags: u64) -> u64 {
    if flags & !(AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH) != 0 {
        return neg(EINVAL)
    }
    let n = resolve(a, pml4, dirfd, va, flags & AT_EMPTY_PATH != 0, fol(flags & AT_SYMLINK_NOFOLLOW == 0))
    if is_err(n) {
        return neg(rf(n))
    }
    if ty(n) == T_INO && tree.is_link(rf(n)) {
        return neg(EOPNOTSUPP)
    }
    chmod_as(a, n, mode)
}

/// px36: `fchmod(fd, mode)`: as `fchmodat` for the file `fd` names;
/// -EBADF for a closed descriptor.
pub fn fchmod(a: u64, fd: u64, mode: u64) -> u64 {
    if kind(a, fd) == K_CLOSED {
        return neg(EBADF)
    }
    chmod_as(a, node_of(a, fd), mode)
}

/// px44: the change of mode both calls make, by `chmod(2)`'s rule as
/// px38 measured it (`perm` D): only the owner or file-system user id 0
/// (R9) may (-EPERM, whatever the mode or the descriptor); S_ISGID asked
/// by one who is neither privileged nor in the node's group (`member`)
/// is dropped without an error, on a file and on a directory alike.
fn chmod_as(a: u64, n: u64, mode: u64) -> u64 {
    if !owns(a, n) {
        return neg(EPERM)
    }
    let r = changeable(a, n)
    if r != 0 {
        return r
    }
    var m = mode & 0xfff
    if m & S_ISGID != 0 && cred.uid(a, cred.FS) != 0 && !member(a, n_owner(a, n, 1)) {
        m = m & !S_ISGID
    }
    tree.set_mode(rf(n), m)
    0
}

/// `fchownat(dirfd, path, owner, group, flags)` (and `chown`, `lchown`;
/// `fchown` with `fd` and no path, `va` 0). px36 answered root asking
/// for root; px42: any id is kept, and who may ask is Linux's rule,
/// measured for the four calls alike (px38's `perm` section E, `own`
/// section C; kernel/tree's `chown` does the change):
///
/// - an id is the low 32 bits of its register; -1 leaves it alone;
/// - **privileged** is file-system user id 0 (ruling R9; the effective
///   id is not asked: `fsid` rows) and may set anything;
/// - anyone else naming an owner must be the file's owner (by
///   file-system user id) and name that same id; naming a group, must
///   be the file's owner and name the group the file has, its own
///   file-system group id or one of its supplementary groups;
/// - a regular file's set-user-ID bit goes at every success, and its
///   set-group-ID bit when the file is group-executable, or when the
///   caller is not privileged and not in the group the file had; one
///   who is not the owner may not make a call that would take a bit;
/// - so `(-1, -1)` on a file with no bit to lose is 0 for anybody,
///   and moves ctime like every success; everything else by one who is
///   not the owner is -EPERM, and a refusal changes nothing.
///
/// Flags AT_SYMLINK_NOFOLLOW (the link itself, as `lchown`) and
/// AT_EMPTY_PATH; any other -EINVAL. What PAX keeps fixed (`/dev`,
/// `/proc`, `/sys`, a pipe, a socket) is refused by name, -EROFS, as
/// before (px36's named drift). `byfd`: `fchown`, `dirfd` the
/// descriptor and no path. This is the one rule about who asks that
/// PAX has before U3: no `open`, walk or `chmod` asks yet.
pub fn fchownat(a: u64, pml4: u64, dirfd: u64, va: u64, owner: u64, group: u64, flags: u64, byfd: bool) -> u64 {
    var n: u64 = 0
    if byfd {
        if kind(a, dirfd) == K_CLOSED {
            return neg(EBADF)
        }
        n = node_of(a, dirfd)
    } else {
        if flags & !(AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH) != 0 {
            return neg(EINVAL)
        }
        n = resolve(a, pml4, dirfd, va, flags & AT_EMPTY_PATH != 0, fol(flags & AT_SYMLINK_NOFOLLOW == 0))
        if is_err(n) {
            return neg(rf(n))
        }
    }
    let r = changeable(a, n)
    if r != 0 {
        return r
    }
    let i = rf(n)
    let u = owner & 0xffffffff
    let g = group & 0xffffffff
    let fu = cred.uid(a, cred.FS)
    if fu != 0 {
        let mine = tree.uid(i) == fu
        if u != tree.KEEP && !(mine && u == fu) {
            return neg(EPERM)
        }
        if g != tree.KEEP && !(mine && (g == tree.gid(i) || member(a, g))) {
            return neg(EPERM)
        }
        let m = tree.mode(i)
        if !mine && m & S_IFMT == S_IFREG && (m & S_ISUID != 0 || (m & S_ISGID != 0 && (m & S_IXGRP != 0 || !member(a, tree.gid(i))))) {
            return neg(EPERM)
        }
    }
    tree.chown(i, u, g, fu != 0 && !member(a, tree.gid(i)))
    0
}

/// px36: one `struct timespec` of `utimensat` at user `ts`: (which bit
/// it sets, the time in signed nanoseconds, or an errno). UTIME_NOW is
/// the tree's clock, UTIME_OMIT sets nothing, a `tv_nsec` that is
/// neither and not below 10^9 (a negative one included) -EINVAL. A
/// second count past what 64 bits of nanoseconds hold (1677 to 2262) is
/// held at that end: named drift (tmpfs keeps it).
fn timespec_in(pml4: u64, ts: u64) -> (bool, u64, u64) {
    let sec = uaccess.get(pml4, ts, 8)
    let ns = uaccess.get(pml4, ts + 8, 8)
    if ns == UTIME_OMIT {
        return (false, 0, 0)
    }
    if ns == UTIME_NOW {
        return (true, tree.clock(), 0)
    }
    if ns >= NS {
        return (false, 0, EINVAL)
    }
    // sec is a signed 64-bit count; 9223372036 s is the last second
    // that fits in signed nanoseconds, -9223372036 the first.
    let max_s: u64 = 9223372035
    if sec < 0x8000000000000000 && sec > max_s {
        return (true, 0x7fffffffffffffff, 0)
    }
    if sec >= 0x8000000000000000 && sec < 0xffffffffffffffff - max_s {
        return (true, 0x8000000000000000, 0)
    }
    if sec < 0x8000000000000000 {
        return (true, sec * NS + ns, 0)
    }
    // before 1970: -(m) where m = |sec| * 10^9 - ns, in two's complement
    // (no step here can overflow: |sec| <= 9223372036, ns < 10^9)
    let m = (!sec + 1) * NS - ns
    (true, !m + 1, 0)
}

/// px36: `utimensat(dirfd, path, times, flags)`: `times` 0 sets both to
/// now; else two `struct timespec` (atime, mtime), each a time to the
/// nanosecond, UTIME_NOW or UTIME_OMIT; ctime moves unless both are
/// UTIME_OMIT. `path` 0 names the descriptor `dirfd` (glibc's
/// `futimens`). AT_SYMLINK_NOFOLLOW sets a link's own times; any other
/// flag -EINVAL.
pub fn utimensat(a: u64, pml4: u64, dirfd: u64, va: u64, times: u64, flags: u64) -> u64 {
    if flags & !(AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH) != 0 {
        return neg(EINVAL)
    }
    var which: u64 = 3
    var at = tree.clock()
    var mt = at
    var now2 = true // px44: NULL, or UTIME_NOW in both: a writer may
    if times != 0 {
        if !uaccess.readable(pml4, times, 32) {
            return neg(EFAULT)
        }
        let (sa, ta, ea) = timespec_in(pml4, times)
        let (sm, tm, em) = timespec_in(pml4, times + 16)
        if ea != 0 || em != 0 {
            return neg(EINVAL)
        }
        which = (if sa { 1 } else { 0 }) | (if sm { 2 } else { 0 })
        at = ta
        mt = tm
        now2 = uaccess.get(pml4, times + 8, 8) == UTIME_NOW && uaccess.get(pml4, times + 24, 8) == UTIME_NOW
    }
    var n: u64 = 0
    if va == 0 {
        if kind(a, dirfd) == K_CLOSED {
            return neg(EBADF)
        }
        n = node_of(a, dirfd)
    } else {
        n = resolve(a, pml4, dirfd, va, flags & AT_EMPTY_PATH != 0, fol(flags & AT_SYMLINK_NOFOLLOW == 0))
        if is_err(n) {
            return neg(rf(n))
        }
    }
    if which == 0 {
        return 0
    }
    // px44: `utimensat(2)`'s rule as px38 measured it (`perm` F): the
    // owner or file-system user id 0 (R9) may set any times; anyone
    // else may set both to now (NULL or {NOW, NOW}) when the class rule
    // gives write (asked of the file, not of the descriptor's access
    // mode), else -EACCES; any other times -EPERM.
    if !owns(a, n) {
        if !now2 {
            return neg(EPERM)
        }
        if !may(a, cred.FS, n, MAY_W) {
            return neg(EACCES)
        }
    }
    let r = changeable(a, n)
    if r != 0 {
        return r
    }
    tree.set_times(rf(n), at, mt, which)
    0
}

/// px36: `linkat(olddirfd, old, newdirfd, new, flags)` (and `link`): the
/// file `old` names gains the name `new`. A last link in `old` is not
/// followed (a hard link to the link itself, as Linux's `link` does)
/// unless AT_SYMLINK_FOLLOW; AT_EMPTY_PATH links the descriptor's file;
/// any other flag -EINVAL. A directory -EPERM; a name that exists
/// -EEXIST (a link there not followed); a file with no name left
/// -ENOENT; across `/dev` -EXDEV; the path errors of each side.
pub fn linkat(a: u64, pml4: u64, odfd: u64, ova: u64, ndfd: u64, nva: u64, flags: u64) -> u64 {
    if flags & !(AT_SYMLINK_FOLLOW | AT_EMPTY_PATH) != 0 {
        return neg(EINVAL)
    }
    let on = resolve(a, pml4, odfd, ova, flags & AT_EMPTY_PATH != 0, fol(flags & AT_SYMLINK_FOLLOW != 0))
    if is_err(on) {
        return neg(rf(on))
    }
    if is_dir_node(on) {
        return neg(EPERM)
    }
    let (nn, np, ns, nl, nt) = walk(a, pml4, ndfd, nva, false, F_NEVER)
    if !is_err(nn) {
        return neg(EEXIST)
    }
    if rf(nn) != ENOENT || is_err(np) {
        return neg(rf(nn))
    }
    if nt {
        return neg(ENOENT) // measured: a new name with a trailing slash
    }
    if ty(on) != T_INO || ty(np) != T_INO || tree.store(rf(on)) != tree.store(rf(np)) {
        return neg(EXDEV) // px63: and between stores
    }
    // px44: fs.protected_hardlinks (R7), then write and search of the
    // new name's directory (measured in this order: a non-owner's link
    // to a file it may not write, into a 0555 directory, is -EPERM).
    if !may_hardlink(a, on) {
        return neg(EPERM)
    }
    if !may_make(a, np) {
        return neg(EACCES)
    }
    tree.link(rf(np), raw() + ns, nl, rf(on))
}

/// px36: `symlinkat(target, newdirfd, path)` (and `symlink`): a new
/// symbolic link whose bytes are `target`'s (1 to 4095; empty -ENOENT,
/// longer -ENAMETOOLONG). A name that exists -EEXIST (a link there not
/// followed); a trailing slash -ENOENT (measured); in `/dev` refused by
/// name, -EROFS; the path's errors. The target is kept in pax_kbuf's
/// second half while the path is walked in its first.
pub fn symlinkat(a: u64, pml4: u64, tva: u64, ndfd: u64, nva: u64) -> u64 {
    let tl = path_in(pml4, tva)
    if is_err(tl) {
        return neg(rf(tl))
    }
    if tl == 0 {
        return neg(ENOENT)
    }
    var k: u64 = 0
    while k < tl {
        put_kb(NORM + k, kb(k))
        k += 1
    }
    let (nn, np, ns, nl, nt) = walk(a, pml4, ndfd, nva, false, F_NEVER)
    if !is_err(nn) {
        return neg(EEXIST)
    }
    if rf(nn) != ENOENT || is_err(np) {
        return neg(rf(nn))
    }
    if nt {
        return neg(ENOENT)
    }
    if ty(np) == T_SYN {
        return neg(ENOENT) // as anything made in /proc or /sys (px34)
    }
    if !may_make(a, np) {
        return neg(EACCES) // px44; px47: /dev's too, first
    }
    if ty(np) != T_INO {
        refuse(a, R_FIXED)
        return neg(EROFS)
    }
    let (su, sg, _dg) = stamp(a, rf(np))
    let i = tree.symlink(rf(np), raw() + ns, nl, raw() + NORM, tl, su, sg)
    if tree.failed(i) {
        return i
    }
    0
}

/// px27: the calls the tree refuses by name, each with the errno Linux
/// gives a file system that cannot do it: `which` 0 a device node
/// (-EPERM: `mknod(2)`), 1 `utime` or `utimes` (-EOPNOTSUPP; px36: in no
/// strace, `utimensat` is the call every program here makes).
pub fn refused(a: u64, which: u64) -> u64 {
    if which == 0 {
        refuse(a, R_LINK)
        return neg(EPERM)
    }
    refuse(a, R_META)
    neg(EOPNOTSUPP)
}

// --- stat -------------------------------------------------------------------

fn n_mode(n: u64) -> u64 {
    let t = ty(n)
    if t == T_INO {
        return tree.mode(rf(n))
    }
    if t == T_CONSOLE && rf(n) == TTY {
        return MODE_NULL // px45: /dev/tty is anyone's, 0666 (measured)
    }
    if t == T_CONSOLE {
        return MODE_CONSOLE
    }
    if t == T_STD {
        return MODE_LINK // px52: /dev/std*, links
    }
    if t == T_NULL {
        return MODE_NULL
    }
    if t == T_DSP {
        return MODE_DSP
    }
    if t == T_PIPE {
        return MODE_FIFO
    }
    if t == T_SOCK || t == T_INET || t == T_TCP || t == T_UNIX {
        return MODE_SOCK
    }
    if t == T_SYN {
        let (isfd, fd) = procfs.fd_of(rf(n))
        if isfd {
            // px50: a descriptor's link has the read and the write bit of
            // its access mode, and the search bit (measured: 0500 for
            // O_RDONLY, 0300 O_WRONLY, 0700 O_RDWR; px45 said 0700).
            let ta = pid_area(procfs.pid_of(rf(n)))
            let acc = if ta == 0 { O_RDWR } else { access(ta, fd) }
            return 0xa000 | 0x40 | (if acc != O_WRONLY { 0x100 } else { 0 }) | (if acc != O_RDONLY { 0x80 } else { 0 })
        }
        return procfs.mode(rf(n)) // px34
    }
    if t == T_EVENT || t == T_EPOLL {
        return MODE_ANON // px24
    }
    if t == T_BLK {
        return MODE_BLK // px79
    }
    MODE_DIR
}

fn n_size(n: u64) -> u64 {
    if ty(n) == T_INO {
        return tree.size(rf(n))
    }
    if ty(n) == T_STD {
        return link_bytes(n) // px52: `/proc/self/fd/N`; px55: `/dev/fd`'s 13
    }
    if ty(n) == T_SYN {
        // px50 (measured): a descriptor's link is 64 bytes, and fd/ is
        // as large as the process has descriptors open.
        if is_fd_entry(n) {
            return 64
        }
        if procfs.entry(rf(n)) == procfs.PFD {
            let ta = pid_area(procfs.pid_of(rf(n)))
            var c: u64 = 0
            var f: u64 = 0
            while ta != 0 && f < FDS {
                if kind(ta, f) != K_CLOSED {
                    c += 1
                }
                f += 1
            }
            return c
        }
        return procfs.size(rf(n)) // px34
    }
    0
}

fn n_ino(n: u64) -> u64 {
    let t = ty(n)
    if t == T_INO {
        return tree.number(rf(n)) // px27: the root is 2, never 0; px63: a volume's own number
    }
    if t == T_DEV {
        return 1
    }
    if t == T_NULL {
        return if rf(n) == 0 { 4 } else { 0x10 + rf(n) } // px45: zero 0x11 to urandom 0x14
    }
    if t == T_DSP {
        return 7 // px30
    }
    if t == T_CONSOLE && (rf(n) == TTY0 || rf(n) == CONSOLE) {
        return 4 + rf(n) // px21a: /dev/tty0 5, /dev/console 6
    }
    if t == T_CONSOLE && rf(n) != 0 {
        return 0x15 + rf(n) // px45: /dev/tty 0x18, /dev/ttyS0 0x19
    }
    if t == T_STD {
        return 0x1a + rf(n) // px52: /dev/stdin 0x1a to /dev/stderr 0x1c (they were the console's 3); px55: /dev/fd 0x1d
    }
    if t == T_PIPE || t == T_SOCK {
        return 0x100 + (rf(n) & 0xff) // px17: one number per buffer
    }
    if t == T_INET {
        return 0x200 + rf(n) // px22: one number per socket
    }
    if t == T_TCP {
        return 0x300 + rf(n) // px23: one number per block
    }
    if t == T_UNIX {
        return 0x800 + rf(n) // px34: one number per socket
    }
    if t == T_SYN {
        return 0x700 + rf(n) // px34
    }
    if t == T_BLK {
        return 0x2000 + (rf(n) & 0xffff) // px79: one number per device record
    }
    3 // the console
}

fn n_nlink(n: u64) -> u64 {
    let t = ty(n)
    if t == T_INO {
        return tree.nlink(rf(n))
    }
    if t == T_DEV || (t == T_SYN && procfs.is_dir(rf(n))) {
        return 2
    }
    1
}

/// The device a character node is (major, minor), 0 for others.
fn n_rdev(n: u64, which: int) -> u64 {
    let t = ty(n)
    if t == T_CONSOLE && rf(n) == TTY0 {
        return if which == 0 { 4 } else { 0 }
    }
    if t == T_CONSOLE && rf(n) == CONSOLE {
        return if which == 0 { 5 } else { 1 }
    }
    if t == T_CONSOLE && rf(n) == TTY {
        return if which == 0 { 5 } else { 0 } // px45: /dev/tty 5:0
    }
    if t == T_CONSOLE {
        return if which == 0 { 4 } else { 64 }
    }
    if t == T_NULL {
        // px45: mem's minors (Linux's numbers, measured): null 3, zero 5, full 7, random 8, urandom 9
        let r = rf(n)
        return if which == 0 { 1 } else if r == ZERO { 5 } else if r == FULL { 7 } else if r == RANDOM { 8 } else if r == URANDOM { 9 } else { 3 }
    }
    if t == T_DSP {
        return if which == 0 { 14 } else { 3 } // px30: OSS's dsp, 14:3
    }
    if t == T_BLK {
        let (ma, mi) = block.numbers(rf(n) & 0xffff) // px79: the guest's, 254:N and 259:N
        return if which == 0 { ma } else { mi }
    }
    0
}

/// The minor number of the device a node's file system is (the major
/// is 0): 1 for the tree and what has no place in it (a pipe, a
/// socket), 5 for `/dev` and what is in it (px27: a second file
/// system, so a `rename` across is -EXDEV and `/` and `/dev` never
/// look alike).
fn n_dev(n: u64) -> u64 {
    let t = ty(n)
    if t == T_INO && tree.on_volume(rf(n)) {
        let (_ma, mi) = block.numbers(tree.disk_of(rf(n))) // px63
        return mi
    }
    if t == T_DEV || t == T_NULL || t == T_STD || t == T_CONSOLE || t == T_DSP || t == T_BLK {
        return 5
    }
    if t == T_SYN {
        return 6 + procfs.fs(rf(n)) // px34: /proc 0:6, /sys 0:7
    }
    1
}

/// px63: the major number of the device a node's file system is: a
/// volume's disk's (254, virtio_blk's on Linux), else 0.
fn n_major(n: u64) -> u64 {
    if ty(n) == T_INO && tree.on_volume(rf(n)) {
        let (ma, _mi) = block.numbers(tree.disk_of(rf(n)))
        return ma
    }
    0
}

/// glibc's dev_t encoding of (major, minor): minor's low byte, major's
/// twelve bits from bit 8, minor's rest from bit 20.
fn dev_t(ma: u64, mi: u64) -> u64 {
    (mi & 0xff) | ((ma & 0xfff) << 8) | ((mi & 0xffffff00) << 12)
}

/// A node's 512-byte blocks (px26: whole 4096-byte pages, what Linux's
/// file systems answer; px27: eight for each page of a file that holds
/// bytes, kernel/tree's `blocks`, so a hole counts nothing, as on
/// tmpfs).
fn n_blksize(n: u64) -> u64 {
    if ty(n) == T_INO {
        return tree.io_size(rf(n))
    }
    if ty(n) == T_BLK {
        return block.lbs(rf(n) & 0xffff) // px79: 512 for a virtio disk's node (measured)
    }
    PAGE
}

fn n_blocks(n: u64) -> u64 {
    if ty(n) == T_INO {
        return tree.blocks(rf(n))
    }
    0
}

/// A node's time `which` (0 access, 1 modification, 2 change, 3 birth)
/// in nanoseconds since the epoch: the inode's (px27), 0 for what is
/// no inode.
fn n_time(n: u64, which: int) -> u64 {
    if ty(n) == T_INO {
        return tree.time(rf(n), which)
    }
    0
}

const NS: u64 = 1000000000

/// px36: a time (signed nanoseconds since the epoch, in a u64) as
/// `struct timespec` holds it: (the seconds, signed, rounded down; the
/// nanoseconds, 0 to 10^9 - 1).
fn tsec(t: u64) -> u64 {
    if t < 0x8000000000000000 {
        return t / NS
    }
    let m = !t + 1
    let q = if m % NS == 0 { m / NS } else { m / NS + 1 }
    !q + 1
}

fn tnsec(t: u64) -> u64 {
    if t < 0x8000000000000000 {
        return t % NS
    }
    let r = (!t + 1) % NS
    if r == 0 { 0 } else { NS - r }
}

/// px42: the area of the process a `/proc` node is about: the named
/// process's for `/proc/<pid>` and what is in it, else the caller's
/// (`/proc/self`); 0 when the named process is gone.
fn syn_area(a: u64, n: u64) -> u64 {
    let tp = procfs.pid_of(rf(n))
    if tp == 0 {
        return a
    }
    let sl = sched.proc_slot(tp)
    if sl == sched.SLOTS {
        return 0
    }
    sched.proc_area_of_leader(sl)
}

/// px42: a node's owner (`which` 0) or group (1): an inode's own;
/// a `/proc` node's by kernel/procfs's rule; px43 (pax#58): a pipe's, a
/// socketpair's and an AF_UNIX socket's maker's file-system ids
/// (measured, `own`'s `desc` rows); px49 (pax#58): an AF_INET datagram
/// socket's, a TCP socket's and an accepted end's (the open file's
/// O_OWNER); 0 for everything else (`/dev` and what is in it; an eventfd
/// and an epoll object, as on Linux: measured).
fn n_owner(a: u64, n: u64, which: int) -> u64 {
    let t = ty(n)
    if t == T_INO {
        return if which == 0 { tree.uid(rf(n)) } else { tree.gid(rf(n)) }
    }
    if t == T_PIPE || t == T_SOCK {
        let o = ppw(rf(n) & 0xffff, P_OWNER)
        return if which == 0 { o & 0xffffffff } else { o >> 32 }
    }
    if t == T_UNIX {
        let (u, g) = unix.owner(rf(n))
        return if which == 0 { u } else { g }
    }
    if t == T_INET || t == T_TCP {
        let o = sock_owner(n) // px49 (pax#58)
        return if which == 0 { o & 0xffffffff } else { o >> 32 }
    }
    if t == T_SYN {
        let ta = syn_area(a, n)
        if ta == 0 {
            return 0
        }
        return procfs.owner(rf(n), ta, which)
    }
    0
}

/// Write `struct stat` (x86-64, 144 bytes) for node `n` at user `st`.
fn put_stat(a: u64, pml4: u64, st: u64, n: u64) -> u64 {
    if !uaccess.writable(pml4, st, 144) {
        return neg(EFAULT)
    }
    uaccess.zero(pml4, st, 144)
    uaccess.put(pml4, st, dev_t(n_major(n), n_dev(n)), 8) // st_dev (px63: a volume's disk)
    uaccess.put(pml4, st + 8, n_ino(n), 8) // st_ino
    uaccess.put(pml4, st + 16, n_nlink(n), 8) // st_nlink
    uaccess.put(pml4, st + 24, n_mode(n), 4) // st_mode
    uaccess.put(pml4, st + 28, n_owner(a, n, 0), 4) // st_uid (px42)
    uaccess.put(pml4, st + 32, n_owner(a, n, 1), 4) // st_gid
    uaccess.put(pml4, st + 40, dev_t(n_rdev(n, 0), n_rdev(n, 1)), 8) // st_rdev
    uaccess.put(pml4, st + 48, n_size(n), 8) // st_size
    uaccess.put(pml4, st + 56, n_blksize(n), 8) // st_blksize (px63: a volume's block size)
    uaccess.put(pml4, st + 64, n_blocks(n), 8) // st_blocks
    uaccess.put(pml4, st + 72, tsec(n_time(n, 0)), 8) // st_atim (px36: signed)
    uaccess.put(pml4, st + 80, tnsec(n_time(n, 0)), 8)
    uaccess.put(pml4, st + 88, tsec(n_time(n, 1)), 8) // st_mtim
    uaccess.put(pml4, st + 96, tnsec(n_time(n, 1)), 8)
    uaccess.put(pml4, st + 104, tsec(n_time(n, 2)), 8) // st_ctim
    uaccess.put(pml4, st + 112, tnsec(n_time(n, 2)), 8)
    0
}

/// Write `struct statx` (256 bytes) for node `n` at user `sx`.
fn put_statx(a: u64, pml4: u64, sx: u64, n: u64) -> u64 {
    if !uaccess.writable(pml4, sx, 256) {
        return neg(EFAULT)
    }
    uaccess.zero(pml4, sx, 256)
    // stx_mask: STATX_BASIC_STATS, and STATX_BTIME for an inode (px27).
    uaccess.put(pml4, sx, if ty(n) == T_INO { 0xfff } else { 0x7ff }, 4)
    uaccess.put(pml4, sx + 4, n_blksize(n), 4) // stx_blksize
    uaccess.put(pml4, sx + 16, n_nlink(n), 4) // stx_nlink
    uaccess.put(pml4, sx + 20, n_owner(a, n, 0), 4) // stx_uid (px42)
    uaccess.put(pml4, sx + 24, n_owner(a, n, 1), 4) // stx_gid
    uaccess.put(pml4, sx + 28, n_mode(n), 2) // stx_mode
    uaccess.put(pml4, sx + 32, n_ino(n), 8) // stx_ino
    uaccess.put(pml4, sx + 40, n_size(n), 8) // stx_size
    uaccess.put(pml4, sx + 48, n_blocks(n), 8) // stx_blocks
    uaccess.put(pml4, sx + 64, tsec(n_time(n, 0)), 8) // stx_atime (px36: signed)
    uaccess.put(pml4, sx + 72, tnsec(n_time(n, 0)), 4)
    uaccess.put(pml4, sx + 80, tsec(n_time(n, 3)), 8) // stx_btime
    uaccess.put(pml4, sx + 88, tnsec(n_time(n, 3)), 4)
    uaccess.put(pml4, sx + 96, tsec(n_time(n, 2)), 8) // stx_ctime
    uaccess.put(pml4, sx + 104, tnsec(n_time(n, 2)), 4)
    uaccess.put(pml4, sx + 112, tsec(n_time(n, 1)), 8) // stx_mtime
    uaccess.put(pml4, sx + 120, tnsec(n_time(n, 1)), 4)
    uaccess.put(pml4, sx + 128, n_rdev(n, 0), 4) // stx_rdev_major
    uaccess.put(pml4, sx + 132, n_rdev(n, 1), 4) // stx_rdev_minor
    uaccess.put(pml4, sx + 136, n_major(n), 4) // stx_dev_major (px63: 254 for a volume's disk)
    uaccess.put(pml4, sx + 140, n_dev(n), 4) // stx_dev_minor (0:1, /dev 0:5)
    0
}

/// `fstat(fd, st)`.
pub fn fstat(a: u64, pml4: u64, fd: u64, st: u64) -> u64 {
    if kind(a, fd) == K_CLOSED {
        return neg(EBADF)
    }
    put_stat(a, pml4, st, stat_node(a, fd))
}

/// px62: the node `stat` answers for descriptor `fd`: a FIFO's end
/// answers its FIFO (the name's inode, its mode and owner, measured),
/// not the buffer its ends share; anything else its own node.
fn stat_node(a: u64, fd: u64) -> u64 {
    if kind(a, fd) == K_PIPE {
        let fi = ppw(rf(node_of(a, fd)), P_FIFO)
        if fi != 0 {
            return ino_node(fi - 1)
        }
    }
    node_of(a, fd)
}

/// `newfstatat(dirfd, path, st, flags)` (and `stat`, `lstat` through it).
pub fn fstatat(a: u64, pml4: u64, dirfd: u64, va: u64, st: u64, flags: u64) -> u64 {
    if flags & (0xffffffff - AT_SYMLINK_NOFOLLOW - AT_EMPTY_PATH - 0x800) != 0 {
        return neg(EINVAL)
    }
    let n = resolve(a, pml4, dirfd, va, flags & AT_EMPTY_PATH != 0, fol(flags & AT_SYMLINK_NOFOLLOW == 0))
    if is_err(n) {
        return neg(rf(n))
    }
    // px52: /dev/std* followed reaches the descriptor's own node through
    // `/proc/self/fd/N` (px50's `std_target` did it by hand: bu25's `cat`
    // compares `/dev/stdin` with its output by `dev` and `ino`).
    put_stat(a, pml4, st, n)
}

/// `statx(dirfd, path, flags, mask, sx)`: every basic field, whatever
/// the mask asks (statx(2) allows more than asked).
pub fn statx(a: u64, pml4: u64, dirfd: u64, va: u64, flags: u64, sx: u64) -> u64 {
    let n = resolve(a, pml4, dirfd, va, flags & AT_EMPTY_PATH != 0, fol(flags & AT_SYMLINK_NOFOLLOW == 0))
    if is_err(n) {
        return neg(rf(n))
    }
    put_statx(a, pml4, sx, n) // px52: /dev/std* as fstatat's
}

// --- directories --------------------------------------------------------------

/// `/dev`'s child number `k` (after "." and ".."): a node, or an error
/// node past the last.
fn dev_child(k: u64) -> u64 {
    if k < 4 {
        return (T_STD << T_SHIFT) | k // px55: and fd, after stderr
    }
    if k == 4 {
        return T_NULL << T_SHIFT
    }
    if k == 5 || k == 6 {
        return (T_CONSOLE << T_SHIFT) | (k - 4) // px21a: tty0, console
    }
    if k >= 7 && k <= 10 {
        return (T_NULL << T_SHIFT) | (k - 6) // px45: zero, full, random, urandom
    }
    if k == 11 || k == 12 {
        return (T_CONSOLE << T_SHIFT) | (k - 8) // px45: tty, ttyS0
    }
    if k == 13 && sound.up() {
        return T_DSP << T_SHIFT // px30: only with the device
    }
    // px79: then the block devices, in /proc/partitions' order
    if k >= 13 {
        let b = block.nth_dev(if sound.up() { k - 14 } else { k - 13 })
        if b != block.DEVS {
            return blk_node(b)
        }
    }
    err(ENOENT)
}

/// px79: the node of block device `d` (its record's generation kept, so a
/// record taken away and made again is not the node's).
fn blk_node(d: u64) -> u64 {
    (T_BLK << T_SHIFT) | (block.gen(d) << 16) | d
}

/// px79: the block device node `n` names, or block.DEVS when its record
/// has been taken away (BLKRRPART, BLKPG) since the node was looked up.
fn blk_dev(n: u64) -> u64 {
    let d = rf(n) & 0xffff
    if block.present(d) && block.gen(d) == rf(n) >> 16 { d } else { block.DEVS }
}

/// The name of a node that is not an inode: `/dev` itself and what is
/// in it.
fn fixed_name(c: u64) -> str {
    let t = ty(c)
    if t == T_DEV {
        return "dev"
    }
    if t == T_NULL {
        let r = rf(c)
        return if r == ZERO { "zero" } else if r == FULL { "full" } else if r == RANDOM { "random" } else if r == URANDOM { "urandom" } else { "null" }
    }
    if t == T_DSP {
        return "dsp" // px30
    }
    if t == T_CONSOLE {
        let r = rf(c)
        return if r == TTY0 { "tty0" } else if r == TTY { "tty" } else if r == TTYS0 { "ttyS0" } else { "console" }
    }
    if rf(c) == 0 {
        return "stdin"
    }
    if rf(c) == 1 {
        return "stdout"
    }
    if rf(c) == FD_LINK {
        return "fd" // px55
    }
    "stderr"
}

/// The length of `fixed_name(c)`.
fn fixed_len(c: u64) -> u64 {
    let t = ty(c)
    if t == T_DEV {
        return 3
    }
    if t == T_BLK {
        return block.name_len(rf(c) & 0xffff) // px79
    }
    if t == T_NULL {
        let r = rf(c)
        return if r == ZERO || r == FULL { 4 } else if r == RANDOM { 6 } else if r == URANDOM { 7 } else { 4 }
    }
    if t == T_DSP {
        return 3 // px30
    }
    if t == T_CONSOLE {
        let r = rf(c)
        return if r == TTY0 { 4 } else if r == TTY { 3 } else if r == TTYS0 { 5 } else { 7 }
    }
    if rf(c) == 0 {
        return 5
    }
    if rf(c) == FD_LINK {
        return 2 // px55: fd
    }
    6
}

fn d_type(c: u64) -> u64 {
    if is_dir_node(c) {
        return DT_DIR
    }
    if ty(c) == T_INO && tree.is_link(rf(c)) {
        return DT_LNK // px36
    }
    if ty(c) == T_INO && tree.is_sock(rf(c)) {
        return DT_SOCK // px34 (measured: 12)
    }
    if ty(c) == T_INO && tree.is_fifo(rf(c)) {
        return DT_FIFO // px62 (measured: 1)
    }
    if ty(c) == T_SYN {
        let (isfd, _n) = procfs.fd_of(rf(c))
        if isfd {
            return DT_LNK // px45: a descriptor of /proc/<pid>/fd
        }
    }
    if ty(c) == T_STD {
        return DT_LNK // px52: /dev/std*; px55: /dev/fd
    }
    if ty(c) == T_INO || ty(c) == T_SYN {
        return DT_REG
    }
    if ty(c) == T_BLK {
        return DT_BLK // px79
    }
    DT_CHR
}

/// The position in the root past its last entry and past `dev`.
const DEV_DONE: u64 = 0x4000000000000000

/// `getdents64(fd, buf, count)`: as many `struct linux_dirent64` as fit
/// (d_ino, d_off the next position, d_reclen a multiple of 8, d_type,
/// the name and its NUL), "." and ".." first; 0 at the end; -EINVAL
/// when not even one fits. px27: a directory of the tree lists its
/// records in their order (a position is 2 plus a record's offset, so
/// an entry that is there for the whole of a reading is returned
/// exactly once whatever is made or removed meanwhile), and the root
/// lists `dev` after them; a directory that has been removed is
/// -ENOENT (measured).
pub fn getdents(a: u64, pml4: u64, fd: u64, buf: u64, count: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    if k != K_DIR {
        return neg(ENOTDIR)
    }
    if !uaccess.writable(pml4, buf, count) {
        return neg(EFAULT)
    }
    let d = node_of(a, fd)
    if ty(d) == T_INO && tree.nlink(rf(d)) == 0 {
        return neg(ENOENT)
    }
    if ty(d) == T_INO && tree.on_volume(rf(d)) {
        tree.touch_read(rf(d)) // px63: a volume's directory read moves its atime, relatime's rule (measured on Linux's ext2 mount)
    }
    var p = pos(a, fd)
    var used: u64 = 0
    var more = true
    while more {
        var c = d
        var nl: u64 = 1
        var na: u64 = 0 // an inode's name, in a directory record
        var dino: u64 = 0 // px63: a tree entry's d_ino and d_type (kernel/tree's `dirent`); 0 for the rest
        var dtyp: u64 = 0
        var next = p + 1
        if p == 1 {
            c = up(d)
            nl = 2
        } else if p >= 2 && ty(d) == T_DEV {
            c = dev_child(p - 2)
            if is_err(c) {
                more = false
            } else {
                nl = fixed_len(c)
            }
        } else if p >= 2 && ty(d) == T_SYN && (procfs.entry(rf(d)) == procfs.PFD || procfs.entry(rf(d)) == procfs.PFDINFO) {
            // px45: /proc/<pid>/fd lists the process's open descriptors;
            // px50: and fdinfo/ the same numbers
            let (f, cnext) = fd_after(a, d, p - 2)
            if f == FDS {
                more = false
            } else {
                let tp = procfs.pid_of(rf(d))
                c = (T_SYN << T_SHIFT) | if procfs.entry(rf(d)) == procfs.PFD { procfs.fd_entry(tp, f) } else { procfs.fi_entry(tp, f) }
                nl = procfs.name_len(rf(c))
                next = cnext + 2
            }
        } else if p >= 2 && ty(d) == T_SYN {
            let e = procfs.child_at(rf(d), p - 2) // px34
            if e == procfs.NONE {
                more = false
            } else {
                c = (T_SYN << T_SHIFT) | e
                nl = procfs.name_len(e)
            }
        } else if p >= DEV_DONE {
            more = false
        } else if p >= 2 {
            let (di, dt, addr, l, nx) = tree.dirent(rf(d), p - 2) // px63: a volume's entries too
            if di != 0 {
                dino = di
                dtyp = dt
                na = addr
                nl = l
                next = nx + 2
            } else if rf(d) == tree.ROOT {
                c = T_DEV << T_SHIFT
                nl = 3
                next = DEV_DONE
            } else {
                more = false
            }
        }
        if more {
            let rec = (19 + nl + 1 + 7) & !7
            if rec > count - used {
                if used == 0 {
                    return neg(EINVAL)
                }
                more = false
            } else {
                let r = buf + used
                uaccess.zero(pml4, r, rec)
                uaccess.put(pml4, r, if dino != 0 { dino } else { n_ino(c) }, 8)
                uaccess.put(pml4, r + 8, next, 8)
                uaccess.put(pml4, r + 16, rec, 2)
                uaccess.put(pml4, r + 18, if dino != 0 { dtyp } else { d_type(c) }, 1)
                if p == 0 {
                    uaccess.put(pml4, r + 19, 46, 1)
                } else if p == 1 {
                    uaccess.put(pml4, r + 19, 46, 1)
                    uaccess.put(pml4, r + 20, 46, 1)
                } else if na != 0 {
                    let _ok = uaccess.copy_out(pml4, r + 19, na, nl)
                } else if ty(c) == T_SYN {
                    var j: u64 = 0
                    while j < nl {
                        uaccess.put(pml4, r + 19 + j, procfs.name_byte(rf(c), j), 1) // px25: a pid's digits too
                        j += 1
                    }
                } else if ty(c) == T_BLK {
                    var j: u64 = 0
                    while j < nl {
                        uaccess.put(pml4, r + 19 + j, block.name_byte(rf(c) & 0xffff, j), 1) // px79
                        j += 1
                    }
                } else {
                    var j: u64 = 0
                    for b in fixed_name(c).bytes() {
                        uaccess.put(pml4, r + 19 + j, b as int as u64, 1)
                        j += 1
                    }
                }
                used += rec
                p = next
            }
        }
    }
    set_pos(a, fd, p)
    used
}

// --- px79: block devices' nodes ------------------------------------------------------
//
// A node of /dev names a device of kernel/block's (`blk_node`); opened, it
// is K_BLK, an open file with an offset like a file's. Its I/O is raw: a
// read or a write goes to the device in whole sectors through kernel/block's
// bounce frame (up to eight at a time: a 4 KiB piece of the device), any
// length at any offset (R-px79-4, recommended and implemented, not decided:
// the guest's answers, measured on Linux 7.3.0: a 100-byte read at offset 3
// answers 100; a read across the end is short and one at the end 0; a write
// across the end is short, one at or past it -ENOSPC; lseek outside 0 to the
// size -EINVAL, SEEK_DATA and SEEK_HOLE -EINVAL; a read-only disk's writes
// -EPERM, even of no bytes). A partial sector is read, changed and written
// back. Nothing is cached on the way: a raw write goes to the device before
// it returns, and every clean cached block of the same disk it touched is
// forgotten (kernel/block's `raw_wrote`), so a mount after it reads what it
// wrote; a block a mounted file system holds dirty is left to the user, as
// Linux leaves it (the note says so; no lock).

/// px79: open block device node `n` (`openat`'s): the class rule (0600,
/// root's), -ENOTDIR for O_DIRECTORY (measured), an O_EXCL open (without
/// O_CREAT) exclusive (kernel/block's `open_dev`: -EBUSY while the device,
/// its disk or a partition of it is mounted or held so); O_TRUNC and
/// O_CREAT do nothing to a device (measured: the open answers).
fn blk_open(a: u64, n: u64, flags: u64, want: u64) -> u64 {
    let d = blk_dev(n)
    if d == block.DEVS {
        return neg(ENXIO)
    }
    if flags & O_DIRECTORY != 0 {
        return neg(ENOTDIR)
    }
    if !may(a, cred.FS, n, want) {
        return neg(EACCES)
    }
    let excl = flags & O_EXCL != 0 && flags & O_CREAT == 0
    let r = block.open_dev(d, excl)
    if r != 0 {
        return r
    }
    let fl = (flags & !(O_CREAT | O_TRUNC | O_EXCL)) | (if excl { O_EXCL } else { 0 })
    let fd = open_new(a, 0, K_BLK, n, fl)
    if fd >= 0x8000000000000000 {
        block.close_dev(d, excl)
    }
    fd
}

/// px79: `n` bytes at byte `off` of device `d` to user `buf`: the count
/// (short at the end, 0 at or past it), -EFAULT (the whole of what would be
/// read is checked first), -EIO (the device's error before anything was
/// read; after, the count so far), -ENXIO for a device taken away.
fn blk_in(pml4: u64, d: u64, off: u64, buf: u64, n: u64) -> u64 {
    if d == block.DEVS {
        return neg(ENXIO)
    }
    let size = block.sectors(d) * 512
    if off >= size || n == 0 {
        return if uaccess.in_user(buf, 0) { 0 } else { neg(EFAULT) }
    }
    var k = if n < size - off { n } else { size - off }
    if k > 0x7ffff000 {
        k = 0x7ffff000
    }
    if !uaccess.writable(pml4, buf, k) {
        return neg(EFAULT)
    }
    let bf = block.bounce()
    if bf == 0 {
        return neg(ENOMEM)
    }
    let hh = frames.hhdm()
    let total = block.sectors(d)
    var done: u64 = 0
    while done < k {
        let p = off + done
        let s0 = (p / 4096) * 8
        let ns = if total - s0 < 8 { total - s0 } else { 8 }
        if block.rw(d, block.T_IN, s0, ns, bf) != 0 {
            return if done > 0 { done } else { neg(EIO) }
        }
        let inoff = p - s0 * 512
        let room = ns * 512 - inoff
        let piece = if k - done < room { k - done } else { room }
        let _ok = uaccess.copy_out(pml4, buf + done, bf + hh + inoff, piece)
        done += piece
    }
    done
}

/// px79: `n` bytes of user `buf` to byte `off` of device `d`: the count
/// (short across the end), -EPERM for a read-only disk (before anything,
/// even a write of no bytes: measured), -ENOSPC at or past the end
/// (measured), -EFAULT (checked whole first: nothing written), -EIO.
fn blk_out(pml4: u64, d: u64, off: u64, buf: u64, n: u64) -> u64 {
    if d == block.DEVS {
        return neg(ENXIO)
    }
    if block.flags(d) & block.F_RO != 0 {
        return neg(EPERM)
    }
    if n == 0 {
        return 0
    }
    let size = block.sectors(d) * 512
    if off >= size {
        return neg(ENOSPC)
    }
    var k = if n < size - off { n } else { size - off }
    if k > 0x7ffff000 {
        k = 0x7ffff000
    }
    if !uaccess.readable(pml4, buf, k) {
        return neg(EFAULT)
    }
    let bf = block.bounce()
    if bf == 0 {
        return neg(ENOMEM)
    }
    let hh = frames.hhdm()
    var done: u64 = 0
    while done < k {
        let p = off + done
        let chunk_end = (p / 4096 + 1) * 4096
        let piece = if k - done < chunk_end - p { k - done } else { chunk_end - p }
        // The sectors the piece touches, the first and last read first
        // when the piece does not cover them whole.
        let sa = p / 512
        let sb = (p + piece - 1) / 512
        let ns = sb - sa + 1
        if p % 512 != 0 || (p + piece) % 512 != 0 {
            if block.rw(d, block.T_IN, sa, ns, bf) != 0 {
                return if done > 0 { done } else { neg(EIO) }
            }
        }
        let _ok = uaccess.copy_in(pml4, bf + hh + (p - sa * 512), buf + done, piece)
        if block.rw(d, block.T_OUT, sa, ns, bf) != 0 {
            return if done > 0 { done } else { neg(EIO) }
        }
        block.raw_wrote(d, sa, ns)
        done += piece
    }
    done
}

/// px79: `write(fd, buf, n)` to a block device's node (kernel/user's
/// `write`, for `write_target`'s 9): at the open file's offset, which
/// moves past what was written.
pub fn blk_write(a: u64, pml4: u64, fd: u64, buf: u64, n: u64) -> u64 {
    let r = blk_out(pml4, blk_dev(node_of(a, fd)), pos(a, fd), buf, n)
    if r < 0x8000000000000000 {
        set_pos(a, fd, pos(a, fd) + r)
    }
    r
}

/// px79: `lseek` on a block device's node: SEEK_SET, SEEK_CUR, SEEK_END
/// to an offset from 0 to the device's size, else -EINVAL; any other
/// whence (SEEK_DATA, SEEK_HOLE included) -EINVAL (measured).
fn blk_seek(a: u64, fd: u64, off: u64, whence: u64) -> u64 {
    let d = blk_dev(node_of(a, fd))
    if d == block.DEVS {
        return neg(ENXIO)
    }
    let size = block.sectors(d) * 512
    var base: u64 = 0
    if whence == 1 {
        base = pos(a, fd)
    } else if whence == 2 {
        base = size
    } else if whence != 0 {
        return neg(EINVAL)
    }
    var p: u64 = 0
    if off < 0x8000000000000000 {
        if off > size || base > size - off {
            return neg(EINVAL)
        }
        p = base + off
    } else {
        let back = 0xffffffffffffffff - off + 1
        if back > base {
            return neg(EINVAL)
        }
        p = base - back
    }
    set_pos(a, fd, p)
    p
}

// The block ioctls (uapi linux/fs.h, linux/hdreg.h, linux/blkpg.h).
const BLKROGET: u64 = 0x125e
const BLKRRPART: u64 = 0x125f
const BLKGETSIZE: u64 = 0x1260
const BLKFLSBUF: u64 = 0x1261
const BLKSSZGET: u64 = 0x1268
const BLKPG: u64 = 0x1269
const BLKBSZGET: u64 = 0x80081270
const BLKGETSIZE64: u64 = 0x80081272
const BLKIOMIN: u64 = 0x1278
const BLKIOOPT: u64 = 0x1279
const BLKALIGNOFF: u64 = 0x127a
const BLKPBSZGET: u64 = 0x127b
const BLKDISCARDZEROES: u64 = 0x127c
const BLKROTATIONAL: u64 = 0x127e
const BLKGETDISKSEQ: u64 = 0x80081280
const HDIO_GETGEO: u64 = 0x0301
const BLKPG_ADD_PARTITION: u64 = 1
const BLKPG_DEL_PARTITION: u64 = 2

/// px79: write `v`'s `width` low bytes at user `arg`: 0 or -EFAULT.
fn put_arg(pml4: u64, arg: u64, v: u64, width: u64) -> u64 {
    if !uaccess.writable(pml4, arg, width) {
        return neg(EFAULT)
    }
    uaccess.put(pml4, arg, v, width)
    0
}

/// px79: `ioctl` on a block device's node, each answer and width measured
/// on the guest (Linux 7.3.0, virtio-blk; tests/mpx6-nodes.d/linux/):
/// BLKGETSIZE64 the bytes (u64), BLKGETSIZE the sectors (unsigned long),
/// BLKSSZGET the logical block (int), BLKPBSZGET and BLKIOMIN the same
/// (unsigned int: the device states no other), BLKIOOPT 0, BLKALIGNOFF 0,
/// BLKDISCARDZEROES 0, BLKROGET 1 for a read-only disk (int), BLKBSZGET
/// the soft block size (int: kernel/block's `soft_block`), BLKROTATIONAL 1
/// (u16: virtio-blk states none), BLKGETDISKSEQ the disk's sequence (u64),
/// HDIO_GETGEO the device's geometry (16 bytes: heads, sectors, the u16
/// cylinders, then the first sector as an unsigned long, its padding
/// written as zeros); for root: BLKFLSBUF (what the cache holds of the
/// device written and forgotten), BLKRRPART (kernel/block's `rescan`),
/// BLKPG's ADD_PARTITION and DEL_PARTITION (`blkpg_add`, `blkpg_del`), each
/// -EACCES to a user (ioctl_list(2): CAP_SYS_ADMIN). Any other request of
/// the block (0x12) and HDIO (0x03) families is refused by name, -ENOTTY;
/// anything else -ENOTTY, as Linux answers (measured: TCGETS, FIONREAD,
/// FS_IOC_GETFLAGS, 0x1234).
fn blk_ioctl(a: u64, pml4: u64, fd: u64, req: u64, arg: u64) -> u64 {
    let d = blk_dev(node_of(a, fd))
    if d == block.DEVS {
        return neg(ENXIO)
    }
    let lbs = block.lbs(d)
    if req == BLKGETSIZE64 {
        return put_arg(pml4, arg, (block.sectors(d) - 1) * 512, 8) // px79-plant-size: one sector short
    }
    if req == BLKGETSIZE {
        return put_arg(pml4, arg, block.sectors(d), 8)
    }
    if req == BLKSSZGET || req == BLKPBSZGET || req == BLKIOMIN {
        return put_arg(pml4, arg, lbs, 4)
    }
    if req == BLKIOOPT || req == BLKALIGNOFF || req == BLKDISCARDZEROES {
        return put_arg(pml4, arg, 0, 4)
    }
    if req == BLKROGET {
        return put_arg(pml4, arg, if block.flags(d) & block.F_RO != 0 { 1 } else { 0 }, 4)
    }
    if req == BLKBSZGET {
        return put_arg(pml4, arg, block.soft_block(d), 4)
    }
    if req == BLKROTATIONAL {
        return put_arg(pml4, arg, 1, 2)
    }
    if req == BLKGETDISKSEQ {
        return put_arg(pml4, arg, block.diskseq(d), 8)
    }
    if req == HDIO_GETGEO {
        let (h, sp, c) = block.geometry(d)
        if h == 0 {
            refuse(a, R_BLKIOCTL)
            return neg(ENOTTY) // the device offers no geometry
        }
        if !uaccess.writable(pml4, arg, 16) {
            return neg(EFAULT)
        }
        uaccess.zero(pml4, arg, 16)
        uaccess.put(pml4, arg, h, 1)
        uaccess.put(pml4, arg + 1, sp, 1)
        uaccess.put(pml4, arg + 2, c & 0xffff, 2)
        uaccess.put(pml4, arg + 8, block.start_of(d), 8)
        return 0
    }
    if req == BLKFLSBUF || req == BLKRRPART || req == BLKPG {
        if !cred.privileged(a) {
            return neg(EACCES)
        }
        if req == BLKFLSBUF {
            let e = block.sync(d)
            block.forget(d)
            return e
        }
        if req == BLKRRPART {
            return block.rescan(d)
        }
        // struct blkpg_ioctl_arg { int op; int flags; int datalen; void *data; }
        // and struct blkpg_partition { long long start, length; int pno; … }
        if !uaccess.readable(pml4, arg, 24) {
            return neg(EFAULT)
        }
        let op = uaccess.get(pml4, arg, 4)
        let data = uaccess.get64(pml4, arg + 16)
        if !uaccess.readable(pml4, data, 20) {
            return neg(EFAULT)
        }
        let start = uaccess.get64(pml4, data)
        let len = uaccess.get64(pml4, data + 8)
        let pno = uaccess.get(pml4, data + 16, 4)
        if op == BLKPG_ADD_PARTITION {
            return block.blkpg_add(d, if pno >= 0x80000000 { 0 } else { pno }, start, len)
        }
        if op == BLKPG_DEL_PARTITION {
            return block.blkpg_del(d, if pno >= 0x80000000 { 0 } else { pno })
        }
        refuse(a, R_BLKIOCTL) // BLKPG_RESIZE_PARTITION and the rest
        return neg(EINVAL)
    }
    let fam = (req >> 8) & 0xff
    if fam == 0x12 || fam == 0x03 {
        refuse(a, R_BLKIOCTL)
    }
    neg(ENOTTY)
}

// --- px62: FIFOs, flock, and what a mapping maps -------------------------------------

/// px62: `mknodat(dirfd, path, mode, dev)` (and `mknod`, with AT_FDCWD;
/// `mknod(2)`): a FIFO (S_IFIFO, kernel/tree's `mkfifo`) or an empty
/// regular file (S_IFREG, or no type), its permission bits `mode &
/// ~umask` (the sticky bit kept, as measured), stamped as `openat`
/// stamps a new file. -EEXIST, -ENOENT, -EACCES, -ENOSPC as `mkdirat`;
/// -EINVAL for a type that is none. A device node is root's to make
/// (-EPERM to a user, px45) and is refused by name, -EPERM: PAX makes
/// none; so is a socket's name (`bind` makes one).
pub fn mknodat(a: u64, pml4: u64, dirfd: u64, va: u64, mode: u64) -> u64 {
    let t = mode & S_IFMT
    if t == S_IFCHR || t == S_IFBLK {
        if !cred.privileged(a) {
            return neg(EPERM)
        }
        return refused(a, 0)
    }
    if t == S_IFSOCK {
        refuse(a, R_SOCKNODE)
        return neg(EPERM)
    }
    if t != 0 && t != S_IFREG && t != S_IFIFO {
        return neg(EINVAL)
    }
    let (n, par, ns, nl, _trail) = walk(a, pml4, dirfd, va, false, F_NEVER)
    if !is_err(n) {
        return neg(EEXIST)
    }
    if rf(n) != ENOENT || is_err(par) {
        return neg(rf(n))
    }
    if ty(par) == T_SYN {
        return neg(ENOENT)
    }
    if !may_make(a, par) {
        return neg(EACCES)
    }
    if ty(par) != T_INO {
        refuse(a, R_DEVRO)
        return neg(EROFS)
    }
    let (su, sg, _dg) = stamp(a, rf(par))
    let perm = file_perm(a, mode & !mask_of(a) & 0xfff, sg)
    let i = if t == S_IFIFO { tree.mkfifo(rf(par), raw() + ns, nl, perm, su, sg) } else { tree.create(rf(par), raw() + ns, nl, perm, su, sg) }
    if tree.failed(i) {
        return i
    }
    0
}

/// px62: an open of FIFO `i` (`openat`, the class rule asked), by
/// fifo(7)'s rules: a reader waits until a writer opens, a writer until
/// a reader opens; O_NONBLOCK's read end opens at once, its write end at
/// once with a reader and -ENXIO without; O_RDWR opens at once (Linux's
/// answer, which POSIX leaves undefined). A waiting open counts as its
/// end from the start (so the other end's open goes on at once, and a
/// reader that has gone on reads no end of file while its writer is
/// still opening, measured), and goes on once the other end's count of
/// opens has moved (an end opened and closed again while it waited lets
/// it on too); the thread's `fifo` word says a run is the same call run
/// again. The ends share one pipe buffer (kernel/files' pipe record, made
/// at the first open, gone with the last end with what was in it), so
/// reads, writes, end of file, SIGPIPE, `poll` and F_GETPIPE_SZ are a
/// pipe's; `fstat` of an end answers the FIFO (`stat_node`). A signal
/// ends a waiting open as it ends a pipe's waiting read, and takes its
/// count back (`fifo_abandon`).
fn fifo_open(a: u64, i: u64, flags: u64) -> u64 {
    let acc = flags & O_ACCMODE
    let nb = flags & O_NONBLOCK != 0
    let mine = (i + 1) | ((acc + 1) << 16)
    let w = sched.self_fifo()
    if w != 0 && w & 0xffffffff == mine {
        // The waiting open, run again: on once the other end is there or
        // has been opened since.
        let p = tree.fifo_pipe(i) - 1
        let present = if acc == O_RDONLY { ppw(p, P_WRITERS) } else { ppw(p, P_READERS) }
        let now = if acc == O_RDONLY { tree.fifo_opens(i, 1) } else { tree.fifo_opens(i, 0) }
        if present == 0 && now == w >> 32 {
            return WAIT
        }
        sched.set_self_fifo(0)
        unpend(p, acc) // its count goes to its open file (`of_new`)
        let fd = open_new(a, 0, K_PIPE, (T_PIPE << T_SHIFT) | p, flags)
        if fd >= 0x8000000000000000 {
            pipe_settle(p)
        }
        return fd
    }
    let p0 = tree.fifo_pipe(i)
    let rd = if p0 == 0 { 0 } else { ppw(p0 - 1, P_READERS) }
    if acc == O_WRONLY && nb && rd == 0 {
        return neg(ENXIO)
    }
    if lowest_free(a, 0) == FDS {
        return neg(EMFILE)
    }
    if !of_room() {
        return neg(ENFILE)
    }
    var p = p0
    if p == 0 {
        let q = pipe_new(PIPE_PAGES)
        if q == PIPES {
            return neg(ENFILE)
        }
        put_ppw(q, P_OWNER, fs_ids(a))
        put_ppw(q, P_FIFO, i + 1)
        tree.set_fifo_pipe(i, q + 1)
        tree.hold(i) // the buffer holds its FIFO (a name removed while an end is open)
        p = q + 1
    }
    p = p - 1
    if acc != O_WRONLY {
        tree.fifo_opened(i, 0)
    }
    if acc != O_RDONLY {
        tree.fifo_opened(i, 1)
    }
    sched.wake_pipes() // a waiting open of the other end may go on
    if !nb && acc != O_RDWR {
        let present = if acc == O_RDONLY { ppw(p, P_WRITERS) } else { ppw(p, P_READERS) }
        if present == 0 {
            let seen = if acc == O_RDONLY { tree.fifo_opens(i, 1) } else { tree.fifo_opens(i, 0) }
            if acc == O_RDONLY {
                put_ppw(p, P_READERS, ppw(p, P_READERS) + 1)
            } else {
                put_ppw(p, P_WRITERS, ppw(p, P_WRITERS) + 1)
            }
            sched.set_self_fifo(mine | (seen << 32))
            return WAIT
        }
    }
    let fd = open_new(a, 0, K_PIPE, (T_PIPE << T_SHIFT) | p, flags)
    if fd >= 0x8000000000000000 {
        pipe_settle(p)
    }
    fd
}

/// px62: a waiting open's count on buffer `p` taken back (access `acc`).
fn unpend(p: u64, acc: u64) {
    if acc == O_RDONLY {
        put_ppw(p, P_READERS, ppw(p, P_READERS) - 1)
    } else {
        put_ppw(p, P_WRITERS, ppw(p, P_WRITERS) - 1)
    }
}

/// px62: the FIFO-open wait word `w` (kernel/sched's) is over without
/// its open: its count goes back, and the buffer with it when nothing
/// else holds it (a signal ended the wait, or its process ended).
fn abandon(w: u64) {
    if w == 0 {
        return
    }
    let i = (w & 0xffff) - 1
    let acc = ((w >> 16) & 3) - 1
    let p1 = tree.fifo_pipe(i)
    if p1 == 0 {
        return
    }
    unpend(p1 - 1, acc)
    pipe_settle(p1 - 1)
    sched.wake_pipes()
}

/// px62: kernel/signal, as a signal ends (or restarts) a wait: the
/// running thread's FIFO open, if that is what waited, gives its count
/// back (a restarted call counts it again from nothing).
pub fn fifo_abandon() {
    let w = sched.self_fifo()
    sched.set_self_fifo(0)
    abandon(w)
}

/// px62: whether an open file of kind `k` keeps a `flock` lock (word
/// O_LOCK): a file's, a directory's, a pipe's or a FIFO's end.
fn locks(k: u64) -> bool {
    k == K_FILE || k == K_DIR || k == K_PIPE || k == K_BLK // px79: sfdisk locks the disk it writes
}

/// px62: whether an open file other than `i` on `i`'s node holds a lock
/// that refuses a lock of kind `want`.
fn lock_conflict(i: u64, want: u64) -> bool {
    let n = ofw(i, O_NODE)
    var j: u64 = 0
    while j < OFILES {
        if j != i && ofw(j, O_REFS) != 0 && ofw(j, O_NODE) == n && locks(ofw(j, O_KIND)) {
            let l = ofw(j, O_LOCK)
            if l == LK_EX || (l == LK_SH && want == LK_EX) {
                return true
            }
        }
        j += 1
    }
    false
}

/// px62: `flock(fd, operation)` (`flock(2)`, s254's `[os.fs.lock]`): an
/// advisory lock on the open file `fd` names, so duplicates and a fork's
/// copies share it and a second `open` of the same file is another
/// holder (measured). LOCK_SH with other shared locks, LOCK_EX alone;
/// LOCK_UN drops it (0 when none is held); a conflicting lock waits,
/// or with LOCK_NB is -EWOULDBLOCK (-EAGAIN); a signal ends a wait as it
/// ends a pipe's. A conversion drops the held lock first (`flock(2)`:
/// not atomic; measured: a LOCK_NB conversion that is refused leaves no
/// lock). The last close of the open file drops its lock. -EBADF for a
/// closed descriptor, -EINVAL for an operation that is none. Refused by
/// name, -ENOLCK: a descriptor PAX keeps no open file or lock word for.
pub fn flock(a: u64, fd: u64, op: u64) -> u64 {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return neg(EBADF)
    }
    let nb = op & LOCK_NB != 0
    let o = op & !LOCK_NB
    if o != LOCK_SH && o != LOCK_EX && o != LOCK_UN {
        return neg(EINVAL)
    }
    let of = of_of(a, fd)
    if of == 0 || !locks(k) {
        refuse(a, R_FLOCK)
        return neg(ENOLCK)
    }
    let i = of - 1
    let cur = ofw(i, O_LOCK)
    if o == LOCK_UN {
        if cur != 0 {
            put_ofw(i, O_LOCK, 0)
            sched.wake_pipes() // a waiting `flock` may have it now
        }
        return 0
    }
    let want = if o == LOCK_SH { LK_SH } else { LK_EX }
    if cur == want {
        return 0
    }
    if cur != 0 {
        put_ofw(i, O_LOCK, 0) // a conversion: the held lock goes first
        sched.wake_pipes()
    }
    if lock_conflict(i, want) {
        if nb {
            return neg(EAGAIN)
        }
        return WAIT
    }
    put_ofw(i, O_LOCK, want)
    0
}

/// px62: what `mmap` finds a descriptor names (kernel/user's
/// `mmap_call`): MT_FILE, a regular file of the tree.
pub const MT_FILE: u64 = 1
/// px62: /dev/zero (anonymous memory, private or shared).
pub const MT_ZERO: u64 = 2
const MT_ERR: u64 = 0

/// px62: (MT_FILE, the inode, what the descriptor allows a mapping:
/// kernel/vm's ACC_READ, ACC_WRITE, ACC_APPEND), (MT_ZERO, 0, 0), or
/// (MT_ERR, -errno, 0): -EBADF for a closed descriptor, -ENODEV for
/// what cannot be mapped (a directory, a pipe, a FIFO, a socket, the
/// console, /dev/null, /proc: measured for the first three and
/// /dev/null).
pub fn map_target(a: u64, fd: u64) -> (u64, u64, u64) {
    let k = kind(a, fd)
    if k == K_CLOSED {
        return (MT_ERR, neg(EBADF), 0)
    }
    let n = node_of(a, fd)
    if k == K_NULL && ty(n) == T_NULL && rf(n) == ZERO {
        return (MT_ZERO, 0, 0)
    }
    if k == K_FILE && ty(n) == T_INO && tree.is_regular(rf(n)) {
        let acc = access(a, fd)
        var m: u64 = 0
        if acc != O_WRONLY {
            m = m | vm.ACC_READ
        }
        if acc != O_RDONLY {
            m = m | vm.ACC_WRITE
        }
        if status(a, fd) & O_APPEND != 0 {
            m = m | vm.ACC_APPEND
        }
        return (MT_FILE, rf(n), m)
    }
    (MT_ERR, neg(ENODEV), 0)
}
