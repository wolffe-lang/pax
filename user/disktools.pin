# The partition and FAT tools px66 runs, BY DIGEST (tools/disktools).
#
# Ubuntu 24.04's own packages, the release of the image tools/e2fs pins
# (docker.io/library/ubuntu@sha256:534baea6…, whose util-linux,
# libsmartcols1, libuuid1, libstdc++6 and libncursesw6 they link
# against): sfdisk (fdisk, with libfdisk1 and libreadline8t64) and
# sgdisk (gdisk, with libpopt0) as the partition table's oracles,
# mkfs.fat and fsck.fat (dosfstools) for the EFI system partition, and
# mtools (mcopy, mmd, mdir) to put files in it without a mount. Each
# .deb is fetched from Ubuntu's archive (Launchpad's librarian as the
# fallback, the same file), refused on a sha256 mismatch, unpacked by
# dpkg-deb inside the pinned image, and run there; no package script
# runs, nothing is installed, and the host's own tools are never used.
# Black-box (ruling #22): run, never read. The MD5 of each matched
# apt's index of the image's release (2026-10-23).
DISKTOOLS_DEBS="dosfstools mtools fdisk libfdisk1 libreadline8t64 gdisk libpopt0"
dosfstools_FILE=dosfstools_4.2-1.1build1_amd64.deb
dosfstools_POOL=main/d/dosfstools
dosfstools_SHA256=ace1ecc42b4d842f8e7a931933824a626dcdb7d4916470833f330ccad82afd63
mtools_FILE=mtools_4.0.43-1build1_amd64.deb
mtools_POOL=main/m/mtools
mtools_SHA256=deb50411c17b001c2400dd8a0146f39d12070a2fe5e92d734b1c6d0e73119262
fdisk_FILE=fdisk_2.39.3-9ubuntu6.6_amd64.deb
fdisk_POOL=main/u/util-linux
fdisk_SHA256=4a27cce5a9ad937298ce82722912e8ceefd123773de5c39fa8cf2a2f61cf4657
libfdisk1_FILE=libfdisk1_2.39.3-9ubuntu6.6_amd64.deb
libfdisk1_POOL=main/u/util-linux
libfdisk1_SHA256=7f67b127d239f51218c1eb63c3b0c219bbf26f450349bed9ad5d9f10a6b80c1b
libreadline8t64_FILE=libreadline8t64_8.2-4build1_amd64.deb
libreadline8t64_POOL=main/r/readline
libreadline8t64_SHA256=563977a16df03b611f5239cc1e9a0426e86479fcc616b5c9e200ea32063119e5
gdisk_FILE=gdisk_1.0.10-1build1_amd64.deb
gdisk_POOL=main/g/gdisk
gdisk_SHA256=4d899a8d2baf3296bdc566924330f534bb8d345ffedea194b588864d7c0469ba
libpopt0_FILE=libpopt0_1.19+dfsg-1build1_amd64.deb
libpopt0_POOL=main/p/popt
libpopt0_SHA256=b3e7ea5192e57c847b77c527d51f5b8d4bce47988d2ba326a5c3193f6d173ded
