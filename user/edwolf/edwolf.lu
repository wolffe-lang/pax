// edwolf — what wolf 0.2.34 asks of PAX (px57): s247's `os_fork` and
// its busy rule, and s248's calls for an editor (wolf-lang#794–#798,
// #802; the spec's `[os.proc.fork]`, `[os.signal.wait.fds]`,
// `[os.term.mode]`'s bits 5–7, `[os.term.restore]`, `[os.fs.sync]`
// with the exclusive create of `[os.fs.open]`, `[os.fs.realpath]`,
// `[os.clock.ns]`), built for Linux by its own pinned wolf
// (user/edwolf/wolf-toolchain.toml, tools/mkedwolf), linked static, run
// unmodified on PAX and on Linux and held to Linux as root and as a user
// (tests/mpx5-jobs' `eds` image).
//
// Run with no argument it is the parent: it prints every row, and
// starts itself again (`os_exe()`) with one MODE for each child whose
// end it reports:
//
//   restore-return   registers the terminal's restore, sets a raw mode,
//                    returns from main (started with the parent's
//                    descriptor 0, the terminal: a plain spawn's 0 is
//                    the null device, `[os.proc.spawn]`)
//   restore-exit     the same, then `os_exit(3)`
//   restore-trap     the same, then a trap (an index past the end: 134)
//   restore-signal   the same, then `os_exit_signal(TERMINATE)`
//
// Every file it makes is under /tmp/ed-UID (root's run and the user's
// apart). A line that starts with `~` is PAX's own by design or by a
// named gap and is left out of the comparison with Linux by name
// (tests/mpx5-jobs' J13 says which): the clock's granularity.

fn ended(st: int) -> str {
    if st >= 0 {
        return "exit {st}"
    }
    if st <= -256 {
        return "signal {0 - st - 256} core"
    }
    "signal {0 - st}"
}

fn bit(m: int, b: int) -> bool {
    (m / b) % 2 == 1
}

fn oct(n: int) -> str {
    if n < 8 {
        return "{n}"
    }
    "{oct(n / 8)}{n % 8}"
}

/// One fork, answered as a row: `busy` (before the host is asked),
/// `io`, `unsupported`, or the child's end (the child exits at once).
fn fork_answer() -> str {
    let r = os_fork() else |e| {
        return match e {
            busy => "busy",
            io => "io",
            unsupported => "unsupported",
        }
    }
    if r.0 == 0 {
        os_exit(0)
    }
    let st = os_wait_status(r.1) else |e| {
        return match e {
            io => "ok, the wait io",
        }
    }
    "ok, the child {ended(st)}"
}

fn fork_rows(dir: str) -> !int {
    let parent = os_pid()
    let p = os_pipe()?
    let f = fs_create("{dir}/offset")?
    fs_write(f, "a")?
    let r = os_fork() else |e| {
        let t = match e {
            busy => "busy",
            io => "io",
            unsupported => "unsupported",
        }
        print("K: fork from main, no task live: {t}")
        return 0
    }
    if r.0 == 0 {
        fs_write(f, "b")?
        let pp = os_ppid()?
        let fresh = os_pid() != parent
        fs_write(p.1, "the child's pid new {fresh}, its ppid the parent's {pp == parent}, its answer ({r.0}, {r.1})")?
        os_exit(7)
    }
    let st = os_wait_status(r.1)?
    fs_write(f, "c")?
    fs_close(f)?
    print("K: fork from main, no task live: the parent's answer has a pid {r.0 > 0} and a handle {r.1 >= 0}")
    let said = fs_read(p.0, 200)?
    print("K: through a pipe made before the fork: {said}")
    print("K: the child {ended(st)}, read through its handle")
    let text = fs_read_text("{dir}/offset")?
    print("K: one write offset, the parent's a, the child's b, the parent's c after the wait: {text}")
    scope s {
        s.spawn(fn() {
            time_sleep_ms(300)
        })
        let b = fork_answer()
        print("K: fork inside a scope while a task is live: {b}")
    }
    scope t {
        t.spawn(fn() {
            let b = fork_answer()
            print("K: fork from a task: {b}")
        })
    }
    let again = fork_answer()
    print("K: fork after the scopes joined: {again}")
    0
}

fn wait_row(fds: List[int], set: int, deadline: int) -> str {
    let r = os_signal_wait_fds(fds, set, deadline) else |e| {
        return match e {
            invalid => "invalid",
            io => "io",
            unsupported => "unsupported",
        }
    }
    "({r.0}, {r.1})"
}

fn wait_rows() -> !int {
    let a = os_pipe()?
    let b = os_pipe()?
    print("W: deadline 0 over two quiet pipes: {wait_row([a.0, b.0], 512, 0)}")
    fs_write(b.1, "x")?
    print("W: the second pipe ready: {wait_row([a.0, b.0], 512, 0)}")
    fs_write(a.1, "y")?
    print("W: both ready, the lowest index: {wait_row([a.0, b.0], 512, 0)}")
    let c = os_pipe()?
    let d = os_pipe()?
    let t0 = os_clock_ns()
    let w = wait_row([c.0, d.0], 512, 50)
    let el = (os_clock_ns() - t0) / 1000000
    print("W: a 50 ms deadline over two quiet pipes: {w}, never early: {el >= 50}")
    os_signal_listen(512)?
    os_signal_raise(512)?
    print("W: USER raised to itself, a ready pipe beside it: the meaning wins: {wait_row([a.0], 512, -1)}")
    print("W: the ready pipe answers the next wait: {wait_row([a.0], 512, 0)}")
    print("W: deadline -2: {wait_row([c.0], 512, -2)}")
    print("W: an empty set: {wait_row([c.0], 0, 0)}")
    fs_close(d.0)?
    print("W: a closed handle: {wait_row([d.0], 512, 0)}")
    0
}

fn show(m: int) -> str {
    "canonical {bit(m, 1)}, echo {bit(m, 2)}, signals {bit(m, 4)}, flow {bit(m, 8)}, extended {bit(m, 16)}; raw_cr {bit(m, 32)}, raw_output {bit(m, 64)}, strip8 {bit(m, 128)}; vmin {(m / 256) % 256}, vtime {(m / 65536) % 256}"
}

/// The editor's raw mode as C yew's `cfmakeraw` sets it: canonical,
/// echo, signals, flow and extended off, RAW_CR and RAW_OUTPUT on, VMIN
/// and VTIME as found.
fn raw_of(m: int) -> int {
    (m / 256) * 256 + 32 + 64
}

fn restore_row(fd: int, mode: int) -> str {
    os_term_restore_at_exit(fd, mode, "".bytes()) else |e| {
        return match e {
            invalid => "invalid",
            io => "io",
            unsupported => "unsupported",
        }
    }
    "ok"
}

fn term_rows(exe: str) -> !int {
    let m0 = os_term_mode(0)?
    print("T: the terminal's mode as found: {show(m0)}")
    let three = m0 - (m0 % 256) + (m0 % 32) + 32 + 64 + 128
    os_term_set_mode(0, three)?
    let m1 = os_term_mode(0)?
    os_term_set_mode(0, m0)?
    let m2 = os_term_mode(0)?
    print("T: RAW_CR, RAW_OUTPUT and STRIP8 set and read back: {bit(m1, 32)} {bit(m1, 64)} {bit(m1, 128)}; the rest as set: {m1 % 32 == m0 % 32}")
    print("T: set back by hand, the mode as found: {m2 == m0}")
    for how in ["restore-return", "restore-exit", "restore-trap", "restore-signal"] {
        let h = os_spawn_fds(exe, [how], [0, 0])?
        let st = os_wait_status(h)?
        let m = os_term_mode(0)?
        print("T: {how}: the child {ended(st)}; the mode back: {m == m0}")
    }
    print("T: restore_at_exit of mode -1: {restore_row(0, -1)}")
    print("T: restore_at_exit of bit 24: {restore_row(0, 16777216)}")
    let p = os_pipe()?
    print("T: restore_at_exit of a pipe: {restore_row(p.0, m0)}")
    0
}

/// A child of term_rows: the restore registered, a raw mode set, then
/// the end MODE names.
fn restore_child(how: str) -> !int {
    let m0 = os_term_mode(0)?
    os_term_restore_at_exit(0, m0, "T: the runtime restored the terminal ({how})\n".bytes())?
    os_term_set_mode(0, raw_of(m0))?
    if how == "restore-exit" {
        os_exit(3)
    }
    if how == "restore-trap" {
        let xs = [1, 2]
        let i = xs.len + 3
        print("unreachable: {xs[i]}")
    }
    if how == "restore-signal" {
        os_exit_signal(2) else |e| {
            let t = match e {
                invalid => "invalid",
                unsupported => "unsupported",
            }
            eprint("exit_signal: {t}")
        }
    }
    0
}

fn sync_row(fd: int) -> str {
    fs_sync(fd) else |e| {
        return match e {
            io => "io ({os_error()})",
        }
    }
    "ok"
}

fn sync_dir_row(path: str) -> str {
    fs_sync_dir(path) else |e| {
        return match e {
            denied => "denied",
            invalid => "invalid",
            io => "io ({os_error()})",
            not_found => "not_found",
            unsupported => "unsupported",
        }
    }
    "ok"
}

fn open_row(path: str, mode: int) -> str {
    let h = fs_open_mode(path, mode) else |e| {
        return match e {
            denied => "denied",
            exists => "exists",
            invalid => "invalid",
            io => "io ({os_error()})",
            not_found => "not_found",
        }
    }
    fs_close(h) else |e| {
        return match e {
            io => "ok, the close io",
        }
    }
    "ok"
}

fn perm_row(path: str, mode: int, perm: int) -> str {
    let h = fs_open_perm(path, mode, perm) else |e| {
        return match e {
            denied => "denied",
            exists => "exists",
            invalid => "invalid",
            io => "io ({os_error()})",
            not_found => "not_found",
            unsupported => "unsupported",
        }
    }
    let st = fs_fstat(h) else |e| {
        return match e {
            denied => "ok, the fstat denied",
            io => "ok, the fstat io",
            not_found => "ok, the fstat not_found",
        }
    }
    let s = fs_stat(path) else |e| {
        return match e {
            denied => "ok, the stat denied",
            io => "ok, the stat io",
            not_found => "ok, the stat not_found",
        }
    }
    fs_close(h) else |e| {
        return match e {
            io => "ok, the close io",
        }
    }
    "ok, kind {st[0]}, mode {oct(s[4])}"
}

fn sync_rows(dir: str) -> !int {
    let f = fs_create("{dir}/f")?
    fs_write(f, "x")?
    print("S: fs_sync of a file: {sync_row(f)}")
    let p = os_pipe()?
    print("S: fs_sync of a pipe: {sync_row(p.1)}")
    fs_close(f)?
    print("S: fs_sync of a closed handle: {sync_row(f)}")
    print("S: fs_sync_dir of /tmp: {sync_dir_row("/tmp")}")
    print("S: fs_sync_dir of a file: {sync_dir_row("{dir}/f")}")
    print("S: fs_sync_dir of a missing name: {sync_dir_row("{dir}/missing")}")
    print("X: open mode 4, a new name: {open_row("{dir}/new", 4)}")
    print("X: open mode 4, the name taken: {open_row("{dir}/new", 4)}")
    print("X: open_perm mode 4 0o640, a new name: {perm_row("{dir}/perm", 4, 0o640)}")
    print("X: open_perm mode 4 0o640, the name taken: {perm_row("{dir}/perm", 4, 0o640)}")
    fs_write_text("{dir}/save", "the old bytes")?
    let t = fs_open_mode("{dir}/save.tmp", 4)?
    fs_write(t, "the new bytes")?
    fs_sync(t)?
    fs_close(t)?
    fs_rename("{dir}/save.tmp", "{dir}/save")?
    fs_sync_dir(dir)?
    let got = fs_read_text("{dir}/save")?
    print("S: the atomic save (an exclusive temporary, its write and sync, the rename, the directory's sync): {got}")
    0
}

fn rp(path: str) -> str {
    let r = fs_realpath(path) else |e| {
        return match e {
            io => "io ({os_error()})",
            not_found => "not_found",
        }
    }
    r
}

fn real_rows(dir: str) -> !int {
    fs_create_dir("{dir}/d")?
    fs_symlink("/etc", "{dir}/l")?
    fs_symlink("{dir}/nowhere", "{dir}/dangling")?
    fs_symlink("{dir}/loop2", "{dir}/loop1")?
    fs_symlink("{dir}/loop1", "{dir}/loop2")?
    print("R: /bin/../etc: {rp("/bin/../etc")}")
    print("R: a directory with a trailing slash: {rp("{dir}/d/")}")
    print("R: .. after a link to /etc: {rp("{dir}/l/..")}")
    print("R: a link to /etc: {rp("{dir}/l")}")
    print("R: a dangling link: {rp("{dir}/dangling")}")
    print("R: a missing name: {rp("{dir}/missing")}")
    print("R: the empty path: {rp("")}")
    print("R: a loop of links: {rp("{dir}/loop1")}")
    print("R: a name under a file: {rp("{dir}/f/x")}")
    os_chdir("{dir}/d")?
    print("R: . after a chdir: {rp(".")}")
    print("R: a relative name through a link: {rp("../l")}")
    os_chdir("/")?
    0
}

/// About 100 us of work on a fast machine (more under TCG).
fn work() -> int {
    var acc = 0
    var i = 0
    while i < 20000 {
        acc = (acc * 31 + i) % 1000003
        i = i + 1
    }
    acc
}

fn clock_rows() -> !int {
    var prev = os_clock_ns()
    var back = 0
    var i = 0
    while i < 10000 {
        let n = os_clock_ns()
        if n < prev {
            back = back + 1
        }
        prev = n
        i = i + 1
    }
    print("N: os_clock_ns over 10000 reads, backwards: {back}")
    let ms = time_now_ms()
    let ns = os_clock_ns()
    print("N: os_clock_ns / 1000000 read after time_now_ms, never smaller: {ns / 1000000 >= ms}")
    var zeros = 0
    var r = 0
    var sum = 0
    while r < 20 {
        let a = os_clock_ns()
        sum = sum + work()
        let b = os_clock_ns()
        if b - a == 0 {
            zeros = zeros + 1
        }
        r = r + 1
    }
    print("~N: twenty rounds of work read 0 ns in {zeros} of 20 (the work's sum {sum})")
    0
}

fn main() -> !int {
    let exe = os_exe()?
    let args = env_args()
    if args.len > 0 {
        return restore_child(args[0])
    }
    let uid = os_uid()?
    let who = if uid == 0 { "root" } else { "a user" }
    print("edwolf: px57's probe of wolf 0.2.34's calls, as {who}")
    let dir = "/tmp/ed-{uid}"
    fs_create_dir(dir)?
    let _ = fork_rows(dir)?
    let _ = wait_rows()?
    let _ = term_rows(exe)?
    let _ = sync_rows(dir)?
    let _ = real_rows(dir)?
    let _ = clock_rows()?
    print("edwolf: done")
    0
}
