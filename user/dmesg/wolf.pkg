// dmesg (px130): the kernel's log, read from /dev/kmsg (or syslog(2)), as util-linux's
// dmesg prints it. Builtins only, no wolf-std: `env` (its arguments), `fs` (standard
// output's writes), `ffi` and `unsafe` (raw.S's six system calls).
pkg {
    name: "pax/dmesg"
    version: "0.1.0"
    capabilities: [env, ffi, fs, unsafe]
    asm: ["raw.S"]
}
