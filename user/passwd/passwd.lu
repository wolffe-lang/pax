//! passwd — set, lock, unlock and show an account's password (px106, P5
//! lane U8's second half; ruling #75 R1 and R8's place, beside `su`).
//!
//! Installed set-user-ID root, as Ubuntu's (04755): /etc/shadow is root's,
//! mode 0600 (R-px106-1), and this is how a user changes their own line.
//! The hash is wolf-std's scrypt in crypt(5)'s `$7$` form, through
//! user/auth/pwhash.lu alone. **Enforced for honest programs; not a
//! boundary against an attacker** (R6): the kernel has never been fuzzed
//! or audited and loads programs at fixed addresses.
//!
//! References consulted: passwd(1), passwd(5), shadow(5) (Ubuntu 24.04's
//! manual pages) and black-box runs of Ubuntu 24.04's own passwd
//! (1:4.13+dfsg1-4ubuntu3.2) on a pseudo-terminal in a throwaway container
//! (notes/px106/auth-ct.sh). Never the source of shadow-utils, PAM, any
//! libc or crypt.
//!
//! **What it does** (each measured against Ubuntu's):
//! - `passwd [USER]`: root sets anyone's (`New password: `, `Retype new
//!   password: `, `passwd: password updated successfully`); a user sets
//!   only their own, after `Changing password for NAME.` and `Current
//!   password: ` (a wrong one: about 1.5 s, then `passwd: Authentication
//!   token manipulation error`, `passwd: password unchanged`, status 10).
//!   The new one is typed twice before it is judged. A mismatch: `Sorry,
//!   passwords do not match.`, about 2 s, the two lines (10). An empty one:
//!   `No password has been supplied.`; under six characters (a user only;
//!   root may choose any): `You must choose a longer password.`; the same
//!   as the old: `The password has not been changed.`; each asks again, up
//!   to three tries, then about 2 s and the two lines (10). Prompts go to /dev/tty, the
//!   echo off (user/auth/secret.lu); with no terminal they read standard
//!   input, and its end is `Password change has been aborted.` (root) or
//!   the two lines.
//! - `-S` (`--status`), `-S -a`: `NAME L|NP|P YYYY-MM-DD MIN MAX WARN
//!   INACTIVE`, an empty number shown as -1 and a date never set as
//!   `never`. `-l`, `-u`, `-d` (root only): `passwd: password changed.`;
//!   `-u` of a bare `!` refused with Ubuntu's two lines (3).
//! - `-R DIR` (`--root`, root only): the files under DIR. Ubuntu's chroots
//!   into DIR; this one reads DIR/etc/passwd and writes DIR/etc/shadow, so
//!   the installer can set a password on the tree it is about to write.
//! - Refusals as Ubuntu's: an unknown user (`passwd: user 'NAME' does not
//!   exist`, 1), another user's line for a user (`passwd: You may not view
//!   or modify password information for NAME.`, 1), `-l`, `-u`, `-d` or
//!   `-R` by a user (`passwd: Permission denied.`, 1).
//!
//! **What it does not, by name:** `-e`, `-i`, `-k`, `-n`, `-r`, `-w` and
//! `-x` (no ageing: the dates are written as Ubuntu's useradd writes them
//! and never read); pam_unix's other `obscure` checks (a palindrome, a
//! case change, a rotation, a password too like the old one); the
//! syslog line. A line /etc/shadow lacks for an account /etc/passwd
//! names is read as locked (`!`: `NAME L never -1 -1 -1 -1`; Ubuntu's
//! reads /etc/passwd's `x` and says `NAME P`), and written, as Ubuntu's
//! writes it (today's date, the rest empty), when the password is set.

use std.os.users

const TRIES: int = 3
const MIN_LEN: int = 6

struct Args {
    lock: bool,
    unlock: bool,
    delete: bool,
    status: bool,
    all: bool,
    quiet: bool,
    help: bool,
    root: str,
    names: List[str],
    error: str,
    refused: str,
}

fn main() -> int {
    let a = parse(env_args())
    if a.error.len > 0 {
        eprint("passwd: {a.error}")
        eprint_raw(usage())
        return 2
    }
    if a.refused.len > 0 {
        eprint("passwd: {a.refused}: not built in PAX's passwd (notes/px106-passwords.md)")
        eprint_raw(usage())
        return 2
    }
    if a.help {
        print_raw(usage())
        return 0
    }
    if a.names.len > 1 {
        eprint_raw(usage())
        return 2
    }
    let uid = os_uid() else -1
    let root = a.root
    if root.len > 0 && uid != 0 {
        eprint("passwd: Permission denied.")
        return 1
    }
    let ptext = fs_read_text("{root}/etc/passwd") else ""
    let me_name = (users.user_by_id(ptext, uid) else users.User { name: "", uid: uid, gid: 0, comment: "", home: "", shell: "" }).name
    if a.status && a.all {
        if uid != 0 {
            eprint("passwd: Permission denied.")
            return 1
        }
        let stext = shadow_text(root)
        for u in users.users(ptext) {
            print(status_line(shadow_entry(stext, u.name)))
        }
        return 0
    }
    let name = if a.names.len > 0 then a.names[0] else me_name
    if name.len == 0 {
        eprint("passwd: Cannot determine your user name.")
        return 1
    }
    let u = users.user_named(ptext, name) else |_| {
        eprint("passwd: user '{name}' does not exist")
        return 1
    }
    if uid != 0 && u.uid != uid {
        eprint("passwd: You may not view or modify password information for {name}.")
        return 1
    }
    if a.status {
        print(status_line(shadow_entry(shadow_text(root), name)))
        return 0
    }
    if a.lock || a.unlock || a.delete {
        if uid != 0 {
            eprint("passwd: Permission denied.")
            return 1
        }
        return change_field(root, name, a)
    }
    set_password(root, name, uid == 0, a.quiet)
}

/// -l, -u, -d: the field changed in place.
fn change_field(root: str, name: str, a: Args) -> int {
    if !shadow_lock(root) {
        eprint("passwd: cannot lock {root}/etc/shadow; try again later.")
        return 4
    }
    let text = shadow_text(root)
    var s = shadow_entry(text, name)
    if !has_line(text, name) {
        s = shadow_bare(name, "!")
    }
    if a.lock {
        if !s.field.starts_with("!") {
            s.field = "!" + s.field
        }
    } else if a.unlock {
        if s.field.starts_with("!") {
            let rest = s.field[1..]
            if rest.len == 0 {
                shadow_unlock(root)
                eprint("passwd: unlocking the password would result in a passwordless account.")
                eprint("You should set a password with usermod -p to unlock the password of this account.")
                return 3
            }
            s.field = rest
        }
    } else {
        s.field = ""
    }
    shadow_write(root, shadow_replace(text, s)) else |_| {
        shadow_unlock(root)
        eprint("passwd: cannot write {root}/etc/shadow")
        eprint("passwd: password unchanged")
        return 4
    }
    shadow_unlock(root)
    if !a.quiet {
        print("passwd: password changed.")
    }
    0
}

fn has_line(text: str, name: str) -> bool {
    for line in text.split("\n") {
        let s = shadow_parse(line) else |_| {
            continue
        }
        if s.name == name {
            return true
        }
    }
    false
}

/// The terminal, or -1 (then standard input, as Ubuntu's reads it).
fn ask(tty: int, prompt: str) -> str ! {eof, interrupted, io} {
    if tty >= 0 {
        return secret_ask(tty, prompt) else |e| match e {
            eof => {
                return eof
            },
            interrupted => {
                return interrupted
            },
            _ => {
                return io
            },
        }
    }
    print_raw(prompt)
    secret_read(0, -1, false, 0) else |e| match e {
        eof => {
            return eof
        },
        interrupted => {
            return interrupted
        },
        _ => {
            return io
        },
    }
}

fn unchanged() -> int {
    eprint("passwd: Authentication token manipulation error")
    eprint("passwd: password unchanged")
    10
}

fn set_password(root: str, name: str, privileged: bool, quiet: bool) -> int {
    let tty = secret_tty()
    let text0 = shadow_text(root)
    let old = shadow_entry(text0, name)
    if !privileged {
        print("Changing password for {name}.")
        let cur = ask(tty, "Current password: ") else |_| {
            return unchanged()
        }
        if !pw_matches(cur, old.field) {
            time_sleep_ms(1500)
            return unchanged()
        }
    }
    var tries = 0
    var chosen = ""
    while tries < TRIES {
        tries += 1
        let first = ask(tty, "New password: ") else |e| match e {
            eof => {
                if privileged {
                    eprint("Password change has been aborted.")
                }
                return unchanged()
            },
            _ => {
                return unchanged()
            },
        }
        let again = ask(tty, "Retype new password: ") else |_| {
            return unchanged()
        }
        if first.len == 0 && again.len == 0 {
            eprint("No password has been supplied.")
            continue
        }
        if again != first {
            eprint("Sorry, passwords do not match.")
            time_sleep_ms(2000)
            return unchanged()
        }
        if !privileged && first.len < MIN_LEN {
            eprint("You must choose a longer password.")
            continue
        }
        if !privileged && pw_matches(first, old.field) {
            eprint("The password has not been changed.")
            continue
        }
        chosen = first
        break
    }
    if chosen.len == 0 {
        time_sleep_ms(2000)
        return unchanged()
    }
    if tty >= 0 {
        fs_close(tty) else |_| {
        }
    }
    let hashed = pw_make(chosen) else |_| {
        eprint("passwd: the hash could not be made")
        return unchanged()
    }
    if !shadow_lock(root) {
        eprint("passwd: cannot lock {root}/etc/shadow; try again later.")
        return unchanged()
    }
    let text = shadow_text(root)
    var s = shadow_entry(text, name)
    if !has_line(text, name) {
        s = shadow_bare(name, hashed)
    }
    s.field = hashed
    s.rest[0] = "{shadow_today()}"
    shadow_write(root, shadow_replace(text, s)) else |_| {
        shadow_unlock(root)
        return unchanged()
    }
    shadow_unlock(root)
    if !quiet {
        print("passwd: password updated successfully")
    }
    0
}

/// `passwd -S`'s line.
fn status_line(s: Shadow) -> str {
    let date = day_text(s.rest[0])
    "{s.name} {shadow_state(s.field)} {date} {num(s.rest[1])} {num(s.rest[2])} {num(s.rest[3])} {num(s.rest[4])}"
}

fn num(f: str) -> str {
    if f.len == 0 then "-1" else f
}

/// Days since 1970-01-01 as YYYY-MM-DD (UTC), `never` when empty.
fn day_text(f: str) -> str {
    if f.len == 0 {
        return "never"
    }
    let days = f.to_int() else -1
    if days < 0 {
        return "never"
    }
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 then mp + 3 else mp - 9
    let yy = if m <= 2 then y + 1 else y
    "{yy}-{two(m)}-{two(d)}"
}

fn two(n: int) -> str {
    if n < 10 then "0{n}" else "{n}"
}

fn parse(args: List[str]) -> Args {
    var a = Args {
        lock: false, unlock: false, delete: false, status: false, all: false, quiet: false, help: false,
        root: "", names: List[str](), error: "", refused: "",
    }
    var i = 0
    var rest = false
    while i < args.len {
        let w = args[i]
        i += 1
        if rest || w == "-" || !w.starts_with("-") {
            (mut a.names).push(w)
            continue
        }
        if w == "--" {
            rest = true
            continue
        }
        if w.starts_with("--") {
            let body = w[2..]
            let eq = body.find("=") else -1
            let name = if eq >= 0 then body[0..eq] else body
            if name == "lock" {
                a.lock = true
            } else if name == "unlock" {
                a.unlock = true
            } else if name == "delete" {
                a.delete = true
            } else if name == "status" {
                a.status = true
            } else if name == "all" {
                a.all = true
            } else if name == "quiet" {
                a.quiet = true
            } else if name == "help" {
                a.help = true
            } else if name == "root" {
                if eq >= 0 {
                    a.root = body[eq + 1..]
                } else if i < args.len {
                    a.root = args[i]
                    i += 1
                } else {
                    a.error = "option '--root' requires an argument"
                }
            } else if name == "expire" || name == "keep-tokens" || name == "inactive" || name == "mindays" ||
                name == "repository" || name == "warndays" || name == "maxdays" {
                if a.refused.len == 0 {
                    a.refused = w
                }
            } else {
                a.error = "unrecognized option '{w}'"
            }
            continue
        }
        var k = 1
        while k < w.len {
            let c = w[k..k + 1]
            k += 1
            if c == "l" {
                a.lock = true
            } else if c == "u" {
                a.unlock = true
            } else if c == "d" {
                a.delete = true
            } else if c == "S" {
                a.status = true
            } else if c == "a" {
                a.all = true
            } else if c == "q" {
                a.quiet = true
            } else if c == "h" {
                a.help = true
            } else if c == "R" {
                var v = w[k..]
                k = w.len
                if v.len == 0 {
                    if i >= args.len {
                        a.error = "option requires an argument -- 'R'"
                        return a
                    }
                    v = args[i]
                    i += 1
                }
                a.root = v
            } else if c == "e" || c == "k" {
                if a.refused.len == 0 {
                    a.refused = "-{c}"
                }
            } else if c == "i" || c == "n" || c == "r" || c == "w" || c == "x" {
                if a.refused.len == 0 {
                    a.refused = "-{c}"
                }
                if k >= w.len {
                    if i >= args.len {
                        a.error = "option requires an argument -- '{c}'"
                        return a
                    }
                    i += 1
                }
                k = w.len
            } else {
                a.error = "invalid option -- '{c}'"
                return a
            }
        }
    }
    a
}

fn usage() -> str {
    """
    Usage: passwd [options] [LOGIN]

    Options:
      -a, --all                     report password status on all accounts
      -d, --delete                  delete the password for the named account
      -e, --expire                  force expire the password for the named account
      -h, --help                    display this help message and exit
      -k, --keep-tokens             change password only if expired
      -i, --inactive INACTIVE       set password inactive after expiration
                                    to INACTIVE
      -l, --lock                    lock the password of the named account
      -n, --mindays MIN_DAYS        set minimum number of days before password
                                    change to MIN_DAYS
      -q, --quiet                   quiet mode
      -r, --repository REPOSITORY   change password in REPOSITORY repository
      -R, --root CHROOT_DIR         directory to chroot into
      -S, --status                  report password status on the named account
      -u, --unlock                  unlock the password of the named account
      -w, --warndays WARN_DAYS      set expiration warning days to WARN_DAYS
      -x, --maxdays MAX_DAYS        set maximum number of days before password
                                    change to MAX_DAYS

    """
}
