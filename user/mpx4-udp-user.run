# tests/mpx4-udp's run list for its `user` way (px22): the lines of
# user/mpx4-udp.run whose other end an ordinary socket on the host can
# be (tools/udp-host, through QEMU's user-mode network), each held to
# the same Linux output as there; and the resolver asking QEMU's own
# DNS server for an outside name, held to what tools/gateway-probe
# --dns got for it on the same host.
/bin/sockerr
/bin/udploop
/bin/udpecho 7 10.0.2.2 9099
/bin/udpclient 10.0.2.2 9099
/bin/udpsoak 10.0.2.2 9099 10000
/bin/resolve 10.0.2.3 dns.google
/bin/udpfill
