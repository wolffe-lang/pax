# The lupin PAX carries as /bin/lupin (px57; tools/mklupin builds it).
#
# Ruling #110 (the maintainer, 2026-10-22): lupin in the base image,
# wolf in a dev image later (the Linux norm: an interpreter in base, the
# compiler installable). lupin is wolf-interp's binary, the reference
# interpreter for the wolf language; its release archives are linked
# against glibc dynamically (the release workflow builds on ubuntu-22.04
# for a glibc floor of 2.35), and PAX has no dynamic loader, so PAX's
# lupin is built here: static, for x86_64-unknown-linux-musl (Rust's
# own prebuilt std for the target, with its self-contained musl CRT and
# libc), from the release TAG.
#
# Why the tag and not wolf-interp's trunk (fcf2fd0 at px57): the source
# is the same (`git diff e642f26 fcf2fd0 -- src Cargo.toml Cargo.lock
# build.rs rust-toolchain.toml vendor` is empty: tl29's CI files and
# notes only), and the tag is the only commit at which build.rs grants
# D57's stamp (`v{version}` pointing at HEAD), so this lupin says
# `lupin 0.1.55 (wolf-interp, reference interpreter at pin 294d626)`, as
# the glibc archive kernel/wolf.pin names does, never `+dev.fcf2fd0`.
#
# The Rust is the tree's own (rust-toolchain.toml, 1.97.1); tools/mklupin
# refuses another, and a missing musl target, and never installs one.
# On kasumi it is built in a throwaway image made FROM px13-ubuntu with
# rustup inside it (notes/px57/rust/Containerfile); in CI the workflow
# installs the channel and the target on the runner before the build.
# px65 (2026-10-23) moves it to v0.1.56 (28547b4, release 421458363),
# wolf 0.2.35's pairing: the 0.2.34 mirror, real OS entropy for
# os_random (getrandom 0.2.16 with its Linux fallback disabled: the
# getrandom(2) call PAX serves), the same Rust (1.97.1).
#
# R-px65-1: from v0.1.56 the release itself publishes a static musl
# archive, built by the flags this recipe used (wolf-interp's
# ci/musl-build.sh: +crt-static, relocation-model=static, the paths
# remapped) and checked as PAX's loader needs it (ci/musl-check.sh:
# ET_EXEC, no PT_INTERP, no PT_DYNAMIC, no .interp or .dynamic), so PAX
# takes THAT binary by digest, as it takes wolf (LUPIN_FROM=release):
# the archive's sha256 and the binary's, each read twice (the API, two
# downloads on kasumi). The tag build below stays for LUPIN_FROM=tag:
# on kasumi it gave 804773f5… (7,584,968 bytes), the same size as the
# release's c0ac0888… but not its bytes (1,177,061 differ), so the two
# recipes are not one binary and the pin names the published one.
LUPIN_FROM=release
# px82: v0.1.58 (6240efe5): archive 6ad6e008f97bce36b875e102906e2a949df5fd5d6f5cc693ae70fa19e376b533,
# binary b4f0f23c4028a4e37fb650dff1d417e90522a408de4b3a8ca3b8e80387676195.
# px97 (2026-11-04): v0.1.59 (668fb752, release 433110898): the 38 commits
# after 0.1.58, the spec mirror at wolf-lang b16353e8, env_arg0 and
# env_args_bytes resolved (wolf-interp#295), the region copies of #310,
# the host calls on the safe wrappers (#277, #278). The same Rust (1.97.1).
# The archive read twice from the release API and twice by download; the
# binary twice, from two extractions.
LUPIN_MUSL_URL=https://github.com/wolffe-lang/wolf-interp/releases/download/v0.1.59/lupin-0.1.59-x86_64-unknown-linux-musl.tar.gz
LUPIN_MUSL_SHA256=29ee2c304b4c5e41e9bf7f301b016f93b2726ff20139b7eb92d2568045846ca3
LUPIN_MUSL_BIN_SHA256=9de724f5752c289a5af5dd89f5c2649b11767f4b53b7ca5b8b154c0b380a4dff
LUPIN_SRC_REPO=https://github.com/wolffe-lang/wolf-interp
LUPIN_SRC_TAG=v0.1.59
LUPIN_SRC_REV=668fb752c690f33cf124c052cc9bae2e9696eeef
LUPIN_SRC_TARGET=x86_64-unknown-linux-musl
# The tree's rust-toolchain.toml channel, named here so CI can install it
# before the build; tools/mklupin refuses a pin that disagrees with the tree.
LUPIN_SRC_RUST=1.97.1
LUPIN_SRC_VERSION_LINE="lupin 0.1.59 (wolf-interp, reference interpreter at pin b16353e)"
# px82: v0.1.58 musl release; tag, archive and binary read twice.
# No std tree or STD-PIN is bundled (0.1.59 neither); user/std.pin names the std.
