# PAX's /etc/sudoers (px103): a subset of sudoers(5). A rule that does not
# say NOPASSWD: asks for the caller's password (px106: /etc/shadow, three
# tries). Enforced for honest programs; not a boundary against an attacker
# (ruling R6).
#
# px106 (R-px106-6, B3): Ubuntu's own shape. Members of group sudo (gid 27)
# may run anything as anyone, after their own password: the installer puts
# the account it makes in sudo, and an upgrade adds that account (uid 1000)
# to it, so `id` shows 27(sudo) and a second administrator is added as on
# Ubuntu, by adding them to the group. Ubuntu's %admin line is left out:
# PAX has never had an admin group. The service account lobo (990) has no
# rule.
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
root ALL=(ALL:ALL) ALL
%sudo ALL=(ALL:ALL) ALL
#includedir /etc/sudoers.d
