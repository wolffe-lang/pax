# PAX's /etc/sudoers (px103): a subset of sudoers(5). A rule that does not
# say NOPASSWD: asks for the caller's password (px106: /etc/shadow, three
# tries). Enforced for honest programs; not a boundary against an attacker
# (ruling R6).
#
# The second rule names uid 1000, not a user name: the installer's account is
# always uid 1000, whatever it is called, and its rule stays NOPASSWD: an
# install whose owner left every account locked (the installer's "n") must
# still reach root from the user's shell, as before px106. The service
# account lobo (990) has no rule.
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
root ALL=(ALL:ALL) ALL
#1000 ALL=(ALL:ALL) NOPASSWD: ALL
#includedir /etc/sudoers.d
