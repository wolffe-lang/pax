//! login — the console's login (px106, P5 lane U8's second half; ruling #75
//! R8's place, beside `su`).
//!
//! The installed system's `/etc/pax-run` is `/bin/login` (R-px106-2): the
//! kernel starts it as pid 1, the leader of the console's session with the
//! console as its terminal (kernel/sched), and it replaces itself with the
//! account's shell, so the shell leads that session. The dev and release
//! images keep ruling #75 R2's root shell, and the live stick its root
//! entry (user/usb-login.sh). Run as root, from /etc/pax-run or a shell.
//! **Enforced for honest programs; not a boundary against an attacker**
//! (R6): the kernel has never been fuzzed or audited and loads programs at
//! fixed addresses.
//!
//! References consulted: login(1), login.defs(5), shadow(5) (Ubuntu
//! 24.04's manual pages) and black-box runs of Ubuntu 24.04's own login
//! (1:4.13+dfsg1-4ubuntu3.2) on a pseudo-terminal in a throwaway container
//! (notes/px106/auth-ct.sh). Never the source of login, shadow-utils,
//! util-linux, PAM or any libc.
//!
//! **What it does** (each measured against Ubuntu's):
//! - `HOST login: ` (the name echoed), `Password: ` (no echo: user/auth/
//!   secret.lu) for every name, known, locked or not; the password checked
//!   against /etc/shadow (user/auth, wolf-std's `$7$`). A failure: about
//!   3 s, a blank line and `Login incorrect`, and the name asked again; a
//!   locked or unknown account answers the same words (R-px106-4), so the
//!   console never says which accounts exist. The fifth failure: `Maximum
//!   number of tries exceeded (5)`; 60 s from the start: `Login timed out
//!   after 60 seconds.` (R-px106-3). An empty name asks the name again.
//! - **The first-boot rule** (R-px106-2, as R-px106-9 has it): while no
//!   account that can reach root has a password PAX can check (root itself
//!   and every member of group `sudo`; every line locked, or no file at
//!   all), the name `root` is let in with no password, and one line says
//!   so. A password on any other account (lobo's) leaves the door open, so
//!   the console never ends with no way to root. An unconfigured system is
//!   as open as the console was before px106 until its owner sets a
//!   password (`passwd`) for root or a sudo member; from then on, the rules
//!   above hold for root too.
//! - The session: the terminal given to the account (owner the account,
//!   group its primary group, mode 0600: px98's rule; Ubuntu's group is
//!   `tty`, which PAX has not), the groups /etc/group gives it, its group
//!   and user ids (`os_set_ids`, whole or the process ends), an
//!   environment of TERM (as found) and HOME, SHELL, PATH (/etc/login.defs'
//!   ENV_PATH, or ENV_SUPATH for root, else Ubuntu's defaults), LOGNAME,
//!   USER and MAIL (`/var/mail/NAME`), and ENV=/etc/shrc when that file is
//!   there (pelt reads it: PAX's own); the home directory entered (else
//!   `No directory, logging in with HOME=/`); the shell exec'd with argv[0]
//!   `-` and its name.
//! - `login NAME` asks only the password first; `login -f NAME` (root
//!   only) asks nothing.
//! - As pid 1 it first empties sudo's timestamp records
//!   (`/var/run/sudo/ts`, user/sudo): Linux's /run is a new tmpfs at each
//!   boot, an installed PAX's /var is on ext2, and a reboot must void them.
//! - Then, as pid 1, the boot's hooks (px112, R-px112-7): each file of
//!   `/etc/pax-boot.d` in name order (a name starting `.` left out), its
//!   standard input /dev/null, its output on the console, as the leader of
//!   a process group of its own (so a key typed at the console signals
//!   none of what it starts), each waited for at most 10 s: one still
//!   running then is named and left to run. PAX has no service manager;
//!   this is where a server starts (`/etc/pax-boot.d/burrowd`). The
//!   kernel's wait for the network comes before pid 1, so before them.
//!
//! **What it does not, by name:** as pid 1 it has no getty to start it
//! again, so after the fifth failure or the timeout it starts over
//! itself (Ubuntu's ends, and getty starts a new one); it does not stay
//! as the shell's parent (no PAM session to close: the shell's end is the
//! session's end, and on PAX's console init's end halts the machine, as
//! before px106); no /etc/motd (PAX's console prints it before the first
//! program), no last-login line, no /etc/nologin, /etc/securetty or
//! hushlogin; `-p`, `-h` and `-r` are refused by name; a login that is
//! not its session's leader stays in its caller's session (PAX's console
//! login always leads it).

use std.fs
use std.os.users
use std.process

const TRIES: int = 5
const TIMEOUT_MS: int = 60000
const FAIL_DELAY_MS: int = 3000
const HOOK_DIR: str = "/etc/pax-boot.d"
const HOOK_MS: int = 10000

fn main() -> int {
    let args = env_args()
    var name = ""
    var force = false
    var i = 0
    while i < args.len {
        let w = args[i]
        i += 1
        if w == "-f" {
            force = true
            continue
        }
        if w == "-p" || w == "-h" || w == "-r" || (w.starts_with("-") && w != "--") {
            eprint("login: {w}: not built in PAX's login (notes/px106-passwords.md)")
            return 1
        }
        if w == "--" {
            continue
        }
        name = w
    }
    let euid = os_euid() else -1
    if euid != 0 {
        eprint("login: Cannot possibly work without effective root")
        return 1
    }
    if force && name.len == 0 {
        eprint("login: -f needs a name")
        return 1
    }
    if force {
        let ptext = fs_read_text("/etc/passwd") else ""
        let u = users.user_named(ptext, name) else |_| {
            eprint("login: no user {name}")
            return 1
        }
        return enter(u)
    }
    let pid1 = os_pid() == 1
    if pid1 {
        boot_clean()
        boot_hooks()
    }
    loop {
        let r = session(name)
        if !pid1 {
            return r
        }
        name = ""
    }
}

fn now_ms() -> int {
    os_clock_ns() / 1000000
}

/// As pid 1, the boot's first program: sudo's timestamp records emptied
/// (`/var/run/sudo/ts`), as Linux's /run is a new tmpfs at each boot, so
/// a reboot voids every record (an installed PAX keeps /var on ext2).
fn boot_clean() {
    let dir = "/var/run/sudo/ts"
    let names = fs_read_dir(dir) else |_| {
        return
    }
    for n in names {
        fs_remove("{dir}/{n}") else |_| {
        }
    }
}

/// As pid 1, the boot's hooks: each file of /etc/pax-boot.d in name order,
/// in a process group of its own, standard input /dev/null, waited for at
/// most HOOK_MS. A hook that cannot start, or ends other than 0, is one
/// line on the console; the login goes on either way.
fn boot_hooks() {
    var names = fs_read_dir(HOOK_DIR) else |_| {
        return
    }
    names = hook_order(names)
    for n in names {
        let path = "{HOOK_DIR}/{n}"
        if n.starts_with(".") || !fs_is_file(path) {
            continue
        }
        var c = process.command(path)
        let null = fs.open("/dev/null") else |_| {
            print("login: {path}: no /dev/null; not run")
            continue
        }
        process.set_stdin(mut c, null)
        let ch = process.start_job(c, 0, 0) else |e| {
            print("login: {path}: not started ({e})")
            continue
        }
        let until = now_ms() + HOOK_MS
        var ended = false
        while !ended && now_ms() < until {
            let got = process.poll() else |_| {
                ended = true
                process.Change {
                    changed: false,
                    child: process.Child { slot: -1 },
                    status: process.status_from(0),
                    live: 0,
                }
            }
            if got.changed && got.child.slot == ch.slot {
                ended = true
                let code = process.exit_code(got.status) else -1
                if code != 0 {
                    print("login: {path} ended with status {code}")
                }
            } else if !ended {
                time_sleep_ms(20)
            }
        }
        if !ended {
            print("login: {path} still runs after {HOOK_MS / 1000} s; left running")
        }
    }
}

/// `names` in byte order (a hook directory's few names).
fn hook_order(names: List[str]) -> List[str] {
    var out = List[str]()
    for n in names {
        var i = 0
        while i < out.len && !name_before(n, out[i]) {
            i += 1
        }
        var next = List[str]()
        var k = 0
        while k < out.len {
            if k == i {
                (mut next).push(n)
            }
            (mut next).push(out[k])
            k += 1
        }
        if i == out.len {
            (mut next).push(n)
        }
        out = next
    }
    out
}

fn name_before(a: str, b: str) -> bool {
    let x = a.bytes()
    let y = b.bytes()
    var i = 0
    while i < x.len && i < y.len {
        if x[i] != y[i] {
            return (x[i] as int) < (y[i] as int)
        }
        i += 1
    }
    x.len < y.len
}

/// One login: up to five tries in 60 s. Returns only when they are spent;
/// a success becomes the shell.
fn session(first: str) -> int {
    let host = hostname()
    let start = now_ms()
    var tries = 0
    var name = first
    while tries < TRIES {
        if name.len == 0 {
            print_raw("{host} login: ")
            let left = TIMEOUT_MS - (now_ms() - start)
            name = secret_read(0, 1, true, if left > 0 then left else 1) else |e| match e {
                timeout => {
                    print("\nLogin timed out after 60 seconds.")
                    return 1
                },
                interrupted => {
                    return 1
                },
                _ => {
                    return 1
                },
            }
            if name.len == 0 {
                continue
            }
        }
        let stext = shadow_text("")
        let ptext = fs_read_text("/etc/passwd") else ""
        let gtext = fs_read_text("/etc/group") else ""
        if name == "root" && !shadow_root_door_shut(stext, ptext, gtext) {
            print("PAX: no password is set for root or for group sudo, so root logs in without one; set one with passwd.")
            let r = users.user_named(ptext, "root") else |_| {
                users.User { name: "root", uid: 0, gid: 0, comment: "", home: "/root", shell: "/bin/sh" }
            }
            return enter(r)
        }
        print_raw("Password: ")
        let left = TIMEOUT_MS - (now_ms() - start)
        let pw = secret_read(0, 1, false, if left > 0 then left else 1) else |e| match e {
            timeout => {
                print("\nLogin timed out after 60 seconds.")
                return 1
            },
            _ => {
                ""
            },
        }
        let found = users.user_named(ptext, name) else |_| {
            users.User { name: "", uid: -1, gid: -1, comment: "", home: "", shell: "" }
        }
        if found.name.len > 0 && pw_matches(pw, shadow_entry(stext, name).field) {
            return enter(found)
        }
        time_sleep_ms(FAIL_DELAY_MS)
        print("\nLogin incorrect")
        tries += 1
        name = ""
    }
    print("Maximum number of tries exceeded ({TRIES})")
    1
}

/// The session for `u`: the terminal, the ids, the environment, the home
/// directory, the shell. Returns only when something fails.
fn enter(u: users.User) -> int {
    let group = fs_read_text("/etc/group") else ""
    let groups = users.groups_of(group, u.name, u.gid)
    // The terminal is the account's, as login(1) gives it (px98's rule).
    fs_set_owner("/dev/stdin", u.uid, u.gid, true) else |_| {
    }
    fs_set_mode("/dev/stdin", 0o600) else |_| {
    }
    var shell = u.shell
    if shell.len == 0 {
        shell = "/bin/sh"
    }
    var home = u.home
    var env = List[str]()
    let term = env_get("TERM") else ""
    if term.len > 0 {
        (mut env).push("TERM={term}")
    }
    var why = ""
    os_set_ids(u.uid, u.gid, groups) else |e| match e {
        denied => {
            why = "Operation not permitted"
        },
        invalid => {
            why = "Invalid argument"
        },
        io => {
            why = "Input/output error"
        },
        unsupported => {
            why = "this host cannot change a process's ids"
        },
    }
    if why.len > 0 {
        eprint("login: cannot set user and group ids: {why}")
        return 1
    }
    os_chdir(home) else |_| {
        print("No directory, logging in with HOME=/")
        home = "/"
        os_chdir("/") else |_| {
        }
    }
    (mut env).push("HOME={home}")
    (mut env).push("SHELL={shell}")
    (mut env).push("PATH={login_path(u.uid == 0)}")
    (mut env).push("LOGNAME={u.name}")
    (mut env).push("USER={u.name}")
    (mut env).push("MAIL=/var/mail/{u.name}")
    if fs_is_file("/etc/shrc") {
        (mut env).push("ENV=/etc/shrc")
    }
    let base = base_name(shell)
    var row = ""
    os_exec(shell, ["-" + base], env, List[int]()) else |e| match e {
        not_found => {
            row = "No such file or directory"
        },
        denied => {
            row = "Permission denied"
        },
        io => {
            row = "Exec format error"
        },
        invalid => {
            row = "Invalid argument"
        },
        unsupported => {
            row = "this host has no exec"
        },
    }
    eprint("login: failed to execute {shell}: {row}")
    1
}

/// `PATH`: /etc/login.defs' ENV_SUPATH (root) or ENV_PATH, as `PATH=…` or
/// bare, else Ubuntu's defaults.
fn login_path(root: bool) -> str {
    let key = if root then "ENV_SUPATH" else "ENV_PATH"
    let defs = fs_read_text("/etc/login.defs") else ""
    for line in defs.split("\n") {
        if !line.starts_with(key) {
            continue
        }
        let rest = line[key.len..]
        if rest.len == 0 || !(rest.starts_with(" ") || rest.starts_with("\t")) {
            continue
        }
        var v = trim(rest)
        if v.starts_with("PATH=") {
            v = v[5..]
        }
        if v.len > 0 {
            return v
        }
    }
    if root {
        return "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    }
    "/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games"
}

fn hostname() -> str {
    let h = trim(fs_read_text("/proc/sys/kernel/hostname") else "")
    if h.len == 0 {
        return "pax"
    }
    h
}

fn trim(s: str) -> str {
    var b = 0
    var e = s.len
    while b < e && (s[b..b + 1] == " " || s[b..b + 1] == "\t") {
        b += 1
    }
    while e > b && (s[e - 1..e] == " " || s[e - 1..e] == "\t" || s[e - 1..e] == "\r" || s[e - 1..e] == "\n") {
        e -= 1
    }
    s[b..e]
}

fn base_name(path: str) -> str {
    let cut = path.rfind("/") else -1
    if cut < 0 {
        return path
    }
    path[cut + 1..]
}
