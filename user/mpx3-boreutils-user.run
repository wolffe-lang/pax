# tests/mpx3-boreutils' run list AS A USER (px47, P5 U7): every line of
# user/mpx3-boreutils.run under px39's `as 1000 1000` (no supplementary
# group, the three group ids and the three user ids 1000, then the
# program), then what only the owner may read refused: root's 0600
# /etc/secret and its 0700 /etc/private (tools/mkinitramfs's owners).
# kmain_boreutils runs it from the user image as /etc/pax-run;
# tools/linux-tree --runlist runs it chrooted in a throwaway container
# with the same owners and modes, `as` and all; the two outputs and
# exit statuses are compared byte for byte.
/bin/as 1000 1000 /bin/echo hello from boreutils
/bin/as 1000 1000 /bin/cat /etc/motd
/bin/as 1000 1000 /bin/ls /bin /etc
/bin/as 1000 1000 /bin/wc /etc/words
/bin/as 1000 1000 /bin/head -n 3 /etc/words
/bin/as 1000 1000 /bin/tail -n 2 /etc/words
/bin/as 1000 1000 /bin/pwd
/bin/as 1000 1000 /bin/wc /etc/motd /etc/words
/bin/as 1000 1000 /bin/cat etc/words
/bin/as 1000 1000 /bin/head -n 1 /etc/motd
/bin/as 1000 1000 /bin/cat
/bin/as 1000 1000 /bin/sleep 0.2
/bin/as 1000 1000 /bin/sleep 0.3 & /bin/as 1000 1000 /bin/ls /etc
/bin/as 1000 1000 /bin/ls -a /etc
/bin/as 1000 1000 /bin/cat /etc/nothing
/bin/as 1000 1000 /bin/cat /bin
/bin/as 1000 1000 /bin/head -n 2 /etc/motd/x
/bin/as 1000 1000 /bin/ls /etc
/bin/as 1000 1000 /bin/ls -l /etc
/bin/as 1000 1000 /bin/ls -a /bin
/bin/as 1000 1000 /bin/ls -F /etc /bin
/bin/as 1000 1000 /bin/ls -R /etc
/bin/as 1000 1000 /bin/ls -a -C -w 40 /bin
/bin/as 1000 1000 /bin/ls -x -w 30 /bin
/bin/as 1000 1000 /bin/ls -m /bin
/bin/as 1000 1000 /bin/ls -d /etc /bin/ls /etc/motd
/bin/as 1000 1000 /bin/ls -S -r /etc
/bin/as 1000 1000 /bin/ls /nothing /etc
/bin/as 1000 1000 /bin/ls -d /
/bin/as 1000 1000 /bin/cat /etc/secret
/bin/as 1000 1000 /bin/head -n 1 /etc/secret /etc/words
/bin/as 1000 1000 /bin/tail -n 1 /etc/secret
/bin/as 1000 1000 /bin/wc /etc/private/note /etc/motd
/bin/as 1000 1000 /bin/ls /etc/private
/bin/as 1000 1000 /bin/ls -l /etc/private
/bin/as 1000 1000 /bin/ls -l -d /etc/private /etc/secret
/bin/as 1000 1000 /bin/cat /etc/private/note
/bin/cat /etc/private/note

# px82: shipped checksum, encoding, arithmetic and test utilities.
/bin/as 1000 1000 /bin/cksum /etc/words
/bin/as 1000 1000 /bin/sum /etc/words
/bin/as 1000 1000 /bin/md5sum /etc/words
/bin/as 1000 1000 /bin/sha1sum /etc/words
/bin/as 1000 1000 /bin/sha224sum /etc/words
/bin/as 1000 1000 /bin/sha256sum /etc/words
/bin/as 1000 1000 /bin/sha384sum /etc/words
/bin/as 1000 1000 /bin/sha512sum /etc/words
/bin/as 1000 1000 /bin/b2sum /etc/words
/bin/as 1000 1000 /bin/basenc --base16 /etc/words
/bin/as 1000 1000 /bin/expr 7 * 9
/bin/as 1000 1000 /bin/factor 360
/bin/as 1000 1000 /bin/numfmt --to=si 1000
/bin/as 1000 1000 /bin/test 7 -gt 2
