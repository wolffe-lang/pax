# /etc/fstab — the mount table of the disk that boots (px66,
# tools/mkdisk --gpt): its partition 2 is the ext2 volume /home is
# (partition 1 is the EFI system partition Limine and the kernel are
# on, partition 3 Limine's BIOS stage). The same format as user/fstab,
# the ISO's: kernel/fstab reads it before the first program.
/dev/vda2	/home	ext2	defaults	0	2
