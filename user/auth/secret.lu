//! user/auth/secret.lu — reading a password from the terminal (px106),
//! for passwd, su, sudo and login.
//!
//! **The terminal** is /dev/tty, the caller's controlling terminal, opened
//! for reading and writing (termios(3)); the prompt is written to it and the
//! answer read from it. With no controlling terminal each program says what
//! Ubuntu's says (sudo: "a terminal is required to read the password"; su
//! and passwd read standard input).
//!
//! **How a line is read:** the terminal's mode is read, then set to read a
//! byte at a time with the echo off and no signals from keys (std.term's
//! `canonical`, `echo`, `signals` and `extended` false; every other setting
//! as found), and put back exactly as it was before anything else is
//! printed. So the reader keeps the line itself: Enter ends it; Backspace
//! (DEL or ^H), ^U and ^W erase a character, the line and a word, as the
//! terminal's own canonical mode does; ^D on an empty line is the end of
//! input (`eof`), elsewhere it ends the line; ^C puts the mode back and
//! ends the program by SIGINT, as a key's signal would (`interrupted` only
//! if it lives). A newline is written after the line, since the Enter was
//! not echoed (Ubuntu's programs do the same). `echo` (login's name) writes
//! each character back, and "\b \b" for an erased one. A deadline reads
//! with VMIN 0 and polls every 50 ms, so a line not finished in time is
//! `timeout`.
//!
//! Enforced for honest programs; not a boundary against an attacker
//! (ruling #75 R6).

use std.term

/// /dev/tty, read-write, or -1 when the caller has no controlling terminal.
fn secret_tty() -> int {
    fs_open_mode("/dev/tty", 3) else -1
}

fn secret_put(fd: int, s: str) {
    if fd >= 0 {
        fs_write(fd, s) else |_| {
        }
    }
}

fn secret_now_ms() -> int {
    os_clock_ns() / 1000000
}

/// One line from `fd`; see the module header. `out` is where an echo and
/// the closing newline go (the terminal itself, or -1 for nothing).
fn secret_read(fd: int, out: int, echo: bool, deadline_ms: int) -> str ! {eof, interrupted, timeout, io} {
    let saved = os_term_mode(fd) else -1
    let tty = saved >= 0
    if tty {
        var m = term.unpack(saved)
        m.canonical = false
        m.echo = false
        m.signals = false
        m.extended = false
        m.min = if deadline_ms > 0 then 0 else 1
        m.time = 0
        os_term_set_mode(fd, term.pack(m)) else |_| {
            return io
        }
    }
    let start = secret_now_ms()
    var line = List[byte]()
    var why = ""
    loop {
        let got = fs_read_chunk(fd, 1) else |e| match e {
            eof => {
                List[byte]()
            },
            io => {
                why = "io"
                List[byte]()
            },
        }
        if why.len > 0 {
            break
        }
        if got.len == 0 {
            if tty && deadline_ms > 0 {
                if secret_now_ms() - start >= deadline_ms {
                    why = "timeout"
                    break
                }
                time_sleep_ms(50)
                continue
            }
            why = if line.len == 0 then "eof" else ""
            break
        }
        let b = got[0] as int
        if b == 10 || b == 13 {
            break
        }
        if !tty {
            (mut line).push(got[0])
            continue
        }
        if b == 3 {
            os_term_set_mode(fd, saved) else |_| {
            }
            os_signal_default(2) else |_| {
            }
            os_signal_raise(2) else |_| {
            }
            return interrupted
        }
        if b == 4 {
            if line.len == 0 {
                why = "eof"
            }
            break
        }
        if b == 127 || b == 8 {
            if line.len > 0 {
                let _p = (mut line).pop() else 0 as byte
                if echo {
                    secret_put(out, "\u{8} \u{8}")
                }
            }
            continue
        }
        if b == 21 {
            while line.len > 0 {
                let _p = (mut line).pop() else 0 as byte
                if echo {
                    secret_put(out, "\u{8} \u{8}")
                }
            }
            continue
        }
        if b == 23 {
            while line.len > 0 && (line[line.len - 1] as int) == 32 {
                let _p = (mut line).pop() else 0 as byte
                if echo {
                    secret_put(out, "\u{8} \u{8}")
                }
            }
            while line.len > 0 && (line[line.len - 1] as int) != 32 {
                let _p = (mut line).pop() else 0 as byte
                if echo {
                    secret_put(out, "\u{8} \u{8}")
                }
            }
            continue
        }
        (mut line).push(got[0])
        if echo && b >= 32 {
            let one = str_from_utf8([got[0]]) else "?"
            secret_put(out, one)
        }
    }
    if tty {
        os_term_set_mode(fd, saved) else |_| {
        }
    }
    if why != "timeout" {
        secret_put(out, "\n")
    }
    if why == "eof" {
        return eof
    }
    if why == "timeout" {
        return timeout
    }
    if why == "io" {
        return io
    }
    str_from_utf8(line) else |_| {
        return io
    }
}

/// Ask with `prompt` on the terminal `fd` and read the answer, the echo off.
fn secret_ask(fd: int, prompt: str) -> str ! {eof, interrupted, timeout, io} {
    secret_put(fd, prompt)
    secret_read(fd, fd, false, 0)?
}

// ---- who is on which terminal: /proc/self/stat (proc_pid_stat(5)) ----

/// The fields after the command's closing parenthesis: state, ppid, pgrp,
/// session, tty_nr, ... ([] when the file cannot be read).
fn secret_stat_fields() -> List[str] {
    let s = fs_read_text("/proc/self/stat") else ""
    let cut = s.rfind(")") else -1
    if cut < 0 {
        return List[str]()
    }
    var out = List[str]()
    for w in s[cut + 1..].split(" ") {
        if w.len > 0 {
            (mut out).push(w.replace("\n", ""))
        }
    }
    out
}

/// The session id, or -1.
fn secret_session() -> int {
    let f = secret_stat_fields()
    if f.len < 5 {
        return -1
    }
    f[3].to_int() else -1
}

/// The controlling terminal's device number (proc_pid_stat(5)'s tty_nr), 0 for none.
fn secret_tty_nr() -> int {
    let f = secret_stat_fields()
    if f.len < 5 {
        return 0
    }
    f[4].to_int() else 0
}

/// The controlling terminal's name as sudo's log writes it (`pts/0`,
/// `ttyS0`, `tty1`, `console`), "" for none.
fn secret_tty_name() -> str {
    let nr = secret_tty_nr()
    if nr == 0 {
        return ""
    }
    let major = (nr / 256) % 4096
    let minor = (nr % 256) + (nr / 1048576) * 256
    if major >= 136 && major <= 143 {
        return "pts/{(major - 136) * 256 + minor}"
    }
    if major == 4 && minor >= 64 {
        return "ttyS{minor - 64}"
    }
    if major == 4 {
        return "tty{minor}"
    }
    if major == 5 && minor == 1 {
        return "console"
    }
    "{major}:{minor}"
}
