//! member: false
// px61: both modules must load from the installed standard library.
use std.fs
use std.str

fn main() -> !int {
    let path = "px61-std.txt"
    let text = str.upper("wolf")
    fs.write_text(path, text)?
    let back = fs.read_text(path)?
    print("std: {back}, roundtrip {back == text}")
    fs.remove(path)?
    0
}
