# /etc/pax-net: how this machine takes its network address. PAX's kernel
# reads it at boot (on an installed system, from the system's own disk).
# The first line that is neither empty nor a comment decides:
#
#   dhcp [wait=<1-600>]
#       a lease from the network's DHCP server. The console waits at most
#       <wait> seconds for it before the first program runs (30 when no
#       wait is given), and not at all when the cable has no link; the
#       client goes on asking either way.
#   static <a.b.c.d>/<prefix> [gateway <a.b.c.d>] [dns <a.b.c.d>]...
#       this address, its subnet's gateway, and up to three DNS servers
#       for /etc/resolv.conf.
#
# Without this file the address is 10.0.2.15/24, gateway 10.0.2.2 (QEMU's
# user network).
dhcp wait=10
