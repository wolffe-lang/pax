//! Line-key navigation works with the served console, without cursor-control
//! sequences. n/p and a number select, q/EOF cancel. Non-terminals get the
//! same numbered plain-text flow. Geometry is sampled afresh on each page.
//! px78: every disk is on the page with its identity, the refused ones with
//! their reason; only a disk on the install allow-list can be chosen. What
//! is printed and what is typed go to the install log (allow.lu).
//! px78b (R-P6-confirm): after the plan, one summary names the disk by
//! model, serial, size and node with the ext2 notice, and the word `yes`,
//! exactly, installs; anything else cancels with nothing written.

/// The one confirmation's summary (no model: a virtio disk shows none).
fn summary_text(p: Plan, model: str, serial: str) -> str {
    let m = if model.len == 0 then "(no model)" else model
    "Erase {m}, serial {serial} ({size_text(p.target.bytes)}, /dev/{p.target.name}), and install PAX?\n" +
        "The root file system is ext2 without a journal."
}

fn answer(mut lg: Log, prompt: str) -> str ! {cancelled, io} {
    print_raw(prompt)
    print_raw("pax-install> ")
    lg.pending += prompt + "pax-install> "
    let s = read_line() else |e| match e {
        eof => { note(mut lg, "(end of input)"); return cancelled },
        _ => { return io },
    }
    note(mut lg, s)
    if s == "q" { return cancelled }
    s
}

fn pick_target(mut lg: Log, disks: List[Disk]) -> Target ! {cancelled, io, invalid} {
    if disks.len == 0 { return invalid }
    var selected = 0
    while selected < disks.len && disks[selected].reason.len != 0 { selected += 1 }
    if selected == disks.len { return invalid }
    loop {
        let tty = os_isatty(0) else |_| false
        if tty {
            let (rows, cols) = os_term_size(0) else |_| (0, 0)
            say(mut lg, "PAX installer / target page ({cols}x{rows})")
        } else {
            say(mut lg, "PAX installer / plain-text target page")
        }
        for i in 0..disks.len {
            let mark = if i == selected then ">" else " "
            say(mut lg, "{mark} {i + 1}. {disk_text(disks[i])}")
        }
        let s = answer(mut lg, "Target number, n/p then Enter, Enter selects, q cancels: ")?
        if s == "n" || s == "p" {
            var k = selected
            loop {
                k = if s == "n" then (k + 1) % disks.len else (k + disks.len - 1) % disks.len
                if disks[k].reason.len == 0 { break }
            }
            selected = k
            continue
        }
        if s.len == 0 { return copy disks[selected].target }
        let n = s.to_int() else |_| { say(mut lg, "Enter an exact target number."); continue }
        if n >= 1 && n <= disks.len {
            if disks[n - 1].reason.len == 0 { return copy disks[n - 1].target }
            say(mut lg, "Disk {n} is refused: {disks[n - 1].reason}.")
            continue
        }
        say(mut lg, "No such target number.")
    }
}

fn guided_plan(mut lg: Log, disks: List[Disk], seed: str) -> Plan ! {
    cancelled,
    io,
    invalid,
    running_root,
    mounted,
    readonly,
    sector_size,
    too_small,
    too_large,
} {
    let t = pick_target(mut lg, disks)?
    var user = ""
    loop {
        user = answer(mut lg, "New user name (uid/gid 1000; q cancels): ")?
        if valid_name(user) { break }
        say(mut lg, "Use 1-32 lowercase letters, digits, _ or -; start with a letter or _. Not root.")
    }
    var games = ""
    loop {
        let s = answer(mut lg, "Install the lair, the wolf games? y/n (no default): ")?
        if s == "y" { games = "yes"; break }
        if s == "n" { games = "no"; break }
        say(mut lg, "An explicit y or n is required.")
    }
    let p = make_plan(t, seed, user, games)?
    print_raw(plan_body(p))
    // The log keeps the confirmation line as its record of what was erased.
    lg.pending += plan_text(p)
    var model = ""
    var serial = ""
    for d in disks {
        if d.target.name == t.name {
            model = d.model
            serial = d.serial
            if d.layout != "no partitions" { say(mut lg, "This install erases /dev/{t.name}'s {d.layout}.") }
        }
    }
    say(mut lg, summary_text(p, model, serial))
    flush_log(mut lg)
    if answer(mut lg, "Type yes to install; anything else cancels: ")? != "yes" { return cancelled }
    p
}

/// px106: after the confirmation and before any write, the guided install
/// asks whether to set root's password and the new user's. Each yes runs
/// the image's /bin/passwd -R on a scratch copy of the accounts the
/// install will write, made from the source tree's /etc/passwd as
/// configure_tree makes them (never the running system's, which a rescue
/// environment need not have: pax#324); its prompts and the typed password
/// go to the terminal, never to the install log. A no, or a passwd that
/// does not finish, leaves the account locked. Returns the /etc/shadow
/// text, every account locked but those set.
fn guided_passwords(mut lg: Log, user: str, source: str, work: str) -> str ! {cancelled, io} {
    let dir = "{work}/accounts"
    fs_create_dir_all("{dir}/etc") else |_| { return io }
    let base = if source == "/" then "" else source
    let tree = fs_read_text("{base}/etc/passwd") else |_| { return io }
    let accounts = account_table(tree, user, false) else |_| { return io }
    durable_text("{dir}/etc/passwd", accounts)?
    durable_text("{dir}/etc/shadow", locked_shadow(accounts, today()))?
    for who in ["root", user] {
        var yes = false
        loop {
            let s = answer(mut lg, "Set a password for {who} now? y/n (n leaves {who} locked; no default): ")?
            if s == "y" { yes = true; break }
            if s == "n" { break }
            say(mut lg, "An explicit y or n is required.")
        }
        if !yes {
            say(mut lg, "{who} is locked: set a password later with passwd.")
            continue
        }
        flush_log(mut lg)
        let child = os_spawn(["/bin/passwd", "-R", dir, who]) else |_| {
            say(mut lg, "{who} is locked: /bin/passwd could not be started.")
            continue
        }
        let status = os_wait(child) else |_| -1
        if status == 0 {
            say(mut lg, "{who}'s password is set (the install log never holds it).")
        } else {
            say(mut lg, "{who} is locked: passwd exited {status}; set a password later with passwd.")
        }
    }
    let text = fs_read_text("{dir}/etc/shadow") else |_| { return io }
    fs_remove_dir_all(dir) else |_| {}
    text
}
