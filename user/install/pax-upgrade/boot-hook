#!/bin/pelt
# /etc/pax-boot.d/pax-upgrade: an upgrade staged over ssh, seen to at each boot
# (px115; pid 1 runs each file of /etc/pax-boot.d before the first prompt).
# `pax-upgrade boot` does nothing when nothing was ever staged. Otherwise:
# an armed configuration under the installed root (the staged boot refused
# its archive, or the installed entry was chosen at the menu) is disarmed
# and the reason goes to /var/log/pax-upgrade.log, with a reboot when the
# staged kernel is the one running; an upgrade cut after its ESP phase is
# armed again; the first boot after a finished upgrade removes the staged
# files. `pax-upgrade status` shows what happened.
[ -x /bin/pax-upgrade ] || exit 0
exec /bin/pax-upgrade boot
