//! Preparation is off-target. The payload is excluded from the copied root:
//! a 'no games' install must not carry a second hidden copy of the games.

use std.x.crypto.sha2

const INSTALL_EPOCH: int = 1700000000

// gm01: a game's engine (lair) is linked into its binary, so the engine's
// source archive travels beside the game's: games.txt's sixth and
// seventh words, the payload's `<name>.engine.source.tar.gz`.
struct Game {
    name: str,
    source: str,
    digest: str,
    archive: str,
    archive_digest: str,
    engine: str,
    engine_digest: str,
}

fn payload_location_ok(source: str, payload: str) -> bool {
    if source == "/" { return payload == "/usr/share/pax-install" }
    if payload == source { return false }
    if payload.starts_with("{source}/") { return payload == "{source}/usr/share/pax-install" }
    true
}

fn require_dir(path: str) -> () ! {io, invalid} {
    let st = fs_lstat(path) else |_| { return io }
    if st[0] != 1 { return invalid }
}

fn verify_file(path: str, digest: str) -> () ! {io, corrupt_asset} {
    let st = fs_lstat(path) else |_| { return io }
    if st[0] != 0 || digest.len != 64 { return corrupt_asset }
    if hash_file(path)? != digest { return corrupt_asset }
}

fn boot_assets(source: str, payload: str) -> () ! {io, invalid, corrupt_asset} {
    for dir in ["/etc", "/home", "/boot", "/boot/limine", "/boot/EFI", "/boot/EFI/BOOT"] {
        require_dir("{source}{dir}")?
    }
    let conf = fs_lstat("{source}/boot/limine/limine.conf") else |_| { return io }
    if conf[0] != 0 { return invalid }
    let text = fs_read_text("{payload}/boot.sha256") else |_| { return io }
    let needed = ["/boot/pax", "/boot/limine/limine-bios.sys", "/boot/EFI/BOOT/BOOTX64.EFI"]
    var bytes: int = 0
    for path in needed {
        var count = 0
        for line in text.lines() {
            let w = line.words()
            if w.len != 2 { return invalid }
            if w[1] == path { verify_file("{source}{path}", w[0])?; count += 1 }
        }
        if count != 1 { return corrupt_asset }
        let size = fs_size("{source}{path}") else |_| { return io }
        if size < 1 || size > ESP_BYTES - 1048576 - bytes { return corrupt_asset }
        bytes += size
    }
    if text.lines().len != 3 { return invalid }
}

fn staged_games(payload: str) -> List[Game] ! {io, invalid, corrupt_asset} {
    let catalog = fs_read_text("{payload}/games.txt") else |_| { return io }
    let sums = fs_read_text("{payload}/games.sha256") else |_| { return io }
    var out = List[Game]()
    for line in catalog.lines() {
        if line.trim().len == 0 || line.starts_with("#") { continue }
        let w = line.words()
        if w.len != 7 ||
            !valid_name(w[0]) ||
            w[0] != w[3] ||
            w[4] != "0755" ||
            w[1].len != 40 ||
            w[2].len != 64 ||
            w[5].len != 40 ||
            w[6].len != 64 {
            return invalid
        }
        for g in out { if g.name == w[0] { return invalid } }
        var digest = ""
        var count = 0
        for row in sums.lines() {
            let s = row.words()
            if s.len != 2 { return invalid }
            if s[1] == w[0] { digest = s[0]; count += 1 }
        }
        if count != 1 { return invalid }
        let source = "{payload}/games/{w[0]}"
        verify_file(source, digest)?
        let archive = "{payload}/games/{w[0]}.source.tar.gz"
        verify_file(archive, w[2])?
        let engine = "{payload}/games/{w[0]}.engine.source.tar.gz"
        verify_file(engine, w[6])?
        (mut out).push(Game {
            name: w[0],
            source: source,
            digest: digest,
            archive: archive,
            archive_digest: w[2],
            engine: engine,
            engine_digest: w[6],
        })
    }
    if out.len == 0 || sums.lines().len != out.len { return invalid }
    out
}

fn new_partuuid(seed: str) -> str {
    let hex = sha2.to_hex(sha2.sum256("pax-gpt-part:{seed}:{INSTALL_EPOCH}:2".bytes()))
    "{hex[0..8]}-{hex[8..12]}-{hex[12..16]}-{hex[16..20]}-{hex[20..32]}"
}

fn new_config(seed: str) -> str { config_text(new_partuuid(seed)) }

/// px93: the installed disk's limine.conf and /etc/fstab for its root's
/// PARTUUID, the texts a fresh install writes and an upgrade regenerates.
/// px118: Limine says how far it got (CONFIG.md, v12.9.1's global
/// options): a five-second menu instead of `timeout: 0` and `quiet: yes`,
/// which drew nothing at all, so a screen black before the menu is told
/// apart from one black after it; `verbose: yes`, its additional lines
/// while it boots; `serial: yes`, the same on a serial port where there is
/// one.
fn config_text(partuuid: str) -> str {
    "timeout: 5\nverbose: yes\nserial: yes\n\n/PAX ext2 developer preview\n    protocol: limine\n" +
        "    path: boot():/boot/pax\n    cmdline: quiet root=PARTUUID={partuuid} rootfstype=ext2 rw\n"
}

/// px118: the text every installer from px78's to px118's wrote (an
/// upgrade regenerates a root's copy that still holds it, as
/// `known_texts` does for the files that name no PARTUUID).
fn config_text_quiet(partuuid: str) -> str {
    "timeout: 0\nquiet: yes\n\n/PAX ext2 developer preview\n    protocol: limine\n" +
        "    path: boot():/boot/pax\n    cmdline: quiet root=PARTUUID={partuuid} rootfstype=ext2 rw\n"
}

fn fstab_text(partuuid: str) -> str {
    "PARTUUID={partuuid} / ext2 rw 0 1\ntmpfs /tmp tmpfs nosuid,nodev 0 0\n"
}

fn append_attrs(attrs: str, path: str, mode: str, uid: int, gid: int) -> () ! {io} {
    let fd = fs_open_mode(attrs, 2) else |_| { return io }
    defer fs_close(fd) else |_| {}
    let row = "{quoted(path)} {mode} {uid} {gid} {INSTALL_EPOCH} {INSTALL_EPOCH} {INSTALL_EPOCH}\n"
    fs_write_chunk(fd, row.bytes()) else |_| { return io }
    fs_sync(fd) else |_| { return io }
}

fn replace_config(tree: str, attrs: str, path: str, text: str) -> () ! {io, invalid} {
    if fs_exists("{tree}{path}") {
        let st = fs_lstat("{tree}{path}") else |_| { return io }
        if st[0] != 0 { return invalid }
        // Break any copied hard link before changing one generated file.
        fs_remove("{tree}{path}") else |_| { return io }
    }
    durable_text("{tree}{path}", text)?
    append_attrs(attrs, path, "0644", 0, 0)?
}

fn account_table(text: str, name: str, group: bool) -> str ! {invalid} {
    var out = ""
    var root = false
    var replaced = false
    for line in text.lines() {
        let f = line.split(":")
        if f.len != (if group then 4 else 7) { return invalid }
        let id = f[2].to_int() else |_| { return invalid }
        if f[0] == "root" {
            if id != 0 || root { return invalid }
            root = true
        }
        if id == INSTALL_USER_ID {
            if replaced { return invalid }
            replaced = true
            continue
        }
        if f[0] == name { return invalid }
        out += "{line}\n"
    }
    if !root { return invalid }
    if group {
        out += "{name}:x:{INSTALL_USER_ID}:\n"
    } else {
        out += "{name}:x:{INSTALL_USER_ID}:{INSTALL_USER_ID}:{name}:/home/{name}:/bin/pelt\n"
    }
    out
}

fn prepared_dir(tree: str, attrs: str, path: str, uid: int) -> () ! {io, invalid} {
    if fs_exists("{tree}{path}") {
        require_dir("{tree}{path}")?
    } else {
        fs_create_dir_mode("{tree}{path}", 448) else |_| { return io }
    }
    append_attrs(attrs, path, "0755", uid, uid)?
}

// px78 (R-px78-6, recommended and implemented, not decided): an install
// made from the live medium (its tree has /etc/pax-live-login) must not
// boot into the live medium's passwordless-root entry (BOOT.md: "Do not
// use this live entry in the installed system"). Its /etc/pax-run becomes
// the console login instead. px106 (R-px106-2): that login is /bin/login
// (user/login, in wolf), pid 1 and the console's session leader, asking
// for a password from /etc/shadow; while no account has one, it lets root
// in with no password and says so (the first-boot rule).
const INSTALLED_RUN: str = "/bin/login\n"

// px98: the login gives the terminal to the account before it drops to
// it, as a Linux console login does (login(1); login.defs(5)'s default:
// the account, its primary group, mode 0600); /bin/login does that since
// px106. /etc/pax-login stays for an /etc/pax-run an earlier installer
// wrote and its owner kept (`/bin/pelt /etc/pax-login`): it starts the
// login.
fn installed_login() -> str {
    "#!/bin/pelt\n" +
    "# The installed system's console login is /bin/login since px106; this\n" +
    "# file, written by pax-install, is kept for an /etc/pax-run that names it.\n" +
    "exec /bin/login\n"
}

// px106 (R-px106-1): /etc/shadow, root's, 0600, one line an account of
// `passwd_text`, every one locked (root `*`, the rest `!`, as Ubuntu's
// base image and useradd leave them; the ages 0, 99999 and 7); `day` the
// date of the last change, days since 1970. The same lines as user/auth's
// shadow_all_locked, which the installer cannot link (its own toolchain).
fn locked_shadow(passwd_text: str, day: int) -> str {
    var out = ""
    for line in passwd_text.lines() {
        let f = line.split(":")
        if f.len < 7 || f[0].len == 0 { continue }
        let field = if f[0] == "root" then "*" else "!"
        out += "{f[0]}:{field}:{day}:0:99999:7:::\n"
    }
    out
}

fn today() -> int {
    time_unix_ms() / 86400000
}

/// px106: `shadow` is the /etc/shadow the guided install's passwords made
/// (passwd -R on the accounts it will write), or "" for every account
/// locked; either way root's, 0600 (R-px106-1).
fn configure_tree(p: Plan, tree: str, attrs: str, games: List[Game], shadow: str) -> () ! {
    io,
    invalid,
    corrupt_asset,
} {
    let passwd = fs_read_text("{tree}/etc/passwd") else |_| { return io }
    let group = fs_read_text("{tree}/etc/group") else |_| { return io }
    if fs_exists("{tree}/etc/pax-live-login") {
        replace_config(tree, attrs, "/etc/pax-run", INSTALLED_RUN)?
        replace_config(tree, attrs, "/etc/pax-login", installed_login())?
    }
    let accounts = account_table(passwd, p.user, false)?
    replace_config(tree, attrs, "/etc/passwd", accounts)?
    // px106 (R-px106-6 B3): the user in group sudo (gid 27), as Ubuntu's installer makes its first user.
    let groups = sudo_member(account_table(group, p.user, true)?, p.user) else |_| { return invalid }
    replace_config(tree, attrs, "/etc/group", groups)?
    let shadow_text = if shadow.len > 0 then shadow else locked_shadow(accounts, today())
    if fs_exists("{tree}/etc/shadow") { fs_remove("{tree}/etc/shadow") else |_| { return io } }
    durable_text("{tree}/etc/shadow", shadow_text)?
    append_attrs(attrs, "/etc/shadow", "0600", 0, 0)?
    replace_config(tree, attrs, "/etc/fstab", fstab_text(new_partuuid(p.seed)))?
    replace_config(tree, attrs, "/boot/limine/limine.conf", new_config(p.seed))?
    prepared_dir(tree, attrs, "/home/{p.user}", INSTALL_USER_ID)?
    if fs_exists("{tree}/home/{p.user}/Games") { return invalid }
    if p.games {
        prepared_dir(tree, attrs, "/home/{p.user}/Games", INSTALL_USER_ID)?
        for g in games {
            let dir = "/home/{p.user}/Games/{g.name}"
            prepared_dir(tree, attrs, dir, INSTALL_USER_ID)?
            copy_regular(g.archive, "{tree}{dir}/source.tar.gz")?
            verify_file("{tree}{dir}/source.tar.gz", g.archive_digest)?
            append_attrs(attrs, "{dir}/source.tar.gz", "0644", INSTALL_USER_ID, INSTALL_USER_ID)?
            copy_regular(g.engine, "{tree}{dir}/engine.source.tar.gz")?
            verify_file("{tree}{dir}/engine.source.tar.gz", g.engine_digest)?
            append_attrs(attrs, "{dir}/engine.source.tar.gz", "0644", INSTALL_USER_ID, INSTALL_USER_ID)?
            copy_regular(g.source, "{tree}{dir}/{g.name}")?
            verify_file("{tree}{dir}/{g.name}", g.digest)?
            append_attrs(attrs, "{dir}/{g.name}", "0755", INSTALL_USER_ID, INSTALL_USER_ID)?
        }
    }
}
