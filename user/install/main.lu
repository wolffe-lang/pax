//! Guided or explicitly scripted fresh install. No default confirmation:
//! the guided install asks the word yes after a summary naming the disk
//! (px78b); the scripted `--install --ext2-preview` takes `--confirm` with
//! the plan's exact token (--dry-run prints it).
//! px78: only a disk on the install allow-list is ever a target (allow.lu);
//! `--check` prints every disk's verdict and writes nothing; the stick's
//! install log records the run.
//! px93: `--upgrade` puts the running stick's image over the install the
//! upgrade entry mounted at /mnt/target, the user's files kept (upgrade.lu).

use std.x.crypto.sha2

fn options(args: List[str]) -> Options ! {invalid} {
    var o = Options {
        mode: "guided",
        target: "",
        seed: "",
        user: "",
        games: "",
        confirm: "",
        preview: false,
        source: "/",
        payload: "/usr/share/pax-install",
        tools: "/bin",
        allow: "",
    }
    var seen = Map[str, bool]()
    var i = 0
    while i < args.len {
        let key = args[i]
        if seen[key] else false { return invalid }
        seen[key] = true
        i += 1
        if key == "--inventory" || key == "--dry-run" || key == "--install" || key == "--check" || key == "--upgrade" {
            if o.mode != "guided" { return invalid }
            o.mode = key
            continue
        }
        if key == "--ext2-preview" { o.preview = true; continue }
        if i == args.len { return invalid }
        let value = args[i]
        i += 1
        match key {
            "--target" => { o.target = value },
            "--seed" => { o.seed = value },
            "--user" => { o.user = value },
            "--games" => { o.games = value },
            "--confirm" => { o.confirm = value },
            "--source" => { o.source = value },
            "--payload" => { o.payload = value },
            "--tool-dir" => { o.tools = value },
            "--allow-list" => { o.allow = value },
            _ => { return invalid },
        }
    }
    if o.target.starts_with("/dev/") { o.target = o.target[5..] }
    if o.mode == "--install" && (!o.preview || o.confirm.len == 0 || o.seed.len == 0) {
        return invalid
    }
    if (o.mode == "guided" || o.mode == "--check") &&
        (o.target.len != 0 || o.user.len != 0 || o.games.len != 0 || o.confirm.len != 0) {
        return invalid
    }
    // px93: the upgrade names its target by the allow-list alone; a
    // scripted run gives the seed and the confirmation line together.
    if o.mode == "--upgrade" &&
        (o.target.len != 0 || o.user.len != 0 || o.games.len != 0 || o.preview || (o.confirm.len == 0) != (o.seed.len == 0)) {
        return invalid
    }
    o
}

fn fresh_seed() -> str {
    var bytes = List[byte]()
    for n in os_random(32) { (mut bytes).push(n as byte) }
    sha2.to_hex(bytes)
}

fn main() -> int {
    let o = options(env_args()) else |_| {
        eprint(
            "usage: pax-install [--inventory | --check | --dry-run | --install --ext2-preview --confirm TOKEN | --upgrade [--seed TEXT --confirm LINE]] [--target NAME --seed TEXT --user NAME --games yes|no] [--allow-list FILE] [--source DIR --payload DIR --tool-dir DIR]",
        )
        return 2
    }
    if o.mode == "--inventory" {
        let ts = inventory() else |e| match e {
            denied => { return 1 }, // px87 (pax#266): open_disk named the node and why
            _ => { eprint("pax-install: inventory: {e}"); return 1 },
        }
        for t in ts { print(inventory_text(t)) }
        return 0
    }
    // Scratch before the inventory and the snapshot (execute_plan's note).
    let work = "/tmp/pax-install-{os_pid()}"
    fs_create_dir_mode(work, 448) else |_| { eprint("pax-install: scratch {work}"); return 1 }
    if o.mode == "--upgrade" { return upgrade_main(o, work) } // px93
    let ts = inventory() else |e| match e {
        denied => { return 1 }, // px87 (pax#266): open_disk named the node and why
        _ => { eprint("pax-install: inventory: {e}"); return 1 },
    }
    let (disks, list) = judge_all(ts, o.allow, o.tools, work)
    var lg = if o.mode == "--check" then no_log("--check writes nothing") else open_log(disks, o.tools, work)
    note(mut lg, "PAX install log {lg.path}")
    note(mut lg, "release {release_line()}")
    note(mut lg, "mode {o.mode}")
    say(mut lg, "Install log: {log_place(lg)}")
    report_disks(mut lg, disks, list)
    flush_log(mut lg)
    if o.mode == "--check" { return if eligible(disks).len == 0 then 1 else 0 }
    let seed = if o.seed.len == 0 then fresh_seed() else o.seed
    var p = Plan {
        target: Target { name: "", identity: "", bytes: 0, sector: 0, readonly: false, mounted: false, running_root: false },
        seed: "",
        user: "",
        games: false,
        root_bytes: 0,
        tail_bytes: 0,
        unused_bytes: 0,
        token: "",
    }
    if o.mode == "guided" {
        if eligible(disks).len == 0 {
            return stop(mut lg, "pax-install: refused before writes: no disk is on the install allow-list")
        }
        p = guided_plan(mut lg, disks, seed) else |e| {
            return stop(mut lg, "pax-install: cancelled/refused before writes: {e}")
        }
    } else {
        var why = "no such disk"
        var t = p.target
        for d in disks {
            if d.target.name == o.target { why = d.reason; t = copy d.target }
        }
        if why.len != 0 { return stop(mut lg, "pax-install: refused: {why}: /dev/{o.target}") }
        p = make_plan(t, seed, o.user, o.games) else |e| { return stop(mut lg, "pax-install: refused: {e}") }
    }
    if o.mode == "--dry-run" { print_raw(plan_text(p)); return 0 }
    if o.mode != "guided" {
        confirm_plan(p, p.target, o.confirm) else |e| { return stop(mut lg, "pax-install: before writes: {e}") }
    }
    let source = fs_realpath(o.source) else |e| { return stop(mut lg, "pax-install: source: {e}") }
    execute_plan(mut lg, p, source, o.payload, o.tools, work) else |e| {
        return stop(
            mut lg,
            "pax-install: stopped: {e}; no rollback promised. If writes began, inspect the target's persistent phase log; bootability is NOT established.",
        )
    }
    if o.mode == "guided" {
        let s = answer(
            mut lg,
            "Type reboot to reboot now or poweroff to power off; anything else leaves the running system up: ",
        ) else |_| ""
        flush_log(mut lg)
        if s == "reboot" || s == "poweroff" {
            let argv = if s == "reboot" then ["/bin/reboot"] else ["/bin/reboot", "-p"]
            let child = os_spawn(argv) else |e| {
                eprint("pax-install: {s}: {e}")
                return 1
            }
            let status = os_wait(child) else |e| { eprint("pax-install: {s}: {e}"); return 1 }
            return status
        }
    }
    0
}
