#!/usr/bin/env bash
# build — build termwolf (user/termwolf/termwolf.lu, px58: the terminal
# yew asks for, asked of the console), a probe in wolf, as a fully static
# x86-64 Linux executable.
#
#   user/termwolf/build OUTDIR
#
# tools/mksigwolf's shape, with this directory's own toolchain file: the
# wolf release archive user/termwolf/wolf-toolchain.toml names for
# x86_64-unknown-linux-gnu, by its sha256 (refused on a mismatch, and on
# a `--version` that is not the file's `version_line`), and wolf-std at
# the commit it names (`WOLF_STD`), so the probe is built by the wolf yew
# is built by, whatever the kernel's pin is. The directory is a package
# (wolf.pkg: `asm` lists tio.S, the raw terminal ioctls), built as su and
# sigwolf are (`wolf build --release --no-cache --deny-warnings`) through
# a `cc` first on PATH that adds `-static`: a static glibc executable,
# ET_EXEC, no PT_INTERP, checked (readelf); `OUTDIR/sums.txt` gets
# `termwolf <sha256> <bytes>`.
#
# Build on a baseline x86-64 glibc (the CI runner's Ubuntu; an Ubuntu
# container on kasumi), never on kasumi's CachyOS x86-64-v4 glibc (px10).
# The release tier needs clang at run time (wolf's D33). Exit 0, or 2 on
# a tool error.
set -euo pipefail
. "$(dirname "$0")/../../tools/lib.sh"
[ $# -eq 1 ] || die "usage: user/termwolf/build OUTDIR"
out=$1
need git curl tar readelf cc clang
mkdir -p "$out" "$PAX_CACHE"
out=$(cd "$out" && pwd)

w=$(mktemp -d "${TMPDIR:-/tmp}/pax-termwolf.XXXXXX")
trap 'rm -rf "$w"' EXIT

toml=$PAX_ROOT/user/termwolf/wolf-toolchain.toml
key() { # section key
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { on = ($0 == s); next }
        on && $1 == k { v = $0; sub(/^[^=]*= *"?/, "", v); sub(/"? *$/, "", v); print v; exit }' "$toml"
}
wv=$(key wolf version)
wsha=$(key wolf x86_64-unknown-linux-gnu)
wline=$(key wolf version_line)
srepo=$(key std repo)
srev=$(key std rev)
[ -n "$wv" ] && [ -n "$wsha" ] && [ -n "$srepo" ] && [ -n "$srev" ] \
    || die "cannot read wolf version/digest and std repo/rev from $toml"
say "termwolf pins wolf $wv (${wsha:0:8}…), wolf-std $srev"

# wolf, by the digest the file names (cached by digest).
arc=$PAX_CACHE/wolf-$wv-$wsha.tar.gz
if [ ! -f "$arc" ] || [ "$(sha256_of "$arc")" != "$wsha" ]; then
    curl -sSfL --retry 3 -o "$arc.part" \
        "https://github.com/wolffe-lang/wolf-lang/releases/download/v$wv/wolf-$wv-x86_64-unknown-linux-gnu.tar.gz" \
        || die "cannot download wolf $wv"
    mv "$arc.part" "$arc"
fi
[ "$(sha256_of "$arc")" = "$wsha" ] || die "wolf $wv archive: sha256 $(sha256_of "$arc"), termwolf pins $wsha"
mkdir -p "$w/wolf"
tar -xzf "$arc" -C "$w/wolf" --strip-components=1
wolf=$w/wolf/wolf
have=$("$wolf" --version | head -n 1)
[ "$have" = "$wline" ] || die "wolf --version says '$have'; termwolf pins '$wline'"
say "$have"

# wolf-std at the commit the file names.
mkdir -p "$w/stdrepo"
git -C "$w/stdrepo" init -q
git -C "$w/stdrepo" fetch -q --depth 1 "https://github.com/${srepo}" "$srev" || die "cannot fetch $srepo at $srev"
git -C "$w/stdrepo" checkout -q --detach FETCH_HEAD
[ "$(git -C "$w/stdrepo" rev-parse HEAD)" = "$srev" ] || die "$srepo: HEAD is not $srev"
std=$w/stdrepo/std
[ -d "$std" ] || die "wolf-std $srev has no std/"

# The static `cc`.
mkdir -p "$w/bin" "$w/src"
real=$(command -v cc)
printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" > "$w/bin/cc"
chmod +x "$w/bin/cc"
cp "$PAX_ROOT/user/termwolf/termwolf.lu" "$PAX_ROOT/user/termwolf/tio.S" "$PAX_ROOT/user/termwolf/wolf.pkg" "$w/src/"

: > "$out/sums.txt"
(cd "$w/src" && PATH="$w/bin:$PATH" WOLF_STD=$std \
    "$wolf" build --release --no-cache --deny-warnings termwolf.lu -o "$out/termwolf") >&2 \
    || die "wolf build of user/termwolf/termwolf.lu"
readelf -hW "$out/termwolf" | grep -Eq 'Type: +EXEC' || die "termwolf is not ET_EXEC"
! readelf -lW "$out/termwolf" | grep -q INTERP || die "termwolf has a PT_INTERP (not static)"
printf '%s %s %s\n' termwolf "$(sha256_of "$out/termwolf")" "$(wc -c < "$out/termwolf" | tr -d ' ')" | tee -a "$out/sums.txt"
printf 'linked against: %s\n' "$("$real" -print-file-name=libc.a)"
