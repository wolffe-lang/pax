// termwolf — px58's probe of the terminal yew asks for, a hosted wolf
// program built for x86-64 Linux and run unmodified on PAX
// (user/termwolf/build). `asm` lists tio.S, the raw terminal ioctls wolf
// has no builtin for (a termios's every bit, a winsize), reached through
// `extern "c" fn` declarations, which carry `ffi`; the rest are the
// builtins it names: `env` (its arguments, its ids), `exec` (the signal
// calls), `fs` (the descriptors, /dev/tty).
pkg {
    name: "pax/termwolf"
    version: "0.1.0"
    capabilities: [env, exec, ffi, fs]
    asm: ["tio.S"]
}
