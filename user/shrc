# /etc/shrc — what PAX's console shell runs before its first prompt
# (px54). /etc/pax-run starts the shell as `/bin/env ENV=/etc/shrc
# /bin/sh -i -m`, and an interactive pelt runs the file $ENV names before
# it prompts (POSIX XCU 2.5.3); a shell started from this one (`exec
# sh`, `su pax`) inherits ENV and runs it too. What it runs is lope's
# hook (ruling #91 R4; user/lope.pin): `cd` records each directory in
# lope's store, `g` and `gi` jump, and a word that names no command
# jumps to the directory lope knows by it (pelt's
# command_not_found_handle, sh21). The store is
# $HOME/.local/share/lope/store (`/` for root) in PAX's in-memory tree:
# gone at reboot until PAX has storage.
eval "$(lope init pelt)"

# R-px57-1(a): lupin resolves use std.* from the installed source tree.
export LUPIN_STD=/usr/share/wolf/std

# px104 (R-px104-5, amending px100's R-px100-1): den's two service
# wrappers are on PATH as /bin/git-upload-pack and /bin/git-receive-pack
# (tools/install-den), the names den runs when DEN_UPLOAD_PACK and
# DEN_RECEIVE_PACK are unset, so this file sets neither: over ssh den
# sends the far side git's own command, `git-receive-pack '<path>'`.
#
# px104 (R-px104-2): the root set den's https checks a server against,
# Mozilla's store as user/roots.pin names it (den reads no system store
# of its own).
export DEN_TLS_ROOTS=/etc/ssl/certs/ca-roots.der

# px124: `logout` ends a login shell, as bash's builtin does, and tells any
# other shell to use `exit`. A login shell here is one that leads its
# session (/proc/$$/stat's sixth field is its own pid): the console's,
# which /bin/init starts so. At an installed system's console init then
# hangs the session up and asks `login:` again; `exit` and Ctrl-D at an
# empty prompt do the same.
logout() {
    read -r __pax_x __pax_x __pax_x __pax_x __pax_x __pax_sid __pax_x < /proc/$$/stat
    if [ "$__pax_sid" = "$$" ]; then
        exit "$@"
    fi
    echo "logout: not login shell: use \`exit'" >&2
    return 1
}
