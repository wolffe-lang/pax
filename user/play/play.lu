//! play — play a note file through the console's speaker (px18).
//!
//!     play                 list the tunes in /usr/share/tunes
//!     play NAME|PATH ...   play each, in order (a NAME without a `/`
//!                          is /usr/share/tunes/NAME)
//!     play -m | -s ...     px30: mixed (the sound device, `/dev/dsp`)
//!                          or the speaker; with neither, mixed when
//!                          /dev/dsp opens, else the speaker (mix.lu)
//!     play -w square|triangle|mix ...   the mixed mode's voices
//!     play -c ...          the mixed mode's cost: synthesise without
//!                          a sound and say how long it took
//!
//! **The note file** is plain text, one item a line; `#` starts a
//! comment that runs to the end of its line; blank lines are skipped:
//!
//!     title <words>     optional, before the tempo
//!     tempo <bpm>       quarter notes a minute, 20-400; before any note
//!     gap <ms>          optional, 0-100 (default 20): silence cut from
//!                       the end of every note, so repeated notes part
//!     <note> <length>   C D E F G A B, then `#` or `b` or nothing, then
//!                       the octave 2-7 (A4 = 440 Hz, equal temperament)
//!     r <length>        a rest
//!     <chord> <length>  px29: two to four notes joined by commas, no
//!                       spaces (`C4,E4,G4 2`): one slot, sounded as an
//!                       arpeggio on the speaker's one voice (below)
//!     arp <ms>          px29, optional, 10-100 in tens (default 20): how
//!                       long each pitch of a chord sounds before the next
//!     order <way>       px29, optional: `up` (low to high, the default),
//!                       `down`, or `written` (as the chord is spelled)
//!     tempo <bpm>       again, anywhere: the lengths after it use it
//!
//! A length is 1 2 4 8 16 or 32 (whole to thirty-second), a trailing `.`
//! dots it, a trailing `t` makes it a triplet's (two thirds of it: three
//! `8t` fill a quarter; px29), and `+` ties lengths together (`4+16`,
//! `2.+8`, `1+1`).
//!
//! **A chord** sounds its pitches one after another, each for the `arp`
//! time, in the tune's `order`, over and over until its slot's sounding
//! time ends (a slot need not hold whole cycles), with no silence between
//! them; the `gap` comes at the slot's end, as for a note. A chord
//! carries at most four pitches, each once. The time is a whole number of
//! the kernel's 10 ms ticks because a step that is not one lands a tick
//! early or late (measured, notes/px29-the-chord.md); 20 ms, fifty
//! pitches a second, is heard as one chord.
//!
//! **Dynamics** (`p`, `mf`, `ff`, `cresc`, ...) are refused by name: the
//! speaker is one bit, so it has one loudness.
//!
//! Every file is read and checked whole before a sound: a bad line is
//! `play: <path>: line <n>: <what>` on standard error, status 2, and
//! nothing plays. A file that cannot be read is `play: <path>: no such
//! tune` or `cannot read`, status 2.
//!
//! **The sound** is Linux's console ioctl KIOCSOUND (0x4B2F,
//! `ioctl_kd(2)`): its argument is the 8254's count, 1193182 / Hz, and 0
//! is silence. play asks it of the first of descriptors 0, 1 and 2 that
//! accepts a silencing KIOCSOUND (a console answers 0; a pipe, a file or
//! a pseudo-terminal answers -ENOTTY), so it runs unmodified on a Linux
//! virtual console and on PAX's console; with none it says `play: no
//! console speaker on descriptors 0-2` and exits 1. The call is kd.S's
//! `play_kd`, the one routine wolf has no builtin for.
//!
//! **The time** is an absolute schedule: every note's start is the
//! first note's start plus the lengths before it, read from the
//! monotonic clock, and play sleeps only the difference, so no error
//! accumulates. The speaker is silenced at the end of every note and
//! before every exit.

/// The tunes' directory.
const TUNES: str = "/usr/share/tunes"

/// KIOCSOUND (uapi linux/kd.h).
const KIOCSOUND: int = 0x4b2f

/// The PC's 8254 input clock, in hundredths of a hertz.
const PIT_CENTI_HZ: int = 119318200

extern "c" fn play_kd(fd: int, req: int, arg: int) -> int

/// A checked note file: its notes' counts (0 a rest) and lengths, or
/// the reason it is refused. A chord's slot (px29) keeps its first
/// pitch in `counts` and all of its pitches, in sounding order, in
/// `chords`, from `chord_at[i]` for `chord_n[i]` (0 for a note or rest).
struct Tune {
    title: str,
    err: str,
    counts: List[int],
    lengths: List[int], // microseconds
    gap: int, // microseconds
    total: int, // microseconds
    chord_at: List[int],
    chord_n: List[int],
    chords: List[int],
    arp: int, // microseconds a chord's pitch sounds
}

fn main() -> int {
    let all = env_args()
    // px30: the options come first: -m mixed (the sound device, or
    // status 1), -s the speaker, -w square|triangle|mix (the mixed
    // mode's voices), -c (the mixed mode's cost: synthesise each tune
    // without sounding it and say how long that took).
    var mode = 0 // 0: the device when /dev/dsp opens, else the speaker
    var style = 0
    var cost = false
    var first = 0
    while first < all.len && all[first].starts_with("-") {
        let o = all[first]
        if o == "-m" {
            mode = 1
        } else if o == "-s" {
            mode = 2
        } else if o == "-c" {
            cost = true
        } else if o == "-w" && first + 1 < all.len {
            first += 1
            let w = all[first]
            style = if w == "square" { 1 } else { if w == "triangle" { 2 } else { if w == "mix" { 0 } else { -1 } } }
            if style < 0 {
                eprint("play: -w takes square, triangle or mix, not '{w}'")
                return 2
            }
        } else {
            eprint("play: unknown option '{o}' (-m, -s, -w square|triangle|mix, -c)")
            return 2
        }
        first += 1
    }
    var args = List[str]()
    var ai = first
    while ai < all.len {
        (mut args).push(copy all[ai])
        ai += 1
    }
    if args.len == 0 {
        return list()
    }
    var tunes = List[Tune]()
    var paths = List[str]()
    for a in args {
        let p = path_of(a)
        let t = load(p)
        if t.err != "" {
            eprint("play: {p}: {t.err}")
            return 2
        }
        (mut paths).push(p)
        (mut tunes).push(t)
    }
    if cost {
        return mixed_cost(tunes, style)
    }
    if mode != 2 {
        let d = dsp_open()
        if d.fd >= 0 {
            return mixed(d, tunes, style)
        }
        if mode == 1 {
            eprint("play: /dev/dsp: cannot open or set it up (-{0 - d.fd})")
            return 1
        }
    }
    let fd = console()
    if fd < 0 {
        eprint("play: no console speaker on descriptors 0-2")
        return 1
    }
    var i = 0
    while i < tunes.len {
        print("playing {tunes[i].title} ({secs(tunes[i].total)} s)")
        perform(fd, tunes[i])
        i += 1
    }
    0
}

/// px30: slot `i` of tune `t` as the mixed mode sounds it: the
/// centi-hertz of each of its pitches (none for a rest), from the
/// speaker's own counts, so both modes sound the same pitches. A chord
/// (px29) gives every pitch of its slot.
fn slot_pitches(t: Tune, i: int) -> List[int] {
    var out = List[int]()
    if t.chord_n[i] > 0 {
        var k = 0
        while k < t.chord_n[i] {
            (mut out).push(PIT_CENTI_HZ / t.chords[t.chord_at[i] + k])
            k += 1
        }
        return out
    }
    if t.counts[i] > 0 {
        (mut out).push(PIT_CENTI_HZ / t.counts[i])
    }
    out
}

/// px30: tune `t`'s slots for kernel `mix`: pitches, lengths, sounding
/// times, and the most pitches in one slot.
fn slots(t: Tune) -> (List[List[int]], List[int], List[int], int) {
    var ps = List[List[int]]()
    var ls = List[int]()
    var ss = List[int]()
    var most = 0
    var i = 0
    while i < t.counts.len {
        let p = slot_pitches(t, i)
        if p.len > most {
            most = p.len
        }
        let len = t.lengths[i]
        var sound = len - t.gap
        if sound < len / 2 {
            sound = len / 2
        }
        (mut ps).push(p)
        (mut ls).push(len)
        (mut ss).push(sound)
        i += 1
    }
    (ps, ls, ss, most)
}

/// px30: play every tune through /dev/dsp, mixed.
fn mixed(d: Dsp, tunes: List[Tune], style: int) -> int {
    var i = 0
    while i < tunes.len {
        let (ps, ls, ss, most) = slots(tunes[i])
        print("playing {tunes[i].title} ({secs(tunes[i].total)} s), mixed: {most} voices at most, {d.rate} Hz")
        let r = perform_mixed(ps, ls, ss, most, style, d.rate, d.channels, true)
        if r.err != 0 {
            eprint("play: /dev/dsp: write failed (-{0 - r.err})")
            let _c = dsp_close()
            return 1
        }
        i += 1
    }
    let c = dsp_close()
    if c < 0 {
        eprint("play: /dev/dsp: close failed (-{0 - c})")
        return 1
    }
    0
}

/// px30: `play -c`: each tune synthesised at 48 kHz without a sound,
/// and the time it took against the time it would sound.
fn mixed_cost(tunes: List[Tune], style: int) -> int {
    var i = 0
    while i < tunes.len {
        let (ps, ls, ss, most) = slots(tunes[i])
        let t0 = time_now_ms()
        let r = perform_mixed(ps, ls, ss, most, style, 48000, 2, false)
        let ms = time_now_ms() - t0
        let sound_ms = r.frames / 48
        let pct10 = if sound_ms > 0 { ms * 1000 / sound_ms } else { 0 }
        print("cost {tunes[i].title}: {r.frames} frames ({sound_ms} ms of sound, {most} voices at most) synthesised in {ms} ms, {pct10 / 10}.{pct10 % 10}% of real time, {r.clamped} clamped")
        i += 1
    }
    0
}

/// A NAME without a `/` is a tune in TUNES; anything else a path.
fn path_of(a: str) -> str {
    for b in a.bytes() {
        if b as int == 47 {
            return a
        }
    }
    "{TUNES}/{a}"
}

/// `play` alone: each tune (a file) in TUNES, sorted, with its title
/// and length.
fn list() -> int {
    let names = fs_read_dir(TUNES) else |_| {
        eprint("play: {TUNES}: cannot read")
        return 2
    }
    let sorted = sort(names)
    var width = 0
    for n in sorted {
        if fs_is_file("{TUNES}/{n}") && n.len > width {
            width = n.len
        }
    }
    for n in sorted {
        if !fs_is_file("{TUNES}/{n}") {
            continue
        }
        let t = load("{TUNES}/{n}")
        var line = n
        var k = n.len
        while k < width + 2 {
            line = "{line} "
            k += 1
        }
        if t.err != "" {
            print("{line}(refused: {t.err})")
        } else {
            print("{line}{t.title}, {secs(t.total)} s")
        }
    }
    0
}

/// `names` in byte order (an insertion sort: a directory of tunes is short).
fn sort(names: List[str]) -> List[str] {
    var out = List[str]()
    for n in names {
        var at = out.len
        var j = 0
        while j < out.len {
            if before(n, out[j]) {
                at = j
                break
            }
            j += 1
        }
        var next = List[str]()
        var k = 0
        while k < out.len {
            if k == at {
                (mut next).push(copy n)
            }
            (mut next).push(copy out[k])
            k += 1
        }
        if at == out.len {
            (mut next).push(copy n)
        }
        out = next
    }
    out
}

/// Whether `a` sorts before `b`, byte by byte.
fn before(a: str, b: str) -> bool {
    let x = a.bytes()
    let y = b.bytes()
    var i = 0
    while i < x.len && i < y.len {
        if x[i] as int != y[i] as int {
            return (x[i] as int) < (y[i] as int)
        }
        i += 1
    }
    x.len < y.len
}

/// Seconds to one decimal, from microseconds.
fn secs(us: int) -> str {
    let tenths = (us + 50000) / 100000
    "{tenths / 10}.{tenths % 10}"
}

/// The first of descriptors 0, 1, 2 that answers a silencing KIOCSOUND
/// with 0; -1 when none does.
fn console() -> int {
    var fd = 0
    while fd < 3 {
        if kd(fd, 0) == 0 {
            return fd
        }
        fd += 1
    }
    -1
}

/// KIOCSOUND on `fd` with count `n`: the raw call's answer.
fn kd(fd: int, n: int) -> int {
    // # Safety: kd.S's ioctl(2) with an integer argument; no memory is
    // passed.
    unsafe { play_kd(fd, KIOCSOUND, n) }
}

/// KIOCSOUND with count `n` (0 silence) on a descriptor that accepted it.
fn tone(fd: int, n: int) {
    let _ = kd(fd, n)
}

/// Sleep until `t` milliseconds on the monotonic clock.
fn until(t: int) {
    let now = time_now_ms()
    if t > now {
        time_sleep_ms(t - now)
    }
}

/// Play `t` on `fd`'s speaker, on an absolute schedule.
fn perform(fd: int, t: Tune) {
    let t0 = time_now_ms()
    var at = 0 // microseconds since t0
    var i = 0
    while i < t.counts.len {
        let len = t.lengths[i]
        if t.counts[i] > 0 {
            var sound = len - t.gap
            if sound < len / 2 {
                sound = len / 2
            }
            if t.chord_n[i] > 0 {
                arpeggio(fd, t, i, t0, at, at + sound)
            } else {
                tone(fd, t.counts[i])
                until(t0 + (at + sound) / 1000)
            }
            tone(fd, 0)
        }
        at += len
        until(t0 + at / 1000)
        i += 1
    }
    tone(fd, 0)
}

/// Sound slot `i`'s chord from `from` to `to` (microseconds since `t0`,
/// in ms): each pitch for `t.arp`, in order, round and round; the last
/// step is cut at `to`. No silence between steps.
fn arpeggio(fd: int, t: Tune, i: int, t0: int, from: int, to: int) {
    let n = t.chord_n[i]
    var at = from
    var k = 0
    while at < to {
        tone(fd, t.chords[t.chord_at[i] + k % n])
        var next = at + t.arp
        if next > to {
            next = to
        }
        until(t0 + next / 1000)
        at = next
        k += 1
    }
}

/// Read and check the note file at `path`.
fn load(path: str) -> Tune {
    let text = fs_read_text(path) else |_| {
        if !fs_is_file(path) && !fs_is_dir(path) {
            return refused("no such tune")
        }
        return refused("cannot read")
    }
    parse(text)
}

fn refused(why: str) -> Tune {
    Tune {
        title: "",
        err: why,
        counts: List[int](),
        lengths: List[int](),
        gap: 0,
        total: 0,
        chord_at: List[int](),
        chord_n: List[int](),
        chords: List[int](),
        arp: 0,
    }
}

/// The words of one line, its comment dropped (a `#` that starts a
/// word starts the comment; inside a word, `F#4`, it is the sharp).
fn words(line: str) -> List[str] {
    var out = List[str]()
    let b = line.bytes()
    var i = 0
    while i < b.len {
        let c = b[i] as int
        if c == 35 {
            break
        }
        if c == 32 || c == 9 || c == 13 {
            i += 1
            continue
        }
        var j = i
        while j < b.len && b[j] as int != 32 && b[j] as int != 9 && b[j] as int != 13 {
            j += 1
        }
        (mut out).push(line[i..j])
        i = j
    }
    out
}

/// A decimal integer of at most six digits, or -1.
fn number(w: str) -> int {
    let b = w.bytes()
    if b.len == 0 || b.len > 6 {
        return -1
    }
    var v = 0
    for c in b {
        let d = c as int - 48
        if d < 0 || d > 9 {
            return -1
        }
        v = v * 10 + d
    }
    v
}

/// The note's frequency at octave 4, in hundredths of a hertz (equal
/// temperament, A4 = 440 Hz), by semitone above C; -1 out of range.
fn centi_hz4(semi: int) -> int {
    match semi {
        0 => 26163,
        1 => 27718,
        2 => 29366,
        3 => 31113,
        4 => 32963,
        5 => 34923,
        6 => 36999,
        7 => 39200,
        8 => 41530,
        9 => 44000,
        10 => 46616,
        11 => 49388,
        _ => -1,
    }
}

/// The 8254 count for a note word (`C4`, `F#5`, `Bb3`), or -1.
fn count_of(w: str) -> int {
    let b = w.bytes()
    if b.len < 2 || b.len > 3 {
        return -1
    }
    var semi = match b[0] as int {
        67 => 0,
        68 => 2,
        69 => 4,
        70 => 5,
        71 => 7,
        65 => 9,
        66 => 11,
        _ => -1,
    }
    if semi < 0 {
        return -1
    }
    var i = 1
    if b.len == 3 {
        let acc = b[1] as int
        if acc == 35 {
            semi += 1
        } else if acc == 98 {
            semi -= 1
        } else {
            return -1
        }
        i = 2
    }
    let oct = b[i] as int - 48
    if oct < 2 || oct > 7 {
        return -1
    }
    var o = oct
    if semi < 0 {
        semi += 12
        o -= 1
    }
    if semi > 11 {
        semi -= 12
        o += 1
    }
    var num = PIT_CENTI_HZ
    var den = centi_hz4(semi)
    if o >= 4 {
        den = den * pow2(o - 4)
    } else {
        num = num * pow2(4 - o)
    }
    (num + den / 2) / den
}

fn pow2(k: int) -> int {
    var v = 1
    var i = 0
    while i < k {
        v = v * 2
        i += 1
    }
    v
}

/// A length word's duration in microseconds at `bpm`, or -1.
fn length_of(w: str, bpm: int) -> int {
    let b = w.bytes()
    var total = 0
    var i = 0
    if b.len == 0 {
        return -1
    }
    while i < b.len {
        var j = i
        while j < b.len && b[j] as int >= 48 && b[j] as int <= 57 {
            j += 1
        }
        let n = number(w[i..j])
        if n != 1 && n != 2 && n != 4 && n != 8 && n != 16 && n != 32 {
            return -1
        }
        // A whole note is four quarters: 240 000 000 us / (bpm * n).
        var us = 240000000 / (bpm * n)
        if j < b.len && b[j] as int == 46 {
            us = us * 3 / 2
            j += 1
        } else if j < b.len && b[j] as int == 116 {
            // A triplet's: two thirds (px29).
            us = 160000000 / (bpm * n)
            j += 1
        }
        total += us
        if j < b.len {
            if b[j] as int != 43 || j + 1 == b.len {
                return -1
            }
            j += 1
        }
        i = j
    }
    total
}

/// Whether `w` names a dynamic (px29: refused, the speaker has one
/// loudness).
fn dynamic(w: str) -> bool {
    let names: List[str] = [
        "ppp",
        "pp",
        "p",
        "mp",
        "mf",
        "f",
        "ff",
        "fff",
        "sf",
        "sfz",
        "fp",
        "cresc",
        "dim",
        "crescendo",
        "diminuendo",
        "dynamic",
        "volume",
    ]
    for d in names {
        if w == d {
            return true
        }
    }
    false
}

/// A chord's 8254 counts in sounding order: `up` is low to high (the
/// largest count first), `down` high to low, `written` as spelled.
fn arrange(chord: List[int], order: str) -> List[int] {
    var out = List[int]()
    for k in chord {
        var at = out.len
        if order != "written" {
            var j = 0
            while j < out.len {
                if order == "up" && k > out[j] || order == "down" && k < out[j] {
                    at = j
                    break
                }
                j += 1
            }
        }
        var next = List[int]()
        var m = 0
        while m < out.len {
            if m == at {
                (mut next).push(k)
            }
            (mut next).push(out[m])
            m += 1
        }
        if at == out.len {
            (mut next).push(k)
        }
        out = next
    }
    out
}

/// Check a note file's text whole; the first bad line refuses it.
fn parse(text: str) -> Tune {
    var title = ""
    var bpm = 0
    var gap = 20000
    var counts = List[int]()
    var lengths = List[int]()
    var total = 0
    var arp = 20000
    var order = "up"
    var chord_at = List[int]()
    var chord_n = List[int]()
    var chords = List[int]()
    var line_no = 0
    let b = text.bytes()
    var start = 0
    while start < b.len {
        var end = start
        while end < b.len && b[end] as int != 10 {
            end += 1
        }
        line_no += 1
        let line = text[start..end]
        start = end + 1
        let ws = words(line)
        if ws.len == 0 {
            continue
        }
        let w = ws[0]
        if w == "title" {
            if bpm != 0 || counts.len > 0 {
                return refused("line {line_no}: the title comes before the tempo")
            }
            if ws.len < 2 {
                return refused("line {line_no}: a title needs words")
            }
            var t = copy ws[1]
            var k = 2
            while k < ws.len {
                t = "{t} {ws[k]}"
                k += 1
            }
            title = t
            continue
        }
        if dynamic(w) {
            return refused(
                "line {line_no}: '{w}' is a dynamic: the speaker is one bit, with one loudness",
            )
        }
        if ws.len != 2 {
            return refused("line {line_no}: '{line}' is not two words")
        }
        if w == "arp" {
            let v = number(ws[1])
            if v < 10 || v > 100 || v % 10 != 0 {
                return refused(
                    "line {line_no}: arp '{ws[1]}' is not 10-100 ms in tens (the 10 ms tick)",
                )
            }
            arp = v * 1000
            continue
        }
        if w == "order" {
            if ws[1] != "up" && ws[1] != "down" && ws[1] != "written" {
                return refused("line {line_no}: order '{ws[1]}' is not up, down or written")
            }
            order = copy ws[1]
            continue
        }
        if w == "tempo" {
            let v = number(ws[1])
            if v < 20 || v > 400 {
                return refused("line {line_no}: tempo '{ws[1]}' is not 20-400")
            }
            bpm = v
            continue
        }
        if w == "gap" {
            let v = number(ws[1])
            if v < 0 || v > 100 {
                return refused("line {line_no}: gap '{ws[1]}' is not 0-100")
            }
            gap = v * 1000
            continue
        }
        var c = 0
        var chord = List[int]()
        if w.contains(",") {
            for nw in w.split(",") {
                let k = count_of(nw)
                if k < 0 {
                    return refused(
                        "line {line_no}: '{nw}' in '{w}' is not a note (C D E F G A B, # or b, an octave 2-7)",
                    )
                }
                for e in chord {
                    if e == k {
                        return refused("line {line_no}: chord '{w}' has {nw} twice")
                    }
                }
                (mut chord).push(k)
            }
            if chord.len > 4 {
                return refused("line {line_no}: chord '{w}' has {chord.len} notes; at most 4")
            }
            chord = arrange(chord, order)
            c = chord[0]
        } else if w != "r" {
            c = count_of(w)
            if c < 0 {
                return refused(
                    "line {line_no}: '{w}' is not a note (C D E F G A B, # or b, an octave 2-7)",
                )
            }
        }
        if bpm == 0 {
            return refused("line {line_no}: a note before the tempo")
        }
        let us = length_of(ws[1], bpm)
        if us < 0 {
            return refused(
                "line {line_no}: '{ws[1]}' is not a length (1 2 4 8 16 32, a dot, + to tie)",
            )
        }
        (mut counts).push(c)
        (mut lengths).push(us)
        (mut chord_at).push(chords.len)
        (mut chord_n).push(chord.len)
        for k in chord {
            (mut chords).push(k)
        }
        total += us
    }
    if counts.len == 0 {
        return refused("no notes")
    }
    if title == "" {
        title = "untitled"
    }
    Tune {
        title: title,
        err: "",
        counts: counts,
        lengths: lengths,
        gap: gap,
        total: total,
        chord_at: chord_at,
        chord_n: chord_n,
        chords: chords,
        arp: arp,
    }
}
