// play — PAX's note-file player (px18), a hosted wolf program built for
// x86-64 Linux and run unmodified on PAX (tools/mkplay). `asm` lists
// kd.S, its one system call wolf has no builtin for (ioctl, for the
// console's KIOCSOUND). Its capabilities are the builtins it reaches:
// `fs` (the tunes), `env` (its arguments).
pkg {
    name: "pax/play"
    version: "0.1.0"
    capabilities: [env, fs]
    asm: ["kd.S"]
}
