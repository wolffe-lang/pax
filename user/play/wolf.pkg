// play — PAX's note-file player (px18), a hosted wolf program built for
// x86-64 Linux and run unmodified on PAX (tools/mkplay). `asm` lists
// kd.S, its one system call wolf has no builtin for (ioctl, for the
// console's KIOCSOUND), and (px30) /dev/dsp's open, requests and writes
// on a raw descriptor for the mixed mode (user/play/mix.lu), and (px41)
// the monotonic clock and a sleep to an absolute time on it, for the
// speaker's schedule. Its
// capabilities are the builtins it reaches: `fs` (the tunes), `env` (its arguments), and `ffi` for kd.S's
// routine, a C declaration (wolf 0.2.27 charges it, px21a).
pkg {
    name: "pax/play"
    version: "0.1.0"
    capabilities: [env, ffi, fs]
    asm: ["kd.S"]
}
