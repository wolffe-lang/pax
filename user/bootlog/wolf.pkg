// pax-boot-status (px118): how the last boots ended, from /proc/pax-boot and
// /proc/pax-bootlog, kept in /var/log/boot.log and /var/log/boot.summary.
// Builtins only, no wolf-std: `env` (its arguments), `fs` (the files), `exec`
// (its effective user, the clock).
pkg {
    name: "pax/bootlog"
    version: "0.1.0"
    capabilities: [env, exec, fs]
}
