// init (px124, pax#352): an installed PAX's pid 1. `asm` lists init.S, the
// system calls wolf has no builtin for (a session of its own, the console's
// ioctls, any child's wait, a signal to a pid, /run's mount), reached
// through `extern "c" fn` declarations, which carry `ffi`; the rest are
// builtins: `env` (its arguments and environment), `exec` (fork, exec, the
// clock, sleeping), `fs` (the files it reads and makes).
pkg {
    name: "pax/init"
    version: "0.1.0"
    capabilities: [env, exec, ffi, fs]
    asm: ["init.S"]
}
