//! init — an installed PAX's pid 1 (px124, pax#352; notes/px124-pid-1.md).
//!
//! The kernel runs /etc/pax-run's one command as pid 1, the leader of the
//! console's session with the console as its terminal (kernel/sched). An
//! installed system's is /bin/login (user/install's INSTALLED_RUN, every
//! installer's text since px106), which, run as pid 1, execs this program
//! when it is there (user/login); no installer writes /bin/init into
//! /etc/pax-run. It does once a boot what /bin/login did as pid 1 from
//! px106 on, and then stays,
//! so the console has a logout and a server can outlive the shell that
//! started it:
//!
//! 1. **/run**: a tmpfs mounted over it (0755, empty at every boot, as
//!    Linux's /run is; one already mounted, by an /etc/fstab line, is
//!    kept), /run/user (0755, root's), and /run/user/UID (0700, the
//!    account's, as pam_systemd(8) makes it) for every account of
//!    /etc/passwd whose shell is not a `…/false` or `…/nologin`: the
//!    runtime directory the XDG Base Directory Specification names
//!    (XDG_RUNTIME_DIR, which /bin/login sets), there for an ssh session
//!    too.
//! 2. sudo's timestamp records emptied (`/var/run/sudo/ts`, user/sudo): an
//!    installed PAX's /var is on ext2, and a reboot must void them.
//! 3. `pax-boot-status record` when /bin/pax-boot-status is there, waited
//!    for (px118, user/bootlog). Its failure is its own.
//! 4. The boot's login records (px133, user/auth/utmp.lu, which
//!    tools/mkinit puts beside this file): /var/run/utmp emptied (an
//!    installed system's /var is on the disk, and a reboot must leave no
//!    session in it, as Linux's tmpfs /run does) and a BOOT_TIME record,
//!    `reboot` on `~` with the kernel's release (uname(2)) and the time it
//!    is written, in utmp and /var/log/wtmp. A session the previous boot
//!    never closed (a power cut) is closed by it: `last` reads it as
//!    `crash`. A system with no /var/run or /var/log keeps no record there;
//!    a record that cannot be written is one line on the console.
//! 5. The boot's services, as the kernel command line's `pax.services=`
//!    word says (/proc/cmdline, read once; no word, or no /proc/cmdline:
//!    `hooks`, SERVICES_DEFAULT; another value is one line and the default):
//!    - `hooks`: the boot's hooks (px112): each file of /etc/pax-boot.d in
//!      name order (a name starting `.` left out), standard input
//!      /dev/null, its output on the console, the leader of a process group
//!      of its own, each waited for at most 10 s; one still running then is
//!      named and left to run. What they start stays in pid 1's session,
//!      which no console session's end reaches (burrowd is neither
//!      restarted nor ended).
//!    - `alpha`: /run/alpha/state removed (it means something only across
//!      alpha's restarts within one boot), then `/bin/alpha manager --kmsg`
//!      started as the hooks are, a job in pid 1's session (a process group
//!      of its own, never a session leader, so it never takes the console
//!      between two logins), descriptor 0 /dev/null and 1 and 2 /dev/kmsg
//!      (its lines kept in the kernel's log at their levels; the console's
//!      descriptors, with one line, when /dev/kmsg cannot be opened); then
//!      the hooks as above but each NAME that has a unit of its name
//!      (/usr/lib/alpha/units/NAME.unit or /etc/alpha/units/NAME.unit),
//!      which alpha starts in its place. With no /bin/alpha, or when it
//!      cannot be started, one line and the hooks as with `hooks`. init
//!      keeps alpha: when its first run ends with status 1 or 2 (alpha's
//!      own refusal at its start: another manager, the socket, the
//!      arguments) one line, and the hooks it was to replace run, as if
//!      there were no /bin/alpha; any other end (a signal, any exit on a
//!      later run) is one line, `init: /bin/alpha ended (…); again in N s`,
//!      and a start again N s later: 1 s, doubling to 60 s while each run
//!      ends within 2 s of its start. Never the hooks once alpha has run:
//!      the services it started may still run.
//! 6. The console leaves pid 1's session (TIOCNOTTY): from here no key,
//!    hangup or stop at the console reaches pid 1 or what the hooks left.
//! 7. Then, for ever: the console's modes put back as the boot left them
//!    (TCSETSW of the termios read at the start), its owner root and its
//!    mode 0600 again (kernel/files' boot record: /bin/login gives it to
//!    the account), and the session's program (/bin/login, or the words
//!    init was given) started in a child that leads a new session and
//!    takes the console as its controlling terminal (setsid, TIOCSCTTY
//!    with 1: taken from a session that opened it after leaving the last
//!    one, as root may, so the login always has its terminal); init waits,
//!    and reaps every other child handed to it as it ends (an orphan the
//!    kernel hands to pid 1 among them, at once, never only at a logout).
//!    When the session's leader ends, its end goes into the login records
//!    (utmp(5): init marks the ended process's utmp entry DEAD_PROCESS):
//!    when utmp holds a session of that pid (login's USER_PROCESS), a
//!    DEAD_PROCESS on the console's line, in utmp's slot and in wtmp, with
//!    the signal that ended it or its exit status, so `last` shows the
//!    logout at its own time. Then the session is hung up: every process
//!    still in it (by /proc/PID/stat's session field; a zombie left out)
//!    gets SIGHUP and SIGCONT, and SIGKILL if it is still in it 2000 ms
//!    later (the kernel's own end's grace, kernel/user); one line says so
//!    when any needed SIGKILL. A process that left the session (setsid(2),
//!    as a server does) is not touched; it is init's child once its parent
//!    ends, and init reaps it when it ends. Then the loop starts again:
//!    `HOST login:`.
//!
//! A session that ends within 2 s of its start makes the next start wait,
//! 1 s doubling to 60 s, with one line (a missing /bin/login never spins
//! the console); a longer one starts the next at once.
//!
//! **What it does not, by name:** no runlevels, inittab or getty (login
//! prompts by itself), and no service manager of its own (alpha is one,
//! started only under the word); no shutdown of its own: `reboot`
//! and `poweroff` are reboot(2), whose end is the kernel's (kernel/user's
//! `end_processes`: SIGTERM and SIGCONT to every process, init among them,
//! SIGKILL 2000 ms later, then the volumes); no screen reset and no input
//! flush between sessions; no hook started again. As any pid but 1 it
//! refuses, by name.
//!
//! References consulted: init(8), getty(8), login(1), setsid(2),
//! ioctl_tty(2), wait4(2), kill(2), mount(2), termios(3), POSIX XBD 11.1
//! (sessions, controlling terminals, the controlling process) and XSH
//! _exit, the XDG Base Directory Specification (XDG_RUNTIME_DIR),
//! pam_systemd(8) and logind.conf(5) (the runtime directory's owner and
//! mode; KillUserProcesses), and black-box runs of Ubuntu 24.04 in a
//! container. No init's, getty's, systemd's or any kernel's source.

extern "c" fn init_setsid() -> int
extern "c" fn init_ioctl(fd: int, req: int, arg: int) -> int
extern "c" fn init_kill(pid: int, sig: int) -> int
extern "c" fn init_wait(pid: int, options: int) -> int
extern "c" fn init_status() -> int
extern "c" fn init_tcsave(fd: int) -> int
extern "c" fn init_tcrestore(fd: int) -> int
extern "c" fn init_mount_run() -> int
extern "c" fn init_uname() -> int
extern "c" fn init_uname_byte(i: int) -> int

const LOGIN: str = "/bin/login"
const HOOK_DIR: str = "/etc/pax-boot.d"
/// The boot's services when the kernel command line names none.
const SERVICES_DEFAULT: str = "hooks"
const SERVICES_WORD: str = "pax.services="
const ALPHA: str = "/bin/alpha"
const ALPHA_STATE: str = "/run/alpha/state"
const UNITS_SHIPPED: str = "/usr/lib/alpha/units"
const UNITS_ADMIN: str = "/etc/alpha/units"
const HOOK_MS: int = 10000
const HANGUP_MS: int = 2000
const KILL_MS: int = 5000
const QUICK_MS: int = 2000
const PAUSE_MAX_MS: int = 60000
const TIOCSCTTY: int = 0x540e
const TIOCNOTTY: int = 0x5422
const WNOHANG: int = 1
const SIGHUP: int = 1
const SIGKILL: int = 9
const SIGCONT: int = 18
const ECHILD: int = 10

// The membrane's calls (init.S): each is one system call with integers
// for arguments; what they read or write besides (the saved termios, the
// status word, the mount's strings) is init.S's own, in .bss and
// .rodata: no memory of wolf's is passed.
fn setsid() -> int {
    // # Safety: as above.
    unsafe { init_setsid() }
}

fn ioctl(fd: int, req: int, arg: int) -> int {
    // # Safety: as above; `arg` is an integer for the requests init makes.
    unsafe { init_ioctl(fd, req, arg) }
}

fn kill(pid: int, sig: int) -> int {
    // # Safety: as above.
    unsafe { init_kill(pid, sig) }
}

fn wait(pid: int, options: int) -> int {
    // # Safety: as above; the status goes to init.S's own word.
    unsafe { init_wait(pid, options) }
}

fn status() -> int {
    // # Safety: as above.
    unsafe { init_status() }
}

fn tc_save(fd: int) -> int {
    // # Safety: as above; the termios goes to init.S's own buffer.
    unsafe { init_tcsave(fd) }
}

fn tc_restore(fd: int) -> int {
    // # Safety: as above; the termios comes from init.S's own buffer.
    unsafe { init_tcrestore(fd) }
}

fn mount_run() -> int {
    // # Safety: as above; the mount's strings are init.S's own.
    unsafe { init_mount_run() }
}

/// The kernel's release, uname(2)'s third field (init.S keeps the
/// utsname), or "" when uname fails.
fn kernel_release() -> str {
    // # Safety: as above; the utsname is init.S's own.
    let got = unsafe { init_uname() }
    if got != 0 {
        return ""
    }
    var b = List[byte]()
    var i = 0
    while i < 64 {
        // # Safety: i < 64, inside the 65-byte release field.
        let c = unsafe { init_uname_byte(i) }
        if c == 0 {
            break
        }
        (mut b).push(c as byte)
        i += 1
    }
    str_from_utf8(b) else ""
}

fn main() -> int {
    let me = os_pid()
    if me != 1 {
        eprint("init: pid 1 only (this is pid {me})")
        return 1
    }
    var prog = env_args()
    if prog.len == 0 {
        prog = [LOGIN]
    }
    let saved = tc_save(0) == 0
    let line = console_line()
    run_dirs()
    boot_clean()
    boot_record()
    boot_utmp()
    var k = Keeper { on: false, pid: 0, runs: 0, began: 0, pause: 0, due: 0 }
    if services_mode() == "alpha" {
        k = alpha_first()
    }
    boot_hooks(if k.on then HOOKS_NO_UNIT else HOOKS_ALL)
    let _dropped = ioctl(0, TIOCNOTTY, 0)
    var pause = 0
    loop {
        console_back(saved)
        let t0 = now_ms()
        let leader = start(prog)
        if leader > 0 {
            let st = wait_for(leader, mut k)
            session_end(line, leader, st)
            hang_up(leader, mut k)
        }
        if now_ms() - t0 < QUICK_MS {
            pause = if pause == 0 then 1000 else pause * 2
            if pause > PAUSE_MAX_MS {
                pause = PAUSE_MAX_MS
            }
            print("init: {prog[0]} ended within {QUICK_MS / 1000} s of its start; again in {pause / 1000} s")
            nap(pause, mut k)
        } else {
            pause = 0
        }
    }
}

fn now_ms() -> int {
    os_clock_ns() / 1000000
}

/// Sleep `ms`, reaping what ends meanwhile, alpha started again when due.
fn nap(ms: int, mut k: Keeper) {
    let until = now_ms() + ms
    while now_ms() < until {
        reap(mut k)
        alpha_due(mut k)
        time_sleep_ms(50)
    }
}

/// Every child that has ended, reaped (an orphan handed to pid 1 among
/// them; alpha's end read by the keeper); returns when none is left to
/// reap now.
fn reap(mut k: Keeper) {
    loop {
        let p = wait(-1, WNOHANG)
        if p <= 0 {
            return
        }
        if p == k.pid {
            alpha_ended(mut k, status())
        }
    }
}

/// `s` as a decimal number, or -1 when it is not one.
fn number(s: str) -> int {
    if s.len == 0 {
        return -1
    }
    var v = 0
    for b in s.bytes() {
        let d = (b as int) - 48
        if d < 0 || d > 9 {
            return -1
        }
        v = v * 10 + d
    }
    v
}

/// Whether /proc/self/mounts has a mount at `path`.
fn mounted(path: str) -> bool {
    let m = fs_read_text("/proc/self/mounts") else ""
    for line in m.lines() {
        let f = line.split(" ")
        if f.len > 1 && f[1] == path {
            return true
        }
    }
    false
}

/// /run, /run/user and each account's runtime directory (the module's 1).
fn run_dirs() {
    if !mounted("/run") {
        if !fs_is_dir("/run") {
            fs_create_dir("/run") else |_| {
            }
        }
        let r = mount_run()
        if r != 0 {
            print("init: /run: no tmpfs ({0 - r}); its directories are made on /")
        }
    }
    fs_set_mode("/run", 0o755) else |_| {
    }
    if !fs_is_dir("/run/user") {
        fs_create_dir("/run/user") else |_| {
            print("init: /run/user cannot be made; no runtime directories")
            return
        }
    }
    fs_set_owner("/run/user", 0, 0, false) else |_| {
    }
    fs_set_mode("/run/user", 0o755) else |_| {
    }
    let ptext = fs_read_text("/etc/passwd") else ""
    for line in ptext.lines() {
        let f = line.split(":")
        if f.len < 7 || f[6].ends_with("/false") || f[6].ends_with("/nologin") {
            continue
        }
        let uid = number(f[2])
        let gid = number(f[3])
        if uid >= 0 && gid >= 0 {
            user_dir(uid, gid)
        }
    }
}

/// /run/user/UID, the account's, 0700: made when it is not there, its
/// owner and mode set either way.
fn user_dir(uid: int, gid: int) {
    let d = "/run/user/{uid}"
    if !fs_is_dir(d) {
        fs_create_dir(d) else |_| {
            return
        }
    }
    fs_set_owner(d, uid, gid, false) else |_| {
    }
    fs_set_mode(d, 0o700) else |_| {
    }
}

/// sudo's timestamp records emptied (`/var/run/sudo/ts`), as Linux's /run
/// is a new tmpfs at each boot, so a reboot voids every record.
fn boot_clean() {
    let dir = "/var/run/sudo/ts"
    let names = fs_read_dir(dir) else |_| {
        return
    }
    for n in names {
        fs_remove("{dir}/{n}") else |_| {
        }
    }
}

/// px118: `pax-boot-status record` (user/bootlog) when it is there, waited
/// for; whatever it answers, the boot goes on.
fn boot_record() {
    let prog = "/bin/pax-boot-status"
    if !fs_exists(prog) {
        return
    }
    let child = os_spawn([prog, "record"]) else |_| {
        return
    }
    let _st = os_wait(child) else |_| -1
}

/// px133: utmp emptied and the boot's record in utmp and wtmp
/// (user/auth/utmp.lu's `ut_boot`), the kernel's release from uname(2).
/// A failure is one line on the console.
fn boot_utmp() {
    if !ut_boot(time_unix_ms() / 1000, kernel_release()) {
        print("init: the boot's record could not be written to {UTMP_PATH} and {WTMP_PATH}")
    }
}

const HOOKS_ALL: int = 0
const HOOKS_NO_UNIT: int = 1
const HOOKS_UNIT: int = 2

/// The boot's hooks: each file of /etc/pax-boot.d in name order, in a
/// process group of its own, standard input /dev/null, waited for at most
/// HOOK_MS: every one (HOOKS_ALL), those with no alpha unit of their name
/// (HOOKS_NO_UNIT: alpha starts the others) or only those with one
/// (HOOKS_UNIT: alpha refused at its start). A hook that cannot start, or
/// ends other than 0, is one line on the console; the boot goes on either
/// way.
fn boot_hooks(which: int) {
    var names = fs_read_dir(HOOK_DIR) else |_| {
        return
    }
    names = hook_order(names)
    for n in names {
        let path = "{HOOK_DIR}/{n}"
        if n.starts_with(".") || !fs_is_file(path) {
            continue
        }
        if which != HOOKS_ALL && has_unit(n) != (which == HOOKS_UNIT) {
            continue
        }
        let null = fs_open("/dev/null") else |_| {
            print("init: {path}: no /dev/null; not run")
            continue
        }
        let h = os_spawn_job(path, List[str](), [0, null], 0, -1, 0) else |e| {
            fs_close(null) else |_| {
            }
            print("init: {path}: not started ({e})")
            continue
        }
        fs_close(null) else |_| {
        }
        let pid = os_proc_pid(h) else -1
        let until = now_ms() + HOOK_MS
        var ended = pid <= 0
        while !ended && now_ms() < until {
            let p = wait(pid, WNOHANG)
            if p == pid {
                ended = true
                let st = status()
                let code = if (st & 0x7f) == 0 then (st >> 8) & 0xff else 128 + (st & 0x7f)
                if code != 0 {
                    print("init: {path} ended with status {code}")
                }
            } else if p < 0 {
                ended = true
            } else {
                time_sleep_ms(20)
            }
        }
        if !ended {
            print("init: {path} still runs after {HOOK_MS / 1000} s; left running")
        }
    }
}

/// `names` in byte order (a hook directory's few names).
fn hook_order(names: List[str]) -> List[str] {
    var out = List[str]()
    for n in names {
        var i = 0
        while i < out.len && !name_before(n, out[i]) {
            i += 1
        }
        var next = List[str]()
        var k = 0
        while k < out.len {
            if k == i {
                (mut next).push(n)
            }
            (mut next).push(out[k])
            k += 1
        }
        if i == out.len {
            (mut next).push(n)
        }
        out = next
    }
    out
}

fn name_before(a: str, b: str) -> bool {
    let x = a.bytes()
    let y = b.bytes()
    var i = 0
    while i < x.len && i < y.len {
        if x[i] != y[i] {
            return (x[i] as int) < (y[i] as int)
        }
        i += 1
    }
    x.len < y.len
}

/// The console as the next session should find it: its modes as the boot
/// left them (when they could be read), root's, 0600.
fn console_back(saved: bool) {
    if saved {
        let _r = tc_restore(0)
    }
    fs_set_owner("/dev/stdin", 0, 0, true) else |_| {
    }
    fs_set_mode("/dev/stdin", 0o600) else |_| {
    }
}

/// The session's program in a child that leads a new session with the
/// console as its controlling terminal: the child's pid, or -1.
fn start(prog: List[str]) -> int {
    let (pid, _h) = os_fork() else |e| {
        print("init: {prog[0]}: no fork ({e})")
        return -1
    }
    if pid == 0 {
        let _s = setsid()
        let _t = ioctl(0, TIOCSCTTY, 1)
        os_exec(prog[0], prog, env_vars(), List[int]()) else |e| {
            eprint("init: {prog[0]}: not run ({e})")
        }
        os_exit(127)
    }
    pid
}

/// Wait until `leader` ends, reaping every other child as it ends (alpha's
/// end read by the keeper, and alpha started again when due: the wait
/// then looks every 50 ms instead of sleeping in the kernel): the leader's
/// wait status, or -1 when there is no child left to wait for.
fn wait_for(leader: int, mut k: Keeper) -> int {
    loop {
        alpha_due(mut k)
        let p = wait(-1, if k.due > 0 then WNOHANG else 0)
        if p == leader {
            return status()
        }
        if p > 0 && p == k.pid {
            alpha_ended(mut k, status())
        } else if p == 0 {
            time_sleep_ms(50)
        } else if p == 0 - ECHILD {
            return -1
        } else if p < 0 {
            time_sleep_ms(100)
        }
    }
}

/// The console's line as login's records name it (`console`): what standard
/// input is, `/dev/` taken off; "" when it is no device file.
fn console_line() -> str {
    let raw = fs_read_link("/proc/self/fd/0") else |_| {
        return ""
    }
    let path = str_from_utf8(raw) else ""
    if !path.starts_with("/dev/") {
        return ""
    }
    ut_line_of(path)
}

/// The end of the session whose leader was `leader`, ended with wait
/// status `st`: DEAD_PROCESS on `line` in utmp and wtmp (`ut_logout`), the
/// signal that ended it or its exit status, when utmp holds a session of
/// that pid (a login that let no one in left none). A record that cannot
/// be written is one line on the console.
fn session_end(line: str, leader: int, st: int) {
    if line.len == 0 || st < 0 {
        return
    }
    let recs = ut_read(UTMP_PATH)
    var found = false
    var i = 0
    while i < recs.len && !found {
        let r = copy recs[i]
        found = r.kind == UT_USER_PROCESS && r.pid == leader
        i += 1
    }
    if !found {
        return
    }
    let sig = st & 0x7f
    let code = if sig == 0 then (st >> 8) & 0xff else 0
    if !ut_logout(leader, line, sig, code) {
        print("init: the end of the session of pid {leader} could not be written to {UTMP_PATH} and {WTMP_PATH}")
    }
}

/// The processes in session `sid` that have not ended (/proc/PID/stat's
/// sixth field; a zombie left out).
fn members(sid: int) -> List[int] {
    var out = List[int]()
    let names = fs_read_dir("/proc") else |_| {
        return out
    }
    for n in names {
        let pid = number(n)
        if pid <= 1 {
            continue
        }
        let st = fs_read_text("/proc/{n}/stat") else ""
        let at = st.rfind(")") else -1
        if at < 0 || at + 2 >= st.len {
            continue
        }
        let f = st[at + 2..].split(" ")
        if f.len < 4 || f[0] == "Z" {
            continue
        }
        if number(f[3]) == sid {
            (mut out).push(pid)
        }
    }
    out
}

/// The end of session `sid`: SIGHUP and SIGCONT to every process still in
/// it; SIGKILL, HANGUP_MS later, to any still there (one line then).
fn hang_up(sid: int, mut k: Keeper) {
    let first = members(sid)
    if first.len == 0 {
        return
    }
    for p in first {
        let _h = kill(p, SIGHUP)
        let _c = kill(p, SIGCONT)
    }
    let until = now_ms() + HANGUP_MS
    while now_ms() < until {
        reap(mut k)
        if members(sid).len == 0 {
            return
        }
        time_sleep_ms(20)
    }
    let left = members(sid)
    for p in left {
        let _k = kill(p, SIGKILL)
    }
    let gone = now_ms() + KILL_MS
    while now_ms() < gone && members(sid).len != 0 {
        reap(mut k)
        time_sleep_ms(20)
    }
    reap(mut k)
    print("init: the session of pid {sid}: SIGKILL to {left.len} of {first.len} still there {HANGUP_MS} ms after its SIGHUP")
}

/// The boot's services (the module's 5): "alpha" or "hooks" from the kernel
/// command line's `pax.services=` word (/proc/cmdline, read once); with no
/// word, or no /proc/cmdline, SERVICES_DEFAULT; another value is one line
/// and the default.
fn services_mode() -> str {
    let text = fs_read_text("/proc/cmdline") else ""
    for line in text.lines() {
        for w in line.split(" ") {
            if w.starts_with(SERVICES_WORD) {
                let v = w[SERVICES_WORD.len..]
                if v == "alpha" || v == "hooks" {
                    return v
                }
                print("init: {w}: neither alpha nor hooks; {SERVICES_DEFAULT}")
                return SERVICES_DEFAULT
            }
        }
    }
    SERVICES_DEFAULT
}

/// alpha as init keeps it under `pax.services=alpha`: whether it is kept
/// (`on`), its pid while it runs (0 when it does not), how many times it
/// was started, when its run began, the pause before the next start and
/// when that start is due (0: none due).
struct Keeper {
    on: bool,
    pid: int,
    runs: int,
    began: int,
    pause: int,
    due: int,
}

/// Whether the hook `name` has an alpha unit of its name, which alpha
/// starts in its place.
fn has_unit(name: str) -> bool {
    fs_exists("{UNITS_SHIPPED}/{name}.unit") || fs_exists("{UNITS_ADMIN}/{name}.unit")
}

/// alpha at the boot: the state file of an earlier boot removed, then its
/// first start. With no /bin/alpha, or a first start that fails, one line,
/// and the keeper off: the hooks run as they do with `hooks`.
fn alpha_first() -> Keeper {
    var k = Keeper { on: false, pid: 0, runs: 0, began: 0, pause: 0, due: 0 }
    if !fs_is_file(ALPHA) {
        print("init: pax.services=alpha, but there is no {ALPHA}; the boot's hooks run")
        return k
    }
    if fs_exists(ALPHA_STATE) {
        fs_remove(ALPHA_STATE) else |_| {
            print("init: {ALPHA_STATE} from an earlier boot cannot be removed")
        }
    }
    k.on = true
    alpha_start(mut k)
    k
}

/// `/bin/alpha manager --kmsg` started as a job in pid 1's session (its own
/// process group), descriptor 0 /dev/null, 1 and 2 /dev/kmsg, or the
/// console's with one line when /dev/kmsg cannot be opened. A start that
/// fails is one line: the first one turns the keeper off (the hooks run),
/// a later one makes the next start due after the pause.
fn alpha_start(mut k: Keeper) {
    k.due = 0
    let null = fs_open("/dev/null") else |_| -1
    let log = fs_open_mode("/dev/kmsg", 2) else |_| -1
    var map = List[int]()
    if null >= 0 {
        (mut map).push(0)
        (mut map).push(null)
    }
    if log >= 0 {
        (mut map).push(1)
        (mut map).push(log)
        (mut map).push(2)
        (mut map).push(log)
    } else {
        print("init: /dev/kmsg cannot be opened; {ALPHA} writes to the console")
    }
    let h = os_spawn_job(ALPHA, ["manager", "--kmsg"], map, 0, -1, 0) else |e| {
        close_fd(null)
        close_fd(log)
        if k.runs == 0 {
            k.on = false
            print("init: {ALPHA} not started ({e}); the boot's hooks run")
        } else {
            alpha_later(mut k, "not started ({e})")
        }
        return
    }
    close_fd(null)
    close_fd(log)
    k.pid = os_proc_pid(h) else -1
    k.runs += 1
    k.began = now_ms()
}

/// alpha's end, wait status `st`. Its first run's exit 1 or 2 is alpha's
/// own refusal at its start: one line, the hooks it was to replace run, and
/// it is not started again. Any other end: one line, and a start again
/// after the pause.
fn alpha_ended(mut k: Keeper, st: int) {
    k.pid = 0
    let sig = st & 0x7f
    let code = (st >> 8) & 0xff
    if k.runs == 1 && sig == 0 && (code == 1 || code == 2) {
        k.on = false
        print("init: {ALPHA} ended with status {code} at its start; the boot's hooks run")
        boot_hooks(HOOKS_UNIT)
        return
    }
    let how = if sig == 0 then "exit {code}" else "killed by signal {sig}"
    alpha_later(mut k, "ended ({how})")
}

/// The next start due after the pause: 1 s, doubling to PAUSE_MAX_MS while
/// each run ends within QUICK_MS of its start; one line.
fn alpha_later(mut k: Keeper, what: str) {
    if now_ms() - k.began < QUICK_MS {
        k.pause = if k.pause == 0 then 1000 else k.pause * 2
        if k.pause > PAUSE_MAX_MS {
            k.pause = PAUSE_MAX_MS
        }
    } else {
        k.pause = 1000
    }
    k.due = now_ms() + k.pause
    print("init: {ALPHA} {what}; again in {k.pause / 1000} s")
}

/// alpha started again when its start is due.
fn alpha_due(mut k: Keeper) {
    if k.on && k.pid == 0 && k.due > 0 && now_ms() >= k.due {
        alpha_start(mut k)
    }
}

/// `fd` closed when it is one (-1 is none).
fn close_fd(fd: int) {
    if fd >= 0 {
        fs_close(fd) else |_| {
        }
    }
}
