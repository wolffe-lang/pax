open /dev/dsp O_WRONLY: ok
second open O_WRONLY|O_NONBLOCK: EBUSY
open O_RDONLY|O_NONBLOCK beside it: ENXIO
SETFMT AFMT_QUERY 0 -> 8
SETFMT AFMT_U8 8 -> 8
SETFMT AFMT_S16_LE 16 -> 16
SETFMT AFMT_S16_BE 32 -> 16
SETFMT AFMT_MU_LAW 1 -> 16
SETFMT AFMT_S8 64 -> 16
SETFMT AFMT_S16_LE 16 -> 16
CHANNELS 1 -> 1
CHANNELS 6 -> 2
CHANNELS 0 -> 1
STEREO 1 -> 1
CHANNELS 2 -> 2
SPEED 8000 -> 8000
SPEED 44100 -> 44100
SPEED 48000 -> 48000
SPEED 11000 -> 11025
SPEED 1000 -> 5512
SPEED 400000 -> 384000
SPEED 48000 -> 48000
SETFRAGMENT 16x4096: ok
GETBLKSIZE: positive 1
GETOSPACE: all free 1, fragsize positive 1, bytes = fragments*fragsize 1
GETCAPS: TRIGGER 0 MMAP 0 DUPLEX 0
poll POLLOUT before a write: 1 revents POLLOUT 1
write 4096 bytes of silence: 4096
write 3 bytes (not a whole frame): 3
GETODELAY: non-negative 1
SYNC: ok
GETODELAY after SYNC: 0
RESET: ok
SETFMT AFMT_QUERY after RESET 0 -> 16
GETISPACE on a playback open: EINVAL
TCGETS: EINVAL
read on a playback open: EBADF
lseek: ESPIPE
close: ok
end
