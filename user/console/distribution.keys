echo PX82-PID=$$
pax-release
sha256sum /etc/pax-release
yew fl -e 'return 6 * 7'
printf 'PX82-FLOAT=%.2f\n' 1.125
scent -P x /etc/motd; echo PX82-PCRE=$?
pax-install --inventory; echo PX82-INSTALLER=$?
echo PX90-DEN=$(den --version)
echo PX90-GIT=$(git --version)
readlink /bin/git
[ ! -x /usr/bin/wolf ] || { mkdir -p /tmp/px92 && cd /tmp/px92 && printf '%s\n' 'fn main() {' '    for a in env_args() {' '        print("PX92-ARG={a}")' '    }' '}' > args.lu && wolf build --no-cache args.lu -o args && ./args one two; echo PX92-ARGS=$?; cd /; }
echo PX82-END
exit 0
