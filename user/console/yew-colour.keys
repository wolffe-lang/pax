#!ps2-session
prompt 1 $\x20
type /bin/termwolf ps2
enter
prompt 1 ps2>\x20
key ctrl-alt-up ctrl-alt-down dot
prompt 2 $\x20
type env HOME=/home/pax TERM=linux yew --clean /home/pax/keyword.lu
enter
pause 45
dump default 0.2
key esc
pause 1
type :q!
enter
prompt 3 $\x20
type env HOME=/home/pax TERM=linux YEW_COLORS=truecolor yew --clean /home/pax/keyword.lu
enter
pause 45
dump colour 0.2
key esc
pause 1
type :q!
enter
prompt 4 $\x20
type exit
enter
