#!ps2-session
prompt 1 $\x20
type cd /home/pax
enter
prompt 2 $\x20
type command -v git
enter
prompt 3 $\x20
type echo NOGIT-ABSENT=$?
enter
prompt 4 $\x20
type yew notes.txt
enter
pause 6
type :git.info
enter
pause 1
dump state-before 0.2
type G
type O
type delta
key esc
type :w
enter
pause 6
type :git.info
enter
pause 1
dump state-after 0.2
type :q
enter
prompt 5 $\x20
type echo NOGIT-EDITOR-STATUS=$?
enter
prompt 6 $\x20
type echo NOGIT-CONTENT-BEGIN
enter
prompt 7 $\x20
type cat notes.txt
enter
prompt 8 $\x20
type echo NOGIT-CONTENT-END
enter
prompt 9 $\x20
type exit
enter
