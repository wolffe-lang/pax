cd
wolf --version
cat > x.lu
^~//! member: false
^~fn main() -> !int {
^~    print("typed at PAX console, checked by wolf")
^~    0
^~}
^~^D
wolf conform-run --json --checked x.lu; echo typed=$?
wolf check /usr/share/wolf/hello.lu; echo check-hello=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/hello.lu; echo typecheck-hello=$?
wolf fmt --check /usr/share/wolf/hello.lu; echo fmt-hello=$?
wolf conform-run --json --checked /usr/share/wolf/hello.lu; echo run-hello=$?
wolf check /usr/share/wolf/loop.lu; echo check-loop=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/loop.lu; echo typecheck-loop=$?
wolf fmt --check /usr/share/wolf/loop.lu; echo fmt-loop=$?
wolf conform-run --json --checked /usr/share/wolf/loop.lu; echo run-loop=$?
wolf check /usr/share/wolf/signal.lu; echo check-signal=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/signal.lu; echo typecheck-signal=$?
wolf fmt --check /usr/share/wolf/signal.lu; echo fmt-signal=$?
wolf conform-run --json --checked /usr/share/wolf/signal.lu; echo run-signal=$?
wolf check /usr/share/wolf/spawn.lu; echo check-spawn=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/spawn.lu; echo typecheck-spawn=$?
wolf fmt --check /usr/share/wolf/spawn.lu; echo fmt-spawn=$?
wolf conform-run --json --checked /usr/share/wolf/spawn.lu; echo run-spawn=$?
wolf check /usr/share/wolf/exec.lu; echo check-exec=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/exec.lu; echo typecheck-exec=$?
wolf fmt --check /usr/share/wolf/exec.lu; echo fmt-exec=$?
wolf conform-run --json --checked /usr/share/wolf/exec.lu; echo run-exec=$?
wolf check /usr/share/wolf/fork.lu; echo check-fork=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/fork.lu; echo typecheck-fork=$?
wolf fmt --check /usr/share/wolf/fork.lu; echo fmt-fork=$?
wolf conform-run --json --checked /usr/share/wolf/fork.lu; echo run-fork=$?
wolf check /usr/share/wolf/host.lu; echo check-host=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/host.lu; echo typecheck-host=$?
wolf fmt --check /usr/share/wolf/host.lu; echo fmt-host=$?
wolf conform-run --json --checked /usr/share/wolf/host.lu; echo run-host=$?
wolf check /usr/share/wolf/std.lu; echo check-std=$?
wolf conform-run --json --phase=typecheck /usr/share/wolf/std.lu; echo typecheck-std=$?
wolf fmt --check /usr/share/wolf/std.lu; echo fmt-std=$?
wolf conform-run --json --checked /usr/share/wolf/std.lu; echo run-std=$?
exit
