#!ps2-session
prompt 1 $\x20
type cd /home/pax
enter
prompt 2 $\x20
type yew notes.txt
enter
pause 6
dump editor 0.2
type /beta
pause 1
dump search 0.2
enter
key esc
type G
type O
type delta
key esc
pause 1
dump edited 0.2
type u
pause 1
dump undo 0.2
type :q!
enter
prompt 3 $\x20
type yew fl
enter
pause 2
type return 6 * 7
enter
pause 2
dump fletch 0.2
key ctrl-d
prompt 4 $\x20
type exit
enter
