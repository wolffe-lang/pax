mkdir /g/t && cd /g/t
mkdir Script
echo 'echo hi' > Script/greet.sh; chmod +x Script/greet.sh; ./Script/greet.sh
echo st=$?
sh Script/greet.sh; echo st=$?
cp /bin/true t; ./t; echo st=$?
cp /bin/false f; ./f; echo st=$?
cat f > t; ./t; echo st=$?
printf '#!/bin/cat -n\nline two\n' > n.sh; chmod +x n.sh; ./n.sh; echo st=$?
printf '#!/bin/sh\necho "sh ran $0 with $# args: $*"\n' > s.sh; chmod +x s.sh; ./s.sh one two; echo st=$?
printf '#!/g/t/n.sh\n' > d1; chmod +x d1; ./d1; echo st=$?
printf '#!/g/t/d1\n' > d2; printf '#!/g/t/d2\n' > d3; printf '#!/g/t/d3\n' > d4; printf '#!/g/t/d4\n' > d5; chmod +x d2 d3 d4 d5
./d4; echo st=$?
./d5; echo st=$?
printf 'echo no x\n' > nx.sh; ./nx.sh; echo st=$?
printf '#!/nope\n' > m.sh; chmod +x m.sh; ./m.sh; echo st=$?
cd / && rm -r /g/t; echo st=$?
exit
