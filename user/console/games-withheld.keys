#!ps2-session
# tests/mpx6-games G6 (gm01): the same image on a kernel whose font row
# is withheld (tools/mkfont --latin1: code points 0-255 alone, as px19
# drew): the glyph screen and trail's rich title draw `?` above U+00FF,
# and a bare start of each game still picks the plain tier.
prompt 1 $\x20
type cd /home/pax
enter
prompt 2 $\x20
type cat glyphs.txt
enter
prompt 3 $\x20
dump glyphs-withheld 2
type Games/trail/trail --replay cases/trail-title-80.pk --ticks 100000
enter
prompt 1 T\x20R\x20A\x20I\x20L
dump trail-title-withheld 3
type q
prompt 4 $\x20
type Games/trail/trail
enter
prompt 2 T\x20R\x20A\x20I\x20L
dump trail-bare-withheld 3
type q
prompt 5 $\x20
type Games/pack/pack
enter
prompt 1 p\x20a\x20c\x20k
pause 3
type q
prompt 6 $\x20
type exit
enter
