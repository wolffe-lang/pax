id
su pax
id
whoami
groups
echo $HOME $USER $LOGNAME $SHELL
pwd
cd
pwd
touch mine
chmod 600 mine
ls -l mine hello.txt
cat /etc/secret
echo $?
ls /srv/lobo
rm /bin/ls
chmod 777 /etc/motd
kill 1
echo $?
kill -l
echo pax was here > /tmp/paxfile
ls -l /tmp
rm /tmp/rootfile
su
echo $?
su -s /bin/pelt lobo -c id
echo $?
exit
id
su - pax -c 'id; pwd; env'
su lobo
echo $?
su -s /bin/pelt lobo -c 'id; whoami; ls /srv/lobo'
su nosuch
echo $?
cat /tmp/paxfile
rm /tmp/paxfile /home/pax/mine
exit
