#!ps2-session
# tests/mpx6-games (gm01): the wolf games typed at PAX's PS/2 keyboard by
# tools/ps2-session, as `pax` in /home/pax, the games where the installer
# puts them (~/Games/<game>/<game>). Each frame is taken where the game
# holds it (the log quiet); cub's opening animates every 6 ticks, so its
# frame is taken at a 50 ms lull and held to the opening's frames.
prompt 1 $\x20
type cd /home/pax
enter
# G1: the games' 161 code points, one cell each
prompt 2 $\x20
type cat glyphs.txt
enter
prompt 3 $\x20
dump glyphs 2
# G2: each game's glyph-width probe (CSI 6 n, answered by the screen)
type Games/pack/pack --probe-glyphs
enter
prompt 4 $\x20
type Games/cub/cub --probe-glyphs
enter
prompt 5 $\x20
type Games/trail/trail --probe-glyphs
enter
# G3: each game's title and one replayed scene, rich
prompt 6 $\x20
type Games/trail/trail --replay cases/trail-title-80.pk --ticks 100000
enter
prompt 1 T\x20R\x20A\x20I\x20L
dump trail-title 3
type q
prompt 7 $\x20
type Games/trail/trail --replay cases/trail-natural-paused.pk --ticks 100000
enter
pause 25
dump trail-scene 3
type q
prompt 8 $\x20
type Games/cub/cub --replay cases/cub-opening.pk --ticks 100000
enter
prompt 1 Late\x20winter
dump cub-title 0.05
type q
prompt 9 $\x20
type Games/cub/cub --replay cases/cub-walk-north.pk --ticks 100000
enter
pause 10
dump cub-scene 3
type q
prompt 10 $\x20
type Games/pack/pack --tier rich
enter
prompt 1 p\x20a\x20c\x20k
dump pack-title 3
type q
prompt 11 $\x20
type Games/pack/pack --replay cases/pack-death-card.pk --ticks 100000
enter
pause 45
dump pack-scene 3
type q
# G4: a short run of each through the keyboard driver: start, three
# moves, quit; the run's record names each key; the terminal restored
prompt 12 $\x20
type Games/pack/pack --tier rich --record pack-run.pk
enter
prompt 2 p\x20a\x20c\x20k
pause 2
key spc
pause 3
key left
pause 1
key right
pause 1
key shift-down
pause 2
type q
pause 4
type q
prompt 13 $\x20
dump pack-after 2
type cat
enter
type restored
enter
key ctrl-d
prompt 14 $\x20
type cat pack-run.pk
enter
prompt 15 $\x20
type Games/cub/cub --tier rich --record cub-run.pk
enter
prompt 2 Late\x20winter
pause 1
key spc
pause 3
key up
pause 1
key left
pause 1
key shift-right
pause 2
type q
prompt 16 $\x20
dump cub-after 2
type cat
enter
type restored
enter
key ctrl-d
prompt 17 $\x20
type cat cub-run.pk
enter
prompt 18 $\x20
type Games/trail/trail --tier rich --record trail-run.pk
enter
prompt 2 T\x20R\x20A\x20I\x20L
pause 2
enter
pause 3
key up
pause 1
key left
pause 1
key down
pause 2
type q
prompt 19 $\x20
dump trail-after 2
type cat
enter
type restored
enter
key ctrl-d
prompt 20 $\x20
type cat trail-run.pk
enter
# G6 (R-gm01-4): a bare start, the tier the game detects on PAX's console
prompt 21 $\x20
type Games/trail/trail
enter
prompt 3 T\x20R\x20A\x20I\x20L
pause 3
type q
prompt 22 $\x20
type Games/pack/pack
enter
prompt 4 p\x20a\x20c\x20k
pause 3
type q
prompt 23 $\x20
type exit
enter
