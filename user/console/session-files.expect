$ mkdir /t
$ cd /t
$ mkdir -p a/b/c
$ echo one > a/f1
$ cat > a/b/note
typed at the keyboard
$ cat a/f1 a/b/note
one
typed at the keyboard
$ ls -l a a/b
a:
total 4
drwxr-xr-x 3 root root 80 DATE b
-rw-r--r-- 1 root root  4 DATE f1

a/b:
total 4
drwxr-xr-x 2 root root 40 DATE c
-rw-r--r-- 1 root root 22 DATE note
$ rm -rf /
