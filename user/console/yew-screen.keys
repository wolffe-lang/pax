#!ps2-session
# tests/mpx5-screen S2 and S3 (px59): yew, then a second pelt, typed at
# PAX's PS/2 keyboard by tools/ps2-session; each screen taken where the
# program waits for a key (the log quiet), held to tools/screen-ref.
prompt 1 $\x20
type cd /home/pax
enter
prompt 2 $\x20
type yew notes.txt
enter
quiet 6
dump yew-opened
type G
pause 2
type O
pause 2
type delta
pause 1
key esc
dump yew-edited
type :w
enter
dump yew-saved 1
# yew's message ("wrote …") lasts 4 s, then the status line is drawn again
pause 6
dump yew-expired
# C-z: yew restores the terminal and stops; the shell's job control says so
key ctrl-z
prompt 3 $\x20
dump yew-stopped
type fg
enter
quiet 6
dump yew-continued
type :q
enter
prompt 4 $\x20
dump shell
type cat notes.txt
enter
prompt 5 $\x20
dump cat
# a second pelt, started from the keyboard: its cursor reports are answered
type sh -i
enter
prompt 6 $\x20
type printf abc
enter
prompt 7 $\x20
dump pelt-6n
type exit
enter
prompt 8 $\x20
type exit
enter
