cd /tmp
echo px61-probes-begin
echo PROBE:shapes; sh /usr/share/pelt/fork/probe/shapes.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:childstate; sh /usr/share/pelt/fork/probe/childstate.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:corners; sh /usr/share/pelt/fork/probe/corners.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:notice; sh /usr/share/pelt/fork/probe/notice.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:notice2; sh /usr/share/pelt/fork/probe/notice2.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:notice3; sh /usr/share/pelt/fork/probe/notice3.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:notice4; sh /usr/share/pelt/fork/probe/notice4.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:notice5; sh /usr/share/pelt/fork/probe/notice5.sh /bin/sh; echo PROBE-STATUS:$?
echo PROBE:trapwait; sh /usr/share/pelt/fork/probe/trapwait.sh /bin/sh; echo PROBE-STATUS:$?
echo px61-probes-end
exit 0
