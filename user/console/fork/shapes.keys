cd /tmp
echo px61-shapes-begin
i=0; while [ $i -lt 8 ]; do x=$(true; true); i=$((i+1)); done; wait; echo SHAPE:fork-substitution:$i
i=0; while [ $i -lt 8 ]; do ( true; true ); i=$((i+1)); done; wait; echo SHAPE:fork-subshell:$i
i=0; while [ $i -lt 8 ]; do { true; } & wait; i=$((i+1)); done; wait; echo SHAPE:fork-background-group:$i
i=0; while [ $i -lt 8 ]; do ( true ) & wait; i=$((i+1)); done; wait; echo SHAPE:fork-background-subshell:$i
i=0; while [ $i -lt 8 ]; do { true; } | true; i=$((i+1)); done; wait; echo SHAPE:fork-stage:$i
sh /usr/share/pelt/fork/script-fork-substitution.sh
( true; true )
( true; true )
( true; true )
( true; true )
( true; true )
( true; true )
( true; true )
( true; true )
echo SHAPE:typed-fork-subshell:8
i=0; while [ $i -lt 8 ]; do ( true ) >/dev/null; i=$((i+1)); done; wait; echo SHAPE:fork-redirected-subshell:$i
i=0; while [ $i -lt 8 ]; do true & wait; i=$((i+1)); done; wait; echo SHAPE:true-background-wait:$i
i=0; while [ $i -lt 8 ]; do true & i=$((i+1)); done; wait; echo SHAPE:true-background:$i
i=0; while [ $i -lt 8 ]; do x=$(echo a | cat); i=$((i+1)); done; wait; echo SHAPE:substitution-pipeline:$i
echo px61-shapes-end
exit 0
