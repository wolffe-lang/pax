su pax
cd
mkdir t
cd t
mkdir -p a/b/c
mkdir a
echo one > a/f1
echo two >> a/f1
cat > a/b/note
^~typed at the keyboard
^~^D
cat a/f1 a/b/note
cp a/f1 a/b/c/f2
cp -r a a2
mv a2/f1 a2/moved
mv a2 a/b/a3
mv a a/b/in
ls -l a a/b
ls -l a/b/a3 /etc
stat -c '%n %s %a %h %b %F %U %G' a a/f1 a/b/a3/moved /etc/motd
echo more >> /etc/motd
echo $?
cat /etc/motd
mkdir /t
cp a/f1 /etc/f1
mv a/b /bin/b
rm /etc/motd
rmdir /bin
rmdir a
rm a/f1
rm -r a/b
rmdir a
rm -rf /
echo $?
ls /bin | wc -l
cd
rm -r t
cat t/a/f1
exit
exit
