ls -l f
stat -c '%n %s %a %A %h %F %Y %X' f
touch -a -t 199901010000 f
stat -c '%n %X %Y' f
touch -m -t 200006070809 f
stat -c '%n %X %Y' f
touch g
cat g
touch -r f g
stat -c '%n %X %Y' g
ln f h
ls -l f h
echo two >> h
cat f
ln f h
ln -f g h
stat -c '%n %h' f g h
ln -s f s
ls -l s
cat s
readlink s
ln -s nowhere d
cat d
ls -l d
ln -sf f d
readlink d
cat d
ln -sfn f d
mkdir -m 700 m
mkdir -p -m 711 p/q
mkdir -m 1777 k
ls -ld m p p/q k
ln -s p ps
ls ps
echo deep > ps/q/x
cat p/q/x
touch -t 202001020304.05 f
cp -p f c
stat -c '%n %a %Y' f c
cp -P s s2
readlink s2
cp s s3
ls -l s3
chmod -R 700 p
stat -c '%n %a' p p/q p/q/x
chmod 4755 f
ls -l f
mv s t
readlink t
cat t
rm h
stat -c '%n %h' f
rm t s2 s3 d
chmod 600 /etc/motd
touch /etc/motd
touch -t 202001020304.05 /etc/motd
ln /etc/motd hl
ln -s /etc/motd sl
cat sl
chown root f
chgrp root f
chgrp pax f
chown pax:pax f
ls -l f sl /etc/motd
rm sl
ls
cd
rm -r w
ls w
exit
