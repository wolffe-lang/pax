# tests/mpx4-tcp's run list for its `none` way (px23): the lines of
# user/mpx4-tcp.run that put nothing on the wire, run on a machine with
# no network device at all — loopback needs none — and held to the
# same Linux output as there.
/bin/tcperr
/bin/tcploop
/bin/tcpwolf
/bin/tcpbulk loop 16777216
/bin/tcpsoak loop 10000
/bin/tcpfull
