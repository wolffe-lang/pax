# tests/mpx4-lobo, session `hands` (px25): a master and four workers
# (fork, execve of itself, the listener inherited); requests; status; a
# reload by SIGHUP; one worker SIGKILLed while requests run and the
# master's replacement serving; a stop by SIGTERM.
pax: wait ^(\x1b\[6n)?\$ $ 120
type cd /srv
mark
type lobo -c conf/four.conf serve &
type echo master $!
wait master (\d+)\s*$ 30
capture M master (\d+)\s*$
wait serving on .*worker=4 120
wait generation-activated gen=1 seq=2 worker=4 120
get hands 80 / 20 new
mark
type lobo -c conf/four.conf status
wait ^worker 4: serving 60
mark
type kill -HUP {M}
wait generation-retired gen=1 .*worker=4 60
get after-hup 80 / 5 new
mark
type cat /proc/[0-9]*/status
wait PPid:\s+{M}\s 30
sleep 2
capture W Pid:\s+(\d+)\s+PPid:\s+{M}\s
load gap 80 / 25 2
sleep 5
mark
type kill -KILL {W}
wait worker-started worker=\d restarts=1 60
loadwait gap
mark
type lobo -c conf/four.conf status
wait restarts=1 60
get after-kill 80 / 10 new
mark
type kill -TERM {M}
wait worker-exited worker=\d reason=exit code=0 60
type wait
type echo hands ended $?
wait ^hands ended 0 60
pax: type exit
halt 60
