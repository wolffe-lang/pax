# clef, the assembler in wolf (wolffe-lang/clef, public; the org's own
# assembler track): GNU-as AT&T x86-64 source to ELF relocatable objects.
# 996a3ccd is as01's merge (clef#8): all 43 x86-64 census sources match
# GNU as 2.42 in section contents, relocation tuples and structural
# symbols, and the kernel's seventeen assembly objects per tier link to
# kernels byte-identical to the GNU-as baseline. tools/mkclef builds it
# static from this commit for the image (as02b); tests/mpx5-clef
# qualifies the package on PAX. Opt-in (R-as02-3 A): no image carries it
# unless asked (tools/mkdev --clef), and tools/build-kernel uses it only
# when WOLF_AS names it.
CLEF_REPO=https://github.com/wolffe-lang/clef
CLEF_REV=996a3ccdf160923757c4ce6aa474efdffa2135b3
