# tests/mpx4-tcp's run list for its `user` way (px23): the lines of
# user/mpx4-tcp.run whose other end an ordinary socket on the host can
# be (tools/tcp-host, through QEMU's user-mode network and its own
# TCP), each held to the same Linux output as there.
/bin/tcperr
/bin/tcploop
/bin/tcpwolf
/bin/tcpecho 7 10.0.2.2 9099
/bin/tcpclient 10.0.2.2 9099
/bin/tcpbulk send 10.0.2.2 9100 16777216
/bin/tcpbulk recv 7100 10.0.2.2 9097
/bin/tcpsoak to 10.0.2.2 9099 10000
/bin/tcpend 10.0.2.2 9
