// last (px133): the login records of /var/log/wtmp, and as lastb those of /var/log/btmp, as
// util-linux's last prints them. Builtins only, no wolf-std: `env` (its arguments), `fs` (the
// files, /proc/self/cmdline for the name it was run by); user/auth/utmp.lu beside it (tools/mklogd).
pkg {
    name: "pax/last"
    version: "0.1.0"
    capabilities: [env, fs]
}
