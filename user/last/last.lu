//! last — who logged in, and when (px133): the login records of /var/log/wtmp (user/auth/utmp.lu),
//! newest first, as util-linux 2.39.3's last prints them; as `lastb` (a link to it) the refused
//! logins of /var/log/btmp, root's to read.
//!
//!     last [-NUM | -n NUM] [-a] [-F] [-i] [-R] [-w] [-x] [-e] [--time-format notime|short|full|iso]
//!          [-f FILE] [USER | TTY]...
//!
//! A line a session: the user, the terminal, the host, the start, and how it ended: `- HH:MM  (DUR)`
//! for a logout, `- crash` when the machine booted again first (a power cut, a reset), `- down` when
//! it was shut down first, `still logged in` for a session of this boot whose process lives, `gone -
//! no logout` for one whose process does not. A boot is the user `reboot` on `system boot` (the
//! kernel's release in the host's place), `still running` for this boot; `-x` adds each shutdown
//! (`shutdown system down`). The last line names the file and its first record's time (`wtmp
//! begins …`). Every time is UTC (PAX keeps no zone). `-NUM`/`-n` keep that many lines, `-a` puts the
//! host last, `-F` prints whole times, `-i` the address's numbers, `-R` no host, `-w` whole names.
//! `-e` is PAX's own (util-linux has none): a column after each session saying how it ended,
//! `logout`, `dropped` (its program ended by SIGHUP: the connection went), `signal N`, `down`,
//! `crash`, `still logged in` or `gone`, from the end record's ut_exit (burrowd writes it).
//! `-d`, `-s`, `-t` and `-p` are refused by name.
//!
//! A file that cannot be opened is util-linux's words and status: `last: cannot open FILE: REASON`,
//! exit 1. Written from last(1) and utmp(5) (util-linux 2.39.3's manual pages) and black-box runs
//! of util-linux's last and lastb on files of known records (px133's notes); no util-linux source.

const WEEKDAYS: str = "Thu Fri Sat Sun Mon Tue Wed"
const MONTHS: str = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec"

struct Opts {
    file: str,
    limit: int,
    hostlast: bool,
    full: bool,
    ip: bool,
    nohost: bool,
    wide: bool,
    system: bool,
    ended: bool,
    timefmt: int, // 0 notime, 1 short, 2 full, 3 iso
    names: List[str],
    btmp: bool,
}

fn word(text: str, k: int) -> str {
    var i = 0
    for w in text.words() {
        if i == k {
            return w
        }
        i += 1
    }
    ""
}

fn two(n: int) -> str {
    if n < 10 then "0{n}" else "{n}"
}

/// (year, month 1-12, day) of `days` since 1970-01-01, the civil calendar.
fn ymd(days: int) -> (int, int, int) {
    let z = days + 719468
    let era = (if z >= 0 then z else z - 146096) / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 then mp + 3 else mp - 9
    (if m <= 2 then y + 1 else y, m, d)
}

fn day_text(d: int) -> str {
    if d < 10 then " {d}" else "{d}"
}

/// A time as util-linux's last prints it: `short` is `Sun Nov 15 19:49`, `full`
/// `Sun Nov 15 19:49:49 2026`, `iso` `2026-11-15T19:49:49+00:00`.
fn when(secs: int, fmt: int) -> str {
    let days = (if secs >= 0 then secs else secs - 86399) / 86400
    let rem = secs - days * 86400
    let (y, m, d) = ymd(days)
    let wd = word(WEEKDAYS, ((days % 7) + 7) % 7)
    let hm = "{two(rem / 3600)}:{two(rem / 60 % 60)}"
    if fmt == 3 {
        return "{y}-{two(m)}-{two(d)}T{hm}:{two(rem % 60)}+00:00"
    }
    if fmt == 2 {
        return "{wd} {word(MONTHS, m - 1)} {day_text(d)} {hm}:{two(rem % 60)} {y}"
    }
    "{wd} {word(MONTHS, m - 1)} {day_text(d)} {hm}"
}

/// The logout's time in the second column of a session's end.
fn when_out(secs: int, fmt: int) -> str {
    if fmt == 1 {
        let days = (if secs >= 0 then secs else secs - 86399) / 86400
        let rem = secs - days * 86400
        return "{two(rem / 3600)}:{two(rem / 60 % 60)}"
    }
    when(secs, fmt)
}

/// `(HH:MM)` or `(D+HH:MM)` of a session `secs` long. A negative length (a shutdown with no boot
/// after it is measured to the epoch, as util-linux measures it) keeps its sign in the days alone.
fn length(secs: int) -> str {
    let mins = secs / 60
    let days = mins / 1440
    var h = mins / 60 % 24
    var m = mins % 60
    if h < 0 {
        h = 0 - h
    }
    if m < 0 {
        m = 0 - m
    }
    if days != 0 {
        return "({days}+{two(h)}:{two(m)})"
    }
    "({two(h)}:{two(m)})"
}

fn padded(s: str, width: int) -> str {
    var out = s
    while out.len < width {
        out = out + " "
    }
    out
}

fn cut(s: str, width: int) -> str {
    if s.len > width {
        return s[0..width]
    }
    s
}

/// The dotted address of a record's ut_addr_v6 (IPv4 in the first word), or `0.0.0.0`.
fn address(u: Utmp) -> str {
    if u.addr.len < 4 {
        return "0.0.0.0"
    }
    var v6 = false
    var k = 4
    while k < u.addr.len {
        if (u.addr[k] as int) != 0 {
            v6 = true
        }
        k += 1
    }
    if v6 {
        var out = ""
        var g = 0
        while g < 8 {
            let v = (u.addr[g * 2] as int) * 256 + (u.addr[g * 2 + 1] as int)
            if g > 0 {
                out += ":"
            }
            out += hex(v)
            g += 1
        }
        return out
    }
    "{u.addr[0] as int}.{u.addr[1] as int}.{u.addr[2] as int}.{u.addr[3] as int}"
}

fn hex(v: int) -> str {
    let digits = "0123456789abcdef"
    if v == 0 {
        return "0"
    }
    var out = ""
    var x = v
    while x > 0 {
        out = digits[x % 16..x % 16 + 1] + out
        x = x / 16
    }
    out
}

fn base_name(path: str) -> str {
    let cut_at = path.rfind("/") else -1
    if cut_at < 0 {
        return path
    }
    path[cut_at + 1..]
}

fn why(path: str) -> str {
    if !fs_exists(path) {
        return "No such file or directory"
    }
    "Permission denied"
}

fn usage(prog: str) -> int {
    eprint("{prog}: bad usage")
    eprint("Try '{prog} --help' for more information.")
    1
}

fn main() -> int {
    let args = env_args()
    var o = Opts {
        file: "",
        limit: -1,
        hostlast: false,
        full: false,
        ip: false,
        nohost: false,
        wide: false,
        system: false,
        ended: false,
        timefmt: 1,
        names: List[str](),
        btmp: false,
    }
    let me = argv0()
    o.btmp = me == "lastb"
    let name = if o.btmp then "lastb" else "last"
    var i = 0
    while i < args.len {
        let a = args[i]
        if a == "-f" || a == "--file" {
            if i + 1 >= args.len {
                eprint("{name}: option requires an argument -- 'f'")
                eprint("Try '{name} --help' for more information.")
                return 1
            }
            o.file = args[i + 1]
            i += 2
            continue
        }
        if a == "-n" || a == "--limit" {
            if i + 1 >= args.len {
                return usage(name)
            }
            o.limit = number(args[i + 1])
            i += 2
            continue
        }
        if a == "--time-format" && i + 1 < args.len {
            let f = args[i + 1]
            o.timefmt = if f == "notime" then 0 else if f == "short" then 1 else if f == "full" then 2 else if f == "iso" then 3 else -1
            if o.timefmt < 0 {
                eprint("{name}: unknown time format: {f}")
                return 1
            }
            i += 2
            continue
        }
        if a.starts_with("--") {
            if a == "--hostlast" {
                o.hostlast = true
            } else if a == "--fulltimes" {
                o.full = true
                o.timefmt = 2
            } else if a == "--ip" {
                o.ip = true
            } else if a == "--nohostname" {
                o.nohost = true
            } else if a == "--fullnames" {
                o.wide = true
            } else if a == "--system" {
                o.system = true
            } else if a == "--ended" {
                o.ended = true
            } else {
                eprint("{name}: {a}: not built in PAX's last (px133)")
                return 1
            }
            i += 1
            continue
        }
        if a.starts_with("-") && a.len > 1 {
            let b = a.bytes()
            if (b[1] as int) >= 48 && (b[1] as int) <= 57 {
                o.limit = number(a[1..])
                i += 1
                continue
            }
            var k = 1
            while k < b.len {
                let c = b[k] as int
                if c == 97 {
                    o.hostlast = true
                } else if c == 70 {
                    o.full = true
                    o.timefmt = 2
                } else if c == 105 {
                    o.ip = true
                } else if c == 82 {
                    o.nohost = true
                } else if c == 119 {
                    o.wide = true
                } else if c == 120 {
                    o.system = true
                } else if c == 101 {
                    o.ended = true
                } else {
                    eprint("{name}: -{a[k..k + 1]}: not built in PAX's last (px133)")
                    return 1
                }
                k += 1
            }
            i += 1
            continue
        }
        (mut o.names).push(a)
        i += 1
    }
    if o.file.len == 0 {
        o.file = if o.btmp then BTMP_PATH else WTMP_PATH
    }
    let fd = fs_open(o.file) else |_| {
        eprint("{name}: cannot open {o.file}: {why(o.file)}")
        return 1
    }
    fs_close(fd) else |_| {
    }
    show(o)
}

/// The name this program was run as: argv[0]'s last part (`lastb` reads btmp).
fn argv0() -> str {
    let t = fs_read_bytes("/proc/self/cmdline") else |_| {
        return "last"
    }
    var end = 0
    while end < t.len && (t[end] as int) != 0 {
        end += 1
    }
    base_name(str_from_utf8(t[0..end]) else "last")
}

fn number(s: str) -> int {
    var n = 0
    for b in s.bytes() {
        let c = b as int
        if c < 48 || c > 57 {
            return -1
        }
        n = n * 10 + c - 48
    }
    n
}

fn wanted(o: Opts, u: Utmp) -> bool {
    if o.names.len == 0 {
        return true
    }
    for n in o.names {
        if n == u.user || n == u.line || (n.starts_with("tty") && n[3..] == u.line) {
            return true
        }
    }
    false
}

/// Whether `pid` lives and started no later than `since` (seconds since 1970): its start from
/// /proc/PID/stat's starttime and /proc/stat's btime where the host has both (Linux); on a host with
/// no btime (PAX), its being there.
fn process_lives(pid: int, since: int) -> bool {
    if pid <= 0 || !fs_exists("/proc/{pid}") {
        return false
    }
    let stat = fs_read_text("/proc/stat") else ""
    var btime = -1
    for l in stat.split("\n") {
        if l.starts_with("btime ") {
            btime = number(l[6..])
        }
    }
    if btime < 0 {
        return true
    }
    let ps = fs_read_text("/proc/{pid}/stat") else ""
    let close = ps.rfind(")") else -1
    if close < 0 {
        return true
    }
    var k = 0
    var ticks = -1
    for w in ps[close + 1..].words() {
        // the fields after the name: state is the 3rd of stat(5), starttime the 22nd
        if k == 19 {
            ticks = number(w)
        }
        k += 1
    }
    if ticks < 0 {
        return true
    }
    btime + ticks / 100 <= since
}

/// The width of a logout's time in the end column: `HH:MM`, or a whole time with `-F`.
fn out_width(o: Opts) -> int {
    if o.timefmt == 3 {
        return 25
    }
    if o.timefmt == 2 {
        return 24
    }
    5
}

/// `text` right-aligned in `width` (none cut).
fn right(text: str, width: int) -> str {
    var out = text
    while out.len < width {
        out = " " + out
    }
    out
}

/// A session's end column: ` - TIME  (LEN)`, ` - down   (LEN)`, ` - crash  (LEN)`.
fn ended_at(o: Opts, word: str, secs: int, len_secs: int) -> str {
    let w = if word.len > 0 then padded(word, out_width(o)) else when_out(secs, o.timefmt)
    " - {w} {right(length(len_secs), 8)}"
}

/// One line: the user, the terminal, the host (unless -R or -a), the start and `tail`, the end
/// column; with -a the host after it, the two padded to util-linux's width.
fn line(o: Opts, user: str, tty: str, host: str, start: int, tail: str, how: str) -> str {
    let u = padded(if o.wide then user else cut(user, 8), 8)
    let t = padded(cut(tty, 12), 12)
    var out = "{u} {t} "
    if !o.nohost && !o.hostlast {
        out += padded(if o.wide then host else cut(host, 16), 16) + " "
    }
    let body = if o.timefmt == 0 then tail else when(start, o.timefmt) + tail
    if o.hostlast && !o.nohost && host.len > 0 {
        out += padded(body, if o.timefmt == 2 then 61 else if o.timefmt == 3 then 63 else 37) + " " + host
    } else {
        out += body
    }
    if o.ended && how.len > 0 {
        out += "  [" + how + "]"
    }
    out
}

/// The end column of a session with no logout: `still logged in` while its process lives and
/// started no later than the record (a pid used again is not the session's), else `gone - no
/// logout`.
fn open_end(o: Opts, u: Utmp) -> (str, str) {
    if process_lives(u.pid, u.secs) {
        return ("   still logged in", "still logged in")
    }
    (if o.timefmt == 1 then "    gone - no logout" else "   gone - no logout", "gone")
}

fn show(o: Opts) -> int {
    let recs = ut_read(o.file)
    var out = List[str]()
    // Going back in time: each terminal's logout seen so far (its time and how it ended), and the
    // first boot and the first shutdown after the records still to come.
    var lines = List[str]()
    var outs = List[int]()
    var hows = List[str]()
    var boot_after = -1
    var down_after = -1
    var shown = 0
    var k = recs.len - 1
    while k >= 0 {
        let u = recs[k]
        k -= 1
        if o.limit >= 0 && shown >= o.limit {
            break
        }
        let is_boot = !o.btmp && (u.kind == UT_BOOT_TIME || (u.line == "~" && u.user == "reboot"))
        let is_down = !o.btmp && !is_boot && u.line == "~" && u.user == "shutdown"
        if is_boot || is_down {
            let host = if o.ip then address(u) else u.host
            if is_boot && wanted_system(o, "reboot") {
                var tail = "   still running"
                if down_after >= 0 && (boot_after < 0 || down_after <= boot_after) {
                    tail = ended_at(o, "", down_after, down_after - u.secs)
                }
                (mut out).push(line(o, "reboot", "system boot", host, u.secs, tail, ""))
                shown += 1
            } else if is_down && o.system && wanted_system(o, "shutdown") {
                let next = if boot_after >= 0 then boot_after else 0
                (mut out).push(line(o, "shutdown", "system down", host, u.secs, ended_at(o, "", next, next - u.secs), ""))
                shown += 1
            }
            if is_boot {
                boot_after = u.secs
                down_after = -1
            } else {
                down_after = u.secs
            }
            lines = List[str]()
            outs = List[int]()
            hows = List[str]()
            continue
        }
        if !o.btmp && (u.kind == UT_DEAD_PROCESS || (u.kind == UT_USER_PROCESS && u.user.len == 0)) {
            set_out(mut lines, mut outs, mut hows, u.line, u.secs, how_of(u))
            continue
        }
        if u.kind != UT_USER_PROCESS && !(o.btmp && u.kind == UT_LOGIN_PROCESS) {
            continue
        }
        if !wanted(o, u) {
            continue
        }
        let host = if o.ip then address(u) else u.host
        var tail = ""
        var how = ""
        let at = find(lines, u.line)
        if o.btmp {
            tail = ended_at(o, "", u.secs, 0)
        } else if at >= 0 {
            tail = ended_at(o, "", outs[at], outs[at] - u.secs)
            how = hows[at]
        } else if down_after >= 0 && (boot_after < 0 || down_after <= boot_after) {
            tail = ended_at(o, "down", 0, down_after - u.secs)
            how = "down"
        } else if boot_after >= 0 {
            tail = ended_at(o, "crash", 0, boot_after - u.secs)
            how = "crash"
        } else {
            let (t, h) = open_end(o, u)
            tail = t
            how = h
        }
        (mut out).push(line(o, u.user, u.line, host, u.secs, tail, how))
        shown += 1
        if !o.btmp {
            set_out(mut lines, mut outs, mut hows, u.line, u.secs, "logout")
        }
    }
    for l in out {
        print(l)
    }
    let first = if recs.len > 0 then recs[0].secs else file_time(o.file)
    print("")
    print("{base_name(o.file)} begins {when(first, if o.timefmt == 3 then 3 else 2)}")
    0
}

fn wanted_system(o: Opts, user: str) -> bool {
    if o.names.len == 0 {
        return true
    }
    for n in o.names {
        if n == user {
            return true
        }
    }
    false
}

fn file_time(path: str) -> int {
    let ms = fs_modified_ms(path) else 0
    ms / 1000
}

fn find(lines: List[str], l: str) -> int {
    var i = 0
    while i < lines.len {
        if lines[i] == l {
            return i
        }
        i += 1
    }
    -1
}

fn set_out(mut lines: List[str], mut outs: List[int], mut hows: List[str], l: str, t: int, how: str) {
    let at = find(lines, l)
    if at >= 0 {
        outs[at] = t
        hows[at] = how
        return
    }
    (mut lines).push(l)
    (mut outs).push(t)
    (mut hows).push(how)
}

/// How a session ended, from its end record's ut_exit (the signal, the status).
fn how_of(u: Utmp) -> str {
    if u.term == 1 {
        return "dropped"
    }
    if u.term > 0 {
        return "signal {u.term}"
    }
    "logout"
}
