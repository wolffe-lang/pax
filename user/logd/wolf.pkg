// logd (px133): the kernel's log on disk, /dev/kmsg to /var/log/kern.log, and the caps of
// /var/log. Builtins only, no wolf-std: `env` (its arguments), `exec` (its pid), `fs` (the
// files), `ffi` and `unsafe` (raw.S's calls); user/auth/utmp.lu beside it for the shutdown
// record (tools/mklogd copies it in).
pkg {
    name: "pax/logd"
    version: "0.1.0"
    capabilities: [env, exec, ffi, fs, unsafe]
    asm: ["raw.S"]
}
