# /etc/burrowd/burrowd_config — burrowd, PAX's ssh server (px112), as PAX
# ships it: a subset of sshd_config(5), the first value of a keyword wins.
# burrowd's defaults stand for everything not named here (burrow's README):
# Port 22, LoginGraceTime 120, MaxAuthTries 6, MaxStartups 10:30:100,
# StrictModes yes, AuthorizedKeysFile .ssh/authorized_keys, root refused.
#
# Where it listens (R-px112-9): this machine alone on the live stick; an
# install writes `ListenAddress 0.0.0.0` here instead, so another machine on
# the LAN reaches the installed system. Nothing outside the LAN reaches it
# unless a router forwards port 22 to it. No account can log in until its
# owner sets a password (passwd) or lists a key in ~/.ssh/authorized_keys;
# root never can. One line, so a change is one line.
ListenAddress 127.0.0.1
# A password from /etc/shadow (passwd sets one), beside keys.
PasswordAuthentication yes
# git's protocol version over ssh.
AcceptEnv GIT_PROTOCOL
# The listener's pid, for `kill $(cat /var/run/burrowd.pid)`: the boot's
# loop starts it again a second later (/etc/pax-boot.d/burrowd).
PidFile /var/run/burrowd.pid
# px116 (pax#334): no SetEnv line here. tools/system-env appends the image's
# one when the image is built, written from the variables its /etc/shrc
# exports for the console, so a command over ssh has them too.
