# /etc/burrowd/burrowd_config — burrowd, PAX's ssh server (px112), as PAX
# ships it: a subset of sshd_config(5), the first value of a keyword wins.
# burrowd's defaults stand for everything not named here (burrow's README):
# Port 22, LoginGraceTime 120, MaxAuthTries 6, MaxStartups 10:30:100,
# StrictModes yes, AuthorizedKeysFile .ssh/authorized_keys, root refused.
#
# Every address of this machine, so another machine on the LAN reaches it
# (R-px112-9). Nothing on the network reaches it from outside the LAN unless
# a router forwards port 22 to it. No account can log in until it has a
# password (passwd) or a key in ~/.ssh/authorized_keys; root never can.
# To serve this machine alone, say `ListenAddress 127.0.0.1` instead.
ListenAddress 0.0.0.0
# A password from /etc/shadow (passwd sets one), beside keys.
PasswordAuthentication yes
# git's protocol version over ssh.
AcceptEnv GIT_PROTOCOL
# The listener's pid, for `kill $(cat /var/run/burrowd.pid)`: the boot's
# loop starts it again a second later (/etc/pax-boot.d/burrowd).
PidFile /var/run/burrowd.pid
