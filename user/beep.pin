# The source package tools/mkbeep builds (px21a), BY DIGEST: Ubuntu
# 24.04's beep 1.4.9-1.1ubuntu2, its two files, the upstream tarball and
# Ubuntu's debian/ tarball. tools/fetch-pinned fetches them (px118): each
# file from its sources in order, refused on a sha256 mismatch, and kept
# in $PAX_CACHE/pinned, read again on every use. The sources: Ubuntu's
# archive pool, Launchpad's archive of the package (the one source before
# px118), and for the upstream tarball Debian's pool, which holds the
# same file (the same digest, 2026-11-11).
BEEP_VERSION=1.4.9-1.1ubuntu2
BEEP_SOURCES="orig debian"
BEEP_orig_FILE=beep_1.4.9.orig.tar.gz
BEEP_orig_SHA256=3b6b03c29a8a9a9f84ace8aa68cd703d8e8a322cd27b04c0dfa62b9f32aba258
BEEP_orig_URLS="http://192.0.2.1/beep_1.4.9.orig.tar.gz"
BEEP_debian_FILE=beep_1.4.9-1.1ubuntu2.debian.tar.xz
BEEP_debian_SHA256=6fe840cbe980417c7ae0b0f710ffcd467b735fbef1bab7eb7d96b4dfa4317172
BEEP_debian_URLS="https://archive.ubuntu.com/ubuntu/pool/universe/b/beep/beep_1.4.9-1.1ubuntu2.debian.tar.xz https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/beep/1.4.9-1.1ubuntu2/beep_1.4.9-1.1ubuntu2.debian.tar.xz"
