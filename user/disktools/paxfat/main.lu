//! FAT32 from Microsoft FAT Specification, 30 August 2005, §§3-7.
//! 512-byte sectors/clusters, two mirrored FATs, no deletion/overwrite.
//! paxfat [--offset BYTES] [--seed TEXT] mkfs IMAGE SIZE [LABEL]
//! paxfat [--offset BYTES] mkdir IMAGE /PATH
//! paxfat [--offset BYTES] copy IMAGE SOURCE /PATH
//! paxfat [--offset BYTES] ls IMAGE [/PATH]
//! paxfat [--offset BYTES] cat IMAGE /PATH

use diskio
use std.x.crypto.sha2

struct Volume {
    fd: int,
    base: int,
    sectors: int,
    fats: int,
    clusters: int,
    fat: List[byte],
    next: int,
}

struct Entry { name: str, alias: List[byte], cluster: int, size: int, attr: int }

struct Alias { bytes: List[byte], flags: int, long_name: bool }

fn timestamp() -> List[int] ! {invalid} {
    let s = env_get("SOURCE_DATE_EPOCH") else |_| "315532800"
    let t = s.to_int() else |_| { return invalid }
    if t < 315532800 || t > 4354819199 { return invalid }
    var days = t / 86400
    var year = 1970
    loop {
        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
        let n = if leap then 366 else 365
        if days < n { break }
        days -= n
        year += 1
    }
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
    let months = [31, if leap then 29 else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    var month = 0
    while days >= months[month] { days -= months[month]; month += 1 }
    let date = (year - 1980) * 512 + (month + 1) * 32 + days + 1
    let time = t % 86400 / 3600 * 2048 + t % 3600 / 60 * 32 + t % 60 / 2
    [date, time]
}

fn stamp(mut e: List[byte]) -> () ! {invalid} {
    let t = timestamp()?
    diskio.put(mut e, 14, t[1], 2)
    diskio.put(mut e, 16, t[0], 2)
    diskio.put(mut e, 18, t[0], 2)
    diskio.put(mut e, 22, t[1], 2)
    diskio.put(mut e, 24, t[0], 2)
}

fn short_entry(alias: List[byte], flags: int, attr: int, cluster: int, size: int) -> List[byte] ! {
    invalid,
} {
    var e = diskio.zeros(32)
    diskio.paste(mut e, 0, alias)
    e[11] = attr as byte
    e[12] = flags as byte
    diskio.put(mut e, 20, cluster >> 16, 2)
    diskio.put(mut e, 26, cluster & 65535, 2)
    diskio.put(mut e, 28, size, 4)
    stamp(mut e)?
    e
}

fn info(free: int, next: int) -> List[byte] {
    var b = diskio.zeros(512)
    diskio.put(mut b, 0, 1096897106, 4)
    diskio.put(mut b, 484, 1631679090, 4)
    diskio.put(mut b, 488, free, 4)
    diskio.put(mut b, 492, next, 4)
    diskio.put(mut b, 508, 2857697280, 4)
    b
}

fn format(path: str, base: int, size: int, label: str, seed: str) -> () ! {invalid, io} {
    if base < 0 ||
        base % 512 != 0 ||
        base / 512 > 4294967295 ||
        size % 512 != 0 ||
        size < 33 * 1048576 ||
        size > 2147483648 ||
        base > 9223372036854775807 - size {
        return invalid
    }
    if label.len < 1 || label.len > 11 { return invalid }
    for b in label.bytes() {
        if b < 32 as byte ||
            b >= 127 as byte ||
            "\"*+,./:;<=>?[\\]|".contains("{b as int as char}") {
            return invalid
        }
    }
    let lab = label.upper() + " ".repeat(11 - label.len)
    let sectors = size / 512
    let fats = (sectors - 30 + 129) / 130
    let clusters = sectors - 32 - 2 * fats
    if clusters < 65525 { return invalid }
    let et = env_get("SOURCE_DATE_EPOCH") else |_| "315532800"
    let hash = sha2.sum256("pax-esp:{seed}:{et}".bytes())
    var boot = diskio.zeros(512)
    boot[0] = 235 as byte
    boot[1] = 88 as byte
    boot[2] = 144 as byte
    diskio.paste(mut boot, 3, "PAX FAT ".bytes())
    diskio.put(mut boot, 11, 512, 2)
    boot[13] = 1 as byte
    diskio.put(mut boot, 14, 32, 2)
    boot[16] = 2 as byte
    boot[21] = 248 as byte
    diskio.put(mut boot, 24, 32, 2)
    diskio.put(mut boot, 26, 8, 2)
    diskio.put(mut boot, 28, base / 512, 4)
    diskio.put(mut boot, 32, sectors, 4)
    diskio.put(mut boot, 36, fats, 4)
    diskio.put(mut boot, 44, 2, 4)
    diskio.put(mut boot, 48, 1, 2)
    diskio.put(mut boot, 50, 6, 2)
    boot[64] = 128 as byte
    boot[66] = 41 as byte
    for i in 0..4 { boot[67 + i] = hash[3 - i] }
    diskio.paste(mut boot, 71, lab.bytes())
    diskio.paste(mut boot, 82, "FAT32   ".bytes())
    boot[510] = 85 as byte
    boot[511] = 170 as byte
    var fat = diskio.zeros(fats * 512)
    diskio.put(mut fat, 0, 268435448, 4)
    diskio.put(mut fat, 4, 268435455, 4)
    diskio.put(mut fat, 8, 268435455, 4)
    var root = diskio.zeros(512)
    diskio.paste(mut root, 0, short_entry(lab.bytes(), 0, 8, 0, 0)?)
    let fd = fs_open_mode(path, 3) else |_| { return io }
    defer fs_close(fd) else |_| {}
    let have = fs_seek(fd, 0, 2) else |_| { return io }
    if have < base + size {
        let st = fs_fstat_record(fd) else |_| { return io }
        if st[0] != 0 || base != 0 { return invalid }
        fs_truncate(fd, size) else |_| { return io }
    }
    diskio.write_at(fd, base, diskio.zeros(32 * 512))?
    diskio.write_at(fd, base, boot)?
    diskio.write_at(fd, base + 6 * 512, boot)?
    diskio.write_at(fd, base + 512, info(clusters - 1, 3))?
    diskio.write_at(fd, base + 7 * 512, info(clusters - 1, 3))?
    diskio.write_at(fd, base + 32 * 512, fat)?
    diskio.write_at(fd, base + (32 + fats) * 512, fat)?
    diskio.write_at(fd, base + (32 + 2 * fats) * 512, root)?
    fs_sync(fd)?
}

fn open_volume(path: str, base: int, write: bool) -> Volume ! {invalid, io} {
    if base < 0 || base % 512 != 0 { return invalid }
    let fd = if write {
        // Non-formatting commands require an existing volume. Mode 3 alone
        // would create an empty file after a misspelled image pathname.
        let existing = fs_open(path) else |_| { return io }
        fs_close(existing) else |_| { return io }
        fs_open_mode(path, 3) else |_| { return io }
    } else {
        fs_open(path) else |_| { return io }
    }
    errdefer fs_close(fd) else |_| {}
    let b = diskio.exact(fd, base, 512)?
    if diskio.le(b, 11, 2)? != 512 ||
        b[13] != 1 as byte ||
        diskio.le(b, 14, 2)? != 32 ||
        b[16] != 2 as byte ||
        diskio.le(b, 17, 2)? != 0 ||
        diskio.le(b, 22, 2)? != 0 ||
        diskio.le(b, 40, 4)? != 0 ||
        diskio.le(b, 44, 4)? != 2 ||
        diskio.le(b, 48, 2)? != 1 ||
        diskio.le(b, 50, 2)? != 6 ||
        diskio.le(b, 510, 2)? != 43605 {
        return invalid
    }
    let sectors = diskio.le(b, 32, 4)?
    let fats = diskio.le(b, 36, 4)?
    if sectors < 67584 || sectors > 4194304 || fats < 1 || fats > sectors / 2 { return invalid }
    let clusters = sectors - 32 - 2 * fats
    if clusters < 65525 || (clusters + 2) * 4 > fats * 512 { return invalid }
    let end = fs_seek(fd, 0, 2) else |_| { return io }
    if base > end || sectors > (end - base) / 512 { return invalid }
    let f = diskio.exact(fd, base + 32 * 512, fats * 512)?
    let other = diskio.exact(fd, base + (32 + fats) * 512, fats * 512)?
    if !diskio.equal(f, other) { return invalid }
    Volume { fd: fd, base: base, sectors: sectors, fats: fats, clusters: clusters, fat: f, next: 3 }
}

fn offset(v: Volume, cluster: int) -> int ! {invalid} {
    if cluster < 2 || cluster >= v.clusters + 2 { return invalid }
    v.base + (32 + 2 * v.fats + cluster - 2) * 512
}

fn chain(v: Volume, first: int) -> List[int] ! {invalid} {
    var out = List[int]()
    var seen = Map[int, bool]()
    var c = first
    while c < 268435448 {
        if c < 2 || c >= v.clusters + 2 || (seen[c] else false) { return invalid }
        seen[c] = true
        (mut out).push(c)
        c = diskio.le(v.fat, c * 4, 4)? & 268435455
    }
    out
}

fn directory(v: Volume, first: int) -> List[byte] ! {invalid, io} {
    let cs = chain(v, first)?
    if cs.len > 2048 { return invalid }
    var out = List[byte]()
    for c in cs {
        region chunk {
            let b = diskio.exact(v.fd, offset(v, c)?, 512)?
            for x in b { (mut out).push(x) }
        }
    }
    out
}

fn checksum(alias: List[byte]) -> int {
    var s = 0
    for b in alias { s = (s & 1) * 128 + (s >> 1) + b as int & 255 }
    s
}

fn oem_text(bytes: List[byte]) -> str {
    let high = "ÇüéâäàåçêëèïîìÄÅÉæÆôöòûùÿÖÜø£Ø×ƒáíóúñÑªº¿®¬½¼¡«»░▒▓│┤ÁÂÀ©╣║╗╝¢¥┐└┴┬├─┼ãÃ╚╔╩╦╠═╬¤ðÐÊËÈıÍÎÏ┘┌█▄¦Ì▀ÓßÔÒõÕµþÞÚÛÙýÝ¯´­±‗¾¶§÷¸°¨·¹³²■ ".
        chars()
    var text = ""
    for b in bytes {
        let n = b as int
        text += if n < 128 then n as char else high[n - 128]
    }
    text
}

fn oem_byte(c: char) -> int {
    let n = c as int
    if n < 128 { return n }
    let high = "ÇüéâäàåçêëèïîìÄÅÉæÆôöòûùÿÖÜø£Ø×ƒáíóúñÑªº¿®¬½¼¡«»░▒▓│┤ÁÂÀ©╣║╗╝¢¥┐└┴┬├─┼ãÃ╚╔╩╦╠═╬¤ðÐÊËÈıÍÎÏ┘┌█▄¦Ì▀ÓßÔÒõÕµþÞÚÛÙýÝ¯´­±‗¾¶§÷¸°¨·¹³²■ ".
        chars()
    for i in 0..128 { if high[i] == c { return i + 128 } }
    -1
}

fn short_name(e: List[byte]) -> str {
    let a = oem_text(e[0..8]).trim()
    let b = oem_text(e[8..11]).trim()
    let base = if e[12] as int & 8 != 0 then a.lower() else a
    let ext = if e[12] as int & 16 != 0 then b.lower() else b
    if ext.len == 0 then base else "{base}.{ext}"
}

fn entries(data: List[byte]) -> List[Entry] ! {invalid} {
    var out = List[Entry]()
    var units = List[byte]()
    var expected = 0
    var sum = 0
    let pos = [1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30]
    for slot in 0..data.len / 32 {
        let at = slot * 32
        let e = data[at..at + 32]
        if e[0] == 0 as byte { break }
        if e[0] == 229 as byte {
            expected = 0
            units = List[byte]()
            continue
        }
        let attr = e[11] as int
        if attr == 15 {
            let ord = e[0] as int
            if ord & 160 != 0 { return invalid }
            if ord & 64 != 0 {
                if units.len != 0 { return invalid }
                expected = ord & 31
                if expected < 1 || expected > 20 { return invalid }
                units = diskio.zeros(expected * 26)
                sum = e[13] as int
            }
            if expected == 0 ||
                ord & 31 != expected ||
                e[13] as int != sum ||
                e[12] != 0 as byte ||
                diskio.le(e, 26, 2)? != 0 {
                return invalid
            }
            for j in 0..13 {
                units[(expected - 1) * 26 + j * 2] = e[pos[j]]
                units[(expected - 1) * 26 + j * 2 + 1] = e[pos[j] + 1]
            }
            expected -= 1
            continue
        }
        if expected != 0 { return invalid }
        if attr & 8 != 0 { units = List[byte](); continue }
        let alias = e[0..11]
        var name = short_name(e)
        if units.len > 0 {
            if checksum(alias) != sum { return invalid }
            name = diskio.from16(units)?
        }
        units = List[byte]()
        (mut out).push(Entry {
            name: name,
            alias: alias,
            cluster: diskio.le(e, 26, 2)? + diskio.le(e, 20, 2)? * 65536,
            size: diskio.le(e, 28, 4)?,
            attr: attr,
        })
    }
    if expected != 0 || units.len != 0 { return invalid }
    out
}

fn components(path: str) -> List[str] ! {invalid} {
    var out = List[str]()
    for p in path.split("/") {
        if p.len == 0 { continue }
        if p == "." || p == ".." || p.ends_with(".") || p.ends_with(" ") { return invalid }
        for c in p.chars() { if c as int < 32 || "\"*:<>?\\|".contains("{c}") { return invalid } }
        let units = diskio.utf16(p, 255)?
        if units.len != 510 { return invalid }
        (mut out).push(p)
    }
    out
}

fn lookup(v: Volume, path: List[str]) -> Entry ! {invalid, io, not_found} {
    var current = Entry { name: "/", alias: List[byte](), cluster: 2, size: 0, attr: 16 }
    for name in path {
        if current.attr & 16 == 0 { return invalid }
        let es = entries(directory(v, current.cluster)?)?
        var found = false
        for e in es {
            let abase = oem_text(e.alias[0..8]).trim()
            let aext = oem_text(e.alias[8..11]).trim()
            let aname = if aext.len == 0 then abase else "{abase}.{aext}"
            if e.name.lower() == name.lower() || aname.lower() == name.lower() {
                current = copy e
                found = true
                break
            }
        }
        if !found { return not_found }
    }
    current
}

fn alias_of(name: str, es: List[Entry]) -> Alias ! {invalid, exists} {
    for e in es {
        let b = oem_text(e.alias[0..8]).trim()
        let x = oem_text(e.alias[8..11]).trim()
        let short = if x.len == 0 then b else "{b}.{x}"
        if e.name.lower() == name.lower() || short.lower() == name.lower() { return exists }
    }
    let dot = name.rfind(".") else -1
    let base = if dot > 0 then name[0..dot] else name
    let ext = if dot > 0 then name[dot + 1..] else ""
    var cleanbase = List[byte](), cleanext = List[byte]()
    var lossy = false
    var numbered = false
    for pass in 0..2 {
        let src = if pass == 0 then base else ext
        var clean = List[byte]()
        for c in src.upper().chars() {
            let n = c as int
            if c == ' ' || c == '.' {
                lossy = true
                numbered = true
                continue
            }
            let oem = oem_byte(c)
            if n >= 65 && n <= 90 ||
                n >= 48 && n <= 57 ||
                "$%'-_@~`!(){{}}^#&".contains("{c}") ||
                oem >= 128 {
                (mut clean).push(oem as byte)
            } else {
                (mut clean).push(95 as byte)
                lossy = true
                if n < 128 || n > 65535 { numbered = true }
            }
        }
        if pass == 0 { cleanbase = clean } else { cleanext = clean }
    }
    if cleanbase.len == 0 {
        (mut cleanbase).push(95 as byte)
        lossy = true
        numbered = true
    }
    numbered = numbered || cleanbase.len > 8 || cleanext.len > 3
    let mixedbase = base != base.upper() && base != base.lower()
    let mixedext = ext != ext.upper() && ext != ext.lower()
    var flags = 0
    if !numbered && !lossy {
        if base != base.upper() && !mixedbase { flags += 8 }
        if ext != ext.upper() && !mixedext { flags += 16 }
    }
    let extlen = if cleanext.len > 3 then 3 else cleanext.len
    var n = 0
    loop {
        var b = List[byte]()
        if numbered {
            n += 1
            if n > 999999 { return invalid }
            let suffix = "~{n}"
            let keep = 8 - suffix.len
            let k = if cleanbase.len < keep then cleanbase.len else keep
            for j in 0..k { (mut b).push(cleanbase[j]) }
            for x in suffix.bytes() { (mut b).push(x) }
        } else {
            b = copy cleanbase
        }
        while b.len < 8 { (mut b).push(32 as byte) }
        for j in 0..extlen { (mut b).push(cleanext[j]) }
        while b.len < 11 { (mut b).push(32 as byte) }
        var used = false
        for old in es { if diskio.equal(old.alias, b) { used = true } }
        if !used {
            return Alias {
                bytes: b,
                flags: if numbered || mixedbase || mixedext || lossy then 0 else flags,
                long_name: numbered || mixedbase || mixedext || lossy,
            }
        }
        numbered = true
    }
}

fn allocate(mut v: Volume, n: int) -> List[int] ! {full, invalid} {
    var out = List[int]()
    var c = v.next
    while c < v.clusters + 2 && out.len < n {
        if diskio.le(v.fat, c * 4, 4)? & 268435455 == 0 { (mut out).push(c) }
        c += 1
    }
    if out.len != n { return full }
    for i in 0..n {
        diskio.put(mut v.fat, out[i] * 4, if i + 1 == n then 268435455 else out[i + 1], 4)
    }
    v.next = c
    out
}

fn save(v: Volume) -> () ! {invalid, io} {
    var free = 0
    var next: int = 4294967295
    for c in 2..v.clusters + 2 {
        if diskio.le(v.fat, c * 4, 4)? & 268435455 == 0 {
            free += 1
            if next == 4294967295 { next = c }
        }
    }
    diskio.write_at(v.fd, v.base + 32 * 512, v.fat)?
    diskio.write_at(v.fd, v.base + (32 + v.fats) * 512, v.fat)?
    diskio.write_at(v.fd, v.base + 512, info(free, next))?
    diskio.write_at(v.fd, v.base + 7 * 512, info(free, next))?
    fs_sync(v.fd)?
}

fn add(mut v: Volume, path: str, source: str, dir: bool) -> () ! {
    invalid,
    io,
    full,
    exists,
    not_found,
} {
    let paths = components(path)?
    if paths.len == 0 { return exists }
    let parent = lookup(v, paths[0..paths.len - 1])?
    if parent.attr & 16 == 0 { return invalid }
    var bytes = directory(v, parent.cluster)?
    let es = entries(bytes)?
    let name = paths[paths.len - 1]
    let alias = alias_of(name, es)?
    var size: int = 0
    var input = -1
    defer { if input >= 0 { fs_close(input) else |_| {} } }
    if !dir {
        input = fs_open_mode(source, 5) else |_| { return io }
        let src = fs_fstat_record(input) else |_| { return io }
        let dst = fs_fstat_record(v.fd) else |_| { return io }
        if src[0] != 0 || src[9] == dst[9] && src[10] == dst[10] { return invalid }
        size = src[1]
        if size < 0 || size > 4294967295 { return invalid }
    }
    let n = if dir then 1 else (size + 511) / 512
    let data = allocate(mut v, n)?
    let first = if data.len == 0 then 0 else data[0]
    let short = short_entry(alias.bytes, alias.flags, if dir then 16 else 32, first, size)?
    var records = List[byte]()
    if alias.long_name {
        // Trim the padded UTF-16 buffer to the name's actual code units.
        let encoded = diskio.utf16(name, 255)?
        var count = 0
        while count < 255 && diskio.le(encoded, count * 2, 2)? != 0 { count += 1 }
        let total = (count + 12) / 13
        let positions = [1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30]
        var seq = total
        while seq > 0 {
            var e = diskio.zeros(32)
            e[0] = (seq + if seq == total then 64 else 0) as byte
            e[11] = 15 as byte
            e[13] = checksum(alias.bytes) as byte
            for j in 0..13 {
                let k = (seq - 1) * 13 + j
                let unit = if k < count {
                    diskio.le(encoded, k * 2, 2)?
                } else if k == count {
                    0
                } else {
                    65535
                }
                diskio.put(mut e, positions[j], unit, 2)
            }
            for b in e { (mut records).push(b) }
            seq -= 1
        }
    }
    for b in short { (mut records).push(b) }
    var used = 0
    while used < bytes.len && bytes[used] != 0 as byte { used += 32 }
    var cs = chain(v, parent.cluster)?
    if used + records.len > bytes.len {
        let more = allocate(mut v, (used + records.len - bytes.len + 511) / 512)?
        diskio.put(mut v.fat, cs[cs.len - 1] * 4, more[0], 4)
        for c in more { (mut cs).push(c); for _ in 0..512 { (mut bytes).push(0 as byte) } }
    }
    if dir {
        var b = diskio.zeros(512)
        diskio.paste(mut b, 0, short_entry(".          ".bytes(), 0, 16, first, 0)?)
        diskio.paste(
            mut b,
            32,
            short_entry(
                "..         ".bytes(),
                0,
                16,
                if parent.cluster == 2 then 0 else parent.cluster,
                0,
            )?,
        )
        diskio.write_at(v.fd, offset(v, first)?, b)?
    } else {
        for i in 0..data.len {
            region chunk {
                var b = diskio.zeros(512)
                let amount = if size - i * 512 < 512 then size - i * 512 else 512
                diskio.paste(mut b, 0, diskio.exact(input, i * 512, amount)?)
                diskio.write_at(v.fd, offset(v, data[i])?, b)?
            }
        }
    }
    diskio.paste(mut bytes, used, records)
    save(v)?
    for i in 0..cs.len { diskio.write_at(v.fd, offset(v, cs[i])?, bytes[i * 512..(i + 1) * 512])? }
    fs_sync(v.fd)?
}

fn run(args: List[str]) -> () ! {invalid, io, full, exists, not_found} {
    var i = 0
    var base: int = 0
    var seed = "pax"
    while i < args.len && args[i].starts_with("--") {
        if i + 1 >= args.len { return invalid }
        match args[i] {
            "--offset" => { base = diskio.size(args[i + 1])? },
            "--seed" => { seed = args[i + 1] },
            _ => { return invalid },
        }
        i += 2
    }
    if i + 2 > args.len { return invalid }
    let cmd = args[i]
    let image = args[i + 1]
    i += 2
    if cmd == "mkfs" {
        if i + 1 != args.len && i + 2 != args.len { return invalid }
        return format(
            image,
            base,
            diskio.size(args[i])?,
            if i + 2 == args.len then args[i + 1] else "PAX-ESP",
            seed,
        )?
    }
    if cmd != "mkdir" && cmd != "copy" && cmd != "ls" && cmd != "cat" { return invalid }
    if (cmd == "mkdir" || cmd == "cat") && i + 1 != args.len { return invalid }
    if cmd == "copy" && i + 2 != args.len { return invalid }
    if cmd == "ls" && i != args.len && i + 1 != args.len { return invalid }
    var v = open_volume(image, base, cmd == "mkdir" || cmd == "copy")?
    defer fs_close(v.fd) else |_| {}
    if cmd == "mkdir" {
        if i + 1 != args.len { return invalid }
        return add(mut v, args[i], "", true)?
    }
    if cmd == "copy" {
        if i + 2 != args.len { return invalid }
        return add(mut v, args[i + 1], args[i], false)?
    }
    if i != args.len && i + 1 != args.len { return invalid }
    let entry = lookup(v, components(if i == args.len then "/" else args[i])?)?
    if cmd == "ls" {
        if entry.attr & 16 == 0 { return invalid }
        for e in entries(directory(v, entry.cluster)?)? {
            if e.name != "." && e.name != ".." {
                print("{if (e.attr & 16) != 0 then "d" else "f"}\t{e.size}\t{e.name}")
            }
        }
    } else {
        if entry.attr & 16 != 0 { return invalid }
        if entry.size == 0 { return }
        let cs = chain(v, entry.cluster)?
        if cs.len != (entry.size + 511) / 512 { return invalid }
        for j in 0..cs.len {
            region chunk {
                let n = if entry.size - j * 512 < 512 then entry.size - j * 512 else 512
                fs_write_chunk(1, diskio.exact(v.fd, offset(v, cs[j])?, n)?) else |_| { return io }
            }
        }
    }
}

fn main() -> int {
    run(env_args()) else |e| { eprint("paxfat: {e}"); return 1 }
    0
}
