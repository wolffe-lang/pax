//! paxext2: ext2 layout from the documented ext4 legacy-format fields.
//! paxext2 [--from DIR] [--attrs FILE] [--label LABEL] [--seed TEXT]
//!         [--inodes N] [--offset BYTES] [--exclude /DIR]... SIZE IMAGE
//! 4 KiB blocks, 256-byte inodes, sparse-super backups, no journal.

use diskio
use std.x.crypto.sha2

struct Group {
    bitmap: List[byte],
    imap: List[byte],
    bb: int,
    ib: int,
    table: int,
    free: int,
    ifree: int,
    dirs: int,
}

struct Fs { fd: int, base: int, blocks: int, ipg: int, groups: List[Group], next: int }

fn has_super(group: int) -> bool {
    if group == 0 || group == 1 { return true }
    for p in [3, 5, 7] {
        var n = group
        while n % p == 0 { n /= p }
        if n == 1 { return true }
    }
    false
}

fn mark(mut bitmap: List[byte], n: int) {
    bitmap[n / 8] = (bitmap[n / 8] as int | 1 << n % 8) as byte
}

fn used(bitmap: List[byte], n: int) -> bool { bitmap[n / 8] as int & 1 << n % 8 != 0 }

fn reserve(mut fs: Fs) -> int ! {full} {
    while fs.next < fs.blocks {
        let n = fs.next
        fs.next += 1
        let g = n / 32768
        if !used(fs.groups[g].bitmap, n % 32768) {
            mark(mut fs.groups[g].bitmap, n % 32768)
            fs.groups[g].free -= 1
            return n
        }
    }
    full
}

fn block_write(fs: Fs, n: int, bytes: List[byte]) -> () ! {io} {
    diskio.write_at(fs.fd, fs.base + n * 4096, bytes)?
}

fn zero_blocks(fs: Fs, start: int, count: int) -> () ! {io} {
    var at = 0
    while at < count {
        region chunk {
            let n = if count - at > 16 then 16 else count - at
            block_write(fs, start + at, diskio.zeros(n * 4096))?
            at += n
        }
    }
}

fn layout(fd: int, base: int, bytes: int, requested: int) -> Fs ! {invalid} {
    let blocks = bytes / 4096
    let count = (blocks + 32767) / 32768
    let want = if requested > 0 {
        requested
    } else {
        bytes / (if bytes < 536870912 then 4096 else 16384)
    }
    let ipg = ((want + count - 1) / count + 15) / 16 * 16
    if ipg < 16 || ipg > 32768 { return invalid }
    let tables = ipg / 16
    let gdt = (count * 32 + 4095) / 4096
    var groups = List[Group]()
    for g in 0..count {
        let first = g * 32768
        let n = if blocks - first < 32768 then blocks - first else 32768
        let prefix = if has_super(g) then 1 + gdt else 0
        let taken = prefix + 2 + tables
        if taken >= n { return invalid }
        var bitmap = diskio.zeros(4096)
        var imap = diskio.zeros(4096)
        for b in 0..taken { mark(mut bitmap, b) }
        for b in n..32768 { mark(mut bitmap, b) }
        for b in ipg..32768 { mark(mut imap, b) }
        if g == 0 { for b in 0..10 { mark(mut imap, b) } }
        (mut groups).push(Group {
            bitmap: bitmap,
            imap: imap,
            bb: first + prefix,
            ib: first + prefix + 1,
            table: first + prefix + 2,
            free: n - taken,
            ifree: ipg - if g == 0 then 10 else 0,
            dirs: if g == 0 then 1 else 0,
        })
    }
    Fs { fd: fd, base: base, blocks: blocks, ipg: ipg, groups: groups, next: 0 }
}

fn finish(fs: Fs, epoch: int, label: str, seed: str) -> () ! {io} {
    let count = fs.groups.len
    var gd = diskio.zeros((count * 32 + 4095) / 4096 * 4096)
    var free = 0, ifree = 0
    for g in 0..count {
        let group = copy fs.groups[g]
        diskio.put(mut gd, g * 32, group.bb, 4)
        diskio.put(mut gd, g * 32 + 4, group.ib, 4)
        diskio.put(mut gd, g * 32 + 8, group.table, 4)
        diskio.put(mut gd, g * 32 + 12, group.free, 2)
        diskio.put(mut gd, g * 32 + 14, group.ifree, 2)
        diskio.put(mut gd, g * 32 + 16, group.dirs, 2)
        free += group.free
        ifree += group.ifree
        block_write(fs, group.bb, group.bitmap)?
        block_write(fs, group.ib, group.imap)?
    }
    var sb = diskio.zeros(1024)
    diskio.put(mut sb, 0, count * fs.ipg, 4)
    diskio.put(mut sb, 4, fs.blocks, 4)
    diskio.put(mut sb, 8, fs.blocks / 20, 4)
    diskio.put(mut sb, 12, free, 4)
    diskio.put(mut sb, 16, ifree, 4)
    diskio.put(mut sb, 24, 2, 4)
    diskio.put(mut sb, 28, 2, 4)
    diskio.put(mut sb, 32, 32768, 4)
    diskio.put(mut sb, 36, 32768, 4)
    diskio.put(mut sb, 40, fs.ipg, 4)
    diskio.put(mut sb, 48, epoch, 4)
    diskio.put(mut sb, 54, 65535, 2)
    diskio.put(mut sb, 56, 61267, 2)
    diskio.put(mut sb, 58, 1, 2)
    diskio.put(mut sb, 60, 1, 2)
    diskio.put(mut sb, 64, epoch, 4)
    diskio.put(mut sb, 76, 1, 4)
    diskio.put(mut sb, 84, 11, 4)
    diskio.put(mut sb, 88, 256, 2)
    diskio.put(mut sb, 96, 2, 4) // filetype, not has_journal
    diskio.put(mut sb, 100, 3, 4) // sparse_super, large_file
    let uuid = sha2.sum256("pax-disk:{seed}:{epoch}".bytes())
    let hash = sha2.sum256("pax-hash:{seed}:{epoch}".bytes())
    diskio.paste(mut sb, 104, uuid[0..16])
    diskio.paste(mut sb, 120, label.bytes())
    diskio.paste(mut sb, 236, hash[0..16])
    sb[252] = 1 as byte
    diskio.put(mut sb, 264, epoch, 4)
    diskio.put(mut sb, 348, 32, 2)
    diskio.put(mut sb, 350, 32, 2)
    // Backups before the primary; all fields and free counts agree.
    var g = count
    while g > 0 {
        g -= 1
        if has_super(g) {
            diskio.put(mut sb, 90, g, 2)
            diskio.write_at(fs.fd, fs.base + g * 32768 * 4096 + if g == 0 then 1024 else 0, sb)?
            block_write(fs, g * 32768 + 1, gd)?
        }
    }
    fs_sync(fs.fd)?
}

fn run(args: List[str]) -> () ! {invalid, io, full} {
    var source = "", attrs_path = "", label = "pax", seed = ""
    var inodes: int = 0, base: int = 0
    var excludes = List[str]()
    var i = 0
    while i < args.len && args[i].starts_with("--") {
        if i + 1 >= args.len { return invalid }
        let value = args[i + 1]
        match args[i] {
            "--from" => { source = value },
            "--attrs" => { attrs_path = value },
            "--label" => { label = value },
            "--seed" => { seed = value },
            "--inodes" => { inodes = diskio.size(value)?; if inodes < 11 { return invalid } },
            "--offset" => { base = diskio.size(value)? },
            "--exclude" => {
                if !value.starts_with("/") { return invalid }
                (mut excludes).push(value)
            },
            _ => { return invalid },
        }
        i += 2
    }
    if i + 2 != args.len { return invalid }
    let bytes = diskio.size(args[i])?
    let path = args[i + 1]
    if label.len > 16 ||
        bytes < 8388608 ||
        bytes > 4294967296 ||
        bytes % 4096 != 0 ||
        base % 512 != 0 ||
        base > 9223372036854775807 - bytes {
        return invalid
    }
    if seed.len == 0 { seed = label }
    let et = env_get("SOURCE_DATE_EPOCH") else |_| "0"
    let epoch = et.to_int() else |_| { return invalid }
    if epoch < 0 || epoch > 4294967295 { return invalid }
    let attrs = attributes(attrs_path, epoch)?
    let nodes = collect(source, attrs, excludes, epoch)?
    // Validate the geometry and inode budget before opening the destination.
    let planned = layout(-1, base, bytes, inodes)?
    for n in nodes { if n.ino > planned.groups.len * planned.ipg { return full } }
    let fd = fs_open_mode(path, 3) else |_| { return io }
    defer fs_close(fd) else |_| {}
    let dst = fs_fstat_record(fd) else |_| { return io }
    if dst[0] != 0 && dst[0] != 7 { return invalid }
    for n in nodes {
        if n.kind == 0 {
            let st = fs_stat(n.source) else |_| { return io }
            if st[9] == dst[9] && st[10] == dst[10] { return invalid }
        }
    }
    let have = fs_seek(fd, 0, 2) else |_| { return io }
    if have < base + bytes {
        if dst[0] != 0 || base != 0 { return invalid }
        fs_truncate(fd, bytes) else |_| { return io }
    }
    var fs = layout(fd, base, bytes, inodes)?
    for g in 0..fs.groups.len {
        zero_blocks(fs, fs.groups[g].table, fs.ipg / 16)?
        if has_super(g) { zero_blocks(fs, g * 32768, 1 + (fs.groups.len * 32 + 4095) / 4096)? }
    }
    for n in nodes {
        if !n.primary { continue }
        region inode {
            write_node(mut fs, n, nodes)?
        }
    }
    finish(fs, epoch, label, seed)?
}

fn main() -> int {
    run(env_args()) else |e| { eprint("paxext2: {e}"); return 1 }
    0
}
