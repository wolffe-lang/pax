//! Legacy inode block maps, packed directory blocks and streamed file data.

use diskio

fn dirent(mut b: List[byte], mut pos: int, mut previous: int, name: str, ino: int, kind: int) {
    let need = (8 + name.len + 3) / 4 * 4
    if pos + need > b.len {
        diskio.put(mut b, previous + 4, b.len - previous, 2)
        pos = b.len
        for _ in 0..4096 { (mut b).push(0 as byte) }
    }
    diskio.put(mut b, pos, ino, 4)
    diskio.put(mut b, pos + 4, need, 2)
    b[pos + 6] = name.len as byte
    b[pos + 7] = (if kind == 1 then 2 else if kind == 3 then 7 else 1) as byte
    diskio.paste(mut b, pos + 8, name.bytes())
    previous = pos
    pos += need
}

fn dir_bytes(node: Node, nodes: List[Node]) -> List[byte] {
    var b = diskio.zeros(4096)
    var pos = 0, previous = 0
    dirent(mut b, mut pos, mut previous, ".", node.ino, 1)
    dirent(mut b, mut pos, mut previous, "..", node.parent, 1)
    for n in nodes {
        if n.path == "/" || n.parent != node.ino { continue }
        let slash = n.path.rfind("/") else 0
        dirent(mut b, mut pos, mut previous, n.path[slash + 1..], n.ino, n.kind)
    }
    diskio.put(mut b, previous + 4, b.len - previous, 2)
    if node.ino == 11 {
        while b.len < 16384 {
            let at = b.len
            for _ in 0..4096 { (mut b).push(0 as byte) }
            diskio.put(mut b, at + 4, 4096, 2)
        }
    }
    b
}

fn zero(bytes: List[byte]) -> bool {
    for b in bytes { if b != 0 as byte { return false } }
    true
}

fn pointer_block(mut fs: Fs, pointers: List[int]) -> int ! {io, full} {
    var any = false
    for p in pointers { if p != 0 { any = true } }
    if !any { return 0 }
    var b = diskio.zeros(4096)
    for i in 0..pointers.len { diskio.put(mut b, i * 4, pointers[i], 4) }
    let block = reserve(mut fs)?
    block_write(fs, block, b)?
    block
}

fn block_map(mut fs: Fs, data: List[int], mut inode: List[byte]) -> int ! {io, full, invalid} {
    if data.len > 1049612 { return invalid }
    var metadata = 0
    let direct = if data.len < 12 then data.len else 12
    for i in 0..direct { diskio.put(mut inode, 40 + i * 4, data[i], 4) }
    if data.len > 12 {
        let end = if data.len < 1036 then data.len else 1036
        let block = pointer_block(mut fs, data[12..end])?
        if block != 0 { metadata += 1 }
        diskio.put(mut inode, 88, block, 4)
    }
    if data.len > 1036 {
        var roots = List[int]()
        var start = 1036
        while start < data.len {
            let end = if data.len - start < 1024 then data.len else start + 1024
            let block = pointer_block(mut fs, data[start..end])?
            if block != 0 { metadata += 1 }
            (mut roots).push(block)
            start = end
        }
        let block = pointer_block(mut fs, roots)?
        if block != 0 { metadata += 1 }
        diskio.put(mut inode, 92, block, 4)
    }
    metadata
}

/// One extent: `length` blocks from logical block `logical` at physical `start`.
struct Extent { logical: int, length: int, start: int }

/// The extent node's entries a block holds: (4096 - 12) / 12 (ifork.rst).
const LEAF_MAX: int = 340

/// The inode flag of a file mapped by an extent tree (EXTENTS_FL, 0x80000).
const EXTENTS_FL: int = 524288

/// `data`'s extents in logical order: each run of consecutive physical blocks,
/// at most 32768 long (an ee_len above 32768 names an uninitialized extent,
/// which paxext2 never writes); a 0 is a hole, a gap between extents.
fn extents_of(data: List[int]) -> List[Extent] {
    var out = List[Extent]()
    var k = 0
    while k < data.len {
        if data[k] == 0 { k += 1; continue }
        let first = k
        let start = data[k]
        k += 1
        while k < data.len && data[k] == start + (k - first) && k - first < 32768 { k += 1 }
        (mut out).push(Extent { logical: first, length: k - first, start: start })
    }
    out
}

/// An extent node's header at `at`: magic 0xF30A, entries, max, depth, generation 0.
fn ext_header(mut b: List[byte], at: int, entries: int, max: int, depth: int) {
    diskio.put(mut b, at, if depth == 2 then 4660 else 62218, 2)
    diskio.put(mut b, at + 2, entries, 2)
    diskio.put(mut b, at + 4, max, 2)
    diskio.put(mut b, at + 6, depth, 2)
}

/// A leaf entry: ee_block, ee_len, then the 48-bit start (high 16 bits first).
fn ext_leaf(mut b: List[byte], at: int, e: Extent) {
    diskio.put(mut b, at, e.logical, 4)
    diskio.put(mut b, at + 4, e.length, 2)
    diskio.put(mut b, at + 6, e.start >> 32, 2)
    diskio.put(mut b, at + 8, e.start & 4294967295, 4)
}

/// An index entry: ei_block, then the 48-bit child block (low 32 bits first).
fn ext_index(mut b: List[byte], at: int, logical: int, block: int) {
    diskio.put(mut b, at, logical, 4)
    diskio.put(mut b, at + 4, block & 4294967295, 4)
    diskio.put(mut b, at + 8, block >> 32, 2)
}

/// `data` (physical blocks in logical order, 0 a hole) as an extent tree in
/// i_block, built whole and as shallow as it can be: four extents in the inode
/// (depth 0), else leaves of 340 under the inode (depth 1), else index blocks
/// of 340 leaves under it (depth 2). Its blocks are reserved after the data.
/// Sets EXTENTS_FL; returns the tree blocks, which count in i_blocks.
fn extent_map(mut fs: Fs, data: List[int], mut inode: List[byte]) -> int ! {io, full, invalid} {
    if data.len > 4294967296 { return invalid }
    let ext = extents_of(data)
    if ext.len > 4 * LEAF_MAX * LEAF_MAX { return invalid }
    diskio.put(mut inode, 32, EXTENTS_FL, 4)
    if ext.len <= 4 {
        ext_header(mut inode, 40, ext.len, 4, 0)
        for i in 0..ext.len { ext_leaf(mut inode, 52 + i * 12, ext[i]) }
        return 0
    }
    // Each node of a level as an Extent: its first logical block and its own block.
    var level = List[Extent]()
    var i = 0
    while i < ext.len {
        let end = if ext.len - i < LEAF_MAX then ext.len else i + LEAF_MAX
        var b = diskio.zeros(4096)
        ext_header(mut b, 0, end - i, LEAF_MAX, 0)
        for j in i..end { ext_leaf(mut b, 12 + (j - i) * 12, ext[j]) }
        let block = reserve(mut fs)?
        block_write(fs, block, b)?
        (mut level).push(Extent { logical: ext[i].logical, length: 0, start: block })
        i = end
    }
    var nodes = level.len
    var depth = 1
    while level.len > 4 {
        var up = List[Extent]()
        var k = 0
        while k < level.len {
            let end = if level.len - k < LEAF_MAX then level.len else k + LEAF_MAX
            var b = diskio.zeros(4096)
            ext_header(mut b, 0, end - k, LEAF_MAX, depth)
            for j in k..end { ext_index(mut b, 12 + (j - k) * 12, level[j].logical, level[j].start) }
            let block = reserve(mut fs)?
            block_write(fs, block, b)?
            (mut up).push(Extent { logical: level[k].logical, length: 0, start: block })
            k = end
        }
        nodes += up.len
        level = up
        depth += 1
    }
    ext_header(mut inode, 40, level.len, 4, depth)
    for j in 0..level.len { ext_index(mut inode, 52 + j * 12, level[j].logical, level[j].start) }
    nodes
}

fn inode_time(mut inode: List[byte], low: int, extra: int, time: int) {
    let bits = time & 4294967295
    let signed = if bits >= 2147483648 then bits - 4294967296 else bits
    diskio.put(mut inode, low, bits, 4)
    diskio.put(mut inode, extra, (time - signed) / 4294967296, 4)
}

fn write_node(mut fs: Fs, node: Node, nodes: List[Node]) -> () ! {invalid, io, full} {
    let group = (node.ino - 1) / fs.ipg
    let index = (node.ino - 1) % fs.ipg
    if node.ino != 2 {
        // collect assigns primary inodes consecutively after reserved 1..10.
        // Keep this explicit: finish synthesizes the inode bitmap's prefix.
        if index != fs.ipg - fs.groups[group].ifree { return invalid }
        fs.groups[group].ifree -= 1
        if node.kind == 1 { fs.groups[group].dirs += 1 }
    }
    var inode = diskio.zeros(256)
    let meta = copy node.meta
    let mode = meta.mode | if node.kind == 1 then 16384 else if node.kind == 3 then 40960 else 32768
    diskio.put(mut inode, 0, mode, 2)
    diskio.put(mut inode, 2, meta.uid & 65535, 2)
    diskio.put(mut inode, 24, meta.gid & 65535, 2)
    diskio.put(mut inode, 120, meta.uid >> 16, 2)
    diskio.put(mut inode, 122, meta.gid >> 16, 2)
    diskio.put(mut inode, 26, node.links, 2)
    diskio.put(mut inode, 128, 32, 2)
    inode_time(mut inode, 8, 140, meta.at)
    inode_time(mut inode, 12, 132, meta.ct)
    inode_time(mut inode, 16, 136, meta.mt)
    inode_time(mut inode, 144, 148, meta.mt)
    var size = node.size
    var physical = 0
    var pointers = List[int]()
    if node.kind == 3 && size < 60 {
        diskio.paste(mut inode, 40, node.target)
    } else if node.kind != 0 {
        let b = if node.kind == 1 then dir_bytes(node, nodes) else copy node.target
        size = b.len
        let count = (size + 4095) / 4096
        for i in 0..count {
            region chunk {
                var data = diskio.zeros(4096)
                let end = if b.len - i * 4096 < 4096 then b.len else (i + 1) * 4096
                diskio.paste(mut data, 0, b[i * 4096..end])
                let block = reserve(mut fs)?
                block_write(fs, block, data)?
                (mut pointers).push(block)
                physical += 1
            }
        }
    } else {
        let fd = fs_open_mode(node.source, 5) else |_| { return io }
        defer fs_close(fd) else |_| {}
        let st = fs_fstat_record(fd) else |_| { return io }
        if st[0] != 0 || st[1] != size { return invalid }
        let count = (size + 4095) / 4096
        for i in 0..count {
            region chunk {
                let amount = if size - i * 4096 < 4096 then size - i * 4096 else 4096
                let bytes = diskio.exact(fd, i * 4096, amount)?
                var block = 0
                // debugfs write creates a hole for an all-zero block.
                if !zero(bytes) {
                    var data = diskio.zeros(4096)
                    diskio.paste(mut data, 0, bytes)
                    block = reserve(mut fs)?
                    block_write(fs, block, data)?
                    physical += 1
                }
                (mut pointers).push(block)
            }
        }
    }
    if fs.extents && !(node.kind == 3 && size < 60) {
        // --extents: a file, directory or slow link, empty or not, gets a tree; a fast link stays inline.
        physical += extent_map(mut fs, pointers, mut inode)?
    } else if pointers.len > 0 { physical += block_map(mut fs, pointers, mut inode)? }
    // i_blocks is 32 bits of 512-byte units (no huge_file): a larger file is refused, not wrapped.
    if physical * 8 > 4294967295 { return invalid }
    diskio.put(mut inode, 4, size, 4)
    // --extents: i_size_high (large_file) for a file past 4 GiB, which only an extent tree reaches far
    // enough to hold. (The indirect map's last 48 MiB past 4 GiB keep trunk's 32-bit size: X3 changes
    // nothing without --extents.)
    if fs.extents { diskio.put(mut inode, 108, size >> 32, 4) }
    diskio.put(mut inode, 28, physical * 8, 4)
    diskio.write_at(fs.fd, fs.base + fs.groups[group].table * 4096 + index * 256, inode)?
}
