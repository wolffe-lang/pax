#!/usr/bin/env python3
# session — a session's own lines from a serial log (px63,
# tests/mpx6-ext2):
#
#   session pax SERIAL     PAX's: between `user: exec pid 1 ` and init's
#                          `user: <name> pid 1 exit_group|exit`, every
#                          line of kernel/user's (`user: …`) cut out, and a
#                          kernel line that landed inside a line a process
#                          had not finished cut from it (tests/mpx3-maps's
#                          rule)
#   session linux SERIAL   tools/linux-blk's: between `linux-blk: run 1:`
#                          and `linux-blk: run 1 status`
#
# Carriage returns and terminal escapes are removed first (lib.sh's
# serial_norm). The lines go to standard output.
import re
import sys


def lines(path):
    b = open(path, "rb").read().replace(b"\r", b"")
    b = re.sub(rb"\x1b\[[0-9;?=<>]*[A-Za-z]", b"", b)
    b = re.sub(rb"\x1b[()][A-Za-z0-9]", b"", b)
    b = re.sub(rb"\x1b[c78DEHM=>]", b"", b)
    return b.decode("utf-8", "surrogateescape").split("\n")


def pax(ls):
    out, on = [], False
    for l in ls:
        if l.startswith("user: exec pid 1 "):
            on = True
            continue
        if on and re.match(r"^user: [^ ]+ pid 1 (exit_group|exit) [0-9]+ after ", l):
            break
        if on:
            i = l.find("user: ")
            if i == 0:
                continue
            if i > 0:
                l = l[:i]
            out.append(l)
    return out


def linux(ls):
    out, on = [], False
    for l in ls:
        if l.startswith("linux-blk: run 1:"):
            on = True
            continue
        if on and l.startswith("linux-blk: run 1 status"):
            break
        if on:
            out.append(l)
    return out


if len(sys.argv) != 3 or sys.argv[1] not in ("pax", "linux"):
    sys.stderr.write("usage: session pax|linux SERIAL\n")
    sys.exit(2)
got = (pax if sys.argv[1] == "pax" else linux)(lines(sys.argv[2]))
sys.stdout.buffer.write(("\n".join(got) + "\n").encode("utf-8", "surrogateescape"))
