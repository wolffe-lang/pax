#!/usr/bin/env bash
# Damage regression using a small, deliberately inconsistent ext2 image.
# damage-row build WORK [KERNEL.elf]  builds a static probe and boot image.
# damage-row run WORK [bios|uefi]     makes fresh fixtures and boots both.
# No e2fsck repair is allowed: the after image is inspected read-only.
set -euo pipefail
. "$(dirname "$0")/../../tools/lib.sh"
[ "$#" -ge 2 ] || die 'damage-row build|run WORK [KERNEL.elf|bios|uefi]'
mode=$1 work=$2
mkdir -p "$work"
work=$(cd "$work" && pwd)
D=$PAX_ROOT/tests/mpx6-ext2.d
case $mode in
build)
    need cc readelf
    cc -static -no-pie -O1 -Wall -Wextra -Werror -Wl,--build-id=none -Wl,-z,noexecstack \
        "$D/damage.c" -o "$work/damage"
    readelf -hW "$work/damage" | grep -Eq 'Type: +EXEC'
    if readelf -lW "$work/damage" | grep -q INTERP; then die 'probe is not static'; fi
    printf '/dev/vda /mnt ext2 defaults 0 0\n' > "$work/fstab"
    "$PAX_ROOT/tools/mkinstall" "$work/bin" temporary
    printf '/bin/damage\n/bin/temp-probe /mnt/bin/burrowd\n' > "$work/pax-run"
    "$PAX_ROOT/tools/mkinitramfs" "$work/damage.cpio" \
        /mnt/:755 "/bin/damage=$work/damage:755" \
        "/bin/temp-probe=$work/bin/pax-temporary:755" \
        "/etc/fstab=$work/fstab:644" "/etc/pax-run=$work/pax-run:644"
    export PAX_WOLF
    PAX_WOLF=$("$PAX_ROOT/tools/fetch-wolf")
    "$PAX_ROOT/tools/fetch-limine"
    kernel=${3:-}
    if [ -z "$kernel" ]; then
        kernel=$("$PAX_ROOT/tools/build-kernel" --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/kernel")
    fi
    cp "$kernel" "$work/kernel.elf"
    "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
        --add "$work/damage.cpio" initramfs.cpio "$work/kernel.elf" "$work/damage.iso"
    ;;
run)
    firmware=${3:-bios}
    case $firmware in bios|uefi) ;; *) die 'firmware must be bios or uefi';; esac
    need python3 mke2fs debugfs e2fsck
    fixture=$work/fixture-$firmware
    python3 -I "$D/damage-fixture.py" "$fixture"
    failed=0
    for case in zero unused; do
        log=$work/$case-$firmware.serial
        rc=0
        "$PAX_ROOT/tools/qemu-halt" --firmware "$firmware" --serial "$log" \
            --timeout 180 --qemu -m --qemu 1G --elf "$work/kernel.elf" --marker 'halt|PANIC .*' \
            --qemu -drive --qemu "file=$fixture/$case.img,if=none,id=d0,format=raw" \
            --qemu -device --qemu virtio-blk-pci,drive=d0 \
            "$work/damage.iso" > "$log.verdict" 2>&1 || rc=$?
        serial_norm "$log" > "$log.norm"
        # Named reds remain column zero for the recorder.
        grep -E '^(PASS|FAIL) (damage-|temporary-)' "$log.norm" || true
        if [ "$rc" != 0 ] || ! grep -q '^PASS damage-probe failures=0$' "$log.norm" || ! grep -q '^PASS temporary-refused:' "$log.norm"; then
            echo "FAIL damage-$case-$firmware: probe or boot failed (boot exit $rc)"
            failed=1
        else
            echo "PASS damage-$case-$firmware"
        fi
        debugfs -R 'ls -l /bin' "$fixture/$case.img" > "$fixture/$case.after.txt" 2>&1
        count=$(grep -c 'burrowd.pax-tmp' "$fixture/$case.after.txt" || true)
        if [ "$count" != 1 ]; then
            echo "FAIL damage-duplicate-$case-$firmware: $count entries for the temporary name"
            failed=1
        else
            echo "PASS damage-duplicate-$case-$firmware: one entry"
        fi
        # Corruption fixture stays corrupt; this is not the clean-after-cut row.
        e2fsck -fn "$fixture/$case.img" > "$fixture/$case.after.fsck" 2>&1 || true
    done
    exit "$failed"
    ;;
*) die 'damage-row takes build or run';;
esac
