#!/usr/bin/env bash
# tests/expect-serial-selftest — prove expect-serial can say no.
#
# No QEMU: fixed logs in a temp dir, each with the verdict it must get.
# A harness that cannot fail measures nothing, so every refusal shape is
# here beside the acceptances.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
es=$here/../tools/expect-serial
t=$(mktemp -d "${TMPDIR:-/tmp}/pax-es.XXXXXX")
trap 'rm -rf "$t"' EXIT

# A firmware-console shaped log: CRs, CSI sequences, a charset switch.
printf 'BdsDxe: loading\r\n\033[2J\033[01;01H\033(BPAX\r\nfirmware: uefi\r\n' > "$t/uefi.log"
printf 'PAX\nfirmware: bios\n' > "$t/bios.log"
# The shapes CI met first (run 37058843828): SeaBIOS's ESC c, OVMF's ESC [=3h.
printf '\033cSeaBIOS (version x)\r\n\033[=3h\033[=3hBdsDxe: x\r\n\033cPAX\r\nfirmware: bios\r\n' > "$t/real.log"
printf 'PAZ\nfirmware: bios\n' > "$t/planted.log"
printf 'PAXX\nxPAX\nfirmware: bios\n' > "$t/partial.log"
: > "$t/empty.log"

fail=0
check() { # want-status description args...
    local want=$1 what=$2 got=0; shift 2
    "$es" "$@" >/dev/null 2>&1 || got=$?
    if [ "$got" = "$want" ]; then
        printf 'ok   %-46s status %s\n' "$what" "$got"
    else
        printf 'FAIL %-46s status %s, want %s\n' "$what" "$got" "$want"; fail=1
    fi
}
check 0 "bios log accepted"                 "$t/bios.log" PAX "firmware: bios"
check 0 "uefi log accepted through escapes" "$t/uefi.log" PAX "firmware: uefi"
check 0 "ESC c and ESC [=3h are stripped"     "$t/real.log" PAX "firmware: bios"
check 1 "planted PAZ refused"               "$t/planted.log" PAX "firmware: bios"
check 1 "a partial line is not a match"     "$t/partial.log" PAX
check 1 "order is enforced"                 "$t/bios.log" "firmware: bios" PAX
check 1 "wrong firmware refused"            "$t/bios.log" PAX "firmware: uefi"
check 1 "empty log refused"                 "$t/empty.log" PAX
check 2 "missing log is a usage error"      "$t/nope.log" PAX
check 2 "no expectation is a usage error"   "$t/bios.log"
exit "$fail"
