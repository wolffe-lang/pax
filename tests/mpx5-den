#!/usr/bin/env bash
# tests/mpx5-den — px90: den, version control in wolf (user/den.pin,
# tools/mkden; Track 16, M0-M4 at den 13bc2caa), preinstalled on PAX as
# /bin/den with /bin/git a symbolic link to it (tools/install-den), typed
# at the console's shell in a repository on the writable ext2 /home, held
# byte for byte to the same den on Linux, as root and as `pax`.
#
#   tests/mpx5-den [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                  [--firmware bios|uefi|both] [--tier native|release|both]
#   tests/mpx5-den --iso ISO --elf KERNEL.elf --images DIR [--firmware bios|uefi|both]
#   tests/mpx5-den --disk DISK.img --elf KERNEL.elf --images DIR [--firmware bios|uefi|both]
#
# One image, kmain_console with the archive: pelt as /bin/pelt and
# /bin/sh, /bin/den (unmodified) and /bin/git -> den (an archive link:
# tools/mkinitramfs' `/PATH->TARGET`), boreutils' cat env id ls mkdir
# readlink sha256sum (user/boreutils.pin), /bin/as; /etc (fstab: the disk
# at /home, user/fstab; hostname, motd, pax-run), /tmp (1777), /home/pax
# (0755, 1000:1000). The disk is tools/mkdisk --home 32M with
# SOURCE_DATE_EPOCH=1700000000, the bytes tests/mpx6-ext2.d/disks.sha256
# records for its home disk: ext2, pax/ owned 1000:1000. Its run list, one
# typed session a run (user/console/den.keys, typed twice), prompt `$ `:
#   den-root  `/bin/sh -i -m` (root): the repository /home/den-root/repo;
#   den-user  `/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m`
#             (`pax`): the repository /home/pax/repo.
# The keys set tools/env's pinned environment themselves (den's
# tools/environment.py: LC_ALL=C, TZ=UTC, a scratch HOME and XDG home, a
# global config of a fixed identity with no system config, color off,
# pager cat, empty hooks and template, GIT_EDITOR=false, GIT_PAGER=cat,
# and author and committer dates that move a minute a step), so commit
# ids are the same bytes wherever the keys are typed. `s` runs a command
# with its standard output and standard error to two files, then prints
# `status N`, the output, `[stderr]` and the error: each verb's three
# answers are held apart. The session is the lines from `den-session-begin`
# to `den-session-end` (tests/mpx5-den.d/region.py).
#
# **The Linux side** is the same binaries typed the same keys in a
# throwaway container (tools/linux-tree: the tree a tmpfs, the link
# copied as a link, the shell on a pseudo-terminal as pid 1 of a fresh pid
# namespace), as root and through `as 1000 1000`, run live.
#
# --iso and --disk boot a shipped image instead, with the Linux side of
# --images DIR (a build's): the rebuilt dev ISO (/home in memory: the
# distribution's root carries no fstab), or a disk pax-install wrote from
# the rebuilt medium (booted alone; / and so /home are its ext2 root). The
# image's own console shell types the keys as root, then `su pax` types
# them again as `pax`; the two sessions are held to the same Linux
# sessions as the image's own.
#
# Assertions, per tier, firmware and session:
#   D0 build: kmain_console built; pelt, den, the boreutils and as static
#      (ET_EXEC, no PT_INTERP); den built to one digest by den's own
#      tools/mkden in two checkouts (tools/mkden); /bin/git a link (the
#      archive's entry read back by a reader of its own: mode 0120777,
#      one link, its data `den`); the home disk the recorded bytes; the
#      image built; the container's two sessions ran.
#   D1 each session byte-identical to the container's: every verb's
#      status, standard output and standard error, the object ids in
#      them, and the sha256 of every loose object file and of the pack.
#   D2 the session's own witness (tests/mpx5-den.d/rows.py): den's
#      answers fixed by Git's formats and den's README, and every `s git
#      VERB` block the `s den VERB` block before it (git is den).
#   D3 the disk after the boot: e2fsck -fn clean; each repository read
#      back from it (debugfs) has the pack files' bytes the session
#      printed, and Linux's own git finds it whole (`fsck --full`) with
#      the commits den's log printed. (Not for --iso: /home is memory.)
#   D4 no -ENOSYS from den but set_robust_list (273) and rseq (334); no
#      `refused:` line; init ended, status 0; no panic; halted.
# D2 is each run's own witness: the container runs the same den, so a den
# (or a link) broken on both sides leaves D1 green and turns D2; a kernel
# break of PAX's alone turns D1.
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. A failed row is
# printed `FAIL <row> …` at the start of a line. Exit 0 when every
# assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only= iso= disk= kelf=
usage="usage: tests/mpx5-den [--images DIR | --no-boot | --only build | --only linux --images DIR] [--firmware bios|uefi|both] [--tier native|release|both] | --iso ISO --elf ELF --images DIR | --disk IMG --elf ELF --images DIR"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --iso)      iso=$2; shift 2 ;;
        --disk)     disk=$2; shift 2 ;;
        --elf)      kelf=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
if [ -n "$iso$disk" ]; then
    [ -z "$iso" ] || [ -z "$disk" ] || die "--iso or --disk, not both"
    [ -n "$images" ] && [ -f "$kelf" ] || die "--iso and --disk need --elf KERNEL.elf and --images DIR (a build's Linux side)"
    [ -f "$iso$disk" ] || die "no image $iso$disk"
fi
need readelf python3 cmp

KEYS=$PAX_ROOT/user/console/den.keys
DD=$here/mpx5-den.d
BORE="cat env id ls mkdir readlink sha256sum" # boreutils in the image (user/boreutils.pin)
RUNS=("/bin/sh -i -m" "/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m")
NAMES=(den-root den-user)
WORKDIRS=(/home/den-root /home/pax)
EPOCH=1700000000

work=$PAX_BUILD/mpx5-den
runs=$PAX_BUILD/mpx5-den-runs.txt
fail=0 ran=0
bad() { printf 'FAIL %s\n' "$*" >&2; fail=1; }

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The archive's entry for NAME, read by this reader (not by
# tools/mkinitramfs's code): "mode nlink size data" or nothing.
cpio_entry() { # archive name
    python3 - "$1" "$2" <<'PY'
import sys
buf = open(sys.argv[1], "rb").read()
want = sys.argv[2]
o = 0
while o + 110 <= len(buf):
    assert buf[o:o + 6] in (b"070701", b"070702"), "not newc at %d" % o
    f = [int(buf[o + 6 + 8 * k:o + 14 + 8 * k], 16) for k in range(13)]
    mode, nlink, size, ns = f[1], f[4], f[6], f[11]
    name = buf[o + 110:o + 110 + ns - 1].decode()
    d = (o + 110 + ns + 3) & ~3
    if name == "TRAILER!!!":
        break
    if name == want:
        print("%o %d %d %s" % (mode, nlink, size, buf[d:d + size].decode("latin-1")))
        break
    o = (d + size + 3) & ~3
PY
}

# The container's two sessions, root's and the user's.
linux_side() { # dir -> reasons on stdout
    mkdir -p "$1/linux"
    local k a0
    for k in 0 1; do
        # shellcheck disable=SC2086 # the run line's words, as the kernel splits them
        set -- "$1" ${RUNS[$k]}
        a0=$2
        if "$PAX_ROOT/tools/linux-tree" --root "$1/root" --keys "$KEYS" --prompt '$ ' --argv0 "$a0" --size 512m --rdev --nsproc \
            --owners "$1/owners" "$1/linux/${NAMES[$k]}.tty" -- "${@:2}"; then
            say "  linux ${NAMES[$k]}: $(wc -c < "$1/linux/${NAMES[$k]}.tty" | tr -d ' ') bytes, status $(cat "$1/linux/${NAMES[$k]}.tty.rc")"
        else
            printf ' tools/linux-tree %s;' "${NAMES[$k]}"
        fi
    done
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS D0 (linux): the Linux side ran in a throwaway container" || bad "D0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/bin" "$r/etc" "$r/home/pax" "$r/tmp" "$work/bin"
    why=
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" || why+=" tools/mkpelt;"
    "$PAX_ROOT/tools/mkden" "$work/den" > "$work/den.txt" || why+=" tools/mkden;"
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE > "$work/bore.txt" || why+=" tools/mkboreutils;"
    "$PAX_ROOT/tools/mkas" "$work/bin" > "$work/as.txt" || why+=" tools/mkas;"
    cp "$work/pelt/pelt" "$r/bin/pelt" 2>/dev/null || why+=" no pelt;"
    cp "$work/pelt/pelt" "$r/bin/sh" 2>/dev/null || true
    "$PAX_ROOT/tools/install-den" "$work/den" "$r" || why+=" tools/install-den;"
    for u in $BORE; do cp "$work/bore/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"; done
    cp "$work/bin/as" "$r/bin/as" 2>/dev/null || why+=" no as;"
    for f in "$r"/bin/*; do
        [ -L "$f" ] && { say "  program: ${f#"$r"/} -> $(readlink "$f")"; continue; }
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    cmp -s "$r/bin/den" "$work/den/den" || why+=" /bin/den is not mkden's bytes;"
    printf '%s\n' "${RUNS[@]}" > "$r/etc/pax-run"
    printf 'pax\n' > "$r/etc/hostname"
    printf 'PAX: den at the console (px90)\n' > "$r/etc/motd"
    cp "$PAX_ROOT/user/fstab" "$r/etc/fstab"
    printf '%s\n' '/tmp 1777 0 0' '/home/pax 755 1000 1000' > "$work/owners"
    args=(/tmp/:1777 /home/:755 /home/pax/:755:1000:1000 /etc/fstab="$r/etc/fstab":644
        /etc/pax-run="$r/etc/pax-run":644 /etc/hostname="$r/etc/hostname":644 /etc/motd="$r/etc/motd":644)
    for f in "$r"/bin/*; do
        if [ -L "$f" ]; then args+=("/bin/${f##*/}->$(readlink "$f")"); else args+=("/bin/${f##*/}=$f:755"); fi
    done
    "$PAX_ROOT/tools/mkinitramfs" "$work/den.cpio" "${args[@]}" > "$work/den.initramfs.txt" || why+=" tools/mkinitramfs;"
    e=$(cpio_entry "$work/den.cpio" bin/git)
    [ "$e" = "120777 1 3 den" ] || why+=" the archive's bin/git is '$e', not a link to den (120777 1 3 den);"
    # The home disk: tools/mkdisk --home, the bytes mpx6-ext2 records.
    if SOURCE_DATE_EPOCH=$EPOCH "$PAX_ROOT/tools/mkdisk" --home 32M "$work/home.img" > "$work/home.mkdisk.txt" 2>&1; then
        want=$(awk '$1 == "home" { print $2 }' "$here/mpx6-ext2.d/disks.sha256")
        got=$(sha256_of "$work/home.img")
        [ "$got" = "$want" ] || why+=" home.img is $got, mpx6-ext2 records $want;"
    else
        cat "$work/home.mkdisk.txt" >&2
        why+=" tools/mkdisk --home;"
    fi
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                --add "$work/den.cpio" initramfs.cpio "$elf" "$work/$tier/den.iso" >/dev/null || why+=" $tier: mkimage;"
            say "built $tier den: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/den.iso"), initramfs $(sha256_of "$work/den.cpio")"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS D0 (build): kmain_console built ($tiers), every program static, den to one digest, bin/git an archive link to den, the home disk the recorded bytes, the image built" || bad "D0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS D0: kmain_console built ($tiers), every program static, den to one digest, bin/git an archive link to den, the home disk the recorded bytes, the image built, the Linux side ran in a throwaway container" || bad "D0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx5-den build (D0): PASS (no boot: --no-boot)" || say "mpx5-den build: FAIL"
        exit "$fail"
    fi
fi

densha=$(awk '$1 == "den" { print $2 }' "$images/den/sums.txt" 2>/dev/null)
[ -n "$densha" ] || die "no $images/den/sums.txt (build first)"
lx=$images/linux
for n in "${NAMES[@]}"; do
    [ -f "$lx/$n.tty" ] || { bad "D0 linux $n: no $lx/$n.tty (build first, and run the Linux side)"; continue; }
    serial_norm "$lx/$n.tty" > "$lx/$n.norm"
    python3 "$DD/region.py" "$lx/$n.norm" 1 > "$lx/$n.region" || bad "D0 linux $n: no whole den session in the container's transcript"
done

# Run k's transcript: from its `run <k>:` line to the kernel's `user:
# frames free …` line after it, the kernel's own lines left out
# (tests/mpx5-jobs' rule).
run_part() { # norm k
    awk -v k="$2" '
        $0 ~ "^run " k ": " { on = 1; next }
        on && /^run [0-9]+: |^run: [0-9]+ commands$|^user: frames free / { exit }
        on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$1"
}

record() { # tier leg what status
    ran=$((ran + 1))
    printf '%s %s %s den halt-status=%s accel=%s serial=%s\n' "$1" "$2" "$3" "$4" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" >> "$runs"
}

# D1 and D2 for one session: SESSION is its region, k its index.
session_rows() { # id k session
    local n=${NAMES[$2]} why line
    why=
    if [ -f "$lx/$n.region" ]; then
        cmp -s "$lx/$n.region" "$3" || why+=" the session differs from the container's: $(diff "$lx/$n.region" "$3" | head -n 14 | cut -c1-300 | tr '\n' '|');"
    else
        why+=" no container session;"
    fi
    [ "$(wc -l < "$3" | tr -d ' ')" -gt 500 ] || why+=" a short session ($(wc -l < "$3" | tr -d ' ') lines);"
    [ -z "$why" ] && say "PASS D1 $1 $n: $(wc -l < "$3" | tr -d ' ') lines byte-identical to the container's ($(sha256_of "$3" | cut -c1-12)…)" || bad "D1 $1 $n:$why"
    why=$(python3 "$DD/rows.py" "$3" "$densha" "${WORKDIRS[$2]}")
    if [ -z "$why" ]; then
        say "PASS D2 $1 $n: the $(python3 -c 'import runpy, sys; print(len(runpy.run_path(sys.argv[1])["ROWS"]))' "$DD/rows.py") rows (den's answers, the link, git as den, the editor's refusal, packs and fsck)"
    else
        while IFS= read -r line; do bad "${line%%:*} $1 $n:${line#*:}"; done <<< "$why"
    fi
}

# D3: the disk image after the boot, ROOT the directory the two
# repositories' parents are in on it ("" for the home disk, /home for a
# root file system).
disk_rows() { # id image root session0 session1
    local id=$1 img=$2 root=$3 dir why k n sess want have ids gids
    dir=$(dirname "$img")
    why=
    "$PAX_ROOT/tools/e2fs" "$dir" e2fsck -fn "$img" > "$img.fsck" 2>&1 || why+=" e2fsck -fn: $(tail -n 3 "$img.fsck" | tr '\n' '|');"
    for k in 0 1; do
        n=${NAMES[$k]} sess=${4}
        [ "$k" = 1 ] && sess=$5
        rm -rf "$img.$n"; mkdir -p "$img.$n"
        "$PAX_ROOT/tools/e2fs" "$dir" debugfs -R "rdump $root${WORKDIRS[$k]#/home}/repo $img.$n" "$img" > "$img.$n.debugfs" 2>&1
        [ -d "$img.$n/repo/.git" ] || { why+=" $n: no repository read back from the disk;"; continue; }
        # The pack files the session printed are the disk's bytes.
        want=$(python3 - "$sess" <<'PY'
import re, sys
lines = open(sys.argv[1], encoding='latin-1').read().split('\n')
i = lines.index('$ sha256sum .git/objects/pack/*')
for l in lines[i + 1:]:
    if not re.fullmatch(r'[0-9a-f]{64}  \S+', l):
        break
    print(l)
PY
)
        have=$(cd "$img.$n/repo" && sha256sum .git/objects/pack/* 2>/dev/null)
        [ -n "$want" ] && [ "$want" = "$have" ] || why+=" $n: the pack on the disk is not the session's ($(printf '%s' "$have" | head -c 160));"
        # Linux's git reads what PAX wrote: whole, and den's commits.
        if git -c safe.directory='*' -C "$img.$n/repo" fsck --full --no-dangling > "$img.$n.git-fsck" 2>&1; then :; else
            why+=" $n: git fsck --full: $(head -n 3 "$img.$n.git-fsck" | tr '\n' '|');"
        fi
        ids=$(python3 - "$sess" <<'PY'
import re, sys
lines = open(sys.argv[1], encoding='latin-1').read().split('\n')
i = max(k for k, l in enumerate(lines) if l == '$ s den log')
out = []
for l in lines[i + 1:]:
    if l.startswith('$ '):
        break
    if re.fullmatch(r'commit [0-9a-f]{40}', l):
        out.append(l[7:])
print('\n'.join(sorted(out)))
PY
)
        gids=$(git -c safe.directory='*' -C "$img.$n/repo" rev-list main 2>/dev/null | sort)
        [ -n "$ids" ] && [ "$ids" = "$gids" ] || why+=" $n: git rev-list main is not den's log ($(printf '%s' "$gids" | wc -l | tr -d ' ') against $(printf '%s' "$ids" | wc -l | tr -d ' '));"
    done
    [ -z "$why" ] && say "PASS D3 $id: the disk clean (e2fsck -fn); both repositories read back, the pack the session's bytes, git fsck --full clean and git's commits den's ($(git --version))" || bad "D3 $id:$why"
}

d4_rows() { # id halt-status
    local why= ns rf pn
    ns=$(sed -n -E 's/^user: (den|git) pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\2/p' "$norm" | sort -un | paste -sd' ' -)
    for x in $ns; do case $x in 273|334) ;; *) why+=" -ENOSYS for $x;" ;; esac; done
    rf=$(grep -c ': refused: ' "$norm")
    [ "$rf" = 0 ] || why+=" $rf refused lines ($(grep -m1 ': refused: ' "$norm" | cut -c1-160));"
    grep -Eqx "PAX: init /bin/(sh|env) ended with status 0; nothing left to run" "$norm" \
        || why+=" no 'PAX: init … ended with status 0' ($(grep -m1 '^PAX: init ' "$norm"));"
    pn=$(grep -m1 '^PANIC ' "$norm")
    [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
    [ "$2" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
    [ -z "$why" ] && say "PASS D4 $1: -ENOSYS from den only for '${ns:-none}' (of 273 334); nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "D4 $1:$why"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "D4 uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    if [ -n "$iso$disk" ]; then
        # A shipped image: one console shell types the keys as root, then
        # as `pax` under su, then leaves both shells.
        what=iso; [ -n "$disk" ] && what=disk
        id="$what $leg"
        log=$PAX_BUILD/mpx5-den-$what-$leg.serial.log
        rm -f "$log" "$log.verdict" "$log.typed"
        keys=$PAX_BUILD/mpx5-den-$what.keys
        { grep -vx exit "$KEYS"; echo 'su pax'; grep -vx exit "$KEYS"; echo exit; echo exit; } > "$keys"
        hargs=(--firmware "$leg" --serial "$log" --timeout 1800 --qemu -m --qemu 2048M --elf "$kelf"
            --marker 'halt|PANIC .*' --type "$keys" --prompt '$ ')
        hrc=0
        if [ -n "$iso" ]; then
            "$PAX_ROOT/tools/qemu-halt" "${hargs[@]}" "$iso" > "$log.verdict" 2>&1 || hrc=$?
        else
            img=$PAX_BUILD/mpx5-den-disk-$leg.img
            cp --sparse=always "$disk" "$img"
            "$PAX_ROOT/tools/qemu-halt" "${hargs[@]}" --boot-disk "$img" > "$log.verdict" 2>&1 || hrc=$?
        fi
        record "$what" "$leg" "$(basename "$iso$disk")" "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        for k in 0 1; do
            out=$PAX_BUILD/mpx5-den-$what-$leg-${NAMES[$k]}.session
            python3 "$DD/region.py" "$norm" $((k + 1)) > "$out" || { bad "D1 $id ${NAMES[$k]}: no whole den session in the serial log"; continue; }
            session_rows "$id" "$k" "$out"
        done
        if [ -n "$disk" ]; then
            # The root file system is GPT partition 2 of the disk.
            python3 - "$img" "$img.root" <<'PY' || bad "D3 $id: cannot read partition 2 of the disk"
import struct, sys
src, dst = sys.argv[1:]
with open(src, 'rb') as f:
    f.seek(512); h = f.read(512); assert h[:8] == b'EFI PART'
    lba, width = struct.unpack_from('<Q', h, 72)[0], struct.unpack_from('<I', h, 84)[0]
    f.seek(lba * 512 + width); start, end = struct.unpack_from('<QQ', f.read(width), 32)
    f.seek(start * 512)
    with open(dst, 'wb') as o:
        left = (end - start + 1) * 512
        while left:
            b = f.read(min(left, 1 << 20)); assert b; o.write(b); left -= len(b)
PY
            disk_rows "$id" "$img.root" /home \
                "$PAX_BUILD/mpx5-den-$what-$leg-${NAMES[0]}.session" "$PAX_BUILD/mpx5-den-$what-$leg-${NAMES[1]}.session"
            rm -f "$img" "$img.root"
        else
            say "NOTE D3 $id: not run: the dev ISO's /home is the in-memory tree (its root carries no fstab)"
        fi
        d4_rows "$id" "$hrc"
        continue
    fi
    for tier in $tiers; do
        id="$tier $leg"
        log=$PAX_BUILD/mpx5-den-$tier-$leg.serial.log
        elf=$images/$tier/kmain_console.elf iso=$images/$tier/den.iso
        rm -f "$log" "$log.verdict" "$log.typed"
        if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
            bad "D4 $id: no image"
            continue
        fi
        home=$PAX_BUILD/mpx5-den-$tier-$leg.home.img
        cp "$images/home.img" "$home"
        cat "$KEYS" "$KEYS" > "$images/den.keys"
        hrc=0
        "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 1800 --qemu -m --qemu 1024M \
            --elf "$elf" --marker 'halt|PANIC .*' --type "$images/den.keys" --prompt '$ ' --drive "$home" \
            "$iso" >"$log.verdict" 2>&1 || hrc=$?
        record "$tier" "$leg" den "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        grep -Eq '^fstab: /dev/vda on /home: ext2, read-write, write-(back|through)$' "$norm" \
            || bad "D4 $id: /home is not the ext2 disk ($(grep -m1 '^fstab: ' "$norm"))"
        for k in 0 1; do
            n=${NAMES[$k]}
            out=$PAX_BUILD/mpx5-den-$tier-$leg-$n.session
            run_part "$norm" $((k + 1)) > "$out.run"
            python3 "$DD/region.py" "$out.run" 1 > "$out" || { bad "D1 $id $n: no whole den session in run $((k + 1))"; continue; }
            session_rows "$id" "$k" "$out"
        done
        disk_rows "$id" "$home" "" \
            "$PAX_BUILD/mpx5-den-$tier-$leg-${NAMES[0]}.session" "$PAX_BUILD/mpx5-den-$tier-$leg-${NAMES[1]}.session"
        d4_rows "$id" "$hrc"
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { bad "D4: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx5-den: PASS" || say "mpx5-den: FAIL"
exit "$fail"
