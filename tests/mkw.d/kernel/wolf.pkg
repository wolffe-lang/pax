// The PAX kernel's manifest. `asm` lists the assembly the kernel calls
// into (wolf assembles it for the kernel's target and refuses a call
// into anything off its roster, [abi.asm.roster]). The target is not
// set here: tools/build-kernel passes `--target x86_64-unknown-none`,
// so M-KW's seen-red variant (the flag removed) builds hosted and fails.
pkg {
    name: "pax/kernel"
    version: "0.0.1"
    asm: ["../boot/io.S"]
}
