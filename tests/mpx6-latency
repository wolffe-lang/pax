#!/usr/bin/env bash
# tests/mpx6-latency — px131: how late PAX lets a process run while another
# makes long system calls, and how long it keeps interrupts off doing so.
# One probe, user/elf/latprobe.c (tools/mklatprobe, static glibc), runs as
# kmain_console's one program with `latency` on the command line (kernel/
# latency's instrument, /proc/pax-latency) and measures each load in turn:
# a 1 ms sleeper's lateness and a UDP echo over loopback, beside the load,
# for SECONDS each; and this host pings the guest's echo through the network
# device every 5 ms (tests/mpx6-latency.d/echo-host.py, through QEMU's user
# network), as keystrokes over ssh would come. Every line also reaches this
# host as a datagram, so a boot with no COM1 reports too. The guest's memory
# is backed before it boots (-mem-prealloc), PAX's and Linux's alike: a
# first touch of a guest frame otherwise costs the host a page fault, and
# a call that fills fresh frames (a fork, an mmap's zeroing) showed the
# host's faults as stretches of 30 to 150 ms now and then.
#
#   tests/mpx6-latency [--images DIR | --no-boot] [--firmware bios|uefi|both]
#                      [--tier native|release|both] [--accel auto|kvm|tcg]
#                      [--mem MIB[,MIB…]] [--loads guard|all|'LOAD …']
#                      [--seconds N] [--screen WxH] [--no-com1] [--linux [--no-pax]]
#
# --loads guard (the default) runs the rows' loads: idle, spin and the
# guarded loads (tests/mpx6-latency.d/rows.py's GUARD); all runs every load
# latprobe has, at sizes for the boot's memory (the measurement table,
# notes/px131-long-kernel-paths.md); or a list of latprobe's LOAD[:ARG].
# --screen boots at that framebuffer mode, and --no-com1 with no serial port
# (the installed machine's shape: every console byte drawn, none sent).
# --linux also boots Linux at each memory size, the same probe and loads,
# the comparison column (black box): the kernel PAX_LINUX_KERNEL (default
# /run/current-system/kernel) with the modules of PAX_LINUX_MODULES (the
# kernel's lib/modules/<version>) its virtio network needs, on q35 with one
# CPU under the same accelerator, user/elf/latinit.c as its init; with
# --no-pax, Linux's boots alone.
#
# Assertions, per tier, firmware and memory:
#   S0 the rows' arithmetic can say no (tests/mpx6-latency.d/rows-selftest:
#      L2's floor, L6's offered rate, unmeasured and its holds), first.
#   L0 build: kmain_console built; latprobe and latbig static; the image.
#   L1 every load reported a line (through the network), each with its
#      sleeper's and its loopback echo's samples; latprobe's end line; the
#      kernel's instrument on.
#   L2 the guarded loads (rows.py): the sleeper's worst lateness and each
#      echo's worst round trip beside the load, as a ratio to the same
#      boot's `spin` (a hog that makes no system call: the scheduler's own
#      share), at most rows.py's bound (the host's ping also within spin's
#      plus 10 ms); under TCG SKIPPED by name.
#   L3 every load's figures, printed as `~` lines (the table), held to
#      nothing.
#   L4 the clocks: CLOCK_MONOTONIC and CLOCK_REALTIME keep the time-stamp
#      counter's time within 2 % across the loads that hold interrupts off
#      longest (rows.py's `clocked`).
#   L5 beside `spin`, the host's ping's p99 at most 3 times its p99 at
#      `idle` (KVM only).
#   L6 under a ping flood offered at rows.py's FLOOD_RATE (`flood:R`), a
#      CPU-bound process keeps at least half of its share beside `spin`
#      (KVM only). A host that did not offer the rate is unmeasured: that
#      boot's L6 is held again, a fresh boot of `spin` and the offered flood
#      (BOOT-hold2, BOOT-hold3), at most three holds; a measured result is
#      final at once; three unmeasured holds are FAIL L6-unmeasured.
#  ~L6 the saturating flood (`flood`), bounded by nothing: its rate, the
#      hog's share and the sleeper's worst, the curve in every record.
# Exit 0 when every assertion held, 3 when the only red is L6-unmeasured, 1
# otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
D=$here/mpx6-latency.d
grep() { command grep -a "$@"; }

images= legs=both tiers=native noboot=0 accel=auto mems=1024 loads=guard seconds=3 screen= com1=1 linux=0 pax=1
usage="usage: tests/mpx6-latency [--images DIR | --no-boot] [--firmware bios|uefi|both] [--tier native|release|both] [--accel auto|kvm|tcg] [--mem MIB[,MIB...]] [--loads guard|all|'LOAD ...'] [--seconds N] [--screen WxH] [--no-com1]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        --accel)    accel=$2; shift 2 ;;
        --mem)      mems=$2; shift 2 ;;
        --loads)    loads=$2; shift 2 ;;
        --seconds)  seconds=$2; shift 2 ;;
        --screen)   screen=$2; shift 2 ;;
        --no-com1)  com1=0; shift ;;
        --linux)    linux=1; shift ;;
        --no-pax)   pax=0; shift ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $accel in auto|kvm|tcg) ;; *) die "--accel takes auto, kvm or tcg" ;; esac
mems=${mems//,/ }
need python3

# The loads for a boot of MIB MiB.
loads_for() { # mib
    local m=$1
    case $loads in
        guard) python3 -I "$D/rows.py" --guard-loads "$m" ;;
        all) echo "idle spin flood console:65536 pty:16384 write:$((m / 16)) fork:$((m / 8)) exec mmap:$((m / 8)) hole:1024 procmem:8 random:8 pipe:65536 tcplo:65536 dir:4000 poll:1000" ;;
        *) echo "$loads" ;;
    esac
}

work=$PAX_BUILD/mpx6-latency
fail=0
bad() { say "FAIL $*"; fail=1; }

# S0: the rows' arithmetic, before anything boots.
if python3 -I "$D/rows-selftest" >&2; then say "PASS S0 the rows' arithmetic (rows-selftest)"; else bad "S0 the rows' arithmetic (rows-selftest)"; fi

if [ -z "$images" ]; then
    need readelf
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    mkdir -p "$work/bin"
    why=
    "$PAX_ROOT/tools/mklatprobe" "$work/bin" > "$work/probes.txt" || why+=" tools/mklatprobe;"
    sed 's/^/  program: /' "$work/probes.txt" >&2
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            [ "$elf" = "$work/$tier/kmain_console.elf" ] || cp "$elf" "$work/$tier/kmain_console.elf"
            say "built $tier kmain_console: elf $(sha256_of "$work/$tier/kmain_console.elf")"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    [ -z "$why" ] && say "PASS L0 build: kmain_console ($tiers), latprobe and latbig static" || { bad "L0 build:$why"; exit 1; }
    images=$work
    [ "$noboot" = 1 ] && exit 0
fi

if [ "$accel" = auto ]; then
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then accel=kvm; else accel=tcg; fi
fi
say "accel: $accel (L2 holds its bound under KVM only)"

# A free UDP port on this host's loopback.
free_port() {
    python3 -I -c 'import socket; s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

# boot_pax TIER LEG MEM DIR LOADS: one boot of the probe with LOADS, its
# report, serial log, verdict and rc in DIR (named TIER-LEG-MEM[-holdN]).
boot_pax() {
    local tier=$1 leg=$2 mem=$3 b=$4 loadlist=$5 name port fwd report epid w nload budget rc qpid scr net q
    name=${b##*/}
    mkdir -p "$b"
    port=$(free_port)
    fwd=$(free_port)
    report=$b/report.txt
    : > "$report"
    python3 -I "$D/echo-host.py" "$port" "$fwd" "$report" > "$b/echo-host.log" 2>&1 &
    epid=$!
    w=0
    while [ "$w" -lt 50 ] && ! grep -q '^echo-host: ' "$b/echo-host.log" 2>/dev/null; do sleep 0.1; w=$((w + 1)); done
    if ! grep -q '^echo-host: port' "$b/echo-host.log"; then
        bad "L1 $name: the host's echo did not bind ($(cat "$b/echo-host.log"))"
        kill "$epid" 2>/dev/null; wait "$epid" 2>/dev/null
        return
    fi
    # shellcheck disable=SC2046
    printf '/bin/latprobe -d %s -e 7 -r 10.0.2.2:%s %s\n' "$seconds" "$port" "$loadlist" > "$b/pax-run"
    "$PAX_ROOT/tools/mkinitramfs" "$b/lat.cpio" "/bin/latprobe=$images/bin/latprobe:755" "/bin/latbig=$images/bin/latbig:755" \
        "/etc/pax-run=$b/pax-run:644" /tmp/:1777 > "$b/initramfs.txt" || { bad "L0 $name: tools/mkinitramfs"; kill "$epid"; wait "$epid" 2>/dev/null; return; }
    cp "$PAX_ROOT/boot/limine-initramfs.conf" "$b/limine.conf"
    [ -n "$screen" ] && printf '\n    resolution: %s\n' "$screen" >> "$b/limine.conf"
    printf '\n    cmdline: latency%s\n' "$([ -n "$screen" ] && echo ' fbwrite')" >> "$b/limine.conf"
    "$PAX_ROOT/tools/mkimage" --conf "$b/limine.conf" --add "$b/lat.cpio" initramfs.cpio \
        "$images/$tier/kmain_console.elf" "$b/lat.iso" > /dev/null || { bad "L0 $name: tools/mkimage"; kill "$epid"; wait "$epid" 2>/dev/null; return; }
    nload=$(wc -w < "$b/pax-run"); nload=$((nload - 7))
    budget=$((nload * (seconds + 12) + 240))
    scr=(); [ -z "$screen" ] && scr=(--no-screen)
    say "boot $name: $nload loads, port $port, budget ${budget}s$([ "$com1" = 0 ] && echo ', no COM1')"
    net=(-m "${mem}M" -mem-prealloc -netdev "user,id=n0,ipv6=off,hostfwd=udp:127.0.0.1:$fwd-:7" -device "virtio-net-pci,netdev=n0")
    if [ "$com1" = 1 ]; then
        q=(); for a in "${net[@]}"; do q+=(--qemu "$a"); done
        "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$b/serial.log" ${scr[@]+"${scr[@]}"} --timeout "$budget" --accel "$accel" \
            --elf "$images/$tier/kmain_console.elf" --marker 'halt|PANIC .*' "${q[@]}" "$b/lat.iso" > "$b/verdict.txt" 2>&1
        rc=$?
    else
        # No COM1, so no halt marker to wait for: the report's end line
        # (the probe's last datagram) ends the boot.
        "$PAX_ROOT/tools/qemu-run" --firmware "$leg" --no-serial ${scr[@]+"${scr[@]}"} ${screen:+--display-mode=$screen} --timeout "$budget" --accel "$accel" \
            "$b/lat.iso" -- "${net[@]}" > "$b/verdict.txt" 2>&1 &
        qpid=$!
        while kill -0 "$qpid" 2>/dev/null && ! grep -q '^latprobe: end' "$report"; do sleep 1; done
        sleep 1
        kill "$qpid" 2>/dev/null
        wait "$qpid" 2>/dev/null
        rc=0; grep -q '^latprobe: end' "$report" || rc=1
    fi
    sleep 0.5
    kill "$epid" 2>/dev/null; wait "$epid" 2>/dev/null
    echo "$rc" > "$b/rc"
    printf '%s %s %s %s halt=%s report=%s lines=%s\n' "$tier" "$leg" "${b##*/$tier-$leg-}" "$accel" "$rc" "$(sha256_of "$report")" "$(grep -c '^latprobe ' "$report")" >> "$runs"
}

runs=$images/runs.txt
: > "$runs"
[ "$pax" = 1 ] || tiers_boot=
for tier in ${tiers_boot-$tiers}; do
    for leg in $legs; do
        if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
            if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then bad "L1 $tier uefi: no OVMF"; else say "SKIP L1 $tier uefi reason=no OVMF"; fi
            continue
        fi
        for mem in $mems; do
            boot_pax "$tier" "$leg" "$mem" "$images/$tier/$tier-$leg-$mem" "$(loads_for "$mem")"
        done
    done
done

# L6's holds: a boot whose offered flood was unmeasured (the host did not
# offer the rate) is held again, a fresh boot of `spin` and the offered
# flood, while every hold so far is unmeasured, at most three holds.
if [ "$accel" = kvm ]; then
    paced="spin $(python3 -I "$D/rows.py" --guard-loads 1024 | tr ' ' '\n' | grep -m 1 '^flood:')"
    for hold in 2 3; do
        for boot in $(python3 -I "$D/rows.py" --l6-again --images "$images" $(for t in ${tiers_boot-$tiers}; do for l in $legs; do for m in $mems; do printf '%s ' "$t-$l-$m"; done; done; done)); do
            IFS=- read -r t l m <<< "$boot"
            say "L6 $boot: unmeasured on hold $((hold - 1)); hold $hold of 3, a fresh boot ($paced)"
            boot_pax "$t" "$l" "$m" "$images/$t/$boot-hold$hold" "$paced"
        done
    done
fi

# The comparison column: Linux, one boot a memory size.
if [ "$linux" = 1 ]; then
    lk=${PAX_LINUX_KERNEL:-/run/current-system/kernel}
    lm=${PAX_LINUX_MODULES:-}
    for mem in $mems; do
        name=linux-direct-$mem
        b=$images/linux/$name
        mkdir -p "$b/mods"
        why=
        [ -r "$lk" ] || why+=" no kernel $lk;"
        : > "$b/mods/order"
        files=(/init="$images/bin/latinit":755 /bin/latprobe="$images/bin/latprobe":755 /bin/latbig="$images/bin/latbig":755
               /proc/:555 /tmp/:1777 /dev/:755 /lib/modules/order="$b/mods/order":644)
        # virtio's network as modules where the kernel has them so, in modules.dep's order
        for m in virtio_ring virtio virtio_pci_legacy_dev virtio_pci_modern_dev virtio_pci failover net_failover virtio_net; do
            f=$(command grep -oE "^[^:]*/$m\.ko(\.xz|\.zst|\.gz)?:" "$lm/modules.dep" 2>/dev/null | head -n 1 | tr -d :)
            [ -n "$f" ] || continue
            case $f in
                *.xz) xz -d -c "$lm/$f" > "$b/mods/$m.ko" ;;
                *.zst) zstd -q -d -c "$lm/$f" > "$b/mods/$m.ko" ;;
                *.gz) gzip -d -c "$lm/$f" > "$b/mods/$m.ko" ;;
                *) cp "$lm/$f" "$b/mods/$m.ko" ;;
            esac || why+=" module $m;"
            echo "$m" >> "$b/mods/order"
            files+=(/lib/modules/$m.ko="$b/mods/$m.ko":644)
        done
        port=$(free_port); fwd=$(free_port)
        report=$b/report.txt
        : > "$report"
        loadlist=$(loads_for "$mem")
        printf '%s
' "-d $seconds -e 7 -r 10.0.2.2:$port $loadlist" > "$b/latprobe-args"
        printf '/bin/latprobe -d %s -e 7 -r 10.0.2.2:%s %s
' "$seconds" "$port" "$loadlist" > "$b/pax-run"
        files+=(/etc/latprobe-args="$b/latprobe-args":644)
        "$PAX_ROOT/tools/mkinitramfs" "$b/linux.cpio" "${files[@]}" > "$b/initramfs.txt" || why+=" tools/mkinitramfs;"
        if [ -n "$why" ]; then bad "L1 $name:$why"; continue; fi
        python3 -I "$D/echo-host.py" "$port" "$fwd" "$report" > "$b/echo-host.log" 2>&1 &
        epid=$!
        w=0
        while [ "$w" -lt 50 ] && ! grep -q '^echo-host: ' "$b/echo-host.log" 2>/dev/null; do sleep 0.1; w=$((w + 1)); done
        nload=$(wc -w < "$b/pax-run"); nload=$((nload - 7))
        acc=(-accel tcg -cpu max); [ "$accel" = kvm ] && acc=(-accel kvm -cpu host)
        say "boot $name: $nload loads, port $port, Linux $(basename "$(readlink -f "$lk")")"
        timeout $((nload * (seconds + 12) + 240)) qemu-system-x86_64 -machine q35 "${acc[@]}" -smp 1 -m "${mem}M" -mem-prealloc -nographic -no-reboot \
            -kernel "$lk" -initrd "$b/linux.cpio" -append "console=ttyS0 quiet loglevel=3 panic=-1" \
            -netdev "user,id=n0,ipv6=off,hostfwd=udp:127.0.0.1:$fwd-:7" -device "virtio-net-pci,netdev=n0" \
            > "$b/serial.log" 2>&1 < /dev/null
        echo $? > "$b/rc"
        sleep 0.5
        kill "$epid" 2>/dev/null; wait "$epid" 2>/dev/null
        printf 'linux direct %s %s qemu=%s report=%s lines=%s\n' "$mem" "$accel" "$(cat "$b/rc")" "$(sha256_of "$report")" "$(grep -c '^latprobe ' "$report")" >> "$runs"
    done
fi

python3 -I "$D/rows.py" --accel "$accel" --images "$images" --com1 "$com1" $(for t in ${tiers_boot-$tiers}; do for l in $legs; do for m in $mems; do printf '%s ' "$t-$l-$m"; done; done; done) \
    $([ "$linux" = 1 ] && for m in $mems; do printf 'linux-direct-%s ' "$m"; done)
rc=$?
# 3: the only red is L6-unmeasured (a host that could not offer the flood), told apart from a kernel's red
[ "$rc" = 3 ] && [ "$fail" = 0 ] && { say "mpx6-latency: UNMEASURED (L6: the host did not offer the flood in three holds)"; exit 3; }
[ "$rc" = 0 ] || fail=1
[ "$fail" = 0 ] && say "mpx6-latency: PASS" || say "mpx6-latency: FAIL"
exit "$fail"
