#!/usr/bin/env bash
# tests/mpx6-part.d/fixtures — the partition-table fixtures of
# tests/mpx6-part (px66), each an 8 MiB disk (16,384 sectors) filled
# with kmain_part's sector pattern and given a table by tools/mkgpt, with
# SOURCE_DATE_EPOCH=1700000000 so every GUID and byte is the same on
# every host (tests/mpx6-part.d/fixtures.sha256).
#
#   tests/mpx6-part.d/fixtures OUTDIR [NAME...]
#
# The names (each OUTDIR/NAME.img):
#   one         a GPT of one entry: vda1, the usable space
#   four        four entries, all used, in LBA order (BIOS boot, ESP,
#               Linux, basic data): the window rows' disk
#   wide        four entries of 256 bytes (a larger multiple of 8)
#   full        128 entries, every one used, 127 sectors each: names
#               past vda15
#   holes       128 entries, slots 1, 3, 64 and 128 used
#   order       slot 1 last on the disk, slot 2 first, slot 3 between
#   gap         three partitions with free space between the first two
#   badprimary  four's table, the primary header failing its CRC
#   badbackup   four's table, the backup header failing its CRC
#   bothbad     four's table, both failing
#   mbr         no GPT: an MBR (signature 5ca1ab1e) with two primary
#               partitions (0x83, 0x0c): R-px66-1
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
mk=$here/../../tools/mkgpt
[ $# -ge 1 ] || { echo "usage: fixtures OUTDIR [NAME...]" >&2; exit 2; }
out=$1; shift
mkdir -p "$out"
export SOURCE_DATE_EPOCH=1700000000
ALL="one four wide full holes order gap badprimary badbackup bothbad mbr"
FOUR="1:bios:34:2047:bios 2:esp:2048:4095:esp 3:linux:4096:8191:home 4:basic:8192:16350:data"
names=${*:-$ALL}
for n in $names; do
    f=$out/$n.img
    g=(--size 8M --pattern --label "$n")
    case $n in
        one)        "$mk" "${g[@]}" --entries 1 "$f" 1:linux:2048:16350:one ;;
        four)       "$mk" "${g[@]}" --entries 4 "$f" $FOUR ;;
        wide)       "$mk" "${g[@]}" --entries 4 --entry-size 256 "$f" $FOUR ;;
        full)       parts=(); for k in $(seq 1 128); do s=$((34 + (k - 1) * 127)); parts+=("$k:linux:$s:$((s + 126)):p$k"); done
                    "$mk" "${g[@]}" "$f" "${parts[@]}" ;;
        holes)      "$mk" "${g[@]}" "$f" 1:linux:2048:4095:a 3:linux:4096:6143:c 64:linux:8192:10239:x 128:linux:12288:16350:z ;;
        order)      "$mk" "${g[@]}" "$f" 1:linux:12288:16350:last 2:linux:2048:4095:first 3:linux:8192:12287:middle ;;
        gap)        "$mk" "${g[@]}" "$f" 1:linux:2048:4095:a 2:linux:8192:10239:b 3:linux:10240:16350:c ;;
        badprimary) "$mk" "${g[@]}" --entries 4 --break primary "$f" $FOUR ;;
        badbackup)  "$mk" "${g[@]}" --entries 4 --break backup "$f" $FOUR ;;
        bothbad)    "$mk" "${g[@]}" --entries 4 --break both "$f" $FOUR ;;
        mbr)        "$mk" --size 8M --pattern --mbr 5ca1ab1e "$f" 1:83:2048:8191 2:0c:8192:16383 ;;
        *)          echo "fixtures: no fixture $n" >&2; exit 2 ;;
    esac
done
