#!/usr/bin/env python3
"""Independent release identity checks, including two non-vacuous negatives."""
from pathlib import Path
import hashlib
import os
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]

def sha(data):
    return hashlib.sha256(data).hexdigest()

def check(release, kernel, commit, epoch):
    rows = {}
    for line in release.read_text().splitlines():
        name, rev, digest = line.split()
        assert name not in rows, f"release-duplicate: {name}"
        rows[name] = (rev, digest)
    assert rows.pop('kernel') == (commit, sha(kernel.read_bytes())), 'release-kernel'
    assert rows.pop('source-date-epoch') == (str(epoch), '-'), 'release-epoch'
    for pin in sorted((ROOT / 'user').glob('*.pin')):
        values = dict(line.split('=', 1) for line in pin.read_text().splitlines()
                      if line and not line.startswith('#') and '=' in line)
        keys = {'lupin': 'LUPIN_SRC_REV', 'wolf': 'WOLF_SRC_REV',
                'boreutils': 'BORE_REV', 'busybox': 'BUSYBOX_VERSION',
                'disktools': None}
        key = keys.get(pin.stem, pin.stem.upper() + '_REV')
        revision = values[key] if key else 'packages'
        assert rows.pop(pin.stem) == (revision, sha(pin.read_bytes())), 'release-' + pin.stem
    for line in (ROOT / 'user/install/games.txt').read_text().splitlines():
        if not line or line.startswith('#'):
            continue
        name, rev, digest, _, _, engine, engine_digest = line.split()
        assert rows.pop(name) == (rev, digest), 'release-game-' + name
        assert rows.pop('lair-' + name) == (engine, engine_digest), 'release-engine-' + name
    assert not rows, 'release-extra'

with tempfile.TemporaryDirectory(prefix='px82-release-') as tmp:
    tmp = Path(tmp)
    kernel = tmp / 'kernel.elf'
    kernel.write_bytes(b'fixture kernel, not bootable\n')
    commit = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip()
    release = tmp / 'pax-release'
    env = dict(os.environ, SOURCE_DATE_EPOCH='1234567890')
    subprocess.run([str(ROOT / 'tools/mkpax-release'), str(kernel), str(release)], env=env, check=True)
    check(release, kernel, commit, 1234567890)
    first = release.read_bytes()
    subprocess.run([str(ROOT / 'tools/mkpax-release'), str(kernel), str(release)], env=env, check=True)
    assert first == release.read_bytes(), 'release-reproducible'
    banner = release.with_name('pax-banner').read_text()
    assert banner == f'PAX: kernel {commit}; release {sha(first)[:8]}\n', 'release-banner'
    print('R0 PASS release matches every pin, kernel, epoch and banner; reproducible')
    lines = release.read_text().splitlines()
    lines = ['yew ' + '0' * 40 + ' ' + line.split()[2] if line.startswith('yew ') else line for line in lines]
    release.write_text('\n'.join(lines) + '\n')
    try:
        check(release, kernel, commit, 1234567890)
    except AssertionError as error:
        assert str(error) == 'release-yew', error
        print('R1 PASS release-yew rejects a commit other than the image pin')
    else:
        raise AssertionError('release-yew accepted the planted mismatch')
    release.write_bytes(first)
    kernel.write_bytes(b'changed kernel\n')
    try:
        check(release, kernel, commit, 1234567890)
    except AssertionError as error:
        assert str(error) == 'release-kernel', error
        print('R2 PASS release-kernel rejects changed ELF bytes')
    else:
        raise AssertionError('release-kernel accepted changed ELF bytes')

# Exercise the production archive codec without the historical dev payload.
import runpy
codec = runpy.run_path(str(ROOT / 'tools/distribution-root'))
with tempfile.TemporaryDirectory(prefix='px82-cpio-') as tmp:
    path = Path(tmp) / 'fixture.cpio'
    records = {'bin': (0o40755, 0, 0, b''),
               'bin/check': (0o100755, 1000, 1000, b'fixture bytes\n'),
               'bin/link': (0o120777, 0, 0, b'check'),
               'tmp': (0o41777, 0, 0, b'')}
    codec['write_cpio'](records, path)
    assert codec['read_cpio'](path.read_bytes()) == records, 'distribution-newc-roundtrip'
    try:
        codec['read_cpio'](path.read_bytes()[:-80])
    except (AssertionError, ValueError):
        pass
    else:
        raise AssertionError('distribution-newc-short-archive-accepted')
    print('R3 PASS distribution archive modes, owners, links, bytes and truncation refusal')
