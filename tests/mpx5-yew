#!/usr/bin/env bash
# tests/mpx5-yew — px58: yew, the modal terminal editor in wolf
# (user/yew.pin, tools/mkyew), on PAX's console: what it asks of the
# terminal, asked by a probe (user/termwolf), and the editor itself typed
# a session as `pax`. Every row is held to the same static binaries on a
# Linux pseudo-terminal in a throwaway container (tools/linux-tree), run
# live, except where the gap table (notes/px58-yew-on-pax.md §D) names
# PAX's answer: those rows hold PAX to that answer.
#
#   tests/mpx5-yew [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                  [--firmware bios|uefi|both] [--tier native|release|both]
#
# Two images, kmain_console with the archive:
#   probe    /bin/termwolf, /bin/as; its run list: `/bin/termwolf` (root),
#            `/bin/as 1000 1000 /bin/termwolf` (`pax`), `/bin/termwolf ps2`
#            (the keyboard's keys, sent by this suite through a second
#            monitor), `/bin/termwolf screen` (the escape classes, read
#            off the halted screen); typed user/console/termwolf.keys
#            (`keys> ` the prompt);
#   session  /bin/yew, pelt as /bin/sh, boreutils' env and cat, /bin/as,
#            /home/pax (0755, 1000:1000) holding notes.txt (alpha, beta,
#            gamma; 0644, 1000:1000); its run list `/bin/as 1000 1000
#            /bin/env HOME=/home/pax /bin/sh -i -m`; typed
#            user/console/yew.keys (`$ ` the prompt): `cd /home/pax`, `yew
#            notes.txt`, then each key a step of its own a pause after the
#            one before (`G` the last line, `O` a line above it, `delta`,
#            ESC, `:w`, three empty steps, `:q`), `cat notes.txt`, `exit`.
#            The empty steps outlast yew's 4 s info message ("wrote …",
#            yew's `src/edit/message.lu`) on both sides, so its expiry's
#            repaint comes before `:q` on Linux as on PAX.
#
# What is compared is the bytes the terminal showed, raw (the escapes
# are the record): each run's part of the serial log, from its `run <k>:`
# line to the kernel's `user: frames free` line after it, the kernel's
# own `user: …` lines taken out whole, CR LF kept; the container's whole
# transcript.
#
# Assertions, per tier and firmware:
#   Y0 build: kmain_console built; yew, termwolf, pelt, env, cat and as
#      static; both images; the container's runs ran.
#   Y1 the probe as root and as `pax`: every line the container's but the
#      named rows (the gap table's divergent rows), and those PAX's
#      recorded answer; its status 0.
#   Y2 the escape classes on the halted screen: (px59) the screendump
#      equals tools/screen-ref's picture of the boot's serial bytes, pixel
#      for pixel and cell for cell — screen-ref draws each class as a
#      Linux VT does, held to the VT's own cells by tests/mpx5-screen
#      (px58's row read every class but CR, LF and SGR 1 7 31 91 41 39 49
#      as dropped: px59 serves them).
#   Y3 the keyboard's keys (`termwolf ps2`): the arrows, Home, End, PgUp,
#      PgDn, Insert and Delete, (px59) the function keys, the modified
#      arrows and editing keys, Shift's and Ctrl's function keys, left
#      Alt as ESC, right Alt, and the keys the VT gives nothing for, each
#      the measured VT's bytes (notes/px59/vt2.rows).
#   Y4 the session byte-identical to the container's, yew's frames and
#      all; notes.txt reads alpha, beta, gamma, delta on both.
#   Y5 per boot: -ENOSYS only for set_robust_list (273) and rseq (334);
#      no `refused:` line; init ended, status 0; halted.
#   Y6 (px59) yew suspended and continued: user/console/yew-tstp.keys
#      (`G`, C-z — yew restores the terminal and stops itself with
#      SIGTSTP —, `jobs`, `fg` — SIGCONT: yew takes raw mode and the
#      alternate screen again and redraws —, `:q`) over COM1, the bytes
#      byte-identical to the container's; the shell's `Stopped` on both.
#   Y7 (px59) yew from the keyboard: user/console/yew.keys typed at the
#      PS/2 keyboard (tools/ps2-session through a second monitor), so the
#      window is the screen's 50 by 160 (kernel/console's `typed_at`) and
#      yew's DA1 is answered by the screen; the bytes byte-identical to
#      the container's on a pseudo-terminal of 50 by 160 (tools/linux-tty
#      --winsize), where no DA1 answer comes; notes.txt as Y4's.
#      A resize under yew is not a VT's: a VT's grid changes only with
#      its font or mode, which no program here asks; TIOCSWINSZ and
#      SIGWINCH are Y1's (served).
#
# The session's keys inside yew are `^~` steps (no prompt to wait for):
# PAX_YEW_PAUSE seconds apart on PAX (default 6: yew's start under TCG,
# measured in notes/px58), tools/linux-tty's 1.5 s in the container.
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only=
usage="usage: tests/mpx5-yew [--images DIR | --no-boot | --only build | --only linux --images DIR] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3

PKEYS=$PAX_ROOT/user/console/termwolf.keys
YKEYS=$PAX_ROOT/user/console/yew.keys
TKEYS=$PAX_ROOT/user/console/yew-tstp.keys # px59
BORE="env cat" # boreutils in the session image (user/boreutils.pin)
PRUNS=("/bin/termwolf" "/bin/as 1000 1000 /bin/termwolf" "/bin/termwolf ps2" "/bin/termwolf screen")
SRUN="/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m"
NOTES=$'alpha\nbeta\ngamma\n'
SAVED=$'alpha\nbeta\ngamma\ndelta\n'

work=$PAX_BUILD/mpx5-yew
runs=$PAX_BUILD/mpx5-yew-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The container's runs: the probe as root, as `pax` and its screen run,
# each typed its own line of the keys; the session as `pax`.
linux_side() { # dir -> reasons on stdout
    mkdir -p "$1/linux"
    local k a0 name keys
    for k in 0 1 3; do
        # shellcheck disable=SC2086 # the run line's words, as the kernel splits them
        set -- "$1" ${PRUNS[$k]}
        a0=$2 name=probe-$k keys=$1/linux/$name.keys
        if [ "$k" = 3 ]; then : > "$keys"; else sed -n "$((k == 0 ? 1 : 2))p" "$PKEYS" > "$keys"; fi
        if "$PAX_ROOT/tools/linux-tree" --root "$1/probe" --keys "$keys" --prompt 'keys> ' --argv0 "$a0" --size 64m --rdev --nsproc \
            "$1/linux/$name.tty" -- "${@:2}"; then
            say "  linux $name: $(wc -c < "$1/linux/$name.tty" | tr -d ' ') bytes, status $(cat "$1/linux/$name.tty.rc")"
        else
            printf ' tools/linux-tree %s;' "$name"
        fi
    done
    # shellcheck disable=SC2086
    set -- "$1" $SRUN
    if "$PAX_ROOT/tools/linux-tree" --root "$1/session" --keys "$YKEYS" --prompt '$ ' --argv0 "$2" --size 128m --rdev --nsproc \
        --owners "$1/owners" "$1/linux/session.tty" -- "${@:2}"; then
        say "  linux session: $(wc -c < "$1/linux/session.tty" | tr -d ' ') bytes, status $(cat "$1/linux/session.tty.rc")"
    else
        printf ' tools/linux-tree session;'
    fi
    # px59: Y6's keys, and Y4's at the screen's 50 by 160 (Y7)
    if "$PAX_ROOT/tools/linux-tree" --root "$1/session" --keys "$TKEYS" --prompt '$ ' --argv0 "$2" --size 128m --rdev --nsproc \
        --owners "$1/owners" "$1/linux/session-tstp.tty" -- "${@:2}"; then
        say "  linux session-tstp: $(wc -c < "$1/linux/session-tstp.tty" | tr -d ' ') bytes, status $(cat "$1/linux/session-tstp.tty.rc")"
    else
        printf ' tools/linux-tree session-tstp;'
    fi
    if "$PAX_ROOT/tools/linux-tree" --root "$1/session" --keys "$YKEYS" --prompt '$ ' --argv0 "$2" --size 128m --rdev --nsproc \
        --winsize 50x160 --owners "$1/owners" "$1/linux/session-kbd.tty" -- "${@:2}"; then
        say "  linux session-kbd: $(wc -c < "$1/linux/session-kbd.tty" | tr -d ' ') bytes, status $(cat "$1/linux/session-kbd.tty.rc")"
    else
        printf ' tools/linux-tree session-kbd;'
    fi
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS Y0 (linux): the Linux side ran in a throwaway container" || bad "Y0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    p=$work/probe s=$work/session
    mkdir -p "$p/bin" "$s/bin" "$s/home/pax" "$work/bin"
    why=
    "$PAX_ROOT/tools/mkyew" "$work/yew" > "$work/yew.txt" || why+=" tools/mkyew;"
    "$PAX_ROOT/user/termwolf/build" "$work/termwolf" > "$work/termwolf.txt" || why+=" user/termwolf/build;"
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" || why+=" tools/mkpelt;"
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE > "$work/bore.txt" || why+=" tools/mkboreutils;"
    "$PAX_ROOT/tools/mkas" "$work/bin" > "$work/as.txt" || why+=" tools/mkas;"
    cp "$work/termwolf/termwolf" "$p/bin/termwolf" 2>/dev/null || why+=" no termwolf;"
    cp "$work/bin/as" "$p/bin/as" 2>/dev/null || why+=" no as;"
    cp "$work/yew/yew" "$s/bin/yew" 2>/dev/null || why+=" no yew;"
    cp "$work/pelt/pelt" "$s/bin/sh" 2>/dev/null || why+=" no pelt;"
    for u in $BORE; do cp "$work/bore/$u" "$s/bin/$u" 2>/dev/null || why+=" no $u;"; done
    cp "$work/bin/as" "$s/bin/as" 2>/dev/null || why+=" no as;"
    for f in "$p"/bin/* "$s"/bin/*; do
        x=$(static_ok "$f") || why+=" $x;"
    done
    for f in "$p"/bin/* "$s"/bin/*; do
        say "  program: ${f#"$work"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    printf '%s' "$NOTES" > "$s/home/pax/notes.txt"
    printf '%s\n' "${PRUNS[@]}" > "$p/pax-run"
    printf '%s\n' "$SRUN" > "$s/pax-run"
    printf '%s\n' '/home/pax 755 1000 1000' '/home/pax/notes.txt 644 1000 1000' > "$work/owners"
    args=(/etc/pax-run="$p/pax-run":644)
    for f in "$p"/bin/*; do args+=("/bin/${f##*/}=$f:755"); done
    "$PAX_ROOT/tools/mkinitramfs" "$work/probe.cpio" "${args[@]}" > "$work/probe.initramfs.txt" || why+=" tools/mkinitramfs probe;"
    args=(/home/pax/:755:1000:1000 /home/pax/notes.txt="$s/home/pax/notes.txt":644:1000:1000 /etc/pax-run="$s/pax-run":644)
    for f in "$s"/bin/*; do args+=("/bin/${f##*/}=$f:755"); done
    "$PAX_ROOT/tools/mkinitramfs" "$work/session.cpio" "${args[@]}" > "$work/session.initramfs.txt" || why+=" tools/mkinitramfs session;"
    # The container's trees are the archives' (the run list kept out).
    rm -f "$p/pax-run" "$s/pax-run"
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            for img in probe session; do
                "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                    --add "$work/$img.cpio" initramfs.cpio "$elf" "$work/$tier/$img.iso" >/dev/null || why+=" $tier: mkimage $img;"
                say "built $tier $img: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/$img.iso"), initramfs $(sha256_of "$work/$img.cpio")"
            done
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS Y0 (build): kmain_console built ($tiers), every program static, both images built" || bad "Y0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS Y0: kmain_console built ($tiers), every program static, both images built, the Linux side ran in a throwaway container" || bad "Y0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx5-yew build (Y0): PASS (no boot: --no-boot)" || say "mpx5-yew build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux
for n in probe-0 probe-1 probe-3 session session-tstp session-kbd; do
    [ -f "$lx/$n.tty" ] || bad "Y0 linux $n: no $lx/$n.tty (build first, and run the Linux side)"
done

# Run k's raw bytes: from the line after `run <k>: …` to the kernel's
# `user: frames free` line after it, every kernel line (`user: …` to its
# CR LF, wherever it starts) taken out. Python, for the bytes.
run_raw() { # serial k out
    python3 - "$1" "$2" "$3" <<'PY'
import re, sys
log = open(sys.argv[1], "rb").read()
k = sys.argv[2].encode()
m = re.search(rb"(?m)^run " + k + rb": [^\n]*\n", log)
if not m:
    open(sys.argv[3], "wb").write(b"")
    sys.exit(0)
rest = log[m.end():]
e = re.search(rb"user: frames free", rest)
part = rest[:e.start()] if e else rest
part = re.sub(rb"user: [^\r\n]*\r?\n", b"", part)
open(sys.argv[3], "wb").write(part)
PY
}

# The probe's rows, PAX's against the container's: every record equal
# but the named ones, and those PAX's answer. A record is a line with its
# CR, but an O row, which runs to its `|` (its bytes cross lines).
probe_rows() { # pax linux who -> reasons on stdout
    python3 - "$1" "$2" "$3" <<'PY'
import sys
def records(path):
    out, cur = [], None
    for l in open(path, "rb").read().split(b"\n"):
        if cur is not None:
            cur += b"\n" + l
            if l.endswith(b"|\r"):
                out.append(cur)
                cur = None
            continue
        if l.startswith(b"O: ") and not l.endswith(b"|\r"):
            cur = l
            continue
        out.append(l)
    if cur is not None:
        out.append(cur)
    return out
pax, lin, who = records(sys.argv[1]), records(sys.argv[2]), sys.argv[3]
# The gap table's divergent rows (notes/px58-yew-on-pax.md §D): a record
# that starts so is PAX's own answer, not Linux's pseudo-terminal's.
named = {
    b"B: cflag kept:": b"B: cflag kept: CS6 CS7 CSTOPB CREAD PARENB PARODD HUPCL CLOCAL CMSPAR CRTSCTS\r",
    b"B: cflag not kept:": b"B: cflag not kept: none\r",
    b"O: OCRNL set:": b"O: OCRNL set: ab\r\ncd\r|\r",
    b"O: OLCUC set:": b"O: OLCUC set: ab\r\ncd\r|\r",
}
if who == "root":
    # Before any key, PAX's console is its screen's grid (px19, pax#68).
    named[b"W: before anything is typed:"] = b"W: before anything is typed: TIOCGWINSZ 0, 50 rows 160 columns; os_term_size 50 160\r"
    named[b"W: set back:"] = b"W: set back: 0; reads back 50 by 160; SIGWINCH: true\r"
def tag(recs):
    return [(next((k for k in named if r.startswith(k)), None), r) for r in recs]
p, q = tag(pax), tag(lin)
why = []
pp = [r for k, r in p if k is None]
qq = [r for k, r in q if k is None]
if pp != qq:
    for i, (a, b) in enumerate(zip(pp, qq)):
        if a != b:
            why.append(" %s: record %d differs: PAX %r, Linux %r;" % (who, i + 1, a[:120], b[:120]))
            break
    else:
        why.append(" %s: %d records on PAX, %d on Linux (outside the named rows);" % (who, len(pp), len(qq)))
for k, want in named.items():
    got = [r for kk, r in p if kk == k]
    if got != [want]:
        why.append(" %s: %r is %r, not PAX's recorded %r;" % (who, k.decode(), got, want))
if b"termwolf: done\r" not in pax:
    why.append(" %s: no 'termwolf: done';" % who)
print("".join(why), end="")
PY
}

# The keyboard's keys (Y3): this suite's second monitor sends them once
# `ps2> ` is on the serial log: the arrows, Home, End, PgUp, PgDn,
# Insert, Delete (px58), then (px59) F1-F12, modified arrows and editing
# keys, Shift's and Ctrl's function keys, left Alt with a key, right Alt
# with an arrow, five keys the VT gives nothing for (Shift+PgUp, Alt+Left,
# Alt+F1, Shift+Ctrl+F1, Alt+Shift+a), then `.`. Each key's bytes are the
# VT's own, measured twice (notes/px59/vt.rows, vt2.rows).
PS2_TABLE="up:1b5b41 down:1b5b42 right:1b5b43 left:1b5b44 home:1b5b317e end:1b5b347e pgup:1b5b357e pgdn:1b5b367e
insert:1b5b327e delete:1b5b337e
f1:1b5b5b41 f2:1b5b5b42 f3:1b5b5b43 f4:1b5b5b44 f5:1b5b5b45 f6:1b5b31377e f7:1b5b31387e f8:1b5b31397e
f9:1b5b32307e f10:1b5b32317e f11:1b5b32337e f12:1b5b32347e
shift-up:1b5b313b3241 ctrl-down:1b5b313b3542 alt-up:1b5b313b3341 shift-ctrl-left:1b5b313b3644
shift-alt-up:1b5b313b3441 ctrl-alt-down:1b5b313b3742 shift-ctrl-alt-left:1b5b313b3844 ctrl-alt-right:1b5b313b3743
shift-home:1b5b317e ctrl-delete:1b5b337e alt-pgup:1b5b357e
shift-f1:1b5b32337e shift-f10:1b5b33347e shift-f12:1b5b32347e ctrl-f5:1b5b5b45
alt-a:1b61 alt-z:1b7a ctrl-alt-a:1b01 alt-1:1b31 alt-backspace:1b7f alt-esc:1b1b alt-slash:1b2f
alt_r-up:1b5b41
shift-pgup: alt-left: alt-f1: shift-ctrl-f1: alt-shift-a:
dot:2e"
PS2_KEYS=$(for kv in $PS2_TABLE; do printf '%s ' "${kv%%:*}"; done)
PS2_WANT=$(for kv in $PS2_TABLE; do printf '%s' "${kv#*:}"; done | sed 's/../& /g; s/ $//')
ps2_sender() { # serial socket -> sends the keys when `ps2> ` shows
    python3 - "$1" "$2" "$PS2_KEYS" <<'PY' &
import os, socket, sys, time
serial, sock, keys = sys.argv[1], sys.argv[2], sys.argv[3].split()
end = time.time() + 1500
while time.time() < end:
    try:
        if b"ps2> " in open(serial, "rb").read():
            break
    except OSError:
        pass
    time.sleep(0.2)
else:
    sys.exit(1)
time.sleep(1)
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock)
s.settimeout(5)
def cmd(c):
    s.sendall((c + "\n").encode())
    time.sleep(0.3)
    try:
        s.recv(65536)
    except OSError:
        pass
cmd("")
for k in keys:
    cmd("sendkey " + k)
s.close()
PY
}

record() { # tier leg image status
    ran=$((ran + 1))
    printf '%s kmain_console %s %s halt-status=%s accel=%s serial=%s iso=%s\n' "$1" "$2" "$3" "$4" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" "$(sha256_of "$iso")" >> "$runs"
}

# Y5: what PAX lacks; nothing refused; the end.
ends() { # norm init -> reasons on stdout
    local ns rf why=
    ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$1" | sort -un | paste -sd' ' -)
    [ "$ns" = "273 334" ] || why+=" -ENOSYS for '$ns', not '273 334';"
    rf=$(grep -c ': refused: ' "$1")
    [ "$rf" = 0 ] || why+=" $rf refused lines ($(grep -m1 ': refused: ' "$1" | cut -c1-160));"
    grep -qx "PAX: init $2 ended with status 0; nothing left to run" "$1" \
        || why+=" no 'PAX: init $2 ended with status 0' ($(grep -m1 '^PAX: init ' "$1"));"
    grep -q '^PANIC ' "$1" && why+=" the kernel panicked: $(grep -m1 '^PANIC ' "$1");"
    printf '%s' "$why"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        elf=$images/$tier/kmain_console.elf
        # The probe.
        id="$tier $leg probe"
        iso=$images/$tier/probe.iso
        log=$PAX_BUILD/mpx5-yew-$tier-$leg-probe.serial.log
        dump=$PAX_BUILD/mpx5-yew-$tier-$leg-probe.ppm
        sock=$PAX_BUILD/mpx5-yew-$tier-$leg.mon2
        rm -f "$log" "$log.verdict" "$dump" "$sock"
        if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
            bad "Y5 $id: no image"
        else
            ps2_sender "$log" "$sock"
            spid=$!
            hrc=0
            "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 900 --qemu -m --qemu 512M \
                --qemu -monitor --qemu "unix:$sock,server=on,wait=off" \
                --elf "$elf" --marker 'halt|PANIC .*' --type "$PKEYS" --prompt 'keys> ' \
                --cmd "screendump $dump" "$iso" >"$log.verdict" 2>&1 || hrc=$?
            wait "$spid" || bad "Y3 $id: the keys were never sent (no 'ps2> ' on the serial log)"
            record "$tier" "$leg" probe "$hrc"
            norm=$log.norm; serial_norm "$log" > "$norm"
            for k in 0 1; do
                who=$([ "$k" = 0 ] && echo root || echo pax)
                out=$PAX_BUILD/mpx5-yew-$tier-$leg-probe-$k.raw
                run_raw "$log" $((k + 1)) "$out"
                why=$(probe_rows "$out" "$lx/probe-$k.tty" "$who")
                [ -z "$why" ] && say "PASS Y1 $id $who: $(wc -l < "$out" | tr -d ' ') lines, the container's but the gap table's named rows, which are PAX's recorded answers" \
                    || bad "Y1 $id $who:$why"
            done
            out=$PAX_BUILD/mpx5-yew-$tier-$leg-probe-2.raw
            run_raw "$log" 3 "$out"
            got=$(sed -n 's/^P: typed: //p' "$out" | tr -d '\r')
            [ "$got" = "$PS2_WANT" ] && say "PASS Y3 $id: the keyboard's $(echo $PS2_KEYS | wc -w | tr -d ' ') keys give the measured VT's bytes ($(echo $PS2_WANT | wc -w | tr -d ' ')): the cursor and editing keys, F1-F12, the modifiers, Alt" \
                || bad "Y3 $id: typed '$got', not '$PS2_WANT'"
            out=$PAX_BUILD/mpx5-yew-$tier-$leg-probe-3.raw
            run_raw "$log" 4 "$out"
            cmp -s "$out" "$lx/probe-3.tty" && say "PASS Y1 $id screen: the escape classes' bytes are the container's ($(wc -c < "$out" | tr -d ' ') bytes)" \
                || bad "Y1 $id screen: the bytes differ from the container's"
            if [ -f "$dump" ]; then
                size=$(python3 -c 'import sys; d=open(sys.argv[1],"rb").read(64).split(); print("%sx%s" % (d[1].decode(), d[2].decode()))' "$dump")
                if r=$(python3 "$PAX_ROOT/tools/screen-ref" --from 'PAX: the console' --size "$size" --compare "$dump" "$log" 2>&1); then
                    say "PASS Y2 $id: the halted screen, termwolf's escape classes last, is screen-ref's picture of the boot's bytes: $(printf '%s\n' "$r" | sed -n 's/^screen-ref: IDENTICAL: .* equals the reference, //p')"
                else
                    bad "Y2 $id: $(printf '%s' "$r" | tail -n 1)"
                fi
            else
                bad "Y2 $id: no screendump"
            fi
            why=$(ends "$norm" /bin/termwolf)
            [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
            [ -z "$why" ] && say "PASS Y5 $id: -ENOSYS only for 273 and 334; nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "Y5 $id:$why"
        fi
        # The session.
        id="$tier $leg session"
        iso=$images/$tier/session.iso
        log=$PAX_BUILD/mpx5-yew-$tier-$leg-session.serial.log
        rm -f "$log" "$log.verdict"
        if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
            bad "Y5 $id: no image"
            continue
        fi
        hrc=0
        # The halted screen is kept (no row reads it: yew's frames on PAX's
        # screen, CUP and the alternate screen dropped; px59's to serve).
        PAX_TYPE_PAUSE=${PAX_YEW_PAUSE:-6} "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 1200 --qemu -m --qemu 512M \
            --elf "$elf" --marker 'halt|PANIC .*' --type "$YKEYS" --prompt '$ ' \
            --cmd "screendump $PAX_BUILD/mpx5-yew-$tier-$leg-session.ppm" "$iso" >"$log.verdict" 2>&1 || hrc=$?
        record "$tier" "$leg" session "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        out=$PAX_BUILD/mpx5-yew-$tier-$leg-session.raw
        run_raw "$log" 1 "$out"
        why=
        if [ -f "$lx/session.tty" ]; then
            cmp -s "$lx/session.tty" "$out" || why+=" the session's bytes differ from the container's at byte $(cmp "$lx/session.tty" "$out" 2>&1 | sed -n 's/.*byte \([0-9]*\).*/\1/p');"
        else
            why+=" no container session;"
        fi
        [ "$(wc -c < "$out" | tr -d ' ')" -gt 2000 ] || why+=" a short session;"
        [ -z "$why" ] && say "PASS Y4 $id: $(wc -c < "$out" | tr -d ' ') bytes byte-identical to the container's, yew's frames and all ($(sha256_of "$out" | cut -c1-12)…)" || bad "Y4 $id:$why"
        why=
        for f in "$out" "$lx/session.tty"; do
            tr -d '\r' < "$f" | command grep -aq -x -F 'delta' || why+=" no 'delta' line in ${f##*/};"
            python3 -c '
import sys
d = open(sys.argv[1], "rb").read().replace(b"\r", b"")
want = b"$ cat notes.txt\nalpha\nbeta\ngamma\ndelta\n"
sys.exit(0 if want in d else 1)' "$f" || why+=" ${f##*/}: cat notes.txt is not alpha beta gamma delta;"
        done
        [ -z "$why" ] && say "PASS Y4 $id: notes.txt saved by yew reads alpha, beta, gamma, delta on PAX and Linux" || bad "Y4 $id:$why"
        why=$(ends "$norm" /bin/as)
        [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
        [ -z "$why" ] && say "PASS Y5 $id: -ENOSYS only for 273 and 334; nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "Y5 $id:$why"

        # px59: Y6, yew suspended and continued, over COM1.
        id="$tier $leg session-tstp"
        log=$PAX_BUILD/mpx5-yew-$tier-$leg-session-tstp.serial.log
        rm -f "$log" "$log.verdict"
        hrc=0
        PAX_TYPE_PAUSE=${PAX_YEW_PAUSE:-6} "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 1200 --qemu -m --qemu 512M \
            --elf "$elf" --marker 'halt|PANIC .*' --type "$TKEYS" --prompt '$ ' "$iso" >"$log.verdict" 2>&1 || hrc=$?
        record "$tier" "$leg" session-tstp "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        out=$PAX_BUILD/mpx5-yew-$tier-$leg-session-tstp.raw
        run_raw "$log" 1 "$out"
        why=
        cmp -s "$lx/session-tstp.tty" "$out" || why+=" the bytes differ from the container's at byte $(cmp "$lx/session-tstp.tty" "$out" 2>&1 | sed -n 's/.*byte \([0-9]*\).*/\1/p');"
        for f in "$out" "$lx/session-tstp.tty"; do
            tr -d '\r' < "$f" | command grep -aq 'Stopped' || why+=" no 'Stopped' in ${f##*/};"
        done
        why+=$(ends "$norm" /bin/as)
        [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
        [ -z "$why" ] && say "PASS Y6 $id: C-z stops yew, fg continues it; $(wc -c < "$out" | tr -d ' ') bytes byte-identical to the container's ($(sha256_of "$out" | cut -c1-12)…), 'Stopped' on both; Y5's ends" || bad "Y6 $id:$why"

        # px59: Y7, the session typed at the keyboard, the screen's 50 by 160.
        id="$tier $leg session-kbd"
        log=$PAX_BUILD/mpx5-yew-$tier-$leg-session-kbd.serial.log
        sock=$PAX_BUILD/mpx5-yew-$tier-$leg-kbd.mon2
        rm -f "$log" "$log.verdict" "$sock"
        hrc=0 krc=0
        PAX_TYPE_PAUSE=${PAX_YEW_PAUSE:-6} python3 "$PAX_ROOT/tools/ps2-session" --serial "$log" --monitor "$sock" --keys "$YKEYS" --prompt '$ ' \
            --out "$PAX_BUILD/mpx5-yew-$tier-$leg-session-kbd" --timeout 600 > "$log.keys" 2>&1 &
        kp=$!
        "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 1200 --qemu -m --qemu 512M \
            --qemu -monitor --qemu "unix:$sock,server=on,wait=off" \
            --elf "$elf" --marker 'halt|PANIC .*' --cmd "screendump $PAX_BUILD/mpx5-yew-$tier-$leg-session-kbd.ppm" "$iso" >"$log.verdict" 2>&1 || hrc=$?
        wait "$kp" || krc=$?
        record "$tier" "$leg" session-kbd "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        out=$PAX_BUILD/mpx5-yew-$tier-$leg-session-kbd.raw
        run_raw "$log" 1 "$out"
        why=
        [ "$krc" = 0 ] || why+=" the keys: $(tail -n 1 "$log.keys");"
        cmp -s "$lx/session-kbd.tty" "$out" || why+=" the bytes differ from the container's at byte $(cmp "$lx/session-kbd.tty" "$out" 2>&1 | sed -n 's/.*byte \([0-9]*\).*/\1/p');"
        python3 -c '
import sys
d = open(sys.argv[1], "rb").read().replace(b"\r", b"")
sys.exit(0 if b"$ cat notes.txt\nalpha\nbeta\ngamma\ndelta\n" in d else 1)' "$out" || why+=" cat notes.txt is not alpha beta gamma delta;"
        why+=$(ends "$norm" /bin/as)
        [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
        [ -z "$why" ] && say "PASS Y7 $id: typed at the PS/2 keyboard, 50 by 160; $(wc -c < "$out" | tr -d ' ') bytes byte-identical to the container's at 50 by 160 ($(sha256_of "$out" | cut -c1-12)…); notes.txt alpha beta gamma delta; Y5's ends" || bad "Y7 $id:$why"
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx5-yew: PASS" || say "mpx5-yew: FAIL"
exit "$fail"
