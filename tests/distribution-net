#!/usr/bin/env bash
# px105: the networked console's stick leg. The actual release and dev
# ISOs (tools/mkdistribution's) booted on QEMU's igb, the 82576 that
# kernel/gbe drives on the I225's programming model, with QEMU's DHCP
# server, both firmwares. Before the prompt the console takes its lease
# (/etc/pax-net, user/pax-net's `dhcp wait=10`) and says so; then
# user/console/distribution-net.keys types the witness a person reads at
# the metal target's console: /etc/pax-net, the lease file kernel/dhcp
# writes and /etc/resolv.conf.
#
# px127: on the dev ISO the same boot then dials names from a program
# built on the box (tests/distribution-net.d/names.py's rows N2-N4): the
# console names the router, 10.0.2.2, as its only nameserver, as an
# installed system's /etc/resolv.conf does, and QEMU hands 10.0.2.2:53 to
# this host's 127.0.0.1:53, where tools/dns-fixture answers (root, or
# sudo -n, binds it; without either the rows are SKIPPED LOUDLY, a
# failure under PAX_REQUIRE_NAMES_FIXTURE=1), and 10.0.2.2:PORT to a
# listener of this suite's own on an ephemeral port;
# user/console/distribution-names.keys types the program, builds it with
# `wolf build` and dials through DNS and through /etc/hosts. VARIANT
# limits the boots to `release` or `dev` (both by default).
#   tests/distribution-net IMAGE_DIRECTORY [VARIANT...]
set -euo pipefail
. "$(dirname "$0")/../tools/lib.sh"
[ $# -ge 1 ] || die 'usage: distribution-net IMAGE_DIRECTORY [VARIANT...]'
out=$(realpath "$1")
shift
variants=${*:-release dev}
for v in $variants; do case $v in release|dev) ;; *) die "variant $v: release or dev" ;; esac; done
head=$(cat "$out/commit")
MAC=52:54:00:12:34:56
fail=0
# px127: the DNS fixture binds port 53.
names_why=
if [ "$(id -u)" != 0 ] && ! sudo -n true 2>/dev/null; then
    names_why='the DNS fixture binds 127.0.0.1:53: root, or sudo -n'
fi
names_start() { # DIR: the DNS fixture and the listener, each held by a pipe; PORT is set
    local d=$1 pre=()
    rm -rf "$d" && mkdir -p "$d"
    mkfifo "$d/dns.hold" "$d/listen.hold"
    [ "$(id -u)" = 0 ] || pre=(sudo -n --preserve-env=PATH)
    "${pre[@]}" python3 -I "$PAX_ROOT/tools/dns-fixture" --bind 127.0.0.1:53 --log "$d/dns.log" --deadline 1800 \
        github.com=10.0.2.2 < "$d/dns.hold" > "$d/dns.out" 2>&1 &
    dns_pid=$!
    exec 8> "$d/dns.hold"
    python3 -I -c '
import select, socket, sys, time
s = socket.socket()
s.bind(("127.0.0.1", 0)); s.listen(16)
print("PORT %d" % s.getsockname()[1], flush=True)
while True:
    r, _, _ = select.select([s, sys.stdin], [], [], 1800)
    if not r or sys.stdin in r:
        break
    c, a = s.accept()
    print("ACCEPT %.3f %s:%d" % (time.time(), a[0], a[1]), flush=True)
    c.close()
' < "$d/listen.hold" > "$d/listen.log" 2>&1 &
    listen_pid=$!
    exec 9> "$d/listen.hold"
    local k
    for k in $(seq 100); do
        grep -q LISTENING "$d/dns.out" 2>/dev/null && grep -q '^PORT ' "$d/listen.log" 2>/dev/null && break
        sleep 0.1
    done
    grep -q LISTENING "$d/dns.out" || { cat "$d/dns.out" >&2; return 1; }
    PORT=$(sed -n 's/^PORT //p' "$d/listen.log")
    [ -n "$PORT" ]
}
names_stop() {
    exec 8>&- 9>&-
    wait "$dns_pid" "$listen_pid" 2>/dev/null || true
}
for variant in $variants; do
    name=pax-${head:0:8}.iso
    [ "$variant" = dev ] && name=pax-dev-${head:0:8}.iso
    for firmware in bios uefi; do
        log=$out/$variant-$firmware-net.serial.log
        keys=$PAX_ROOT/user/console/distribution-net.keys
        names=0
        if [ "$variant" = dev ]; then
            if [ -n "$names_why" ]; then
                if [ "${PAX_REQUIRE_NAMES_FIXTURE:-0}" = 1 ]; then
                    say "FAIL N2 dev-$firmware: $names_why, and PAX_REQUIRE_NAMES_FIXTURE=1"; fail=1
                else
                    say "SKIPPED LOUDLY N2-N4 dev-$firmware: $names_why"
                fi
            else
                nd=$out/dev-$firmware-names
                names_start "$nd" || die "dev-$firmware: the DNS fixture or the listener did not start"
                keys=$nd/session.keys
                grep -v '^exit 0$' "$PAX_ROOT/user/console/distribution-net.keys" > "$keys"
                sed "s/@PORT@/$PORT/g" "$PAX_ROOT/user/console/distribution-names.keys" >> "$keys"
                echo 'exit 0' >> "$keys"
                names=1
            fi
        fi
        hrc=0
        PAX_TYPE_PAUSE=2 "$PAX_ROOT/tools/qemu-halt" --firmware "$firmware" --serial "$log" \
            --timeout 600 --qemu -m --qemu 2048M --elf "$out/kernel/kmain_console.elf" \
            --qemu -netdev --qemu user,id=n0,ipv6=off --qemu -device --qemu "igb,netdev=n0,mac=$MAC" \
            --type "$keys" --prompt '$ ' --marker 'halt|PANIC .*' \
            "$out/$name" > "$out/$variant-$firmware-net.halt.log" 2>&1 || hrc=$?
        if [ "$names" = 1 ]; then
            names_stop
            python3 -I "$PAX_ROOT/tests/distribution-net.d/names.py" "$log" "$nd/dns.log" "$nd/listen.log" "$PORT" \
                "dev-$firmware" || fail=1
        fi
        [ "$hrc" = 0 ] || { tail -n 3 "$out/$variant-$firmware-net.halt.log" >&2; die "$variant-$firmware: qemu-halt exit $hrc"; }
        python3 -I - "$log" "$PAX_ROOT/user/pax-net" "$MAC" <<'PY'
from pathlib import Path
import re, sys
log, paxnet, mac = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
normal = re.sub(rb'\x1b\[[0-9;?]*[A-Za-z]', b'', log.read_bytes()).replace(b'\r', b'').decode('latin-1')
lines = normal.splitlines()
def at(pattern):
    for k, line in enumerate(lines):
        if re.search(pattern, line):
            return k
    raise AssertionError('net-row: no line ' + pattern)
first = at(r'^run 1: ')
for pattern in (r'^dhcp: started on ' + mac + r', client id 01:' + mac + r'; asking for a lease \(/etc/pax-net: dhcp, wait 10 s\)$',
                r'^dhcp: \+[0-9.]+ s bound 10\.0\.2\.15 netmask 255\.255\.255\.0 gateway 10\.0\.2\.2; /etc/resolv\.conf: nameserver 10\.0\.2\.3$',
                r'^dhcp: a lease after [0-9]+\.[0-9]+ s$',
                r"^dhcp: the router 10\.0\.2\.2 answers the kernel's echo$",
                r'^net: the console waited [0-9]+ ms for the network \(bound 25000 ms: device 12000, lease 10000, echo 3000\)$'):
    assert at(pattern) < first, 'net-row-before-prompt: ' + pattern
w = int(re.search(r'waited ([0-9]+) ms', lines[at(r'^net: the console waited ')]).group(1))
assert w <= 25000, 'net-row-bound: waited %d ms' % w
# The routine lines stay off a quiet console (R-px105-3).
assert not any(re.match(r'^dhcp: \+[0-9.]+ s (DISCOVER|OFFER|REQUEST|ACK) ', l) for l in lines), 'net-row-quiet'
b, e = at(r'^PX105-NET=begin$'), at(r'^PX105-NET=end$')
typed = lines[b:e]
want = [l for l in paxnet.read_text().splitlines()]
for l in want:
    assert l in typed, 'net-row-pax-net: ' + l
for l in ('state bound', 'address 10.0.2.15', 'netmask 255.255.255.0', 'router 10.0.2.2', 'dns 10.0.2.3', 'router-echo answered', 'nameserver 10.0.2.3'):
    assert l in typed, 'net-row-lease: ' + l
assert 'PAX: init /bin/env ended with status 0; nothing left to run' in lines, 'net-row-end'
assert 'PANIC ' not in normal
print('N1 PASS', log.name, 'the lease before the prompt (%d ms of a 25000 ms bound), the router answers, the typed witness reads /etc/pax-net, the lease and resolv.conf, clean halt' % w)
PY
    done
done
exit $fail
