# tests/mpx6-root.d/fstab (px67): the mount table the suite's archives
# carry, as a distribution's first line names `/`: partition 2, the
# root the kernel command line's `root=` mounted (its `rw` remounts it
# read-write when root= said `ro`), and a tmpfs /tmp (R-px67-1).
/dev/vda2	/	ext2	rw	0	1
tmpfs	/tmp	tmpfs	nosuid,nodev	0	0
