#!/usr/bin/env python3
# tests/mpx6-root.d/session — the probe's own lines out of a serial log
# (px67): `session pax LOG` or `session linux LOG` prints the lines
# user/elf/mounts.c wrote, carriage returns removed, every line of the
# kernel's (PAX's `user:`, `run`, `root:` …; Linux's `[    1.23] …`)
# left out, and a Linux console message that came in the middle of one of
# the probe's lines (`mount(…) = 0[    2.42] EXT4-fs (vda2): re-mounted …`,
# the probe's own newline after it: px68's ext3 guest) taken out of it.
# `session norm FILE` prints FILE with the named drifts
# folded (tests/mpx6-root's R3), so PAX's and the guest's compare:
#   - a devtmpfs, tmpfs or rootfs line's sizes and kernel defaults
#     (`size=`, `nr_inodes=`, `inode64`, `huge=`): PAX's /dev holds
#     nothing and its tmpfs is the tree's cap (kernel/files' mounts_of);
#   - mountinfo's mount ids, its parent ids and an anonymous device's
#     numbers (0:N: each kernel numbers its own);
#   - a `~` line is the kernel's to choose: left out.
import re
import sys

PREFIXES = ("table: ", "mounts: ", "/proc/mounts: ", "/etc/mtab: ", "mtab: ", "statfs ", "statvfs ", "lstat ",
            "open(", "write ", "mount(", "umount2(", "unlink(", "mkdir(", "chdir(", "calls: ", "user 1", "setresuid(",
            "dotdot: ", "end: ", "twice: ", "linger ", "reboot(", "reboot ", "~")


# A console message of Linux's that began after a line's start: the
# message and its newline (the line's own end follows it).
MIDLINE = re.compile(r"(?<=[^\n])\[ *[0-9]+\.[0-9]+\] [^\n]*\n")


def probe_lines(path):
    out = []
    try:
        raw = open(path, "rb").read()
    except OSError as e:
        # pax#241 (px78): a guest that left no log is a named failure, not a traceback
        sys.exit("FAIL the guest left no log: %s (%s)" % (path, e.strerror))
    text = raw.decode("utf-8", "replace").replace("\r", "")
    for raw in MIDLINE.sub("", text).split("\n"):
        line = raw.rstrip("\n")
        if line.startswith(PREFIXES):
            out.append(line)
    return out


OPTS = re.compile(r",(size=[0-9]+k|nr_inodes=[0-9]+|inode64|huge=[a-z]+)")


def norm(line):
    if line.startswith("~mountinfo: "):
        f = line[len("~mountinfo: "):].split(" ")
        if len(f) > 3:
            dev = f[2] if not f[2].startswith("0:") else "0:N"
            return "mountinfo: " + OPTS.sub("", " ".join([dev] + f[3:]))
        return line
    if line.startswith("~"):
        return None
    return OPTS.sub("", line)


def main(argv):
    if len(argv) == 3 and argv[1] in ("pax", "linux"):
        for l in probe_lines(argv[2]):
            print(l)
        return 0
    if len(argv) == 3 and argv[1] == "norm":
        for l in open(argv[2]).read().splitlines():
            n = norm(l)
            if n is not None:
                print(n)
        return 0
    sys.stderr.write("usage: session pax|linux LOG | session norm FILE\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
