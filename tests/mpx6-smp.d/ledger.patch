tests/mpx6-smp.d/ledger.patch: the kernel lock's ledger's hooks (px166, stage 3). tools/build-kernel --test-words applies
it to its own copy of kernel/ beside tests/mpx6-smp.d/testwords.lu; the shipped kernel is built from kernel/ as it is,
which names no ledger. tests/mpx6-smp.d/ledger-patch.py (LEDGER-PATCH) holds it to the ledger's own lines and to exact
context on kernel/ as it is; a kernel change under one of its hunks is red there before any build, and is fixed here.

diff --git a/kernel/interrupts/interrupts.lu b/kernel/interrupts/interrupts.lu
index 98e2766..23c93dd 100644
--- a/kernel/interrupts/interrupts.lu
+++ b/kernel/interrupts/interrupts.lu
@@ -439,8 +439,13 @@ export fn pax_interrupt(f: *Frame) -> *Frame {
     if user.from_user(unsafe { f as u64 }) && klock.held_here() {
         panic.fail("klock: entered from ring 3 holding it, cpu ", percpu.index())
     }
+    // px166 (stage 3, the test build alone: tests/mpx6-smp.d/ledger.patch): the lock's ledger reads the TSC before
+    // the lock and opens a hold after a fresh take, keyed by this entry (tests/mpx6-smp.d/testwords.lu).
+    let t0 = testwords.ledger_now()
     let fresh = klock.enter()
     if fresh {
+        // # Safety: the frame's address; the ledger reads its vector, number and CS words.
+        testwords.ledger_took(unsafe { f as u64 }, t0)
         sched.ambient_resume()
     }
     // px166: a test kernel's `pax.slowleave=MS` (kernel/testwords; no hold as
@@ -461,7 +466,10 @@ export fn pax_interrupt(f: *Frame) -> *Frame {
             tlb.answer()
             sync.relax()
         }
+        let t1 = testwords.ledger_now()
         if klock.enter() {
+            // # Safety: as at the first take.
+            testwords.ledger_took(unsafe { f as u64 }, t1)
             sched.ambient_resume()
         }
         testwords.held(percpu.index(), sched.self_slot(), sched.self_pid())
