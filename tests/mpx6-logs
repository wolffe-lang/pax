#!/usr/bin/env bash
# tests/mpx6-logs — the system's logs on PAX (px133): the kernel's log kept on disk by logd
# (/var/log/kern.log, across reboots, restarts, a wrapped ring and a power cut), the login
# records (utmp, wtmp, btmp) written by login, burrowd and pid 1 and read by last, lastb and
# who, and every file of /var/log held to its cap.
#
#   tests/mpx6-logs [--images DIR | --no-boot] [--firmware bios|uefi|both]
#                   [--tier native|release|both] [--accel auto|kvm|tcg]
#
# G0 builds the image's tree (build/mpx6-logs/root, files.txt as tools/mkinitramfs' arguments):
# kmain_console, the kernel every shipped image boots, with `quiet`; the installed system's run
# list (/bin/login as pid 1, user/login built by tools/mkauth with /bin/passwd and /bin/sudo);
# pelt as /bin/sh; the boreutils the rows run (env for burrowd's hook); dmesg (tools/mkdmesg); reboot
# and poweroff (tools/mkdiskprobe); lope for /etc/shrc's hook (tools/mklope); logd and last
# (tools/mklogd), /bin/lastb a link to last; burrow's three programs (tools/mkburrow,
# tools/install-burrow); /etc/pax-boot.d/burrowd and /etc/pax-boot.d/logd as the images ship
# them (user/pax-boot.d); /etc/fstab mounting the run's own ext3 volume (label px133-log) on
# /var/log, write-back, so what logd wrote is there at the next boot of the same volume, and
# the host reads it after each one. A piece the tree cannot build is named at G0 and left out,
# so the rows that need it fail by name.
#
# The rows (tests/mpx6-logs.d/rows.py's header has each), on every tier and firmware asked:
# G1 a kernel line after a reboot; G2 logd killed and started again, nothing lost or written
# twice; G3 the ring wrapped while logd was held, the loss counted; G4 power cuts, the loss
# bounded; G5 `last` (a console login, ssh logins, a dropped one, the boots) and PAX's last held
# byte for byte to util-linux's on the same wtmp; G6 lastb; G7 what a user may read; G8 the caps;
# G9 a clean end's records. tests/mpx6-logs.d/last-cases holds PAX's last and lastb to
# util-linux's on crafted files with no boot (L1).
#
# Needs root in the rig (the tap, dnsmasq) or `sudo -n`, /dev/net/tun, ip(8), dnsmasq(8),
# mke2fs and debugfs, ssh, ssh-keygen, last and lastb (util-linux): SKIPPED LOUDLY without them
# unless PAX_REQUIRE_BURROWD_RIG=1, when it is a failure. The UEFI leg needs OVMF
# (PAX_REQUIRE_UEFI=1: a failure without it). Exit 0 when every row held, 1 otherwise, 2 on a
# usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"

images= legs=both tiers=both noboot=0 accel=auto
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        --accel)    accel=$2; shift 2 ;;
        *)          die "usage: tests/mpx6-logs [--images DIR | --no-boot] [--firmware bios|uefi|both] [--tier native|release|both] [--accel auto|kvm|tcg]" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac

BORE="cat chmod dd env head id kill ls mkdir rm sleep stty sync tty uname users wc who yes"
work=$PAX_BUILD/mpx6-logs
fail=0
need python3 readelf

static_ok() {
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf" git gcc
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/bin" "$r/etc/burrowd" "$r/etc/pax-boot.d" "$r/var/log" "$r/var/run" "$r/home/pax" "$work/tools"
    why= missing=
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" 2>&1 || why+=" tools/mkpelt;"
    cp "$work/pelt/pelt" "$r/bin/pelt" 2>/dev/null && cp "$work/pelt/pelt" "$r/bin/sh" || why+=" no pelt;"
    # shellcheck disable=SC2086 # the utilities' names, one word each
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE > "$work/bore.txt" 2>&1 || why+=" tools/mkboreutils;"
    for u in $BORE; do cp "$work/bore/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"; done
    "$PAX_ROOT/tools/mkauth" "$work/auth" login passwd sudo mkshadow > "$work/auth.txt" 2>&1 || why+=" tools/mkauth;"
    for p in login passwd sudo; do cp "$work/auth/$p" "$r/bin/$p" 2>/dev/null || why+=" no $p;"; done
    cp "$PAX_ROOT/user/sudo/sudoers" "$r/etc/sudoers" 2>/dev/null || why+=" no user/sudo/sudoers;"
    cp "$work/auth/mkshadow" "$work/tools/mkshadow" 2>/dev/null || why+=" no mkshadow;"
    "$PAX_ROOT/tools/mkdmesg" "$work/dmesg" > "$work/dmesg.txt" 2>&1 || why+=" tools/mkdmesg;"
    cp "$work/dmesg/dmesg" "$r/bin/dmesg" 2>/dev/null || why+=" no dmesg;"
    # reboot and poweroff as the images ship them (tools/mkdiskprobe's reboot.S, by both names).
    "$PAX_ROOT/tools/mkdiskprobe" "$work/probe" > "$work/probe.txt" 2>&1 || why+=" tools/mkdiskprobe;"
    for p in reboot poweroff; do cp "$work/probe/reboot" "$r/bin/$p" 2>/dev/null || why+=" no $p;"; done
    # lope as the dev image has it (user/lope.pin, tools/mklope): /etc/shrc's hook runs it.
    "$PAX_ROOT/tools/mklope" "$work/lope" > "$work/lope.txt" 2>&1 || why+=" tools/mklope;"
    cp "$work/lope/lope" "$r/bin/lope" 2>/dev/null || why+=" no lope;"
    # px133: logd and last (tools/mklogd), lastb a link to last. A tree without them names them
    # missing, and the rows that need them fail by name.
    if [ -x "$PAX_ROOT/tools/mklogd" ] && "$PAX_ROOT/tools/mklogd" "$work/logd" > "$work/logd.txt" 2>&1; then
        cp "$work/logd/logd" "$r/bin/logd" && cp "$work/logd/last" "$r/bin/last" && ln -s last "$r/bin/lastb" \
            || why+=" no logd or last;"
        cp "$work/logd/last" "$work/tools/last"
    else
        missing+=" /bin/logd and /bin/last (tools/mklogd)"
    fi
    "$PAX_ROOT/tools/mkburrow" "$work/burrow" > "$work/burrow.txt" 2>&1 || why+=" tools/mkburrow;"
    "$PAX_ROOT/tools/install-burrow" "$work/burrow" "$r" >> "$work/burrow.txt" 2>&1 || why+=" tools/install-burrow;"
    [ -x "$r/bin/burrowd" ] || missing+=" /bin/burrowd"
    for f in burrowd logd; do
        if [ -f "$PAX_ROOT/user/pax-boot.d/$f" ]; then
            cp -p "$PAX_ROOT/user/pax-boot.d/$f" "$r/etc/pax-boot.d/$f"
        else
            missing+=" /etc/pax-boot.d/$f (no user/pax-boot.d/$f)"
        fi
    done
    python3 -I "$PAX_ROOT/tools/system-env" shrc dev > "$r/etc/shrc" || why+=" tools/system-env shrc;"
    python3 -I "$PAX_ROOT/tools/system-env" burrowd-config "$r/etc/shrc" > "$work/burrowd_config" \
        || why+=" tools/system-env burrowd-config;"
    printf 'root:x:0:0:root:/root:/bin/sh\npax:x:1000:1000:pax:/home/pax:/bin/sh\nlobo:x:990:990:lobo:/srv/lobo:/bin/false\nburrowd:x:989:989:burrowd:/nonexistent:/bin/false\n' > "$r/etc/passwd"
    printf 'root:x:0:\npax:x:1000:\nlobo:x:990:\nburrowd:x:989:\nsudo:x:27:pax\n' > "$r/etc/group"
    printf 'LABEL=px133-log /var/log ext2 defaults 0 0\n' > "$r/etc/fstab"
    printf '/bin/login\n' > "$r/etc/pax-run"
    printf 'dhcp wait=10\n' > "$r/etc/pax-net"
    printf 'pax\n' > "$r/etc/hostname"
    "$PAX_ROOT/tools/mkzone" "$r/etc/localtime" > "$work/zone.txt" 2>&1 || why+=" tools/mkzone;"
    # The rows' own scripts (tests/mpx6-logs.d/guest), root's, never in a shipped image.
    mkdir -p "$r/root/rows"
    for f in "$here"/mpx6-logs.d/guest/*.sh; do cp "$f" "$r/root/rows/" || why+=" no ${f##*/};"; done
    : > "$work/files.txt"
    printf '%s\n' /tmp/:1777 /root/:700 /root/rows/:700 /run/:755 /home/:755 /home/pax/:755:1000:1000 /var/:755 \
        /var/log/:755 /var/run/:755 /etc/burrowd/:755 /etc/pax-boot.d/:755 >> "$work/files.txt"
    (cd "$r" && find . -mindepth 1 \( -type f -o -type l \) | sort) | while IFS= read -r f; do
        f=${f#./}
        if [ -L "$r/$f" ]; then
            printf '/%s->%s\n' "$f" "$(readlink "$r/$f")"
        else
            m=644; [ -x "$r/$f" ] && m=755
            printf '/%s=%s:%s\n' "$f" "$r/$f" "$m"
        fi
    done >> "$work/files.txt"
    sed -i -e 's#^\(/bin/sudo=.*\):755$#\1:4755#' -e 's#^\(/etc/sudoers=.*\):644$#\1:440#' "$work/files.txt"
    for f in "$r"/bin/*; do
        [ -L "$f" ] && { say "  program: ${f#"$r"/} -> $(readlink "$f")"; continue; }
        case $(head -c 2 "$f") in '#!') say "  script: ${f#"$r"/} $(sha256_of "$f")"; continue ;; esac
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    for f in etc/pax-boot.d/burrowd etc/pax-boot.d/logd; do
        [ -f "$r/$f" ] && say "  file: /$f $(sha256_of "$r/$f") $(wc -c < "$r/$f" | tr -d ' ') bytes"
    done
    git -C "$PAX_ROOT" rev-parse HEAD > "$work/tree.commit" 2>/dev/null || true
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            [ "$elf" = "$work/$tier/kmain_console.elf" ] || cp "$elf" "$work/$tier/kmain_console.elf"
            say "built $tier kmain_console: elf $(sha256_of "$elf"), $(wc -c < "$elf" | tr -d ' ') bytes"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    printf '%s\n' "${missing# }" > "$work/missing.txt"
    if [ -n "$missing" ]; then
        say "G0 the tree builds no$missing: left out of the image; the rows that need them fail by name"
    fi
    if [ -n "$why" ]; then
        say "FAIL G0 build:$why"
        exit 1
    fi
    say "G0 PASS build: kmain_console, the image's programs static, the image's tree (build/mpx6-logs/files.txt)"
    images=$work
fi
[ "$noboot" = 1 ] && exit 0

# L1: PAX's last and lastb against util-linux's, on crafted files (no boot; a Linux host's last).
python3 -I "$here/mpx6-logs.d/last-cases.py" "$images/tools/last" "$PAX_BUILD/mpx6-logs-cases" || fail=1

out=$PAX_BUILD/mpx6-logs-runs
mkdir -p "$out"
ran=0 skipped=0
for tier in $tiers; do
    elf=$images/$tier/kmain_console.elf
    [ -f "$elf" ] || { say "FAIL G0 $tier: no $elf"; fail=1; continue; }
    for leg in $legs; do
        if [ "$leg" = uefi ] && [ -z "$(find_ovmf 2>/dev/null)" ]; then
            if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then say "FAIL $tier uefi: no OVMF"; fail=1; else say "SKIPPED LOUDLY $tier uefi: no OVMF"; fi
            continue
        fi
        say "boots: $tier $leg"
        rc=0
        python3 -I "$here/mpx6-logs.d/rows.py" --images "$images" --elf "$elf" --tier "$tier" --leg "$leg" \
            --accel "$accel" --out "$out/$tier-$leg" || rc=$?
        case $rc in
            0) ran=$((ran + 1)) ;;
            3)
                if [ "${PAX_REQUIRE_BURROWD_RIG:-0}" = 1 ]; then
                    say "FAIL $tier $leg: the rig cannot run here, and PAX_REQUIRE_BURROWD_RIG=1"; fail=1
                else
                    say "SKIPPED LOUDLY $tier $leg: the rig cannot run here"; skipped=$((skipped + 1))
                fi ;;
            *) fail=1; ran=$((ran + 1)) ;;
        esac
    done
done
say "mpx6-logs: $ran legs, $skipped skipped"
exit $fail
