#!/usr/bin/env bash
# px61: pelt#50's replay, the same static shell and keys on Linux and
# PAX, root and pax. px62: the FIFO row px61 measured and named apart
# (R-px61-1, pax#108) is parity now, 22 of 22: PAX makes the FIFO
# (mknodat) and keeps fifo(7)'s open rules (kernel/files).
# Builds only on baseline Linux, not kasumi's host libc.
set -uo pipefail
. "$(dirname "$0")/../tools/lib.sh"
images= only= tiers=both legs=both noboot=0
while [ $# -gt 0 ]; do
    case $1 in
        --images) images=$2; shift 2 ;;
        --only) only=$2; shift 2 ;;
        --tier) tiers=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --no-boot) noboot=1; shift ;;
        *) die 'usage: mpx5-pelt [--images DIR] [--only build|linux|friendly] [--tier native|release|both] [--firmware bios|uefi|both] [--no-boot]' ;;
    esac
done
case $tiers in both) tiers='native release' ;; native|release) ;; *) die 'bad tier' ;; esac
case $legs in both) legs='bios uefi' ;; bios|uefi) ;; *) die 'bad firmware' ;; esac
case $only in ''|build|linux|friendly) ;; *) die 'bad only' ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die '--only linux needs --images'
[ "$only" != friendly ] || [ -n "$images" ] || die '--only friendly needs --images'
need python3 readelf
python3 -I "$PAX_ROOT/tests/mpx5-pelt.d/selftest.py" || exit 1
python3 -I "$PAX_ROOT/tests/mpx5-pelt.d/friendly-selftest.py" || exit 1
. "$PAX_ROOT/tests/mpx5-pelt.d/friendly.sh"
F=$PAX_ROOT/user/console/fork
# Match the upstream session harness SETTLE=0.6 for in-flight keys.
export PAX_TYPE_PAUSE=${PAX_TYPE_PAUSE:-0.6}
CASES='corpus c_jc_mixed_pipeline jc_subshell_stop jc_subshell_redir_stop jc_background_subshell subshell_jobs autocd_subshell cnf_cd cnf_contexts cnf_redirect shapes probes selfcheck'
if [ -n "${PAX_PELT_CASES:-}" ]; then
    for c in $PAX_PELT_CASES; do
        case " $CASES " in *" $c "*) ;; *) die "unknown replay case: $c" ;; esac
    done
    CASES=$PAX_PELT_CASES
    say "SUBSET: $CASES (empty PAX_PELT_CASES runs every replay)"
fi
BORE='cat env head sleep true false mkdir rm tr wc tail'
BB='mkfifo sed yes sort'
work=$PAX_BUILD/mpx5-pelt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }
shell_mode() {
    case $1 in c_jc_mixed_pipeline|jc_subshell_stop|jc_subshell_redir_stop|jc_background_subshell|shapes) echo -m ;; *) echo +m ;; esac
}
linux_side() {
    local d=$1 c role args rc
    mkdir -p "$d/linux"
    case " $CASES " in *" corpus "*)
        # A wrong pin can make both sides equally wrong or hang before
        # the differential comparison. Assert the process row first.
        printf 'cd /tmp\nsh /usr/share/pelt/fork/diff/env/subshell_is_process.sh\nexit 0\n' > "$d/process.keys"
        "$PAX_ROOT/tools/linux-tree" --root "$d/root" --keys "$d/process.keys" --prompt '$ ' \
            --argv0 /bin/env --size 512m --rdev --nsproc --owners "$d/owners" \
            "$d/linux/process.tty" -- /bin/env HOME=/ /bin/sh -i -m || return 1
        serial_norm "$d/linux/process.tty" > "$d/linux/process.cmp"
        while IFS= read -r witness; do
            if ! grep -qxF "$witness" "$d/linux/process.cmp"; then
                say "FAIL F2 Linux fork semantic witness: $witness"
                return 1
            fi
        done < "$F/process.expect"
        say 'PASS F2 Linux fork semantic witness: subshell, substitution, stage, background processes'
    ;; esac
    for c in $CASES; do
        for role in root pax; do
            args=(/bin/env HOME=/ /bin/sh -i "$(shell_mode "$c")")
            [ "$role" = root ] || args=(/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i "$(shell_mode "$c")")
            rc=0
            "$PAX_ROOT/tools/linux-tree" --root "$d/root" --keys "$d/keys/$c-$role.keys" --prompt '$ ' \
                --argv0 "${args[0]}" --size 512m --rdev --nsproc --owners "$d/owners" \
                "$d/linux/$c-$role.tty" -- "${args[@]}" || rc=$?
            [ "$rc" = 0 ] || return "$rc"
            [ "$(cat "$d/linux/$c-$role.tty.rc")" = 0 ] || return 1
        done
    done
}
# R-px61-2: each case and role gets a fresh boot, just as its Linux
# reference does. Two role images are shared by all cases; no bound or
# assertion is removed, and no large duplicate ISO per case is needed.
role_images() { # images tier
    local d=$1 tier=$2 role f mode mon
    [ -f "$d/$tier/pelt-root-m.iso" ] && [ -f "$d/$tier/pelt-pax-plusm.iso" ] && return 0
    local args=(/tmp/:1777 /home/pax/:755:1000:1000)
    while IFS= read -r -d '' f; do
        [ "$f" != "$d/root/etc/pax-run" ] || continue
        mode=644; case "$f" in "$d/root/bin/"*) mode=755 ;; esac
        args+=("${f#"$d/root"}=$f:$mode")
    done < <(find "$d/root" -type f -print0)
    for role in root pax; do
      for mon in m plusm; do
        opt=-m; [ "$mon" = m ] || opt=+m
        if [ "$role" = root ]; then echo "/bin/env HOME=/ /bin/sh -i $opt" > "$d/$role-$mon.run"
        else echo "/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i $opt" > "$d/$role-$mon.run"; fi
        "$PAX_ROOT/tools/mkinitramfs" "$d/pelt-$role-$mon.cpio" "${args[@]}" \
            "/etc/pax-run=$d/$role-$mon.run:644" > "$d/$role-$mon.initramfs.txt" || return 1
        "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
            --add "$d/pelt-$role-$mon.cpio" initramfs.cpio "$d/$tier/kmain_console.elf" "$d/$tier/pelt-$role-$mon.iso" || return 1
        say "role image $tier $role $mon: cpio $(sha256_of "$d/pelt-$role-$mon.cpio"), iso $(sha256_of "$d/$tier/pelt-$role-$mon.iso")"
      done
    done
}
if [ "$only" = linux ]; then
    linux_side "$images" || { bad 'F0 Linux replay'; exit 1; }
    say 'PASS F0 Linux: every replay ran, root and pax'
    exit 0
fi
if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}; need "$wolf"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"; mkdir -p "$work/root" "$work/keys" "$work/bin"
    cc -static -O2 -Wall -Wextra -Werror "$PAX_ROOT/tests/mpx5-pelt.d/winsize.c" -o "$work/bin/winsize" || exit 2
    r=$work/root
    mkdir -p "$r/bin" "$r/etc" "$r/tmp" "$r/home/pax" "$r/usr/share/pelt/fork"
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" || exit 2
    case " $CASES " in *" selfcheck "*) "$PAX_ROOT/tools/mkpelt" "$work/selfcheck" selfcheck || exit 2 ;; esac
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE || exit 2
    "$PAX_ROOT/tools/mkas" "$work/bin" || exit 2
    "$PAX_ROOT/tools/mkpspgid" "$work/pspgid" || exit 2
    "$PAX_ROOT/tools/fetch-busybox" "$work/bin" || exit 2
    cp "$work/pelt/pelt" "$r/bin/sh"
    case " $CASES " in *" selfcheck "*) cp "$work/selfcheck/selfcheck" "$r/bin/selfcheck" ;; esac
    cp "$work/bin/as" "$r/bin/as"
    cp "$work/pspgid/ps" "$r/bin/ps"
    for c in $BORE; do cp "$work/bore/$c" "$r/bin/$c"; done
    # Busybox applets are black-box fixture helpers, not the shell or
    # a replacement for any tested pelt/boreutils program.
    for c in $BB; do cp "$work/bin/busybox" "$r/bin/$c"; done
    cp -R "$F/." "$r/usr/share/pelt/fork/"
    for c in $CASES; do
        if [ "$c" = selfcheck ]; then printf '/bin/selfcheck; echo selfcheck-status=$?\nexit 0\n' > "$work/keys/$c.keys"
        else cp "$F/$c.keys" "$work/keys/$c.keys"; fi
        case $c in c_jc_mixed_pipeline|jc_subshell_stop|jc_subshell_redir_stop)
            sed -i 's/^\^Z$/^~^Z^./' "$work/keys/$c.keys" ;;
        esac
        # Upstream mixed-pipeline intentionally ends alive after refusing
        # the first exit. Keep that step, then supply only teardown.
        [ "$c" != c_jc_mixed_pipeline ] || echo 'exit 0' >> "$work/keys/$c.keys"
    done
    : > "$r/etc/pax-run"; : > "$work/all.keys"; : > "$work/run-names"
    for c in $CASES; do
        for role in root pax; do
            if [ "$role" = root ]; then echo '/bin/env HOME=/ /bin/sh -i -m' >> "$r/etc/pax-run"
            else echo '/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m' >> "$r/etc/pax-run"; fi
            echo "$c-$role" >> "$work/run-names"
            # Each run gets a distinct writable cwd on both systems:
            # PAX keeps its tree between runs; Linux references are fresh.
            key=$work/keys/$c-$role.keys
            printf ':\nmkdir -p /tmp/px61-%s-%s\ncd /tmp/px61-%s-%s\n' "$c" "$role" "$c" "$role" > "$key"
            sed "s|^cd /tmp$|cd /tmp/px61-$c-$role|" "$work/keys/$c.keys" >> "$key"
            cat "$key" >> "$work/all.keys"
        done
    done
    printf '%s\n' '/tmp 1777 0 0' '/home/pax 755 1000 1000' > "$work/owners"
    args=(/tmp/:1777 /home/pax/:755:1000:1000)
    while IFS= read -r -d '' f; do args+=("${f#"$r"}=$f:644"); done < <(find "$r" -type f ! -path "$r/bin/*" -print0)
    for f in "$r"/bin/*; do
        readelf -hW "$f" | grep -Eq 'Type: +EXEC' || die "$f not ET_EXEC"
        ! readelf -lW "$f" | grep -q INTERP || die "$f not static"
        args+=("/bin/${f##*/}=$f:755")
        say "program: ${f##*/} $(sha256_of "$f") $(wc -c < "$f")"
    done
    "$PAX_ROOT/tools/mkinitramfs" "$work/pelt.cpio" "${args[@]}" > "$work/initramfs.txt" || exit 2
    for tier in $tiers; do
        flag=(); [ "$tier" != release ] || flag=(--release)
        mkdir -p "$work/$tier"
        elf=$("$PAX_ROOT/tools/build-kernel" "${flag[@]}" --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier") || exit 2
        "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" --add "$work/pelt.cpio" initramfs.cpio "$elf" "$work/$tier/pelt.iso" || exit 2
    done
    for tier in $tiers; do role_images "$work" "$tier" || exit 2; done
    say 'PASS F0 build: static programs, replay fixtures and images'
    [ "$only" != build ] || exit 0
    linux_side "$work" || { bad 'F0 Linux replay'; exit 1; }
    images=$work
    [ "$noboot" != 1 ] || exit 0
fi
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then bad 'UEFI required but missing'; else say 'SKIP uefi: no OVMF'; fi
        continue
    fi
    for tier in $tiers; do
        role_images "$images" "$tier" || { bad "F0 $tier role images"; continue; }
        friendly_image "$images" "$tier" || { bad "F4 $tier friendly image"; continue; }
        for console in framebuffer serial-zero serial-sized; do
            friendly_boot "$images" "$tier" "$leg" "$console" || bad "F4 $tier $leg $console"
            ran=$((ran+1))
        done
        for console in framebuffer serial; do
            "$PAX_ROOT/tests/mpx5-pelt.d/prompt" "$images" "$tier" "$leg" "$console" \
                "$PAX_BUILD/mpx5-pelt-prompt-$tier-$leg-$console" || bad "F5 $tier $leg $console"
            ran=$((ran+1))
        done
        [ "$only" != friendly ] || continue
        while IFS= read -r name; do
            role=${name##*-}
            c=${name%-*}; mon=m; [ "$(shell_mode "$c")" = -m ] || mon=plusm
            log=$PAX_BUILD/mpx5-pelt-$tier-$leg-$name.serial.log
            if command -v uptime >/dev/null 2>&1; then uptime; fi
            say "begin $tier $leg $name (fresh boot, bound 1800 s)"
            rc=0
            "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 1800 --qemu -m --qemu 1024M \
                --elf "$images/$tier/kmain_console.elf" --marker 'halt|PANIC .*' --type "$images/keys/$name.keys" --prompt '$ ' \
                "$images/$tier/pelt-$role-$mon.iso" > "$log.verdict" 2>&1 || rc=$?
            ran=$((ran+1))
            [ "$rc" = 0 ] || bad "F3 $tier $leg $name: not halted ($rc)"
            serial_norm "$log" > "$log.norm"
            python3 -I "$PAX_ROOT/tests/mpx5-pelt.d/compare.py" "$images" "$log.norm" "$log.sessions" "$name" || bad "F1/F2 $tier $leg $name"
            init=/bin/env; [ "$role" = root ] || init=/bin/as
            grep -qx "PAX: init $init ended with status 0; nothing left to run" "$log.norm" || bad "F3 $tier $leg $name: init did not exit zero"
            if grep -q '^PANIC ' "$log.norm"; then bad "F3 $tier $leg $name panic"; fi
            say "F3 $tier $leg $name: $(tail -n 1 "$log.verdict")"
        done < "$images/run-names"
    done
done
[ "$ran" -gt 0 ] || bad 'no boot ran'
[ "$fail" = 0 ] && say 'mpx5-pelt: PASS' || say 'mpx5-pelt: FAIL'
exit "$fail"
