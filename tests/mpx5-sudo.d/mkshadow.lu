//! mkshadow (px106, a test helper; never in an image): /etc/shadow lines
//! for the password sessions of tests/mpx5-sudo, from passwords the suite
//! makes at run time. Reads `NAME PASSWORD` lines on standard input and
//! prints `NAME:HASH:DAY:0:99999:7:::` for each, the hash made by
//! user/auth/pwhash.lu (wolf-std's `$7$`, a fresh salt each), the line by
//! user/auth/shadow.lu. A line `NAME !` is a locked account.
//!
//! `mkshadow --cost NLOG2 R P` makes the lines at that cost instead of the
//! shipped one (tests/mpx5-sudo's sessions: a stored string keeps its own
//! cost, and the sessions' timing should be the programs', not CI's
//! emulator's; what passwd writes in a session is at the shipped cost).
//!
//! `mkshadow --check` (S0's row, on the build host): a string made at the
//! shipped cost is one PAX can check (user/auth's pw_refusal says ""), its
//! own password matches it and another does not; `check ok`, else exit 1.
//!
//! `mkshadow --time NLOG2 R P` (the cost row, px106 R-px106-5): makes a
//! `$7$` string at N = 2^NLOG2, r = R, p = P three times and prints the
//! wall milliseconds of each by the monotonic clock, as
//! `cost NLOG2 R P ms A B C`.

fn main() -> int {
    let args = env_args()
    if args.len == 4 && args[0] == "--time" {
        return timing(args[1].to_int() else 14, args[2].to_int() else 8, args[3].to_int() else 1)
    }
    if args.len == 1 && args[0] == "--check" {
        return check()
    }
    var cost = List[int]()
    if args.len == 4 && args[0] == "--cost" {
        for w in [args[1], args[2], args[3]] {
            (mut cost).push(w.to_int() else -1)
        }
    } else if args.len > 0 {
        eprint("mkshadow: usage: mkshadow [--cost NLOG2 R P] < LINES, or mkshadow --time NLOG2 R P")
        return 2
    }
    loop {
        let line = read_line() else |_| {
            break
        }
        let cut = line.find(" ") else -1
        if cut < 1 {
            eprint("mkshadow: a line is NAME PASSWORD")
            return 2
        }
        let name = line[0..cut]
        let pw = line[cut + 1..]
        if pw == "!" {
            print(shadow_line(shadow_fresh(name, "!")))
            continue
        }
        var h = ""
        if cost.len == 3 {
            h = pw_make_at(pw, cost[0], cost[1], cost[2]) else |_| {
                eprint("mkshadow: the hash could not be made at that cost")
                return 2
            }
        } else {
            h = pw_make(pw) else |_| {
                eprint("mkshadow: the hash could not be made")
                return 2
            }
        }
        print(shadow_line(shadow_fresh(name, h)))
    }
    0
}

fn timing(n: int, r: int, p: int) -> int {
    var out = "cost {n} {r} {p} ms"
    var k = 0
    while k < 3 {
        let t0 = os_clock_ns()
        let _h = pw_make_at("cost-row", n, r, p) else |_| {
            print("cost {n} {r} {p} refused")
            return 1
        }
        out = "{out} {(os_clock_ns() - t0) / 1000000}"
        k += 1
    }
    print(out)
    0
}

fn check() -> int {
    let h = pw_make("check-row") else |_| {
        print("check FAIL: no string made at the shipped cost")
        return 1
    }
    let why = pw_refusal(h)
    if why.len > 0 {
        print("check FAIL: a string at the shipped cost is refused: {why}")
        return 1
    }
    if !pw_matches("check-row", h) {
        print("check FAIL: a string at the shipped cost does not match its own password")
        return 1
    }
    if pw_matches("check-row-not", h) {
        print("check FAIL: another password matches")
        return 1
    }
    print("check ok: {h[0..14]}")
    0
}
