# px106: the typed password sessions' policy (tests/mpx5-sudo), the same file on PAX and in the
# Ubuntu container: PAX's shipped rules, a password rule for bob, and the log as a file (PAX's sudo
# always writes /var/log/sudo.log and accepts the line).
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults logfile=/var/log/sudo.log
root ALL=(ALL:ALL) ALL
#1000 ALL=(ALL:ALL) NOPASSWD: ALL
bob ALL=(ALL:ALL) ALL
