#!/usr/bin/env bash
# tests/mpx6-nvme — NVMe, the desktops' disks (px75, P6): kernel/nvme
# behind kernel/block, its names and numbers, its bytes, its errors, its
# boot lines, `/etc/fstab` and `/` on it, each held to the Linux guest
# (hasu's installed Linux 7.2.4 on QEMU: tools/linux-nodes --nvme)
# running the same programs on the same disks.
#
#   tests/mpx6-nvme [--images DIR | --no-boot | --only build | --only linux --images DIR [--record]]
#                   [--rows pr|all] [--firmware bios|uefi|both] [--tier native|release|both]
#
# The programs, each static and unmodified: pelt (as /bin/sh), boreutils'
# ls, user/elf/nodes.c (tools/mknodes, px79's probe) and user/elf/nvme.c
# (tools/mknvme). The disks, made where the boots run with
# SOURCE_DATE_EPOCH=1700000000: a.img, px79's A (64 MiB, GPT: partition 1
# LBA 2048-34815 with no file system, partition 2 LBA 34816-100351 an
# ext2 of 32 MiB), its sha256 the one tests/mpx6-nodes.d/disks.sha256
# records; big.img, 1 GiB blank. Every boot is kmain_console with pid 1 a
# session of tests/mpx6-nvme.d/ run by pelt, on QEMU's `nvme` device
# (tools/qemu-halt --nvme, and --qemu for what that does not say):
#   names   vda a.img (virtio), nvme0n1 a copy: names.sh;
#   two     nvme0 a copy; nvme1 a controller with namespaces 1 (a copy)
#           and 3 (16 MiB blank): two.sh;
#   four    a copy behind `logical_block_size=4096,physical_block_size=
#           4096`: four.sh;
#   error   a copy behind QEMU's blkdebug, every read of sector 4096
#           failing with EIO: error.sh;
#   single  a copy behind `max_ioqpairs=1`: single.sh (no guest run: its
#           sizes section is held to the names session's);
#   speed   big.img: speed.sh;
#   fstab   nvme0n1 a copy and no virtio disk; /etc/fstab
#           `PARTUUID=<a.img's partition 2> /mnt ext2 defaults 0 2`:
#           fstab.sh;
#   root    tools/mkdisk --gpt --root of root.sh's archive, booted from
#           QEMU's NVMe controller (tools/qemu-halt --boot-nvme; the
#           disk's `root=PARTUUID=`): root.sh (no guest run).
#
# The Linux side (`--only linux`, or with the build): tools/linux-nodes
# runs names, two, four, error, speed and fstab on copies of the same
# disks with the same programs (fstab after the guest's own mount(2) of
# /dev/nvme0n1p2 at /mnt), and the sha256 of each NVMe image it left. Where
# this host's kernel cannot be read (the CI runner's is root's), the
# reference is the one recorded on hasu (tests/mpx6-nvme.d/linux/,
# `--record` writes it), said loudly; PAX_LINUX=live insists on a live
# one. pax#241 (px78):
# PAX_LINUX=recorded takes the record whatever kernel is readable, and a
# guest that left no log is a named failure. PAX_LINUX_KERNEL and PAX_LINUX_MODULES name the guest's kernel and
# its modules' directory; PAX_LINUX_ACCEL its accelerator (tcg, kvm).
# PAX_NVME_RAM names a directory in memory (a tmpfs) for the 1 GiB disk,
# so the throughput is the driver's and QEMU's, not a host disk's.
#
# Rows (--rows pr, or PAX_NVME_ROWS=pr, CI's pr tier: V0-V4, V6-V8, V12 on
# the names, four, error and single boots; --rows all, the default and the
# full and all tiers: every one):
#   V0  build: the programs static, kmain_console built, the images made,
#       a.img its recorded sha256, the Linux side ran (or its record is
#       there).
#   V1  the boot lines: every `nvme…:` and `block: nvme…` line of the
#       names, four, single and two boots is tests/mpx6-nvme.d/boot.golden's
#       (QEMU's own firmware revision, its version, folded to `QEMU`; a
#       shutdown line's counts to `N`): the controller's PCI ids and slot,
#       its Identify (version, model, serial, firmware, MDTS, namespaces,
#       the write cache), each namespace's blocks, the queue depth chosen
#       and asked, MQES, the queues granted, a single pair, polled.
#   V2  names and numbers: stat of the nodes, /dev's block devices,
#       /proc/partitions and /sys/block, /sys/class/block: the guest's
#       (nvme0n1 259:0, nvme0n1p1 259:1, nvme0n1p2 259:2 beside vda's
#       254:N; no nvme0n1p3, nvme0n2 or nvme1n1).
#   V3  the ioctls (but BLKSECTGET, BLKRAGET and BLKFRAGET, refused by
#       name) and raw reads (lseek, odd lengths and offsets, across and at
#       the end, O_DIRECT): the guest's.
#   V4  bytes: the whole disk read before (its FNV-1a the guest's), 22
#       writes of 512 bytes to 1 MiB at odd and even offsets (one page,
#       two: PRP2, three and more: a PRP list, past the largest request)
#       read back (the guest's answers, 0 bytes differ), the disk read
#       after; the NVMe image PAX left byte for byte the image the guest
#       left (sha256).
#   V5  two controllers: names (nvme0n1, nvme1n1, nvme1n2 for namespaces 1
#       and 3) the guest's; the minors on 259 the guest's set (the order
#       its probes' race, named); the reads of each namespace the guest's.
#   V6  4096-byte blocks: /sys/block's size and the ioctls (512-byte
#       units, BLKSSZGET 4096), no partition table, raw reads, odd raw
#       writes (read-modify-write in 4096-byte blocks) put back, the sizes
#       writes: the guest's, and the image the guest's.
#   V7  errors by name: the reads around the failing sector the guest's
#       (EIO at it, 4096 of 8192 across it); PAX's kernel line names the
#       status: `Unrecovered Read Error (media and data integrity)`.
#   V8  a single queue pair: one SQ and one CQ granted (the boot line),
#       the sizes section the guest's (names') to the byte.
#   V9  1 GiB: written in 1 MiB writes and read back, 0 sectors differ,
#       the guest's lines; the image the guest's (sha256); the throughput,
#       PAX's and the guest's, as numbers (no bar).
#   V10 /etc/fstab by PARTUUID= on nvme0n1p2: the fstab line, /proc/mounts
#       (the guest's ext2 module's own options, `errors=continue,user_xattr,
#       acl`, folded: hasu's kernel mounts ext2 with ext2.ko, kasumi's and
#       PAX's say `rw,relatime` alone) and the tree the guest's.
#   V11 `/` on NVMe: the disk boots from the NVMe controller, `/` is
#       nvme0n1p2 (the kernel's `root: PARTUUID=… (nvme0n1p2) on /: ext3`;
#       /proc/mounts names it `/dev/root`, as Linux names a root given by
#       PARTUUID=), a file written there, halted; e2fsck -fn of partition 2
#       clean after.
#   V12 the books (`0 errors` on every NVMe disk), each controller shut
#       down (CC.SHN, CSTS.SHST complete), init ended, halted.
#
# The UEFI legs need OVMF (SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1). Exit 0 when every assertion held, 1 otherwise, 2
# on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only= rows=${PAX_NVME_ROWS:-all} record=0
usage="usage: tests/mpx6-nvme [--images DIR | --no-boot | --only build | --only linux --images DIR [--record]] [--rows pr|all] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --rows)     rows=$2; shift 2 ;;
        --record)   record=1; shift ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
case $rows in pr|all) ;; *) die "--rows takes pr or all" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3 sha256sum

D=$PAX_ROOT/tests/mpx6-nvme.d
REC=$D/linux
EPOCH=1700000000
SEED=0x7078373573697a65
GUEST="names two four error speed fstab"
work=$PAX_BUILD/mpx6-nvme
runs=$PAX_BUILD/mpx6-nvme-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

static_ok() {
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# --- the disks (made on the host that boots: tools/mkdisk runs a container) ---

make_disks() { # dir -> reasons
    local w=$1
    mkdir -p "$w/disks"
    (
        export SOURCE_DATE_EPOCH=$EPOCH
        cd "$w/disks" || exit 1
        rm -f a.img a2.img
        "$PAX_ROOT/tools/mkdisk" --home 32M a2.img > a2.mkdisk.txt || { printf ' the ext2 of a.img;'; exit 0; }
        truncate -s 64M a.img
        dd if=a2.img of=a.img bs=512 seek=34816 conv=notrunc status=none
        rm -f a2.img
        "$PAX_ROOT/tools/mkgpt" --label px79a a.img 1:linux:2048:34815:one 2:linux:34816:100351:home > /dev/null || printf ' mkgpt a.img;'
        printf '[inject-error]\nevent = "read_aio"\nerrno = "5"\nsector = "4096"\nonce = "off"\n' > blkdebug.cfg
    )
}

disks_ready() { # dir -> reasons
    [ -f "$1/disks/a.img" ] || make_disks "$1"
    local got want
    got=$(sha256_of "$1/disks/a.img")
    want=$(sed -n 's/^a \([0-9a-f]*\)$/\1/p' "$PAX_ROOT/tests/mpx6-nodes.d/disks.sha256")
    [ "$got" = "$want" ] || printf ' a.img is %s, tests/mpx6-nodes.d/disks.sha256 says %s;' "$got" "$want"
}

blank() { rm -f "$1"; truncate -s "$2" "$1"; }

# Each session's disks (fresh copies into $2): one line a disk or QEMU
# argument for tools/qemu-halt and tools/linux-nodes alike (`--drive X`,
# `--nvme X`, `--qemu X`), on stdout.
disks_of() { # session dir
    local s=$1 w=$2 dk=$images/disks
    mkdir -p "$w"
    case $s in
        names) cp "$dk/a.img" "$w/v.img"; cp "$dk/a.img" "$w/n.img"
               printf '%s\n' --drive "$w/v.img" --nvme "$w/n.img" ;;
        two)   cp "$dk/a.img" "$w/n.img"; cp "$dk/a.img" "$w/m.img"; blank "$w/m3.img" 16M
               printf '%s\n' --nvme "$w/n.img" --qemu -device --qemu nvme,id=c1,serial=paxnvme1 \
                   --qemu -drive --qemu "file=$w/m.img,if=none,id=c1n1,format=raw" --qemu -device --qemu nvme-ns,drive=c1n1,bus=c1,nsid=1 \
                   --qemu -drive --qemu "file=$w/m3.img,if=none,id=c1n3,format=raw" --qemu -device --qemu nvme-ns,drive=c1n3,bus=c1,nsid=3 ;;
        four)  cp "$dk/a.img" "$w/n.img"
               printf '%s\n' --nvme "$w/n.img;logical_block_size=4096,physical_block_size=4096" ;;
        error) cp "$dk/a.img" "$w/n.img"; cp "$dk/blkdebug.cfg" "$w/blkdebug.cfg"
               printf '%s\n' --qemu -drive --qemu "file=blkdebug:$w/blkdebug.cfg:$w/n.img,if=none,id=e0,format=raw" \
                   --qemu -device --qemu nvme,serial=paxnvme0,drive=e0 ;;
        single) cp "$dk/a.img" "$w/n.img"
               printf '%s\n' --nvme "$w/n.img;max_ioqpairs=1" ;;
        speed) # PAX_NVME_RAM: a directory in memory for the 1 GiB (a host whose
               # page cache lets the image go reads it back at its disk's rate)
               if [ -n "${PAX_NVME_RAM:-}" ]; then
                   blank "$PAX_NVME_RAM/${w//\//_}.img" 1G; ln -sfn "$PAX_NVME_RAM/${w//\//_}.img" "$w/n.img"
               else
                   blank "$w/n.img" 1G
               fi
               printf '%s\n' --nvme "$w/n.img" ;;
        fstab) cp "$dk/a.img" "$w/n.img"
               printf '%s\n' --nvme "$w/n.img" ;;
    esac
}

# --- the Linux side -------------------------------------------------------------

kernel_readable() {
    # pax#241 (px78): PAX_LINUX=recorded takes the record, whatever kernel is readable
    [ "${PAX_LINUX:-}" != recorded ] || return 1
    local k=${PAX_LINUX_KERNEL:-}
    if [ -z "$k" ]; then
        k=/usr/lib/modules/$(uname -r)/vmlinuz
        [ -r "$k" ] || k=$(command ls -1 /usr/lib/modules/*/vmlinuz 2>/dev/null | grep -v lts | tail -n 1)
    fi
    [ -n "$k" ] && [ -r "$k" ] && printf '%s\n' "$k"
}

linux_side() { # dir -> reasons
    local w=$1 k s mods=()
    mkdir -p "$w/linux"
    k=$(kernel_readable || true)
    if [ -z "$k" ] && [ "${PAX_LINUX:-}" != live ]; then
        say "LOUD: $([ "${PAX_LINUX:-}" = recorded ] && echo PAX_LINUX=recorded || echo no readable Linux kernel on this host): the Linux side is the record made on hasu ($(head -n 1 "$REC/meta"))"
        for s in $GUEST; do cp "$REC/$s.session" "$w/linux/" || printf ' no %s record in %s;' "$s" "$REC"; done
        cp "$REC/images.sha256" "$w/linux/" || printf ' no images.sha256 in %s;' "$REC"
        echo recorded > "$w/linux/how"
        return
    fi
    [ -n "$k" ] || { printf ' PAX_LINUX=live and no readable kernel;'; return; }
    [ -z "${PAX_LINUX_MODULES:-}" ] || mods=(--modules "$PAX_LINUX_MODULES")
    # the guest's shell tools: Ubuntu's busybox-static by digest (px48)
    "$PAX_ROOT/tools/fetch-busybox" "$w/guest-bb" > /dev/null || { printf ' tools/fetch-busybox;'; return; }
    local bb=(--busybox "$w/guest-bb/busybox") progs=("$w/bin"/*)
    : > "$w/linux/images.sha256"
    for s in $GUEST; do
        local g=$w/linux/$s first=() run=1
        mapfile -t dv < <(images=$w disks_of "$s" "$g/disks")
        if [ "$s" = fstab ]; then first=("/bin/nodes mount /dev/nvme0n1p2 /mnt"); run=2; fi
        "$PAX_ROOT/tools/linux-nodes" --kernel "$k" ${mods[@]+"${mods[@]}"} ${bb[@]+"${bb[@]}"} --accel "${PAX_LINUX_ACCEL:-tcg}" \
            "${dv[@]}" --file "$D/$s.sh=/etc/nvme/$s.sh" \
            "$g" "${progs[@]}" -- ${first[@]+"${first[@]}"} "/bin/sh /etc/nvme/$s.sh" || printf ' tools/linux-nodes %s;' "$s"
        python3 "$D/session" linux "$g/serial.log" "$run" > "$w/linux/$s.session"
        grep -qx '== end' "$w/linux/$s.session" || printf ' the guest'"'"'s %s session did not end;' "$s"
        printf '%s %s\n' "$s" "$(sha256_of "$g/disks/n.img")" >> "$w/linux/images.sha256"
        if [ "$s" = speed ]; then "$PAX_ROOT/tools/blk-pattern" "$g/disks/n.img" > "$w/linux/speed.pattern" 2>&1 || printf ' the guest'"'"'s 1 GiB is not the pattern: %s;' "$(tail -n 1 "$w/linux/speed.pattern")"; fi
        [ -L "$g/disks/n.img" ] && rm -f "$(readlink "$g/disks/n.img")"
        rm -rf "$g/root" "$g/initramfs.cpio" "$g/disks"
    done
    echo "live $(file -b "$k" | sed -n 's/.*version \([^ ]*\).*/\1/p') $k" > "$w/linux/how"
    if [ "$record" = 1 ]; then
        mkdir -p "$REC"
        for s in $GUEST; do cp "$w/linux/$s.session" "$REC/"; done
        cp "$w/linux/images.sha256" "$REC/"
        sed 's#^.*/n\.img: #the guest'"'"'s 1 GiB: #' "$w/linux/speed.pattern" > "$REC/speed.pattern"
        printf 'Linux %s on QEMU %s (tools/linux-nodes --nvme, %s), recorded %s\n' \
            "$(sed -n 's/.*linux-nodes: uname //p' "$w/linux/names/serial.log" | tr -d '\r' | head -n 1)" \
            "$(sed -n 's/^qemu QEMU emulator version \([^ ]*\).*/\1/p' "$w/linux/names/meta")" "${PAX_LINUX_ACCEL:-tcg}" "$(date -u +%Y-%m-%d)" > "$REC/meta"
        say "recorded the Linux side in $REC"
    fi
}

if [ "$only" = linux ]; then
    why=$(disks_ready "$images")
    why+=$(linux_side "$images")
    [ -z "$why" ] && say "PASS V0 (linux): the Linux side ran ($(cat "$images/linux/how"))" || bad "V0 (linux):$why"
    exit "$fail"
fi

# --- the build ----------------------------------------------------------------------

SESSIONS="names two four error single speed fstab"
if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    mkdir -p "$work/bin"
    why=
    "$PAX_ROOT/tools/mkpelt" "$work/peltbin" > "$work/pelt.txt" || why+=" tools/mkpelt;"
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" ls > "$work/bore.txt" || why+=" tools/mkboreutils;"
    "$PAX_ROOT/tools/mknodes" "$work/bin" > "$work/probes.txt" || why+=" tools/mknodes;"
    "$PAX_ROOT/tools/mknvme" "$work/bin" >> "$work/probes.txt" || why+=" tools/mknvme;"
    cp "$work/peltbin/pelt" "$work/bin/sh" 2>/dev/null || why+=" no pelt;"
    cp "$work/bore/ls" "$work/bin/ls" 2>/dev/null || why+=" no ls;"
    for f in "$work"/bin/*; do
        r=$(static_ok "$f") || why+=" $r;"
    done
    sed 's/^/  program: /' "$work/probes.txt" >&2
    partuuid=86aec534-0899-c941-fb08-5f840bf4cdbb # a.img's partition 2 (px79's A, its GPT by tools/mkgpt)
    for s in $SESSIONS root; do
        printf '/bin/sh /etc/nvme/%s.sh\n' "$s" > "$work/$s.run"
        args=()
        for f in "$work"/bin/*; do args+=("/bin/${f##*/}=$f:755"); done
        args+=(/mnt/:755 /tmp/:1777 "/etc/nvme/$s.sh=$D/$s.sh:644" "/etc/pax-run=$work/$s.run:644")
        if [ "$s" = fstab ]; then
            printf 'PARTUUID=%s /mnt ext2 defaults 0 2\n' "$partuuid" > "$work/fstab.fstab"
            args+=("/etc/fstab=$work/fstab.fstab:644")
        fi
        [ "$s" = root ] && args+=(/dev/:755 /proc/:555 /sys/:555)
        "$PAX_ROOT/tools/mkinitramfs" "$work/$s.cpio" "${args[@]}" > "$work/$s.initramfs.txt" || why+=" tools/mkinitramfs $s;"
    done
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            cat "$log" >&2
            for s in $SESSIONS; do
                "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" --add "$work/$s.cpio" initramfs.cpio \
                    "$elf" "$work/$tier/nvme-$s.iso" >/dev/null || why+=" $tier $s: mkimage;"
            done
            say "built $tier kmain_console: elf $(sha256_of "$elf")"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS V0 (build): the programs static, kmain_console built ($tiers), eight images a tier" || bad "V0 (build):$why"
        exit "$fail"
    fi
    why+=$(disks_ready "$work")
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s));"
    else
        why+=$(images=$work linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS V0: the programs static, kmain_console built ($tiers), the images and the disks (as recorded), the Linux side ($(cat "$work/linux/how"))" || bad "V0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx6-nvme build (V0): PASS (no boot: --no-boot)" || say "mpx6-nvme build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux
[ -d "$lx" ] || die "no $lx (build first, and run the Linux side)"
why=$(disks_ready "$images")
[ -z "$why" ] && say "PASS V0 (disks): a.img as recorded" || bad "V0 (disks):$why"

# --- the boots ------------------------------------------------------------------------

record_run() { # tier leg what status
    ran=$((ran + 1))
    printf '%s kmain_console %s %s status=%s accel=%s elapsed=%s serial=%s\n' "$1" "$2" "$3" "$4" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sed -n 's/^elapsed: //p' "$log.meta" 2>/dev/null)" \
        "$(sha256_of "$log")" >> "$runs"
}

# Boot session $3's image with its disks (fresh copies in $dw); the
# session's lines into $out; the log normalised once into $log.norm.
boot_session() { # tier leg session
    local rc=0
    dw=$PAX_BUILD/mpx6-nvme-$1-$2-$3
    rm -rf "$dw"; mkdir -p "$dw"
    mapfile -t dv < <(disks_of "$3" "$dw")
    log=$dw.serial.log
    rm -f "$log" "$log.verdict" "$log.norm"
    "$PAX_ROOT/tools/qemu-halt" --firmware "$2" --serial "$log" --timeout 900 --qemu -m --qemu 1G \
        --elf "$images/$1/kmain_console.elf" --marker 'halt|PANIC .*' "${dv[@]}" \
        "$images/$1/nvme-$3.iso" >"$log.verdict" 2>&1 || rc=$?
    serial_norm "$log" > "$log.norm"
    record_run "$1" "$2" "$3" "$rc"
    out=$dw.session
    python3 "$D/session" pax "$log" > "$out"
    return "$rc"
}

sgrep() { command grep -a "$@" "$log.norm"; }

# Hold sections $3… of the session to the guest's session $s: one row.
held() { # row id guest-session section...
    local row=$1 id=$2 s=$3; shift 3
    local r
    if r=$(python3 "$D/compare" "$out" "$lx/$s.session" "$@"); then
        say "PASS $row $id: $(printf '%s' "$r" | sed 's/^PASS //' | tr '\n' ';' | sed 's/;$//')"
    else
        bad "$row $id: $(printf '%s' "$r" | grep -v '^PASS' | tr '\n' '|' | cut -c1-900)"
    fi
}

# V1: the session's kernel lines about NVMe, folded, are the golden's:
# QEMU's firmware revision (its version) to `QEMU`; the books' and the
# shutdown line's counts to `N` but the errors and refusals; the first
# disk's cache numbers (the cache is every disk's) left out.
golden() { # id session leg
    local g=$dw.boot want=$dw.golden
    python3 - "$log.norm" > "$g" <<'PY'
import re, sys
for l in open(sys.argv[1], encoding="utf-8", errors="replace").read().split("\n"):
    if not re.match(r"^(nvme[0-9]+: [0-9a-f]{4}:[0-9a-f]{4} at |block: nvme[0-9]+n[0-9]+)", l):
        continue
    l = re.sub(r' firmware "[^"]*";', ' firmware "QEMU";', l)
    m = re.match(r"^(block: \S+ )(\d+) reads \((\d+) sectors\), (\d+) writes \((\d+) sectors\), (?:(\d+) flushes, )?(\d+) errors, (\d+) refused", l)
    if m:
        l = "%sN reads (N sectors), N writes (N sectors), %s%s errors, %s refused" % (m.group(1), "N flushes, " if m.group(6) is not None else "", m.group(7), m.group(8))
    l = re.sub(r": \d+ commands \(\d+ reads, \d+ writes, \d+ flushes; \d+ and \d+ sectors\), (\d+) errors, \d+ admin;",
               r": N commands (N reads, N writes, N flushes; N and N sectors), \1 errors, N admin;", l)
    print(l)
PY
    python3 - "$D/boot.golden" "$2" "$3" > "$want" <<'PY'
import sys
on = False
for l in open(sys.argv[1]).read().split("\n"):
    if l.startswith("== "):
        w = l[3:].split()
        on = w[0] == sys.argv[2] and w[1] in (sys.argv[3], "any")
        continue
    if on and l:
        print(l)
PY
    if [ -s "$want" ] && cmp -s "$g" "$want"; then
        say "PASS V1 $1: $(wc -l < "$g" | tr -d ' ') boot lines are tests/mpx6-nvme.d/boot.golden's ($2, $3): $(grep -m1 '^nvme0: ' "$g" | cut -c1-160)…"
    else
        bad "V1 $1: the boot lines are not the golden's ($2, $3): $(diff "$want" "$g" | head -n 6 | tr '\n' '|' | cut -c1-900)"
    fi
}

the_end() { # id status session
    local why= n k
    n=$(sgrep -Ec '^block: nvme[0-9]+n[0-9]+: [0-9]+ sectors ')
    k=$(sgrep -Ec '^block: nvme[0-9]+n[0-9]+: [0-9]+ reads \([0-9]+ sectors\), [0-9]+ writes \([0-9]+ sectors\), ([0-9]+ flushes, )?0 errors, ')
    [ "$k" = "$n" ] && [ "$n" -gt 0 ] || why+=" $k books lines with 0 errors for $n NVMe disks;"
    c=$(sgrep -Ec '^nvme[0-9]+: [0-9a-f]{4}:[0-9a-f]{4} at [0-9a-f:.]+, NVMe ')
    s=$(sgrep -Ec '^nvme[0-9]+: [0-9a-f]{4}:[0-9a-f]{4} at [0-9a-f:.]+: [0-9]+ commands .*; shut down$')
    [ "$c" = "$s" ] && [ "$c" -gt 0 ] || why+=" $s of $c controllers shut down;"
    sgrep -q '^PAX: init /bin/sh ended with status 0; nothing left to run$' || why+=" no clean end of init;"
    [ "$2" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
    ! sgrep -q '^PANIC ' || why+=" $(sgrep -m1 '^PANIC ')"
    grep -qx '== end' "$out" || why+=" the session did not end;"
    [ -z "$why" ] && say "PASS V12 $1: $n NVMe disks, each 0 errors; $c controllers shut down; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "V12 $1:$why"
}

image_is() { # row id session file
    local got want
    got=$(sha256_of "$4")
    want=$(sed -n "s/^$3 \\([0-9a-f]*\\)\$/\\1/p" "$lx/images.sha256")
    if [ -n "$want" ] && [ "$got" = "$want" ]; then
        say "PASS $1 $2 (the image): byte for byte the image the guest left, sha256 $got"
    else
        bad "$1 $2 (the image): sha256 $got, the guest's ${want:-none}"
    fi
}

e2clean() { # image first-sector sectors -> 0 clean
    local img=$1 p=$1.part
    dd if="$img" of="$p" bs=512 skip="$2" count="$3" status=none
    "$PAX_ROOT/tools/e2fs" "$(dirname "$img")" e2fsck -fn "$p" > "$p.fsck" 2>&1
    local rc=$?
    rm -f "$p"
    return $rc
}

# V11: `/` on NVMe (the header says what it holds).
root_row() { # tier leg
    local id="$1 $2 root" why= rw=$PAX_BUILD/mpx6-nvme-$1-$2-root img first n rc=0
    rm -rf "$rw"; mkdir -p "$rw"
    img=$rw/root.img
    if ! SOURCE_DATE_EPOCH=$EPOCH "$PAX_ROOT/tools/mkdisk" --gpt --kernel "$images/$1/kmain_console.elf" --root "$images/root.cpio" \
        --label px75-root 128M "$img" > "$rw/mkdisk.txt" 2>&1; then
        bad "V11 $id: tools/mkdisk --gpt --root: $(tail -n 2 "$rw/mkdisk.txt" | tr '\n' ' ')"
        return
    fi
    first=$(sed -n 's/^ *[^ ]*2 : start= *\([0-9]*\), size= *\([0-9]*\),.*/\1/p' "$rw/mkdisk.txt" | head -n 1)
    n=$(sed -n 's/^ *[^ ]*2 : start= *\([0-9]*\), size= *\([0-9]*\),.*/\2/p' "$rw/mkdisk.txt" | head -n 1)
    [ -n "$first" ] && [ -n "$n" ] || { bad "V11 $id: no partition 2 in mkdisk's sfdisk --dump"; return; }
    log=$rw/boot.serial.log
    "$PAX_ROOT/tools/qemu-halt" --firmware "$2" --serial "$log" --timeout 900 --qemu -m --qemu 512M --boot-nvme \
        --elf "$images/$1/kmain_console.elf" --marker 'halt|PANIC .*' "$img" > "$log.verdict" 2>&1 || rc=$?
    serial_norm "$log" > "$log.norm"
    record_run "$1" "$2" root "$rc"
    out=$rw.session
    python3 "$D/session" pax "$log" > "$out"
    sgrep -Eq '^nvme0: 1b36:0010 at [0-9a-f:.]+, NVMe ' || why+=" no controller line;"
    sgrep -Eq '^root: PARTUUID=[0-9a-f-]+ \(nvme0n1p2\) on /: ext3, read-write, ' || why+=" the kernel did not mount / from nvme0n1p2 ($(sgrep -m1 '^root: ' || echo 'no root line'));"
    grep -Eq '^mounts: /dev/root / ext3 rw' "$out" || why+=" /proc/mounts has no /dev/root on / ($(grep -m1 '^mounts: ' "$out" || echo none));"
    grep -qx '== end' "$out" || why+=" the session did not end;"
    sgrep -q '^PAX: init /bin/sh ended with status 0; nothing left to run$' || why+=" no clean end of init;"
    [ "$rc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
    if e2clean "$img" "$first" "$n"; then :; else why+=" e2fsck -fn: $(grep -v '^e2fsck \|^Pass ' "$img.part.fsck" | head -n 4 | tr '\n' '|');"; fi
    [ -z "$why" ] && say "PASS V11 $id: booted from QEMU's NVMe controller ($2): $(sgrep -m1 '^root: '); /proc/mounts: $(grep -m1 '^mounts: /dev/root / ' "$out" | sed 's/^mounts: //'); a file written, halted; e2fsck -fn of partition 2 clean: $(tail -n 1 "$img.part.fsck")" || bad "V11 $id:$why"
    rm -rf "$rw"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        # --- names: V1-V4, V12 --------------------------------------------------
        id="$tier $leg names"
        hrc=0; boot_session "$tier" "$leg" names || hrc=$?
        golden "$id" names "$leg"
        held V2 "$id" names stat dev sys
        held V3 "$id" names ioctl io
        held V4 "$id" names before sizes after
        image_is V4 "$id" names "$dw/n.img"
        cmp -s "$dw/v.img" "$images/disks/a.img" && say "PASS V4 $id (vda): the virtio disk every byte as it was (only read)" || bad "V4 $id (vda): the virtio disk's image changed"
        the_end "$id" "$hrc" names
        names_out=$out
        rm -rf "$dw"

        # --- four: V6, V12 ------------------------------------------------------
        id="$tier $leg four"
        hrc=0; boot_session "$tier" "$leg" four || hrc=$?
        golden "$id" four "$leg"
        held V6 "$id" four sys ioctl io wio sizes after
        image_is V6 "$id" four "$dw/n.img"
        the_end "$id" "$hrc" four
        rm -rf "$dw"

        # --- error: V7, V12 -----------------------------------------------------
        id="$tier $leg error"
        hrc=0; boot_session "$tier" "$leg" error || hrc=$?
        held V7 "$id" error rd
        if sgrep -Eq '^nvme0n1: READ of [0-9]+ sectors from [0-9]+: status 2h/81h Unrecovered Read Error \(media and data integrity\), -EIO$'; then
            say "PASS V7 $id (by name): $(sgrep -m1 '^nvme0n1: READ of ')"
        else
            bad "V7 $id (by name): no Unrecovered Read Error line: $(sgrep -m1 '^nvme0n1: ' || echo none)"
        fi
        why=
        n=$(sgrep -Ec '^block: nvme0n1: [0-9]+ sectors ')
        sgrep -Eq '^block: nvme0n1: [0-9]+ reads \([0-9]+ sectors\), [0-9]+ writes \([0-9]+ sectors\), [0-9]+ flushes, [1-9][0-9]* errors, ' || why+=" no errors in the books;"
        sgrep -q '^PAX: init /bin/sh ended with status 0; nothing left to run$' || why+=" no clean end of init;"
        [ "$hrc" = 0 ] || why+=" not halted;"
        [ -z "$why" ] && say "PASS V12 $id: the errors counted in the books ($(sgrep -m1 '^block: nvme0n1: [0-9]* reads' | sed 's/.*flushes, //')), init ended, halted" || bad "V12 $id:$why"
        rm -rf "$dw"

        # --- single: V8, V12 -----------------------------------------------------
        id="$tier $leg single"
        hrc=0; boot_session "$tier" "$leg" single || hrc=$?
        golden "$id" single "$leg"
        held V8 "$id" names sizes
        the_end "$id" "$hrc" single
        rm -rf "$dw"
        [ "$rows" = all ] || continue

        # --- two: V5, V1, V12 ---------------------------------------------------
        id="$tier $leg two"
        hrc=0; boot_session "$tier" "$leg" two || hrc=$?
        golden "$id" two "$leg"
        held V5 "$id" two 'dev~' 'sys~' io
        the_end "$id" "$hrc" two
        rm -rf "$dw"

        # --- speed: V9, V12 -----------------------------------------------------
        id="$tier $leg speed"
        hrc=0; boot_session "$tier" "$leg" speed || hrc=$?
        held V9 "$id" speed speed
        image_is V9 "$id" speed "$dw/n.img"
        pt=$(sed -n '/^== time$/{n;p;}' "$out" | sed 's/^speed [^:]*: time: //')
        gt=$(sed -n '/^== time$/{n;p;}' "$lx/speed.session" | sed 's/^speed [^:]*: time: //')
        [ -n "$pt" ] && say "PASS V9 $id (the number): PAX $pt ($(sed -n 's/^accel: //p' "$log.meta")); the guest $gt ($(cat "$lx/how" | cut -c1-60))" || bad "V9 $id (the number): no time line"
        the_end "$id" "$hrc" speed
        [ -L "$dw/n.img" ] && rm -f "$(readlink "$dw/n.img")"
        rm -rf "$dw"

        # --- fstab: V10, V12 ----------------------------------------------------
        id="$tier $leg fstab"
        hrc=0; boot_session "$tier" "$leg" fstab || hrc=$?
        if sgrep -Eq '^fstab: PARTUUID=86aec534-0899-c941-fb08-5f840bf4cdbb \(nvme0n1p2\) on /mnt: ext2, read-write, write-(back|through)$'; then
            held V10 "$id" fstab mounts ls
        else
            bad "V10 $id: no fstab line for PARTUUID=86aec534-…: $(sgrep -m1 '^fstab: ' || echo none)"
        fi
        the_end "$id" "$hrc" fstab
        rm -rf "$dw"

        # --- root: V11 ----------------------------------------------------------
        root_row "$tier" "$leg"
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx6-nvme: PASS" || say "mpx6-nvme: FAIL"
exit "$fail"
