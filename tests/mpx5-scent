#!/usr/bin/env bash
# tests/mpx5-scent — px64: scent, grep in wolf (user/scent.pin,
# tools/mkscent; Track 15, M1 at scent b6f63a4), preinstalled on PAX as
# /bin/scent with /bin/grep a symbolic link to it and its two wrappers as
# /bin/egrep and /bin/fgrep (shell scripts run by /bin/sh, pelt, through
# the kernel's `#!`), typed at the console's shell, held byte for byte to
# the same binaries on Linux and to GNU grep 3.12's answers, as root and
# as `pax`.
#
#   tests/mpx5-scent [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                    [--firmware bios|uefi|both] [--tier native|release|both]
#
# One image, kmain_console with the archive: pelt as /bin/pelt and
# /bin/sh, /bin/scent (unmodified), /bin/grep -> scent (an archive link:
# tools/mkinitramfs' `/PATH->TARGET`, kernel/tree's adoption of it, px64),
# /bin/egrep and /bin/fgrep (scent's wrappers, byte for byte, 0755),
# boreutils' cat env head id ls mkdir readlink tr (user/boreutils.pin),
# /bin/as; /etc (hostname, motd, pax-run), /tmp (1777), /home/pax (0755,
# 1000:1000), an empty /usr/lib (no locale data: nothing under it) and
# the generated fixture at /usr/share/scent (tests/mpx5-scent.d/
# fixture.py). Its run list, one typed session a run
# (user/console/scent.keys, typed twice), prompt `$ `:
#   scent       `/bin/sh -i -m` (root, HOME=/);
#   scent-user  `/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m`
#               (`pax`, the home `su pax` gives).
# The keys define `s`, which runs a command with its standard output and
# standard error to two files, then prints `status N`, the output (NUL as
# @) and `[stderr]` and the error, so each row's status and streams are
# held apart; a few rows are typed bare (pipes, PATH changes, the
# warnings on the terminal).
#
# **The Linux side** is the same binaries typed the same keys in a
# throwaway container (tools/linux-tree: the tree a tmpfs, the link
# copied as a link, the shell on a pseudo-terminal as pid 1 of a fresh
# pid namespace, PAX's environment), as root and through `as 1000 1000`,
# run live.
#
# What is compared, by rule: each run's transcript, from its `run <k>:`
# line to the kernel's `user: frames free` line after it, normalised as a
# serial log is (tools/lib.sh's serial_norm), the kernel's own `user: …`
# lines out, and the runtime's thread id in a panic line typed as `{pid}`
# (R-ct02-6: the one field of scent's abort rows that is not fixed); the
# container's whole transcript, normalised the same way.
#
# Assertions, per tier, firmware and session:
#   A0 build: kmain_console built; pelt, scent, the boreutils and as
#      static (ET_EXEC, no PT_INTERP); scent built twice to one digest
#      (tools/mkscent); the wrappers git's bytes, 0755; /bin/sh in the
#      root; the archive holds bin/grep as a link (read back by a reader
#      of its own: mode 0120777, one link, its data `scent`); the image
#      built; the container's two sessions ran.
#   A1 each session byte-identical to the container's, and its status.
#   A2 the session's own witness (tests/mpx5-scent.d/rows.py, 49 rows):
#      GNU 3.12's answers for every option the contract names (BRE with
#      a backreference, -E classes and alternation, -F punctuation, -i,
#      -v, -c, -n, -b, -o, -w, -x, merged context, -m with context, -e
#      with -f, standard input and files, -z, the binary policy, statuses
#      1 and 2, the -P refusal, conflicting matchers), the wrappers'
#      warnings (--help too) and conflicts, the link and the wrappers
#      after PATH changes, the C locale with no LANG and no locale data,
#      rulings #115-#117's published answers, the argv0 seam and the
#      runtime's abort on a non-UTF-8 argument (scent's upstream-blocked
#      rows), the -r refusal (M2).
#   A3 -ENOSYS only for set_robust_list (273) and rseq (334); no
#      `refused:` line; `PAX: init /bin/sh ended with status 0; nothing
#      left to run`, `halt`, held halted.
# A2 is each run's own witness: the container runs the same binaries, so
# a break of both sides leaves A1 green and turns A2; a kernel break of
# PAX's alone (the link, a `#!` line, a byte of a read) turns A1.
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only=
usage="usage: tests/mpx5-scent [--images DIR | --no-boot | --only build | --only linux --images DIR] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3

KEYS=$PAX_ROOT/user/console/scent.keys
ROWS=$here/mpx5-scent.d/rows.py
BORE="cat env head id ls mkdir readlink tr" # boreutils in the image (user/boreutils.pin)
RUNS=("/bin/sh -i -m" "/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m")
NAMES=(scent scent-user)

work=$PAX_BUILD/mpx5-scent
runs=$PAX_BUILD/mpx5-scent-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The runtime's thread id in a panic line, typed (R-ct02-6).
pid_norm() { LC_ALL=C sed -E "s/^thread '<unnamed>' \\([0-9]+\\) panicked at /thread '<unnamed>' ({pid}) panicked at /" "$1"; }

# The archive's entry for NAME, read by this reader (not by
# tools/mkinitramfs's code): "mode nlink size data" or nothing.
cpio_entry() { # archive name
    python3 - "$1" "$2" <<'PY'
import sys
buf = open(sys.argv[1], "rb").read()
want = sys.argv[2]
o = 0
while o + 110 <= len(buf):
    assert buf[o:o + 6] in (b"070701", b"070702"), "not newc at %d" % o
    f = [int(buf[o + 6 + 8 * k:o + 14 + 8 * k], 16) for k in range(13)]
    mode, nlink, size, ns = f[1], f[4], f[6], f[11]
    name = buf[o + 110:o + 110 + ns - 1].decode()
    d = (o + 110 + ns + 3) & ~3
    if name == "TRAILER!!!":
        break
    if name == want:
        print("%o %d %d %s" % (mode, nlink, size, buf[d:d + size].decode("latin-1")))
        break
    o = (d + size + 3) & ~3
PY
}

# The container's two sessions, root's and the user's.
linux_side() { # dir -> reasons on stdout
    mkdir -p "$1/linux"
    local k a0
    for k in 0 1; do
        # shellcheck disable=SC2086 # the run line's words, as the kernel splits them
        set -- "$1" ${RUNS[$k]}
        a0=$2
        if "$PAX_ROOT/tools/linux-tree" --root "$1/root" --keys "$KEYS" --prompt '$ ' --argv0 "$a0" --size 512m --rdev --nsproc \
            --owners "$1/owners" "$1/linux/${NAMES[$k]}.tty" -- "${@:2}"; then
            say "  linux ${NAMES[$k]}: $(wc -c < "$1/linux/${NAMES[$k]}.tty" | tr -d ' ') bytes, status $(cat "$1/linux/${NAMES[$k]}.tty.rc")"
        else
            printf ' tools/linux-tree %s;' "${NAMES[$k]}"
        fi
    done
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS A0 (linux): the Linux side ran in a throwaway container" || bad "A0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/bin" "$r/etc" "$r/home/pax" "$r/tmp" "$r/usr/lib" "$work/bin"
    why=
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" || why+=" tools/mkpelt;"
    "$PAX_ROOT/tools/mkscent" "$work/scent" > "$work/scent.txt" || why+=" tools/mkscent;"
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE > "$work/bore.txt" || why+=" tools/mkboreutils;"
    "$PAX_ROOT/tools/mkas" "$work/bin" > "$work/as.txt" || why+=" tools/mkas;"
    python3 "$here/mpx5-scent.d/fixture.py" "$r/usr/share/scent" > "$work/fixture.txt" || why+=" the fixture;"
    cp "$work/pelt/pelt" "$r/bin/pelt" 2>/dev/null || why+=" no pelt;"
    cp "$work/pelt/pelt" "$r/bin/sh" 2>/dev/null || true
    cp "$work/scent/scent" "$r/bin/scent" 2>/dev/null || why+=" no scent;"
    for u in egrep fgrep; do
        cp -p "$work/scent/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"
        [ "$(stat -c %a "$r/bin/$u" 2>/dev/null)" = 755 ] || why+=" $u is not 0755;"
    done
    ln -s scent "$r/bin/grep" || why+=" no link;"
    for u in $BORE; do cp "$work/bore/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"; done
    cp "$work/bin/as" "$r/bin/as" 2>/dev/null || why+=" no as;"
    for f in "$r"/bin/*; do
        [ -L "$f" ] && { say "  program: ${f#"$r"/} -> $(readlink "$f")"; continue; }
        case ${f##*/} in egrep|fgrep) say "  wrapper: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"; continue ;; esac
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    # The wrappers need /bin/sh: it is in this root, and it is pelt.
    [ -x "$r/bin/sh" ] && cmp -s "$r/bin/sh" "$r/bin/pelt" || why+=" /bin/sh is not pelt in the root;"
    for u in egrep fgrep; do
        [ "$(head -n 1 "$r/bin/$u" 2>/dev/null)" = "#!/bin/sh" ] || why+=" $u does not start #!/bin/sh;"
    done
    # The tree the session greps: /etc, the fixture (the same in the
    # archive and in the container's root).
    printf '%s\n' "${RUNS[@]}" > "$r/etc/pax-run"
    printf 'pax\n' > "$r/etc/hostname"
    printf 'PAX: scent at the console (px64)\n' > "$r/etc/motd"
    printf '%s\n' '/tmp 1777 0 0' '/home/pax 755 1000 1000' > "$work/owners"
    args=(/tmp/:1777 /home/pax/:755:1000:1000 /usr/lib/:755 /bin/grep-\>scent
        /etc/pax-run="$r/etc/pax-run":644 /etc/hostname="$r/etc/hostname":644 /etc/motd="$r/etc/motd":644)
    for f in "$r"/usr/share/scent/*; do
        m=644; [ -x "$f" ] && m=755
        args+=("/usr/share/scent/${f##*/}=$f:$m")
    done
    for f in "$r"/bin/*; do [ -L "$f" ] || args+=("/bin/${f##*/}=$f:755"); done
    "$PAX_ROOT/tools/mkinitramfs" "$work/scent.cpio" "${args[@]}" > "$work/scent.initramfs.txt" || why+=" tools/mkinitramfs;"
    e=$(cpio_entry "$work/scent.cpio" bin/grep)
    [ "$e" = "120777 1 5 scent" ] || why+=" the archive's bin/grep is '$e', not a link to scent (120777 1 5 scent);"
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                --add "$work/scent.cpio" initramfs.cpio "$elf" "$work/$tier/scent.iso" >/dev/null || why+=" $tier: mkimage;"
            say "built $tier scent: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/scent.iso"), initramfs $(sha256_of "$work/scent.cpio")"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS A0 (build): kmain_console built ($tiers), every program static, scent twice to one digest, the wrappers and /bin/sh in place, bin/grep an archive link, the image built" || bad "A0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS A0: kmain_console built ($tiers), every program static, scent twice to one digest, the wrappers and /bin/sh in place, bin/grep an archive link, the image built, the Linux side ran in a throwaway container" || bad "A0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx5-scent build (A0): PASS (no boot: --no-boot)" || say "mpx5-scent build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux
for n in "${NAMES[@]}"; do
    [ -f "$lx/$n.tty" ] || { bad "A0 linux $n: no $lx/$n.tty (build first, and run the Linux side)"; continue; }
    serial_norm "$lx/$n.tty" > "$lx/$n.norm"
    pid_norm "$lx/$n.norm" > "$lx/$n.cmp"
done

# Run k's transcript: from its `run <k>:` line to the kernel's `user:
# frames free …` line after it, the kernel's own lines left out
# (tests/mpx5-jobs' rule).
run_part() { # norm k
    awk -v k="$2" '
        $0 ~ "^run " k ": " { on = 1; next }
        on && /^run [0-9]+: |^run: [0-9]+ commands$|^user: frames free / { exit }
        on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$1"
}

record() { # tier leg status
    ran=$((ran + 1))
    printf '%s kmain_console %s scent halt-status=%s accel=%s serial=%s iso=%s\n' "$1" "$2" "$3" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" "$(sha256_of "$iso")" >> "$runs"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        id="$tier $leg scent"
        log=$PAX_BUILD/mpx5-scent-$tier-$leg.serial.log
        elf=$images/$tier/kmain_console.elf iso=$images/$tier/scent.iso
        rm -f "$log" "$log.verdict" "$log.typed"
        if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
            bad "A3 $id: no image"
            continue
        fi
        cat "$KEYS" "$KEYS" > "$images/scent.keys"
        hrc=0
        "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 900 --qemu -m --qemu 1024M \
            --elf "$elf" --marker 'halt|PANIC .*' --type "$images/scent.keys" --prompt '$ ' "$iso" >"$log.verdict" 2>&1 || hrc=$?
        record "$tier" "$leg" "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        for k in 0 1; do
            n=${NAMES[$k]}
            out=$PAX_BUILD/mpx5-scent-$tier-$leg-$n.session
            run_part "$norm" $((k + 1)) > "$out"
            serial_norm "$out" > "$out.norm"
            pid_norm "$out.norm" > "$out.cmp"
            # A1: the container's session.
            why=
            if [ -f "$lx/$n.cmp" ]; then
                cmp -s "$lx/$n.cmp" "$out.cmp" || why+=" the session differs from the container's: $(diff "$lx/$n.cmp" "$out.cmp" | head -n 14 | cut -c1-300 | tr '\n' '|');"
            else
                why+=" no container session;"
            fi
            [ "$(wc -l < "$out.cmp" | tr -d ' ')" -gt 100 ] || why+=" a short session;"
            [ -z "$why" ] && say "PASS A1 $id $n: $(wc -l < "$out.cmp" | tr -d ' ') lines byte-identical to the container's ($(sha256_of "$out.cmp" | cut -c1-12)…)" || bad "A1 $id $n:$why"
            # A2: the session's own witness (its thread ids as printed).
            why=$(python3 "$ROWS" "$out.norm")
            [ -z "$why" ] && say "PASS A2 $id $n: the $(python3 -c 'import runpy, sys; print(len(runpy.run_path(sys.argv[1])["ROWS"]))' "$ROWS") rows (GNU 3.12's answers, rulings #115-#117, the upstream rows, the wrappers, the link, PATH, the C locale)" || bad "A2 $id $n:$why"
        done
        # A3: what PAX lacks; nothing refused; the end.
        why=
        ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$norm" | sort -un | paste -sd' ' -)
        [ "$ns" = "273 334" ] || why+=" -ENOSYS for '$ns', not '273 334';"
        rf=$(grep -c ': refused: ' "$norm")
        [ "$rf" = 0 ] || why+=" $rf refused lines ($(grep -m1 ': refused: ' "$norm" | cut -c1-160));"
        grep -qx "PAX: init /bin/sh ended with status 0; nothing left to run" "$norm" \
            || why+=" no 'PAX: init /bin/sh ended with status 0' ($(grep -m1 '^PAX: init ' "$norm"));"
        pn=$(grep -m1 '^PANIC ' "$norm")
        [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
        [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
        [ -z "$why" ] && say "PASS A3 $id: -ENOSYS only for 273 and 334; nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "A3 $id:$why"
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx5-scent: PASS" || say "mpx5-scent: FAIL"
exit "$fail"
