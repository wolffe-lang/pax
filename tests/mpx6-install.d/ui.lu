fn main() -> int {
    let targets = [
        Target {
            name: "vda",
            identity: "254:0-seq1",
            bytes: 536870912,
            sector: 512,
            readonly: false,
            mounted: true,
            running_root: true,
        },
        Target {
            name: "vdb",
            identity: "254:16-seq2",
            bytes: 536870912,
            sector: 512,
            readonly: false,
            mounted: false,
            running_root: false,
        },
    ]
    // px78: the page judges each disk; vda (the running root) is refused
    // before the list is read, vdb is on it. px78b: vdb has a model, so
    // the one confirmation names it with its serial.
    let list = parse_allow_list("model=Samsung SSD 860 serial=PX71-VDB\n", "ui witness")
    var disks = List[Disk]()
    let models = ["", "Samsung SSD 860"]
    let serials = ["PX71-VDA", "PX71-VDB"]
    for i in 0..targets.len {
        let t = copy targets[i]
        (mut disks).push(Disk {
            target: copy t,
            model: models[i],
            serial: serials[i],
            part1: "",
            part1_at: 0,
            live: false,
            layout: "no partitions",
            reason: judge(t, models[i], serials[i], false, list),
        })
    }
    var lg = no_log("ui witness: no stick")
    let p = guided_plan(mut lg, disks, "test") else |e| { print("UI result {e}"); return 1 }
    print("UI confirmed {p.target.name} {p.user} {p.games}")
    0
}
