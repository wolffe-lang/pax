//! Exercise the installer's actual temporary-file inspection on a damaged
//! volume, not a mock of the error. The host supplies the ext2 fixture.
fn main() -> int {
    let a = env_args()
    if a.len != 1 { return 2 }
    let tmp = tmp_of(a[0]) else |e| {
        print("PASS temporary-refused: {a[0]}.pax-tmp: {e}")
        return 0
    }
    print("FAIL temporary-refused: damaged name accepted as {tmp}")
    1
}
