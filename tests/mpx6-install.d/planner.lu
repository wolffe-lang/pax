//! Planner's independent arithmetic and refusal witnesses; no devices opened.

fn target(name: str, bytes: int) -> Target {
    Target {
        name: name,
        identity: "254:16-seq2",
        bytes: bytes,
        sector: 512,
        readonly: false,
        mounted: false,
        running_root: false,
    }
}

fn verdict(t: Target, user: str, games: str) -> str {
    let _p = make_plan(t, "test", user, games) else |e| { return "{e}" }
    "ok"
}

fn confirmation_verdict(p: Plan, t: Target, token: str) -> str {
    confirm_plan(p, t, token) else |e| { return "{e}" }
    "ok"
}

fn identity_check(actual: str, expected: str) {
    if actual != expected {
        eprint("FAIL I-identity: expected {expected}, got {actual}")
        os_exit(1)
    }
}

fn main() {
    let t = target("vdb", 536870912)
    let p = make_plan(t, "test", "pax", "yes") else |_| { assert(false); return }
    assert(p.root_bytes == 467644416)
    assert(p.tail_bytes == 20480)
    assert(ROOT_START + p.root_bytes + p.tail_bytes == t.bytes)
    assert(plan_text(p).contains("NO journal"))
    print("PASS I-layout: exact 512 MiB plan, no hidden capacity")
    let minimum = ROOT_START + ROOT_MIN + 33 * 512
    let maximum = ROOT_START + ROOT_MAX + 33 * 512
    assert(verdict(target("vdb", minimum), "pax", "no") == "ok")
    assert(verdict(target("vdb", minimum - 512), "pax", "no") == "too_small")
    assert(verdict(target("vdb", maximum), "pax", "no") == "ok")
    assert(verdict(target("vdb", maximum + 4096), "pax", "no") == "ok")
    assert(verdict(target("vdb", 9223372036854775296), "pax", "no") == "ok")
    for bytes in [8589934592, 68719476736, 500000000000, 4000000000000, 18691697672192, 9223372036854775296] {
        let large = make_plan(target("vdb", bytes), "big", "pax", "no") else |e| {
            eprint("FAIL I-big-plan: {bytes}: {e}"); os_exit(1); return
        }
        let end = (bytes - 33 * 512) / 4096 * 4096
        let available = end - ROOT_START
        let expected = if available < 17592186040320 then available else 17592186040320
        assert(large.root_bytes == expected)
        assert(large.root_bytes % 4096 == 0)
        assert(large.unused_bytes == available - expected)
        assert(large.tail_bytes == bytes - end)
        assert(ROOT_START + large.root_bytes + large.unused_bytes + large.tail_bytes == bytes)
        assert(plan_text(large).contains("unused_bytes {large.unused_bytes}"))
        print("PASS I-big-plan: {bytes} bytes; root {expected}; unused {large.unused_bytes}")
    }
    assert(verdict(target("vdb", -512), "pax", "no") == "too_small")
    assert(verdict(target("vdb", 536870913), "pax", "no") == "sector_size")
    print("PASS I-bounds: exact min/max, tiny, large, signed overflow, alignment")
    var other = copy t
    other.sector = 4096
    assert(verdict(other, "pax", "yes") == "sector_size")
    other = copy t
    other.running_root = true
    assert(verdict(other, "pax", "yes") == "running_root")
    other = copy t
    other.mounted = true
    assert(verdict(other, "pax", "yes") == "mounted")
    other = copy t
    other.readonly = true
    assert(verdict(other, "pax", "yes") == "readonly")
    print("PASS I-refusals: running root, mounted, read-only, unsupported sector")
    assert(confirmation_verdict(p, t, "") == "unconfirmed")
    assert(confirmation_verdict(p, t, "yes") == "unconfirmed")
    assert(confirmation_verdict(p, t, p.token) == "ok")
    other = copy t
    other.name = "vdbb"
    identity_check(confirmation_verdict(p, other, p.token), "changed")
    other = copy t
    other.identity = "254:16-seq3"
    identity_check(confirmation_verdict(p, other, p.token), "changed")
    other = copy t
    other.bytes += 512
    identity_check(confirmation_verdict(p, other, p.token), "changed")
    other = copy t
    other.mounted = true
    identity_check(confirmation_verdict(p, other, p.token), "changed")
    print("PASS I-identity: similar name, changed identity/capacity/mount, exact token")
    assert(verdict(t, "pax", "") == "invalid")
    assert(verdict(t, "pax", "y") == "invalid")
    assert(verdict(t, "root", "no") == "invalid")
    assert(verdict(t, "../escape", "yes") == "invalid")
    assert(verdict(t, "name:0", "yes") == "invalid")
    assert(verdict(t, "pax", "no") == "ok")
    print("PASS I-answers: explicit games yes/no and bounded account name")
    // px78b: the one confirmation's size, decimal GB, TB from 1000.0 GB,
    // one decimal, the nearest tenth; never an overflow near INT_MAX.
    assert(size_text(77611520) == "0.1 GB")
    assert(size_text(536870912) == "0.5 GB")
    assert(size_text(500107862016) == "500.1 GB")
    assert(size_text(512110190592) == "512.1 GB")
    assert(size_text(999949999999) == "999.9 GB")
    assert(size_text(999950000000) == "1.0 TB")
    assert(size_text(1000204886016) == "1.0 TB")
    assert(size_text(4000787030016) == "4.0 TB")
    assert(size_text(9223372036854775296) == "9223372.0 TB")
    print("PASS I-size: the summary's size, GB to TB at 1000.0 GB, one decimal, nearest tenth")
    // px78b: the screen's plan has no confirmation line; --dry-run's and
    // the log's end with it, the scripted --install --confirm's token.
    assert(!plan_body(p).contains("confirmation"))
    assert(plan_text(p) == plan_body(p) + "confirmation ERASE /dev/vdb 254:16-seq2 536870912 test\n")
    print("PASS I-plan-record: the screen's plan asks nothing; the record keeps the token")
    // px86: the zero phases, after the table and before any formatter or
    // Limine, each named by the plan: partition 3 whole (where the 860's
    // old file system made Limine refuse), the first and last MiB of 1 and
    // 2, the first MiB outside the table and the log, the tail before the
    // backup table. Exact on the 512 MiB plan; on every size disjoint, and
    // clear of the tables, the log and the backup.
    let w = wipes(p)
    assert(w.len == 4)
    assert(w[0].phase == "zero-bios" && w[1].phase == "zero-esp" && w[2].phase == "zero-root" && w[3].phase == "zero-gap")
    assert(wipe_text(w[0]) == "zero-bios [1048576,2097152)")
    assert(wipe_text(w[1]) == "zero-esp [2097152,3145728) [68157440,69206016)")
    assert(wipe_text(w[2]) == "zero-root [69206016,70254592) [535801856,536850432)")
    assert(wipe_text(w[3]) == "zero-gap [17408,65536) [131072,1048576) [536850432,536854016)")
    for x in w { assert(plan_body(p).contains(wipe_text(x) + " (")) }
    // A disk whose tail is the backup table alone has no slack range.
    let snug = make_plan(target("vdb", 536850432 + 16896), "test", "pax", "no") else |_| { assert(false); return }
    assert(wipe_text(wipes(snug)[3]) == "zero-gap [17408,65536) [131072,1048576)")
    for bytes in [ROOT_START + ROOT_MIN + 33 * 512, 536867328, 1000204886016, 4000787030016, 18691697672192] {
        let q = make_plan(target("vdb", bytes), "big", "pax", "no") else |_| { assert(false); return }
        var spans = List[List[int]]()
        for x in wipes(q) { for r in x.ranges { (mut spans).push(copy r) } }
        for i in 0..spans.len {
            let at = spans[i][0]
            let len = spans[i][1]
            assert(len > 0)
            assert(at >= 17408 && at + len <= bytes - 16896)
            assert(at + len <= 65536 || at >= 131072)
            for j in 0..spans.len {
                let other = spans[j][0]
                let other_len = spans[j][1]
                if i != j { assert(at + len <= other || other + other_len <= at) }
            }
        }
        print("PASS I-wipe-span: {bytes} bytes: {spans.len} disjoint ranges clear of the tables, the log and the backup")
    }
    print("PASS I-wipe-plan: the zero phases' exact ranges, each named by the plan")
}
