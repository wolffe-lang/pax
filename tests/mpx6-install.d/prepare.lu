fn main() -> int {
    assert(payload_location_ok("/", "/usr/share/pax-install"))
    assert(!payload_location_ok("/", "/payload"))
    assert(!payload_location_ok("/source", "/source/payload"))
    assert(payload_location_ok("/source", "/payload"))
    assert(payload_location_ok("/source", "/source/usr/share/pax-install"))
    let a = env_args()
    // px106 (R-px106-6 B3): `groups FILE NAME` prints sudo_member's answer for FILE's text, or
    // `refused: TAG` and exits 3.
    if a.len == 3 && a[0] == "groups" {
        let text = fs_read_text(a[1]) else |_| { return 2 }
        let out = sudo_member(text, a[2]) else |e| match e {
            gid_taken => {
                print("refused: gid_taken")
                return 3
            },
            sudo_gid => {
                print("refused: sudo_gid")
                return 3
            },
        }
        print_raw(out)
        return 0
    }
    if a.len != 5 { return 2 }
    let t = Target {
        name: "vdb",
        identity: "254:16-seq2",
        bytes: 536870912,
        sector: 512,
        readonly: false,
        mounted: false,
        running_root: false,
    }
    let p = make_plan(t, "test", a[3], a[4]) else |e| { eprint("prepare: {e}"); return 1 }
    boot_assets(a[0], a[1]) else |e| { eprint("prepare: {e}"); return 1 }
    let games = staged_games(a[1]) else |e| { eprint("prepare: {e}"); return 1 }
    let rows = source_snapshot(a[0]) else |e| { eprint("prepare: {e}"); return 1 }
    stage_snapshot(a[0], a[2], "{a[2]}.attrs", rows) else |e| { eprint("prepare: {e}"); return 1 }
    configure_tree(p, a[2], "{a[2]}.attrs", games, "") else |e| { eprint("prepare: {e}"); return 1 }
    // px114: the install's manifest, as execute_plan writes it after configure_tree.
    install_manifest(a[0], a[2], "{a[2]}.attrs", rows) else |e| { eprint("prepare: {e}"); return 1 }
    0
}
