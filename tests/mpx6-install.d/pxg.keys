echo PXG-VERSION-BEGIN; /bin/pxg version; echo PXG-VERSION-END=$?
echo PXG-COMPARE-BEGIN; /bin/pxg compare '1~rc-1' '1-1'; echo PXG-COMPARE-END=$?
echo PXG-INSTALL-BEGIN; /bin/pxg install --root / alpha; echo PXG-INSTALL-END=$?
echo PXG-REMOVE-BEGIN; /bin/pxg remove --root / alpha; echo PXG-REMOVE-END=$?
echo PXG-UPGRADE-BEGIN; /bin/pxg upgrade --root /; echo PXG-UPGRADE-END=$?
echo PXG-INIT-BEGIN; /bin/pxg init --root /home/pax --repo file:///missing-pxg-repository --pinned-root /missing-pxg-trust-root --arch x86_64 --slot default --now 2026-11-13T00:00:00Z; echo PXG-INIT-END=$?
test ! -e /home/pax/var; echo PXG-NO-STATE=$?
cat /etc/pax-release
