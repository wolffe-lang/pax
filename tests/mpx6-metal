#!/usr/bin/env bash
# tests/mpx6-metal — the clocks a firmware may or may not give (px76, run
# by tests/mpx6-firmware as its F1).
#
# kernel/kmain_metal.lu on five machines per firmware: q35 as it is (the
# HPET), --no-hpet (the ACPI PM timer), --no-pit (q35's pit=off: QEMU 8.2
# and 11.1 both offer it), --no-hpet --no-pit, and -m 8G (memory above
# 4 GiB); and on UEFI a sixth, `-machine acpi=off`, where OVMF leaves
# only its own XSDT and BGRT (no HPET table, no FADT, so no PM timer) and
# the clock is the PIT (`metal_pitonly`: the 20 ticks timed by q35's HPET
# read directly at 0xfed00000; SeaBIOS supplies its own tables under
# acpi=off, so its machine is the first one again). On each the kernel
# reads ACPI (at least one table checked, but on the PIT-only machine),
# chooses its clock (`clock: HPET …, checked against the PM timer` on
# the HPET's machines, `clock: PM 3579545 Hz` without one), calibrates
# the local APIC tick against that clock (`timer: LAPIC calibrated by
# HPET|PM|PIT …`, the same name), and 20 of its ticks take 150-300 ms by
# a reference read independently (`PASS METAL LAPIC tick rate …`).
#
# PAX_METAL_X2APIC=1 adds the x2apic leg (R-px76-7): the kernel switches
# the local APIC to x2APIC mode before starting it (`metal_x2apic`, as a
# firmware may hand it over), under `-cpu max,+x2apic`. It is a hand leg:
# QEMU 8.2.2's TCG (CI's) refuses the CPUID bit (`TCG doesn't support
# requested feature: CPUID.01H:ECX.x2apic`), and the kernel then stops by
# name (`FAIL METAL x2APIC offered by CPUID`).
#
# px85 (pax#260): five more legs on q35 as it is, each a word on the
# kernel's command line (kernel/clock's test words). The HPET's check
# against the PM timer must survive a stall, as of a vCPU or an SMI,
# since both clocks count on through it: 30 ms inside the measured window
# (stall-window), 30 ms between the window's last PM read and its HPET
# read (stall-edge), 5 s inside it, past the 24-bit PM timer's wrap
# (stall-long); each still ends `checked against the PM timer`, and the
# kernel's `metal: the HPET's check measured …` line shows the stall was
# met where it was put: stall-edge took the bracket the stall widened
# again (`1 across the stall`; under TCG a plain boot also retakes its
# first bracket once, while QEMU translates the loop), stall-long measured
# a second window (`1 too long`: over 2 s is no verdict). And it
# must still refuse an HPET whose period lies by a quarter or a fifth
# (hpet-fast: read 1.25 times, hpet-slow: 0.8 times), which the old
# 5-20 ms band let through: `clock: HPET … refused`, then the PM timer.
#
# px107 (pax#293): three legs of kernel/clock's own (more test words). A
# reading of a 64-bit counter below the one before is no time passing,
# never a wrap: clock-behind (q35 as it is, the HPET's readings 5 * 2^32
# up) feeds now_ns a reading one high word behind (the shape of a torn
# read, HPET 1.0a §2.4.7) and a reading of all ones (an absent device's),
# and requires the answers monotonic, 20 ticks in 150-300 ms across the
# first, and both counted (`metal: a reading 2^32 ticks behind …`); then a
# skip of 2^40 ticks must count forward exactly. A true rollover still
# counts forward: clock-32 (the HPET read as a 32-bit counter) and
# clock-pmwrap (--no-hpet: the PM timer's 24 bits) each put the counter
# 100 ms before its rollover, and across 20 ticks the clock must agree
# with the PM timer read directly within 2% and have counted the
# rollover; then the largest step the mask allows (a reading one behind
# the last) must count forward exactly. And the read itself: clock-torn
# puts the HPET's counter 50 us before its low word rolls over, 20000
# times (halted, written, enabled again), and reads it across each
# through the clock's own read: none may be below the one before (HPET
# 1.0a §2.4.7's note: a 64-bit read may be broken into two 32-bit ones;
# QEMU 8.2's is, its low half first, so one 8-byte load is torn in 14% of
# such crossings under TCG and 0.1-0.5% under KVM). Every `metal: step` line's
# nanoseconds are held here to its ticks times the source's period
# (exact, or one more for the carried fraction).
#
# px107 (pax#308): the tick's calibration under a stall. A boot under KVM
# calibrated the LAPIC at 89527688 Hz, 1.433 times the rate, and its
# clock, sleeps and timeouts ran at 0.70 of real time. timer-stall makes
# the clock stand still 8.6 ms inside the calibration (one reading 8.6 ms
# ahead, the readings behind it taken as no time passing) and requires
# the tick timed by the PM timer read directly: 50 ticks in 500 ms within
# 0.5% (`metal: 50 ticks of 10 ms in <us> us by the PM timer`), and the
# stalled window set aside by name (`timer: LAPIC calibration: window <k>
# set aside …`). The rate row every leg has (20 ticks in 150-300 ms) lets
# a 1.433 times tick through. timer-stall-nopm is the same stall with the
# PM timer hidden from the calibration (a machine without one): the
# agreement rule alone must catch it (`windows 1 and 2 disagree`) and the
# boot must say it had nothing beside the clock to hold windows to.
#
# PAX_METAL_TIER (native, release) and PAX_METAL_FIRMWARE ("bios uefi")
# choose the build and the firmwares (tests/mpx6-firmware sets both);
# PAX_METAL_LEGS (px107), when set, the legs, by name (a plant's run, or
# one leg's witness).
# A failing machine prints its `FAIL METAL`/`PANIC` lines by name.
set -euo pipefail
flags=()
[ "${PAX_METAL_TIER:-native}" != release ] || flags=(--release)
. "$(dirname "$0")/../tools/lib.sh"
work=$PAX_BUILD/mpx6-metal
mkdir -p "$work"
"$PAX_ROOT/tools/fetch-limine"
"$PAX_ROOT/tools/build-kernel" "${flags[@]}" --src "$PAX_ROOT/kernel/kmain_metal.lu" "$work"
"$PAX_ROOT/tools/mkimage" "$work/kmain_metal.elf" "$work/check.iso"
cp "$PAX_ROOT/boot/limine.conf" "$work/x2apic.conf"
printf '\n    cmdline: metal_x2apic\n' >> "$work/x2apic.conf"
"$PAX_ROOT/tools/mkimage" --conf "$work/x2apic.conf" "$work/kmain_metal.elf" "$work/x2apic.iso"
cp "$PAX_ROOT/boot/limine.conf" "$work/pitonly.conf"
printf '\n    cmdline: metal_pitonly\n' >> "$work/pitonly.conf"
"$PAX_ROOT/tools/mkimage" --conf "$work/pitonly.conf" "$work/kmain_metal.elf" "$work/pitonly.iso"
for word in stall_window stall_edge stall_long hpet_fast hpet_slow clock_behind clock_torn clock_32 clock_pmwrap timer_stall timer_stall_nopm; do
    cp "$PAX_ROOT/boot/limine.conf" "$work/$word.conf"
    printf '\n    cmdline: metal_%s\n' "$word" >> "$work/$word.conf"
    "$PAX_ROOT/tools/mkimage" --conf "$work/$word.conf" "$work/kmain_metal.elf" "$work/$word.iso"
done
fail() { # leg why
    grep -aE '^(FAIL METAL|PANIC|clock:|timer:|metal: 50 ticks)' "$work/$1.log" | tr -d '\r' >&2 || true
    echo "FAIL METAL firmware $1: $2" >&2
    exit 1
}
for fw in ${PAX_METAL_FIRMWARE:-bios uefi}; do
    legs='hpet pm pitless pm-pitless ram8 stall-window stall-edge stall-long hpet-fast hpet-slow clock-behind clock-torn clock-32 clock-pmwrap timer-stall timer-stall-nopm'
    [ "$fw" != uefi ] || legs="$legs pitonly"
    [ "${PAX_METAL_X2APIC:-0}" != 1 ] || legs="$legs x2apic"
    [ -z "${PAX_METAL_LEGS:-}" ] || legs=$PAX_METAL_LEGS
    for leg in $legs; do
        args=() qargs=() iso=$work/check.iso
        source=HPET
        case $leg in
            x2apic) iso=$work/x2apic.iso; qargs=(-cpu max,+x2apic);;
            pitonly) iso=$work/pitonly.iso; qargs=(-machine acpi=off); source=PIT;;
            pm) args=(--no-hpet); source=PM;;
            pitless) args=(--no-pit);;
            pm-pitless) args=(--no-hpet --no-pit); source=PM;;
            ram8) qargs=(-m 8G);;
            stall-*) iso=$work/stall_${leg#stall-}.iso;;
            hpet-*) iso=$work/hpet_${leg#hpet-}.iso; source=PM;;
            clock-behind) iso=$work/clock_behind.iso;;
            clock-torn) iso=$work/clock_torn.iso;;
            clock-32) iso=$work/clock_32.iso;;
            clock-pmwrap) iso=$work/clock_pmwrap.iso; args=(--no-hpet); source=PM;;
            timer-stall) iso=$work/timer_stall.iso;;
            timer-stall-nopm) iso=$work/timer_stall_nopm.iso;;
        esac
        rc=0
        "$PAX_ROOT/tools/qemu-run" --timeout 30 --firmware "$fw" --serial "$work/$fw-$leg.log" ${args[@]+"${args[@]}"} "$iso" -- ${qargs[@]+"${qargs[@]}"} || rc=$?
        [ "$rc" = 33 ] || fail "$fw-$leg" "exit $rc, not 33"
        grep -aqF 'PASS METAL LAPIC tick rate' "$work/$fw-$leg.log" || fail "$fw-$leg" "no tick rate row"
        grep -aq "^clock: $source " "$work/$fw-$leg.log" || fail "$fw-$leg" "the clock is not the $source"
        grep -aq "^timer: LAPIC calibrated by $source " "$work/$fw-$leg.log" || fail "$fw-$leg" "the tick was not calibrated by the $source"
        [ "$source" != HPET ] || grep -aq '^clock: HPET .*, checked against the PM timer' "$work/$fw-$leg.log" || fail "$fw-$leg" "the HPET was not checked against the PM timer"
        [ "$leg" != x2apic ] || grep -aq '^apic: x2APIC mode ' "$work/$fw-$leg.log" || fail "$fw-$leg" "the tick did not run in x2APIC mode"
        case $leg in hpet-*) grep -aq '^clock: HPET .*; refused' "$work/$fw-$leg.log" || fail "$fw-$leg" "the lying HPET was not refused by name";; esac
        case $leg in
            stall-edge) grep -aqE "^metal: the HPET's check measured 1 window\(s\), 0 too long, and took [1-9][0-9]* bracket\(s\) again, 1 across the stall" "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "the stall inside the closing bracket did not make the check take it again";;
            stall-long) grep -aqE "^metal: the HPET's check measured 2 window\(s\), 1 too long, " "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "the 5 s window was not measured again";;
        esac
        case $leg in
            clock-behind) tr -d '\r' < "$work/$fw-$leg.log" | grep -aqE '^metal: a reading 2\^32 ticks behind .*; 1 reading\(s\) taken as no time passing$' \
                || fail "$fw-$leg" "the reading behind was not taken as no time passing";;
            clock-32|clock-pmwrap) grep -aqE '^metal: across a rollover of the .*; rollovers [1-9]' "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "no rollover counted across the window";;
            clock-torn) grep -aqE '^metal: the HPET read across 20000 rollovers of its low word: [0-9]+ read across, 0 torn, ' "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "a reading of the HPET was torn across a rollover";;
            timer-stall) grep -aqE '^PASS METAL the tick: 50 in 500 ms within 0.5% by the PM timer' "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "the tick was not timed within 0.5% by the PM timer"
                grep -aqE '^timer: LAPIC calibration: window [0-9]+ set aside' "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "the calibration did not set the stalled window aside by name";;
            timer-stall-nopm) grep -aqE '^PASS METAL the tick: 50 in 500 ms within 0.5% by the PM timer' "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "the tick was not timed within 0.5% by the PM timer"
                grep -aqE '^timer: LAPIC calibration: windows 1 and 2 disagree: ' "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "the agreement rule alone did not catch the stalled window"
                grep -aqE '^timer: LAPIC calibration: no second counter beside the HPET ' "$work/$fw-$leg.log" \
                || fail "$fw-$leg" "the boot did not say it had nothing beside the clock";;
        esac
        case $leg in
            clock-behind|clock-32|clock-pmwrap)
                why=$(tr -d '\r' < "$work/$fw-$leg.log" | python3 -I -c '
import re, sys
n = 0
lines = sys.stdin.read().splitlines()
fs = [int(x) for l in lines for x in re.findall(r"^clock: HPET (\d+) fs/tick", l)]
for l in lines:
    m = re.match(r"metal: step (\w+) (HPET|PM) from 0x([0-9a-f]+) to 0x([0-9a-f]+) mask 0x([0-9a-f]+) read as (\d+) ns$", l.strip())
    if not m:
        continue
    n += 1
    a, b, k, ns = int(m.group(3), 16), int(m.group(4), 16), int(m.group(5), 16), int(m.group(6))
    d = (b - a) & k
    want = d * fs[-1] // 10**6 if m.group(2) == "HPET" and fs else d * 10**9 // 3579545
    if ns not in (want, want + 1):
        print("step %s: %d ticks read as %d ns, not %d" % (m.group(1), d, ns, want))
if n != 1:
    print("%d step lines, not 1" % n)
') || why="python3 failed"
                [ -z "$why" ] || fail "$fw-$leg" "$why";;
        esac
        tr -d '\r' < "$work/$fw-$leg.log" | grep -aE '^(clock|timer|metal): |^apic: x2APIC|^PASS METAL LAPIC tick rate'
        echo "PASS METAL firmware $fw $leg"
    done
done
