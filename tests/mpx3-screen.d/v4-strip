#!/usr/bin/env bash
# tests/mpx3-screen.d/v4-strip FILE — V4's view of a boot's serial log (tests/mpx3-screen): every line from `PAX:
# the screen` on but those that say what the display device changed (`screen:` and `scroll:`, the screen's own
# report; `paging:`, Limine's own page tables sit elsewhere when it sets a display mode; the pattern's two
# full-width rows), with the firmware's description of the machine folded where the display device is part of
# it (R-px76-9 A): the root table's and the DSDT's lengths and the memory map's numbers become <n>, and UEFI's
# boot graphics table (BGRT) is left out. px129: and kernel/timer's calibration lines that a host's timing
# decides: a line for each window it set aside and each pair of windows that disagreed, and when it has printed
# one, the pair that then agreed, or that none did (its header names them `timer: LAPIC calibration: …`). Those
# four forms, whole lines and nothing else, are left out; the line naming the clock and the rate the calibration
# took stays (its rate folded).
set -u
awk '/^PAX: the screen$/ { on = 1 } on && !/^screen: / && !/^scroll: / && !/^paging: / && !/^acpi: BGRT / && !/^\[=+\]$/ && !/^-+\+.?Z$/ && !/^timer: LAPIC calibration: (window [0-9]+ set aside: [0-9]+ Hz, the clock [0-9]+ us against the PM timer\047s [0-9]+ us|windows [0-9]+ and [0-9]+ disagree: [0-9]+ and [0-9]+ Hz|windows [0-9]+ and [0-9]+ of [0-9]+ agree|no two windows in a row agreed in [0-9]+; took [0-9]+ Hz)$/ { sub(/ divide16 [0-9]+ Hz,/, " divide16 <rate> Hz,"); if ($0 ~ /^acpi: (RSDT|XSDT|DSDT) OEM .* length [0-9]+$/) sub(/ length [0-9]+$/, " length <n>"); if ($0 ~ /^memory: /) gsub(/[0-9]+/, "<n>"); print }' "$1"
