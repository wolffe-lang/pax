#!/usr/bin/env bash
# tests/mpx6-ext2-cache — every inode change ext2 makes reaches the disk
# while the block cache turns over under a write-back mount (px164).
#
#   tests/mpx6-ext2-cache [--kernel ELF] [--rows scene,pressure,modes]
#                         [--firmware bios|uefi|both] [--tier native|release|both]
#
# The rows, the disk and the probe (user/elf/churn.c) are
# tests/mpx6-ext2-cache.d/rows.py's: its header says each. This script
# reads the legs as the other suites do and runs it. KVM is not needed:
# under TCG the boots are slower, the rows the same. Exit 0 when every row
# held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
usage="usage: tests/mpx6-ext2-cache [--kernel ELF] [--rows LIST] [--firmware bios|uefi|both] [--tier native|release|both]"
args=()
while [ $# -gt 0 ]; do
    case $1 in
        --kernel)   args+=(--kernel "$2"); shift 2 ;;
        --rows)     args+=(--rows "$2"); shift 2 ;;
        --firmware) args+=(--firmware "$2"); shift 2 ;;
        --tier)     args+=(--tier "$2"); shift 2 ;;
        *)          die "$usage" ;;
    esac
done
need python3 cc readelf
exec python3 -B "$here/mpx6-ext2-cache.d/rows.py" ${args[@]+"${args[@]}"}
