#!/usr/bin/env python3
# tests/mpx6-ext2-cache — every change ext2 makes to an inode reaches the
# disk while the block cache turns over under a write-back mount (px164).
#
#   tests/mpx6-ext2-cache [--kernel ELF] [--rows LIST] [--firmware bios|uefi]
#
# kernel/block's cache holds at most 512 buffers (2 MiB of 4 KiB blocks)
# and, under write-back, never takes back a dirty metadata buffer before
# its ordered write: on a volume where many inodes change between two of
# the flusher's turns, the buffers the clock hand may take are few, and a
# buffer ext2 has just changed is among them until it is marked dirty. A
# change whose buffer is taken back before it is marked is lost: the disk
# keeps the inode as it was. These rows make such a volume and check every
# inode on the disk afterwards.
#
# The disk: an ext2 volume of 20 GiB (sparse; mke2fs -t ext2 -b 4096 -I
# 256, 256 inodes a group, so the 160 groups' descriptors fill two blocks
# and 12,121 inodes spread over about 50 groups' tables), made by
# e2fsprogs' own mke2fs -d from a tree of 120 directories of 100 small
# files each (/tree/dNNN/fNNN, 64 to 4000 bytes, each file's bytes its
# path's), and /log; every time in it SOURCE_DATE_EPOCH. kmain_console
# mounts it read-write at /mnt (write-back, the default) and runs
# user/elf/churn.c (static, unmodified) as /etc/pax-run, in one boot a row,
# each boot on a fresh copy:
#   scene     `churn scene /mnt/tree /mnt/log/app.log 30`: an appender adds a
#             numbered line to /mnt/log/app.log every 2 ms while the walk
#             reads every file and directory once (each read moves its
#             access time: relatime's rule, the times being equal), then the
#             appender alone until 30 s (the flusher's turns, idle), then
#             sync(2);
#   pressure  the same, after the probe has taken anonymous memory until
#             MemFree is 48 MiB (the cache is not shrunk by it: its buffers
#             are made once and kept);
#   modes     `churn modes /mnt/tree 600`: chmod(2) of every file, one change
#             to one inode each, then sync(2).
# Rows (each boot's, named by its boot: C2-scene, C3-modes, …):
#   C0 build: the probe static, the kernel, the image, the disk clean
#      (e2fsck -fn) before any boot.
#   C1 the boot: the probe's `end` line, `PAX: init /bin/churn ended with
#      status 0`, halted, no PANIC.
#   C2 no ext2 fault line (`ext2: vda: <words>`): a change the cache lost
#      is said there.
#   C3 the inodes: scene and pressure: every file's and every directory's
#      access time moved (none left as the disk was made); modes: every
#      file's mode 0600. Each one not is named by path and inode.
#   C4 scene and pressure: /log/app.log is the appender's lines, every one,
#      in order (the probe's count).
#   C5 e2fsck -fn: clean.
#
# The host's e2fsprogs is the pinned container's (tools/e2fs), or, with
# PAX_E2FS_NATIVE=1 (a runner already inside a pinned toolchain image),
# the image's own. Exit 0 when every row held, 1 otherwise, 2 on a usage
# or tool error.
import argparse
import hashlib
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
NAME = "mpx6-ext2-cache"
EPOCH = 1700000000
DIRS, FILES = 120, 100
ROWS = ("scene", "pressure", "modes")


def say(text):
    print(f"{NAME}: {text}", flush=True)


def die(text):
    say(text)
    sys.exit(2)


def process(argv, **kw):
    argv = list(map(str, argv))
    if argv[0] in ("mke2fs", "debugfs", "e2fsck", "dumpe2fs") and os.environ.get("PAX_E2FS_NATIVE") != "1":
        argv = [str(ROOT / "tools/e2fs"), str(Path(argv[-1]).resolve().parent), *argv]
    return subprocess.run(argv, **kw)


def run(argv, **kw):
    r = process(argv, capture_output=True, text=True, errors="replace", **kw)
    if r.returncode:
        die(f"failed ({r.returncode}): {' '.join(map(str, argv))}\n{r.stdout[-2000:]}\n{r.stderr[-2000:]}")
    return r.stdout


def file_bytes(rel):
    n = 64 + (int(hashlib.sha256(rel.encode()).hexdigest()[:8], 16) % 3937)
    seed = (rel + "\n").encode()
    return (seed * (n // len(seed) + 1))[:n]


class Suite:
    def __init__(self, a):
        self.a = a
        build = Path(os.environ.get("PAX_BUILD", ROOT / "build"))
        self.out = build / NAME
        shutil.rmtree(self.out, ignore_errors=True)
        self.out.mkdir(parents=True)
        self.failed = 0
        self.paths = [f"/tree/d{d:03d}/f{f:03d}" for d in range(DIRS) for f in range(FILES)]
        self.dirs = ["/tree"] + [f"/tree/d{d:03d}" for d in range(DIRS)]

    def row(self, name, ok, why):
        say(("PASS " if ok else "FAIL ") + name + " " + why)
        if not ok:
            self.failed += 1

    def build(self):
        why = []
        probe = self.out / "churn"
        r = subprocess.run(["cc", "-static", "-no-pie", "-O1", "-Wall", "-Wextra", "-Werror",
                            "-Wl,--build-id=none", "-Wl,-z,noexecstack",
                            "-o", probe, ROOT / "user/elf/churn.c"], capture_output=True, text=True)
        if r.returncode:
            die("cc churn.c:\n" + r.stderr)
        hdr = subprocess.run(["readelf", "-hlW", probe], capture_output=True, text=True).stdout
        if not re.search(r"Type: +EXEC", hdr) or "INTERP" in hdr:
            why.append("churn is not a static ET_EXEC")
        self.probe = probe
        if self.a.kernel:
            self.kernel = Path(self.a.kernel)
        else:
            kdir = self.out / "kernel"
            r = subprocess.run([ROOT / "tools/build-kernel", "--src", ROOT / "kernel/kmain_console.lu", kdir],
                               capture_output=True, text=True)
            if r.returncode:
                die("tools/build-kernel:\n" + r.stderr[-3000:])
            self.kernel = Path(r.stdout.strip().splitlines()[-1])
        seed = self.out / "seed"
        for rel in self.paths:
            p = seed / rel.lstrip("/")
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_bytes(file_bytes(rel))
        (seed / "log").mkdir()
        for dirpath, dirnames, filenames in os.walk(seed):
            for n in filenames + dirnames:
                os.utime(os.path.join(dirpath, n), (EPOCH, EPOCH))
        os.utime(seed, (EPOCH, EPOCH))
        self.disk = self.out / "disk.img"
        with self.disk.open("wb") as f:
            f.truncate(20 << 30)
        env = dict(os.environ, E2FSPROGS_FAKE_TIME=str(EPOCH), SOURCE_DATE_EPOCH=str(EPOCH))
        r = process(["mke2fs", "-q", "-F", "-t", "ext2", "-b", "4096", "-I", "256", "-N", str(160 * 256),
                     "-O", "^resize_inode", "-E", "root_owner=0:0", "-L", "pax-churn", "-U",
                     "5ca1ab1e-0000-4000-8000-000000000164", "-d", seed, self.disk],
                    capture_output=True, text=True, env=env)
        if r.returncode:
            die("mke2fs:\n" + r.stdout + r.stderr)
        shutil.rmtree(seed)
        r = process(["e2fsck", "-fn", self.disk], capture_output=True, text=True)
        if r.returncode:
            why.append("the new disk is not clean: " + r.stdout[-400:])
        # The access times as made: a lost change leaves one as it was.
        self.before = self.stats(self.disk, self.paths + self.dirs)
        dump = run(["dumpe2fs", "-h", self.disk])
        groups = re.search(r"^Block count:\s+(\d+)", dump, re.M)
        (self.out / "disk.dumpe2fs").write_text(dump)
        self.row("C0", not why, "; ".join(why) if why else
                 f"churn static, kernel {self.kernel.name}, disk of {len(self.paths)} files in {DIRS} directories, "
                 f"{groups.group(1) if groups else '?'} blocks, clean")
        if why:
            sys.exit(1)

    def boot(self, row, run_line):
        work = self.out / row
        work.mkdir()
        (work / "fstab").write_text("/dev/vda /mnt ext2 defaults 0 0\n")
        (work / "pax-run").write_text(run_line + "\n")
        archive = work / "initramfs.cpio"
        run([ROOT / "tools/mkinitramfs", archive, f"/bin/churn={self.probe}:755", "/mnt/:755", "/tmp/:1777",
             f"/etc/fstab={work / 'fstab'}:644", f"/etc/pax-run={work / 'pax-run'}:644"])
        iso = work / "boot.iso"
        run([ROOT / "tools/mkimage", "--conf", ROOT / "boot/limine-initramfs.conf", "--add", archive,
             "initramfs.cpio", self.kernel, iso])
        disk = work / "disk.img"
        r = subprocess.run(["cp", "--sparse=always", self.disk, disk])
        if r.returncode:
            die("cp the disk")
        log = work / "serial.log"
        r = subprocess.run([ROOT / "tools/qemu-halt", "--firmware", self.a.firmware, "--serial", log,
                            "--timeout", "900", "--qemu", "-m", "--qemu", "1G", "--elf", self.kernel,
                            "--marker", "halt|PANIC .*",
                            "--qemu", "-drive", "--qemu", f"file={disk},if=none,id=d0,format=raw",
                            "--qemu", "-device", "--qemu", "virtio-blk-pci,drive=d0", iso],
                           capture_output=True, text=True)
        (work / "qemu-halt.txt").write_text(r.stdout + r.stderr)
        text = log.read_text(errors="replace") if log.exists() else ""
        # tools/lib.sh's serial_norm: the terminal's escapes and CRs out
        text = re.sub(r"\x1b\[[0-9;?=<>]*[A-Za-z]|\x1b[()][A-Za-z0-9]|\x1b[c78DEHM=>]|\r", "", text)
        return disk, text, r.returncode

    def stats(self, disk, paths):
        """debugfs `stat` of every path, in order: [(ino, mode, atime seconds)]."""
        cmds = disk.parent / "stat.cmds"
        cmds.write_text("".join(f"stat {p}\n" for p in paths))
        out = run(["debugfs", "-f", cmds, disk])
        got, cur = [], None
        for line in out.splitlines():
            m = re.match(r"^Inode: (\d+)\s+Type: \S+\s+Mode:\s+(\d+)", line)
            if m:
                cur = [int(m.group(1)), int(m.group(2), 8), None]
                got.append(cur)
                continue
            m = re.match(r"^\s*atime: 0x([0-9a-f]+)", line)
            if m and cur is not None and cur[2] is None:
                cur[2] = int(m.group(1), 16)
        if len(got) != len(paths) or any(g[2] is None for g in got):
            die(f"debugfs stat: {len(got)} answers for {len(paths)} paths")
        return got

    def scene(self, row, hold):
        line = "/bin/churn scene /mnt/tree /mnt/log/app.log 30" + (f" {hold}" if hold else "")
        disk, text, rc = self.boot(row, line)
        self.common(row, text, rc, "scene: end")
        lost = [(p, s[0]) for p, s, b in zip(self.paths + self.dirs, self.stats(disk, self.paths + self.dirs), self.before)
                if s[2] == b[2]]
        self.row(f"C3-{row}", not lost, (f"{len(lost)} of {len(self.paths) + len(self.dirs)} inodes kept the "
                 f"old access time: " + ", ".join(f"{p} (inode {i})" for p, i in lost[:6]) if lost else
                 f"every one of {len(self.paths)} files' and {len(self.dirs)} directories' access times moved"))
        m = re.search(r"^scene: appended (\d+) lines$", text, re.M)
        n = int(m.group(1)) if m else -1
        got = disk.parent / "app.log"
        process(["debugfs", "-R", f"dump /log/app.log {got}", disk], capture_output=True)
        want = "".join(f"line {k:08d}\n" for k in range(n)).encode() if n >= 0 else None
        have = got.read_bytes() if got.exists() else b""
        if want is not None and have == want:
            self.row(f"C4-{row}", True, f"/log/app.log holds the {n} lines appended, in order")
        else:
            lines = have.decode(errors="replace").splitlines()
            gaps = [k for k, l in enumerate(lines) if l != f"line {k:08d}"][:3]
            self.row(f"C4-{row}", False, f"/log/app.log has {len(have)} bytes, {len(lines)} lines, the probe "
                     f"appended {n}; first out of place at {gaps}")
        self.fsck(row, disk)

    def modes(self, row):
        disk, text, rc = self.boot(row, "/bin/churn modes /mnt/tree 600")
        self.common(row, text, rc, "modes: end")
        lost = [(p, s[0], s[1]) for p, s in zip(self.paths, self.stats(disk, self.paths)) if s[1] & 0o7777 != 0o600]
        self.row(f"C3-{row}", not lost, (f"{len(lost)} of {len(self.paths)} files kept another mode: " +
                 ", ".join(f"{p} (inode {i}, {m & 0o7777:04o})" for p, i, m in lost[:6]) if lost else
                 f"every one of {len(self.paths)} files is 0600"))
        self.fsck(row, disk)

    def common(self, row, text, rc, end):
        why = []
        if not re.search(rf"^{re.escape(end)}$", text, re.M):
            why.append(f"no '{end}'")
        if not re.search(r"^PAX: init /bin/churn ended with status 0; nothing left to run$", text, re.M):
            why.append("init did not end with status 0")
        if rc != 0:
            why.append(f"not halted (qemu-halt {rc})")
        if re.search(r"^PANIC ", text, re.M):
            why.append("PANIC")
        books = re.search(r"^block: vda: .*$", text, re.M)
        self.row(f"C1-{row}", not why, ("; ".join(why) if why else "the probe ended, init 0, halted") +
                 (f"; {books.group(0)}" if books else ""))
        faults = re.findall(r"^ext2: vda: [a-z].*$", text, re.M)
        early = re.findall(r"^block: the cache is full of metadata.*$", text, re.M)
        self.row(f"C2-{row}", not faults, (" | ".join(faults[:4]) if faults else "no ext2 fault line") +
                 (f" (and: {early[0]})" if early else ""))

    def fsck(self, row, disk):
        r = process(["e2fsck", "-fn", disk], capture_output=True, text=True)
        (disk.parent / "e2fsck.txt").write_text(r.stdout + r.stderr)
        body = [l for l in r.stdout.splitlines() if not l.startswith(("e2fsck ", "Pass "))]
        self.row(f"C5-{row}", r.returncode == 0, f"e2fsck -fn " + ("clean" if r.returncode == 0 else
                 f"exit {r.returncode}: " + " | ".join(body[:8])))
        disk.unlink()


def main():
    p = argparse.ArgumentParser(prog=NAME)
    p.add_argument("--kernel")
    p.add_argument("--rows", default=",".join(ROWS))
    p.add_argument("--firmware", default="bios", choices=("bios", "uefi"))
    a = p.parse_args()
    rows = a.rows.split(",")
    if any(r not in ROWS for r in rows):
        die(f"--rows takes {','.join(ROWS)}")
    s = Suite(a)
    s.build()
    for r in rows:
        if r == "modes":
            s.modes(r)
        else:
            s.scene(r, 48 if r == "pressure" else 0)
    say(("PASS" if s.failed == 0 else f"FAIL ({s.failed} rows)") + f": {', '.join(rows)}")
    return 1 if s.failed else 0


if __name__ == "__main__":
    sys.exit(main())
