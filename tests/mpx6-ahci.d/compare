#!/usr/bin/env python3
"""Named AHCI rows. Whole bounded sections, never greps that pass vacuously."""
import pathlib
import re
import sys


def section(text, name):
    begin, end = f"AHCI BEGIN {name}\n", f"AHCI END {name}\n"
    if text.count(begin) != 1 or text.count(end) != 1:
        raise ValueError(f"missing or repeated {name} markers")
    return text.split(begin, 1)[1].split(end, 1)[0]


def normalized(path):
    text = pathlib.Path(path).read_text(errors="replace").replace("\r", "")
    text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", text)
    # PAX's process narration is not program output; preserve every other
    # line, including AHCI errors and panics, so extra diagnostics fail.
    return "\n".join(line for line in text.split("\n") if not line.startswith("user: "))


def main():
    if len(sys.argv) != 3:
        raise ValueError("usage: compare PAX-LOG LINUX-LOG")
    pax, linux = map(normalized, sys.argv[1:])
    failed = False
    for row, name in (("A1-identify-inventory", "inventory"),
                      ("A1-identify-files", "identity"),
                      ("A2-linux-name-order", "names"),
                      ("A3-before-differential", "before"),
                      ("A4-prdt-readback", "bytes"),
                      ("A5-after-differential", "after")):
        try:
            got, want = section(pax, name), section(linux, name)
            if name == "inventory":
                # The real installer's whole report on both guests: each
                # device line (name, size, sector, state), its identity
                # numbers and its model/serial line, held line for line.
                got = "\n".join(x.rstrip() for x in got.splitlines())
                want = "\n".join(x.rstrip() for x in want.splitlines())
                models = [x.strip() for x in got.splitlines() if x.lstrip().startswith("model=")]
                if len(models) != 4 or "model=PX75B-SATA-B serial=PX75B B2 INNER" not in models:
                    raise ValueError("installer did not preserve all four hardware identities")
            if name == "identity":
                # R-px75b-4: sysfs presentation padding differs, not identity.
                # The fixture's ATA models fit Linux's 16-byte SCSI field.
                got = "\n".join(x.rstrip(" ") for x in got.split("\n"))
                want = "\n".join(x.rstrip(" ") for x in want.split("\n"))
            if not want.strip() or got != want:
                raise ValueError(f"guest {want!r}; PAX {got!r}")
            if name == "bytes":
                reads = re.findall(r"(\d+) bytes differ", got)
                if len(reads) != 22 or any(int(x) for x in reads):
                    raise ValueError("expected all 22 readbacks and zero differing bytes")
            if name == "identity" and ("PX75B-A1" not in got or "PX75B-C3" not in got or "PX75B B2 INNER\n" not in got):
                raise ValueError("not the specified serials")
            print(f"PASS {row}: {len(got.splitlines())} lines match Linux")
        except ValueError as exc:
            print(f"FAIL {row}: {exc}")
            failed = True
    if "AHCI SESSION END" not in pax or "AHCI SESSION END" not in linux:
        print("FAIL A0-session-complete")
        failed = True
    return int(failed)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as exc:
        print(f"FAIL A0-input: {exc}")
        sys.exit(1)
