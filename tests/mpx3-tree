#!/usr/bin/env bash
# tests/mpx3-tree — px27: the writable file tree. Two things run on PAX
# and on Linux and are compared byte for byte:
#
#   - tree (user/elf/tree.c, tools/mkprobes), one static glibc program,
#     the first program on PAX and pid 1 on Linux with its root a tmpfs:
#     what `open` makes and refuses, O_APPEND from two descriptors and
#     two processes, holes and truncation, a file unlinked while open, a
#     working directory removed, `rename` (what it replaces, what it
#     refuses, a directory moved with a process inside), a directory's
#     size and link count and a reading of it while it changes, long
#     names, the errnos, which times move, the copies in the kernel;
#     then, as `tree soak`, 10,000 rounds of create, write, rename,
#     unlink and a fill to ENOSPC and back; and `tree speed`, 16 MiB
#     written and read back, then 1 GiB each way over the same file;
#   - a typed session (user/console/shell-tree.keys) in pelt with
#     boreutils' `mkdir`, `rmdir`, `rm`, `mv`, `cp`, `cat >`, `>>`, `ls
#     -l` and `stat` at user/boreutils.pin (bu21): a tree made, files
#     written from the keyboard, copied, moved, listed, a file of the
#     initramfs appended to, the tree removed, and `rm -rf /` refused;
#   - px36: a second typed session (user/console/shell-changes.keys)
#     with bu22's `chmod`, `touch` and `ln`, `mkdir -m` and `cp -p`:
#     modes set and listed, times set with `touch -t`, `-a`, `-m`, `-r`
#     and read back with `stat`, hard and symbolic links made, followed,
#     replaced and removed, `readlink`, `cp -P`.
#   - px50 (pax#78): a third typed session (user/console/shell-inout.keys)
#     of boreutils' `cat` with its input its output (bu25's shapes,
#     boreutils' tests/inout/cases.toml, rewritten for pelt: `read` and
#     `echo -n` move the offsets where those use `dd`): `f >> f`, `<`,
#     `-`, `/dev/stdin`, a hard and a symbolic link, `>`, `1<>` behind,
#     at and ahead of the input, the other operands copied; cat finds
#     its output's identity through /proc/self/fd/1 and its append flag
#     in /proc/self/fdinfo/1, so PAX refuses as Linux does; and again
#     after `su pax` (shell-inout-user.keys, without the three shapes
#     that name /dev/null: the container's is not the user's to open).
#     px52 (pax#83): both end with `readlink` of /dev/stdin, stdout and
#     stderr (links to /proc/self/fd/N), pelt's `> /dev/stderr` while
#     descriptor 2 is `2>> f` (the reopen truncates f), and `cat
#     /dev/stdin < f > /dev/stdout` into a pipe.
#   - px55 (pax#93, #94): the probe reads /proc/self/limits and
#     /proc/sys/kernel/core_pattern: each file's mode, size and owner, the
#     listing of its directory, the limits file's header and each row's
#     name, units, length and columns, and every row's values against
#     getrlimit, compared with Linux (T1); the values themselves, the
#     host's on Linux, are `~proc:` lines held to PAX's own text (T2).
#   - px47 (P5 U7): every one of them again AS A USER, beside root's.
#     `tree` and `tree soak` as 1000:1000 through px39's `as` (pid 1
#     is `/bin/as 1000 1000 /bin/tree`; the image holds `/t` as the
#     user's own, 0755, made by tools/mkinitramfs's owners, since a
#     user may not make it in root's `/`); shell-tree and
#     shell-changes typed after `su pax` (px46) in the user's home
#     (user/console/shell-tree-user.keys, shell-changes-user.keys),
#     with what only root may do refused: a write to /etc/motd, a name
#     made in /etc or /bin, `rm` of /etc/motd, `rmdir /bin`, `chmod`,
#     `touch` and `ln` of root's file, `chown` to root. The Linux side
#     of each is the same binaries as the same user in a throwaway
#     container (tools/linux-tree --owners: the image's owners and
#     modes), so no host account and no root on the host.
#
#   tests/mpx3-tree [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                   [--pelt DIR] [--bore DIR] [--su DIR]
#                   [--firmware bios|uefi|both] [--tier native|release|both]
#
# **Nothing under test runs on a host.** The Linux side of every session
# is tools/linux-tree: a throwaway container with no network and
# nothing of the host mounted but a staging directory under the build
# directory, the programs' root a tmpfs inside it. `--only build` makes
# the programs and the images and stops (on a host whose libc the
# programs must not be built with, that step runs in a container, and
# `--only linux --images DIR` then runs the Linux side from the host).
#
# Images, per tier: tree-probes, tree-soak, tree-speed (/bin/tree and
# /etc/pax-run) and tree-shell (pelt, boreutils' twenty, /etc as
# tests/mpx3-shell's), one kernel, kmain_console. Sessions: probes,
# soak, speed, shell-tree and shell-changes (COM1), shell-tree-ps2 and
# shell-changes-ps2 (the PS/2 keyboard; each one's reference is its
# COM1 twin's). Assertions, per tier, firmware and
# session:
#   T0 build: kmain_console built; every program static; the images
#      built (digests printed); the Linux side ran every session in its
#      container.
#   T1 the output, differential: every line the session wrote on PAX
#      (the kernel's own `user: …` lines left out) is byte-identical to
#      what it wrote on Linux, and the exit status is Linux's. Two
#      things are compared by rule, not by value: a line that starts
#      with `~` (what depends on the host: megabytes that fit, a time
#      in milliseconds, what PAX refuses by name) is left out; and in
#      `ls -l`, the date of a file made in the session (`Mon DD HH:MM`,
#      the form `ls` gives a recent file) is masked on both sides —
#      a date from 1970, the initramfs's, or one `touch -t` set, is
#      compared as it stands, so a clock that is wrong on PAX shows.
#   T2 probes: what PAX refuses by name is exactly its `~refused` line
#      (px36: link, symlink, chmod, chown to root and utimensat answer
#      0 now; O_SYNC -EINVAL; O_TMPFILE -EOPNOTSUPP; RENAME_NOREPLACE
#      -EINVAL), a file and a directory made in `/dev` (`~limits`:
#      -EROFS), and px36's: a mode, times and a symbolic link in `/dev`
#      (`~fixed`: -EROFS), each with its `refused:` line, and the kernel
#      counted them: eight (px56: the `execve` of a program copied since
#      boot, `~exec`, was the ninth, -EACCES; it runs now, status 7, as
#      on Linux, and its line is held at that; px42: an owner that is not root was the
#      tenth, -EINVAL; PAX keeps any id now, and the line `owner: chown
#      1000 1000 0: uid 1000` is compared with Linux's like the rest:
#      T1). And what PAX answers where Linux's answer depends on
#      more than the ABI: PAX's largest file (a byte at 1 GiB and a file
#      grown to 2 GiB are -EFBIG, `~limits`; tmpfs takes both), a time
#      past 2262 held at PAX's last nanosecond (`~time`), and a write by
#      root that keeps a set-user-ID bit (`~mode`: root has CAP_FSETID
#      on PAX; a container's root may not). px55: the `~proc:` lines are
#      tests/mpx3-tree.d/proc.pax, PAX's /proc/self/limits as Linux lays
#      it out with PAX's values (prlimit64's: the stack's 131072, the
#      descriptors' 1024, the core file's soft 0 and hard unlimited,
#      the rest unlimited), /proc/<pid>/limits the same bytes, and
#      core_pattern `core`, as root and (in probes-user.pax) as a user.
#   T3 -ENOSYS only for set_robust_list (273) and rseq (334); no
#      `refused:` line but T2's; nobody killed.
#   T4 everything given back: the frames line shows as many frames free
#      after init's end as before the first program, and the tree's line
#      as many frames and inodes held as when it was made — but for the
#      frames the inode table grew by (they hold the most inodes there
#      were at once and are never given back; the line counts them),
#      and for one frame in two sessions: shell-tree leaves the page
#      of /etc/motd it appended to, the probe's the page of
#      /etc/pax-run, which it removed and made again.
#   T5 soak: the kernel's census lines, one for every 2500th file
#      removed (`user: tree pid 1 tree: <n> files removed since boot;
#      frames held <h>, inodes <i>, frames free <f>`), four of them
#      and flat; the fill, twice: a `tree: full:` line with the tree at
#      its cap, and — the second time, with 120 MiB of the program's
#      own memory held — one with the tree below its cap and the
#      machine at the reserve, the frames a write never takes (and the
#      program could still have memory of its own then: T1's line); the
#      program's break did not move (T1's line).
#   T6 each shell session, on Linux: when it was over the root held
#      exactly the names it started with (the session removed what it
#      made; `rm -rf /` removed nothing) and, since px46's pin of pelt
#      (sh12), pelt's history file /.sh_history (root's HOME is /). T1
#      holds PAX to the same transcript, and T4 to the same inodes (one
#      more than at the start: the history file, and its page).
#   T7 speed: 16 MiB written and read back and 64 more passes over it,
#      1 GiB each way (T1), and the times the program measured (10 ms
#      steps on PAX).
#   T8 the end: `PAX: init … ended with status <s>; nothing left to
#      run`, `halt`, and qemu-halt holds the machine halted.
# The user sessions (px47) are held to the same T1, T3, T4, T5 (soak-
# user), T6 (the two typed ones) and T8; T2 for probes-user holds its
# `~` lines and refusal lines to PAX's own recorded text,
# tests/mpx3-tree.d/probes-user.pax (a user's answers where Linux's
# depend on more than the ABI, and what PAX refuses by name before a
# user's check). T4 for them: nothing of root's is changed (the tree
# keeps /etc/pax-run and /etc/motd), and each typed session leaves two
# history files, root's /.sh_history and the user's
# /home/pax/.sh_history (pelt keeps one per HOME), and the page of
# entries the user's home, empty in the image, gained.
# The probes session of the first leg runs first, and the suite stops
# at its first failure: `stopped early`. A boot ends at the kernel's
# `halt` or at a `PANIC` line, whichever comes (a kernel that panics is
# not waited on to the deadline; T8 fails it): a planted break fails
# fast.
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only= peltdir= boredir= sudir=
usage="usage: tests/mpx3-tree [--images DIR | --no-boot | --only build | --only linux --images DIR] [--pelt DIR] [--bore DIR] [--su DIR] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --pelt)     peltdir=$2; shift 2 ;;
        --bore)     boredir=$2; shift 2 ;;
        --su)       sudir=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3

BORE="cat echo env false head ls readlink sleep stat tail true wc mkdir rmdir rm mv cp chmod touch ln" # px36: bu22's three
USER_BORE="chown chgrp" # px47: the user's image also has bu24's two owner tools
SESSIONS="probes soak speed shell-tree shell-tree-ps2 shell-changes shell-changes-ps2 probes-user soak-user shell-tree-user shell-changes-user shell-inout shell-inout-user"
LINUX_SESSIONS="probes soak speed shell-tree shell-changes probes-user soak-user shell-tree-user shell-changes-user shell-inout shell-inout-user"
image_of() { case $1 in shell-*-user) echo shell-user ;; shell-*) echo shell ;; *) echo "$1" ;; esac; }
init_of() { case $1 in shell-*) echo pelt ;; *-user) echo as ;; *) echo tree ;; esac; }
args_of() { case $1 in soak|speed) echo "$1" ;; probes-user) echo "1000 1000 /bin/tree" ;; soak-user) echo "1000 1000 /bin/tree soak" ;; *) echo ;; esac; }
user_of() { case $1 in *-user) echo 1 ;; *) echo 0 ;; esac; }
kbd_of() { case $1 in *-ps2) echo ps2 ;; *) echo serial ;; esac; }
linux_of() { case $1 in *-ps2) echo "${1%-ps2}" ;; *) echo "$1" ;; esac; }
mem_of() { case $1 in shell-*) echo 512M ;; *) echo 256M ;; esac; }
keys_of() { echo "$PAX_ROOT/user/console/$(linux_of "$1").keys"; }
SHELL_MOTD='PAX. Kernel: wolf. Shell: wolf. Tools: wolf. Nothing here existed last year.'
PROMPT='$ '
REFUSED='~refused: link 0, symlink 0, chmod 0, chown 0, utimensat 0, O_SYNC -22, O_TMPFILE -95, RENAME_NOREPLACE -22'
FIXED='~fixed: chmod of /dev -30, its times -30, a symbolic link made in /dev -30'
SETID='~mode: 06755 and a write by root: mode 106755 links 1 size 2 blocks 8'
FAR='~time: the year 3000 as atime: atime 9223372036.854775807 mtime 4102444800.000000002'
PROC=$here/mpx3-tree.d/proc.pax # px55: PAX's /proc/self/limits and core_pattern, its `~proc:` lines
LIMITS='~limits: a file made in /dev -30, a directory -30; a byte written at 1 GiB -27, a file grown to 2 GiB -27'
EXEC_LINE='~exec: a program copied since boot, run: status 7 (7: it ran; 113: -EACCES)' # px56: Linux's answer (113 before: px27's limit)
REFUSALS='syscall 257: refused: an open flag PAX does not honour (O_DIRECT, O_SYNC, O_DSYNC, O_NOATIME, O_PATH, O_TMPFILE), -22|syscall 257: refused: an open flag PAX does not honour (O_DIRECT, O_SYNC, O_DSYNC, O_NOATIME, O_PATH, O_TMPFILE), -95|syscall 257: refused: making or removing a name in /dev (PAX'"'"'s /dev is fixed), -30|syscall 280: refused: a mode, an owner, times or a link of what PAX keeps fixed (/dev, /proc, /sys, a pipe, a socket), -30|syscall 316: refused: a renameat2 flag (RENAME_NOREPLACE, RENAME_EXCHANGE, RENAME_WHITEOUT), -22|syscall 83: refused: making or removing a name in /dev (PAX'"'"'s /dev is fixed), -30|syscall 88: refused: a mode, an owner, times or a link of what PAX keeps fixed (/dev, /proc, /sys, a pipe, a socket), -30|syscall 90: refused: a mode, an owner, times or a link of what PAX keeps fixed (/dev, /proc, /sys, a pipe, a socket), -30'
NREF=$(printf '%s' "$REFUSALS" | tr '|' '\n' | grep -c .)

work=$PAX_BUILD/mpx3-tree
runs=$PAX_BUILD/mpx3-tree-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

# A transcript with the date of every file made in the session masked
# (`ls -l`'s `Mon DD HH:MM`; a date with a year is left as it is).
# px47: whoever owns it (the user's sessions list `pax pax` files).
mask() {
    sed -E 's/^([-dl][-rwxsStT]{9} +[0-9]+ [^ ]+ +[^ ]+ +[0-9]+) [A-Z][a-z]{2} +[0-9]+ +[0-9]{2}:[0-9]{2} /\1 DATE /' "$1"
}

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The Linux side of every session, each in its own throwaway container.
linux_side() { # dir -> reasons on stdout
    local s p i a size
    mkdir -p "$1/linux"
    for s in $LINUX_SESSIONS; do
        p=$(image_of "$s") i=$(init_of "$s") a=$(args_of "$s")
        keys=$1/none.keys; [ "$i" = pelt ] && keys=$(keys_of "$s")
        size=64m; [ "$i" = pelt ] && size=512m
        own=(); [ -f "$1/$p.owners" ] && own=(--owners "$1/$p.owners") # px47: the user's images
        # shellcheck disable=SC2086
        if "$PAX_ROOT/tools/linux-tree" --root "$1/$p/root" --keys "$keys" --prompt "$PROMPT" --argv0 "/bin/$i" --size "$size" \
            ${own[@]+"${own[@]}"} "$1/linux/$s.tty" -- "/bin/$i" $a; then
            say "  linux $s: $(wc -c < "$1/linux/$s.tty" | tr -d ' ') bytes, status $(cat "$1/linux/$s.tty.rc"), $(wc -l < "$1/linux/$s.tty.after" | tr -d ' ') names left"
        else
            printf ' tools/linux-tree %s;' "$s"
        fi
    done
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS T0 (linux): the Linux side ran every session, each in a throwaway container" || bad "T0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    mkdir -p "$work/bin" "$work/shell/root/bin" "$work/shell/root/etc"
    why=
    sh=$work/shell/root
    "$PAX_ROOT/tools/mkprobes" "$work/bin" > "$work/probes.txt" || why+=" tools/mkprobes;"
    sed 's/^/  program: /' "$work/probes.txt" >&2
    "$PAX_ROOT/tools/mkas" "$work/cred" > "$work/cred.txt" || why+=" tools/mkas;" # px47: `as`
    if [ -n "$sudir" ]; then
        mkdir -p "$work/subin" && cp "$sudir/su" "$work/subin/su" || why+=" no $sudir/su;"
        say "su from $sudir"
    else
        "$PAX_ROOT/tools/mksu" "$work/subin" > "$work/su.txt" || why+=" tools/mksu;"
    fi
    if [ -n "$peltdir" ]; then
        cp "$peltdir/pelt" "$sh/bin/pelt" || why+=" no $peltdir/pelt;"
        say "pelt from $peltdir"
    elif "$PAX_ROOT/tools/mkpelt" "$work/peltbin" > "$work/pelt.txt"; then
        cp "$work/peltbin/pelt" "$sh/bin/pelt"
    else
        why+=" tools/mkpelt;"
    fi
    if [ -z "$boredir" ]; then
        # shellcheck disable=SC2086
        "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE $USER_BORE > "$work/bore.txt" || why+=" tools/mkboreutils;"
        boredir=$work/bore
    else
        say "boreutils from $boredir"
    fi
    for u in $BORE; do
        cp "$boredir/$u" "$sh/bin/$u" || why+=" no $boredir/$u;"
    done
    printf '%s\n' "$SHELL_MOTD" > "$sh/etc/motd"
    printf 'root:x:0:0:root:/:/bin/pelt\n' > "$sh/etc/passwd"
    printf 'root:x:0:\n' > "$sh/etc/group"
    "$PAX_ROOT/tools/mkzone" "$sh/etc/localtime" > "$work/zone.txt" || why+=" tools/mkzone;"
    echo /bin/pelt > "$sh/etc/pax-run"
    : > "$work/none.keys"
    for s in probes soak speed; do
        r=$work/$s/root
        mkdir -p "$r/bin" "$r/etc"
        cp "$work/bin/tree" "$r/bin/tree" || why+=" no tree;"
        a=$(args_of "$s")
        echo "/bin/tree${a:+ $a}" > "$r/etc/pax-run"
    done
    # px47: the user's images. `tree` as 1000:1000 through `as`, with
    # /t the user's own (a user may not make it in root's /); the
    # shell's tree with su, the accounts (px46's lines, R3), the
    # user's home and chown/chgrp.
    for s in probes-user soak-user; do
        r=$work/$s/root
        mkdir -p "$r/bin" "$r/etc" "$r/t"
        cp "$work/bin/tree" "$r/bin/tree" || why+=" no tree;"
        cp "$work/cred/as" "$r/bin/as" || why+=" no as;"
        echo "/bin/as $(args_of "$s")" > "$r/etc/pax-run"
        printf '/t 755 1000 1000\n' > "$work/$s.owners"
    done
    su_=$work/shell-user/root
    mkdir -p "$su_"
    cp -R "$sh/." "$su_/"
    mkdir -p "$su_/home/pax"
    for u in $USER_BORE; do
        cp "$boredir/$u" "$su_/bin/$u" || why+=" no $boredir/$u;"
    done
    cp "$work/subin/su" "$su_/bin/su" || why+=" no su;"
    printf 'root:x:0:0:root:/:/bin/pelt\npax:x:1000:1000:pax:/home/pax:/bin/pelt\nlobo:x:990:990:lobo:/srv/lobo:/bin/false\n' > "$su_/etc/passwd"
    printf 'root:x:0:\npax:x:1000:\nlobo:x:990:\n' > "$su_/etc/group"
    printf 'ENV_PATH\tPATH=/bin\nENV_SUPATH\tPATH=/bin\n' > "$su_/etc/login.defs"
    printf '/home 755 0 0\n/home/pax 755 1000 1000\n' > "$work/shell-user.owners"
    for f in "$sh"/bin/* "$su_"/bin/su "$su_"/bin/chown "$su_"/bin/chgrp "$work/bin/tree" "$work/cred/as"; do
        r=$(static_ok "$f") || why+=" $r;"
        say "  program: ${f#"$work"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    for p in probes soak speed shell probes-user soak-user shell-user; do
        pairs=()
        r=$work/$p/root
        if [ -f "$work/$p.owners" ]; then
            # px47: every name, with the owners and modes of $p.owners (a
            # directory with no line is implied, root's 0755)
            while read -r f; do
                f=${f#.}
                line=$(awk -v p="$f" '$1 == p { print $2 ":" $3 ":" $4 }' "$work/$p.owners")
                if [ -d "$r$f" ]; then
                    [ -n "$line" ] && pairs+=("$f/:$line")
                else
                    mode=644; [ -x "$r$f" ] && mode=755
                    pairs+=("$f=$r$f:${line:-$mode}")
                fi
            done < <(cd "$r" && find . -mindepth 1 | LC_ALL=C sort)
        else
        for f in $(cd "$r" && find . -type f | sort); do
            f=${f#./}
            mode=644; [ -x "$r/$f" ] && mode=755
            pairs+=("/$f=$r/$f:$mode")
        done
        fi
        if "$PAX_ROOT/tools/mkinitramfs" "$work/$p.cpio" "${pairs[@]}" > "$work/$p.initramfs.txt"; then
            sed "s/^/  initramfs $p: /" "$work/$p.initramfs.txt" >&2
        else
            why+=" tools/mkinitramfs $p;"
        fi
    done
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            cat "$log" >&2
            for p in probes soak speed shell probes-user soak-user shell-user; do
                "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                    --add "$work/$p.cpio" initramfs.cpio "$elf" "$work/$tier/tree-$p.iso" >/dev/null \
                    || why+=" $tier tree-$p: mkimage;"
                say "built $tier tree-$p: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/tree-$p.iso"), initramfs $(sha256_of "$work/$p.cpio")"
            done
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS T0 (build): kmain_console built ($tiers), every program static, seven images a tier" || bad "T0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS T0: kmain_console built ($tiers), every program static, seven images a tier, Linux ran $(echo $LINUX_SESSIONS | wc -w | tr -d ' ') sessions, each in a throwaway container" || bad "T0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx3-tree build (T0): PASS (no boot: --no-boot)" || say "mpx3-tree build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux
[ -d "$lx" ] || die "no $lx (build first, and run the Linux side)"

record() { # tier leg session status
    ran=$((ran + 1))
    printf '%s kmain_console %s %s halt-status=%s accel=%s serial=%s iso=%s\n' "$1" "$2" "$3" "$4" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" \
        "$(sha256_of "$iso")" >> "$runs"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
stopped=
for leg in $legs; do
    [ -z "$stopped" ] || break
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        [ -z "$stopped" ] || break
        for s in $SESSIONS; do
            p=$(image_of "$s") i=$(init_of "$s") kb=$(kbd_of "$s") ls=$(linux_of "$s")
            id="$tier $leg $s"
            before=$fail
            log=$PAX_BUILD/mpx3-tree-$tier-$leg-$s.serial.log
            elf=$images/$tier/kmain_console.elf iso=$images/$tier/tree-$p.iso
            rm -f "$log" "$log.verdict" "$log.typed"
            if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
                for t in T1 T3 T4 T8; do bad "$t $id: no image"; done
                continue
            fi
            typing=()
            [ "$i" != pelt ] || typing=(--type "$(keys_of "$s")" --prompt "$PROMPT" --keyboard "$kb")
            hrc=0
            "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 300 --qemu -m --qemu "$(mem_of "$s")" \
                --elf "$elf" --marker 'halt|PANIC .*' ${typing[@]+"${typing[@]}"} "$iso" >"$log.verdict" 2>&1 || hrc=$?
            record "$tier" "$leg" "$s" "$hrc"
            norm=$log.norm; serial_norm "$log" > "$norm"

            # T1: the session against Linux's.
            why=
            out=$PAX_BUILD/mpx3-tree-$tier-$leg-$s.session
            awk '/^user: exec pid 1 / { if (!on) { on = 1; next } } on && /^user: [^ ]+ pid 1 (exit_group|exit) [0-9]+ after / { exit }
                 on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$norm" > "$out"
            serial_norm "$lx/$ls.tty" > "$out.linux" # px46: as the serial log is (pelt's ESC [ 6 n)
            [ -z "$(tail -c 1 "$out.linux")" ] || printf '\n' >> "$out.linux"
            grep -v '^~' "$out" | mask /dev/stdin > "$out.cmp"
            grep -v '^~' "$out.linux" | mask /dev/stdin > "$out.linux.cmp"
            if ! cmp -s "$out.linux.cmp" "$out.cmp"; then
                why+=" the session differs from Linux's: $(diff "$out.linux.cmp" "$out.cmp" | head -n 14 | cut -c1-600 | tr '\n' '|');"
            fi
            pst=$(sed -n -E "s/^user: [^ ]+ pid 1 (exit_group|exit) ([0-9]+) after .*/\\2/p" "$norm" | head -n 1)
            lst=$(cat "$lx/$ls.tty.rc" 2>/dev/null)
            [ "$pst" = "$lst" ] || why+=" exit '$pst' on PAX, '$lst' on Linux;"
            [ "$(wc -l < "$out.cmp" | tr -d ' ')" -gt 1 ] || why+=" fewer than two lines;"
            [ -z "$why" ] && say "PASS T1 $id: $(wc -l < "$out.cmp" | tr -d ' ') lines byte-identical to Linux's ($(sha256_of "$out.cmp" | cut -c1-12)…; $(grep -c ' DATE ' "$out.cmp") dates compared by rule), exit $pst" || bad "T1 $id:$why"

            # T2: what PAX refuses by name, counted.
            rf=$(grep ': refused: ' "$norm" | sed -E 's/^.*user: [^ ]+ pid [0-9]+ //' | LC_ALL=C sort | paste -sd'|' -)
            tl=$(grep -m1 '^tree: frames ' "$norm")
            if [ "$s" = probes ]; then
                why=
                g=$(grep -m1 '^~refused' "$out")
                [ "$g" = "$REFUSED" ] || why+=" '$g';"
                [ "$rf" = "$REFUSALS" ] || why+=" refusal lines '$rf';"
                x=$(grep -m1 '^~exec' "$out")
                [ "$x" = "$EXEC_LINE" ] || why+=" '$x';"
                lm=$(grep -m1 '^~limits' "$out")
                [ "$lm" = "$LIMITS" ] || why+=" '$lm';"
                rn=$(printf '%s\n' "$tl" | sed -n -E 's/.*, refusals ([0-9]+)$/\1/p')
                for v in "$FIXED" "$SETID" "$FAR"; do
                    grep -qxF -- "$v" "$out" || why+=" no '$v' ('$(grep -m1 -- "^${v%%:*}" "$out")');"
                done
                [ "$rn" = "$NREF" ] || why+=" the kernel counted '$rn' refusals, not $NREF ('$tl');"
                # px55: the limits and the core pattern, PAX's own text.
                grep '^~proc' "$out" > "$out.proc"
                cmp -s "$PROC" "$out.proc" || why+=" the ~proc lines are not $PROC's: $(diff "$PROC" "$out.proc" | head -n 8 | cut -c1-300 | tr '\n' '|');"
                [ -z "$why" ] && say "PASS T2 $id: $g; $x; $lm; $FIXED; $SETID; $FAR; $(wc -l < "$out.proc" | tr -d ' ') ~proc lines PAX's own ($(sha256_of "$out.proc" | cut -c1-12)…); $NREF refusal lines, $NREF counted (Linux here: $(grep -m1 '^~refused' "$out.linux"); $(grep -m1 '^~exec' "$out.linux"); $(grep -m1 '^~limits' "$out.linux"); $(grep -m1 '^~fixed' "$out.linux"); $(grep -m1 '^~mode' "$out.linux"); $(grep -m1 '^~time' "$out.linux"))" || bad "T2 $id:$why"
            fi

            # T2 for a user (px47): the `~` lines and the refusal lines are
            # PAX's own recorded answers for 1000:1000.
            if [ "$s" = probes-user ]; then
                why=
                rec=$here/mpx3-tree.d/probes-user.pax
                { grep '^~' "$out"; printf '%s\n' "$rf" | tr '|' '\n' | sed '/^$/d; s/^/refused: /'; } > "$out.pax"
                if [ ! -f "$rec" ]; then
                    why+=" no recording $rec;"
                elif ! cmp -s "$rec" "$out.pax"; then
                    why+=" PAX's own answers differ from the recording: $(diff "$rec" "$out.pax" | head -n 10 | cut -c1-300 | tr '\n' '|');"
                fi
                [ -z "$why" ] && say "PASS T2 $id: $(wc -l < "$out.pax" | tr -d ' ') lines (\`~\` and refusals) are the recording's ($(sha256_of "$out.pax" | cut -c1-12)…); Linux's \`~\` lines here: $(grep -c '^~' "$out.linux")" || bad "T2 $id:$why"
            fi

            # T3: what PAX lacks; nobody killed.
            why=
            ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$norm" | sort -un | paste -sd' ' -)
            [ "$ns" = "273 334" ] || why+=" -ENOSYS for '$ns', not '273 334';"
            if [ "$s" != probes ] && [ "$s" != probes-user ]; then
                [ -z "$rf" ] || why+=" refusals '$rf';"
            fi
            kl=$(grep -c 'user: [^ ]* pid [0-9]* killed: ' "$norm")
            [ "$kl" = 0 ] || why+=" $kl killed: lines ($(grep -m1 ' killed: ' "$norm" | cut -c1-120));"
            [ -z "$why" ] && say "PASS T3 $id: -ENOSYS only for 273 and 334; nobody killed" || bad "T3 $id:$why"

            # T4: every frame and inode back.
            why=
            fl=$(grep -m1 '^user: frames free ' "$norm")
            set -- $(printf '%s\n' "$fl" | sed -n -E 's/^user: frames free ([0-9]+) before, [0-9]+ with 1 processes, ([0-9]+) after$/\1 \2/p')
            fb=${1:-} fa=${2:-}
            set -- $(printf '%s\n' "$tl" | sed -n -E "s/^tree: frames ([0-9]+) \\(([0-9]+) when made\\), ([0-9]+) \\(([0-9]+)\\) of them the inode table's, inodes ([0-9]+) \\(([0-9]+)\\), cap ([0-9]+), refusals [0-9]+\$/\\1 \\2 \\3 \\4 \\5 \\6/p")
            th=${1:-} tb=${2:-} tt=${3:-} ttb=${4:-} ti=${5:-} tib=${6:-}
            left=0 hist=0
            [ "$p" != shell ] || [ "$(linux_of "$s")" != shell-tree ] || left=1 # the page of /etc/motd the session appended to
            [ "$s" != probes ] || left=1 # the page of /etc/pax-run, which the probe removed and made again
            # px46: pelt keeps its history in $HOME/.sh_history since sh12,
            # and root's HOME is /: a typed session leaves that file, one
            # inode and its one page, on PAX and on Linux (T6).
            [ "$p" != shell ] || { left=$((left + 1)); hist=1; }
            # px47: a user's typed session leaves two, root's and the
            # user's (/home/pax/.sh_history), the second in a home that
            # had no entry, so the home's first page of entries too; a
            # user changes nothing of root's.
            [ "$p" != shell-user ] || { left=$((left + 3)); hist=2; }
            if [ -z "$fb" ] || [ -z "$th" ]; then
                why+=" no frames line or no tree line ('$fl' / '$tl');"
            else
                grew=$((tt - ttb)) # the inode table's frames are never given back
                [ $((fb - fa)) = $((left + grew)) ] || why+=" $((fb - fa)) frames not back, not $left and the inode table's $grew ('$fl');"
                [ $((th - tb)) = $((left + grew)) ] || why+=" the tree holds $((th - tb)) frames more than when made, not $left and the inode table's $grew ('$tl');"
                [ "$ti" = $((tib + hist)) ] || why+=" the tree has $ti inodes, $tib when made$( [ "$hist" != 0 ] && echo " and $hist history files");"
            fi
            [ -z "$why" ] && say "PASS T4 $id: $fl; $tl" || bad "T4 $id:$why"

            # T5: the soak's census and the fill.
            if [ "$s" = soak ] || [ "$s" = soak-user ]; then
                why=
                cl=$(grep -c '^user: tree pid 1 tree: [0-9]* files removed since boot' "$norm")
                [ "$cl" = 4 ] || why+=" $cl census lines, not 4;"
                cu=$(sed -n -E 's/^user: tree pid 1 tree: [0-9]+ files removed since boot; (frames held [0-9]+, inodes [0-9]+, frames free [0-9]+)$/\1/p' "$norm" | sort -u)
                [ "$(printf '%s\n' "$cu" | grep -c .)" = 1 ] || why+=" the census is not flat: $(printf '%s' "$cu" | tr '\n' '|');"
                nf=0 okf=1 atcap=0 atres=0
                while read -r h c f rsv; do
                    nf=$((nf + 1))
                    if [ "$h" -ge "$c" ]; then atcap=$((atcap + 1))
                    elif [ "$f" -le "$rsv" ]; then atres=$((atres + 1))
                    else okf=0
                    fi
                done < <(sed -n -E 's/^user: tree pid 1 tree: full: frames held ([0-9]+) of ([0-9]+), frames free ([0-9]+), reserve ([0-9]+)$/\1 \2 \3 \4/p' "$norm")
                [ "$atcap" -ge 1 ] || why+=" no 'tree: full:' line with the tree at its cap;"
                [ "$atres" -ge 1 ] || why+=" no 'tree: full:' line with the tree below its cap and the machine at the reserve;"
                [ "$okf" = 1 ] || why+=" a 'tree: full:' line with the tree below its cap and the machine above the reserve;"
                [ -z "$why" ] && say "PASS T5 $id: $cl census lines, all '$cu'; $nf full lines, $atcap at the cap ($(grep -m1 'tree: full:' "$norm" | sed 's/^.*tree: full: //')), $atres at the reserve ($(grep 'tree: full:' "$norm" | sed 's/^.*tree: full: //' | awk -F'[ ,]+' '$3 + 0 < $5 + 0' | head -n 1)); $(grep '^~fill' "$out" | paste -sd' ' -)" || bad "T5 $id:$why"
            fi

            # T6: the tree intact, on Linux.
            if [ "$s" = shell-tree ] || [ "$s" = shell-changes ] || [ "$s" = shell-tree-user ] || [ "$s" = shell-changes-user ] || [ "$s" = shell-inout ] || [ "$s" = shell-inout-user ]; then
                want=$( (cd "$images/$p/root" 2>/dev/null && { find . -mindepth 1; echo ./.sh_history; [ "$p" != shell-user ] || echo ./home/pax/.sh_history; } | LC_ALL=C sort) ) # px46: pelt's history file (sh12); px47: and the user's
                if [ -z "$want" ]; then
                    say "PASS T6 $id: (the shell's tree is not on this host; the build host compared it)"
                elif [ "$(cat "$lx/$s.tty.after")" = "$want" ]; then
                    say "PASS T6 $id: after the session Linux's root holds the $(printf '%s\n' "$want" | wc -l | tr -d ' ') names it started with and pelt's history file$( [ "$p" = shell-user ] && echo "s (root's and the user's)"): rm -rf / removed nothing, the session removed what it made"
                else
                    bad "T6 $id: the root on Linux after the session: $(diff <(printf '%s\n' "$want") "$lx/$s.tty.after" | head -n 8 | tr '\n' '|')"
                fi
            fi

            # T7: the speed.
            if [ "$s" = speed ]; then
                sp=$(grep -m1 '^~speed' "$out")
                printf '%s\n' "$sp" | grep -Eq '^~speed: 16 MiB first written in [0-9]+ ms, read in [0-9]+ ms; 1 GiB rewritten in [0-9]+ ms, read in [0-9]+ ms$' \
                    && say "PASS T7 $id: 16 MiB: $sp (accel $(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null); Linux here: $(grep -m1 '^~speed' "$out.linux"))" \
                    || bad "T7 $id: no speed line ('$sp')"
            fi

            # T8
            why=
            grep -qx "PAX: init /bin/$i ended with status $lst; nothing left to run" "$norm" \
                || why+=" no 'PAX: init /bin/$i ended with status $lst' ($(grep -m1 '^PAX: init ' "$norm"));"
            pn=$(grep -m1 '^PANIC ' "$norm")
            [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
            [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
            [ -z "$why" ] && say "PASS T8 $id: init ended, status $lst; $(tail -n 1 "$log.verdict")" || bad "T8 $id:$why"

            if [ "$s" = probes ] && [ "$before" = 0 ] && [ "$fail" != 0 ]; then
                stopped="$id"
                say "FAIL stopped early: the probes failed on $id; the later boots are not run"
                break
            fi
        done
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx3-tree: PASS" || say "mpx3-tree: FAIL"
exit "$fail"
