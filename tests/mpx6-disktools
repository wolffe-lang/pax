#!/usr/bin/env bash
# Disk-tool Linux differentials. Programs are built by tools/mkdisktools
# and run unchanged; invoke inside the Linux oracle container.
# --only names a format, --programs its executable directory.
set -euo pipefail
. "$(dirname "$0")/../tools/lib.sh"
only=gpt
programs=$PAX_BUILD/disktools/bin
work=$PAX_BUILD/disktools/rows
oracle=
executor=
while [ $# -gt 0 ]; do
    case $1 in
        --only) only=$2; shift 2 ;;
        --programs) programs=$2; shift 2 ;;
        --work) work=$2; shift 2 ;;
        --oracle-bin) oracle=$2; shift 2 ;;
        --executor) executor=$2; shift 2 ;;
        *) die 'usage: mpx6-disktools --only gpt|fat|ext2 --programs DIR --work DIR [--oracle-bin DIR]' ;;
    esac
done
case $only in gpt|fat|ext2) ;; *) die "format not implemented yet: $only" ;; esac
[ -x "$programs/pax$only" ] || die "build pax$only with tools/mkdisktools"
args=()
if [ "$only" = ext2 ]; then
    [ -z "$executor" ] || args+=("$executor")
else
    [ -z "$oracle" ] || args+=("$oracle")
fi
exec python3 -I "$PAX_ROOT/tests/mpx6-disktools.d/$only.py" "$programs/pax$only" "$work/$only" "${args[@]}"
