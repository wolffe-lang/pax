def verdict(needs):
    env = dict(os.environ, NEEDS=json.dumps(needs))
    r = subprocess.run([PLAN, "--verdict"], capture_output=True, text=True, env=env)
    return r.returncode, r.stdout + r.stderr


def run_of(tier, chosen, results=None, legs=PR_LEGS):
    outs = {"tier": tier, "suites": json.dumps(chosen)}
    if legs:  # GitHub leaves an empty output out of `needs`
        outs["legs"] = legs
    n = {"plan": {"result": "success", "outputs": outs}}
    for s in SUITES:
        n[s] = {"result": "success" if s in chosen else "skipped", "outputs": {}}
    n.update(results or {})
    return n


def vexpect(name, needs, want):
    rc, text = verdict(needs)
    say(rc == want, "P6 %s: exit %d%s" % (name, rc, "" if rc == want else " (wanted %d) %s" % (want, text.strip()[-200:])))


