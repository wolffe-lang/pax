#!/usr/bin/env python3
"""tests/ci-plan — the CI planner's own proof (px37, px40, tl29). No QEMU: python3 and bash.

    tests/ci-plan

  P1  the tiers by event (tl29): a trunk push, the nightly and a dispatch
      are all (every suite, every leg); the `full-matrix` label is full,
      the merge gate (every suite on the merge legs, native BIOS), and all
      beside a FULL path or with no paths to read; another label's
      `labeled` event is a noop; a dispatch can ask for full or pr, and
      one naming suites is partial, on its tier input's legs.
  P2  the pr tier by path, one change per area: the network's suites for
      kernel/tcp, sound's for user/play, nothing for notes; a kmain, a
      test, a user program and a shared device select their readers.
      The kernel's core (px40, ruling #76: its fifteen modules and their
      assembly) and CI's own files select every suite, on the pr leg.
  P3  FULL wins: the toolchain pins, the harness, the kernel's entry,
      link script and Limine configuration, and any path no rule knows
      make a pull request's run all (every leg), alone or beside a core
      change; a pull request whose changed paths cannot be read is all too.
  P4  the wiring of .github/workflows/ci.yml: every suite job needs the
      plan and runs only when chosen; every test that takes a leg gets
      $PAX_LEGS and accepts --tier and --firmware; the `tier` job needs
      every job and runs unless cancelled; cancel-in-progress is for
      pull requests only and every other run has a concurrency group
      of its own run id; the trunk push, the nightly and the label are
      triggers; the dispatch's tier input is all, full or pr, all by
      default; the tier job's last step, on a red nightly only and after
      the verdict, runs tools/nightly-red, and only that job may write
      issues.
  P6  the verdict (`tools/ci-plan --verdict`, the `tier` job): green for
      an all run whose `legs` output is absent (GitHub drops an empty
      output; run 38344726280 was red on exactly that), a full run on the
      merge legs, a pr run, a partial run and a noop; red for a chosen
      suite failed, skipped or cancelled, a suite that ran unasked, a
      failed plan, a plan with no suites, and (tl29) a tier whose shape
      does not hold: a full or an all run of fewer suites than every one,
      a full run on every leg (px37's full, now all), an all run on the
      merge legs, a pr run on every leg, a partial run of no suite, a
      tier the planner never names.
  P7  the red nightly's issue (tools/nightly-red, against a stand-in
      `gh`, tl29): no open issue opens one, labelled nightly-red, under
      the one title; an open one gets a comment and no new issue; a label
      that already exists is no failure; unset variables are refused.
  P5  (a WARN, not a failure) every tracked path is known to the map or
      read by a suite; an unknown one makes its pull request full.

Exit 0 when every check passes, 1 otherwise.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PLAN = os.path.join(ROOT, "tools", "ci-plan")
PR_LEGS = "--tier native --firmware bios"
MERGE_LEGS = "--tier native --firmware bios"  # tl29: the merge gate's legs
TIER_LEGS = {"all": "", "full": MERGE_LEGS, "pr": PR_LEGS, "noop": PR_LEGS}
NIGHTLY_RED = os.path.join(ROOT, "tools", "nightly-red")
NET = ["mpx4-net", "mpx4-udp", "mpx4-tcp", "mpx4-ready", "mpx4-session", "mpx4-unix", "mpx4-lobo", "mpx5-jobs"]  # px49: mpx5-jobs (gaps' TCP rows)
MUSIC = ["mpx3-speaker", "mpx3-sound", "mpx3-orchestra", "mpx4-session"]
fails = 0


def say(ok, what):
    global fails
    print("ci-plan: %s %s" % ("PASS" if ok else "FAIL", what))
    fails += not ok


def plan(paths=None, **kw):
    args = [PLAN, "--json"]
    for k, v in kw.items():
        args += ["--" + k.replace("_", "-"), v]
    env = {k: v for k, v in os.environ.items()
           if k not in ("EVENT", "ACTION", "LABEL", "LABELS", "BASE", "HEAD", "IN_TIER", "IN_SUITES")}
    if paths is not None:
        args += ["--paths-from", "-"]
    r = subprocess.run(args, input="\n".join(paths or []) + "\n", capture_output=True, text=True, env=env)
    if r.returncode != 0:
        return {"tier": "ERROR rc=%d %s" % (r.returncode, r.stderr.strip()[-300:]), "suites": [], "legs": ""}
    return json.loads(r.stdout)


def jobs():
    out, inside = [], False
    for line in open(os.path.join(ROOT, ".github/workflows/ci.yml")):
        if line.rstrip() == "jobs:":
            inside = True
        elif inside:
            m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", line)
            if m:
                out.append(m.group(1))
    return out


JOBS = jobs()
SUITES = [j for j in JOBS if j not in ("plan", "tier")]


def expect(name, got, tier, suites=None, has=(), lacks=(), legs=None):
    why = []
    if got["tier"] != tier:
        why.append("tier %s, wanted %s" % (got["tier"], tier))
    if suites is not None and sorted(got["suites"]) != sorted(suites):
        why.append("suites %s, wanted %s" % (" ".join(got["suites"]) or "none", " ".join(suites) or "none"))
    for s in has:
        if s not in got["suites"]:
            why.append("lacks " + s)
    for s in lacks:
        if s in got["suites"]:
            why.append("has " + s)
    if legs is None:
        legs = TIER_LEGS.get(tier, "?")
    if got["legs"] != legs:
        why.append("legs '%s', wanted '%s'" % (got["legs"], legs))
    shown = "every suite (%d)" % len(SUITES) if sorted(got["suites"]) == sorted(SUITES) else (" ".join(got["suites"]) or "no suite")
    say(not why, "%s: %s%s" % (name, tier, (" (" + "; ".join(why) + ")") if why else ", " + shown))


