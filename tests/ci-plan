  *) printf '{"check_runs": []}\n' ;;
esac
'''


def check_run(name, conclusion="success", status="completed", app="github-actions", url="https://github.com/wolffe-lang/pax/runs/1"):
    return {"name": name, "status": status, "conclusion": conclusion, "app": {"slug": app}, "html_url": url}


def covered(all_runs=(), full_runs=(), rc=0, unset=False):
    d = tempfile.mkdtemp(prefix="ci-plan-checks-")
    try:
        with open(os.path.join(d, "gh"), "w") as f:
            f.write(FAKE_CHECKS)
        os.chmod(os.path.join(d, "gh"), 0o755)
        log = os.path.join(d, "log")
        env = dict(os.environ, PATH=d + os.pathsep + os.environ.get("PATH", ""), FAKE_LOG=log, FAKE_RC=str(rc),
                   FAKE_ALL=json.dumps({"check_runs": list(all_runs)}), FAKE_FULL=json.dumps({"check_runs": list(full_runs)}),
                   REPO="wolffe-lang/pax", SHA="a" * 40)
        if unset:
            env.pop("REPO"); env.pop("SHA")
        out = os.path.join(d, "out")
        r = subprocess.run([COVERED, "--github-output", out], capture_output=True, text=True, env=env)
        got = dict(l.split("=", 1) for l in open(out).read().splitlines() if "=" in l) if os.path.exists(out) else {}
        calls = open(log).read().splitlines() if os.path.exists(log) else []
        return r.returncode, got, calls
    except OSError as e:
        return -1, {"error": str(e)}, []
    finally:
        shutil.rmtree(d, ignore_errors=True)


