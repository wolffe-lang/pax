#!/usr/bin/env python3
"""tests/ci-plan — the CI planner's own proof (px37, px40). No QEMU: python3 only.

    tests/ci-plan

  P1  the tiers by event: a trunk push, the nightly, a dispatch, the
      `full-matrix` label are full (every suite, every leg); another
      label's `labeled` event is a noop; a dispatch can ask for the pr
      leg or for named suites.
  P2  the pr tier by path, one change per area: the network's suites for
      kernel/tcp, sound's for user/play, nothing for notes; a kmain, a
      test, a user program and a shared device select their readers.
      The kernel's core (px40, ruling #76: its fifteen modules and their
      assembly) and CI's own files select every suite, on the pr leg.
  P3  FULL wins: the toolchain pins, the harness, the kernel's entry,
      link script and Limine configuration, and any path no rule knows
      make a pull request's run full, alone or beside a core change; a
      pull request whose changed paths cannot be read is full too.
  P4  the wiring of .github/workflows/ci.yml: every suite job needs the
      plan and runs only when chosen; every test that takes a leg gets
      $PAX_LEGS and accepts --tier and --firmware; the `tier` job needs
      every job and runs unless cancelled; cancel-in-progress is for
      pull requests only and every other run has a concurrency group
      of its own run id; the trunk push, the nightly and the label are
      triggers.
  P6  the verdict (`tools/ci-plan --verdict`, the `tier` job): green for
      a full run whose `legs` output is absent (GitHub drops an empty
      output; run 38344726280 was red on exactly that), for a pr run
      and a noop; red for a chosen suite failed, skipped or cancelled,
      a suite that ran unasked, a failed plan, a plan with no suites.
  P5  (a WARN, not a failure) every tracked path is known to the map or
      read by a suite; an unknown one makes its pull request full.

Exit 0 when every check passes, 1 otherwise.
"""
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PLAN = os.path.join(ROOT, "tools", "ci-plan")
PR_LEGS = "--tier native --firmware bios"
NET = ["mpx4-net", "mpx4-udp", "mpx4-tcp", "mpx4-ready", "mpx4-session", "mpx4-unix", "mpx4-lobo"]
MUSIC = ["mpx3-speaker", "mpx3-sound", "mpx3-orchestra", "mpx4-session"]
fails = 0


def say(ok, what):
    global fails
    print("ci-plan: %s %s" % ("PASS" if ok else "FAIL", what))
    fails += not ok


def plan(paths=None, **kw):
    args = [PLAN, "--json"]
    for k, v in kw.items():
        args += ["--" + k.replace("_", "-"), v]
    env = {k: v for k, v in os.environ.items()
           if k not in ("EVENT", "ACTION", "LABEL", "LABELS", "BASE", "HEAD", "IN_TIER", "IN_SUITES")}
    if paths is not None:
        args += ["--paths-from", "-"]
    r = subprocess.run(args, input="\n".join(paths or []) + "\n", capture_output=True, text=True, env=env)
    if r.returncode != 0:
        return {"tier": "ERROR rc=%d %s" % (r.returncode, r.stderr.strip()[-300:]), "suites": [], "legs": ""}
    return json.loads(r.stdout)


def jobs():
    out, inside = [], False
    for line in open(os.path.join(ROOT, ".github/workflows/ci.yml")):
        if line.rstrip() == "jobs:":
            inside = True
        elif inside:
            m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", line)
            if m:
                out.append(m.group(1))
    return out


JOBS = jobs()
SUITES = [j for j in JOBS if j not in ("plan", "tier")]


def expect(name, got, tier, suites=None, has=(), lacks=(), legs=None):
    why = []
    if got["tier"] != tier:
        why.append("tier %s, wanted %s" % (got["tier"], tier))
    if suites is not None and sorted(got["suites"]) != sorted(suites):
        why.append("suites %s, wanted %s" % (" ".join(got["suites"]) or "none", " ".join(suites) or "none"))
    for s in has:
        if s not in got["suites"]:
            why.append("lacks " + s)
    for s in lacks:
        if s in got["suites"]:
            why.append("has " + s)
    if legs is None:
        legs = "" if tier == "full" else PR_LEGS
    if got["legs"] != legs:
        why.append("legs '%s', wanted '%s'" % (got["legs"], legs))
    shown = "every suite (%d)" % len(SUITES) if sorted(got["suites"]) == sorted(SUITES) else (" ".join(got["suites"]) or "no suite")
    say(not why, "%s: %s%s" % (name, tier, (" (" + "; ".join(why) + ")") if why else ", " + shown))


# --- P1 the tiers by event ------------------------------------------------------
expect("P1 a push to trunk", plan(event="push"), "full", SUITES)
expect("P1 the nightly", plan(event="schedule"), "full", SUITES)
expect("P1 a dispatch, no inputs", plan(event="workflow_dispatch"), "full", SUITES)
expect("P1 a dispatch, tier pr", plan(event="workflow_dispatch", tier="pr"), "pr", SUITES)
expect("P1 a dispatch, one suite", plan(event="workflow_dispatch", suites="mpx3-tree"), "full", ["mpx3-tree"])
expect("P1 a dispatch, proof brings macos-run", plan(event="workflow_dispatch", suites="proof"), "full", ["proof", "macos-run"])
expect("P1 a pull request labelled full-matrix, notes only",
       plan(["notes/px99.md"], event="pull_request", action="synchronize", labels="bug,full-matrix"), "full", SUITES)
expect("P1 the full-matrix label added",
       plan(["notes/px99.md"], event="pull_request", action="labeled", label="full-matrix", labels="full-matrix"), "full", SUITES)
expect("P1 another label added",
       plan(["kernel/tcp/tcp.lu"], event="pull_request", action="labeled", label="bug", labels="bug"), "noop", [])

# --- P2 the pr tier by path -------------------------------------------------------
pr = dict(event="pull_request", action="synchronize")
expect("P2 a network change (kernel/tcp)", plan(["kernel/tcp/tcp.lu"], **pr), "pr", NET)
expect("P2 a network change with its test and its note",
       plan(["kernel/tcp/tcp.lu", "tests/mpx4-tcp", "notes/px99-tcp.md"], **pr), "pr", NET)
expect("P2 a music change (user/play)", plan(["user/play/play.lu"], **pr), "pr", MUSIC)
expect("P2 a music change with its test and its note",
       plan(["user/play/parts.lu", "tests/mpx3-orchestra", "notes/px99-format.md"], **pr), "pr", MUSIC)
expect("P2 play's replay test (px33)", plan(["user/play/parts-test/replay", "user/play/orch.lu"], **pr), "pr", MUSIC)
expect("P2 the tree's typed session (px36)", plan(["user/console/shell-changes.keys", "user/elf/tree.c"], **pr), "pr", has=["mpx3-tree"], lacks=["mpx4-tcp", "mpx2-heap"])
expect("P2 net-peer's own witness (px35) is mpx4-tcp's", plan(["tests/paxtcp-selftest"], **pr), "pr", ["mpx4-tcp"])
expect("P2 net-peer's TCP reaches its witness and the peers", plan(["tools/paxtcp.py"], **pr), "pr", has=["mpx4-tcp", "mpx4-net", "mpx4-ready"], lacks=["mpx3-orchestra"])
expect("P2 mpx4-net's renew step (px35)", plan(["tests/mpx4-net", "kernel/kmain_net.lu", "kernel/arp/arp.lu"], **pr), "pr", NET)
expect("P2 a notes-only change", plan(["notes/px99-x.md", "notes/px99/run.txt", "README.md"], **pr), "pr", [])
expect("P2 two areas: the union", plan(["kernel/tcp/tcp.lu", "user/play/play.lu"], **pr), "pr", sorted(set(NET + MUSIC)))
expect("P2 a kmain selects its suites", plan(["kernel/kmain_sockets.lu"], **pr), "pr",
       has=["mpx4-udp", "mpx4-tcp", "mpx4-ready"], lacks=["mpx3-orchestra", "mpx2-heap"])
expect("P2 a test selects itself", plan(["tests/mpx3-tree"], **pr), "pr", has=["mpx3-tree"], lacks=["mpx4-tcp"])
expect("P2 a user program selects its reader", plan(["user/elf/threads.c"], **pr), "pr", has=["mpx3-threads"], lacks=["mpx4-tcp"])
expect("P2 the bus the sound device shares", plan(["kernel/pci/pci.lu"], **pr), "pr", has=["mpx4-net", "mpx3-sound"], lacks=["mpx2-heap"])
expect("P2 the stub selects the proof and macos-run", plan(["boot/stub/stub.S"], **pr), "pr", has=["proof", "macos-run"], lacks=["mpx4-tcp"])
expect("P2 lobo's own (px25)", plan(["user/lobo/steps/serve.steps", "tools/lobo-check"], **pr), "pr", has=["mpx4-lobo"], lacks=["mpx3-orchestra", "mpx2-heap"])
expect("P2 procfs reaches lobo", plan(["kernel/procfs/procfs.lu"], **pr), "pr", has=["mpx4-lobo", "mpx4-unix"])
expect("P2 who a process is (px39) reaches every user suite", plan(["kernel/cred/cred.lu"], **pr), "pr",
       has=["mpx5-users", "mpx3-tree", "mpx3-shell", "mpx4-lobo"], lacks=["mpx2-heap", "census"])
expect("P2 the credentials' programs and recordings are mpx5-users' alone",
       plan(["user/elf/cred.c", "user/elf/ident.c", "tools/mkcred", "tests/mpx5-users.d/linux/cred.txt"], **pr), "pr", ["mpx5-users"])
expect("P2 the census's own", plan(["docs/CENSUS.md"], **pr), "pr", ["census"])
expect("P2 CI itself: every suite, the pr leg", plan([".github/workflows/ci.yml"], **pr), "pr", SUITES)

# The kernel's core (px40, ruling #76): every suite, on the pr leg.
CORE = ["serial", "log", "panic", "boot_info", "frames", "paging", "gdt", "idt", "interrupts",
        "apic", "timer", "heap", "sync", "sched", "fpu"]
CORE_ASM = ["boot/io.S", "boot/cpu.S", "boot/isr.S", "boot/sched.S", "boot/fpu.S"]
expect("P2 a core-only change (kernel/sched): every suite, the pr leg", plan(["kernel/sched/sched.lu"], **pr), "pr", SUITES)
for p in ["kernel/%s/%s.lu" % (m, m) for m in CORE] + CORE_ASM:
    expect("P2 the core: %s" % p, plan([p, "notes/px99.md"], **pr), "pr", SUITES)
expect("P2 the core beside a narrow change", plan(["kernel/tcp/tcp.lu", "kernel/sched/sched.lu"], **pr), "pr", SUITES)

# --- P3 FULL wins ---------------------------------------------------------------------
PINS = ["kernel/wolf.pin", "kernel/wolf.pkg", "boot/limine.pin"]
HARNESS = ["tools/lib.sh", "tools/build-kernel", "tools/mkimage", "tools/fetch-wolf", "tools/fetch-limine",
           "tools/qemu-halt", "tools/qemu-run", "tools/qemu-fault", "tools/expect-serial"]
ENTRY = ["boot/start.S", "boot/kernel.ld", "boot/limine.conf"]
for p in PINS + HARNESS + ENTRY:
    expect("P3 %s" % p, plan([p, "notes/px99.md"], **pr), "full", SUITES)
expect("P3 a path no rule knows", plan(["newplace/thing.c"], **pr), "full", SUITES)
expect("P3 FULL beside a narrow change", plan(["kernel/tcp/tcp.lu", "kernel/wolf.pin"], **pr), "full", SUITES)
expect("P3 a pin beside a core change", plan(["kernel/sched/sched.lu", "kernel/wolf.pin"], **pr), "full", SUITES)
expect("P3 a harness tool beside a core change", plan(["kernel/heap/heap.lu", "tools/qemu-run"], **pr), "full", SUITES)
expect("P3 an unknown path beside a core change", plan(["kernel/sched/sched.lu", "newplace/thing.c"], **pr), "full", SUITES)
expect("P3 no changed paths to read", plan(**pr), "full", SUITES)
expect("P3 a diff git cannot take", plan(base="0" * 40, head="1" * 40, **pr), "full", SUITES)

# --- P6 the verdict -----------------------------------------------------------------------
def verdict(needs):
    env = dict(os.environ, NEEDS=json.dumps(needs))
    r = subprocess.run([PLAN, "--verdict"], capture_output=True, text=True, env=env)
    return r.returncode, r.stdout + r.stderr


def run_of(tier, chosen, results=None, legs=PR_LEGS):
    outs = {"tier": tier, "suites": json.dumps(chosen)}
    if legs:  # GitHub leaves an empty output out of `needs`
        outs["legs"] = legs
    n = {"plan": {"result": "success", "outputs": outs}}
    for s in SUITES:
        n[s] = {"result": "success" if s in chosen else "skipped", "outputs": {}}
    n.update(results or {})
    return n


def vexpect(name, needs, want):
    rc, text = verdict(needs)
    say(rc == want, "P6 %s: exit %d%s" % (name, rc, "" if rc == want else " (wanted %d) %s" % (want, text.strip()[-200:])))


vexpect("a green full run, its legs output absent", run_of("full", SUITES, legs=""), 0)
vexpect("a green pr run of two suites", run_of("pr", ["mpx3-sound", "census"]), 0)
vexpect("a noop run", run_of("noop", []), 0)
vexpect("a chosen suite failed", run_of("full", SUITES, {"mpx1": {"result": "failure", "outputs": {}}}, legs=""), 1)
vexpect("a chosen suite was skipped", run_of("pr", ["mpx3-sound"], {"mpx3-sound": {"result": "skipped", "outputs": {}}}), 1)
vexpect("a chosen suite was cancelled", run_of("pr", ["mpx3-sound"], {"mpx3-sound": {"result": "cancelled", "outputs": {}}}), 1)
vexpect("a suite ran unasked", run_of("pr", ["census"], {"mpx4-tcp": {"result": "success", "outputs": {}}}), 1)
vexpect("the plan failed", {"plan": {"result": "failure", "outputs": {}}, "census": {"result": "skipped", "outputs": {}}}, 1)
vexpect("the plan chose nothing readable", {"plan": {"result": "success", "outputs": {}}, "census": {"result": "skipped", "outputs": {}}}, 1)

# --- P4 the wiring -------------------------------------------------------------------------
wf = open(os.path.join(ROOT, ".github/workflows/ci.yml")).read()
blocks = {}
for j in JOBS:
    m = re.search(r"^  %s:\s*\n(.*?)(?=^  [A-Za-z0-9_-]+:\s*$|\Z)" % re.escape(j), wf, re.M | re.S)
    blocks[j] = m.group(1) if m else ""
say("plan" in JOBS and "tier" in JOBS, "P4 the workflow has a plan job and a tier job")
for j in SUITES:
    b = blocks[j]
    needs = "[plan, proof]" if j == "macos-run" else "plan"
    ok = ("    needs: %s\n" % needs) in b and ("    if: contains(fromJSON(needs.plan.outputs.suites), '%s')\n" % j) in b
    why = ""
    script = os.path.join(ROOT, "tests", j)
    run = re.search(r"^\s+run: tests/%s\b(.*)$" % re.escape(j), b, re.M)
    if run and j not in ("proof", "census"):
        text = open(script).read()
        takes = "--tier)" in text and "--firmware)" in text
        ok = ok and run.group(1).endswith(" $PAX_LEGS") and takes and "PAX_LEGS: ${{ needs.plan.outputs.legs }}" in b
        why = " (the step: tests/%s%s; the script takes --tier/--firmware: %s)" % (j, run.group(1), takes)
    say(ok, "P4 %s needs the plan, runs when chosen%s" % (j, why))
tn = re.findall(r"^      - ([A-Za-z0-9_-]+)\s*$", blocks["tier"], re.M)
say(sorted(tn) == sorted(["plan"] + SUITES) and "    if: ${{ !cancelled() }}" in blocks["tier"],
    "P4 the tier job runs unless cancelled and needs every job (%d of %d)" % (len(tn), len(SUITES) + 1))
say("        run: tools/ci-plan --verdict\n" in blocks["tier"] and "actions/checkout" in blocks["tier"],
    "P4 the tier job's check is tools/ci-plan --verdict")
say("cancel-in-progress: ${{ github.event_name == 'pull_request' }}" in wf, "P4 cancel-in-progress for pull requests only")
group = re.search(r"^concurrency:\n  group: (.*)$", wf, re.M)
say(group is not None and group.group(1).rstrip().endswith("|| format('ci-{0}-{1}', github.event_name, github.run_id) }}"),
    "P4 a run that is no pull request's has a group of its own run id")
say(re.search(r"^  push:\n    branches: \[trunk\]", wf, re.M) is not None, "P4 a push to trunk runs")
say(re.search(r"^  schedule:\n(\s+#.*\n)*\s+- cron: ", wf, re.M) is not None, "P4 the nightly runs")
say("types: [opened, synchronize, reopened, labeled]" in wf, "P4 adding a label starts a run")

# --- P5 every tracked path is known --------------------------------------------------------
try:
    tracked = subprocess.run(["git", "-C", ROOT, "ls-files"], check=True, capture_output=True, text=True).stdout.split()
except (subprocess.CalledProcessError, FileNotFoundError):
    tracked = []
if tracked:
    r = subprocess.run([PLAN, "--event", "pull_request", "--paths-from", "-"], input="\n".join(tracked),
                       capture_output=True, text=True)
    unknown = [l.split(" -> ")[0].replace("ci-plan: ", "") for l in r.stderr.splitlines() if "no rule and no suite reads it" in l]
    if unknown:
        print("ci-plan: WARN P5 %d tracked path(s) no rule knows (a pull request touching one runs full): %s"
              % (len(unknown), " ".join(unknown[:20])))
    else:
        print("ci-plan: PASS P5 every one of %d tracked paths is known" % len(tracked))
else:
    print("ci-plan: WARN P5 not a git checkout: the tracked paths not checked")

print("ci-plan: %s" % ("PASS" if fails == 0 else "FAIL (%d)" % fails))
sys.exit(1 if fails else 0)
