fails = 0


def say(ok, what):
    global fails
    print("ci-plan: %s %s" % ("PASS" if ok else "FAIL", what))
    fails += not ok


def plan(paths=None, **kw):
    args = [PLAN, "--json"]
    for k, v in kw.items():
        args += ["--" + k.replace("_", "-"), v]
    env = {k: v for k, v in os.environ.items()
           if k not in ("EVENT", "ACTION", "LABEL", "LABELS", "BASE", "HEAD", "IN_TIER", "IN_SUITES", "IN_ACCEL")}
    if paths is not None:
        args += ["--paths-from", "-"]
    r = subprocess.run(args, input="\n".join(paths or []) + "\n", capture_output=True, text=True, env=env)
    if r.returncode != 0:
        return {"tier": "ERROR rc=%d %s" % (r.returncode, r.stderr.strip()[-300:]), "suites": [], "legs": "", "also_release": None}
    return json.loads(r.stdout)


def jobs():
    out, inside = [], False
    for line in open(os.path.join(ROOT, ".github/workflows/ci.yml")):
        if line.rstrip() == "jobs:":
            inside = True
        elif inside:
            m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", line)
            if m:
                out.append(m.group(1))
    return out


JOBS = jobs()
SUITES = [j for j in JOBS if j not in ("plan", "tier", "nightly-red")]
# macos-run (the proof's ISO under macOS's QEMU, on one of the few macOS runners) is not in the full
# tier: a pull request's merge gate waits for no macOS runner, and the trunk push (all), the
# nightly and the weekly run it. A pull request whose paths choose the proof still runs it (pr tier).
FULL_SUITES = [s for s in SUITES if s != "macos-run"]


def every(tier):
    return FULL_SUITES if tier == "full" else SUITES


def expect(name, got, tier, suites=None, has=(), lacks=(), legs=None):
    why = []
    if got["tier"] != tier:
        why.append("tier %s, wanted %s" % (got["tier"], tier))
    if suites is not None and sorted(got["suites"]) != sorted(suites):
        why.append("suites %s, wanted %s" % (" ".join(got["suites"]) or "none", " ".join(suites) or "none"))
    for s in has:
        if s not in got["suites"]:
            why.append("lacks " + s)
    for s in lacks:
        if s in got["suites"]:
            why.append("has " + s)
    if legs is None:
        legs = TIER_LEGS.get(tier, "?")
    if got["legs"] != legs:
        why.append("legs '%s', wanted '%s'" % (got["legs"], legs))
    shown = ("every suite (%d)" % len(SUITES) if sorted(got["suites"]) == sorted(SUITES) else
             "every suite but macos-run (%d)" % len(FULL_SUITES) if sorted(got["suites"]) == sorted(FULL_SUITES) else
             " ".join(got["suites"]) or "no suite")
    say(not why, "%s: %s%s" % (name, tier, (" (" + "; ".join(why) + ")") if why else ", " + shown))


