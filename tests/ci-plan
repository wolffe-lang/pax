# --- P13 BusyBox from the cache, by the pin's sha256 ------------------------------------------
def bb_jobs(text):
    """Each job's body lines."""
    jobs, job, inside = {}, None, False
    for l in text.splitlines():
        if l.rstrip() == "jobs:":
            inside = True
        elif inside:
            m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", l)
            if m:
                job = m.group(1)
                jobs[job] = []
            elif job is not None:
                jobs[job].append(l)
    return jobs


def bb_steps(body):
    """A job's steps, each as its text with the step's own keys at column 0."""
    steps, on = [], False
    for l in body:
        if l.startswith("    steps:"):
            on = True
        elif on and l.startswith("      - "):
            steps.append([l[8:]])
        elif on and steps and (l.startswith("        ") or not l.strip()):
            steps[-1].append(l[8:])
        elif on and l.strip() and not l.startswith("      "):
            on = False
    return ["\n".join(s) for s in steps]


# Whose suite needs BusyBox, in which shape; and the suites that fetch it for a live Linux side alone (a host
# with a readable kernel), go on without it, and so get no fetch that could stop their job.
BB_OWN_STEP = ("usb-stick", "mpx5-jobs")
BB_AROUND = {"mpx5-pelt": "tests/ci-budgets.py cannot time a new named step of mpx5-pelt whose plan job it reddens"}
BB_LIVE_ONLY = ("mpx6-ext2", "mpx6-nvme")


def bb_check(text, script, shape):
    """(the jobs that run tests/SCRIPT, what each lacks for SHAPE: own, around or restore)."""
    chosen, problems = [], []
    for job, body in bb_jobs(text).items():
        steps = bb_steps(body)
        suite = [i for i, st in enumerate(steps) if re.search(r"(^|[\s;&|(])tests/%s(\s|$)" % re.escape(script), st, re.M)]
        if not suite:
            continue
        chosen.append(job)
        pins = [i for i, st in enumerate(steps) if re.search(r"^id: \S+$", st, re.M) and "BUSYBOX_DEB_SHA256" in st
                and "user/busybox.pin" in st and "GITHUB_OUTPUT" in st]
        if not pins:
            problems.append("%s reads no BUSYBOX_DEB_SHA256 from user/busybox.pin into a step's output" % job)
            continue
        key = "busybox-${{ steps.%s.outputs.sha256 }}" % re.search(r"^id: (\S+)$", steps[pins[0]], re.M).group(1)

        def cache(uses):
            return [i for i, st in enumerate(steps) if re.search(r"^uses: %s$" % re.escape(uses), st, re.M)
                    and re.search(r"^  key: %s$" % re.escape(key), st, re.M) and re.search(r"^  path: \.pax-cache/busybox-\*$", st, re.M)]
        restore, save = cache("actions/cache/restore@v4"), cache("actions/cache/save@v4")
        fetch = [i for i, st in enumerate(steps) if re.search(r"^run: tools/fetch-busybox \S+$", st, re.M)]
        if not restore or not pins[0] < restore[0] < suite[0]:
            problems.append("%s restores no .pax-cache/busybox-* under %s between the pin and the suite" % (job, key))
        elif shape == "own":
            if not fetch or not restore[0] < fetch[0] < suite[0]:
                problems.append("%s fetches BusyBox in no step of its own between the restore and the suite" % job)
            elif not save or not fetch[0] < save[0] < suite[0] or not re.search(r"^if: .*cache-hit != 'true'", steps[save[0]], re.M):
                problems.append("%s saves no BusyBox after its fetch, before the suite, when the restore missed" % job)
        elif shape == "around":
            named = [i for i in (pins[0], restore[0]) + tuple(save[:1]) if re.search(r"^name: ", steps[i], re.M)]
            if fetch:
                problems.append("%s fetches BusyBox in a step of its own" % job)
            elif not save or not save[0] > suite[0] or not re.search(r"^if: .*always\(\).*cache-hit != 'true'.*hashFiles\('\.pax-cache/busybox-\*'\)", steps[save[0]], re.M):
                problems.append("%s saves no BusyBox after the suite (always, when the restore missed and there is one)" % job)
            elif named:
                problems.append("%s names a BusyBox step, which the step budget cannot time" % job)
        elif shape == "restore":
            if fetch or save:
                problems.append("%s fetches or saves BusyBox, which nothing there needs" % job)
    return chosen, problems


