    "nothing else sets it or FETCH_RETRY_OWN, and no pull_request_target%s" % (TOKEN, " ".join(writers) or "none", (": " + "; ".join(tp)) if tp else ""))


def token_refused(name, change, words):
    """None when ci.yml changed by CHANGE (a function of its text) is refused with WORDS in a problem."""
    changed = change(wf_text)
    if changed == wf_text and name != "the nightly-red job without its empty token":
        return "%s (cannot be made from ci.yml)" % name
    got = token_problems(changed)
    return None if any(words in p for p in got) else "%s (said: %s)" % (name, "; ".join(got) or "nothing")


