# --- P16 every step that runs apt-get ends when apt stalls (pax#540) ----------------------------
# pax#540: an apt step takes a median of 322 s, at most 510 s, in a full run, and none that succeeded took over 17
# minutes among the 20,479 jobs read (their installs up to 999 s, their updates up to 85 s). The stalls, every one in
# `apt-get update`, held their jobs 45 to 160 minutes. tools/apt-update stops an update silent for 120 s and tries it
# once more; the step's limit bounds the rest.
APT_STEP_MINUTES = 25


def apt_problems(step):
    """What keeps one step that runs apt-get from ending when apt stalls: [] when nothing does."""
    if "apt-get" not in step and "tools/apt-update" not in step:
        return []
    found = []
    limit = re.search(r"^        timeout-minutes: (\d+)$", step, re.M)
    if not limit:
        found.append("no timeout-minutes of its own")
    elif int(limit.group(1)) > APT_STEP_MINUTES:
        found.append("timeout-minutes %s, over %d" % (limit.group(1), APT_STEP_MINUTES))
    if re.search(r"apt-get\s+(?:-\S+\s+)*update\b", step):
        found.append("a bare apt-get update")
    update = re.search(r"^          sudo tools/apt-update$", step, re.M)
    install = re.search(r"apt-get\s+(?:-\S+\s+)*install\b", step)
    if not update:
        found.append("no sudo tools/apt-update")
    elif install and install.start() < update.start():
        found.append("an install before the update")
    return found


GOOD_APT = ("      - name: qemu (apt)\n        timeout-minutes: %d\n        run: |\n          sudo tools/apt-update\n"
            "          sudo apt-get install -y -q qemu-system-x86\n" % APT_STEP_MINUTES)
apt_says_no = (not apt_problems(GOOD_APT)
               and apt_problems(GOOD_APT.replace("        timeout-minutes: %d\n" % APT_STEP_MINUTES, ""))
               and apt_problems(GOOD_APT.replace("timeout-minutes: %d" % APT_STEP_MINUTES,
                                                 "timeout-minutes: %d" % (APT_STEP_MINUTES + 1)))
               and apt_problems(GOOD_APT.replace("sudo tools/apt-update", "sudo apt-get update -q"))
               and apt_problems(GOOD_APT.replace("          sudo tools/apt-update\n", "")
                                + "          sudo tools/apt-update\n"))
apt_steps, apt_bad = 0, []
for j in JOBS:
    for st in re.split(r"(?m)^(?=      - )", blocks[j]):
        if not st.startswith("      - "):
