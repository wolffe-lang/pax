#!/usr/bin/env bash
# tests/mpx4-unix — px34: AF_UNIX path sockets and the rest lobo asks of
# PAX before px25. Three sessions run on PAX and on Linux and are
# compared byte for byte:
#
#   - probes (user/unix/unixprobe.c, tools/mkunix), one static glibc
#     program, the first program on PAX and pid 1 on Linux with its
#     root a tmpfs and /proc, /sys and /sys/fs/cgroup mounted: socket,
#     bind, listen and the queue, accept4, connect and its errnos, a
#     name unlinked while its socket listens and one a closed socket
#     left, data, the end of a stream, EPIPE and SIGPIPE, a reset,
#     shutdown, getsockname and getpeername, getsockopt, poll and epoll
#     on each kind of Unix socket and between two processes,
#     socketpair(AF_UNIX, SOCK_SEQPACKET)'s message boundaries, the
#     files of /proc and /sys lobo reads, and memory mapped with
#     MAP_NORESERVE (backed where it is touched, given back by
#     MADV_DONTNEED and MADV_FREE, a PROT_NONE guard inside it);
#   - soak (`unixprobe soak`): 10,000 connections through one listener
#     in a second process, a request and an answer each;
#   - ctl (user/unix/ctl.c): a control server shaped as lobo's and, as
#     its child, lobo's own client — `/bin/lobo -c conf/lobo.conf
#     status`, lobo at user/lobo.pin built by tools/mklobo — which
#     prints what the server answered; then `status`, `reload` and
#     `stop` from ctl's own client, and the name unlinked.
#
#   tests/mpx4-unix [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                   [--lobo DIR] [--firmware bios|uefi|both] [--tier native|release|both]
#
# **Nothing under test runs on a host.** The Linux side of every session
# is tools/linux-tree --sys: a throwaway container with no network and
# nothing of the host mounted but a staging directory under the build
# directory. `--only build` makes the programs and the images and stops;
# `--only linux --images DIR` then runs the Linux side.
#
# Images, per tier: unix-probes, unix-soak, unix-ctl, one kernel,
# kmain_console. Assertions, per tier, firmware and session:
#   U0 build: kmain_console built; every program static; the images
#      built (digests printed); the Linux side ran every session in its
#      container.
#   U1 the output, differential: every line the session wrote on PAX
#      (the kernel's own `user: …` lines left out) is byte-identical to
#      what it wrote on Linux, and the exit status is Linux's. A line
#      that starts with `~` (what is the machine's: its CPUs, its
#      controllers, the descriptor limit, the memory a page costs, what
#      PAX refuses by name) is left out of the comparison and held to
#      PAX's own answer (U2).
#   U2 probes, PAX's own answers: the `~refused` line names exactly the
#      six things PAX refuses by name (a SOCK_RAW, SOCK_SEQPACKET or
#      SOCK_DGRAM Unix socket -ESOCKTNOSUPPORT, an option set on one
#      -ENOPROTOOPT, an abstract name and autobind -EINVAL), each with
#      its `refused:` line from the kernel; a seqpacket message larger
#      than its buffer -EMSGSIZE; the `/proc` and `/sys` lines PAX makes
#      (one CPU, the one controller, 1024 descriptors); and the
#      MAP_NORESERVE region: nothing backed at the mmap, three pages and
#      the read's page after the touches (12 kB), all of them back
#      after MADV_DONTNEED and MADV_FREE.
#   U3 -ENOSYS only for set_robust_list (273) and rseq (334); no
#      `refused:` line but U2's and U5's; two processes killed in the probes (the
#      child that touches the guard: a page fault, SIGSEGV; the child
#      that sends without MSG_NOSIGNAL to a peer gone: SIGPIPE), none
#      elsewhere.
#   U4 everything given back: the frames line shows as many frames free
#      after init's end as before the first program; the tree's frames
#      and inodes as when it was made but for the inode table's growth;
#      and the kernel's `unix:` books line, 0 sockets and 0 buffers.
#   U5 soak: the kernel's census lines, one every 2,500 connections
#      (`user: unixprobe pid 1 unix: <n> connections since boot;
#      sockets <s>, buffers <b>, frames free <f>`), four, and flat; then,
#      with every frame the program could take taken, a thread's clone
#      answered EAGAIN (`~stack: … a thread then: EAGAIN`) with its
#      `refused:` line (no frame for a thread's kernel stack; and the two
#      mmap refusals, out of frames, that took the memory), and a
#      thread made again once the memory was given back (U1).
#   U6 ctl: lobo's client exited 0 and printed the server's answer (U1
#      holds it to Linux's).
#   U7 the end: `PAX: init … ended with status <s>; nothing left to
#      run`, `halt`, and qemu-halt holds the machine halted.
# The probes session of the first leg runs first, and the suite stops
# at its first failure: `stopped early`. A boot ends at the kernel's
# `halt` or at a `PANIC` line, whichever comes, each with a deadline of
# 300 s: a planted break fails fast.
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only= lobodir=
usage="usage: tests/mpx4-unix [--images DIR | --no-boot | --only build | --only linux --images DIR] [--lobo DIR] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --lobo)     lobodir=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3

SESSIONS="probes soak ctl"
init_of() { case $1 in ctl) echo ctl ;; *) echo unixprobe ;; esac; }
args_of() { case $1 in soak) echo soak ;; *) echo ;; esac; }
mem_of() { case $1 in ctl) echo 512M ;; *) echo 256M ;; esac; }
REFUSED='~refused: socket SOCK_RAW ESOCKTNOSUPPORT, socket SOCK_SEQPACKET ESOCKTNOSUPPORT, socket SOCK_DGRAM ESOCKTNOSUPPORT, setsockopt SO_REUSEADDR ENOPROTOOPT, bind abstract EINVAL, bind autobind EINVAL'
REFUSALS='syscall 41: refused: an AF_UNIX socket of a type PAX has on a path neither (SOCK_STREAM only), -94|syscall 41: refused: an AF_UNIX socket of a type PAX has on a path neither (SOCK_STREAM only), -94|syscall 41: refused: an AF_UNIX socket of a type PAX has on a path neither (SOCK_STREAM only), -94|syscall 49: refused: an abstract name or autobind (PAX names Unix sockets by path only), -22|syscall 49: refused: an abstract name or autobind (PAX names Unix sockets by path only), -22|syscall 54: refused: an option set on a Unix socket (PAX has none to set), -92'
SEQ_LINE='~seqpacket: a message of 8000 bytes: -EMSGSIZE'
PAX_LINES='~  FDSize:	1024|~  VmRSS:	*|~  Cpus_allowed_list:	0|~  * lines|~  "cpu"|~  "0"|~rlimit: RLIMIT_NOFILE 1024 1024'
STACK_REFUSAL="syscall 56: refused: no frame for a thread's kernel stack, -11|syscall 9: refused: out of frames, -12|syscall 9: refused: out of frames, -12"
NORESERVE='~noreserve: VmRSS * kB before, 0 kB more after the mmap|~noreserve: 12 kB more after three pages and a read|~noreserve: -12 kB after MADV_FREE than before it'

work=$PAX_BUILD/mpx4-unix
runs=$PAX_BUILD/mpx4-unix-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The Linux side of every session, each in its own throwaway container.
linux_side() { # dir -> reasons on stdout
    local s i a
    mkdir -p "$1/linux"
    for s in $SESSIONS; do
        i=$(init_of "$s") a=$(args_of "$s")
        # shellcheck disable=SC2086
        if "$PAX_ROOT/tools/linux-tree" --root "$1/$s/root" --keys "$1/none.keys" --prompt '$ ' --argv0 "/bin/$i" --size 64m --sys \
            "$1/linux/$s.tty" -- "/bin/$i" $a; then
            say "  linux $s: $(wc -c < "$1/linux/$s.tty" | tr -d ' ') bytes, status $(cat "$1/linux/$s.tty.rc")"
        else
            printf ' tools/linux-tree %s;' "$s"
        fi
    done
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS U0 (linux): the Linux side ran every session, each in a throwaway container" || bad "U0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    mkdir -p "$work/bin"
    why=
    "$PAX_ROOT/tools/mkunix" "$work/bin" > "$work/unix.txt" || why+=" tools/mkunix;"
    sed 's/^/  program: /' "$work/unix.txt" >&2
    if [ -n "$lobodir" ]; then
        cp "$lobodir/lobo" "$work/bin/lobo" || why+=" no $lobodir/lobo;"
        say "lobo from $lobodir"
    elif "$PAX_ROOT/tools/mklobo" "$work/lobobin" > "$work/lobo.txt"; then
        cp "$work/lobobin/lobo" "$work/bin/lobo"
    else
        why+=" tools/mklobo;"
    fi
    : > "$work/none.keys"
    for s in $SESSIONS; do
        r=$work/$s/root
        mkdir -p "$r/bin" "$r/etc"
        i=$(init_of "$s") a=$(args_of "$s")
        cp "$work/bin/$i" "$r/bin/$i" || why+=" no $i;"
        if [ "$s" = ctl ]; then
            cp "$work/bin/lobo" "$r/bin/lobo" || why+=" no lobo;"
            mkdir -p "$r/conf"
            cp "$PAX_ROOT/user/unix/lobo.conf" "$r/conf/lobo.conf"
        fi
        echo "/bin/$i${a:+ $a}" > "$r/etc/pax-run"
    done
    for f in "$work/bin/unixprobe" "$work/bin/ctl" "$work/bin/lobo"; do
        r=$(static_ok "$f") || why+=" $r;"
        say "  program: ${f#"$work"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    for s in $SESSIONS; do
        pairs=()
        r=$work/$s/root
        for f in $(cd "$r" && find . -type f | sort); do
            f=${f#./}
            mode=644; [ -x "$r/$f" ] && mode=755
            pairs+=("/$f=$r/$f:$mode")
        done
        if "$PAX_ROOT/tools/mkinitramfs" "$work/$s.cpio" "${pairs[@]}" > "$work/$s.initramfs.txt"; then
            sed "s/^/  initramfs $s: /" "$work/$s.initramfs.txt" >&2
        else
            why+=" tools/mkinitramfs $s;"
        fi
    done
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            cat "$log" >&2
            for s in $SESSIONS; do
                "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                    --add "$work/$s.cpio" initramfs.cpio "$elf" "$work/$tier/unix-$s.iso" >/dev/null \
                    || why+=" $tier unix-$s: mkimage;"
                say "built $tier unix-$s: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/unix-$s.iso"), initramfs $(sha256_of "$work/$s.cpio")"
            done
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS U0 (build): kmain_console built ($tiers), every program static, three images a tier" || bad "U0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS U0: kmain_console built ($tiers), every program static, three images a tier, Linux ran $(echo $SESSIONS | wc -w | tr -d ' ') sessions, each in a throwaway container" || bad "U0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx4-unix build (U0): PASS (no boot: --no-boot)" || say "mpx4-unix build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux
[ -d "$lx" ] || die "no $lx (build first, and run the Linux side)"

record() { # tier leg session status
    ran=$((ran + 1))
    printf '%s kmain_console %s %s halt-status=%s accel=%s serial=%s iso=%s\n' "$1" "$2" "$3" "$4" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" \
        "$(sha256_of "$iso")" >> "$runs"
}

# Whether every line of `got` (|-separated) matches its glob in `want`
# (|-separated), in order.
lines_match() { # got want
    local g w
    IFS='|' read -r -a g <<< "$1"
    IFS='|' read -r -a w <<< "$2"
    [ "${#g[@]}" = "${#w[@]}" ] || return 1
    for k in "${!w[@]}"; do
        # shellcheck disable=SC2053
        [[ ${g[$k]} == ${w[$k]} ]] || return 1
    done
}

mkdir -p "$PAX_BUILD"
: > "$runs"
stopped=
for leg in $legs; do
    [ -z "$stopped" ] || break
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        [ -z "$stopped" ] || break
        for s in $SESSIONS; do
            i=$(init_of "$s")
            id="$tier $leg $s"
            before=$fail
            log=$PAX_BUILD/mpx4-unix-$tier-$leg-$s.serial.log
            elf=$images/$tier/kmain_console.elf iso=$images/$tier/unix-$s.iso
            rm -f "$log" "$log.verdict"
            if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
                for t in U1 U3 U4 U7; do bad "$t $id: no image"; done
                continue
            fi
            hrc=0
            "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 300 --qemu -m --qemu "$(mem_of "$s")" \
                --elf "$elf" --marker 'halt|PANIC .*' "$iso" >"$log.verdict" 2>&1 || hrc=$?
            record "$tier" "$leg" "$s" "$hrc"
            norm=$log.norm; serial_norm "$log" > "$norm"

            # U1: the session against Linux's.
            why=
            out=$PAX_BUILD/mpx4-unix-$tier-$leg-$s.session
            awk '/^user: exec pid 1 / { if (!on) { on = 1; next } } on && /^user: [^ ]+ pid 1 (exit_group|exit) [0-9]+ after / { exit }
                 on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$norm" > "$out"
            tr -d '\r' < "$lx/$s.tty" > "$out.linux"
            [ -z "$(tail -c 1 "$out.linux")" ] || printf '\n' >> "$out.linux"
            grep -v '^~' "$out" > "$out.cmp"
            grep -v '^~' "$out.linux" > "$out.linux.cmp"
            if ! cmp -s "$out.linux.cmp" "$out.cmp"; then
                why+=" the session differs from Linux's: $(diff "$out.linux.cmp" "$out.cmp" | head -n 14 | cut -c1-600 | tr '\n' '|');"
            fi
            pst=$(sed -n -E "s/^user: [^ ]+ pid 1 (exit_group|exit) ([0-9]+) after .*/\\2/p" "$norm" | head -n 1)
            lst=$(cat "$lx/$s.tty.rc" 2>/dev/null)
            [ "$pst" = "$lst" ] || why+=" exit '$pst' on PAX, '$lst' on Linux;"
            [ "$(wc -l < "$out.cmp" | tr -d ' ')" -gt 1 ] || why+=" fewer than two lines;"
            [ -z "$why" ] && say "PASS U1 $id: $(wc -l < "$out.cmp" | tr -d ' ') lines byte-identical to Linux's ($(sha256_of "$out.cmp" | cut -c1-12)…), exit $pst" || bad "U1 $id:$why"

            # U2: what PAX answers by design.
            rf=$(grep ': refused: ' "$norm" | sed -E 's/^.*user: [^ ]+ pid [0-9]+ //' | LC_ALL=C sort | paste -sd'|' -)
            if [ "$s" = probes ]; then
                why=
                g=$(grep -m1 '^~refused' "$out")
                [ "$g" = "$REFUSED" ] || why+=" '$g';"
                [ "$rf" = "$REFUSALS" ] || why+=" refusal lines '$rf';"
                q=$(grep -m1 '^~seqpacket' "$out")
                [ "$q" = "$SEQ_LINE" ] || why+=" '$q';"
                pl=$(grep -E '^~(  FDSize|  VmRSS|  Cpus_allowed_list|  [0-9]+ lines|  "|rlimit)' "$out" | paste -sd'|' -)
                lines_match "$pl" "$PAX_LINES" || why+=" the /proc and /sys lines '$pl';"
                nr=$(grep '^~noreserve' "$out" | paste -sd'|' -)
                lines_match "$nr" "$NORESERVE" || why+=" the MAP_NORESERVE lines '$nr';"
                [ -z "$why" ] && say "PASS U2 $id: $g; $q; $(printf '%s' "$pl" | tr '\t' ' '); $nr (Linux here: $(grep -m1 '^~refused' "$out.linux"); $(grep '^~noreserve' "$out.linux" | paste -sd'|' -))" || bad "U2 $id:$why"
            fi

            # U3: what PAX lacks; who was killed.
            why=
            ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$norm" | sort -un | paste -sd' ' -)
            [ "$ns" = "273 334" ] || why+=" -ENOSYS for '$ns', not '273 334';"
            if [ "$s" = soak ]; then
                [ "$rf" = "$STACK_REFUSAL" ] || why+=" refusals '$rf', not '$STACK_REFUSAL';"
            elif [ "$s" != probes ]; then
                [ -z "$rf" ] || why+=" refusals '$rf';"
            fi
            kl=$(grep -c 'user: [^ ]* pid [0-9]* killed: ' "$norm")
            want_k=0; [ "$s" = probes ] && want_k=2
            [ "$kl" = "$want_k" ] || why+=" $kl killed: lines, not $want_k ($(grep -m1 ' killed: ' "$norm" | cut -c1-120));"
            if [ "$s" = probes ]; then
                grep -q 'user: unixprobe pid [0-9]* killed: page fault vector 14 ' "$norm" || why+=" the guard's touch was not a page fault;"
                grep -q 'user: unixprobe pid [0-9]* killed: SIGPIPE, ' "$norm" || why+=" the send without MSG_NOSIGNAL was not SIGPIPE;"
            fi
            [ -z "$why" ] && say "PASS U3 $id: -ENOSYS only for 273 and 334; $kl killed ($want_k wanted)" || bad "U3 $id:$why"

            # U4: every frame, inode and socket back.
            why=
            fl=$(grep -m1 '^user: frames free ' "$norm")
            set -- $(printf '%s\n' "$fl" | sed -n -E 's/^user: frames free ([0-9]+) before, [0-9]+ with 1 processes, ([0-9]+) after$/\1 \2/p')
            fb=${1:-} fa=${2:-}
            tl=$(grep -m1 '^tree: frames ' "$norm")
            set -- $(printf '%s\n' "$tl" | sed -n -E "s/^tree: frames ([0-9]+) \\(([0-9]+) when made\\), ([0-9]+) \\(([0-9]+)\\) of them the inode table's, inodes ([0-9]+) \\(([0-9]+)\\), cap ([0-9]+), refusals [0-9]+\$/\\1 \\2 \\3 \\4 \\5 \\6/p")
            th=${1:-} tb=${2:-} tt=${3:-} ttb=${4:-} ti=${5:-} tib=${6:-}
            ul=$(grep -m1 '^unix: sockets ' "$norm")
            if [ -z "$fb" ] || [ -z "$th" ]; then
                why+=" no frames line or no tree line ('$fl' / '$tl');"
            else
                grew=$((tt - ttb))
                [ $((fb - fa)) = "$grew" ] || why+=" $((fb - fa)) frames not back, not the inode table's $grew ('$fl');"
                [ $((th - tb)) = "$grew" ] || why+=" the tree holds $((th - tb)) frames more than when made, not the inode table's $grew ('$tl');"
                [ "$ti" = "$tib" ] || why+=" the tree has $ti inodes, $tib when made;"
            fi
            printf '%s\n' "$ul" | grep -Eq '^unix: sockets 0, buffers 0; made [1-9][0-9]*, connections [0-9]+, refused [0-9]+$' \
                || why+=" the unix line '$ul';"
            [ -z "$why" ] && say "PASS U4 $id: $fl; $tl; $ul" || bad "U4 $id:$why"

            # U5: the soak's census.
            if [ "$s" = soak ]; then
                why=
                cl=$(grep -c '^user: unixprobe pid 1 unix: [0-9]* connections since boot' "$norm")
                [ "$cl" = 4 ] || why+=" $cl census lines, not 4;"
                cu=$(sed -n -E 's/^user: unixprobe pid 1 unix: [0-9]+ connections since boot; (sockets [0-9]+, buffers [0-9]+, frames free [0-9]+)$/\1/p' "$norm" | sort -u)
                [ "$(printf '%s\n' "$cu" | grep -c .)" = 1 ] || why+=" the census is not flat: $(printf '%s' "$cu" | tr '\n' '|');"
                sk=$(grep -m1 '^~stack: ' "$out")
                printf '%s\n' "$sk" | grep -Eq '^~stack: [0-9]+ MiB and [0-9]+ pages taken \(no more to take\); a thread then: EAGAIN$' \
                    || why+=" the thread with no frame for its kernel stack: '$sk';"
                [ -z "$why" ] && say "PASS U5 $id: $cl census lines, all '$cu'; $sk (Linux here: $(grep -m1 '^~stack: ' "$out.linux"))" || bad "U5 $id:$why"
            fi

            # U6: lobo's own client.
            if [ "$s" = ctl ]; then
                why=
                grep -qx 'lobo -c conf/lobo.conf status: exit 0' "$out" || why+=" lobo's client did not exit 0 ($(grep -m1 '^lobo -c' "$out"));"
                grep -q '^control: unix:logs/control.sock (px34' "$out" || why+=" lobo's client did not print the answer;"
                [ -z "$why" ] && say "PASS U6 $id: lobo's own client printed the server's answer and exited 0" || bad "U6 $id:$why"
            fi

            # U7
            why=
            grep -qx "PAX: init /bin/$i ended with status $lst; nothing left to run" "$norm" \
                || why+=" no 'PAX: init /bin/$i ended with status $lst' ($(grep -m1 '^PAX: init ' "$norm"));"
            pn=$(grep -m1 '^PANIC ' "$norm")
            [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
            [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
            [ -z "$why" ] && say "PASS U7 $id: init ended, status $lst; $(tail -n 1 "$log.verdict")" || bad "U7 $id:$why"

            if [ "$s" = probes ] && [ "$before" = 0 ] && [ "$fail" != 0 ]; then
                stopped="$id"
                say "FAIL stopped early: the probes failed on $id; the later boots are not run"
                break
            fi
        done
    done
done
