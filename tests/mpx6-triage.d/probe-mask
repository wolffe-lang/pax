#!/usr/bin/env bash
# T2's new probe report, after its existing numeric mask. Match the whole
# measured reason, including exactly five costs per direction. Keep the
# statistic, sample count/shape, units and rule visible; never match a
# forced way or injected costs. The serial-console change's old-format
# probe mask and this new-format extension deliberately do not overlap.
set -eu
sed -E '/^boot: N ms /s/ scrolls by (copy|redraw) \(read N, write N cycles; copy when read <= N x write; minimum of N samples; reads \[N,N,N,N,N\]; writes \[N,N,N,N,N\]; window N cycles, N us\)/ scrolls by the probe'"'"'s way (read N, write N cycles; copy when read <= N x write; minimum of N samples; reads [N,N,N,N,N]; writes [N,N,N,N,N]; window N cycles, N us)/'
