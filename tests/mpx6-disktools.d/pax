#!/usr/bin/env bash
# Portable PAX leg: raw Limine equality, then a whole disk on vdb and the
# same persistent playground session under every requested firmware/tier.
set -euo pipefail
. "$(dirname "$0")/../../tools/lib.sh"
phase=$1 work=$2 tiers=$3 legs=$4
D=$PAX_ROOT/tests/mpx6-disktools.d
mkdir -p "$work"
export SOURCE_DATE_EPOCH=1700000000
if [ "$phase" = build ]; then
    "$PAX_ROOT/tools/mkdisktools" "$work/bin"
    "$PAX_ROOT/tools/mklimine-static" "$work/limine"
    "$PAX_ROOT/tools/mkpelt" "$work/pelt"
    "$PAX_ROOT/tools/mklope" "$work/lope"
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" cat cp env ls
    "$PAX_ROOT/tools/mkdiskprobe" "$work/probe"
    cc -static -no-pie -O1 -Wall -Wextra -Werror "$PAX_ROOT/user/elf/disktools-preflight.c" -o "$work/probe/disktools-preflight"
    "$PAX_ROOT/tools/fetch-limine"
    for tier in $tiers; do
        flags=(); [ "$tier" != release ] || flags=(--release)
        "$PAX_ROOT/tools/build-kernel" "${flags[@]}" --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" > "$work/$tier.elf.path"
    done
    exit 0
fi
[ "$phase" = run ] || die 'pax phase is build or run'
first=${tiers%% *}
elf=$(cat "$work/$first.elf.path")
probe=$work/preflight
mkdir -p "$probe"
printf '/bin/disktools-preflight\n' > "$probe/run"
"$PAX_ROOT/tools/mkinitramfs" "$probe/init.cpio" /bin/disktools-preflight="$work/probe/disktools-preflight":755 /etc/pax-run="$probe/run":644 > "$probe/cpio.log"
"$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" --add "$probe/init.cpio" initramfs.cpio "$elf" "$probe/boot.iso" >/dev/null
truncate -s 128M "$probe/a.img"; truncate -s 128M "$probe/b.img"
"$PAX_ROOT/tools/qemu-halt" --firmware bios --elf "$elf" --serial "$probe/serial.log" --marker halt \
    --qemu -drive --qemu "file=$probe/a.img,if=none,id=dt0,format=raw" --qemu -device --qemu virtio-blk-pci,drive=dt0 \
    --qemu -drive --qemu "file=$probe/b.img,if=none,id=dt1,format=raw" --qemu -device --qemu virtio-blk-pci,drive=dt1 "$probe/boot.iso" > "$probe/boot.log" 2>&1
if ! grep -aq 'disktools-preflight: /dev/vdb bytes=134217728' "$probe/serial.log"; then
    if [ "${PAX_DISKTOOLS_NOT_YET:-}" = 144 ] && grep -aq 'disktools-preflight: /dev/vdb open errno=2' "$probe/serial.log"; then
        say 'SKIP D-PAX: pax#144, raw second disk absent; 1 SKIP'
        exit 0
    fi
    cat "$probe/serial.log"
    die 'FAIL D-PAX: raw vdb prerequisite (pax#144)'
fi
say 'PASS D-PAX: vda and vdb raw nodes present; 0 SKIP'
# Limine's one static Linux binary on the raw first disk, no mounted volume.
lm=$work/limine-raw; mkdir -p "$lm"
"$work/bin/paxgpt" --seed px69-limine --size 128M "$lm/pax.img" 1:esp:4096:135167:esp 2:linux:135168:262103:root 3:bios:2048:4095:bios
cp --sparse=always "$lm/pax.img" "$lm/linux.img"
"$work/limine/limine" bios-install "$lm/linux.img" 3 > "$lm/linux.log" 2>&1
load_limine_pin
cp --sparse=always "$lm/pax.img" "$lm/dynamic.img"
"$LIMINE_DIR/limine" bios-install "$lm/dynamic.img" 3 > "$lm/dynamic.log" 2>&1
cmp "$lm/linux.img" "$lm/dynamic.img"
printf '/bin/limine bios-install /dev/vda 3\n' > "$lm/run"
"$PAX_ROOT/tools/mkinitramfs" "$lm/init.cpio" /bin/limine="$work/limine/limine":755 /etc/pax-run="$lm/run":644 > "$lm/cpio.log"
"$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" --add "$lm/init.cpio" initramfs.cpio "$elf" "$lm/boot.iso" >/dev/null
"$PAX_ROOT/tools/qemu-halt" --firmware bios --elf "$elf" --serial "$lm/serial.log" --marker halt \
    --qemu -drive --qemu "file=$lm/pax.img,if=none,id=dt0,format=raw" --qemu -device --qemu virtio-blk-pci,drive=dt0 "$lm/boot.iso" > "$lm/boot.log" 2>&1
grep -aq 'user: limine pid 1 exit_group 0' "$lm/serial.log"
cmp "$lm/pax.img" "$lm/linux.img"
say 'PASS D-LIMINE: static installer on PAX /dev/vda equals Linux, every byte'
for tier in $tiers; do
    t=$work/$tier/install; mkdir -p "$t"
    elf=$(cat "$work/$tier.elf.path")
    python3 -I "$D/fixture.py" "$PAX_ROOT" "$work" "$t" "$elf" > "$t/fixture.log"
    "$PAX_ROOT/tools/mkdisk" --gpt --no-journal --kernel "$elf" --root "$t/bootstrap.cpio" --label px69-bootstrap 512M "$t/bootstrap.img" > "$t/bootstrap.log" 2>&1
    rm -f "$t/target.img"
    truncate -s 512M "$t/target.img"
    "$PAX_ROOT/tools/qemu-halt" --boot-disk --firmware bios --timeout 1200 --elf "$elf" --serial "$t/install.serial" --marker halt \
        --qemu -m --qemu 1G --qemu -drive --qemu "file=$t/target.img,if=none,id=dt1,format=raw" --qemu -device --qemu virtio-blk-pci,drive=dt1 "$t/bootstrap.img" > "$t/install.boot" 2>&1
    python3 -I - "$t" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]);s=(p/'install.serial').read_text()
assert s.count('exit_group 0')==13,s
assert 'installed successfully' in s,s
with (p/'target.img').open('rb') as a,(p/'target-root.img').open('wb') as b:
 a.seek(135168*512);left=467644416
 while left:
  x=a.read(min(left,1048576));assert x;b.write(x);left-=len(x)
PY
    "$PAX_ROOT/tools/e2fs" "$t" e2fsck -fn "$t/target-root.img" > "$t/target.fsck" 2>&1
    "$PAX_ROOT/tools/e2tree" "$t/expected.img" > "$t/expected.tree"
    "$PAX_ROOT/tools/e2tree" "$t/target-root.img" > "$t/target.tree"
    cmp "$t/expected.tree" "$t/target.tree"
    say "PASS D-DISK $tier: all three tools and Limine write vdb on PAX; exact tree"
    for fw in $legs; do
        extra=()
        if [ "$fw" = uefi ]; then
            read -r code vars <<< "$(find_ovmf)"
            [ -n "$code" ] || die 'D-BOOT: no UEFI firmware (never skipped)'
            extra=("$code")
        fi
        cp --sparse=always "$t/target.img" "$t/session.img"
        python3 -I "$D/session.py" "$t/session.img" "$t/$fw.serial" "${extra[@]}" > "$t/$fw.session" 2>&1
        python3 -I "$D/check-play.py" "$t/$fw.serial" > "$t/$fw.compare"
        python3 -I - "$t" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1])
with (p/'session.img').open('rb') as a,(p/'check-root.img').open('wb') as b:
 a.seek(135168*512);left=467644416
 while left:
  x=a.read(min(left,1048576));assert x;b.write(x);left-=len(x)
PY
        "$PAX_ROOT/tools/e2fs" "$t" e2fsck -fn "$t/check-root.img" > "$t/$fw.fsck" 2>&1
        "$PAX_ROOT/tools/e2fs" "$t" dumpe2fs -h "$t/check-root.img" > "$t/$fw.state" 2>&1
        grep -Eq '^Filesystem state: +clean$' "$t/$fw.state"
        grep -Eq '^Mount count: +2$' "$t/$fw.state"
        say "PASS D-BOOT $tier $fw: target alone; playground persists, root clean"
        rm "$t/session.img" "$t/check-root.img"
    done
    rm "$t/bootstrap.img" "$t/bootstrap.cpio" "$t/expected.img" "$t/target-root.img"
done
say 'mpx6-disktools PAX: PASS; 0 SKIP'
