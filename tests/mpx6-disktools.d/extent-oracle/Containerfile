# The existing tools/e2fs oracle, frozen by image, package version and executable bytes.
# No apt operation: a changed/missing input fails this build instead of downloading a replacement.
FROM docker.io/library/ubuntu@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
COPY binaries.sha256 /opt/extent-oracle/binaries.sha256
COPY oracle.sh /opt/extent-oracle/oracle.sh
RUN /bin/sh /opt/extent-oracle/oracle.sh --identity
ENTRYPOINT ["/bin/sh", "/opt/extent-oracle/oracle.sh"]
