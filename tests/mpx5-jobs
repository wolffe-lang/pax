#!/usr/bin/env bash
# tests/mpx5-jobs — px48: job control. Process groups and sessions, the
# console as a controlling terminal and its ioctls, `kill` to a group,
# stops and continues and the waits that report them, the console's
# signals for its foreground group and its background rules (TOSTOP),
# hangup and the orphaned group; held to Linux black-box, as root and as
# a user, by this lane's probe (user/elf/jobs.c, tools/mkjobs) and by a
# typed job-control session in a distribution's static Almquist shell
# (Ubuntu 24.04's busybox-static, `sh -i`: tools/fetch-busybox; the
# contract's static dash is packaged nowhere: notes/px48-job-control.md).
#
#   tests/mpx5-jobs [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                   [--firmware bios|uefi|both] [--tier native|release|both]
#
# Three images, each kmain_console with an `/etc/pax-run` of its own:
#   probe   `/bin/jobs`, then `/bin/as 1000 1000 /bin/jobs`, then the
#           soak `/bin/jobs soak 3000` and `/bin/as 1000 1000 /bin/jobs
#           soak 3000`; user/console/jobs.keys typed twice (^C ^\ ^Z ^Z
#           ^C each time), prompt `$ `; booted with the keys on COM1 and
#           again on the PS/2 keyboard (probe-ps2);
#   shell   `/bin/sh -i` as root: user/console/jobs-shell.keys, prompt
#           `# ` (`sleep 100 &`, `jobs`, a foreground `sleep` stopped by
#           ^Z, `bg`, `fg`, ^C, `kill %2`, `wait`, …);
#   shell-user  `/bin/as 1000 1000 /bin/sh -i`: jobs-shell.keys,
#           prompt `$ `, the same keys.
#   gaps    px49: `/bin/gaps`, then `/bin/as 1000 1000 /bin/gaps`
#           (user/elf/gaps.c, tools/mkjobs): pause, rt_sigsuspend across
#           a stop and another thread's take, TIOCSTI, TCFLSH and TCSBRK,
#           sendfile and splice from the background under TOSTOP, fstat's
#           owner of sockets, an eventfd and an epoll object,
#           faccessat2's flags, fallocate's modes, root's unlink of /dev,
#           /proc and /sys (pax#58, #60, #63, #70, #73-#76);
#           user/console/gaps.keys typed twice (one line, `zap`, which
#           TCFLSH discards), prompt `$ `. Its archive has /g (1777) and
#           root's /g/r644, /g/r600 and /g/sf. Its kernel is
#           kmain_session (the console as kmain_console's, and the
#           network stack: the TCP rows connect to 127.0.0.1).
#   fds     px50: `/bin/fdtab`, then `/bin/as 1000 1000 /bin/fdtab`
#           (user/elf/fdtab.c, tools/mkjobs): /proc/<pid>/fd and fdinfo
#           (readlink of each kind of descriptor, lstat of the entries
#           and stat through them, opening through them, the listings,
#           fdinfo's lines, who may read another process's) and rmdir
#           and rename of /proc and /sys (pax#78, #80); nothing typed.
#           Its archive has /g (1777) and root's /g/r644; kmain_session
#           (its sockets).
#   pjobs   px51: pelt's own job control (user/pelt.pin, sh18's): one
#           run of `/bin/sh -i -m` (pelt) a case, each typed the keys of
#           one of sh18's job-control sessions (user/console/pjobs/,
#           pelt's tests/session/c_jc_* in tools/qemu-halt's notation;
#           the ones that ask `ps` or `sed`, which PAX lacks, as
#           variants that read /proc/<pid>/stat with `cut` or squeeze
#           with `tr`, named `-proc` and `-tr`), prompt `$ `. Its
#           archive: pelt as /bin/sh and /bin/pelt, boreutils' sleep,
#           cat, cut, tr, wc, kill and timeout (user/boreutils.pin),
#           `as`, /g (1777); kmain_console.
#   pjobs-user  the same runs through `/bin/as 1000 1000 /bin/sh -i -m`.
#   groups  px51: boreutils' `kill` to a group and `timeout`, typed at
#           pelt (user/console/groups.keys, typed twice): `/bin/sh -i
#           -m`, then `/bin/as 1000 1000 /bin/sh -i -m`; the pjobs
#           archive with its own /etc/pax-run. px53: bu28's rows too:
#           `timeout -s SEGV`, `-s RTMIN` and a host number (the signal
#           ignored, then sent to timeout's own group), a command dead of
#           SEGV and of RTMIN (timeout dies of it again), `kill -L`'s row 0.
#   sigs    px53: what wolf 0.2.33 asks of PAX: `/bin/sigwolf`, then
#           `/bin/as 1000 1000 /bin/sigwolf` (user/sigwolf/sigwolf.lu,
#           built by 0.2.33 from its own pin, tools/mksigwolf): s246's
#           five calls (one meaning ignored or defaulted in the sending
#           shape, the end by a signal, the core siblings) and
#           `os_signal_text(0)`; nothing typed; kmain_console.
#   execs   px56 (pax#95, #96): `/bin/execs`, then `/bin/as 1000 1000
#           /bin/execs` (user/elf/execs.c, tools/mkexecs): what execve
#           loads (programs written since boot, an archive file
#           rewritten, a copy unlinked while open, a link), every
#           refusal a path earns, `#!` lines, ETXTBSY and `execveat`;
#           then pelt typed user/console/execs.keys twice, `/bin/sh -i
#           -m` and `/bin/as 1000 1000 /bin/sh -i -m` (the maintainer's
#           `./Script/greet.sh`, a copied and a rewritten program,
#           scripts with and without `#!`, a chain of them), prompt
#           `$ `. Its archive: pelt as /bin/sh and /bin/pelt, boreutils'
#           cat, chmod, cp, false, mkdir, rm and true, `as`, /g (1777)
#           and the cases in /g/m with their modes and owners;
#           kmain_console.
#   eds     px57: what wolf 0.2.34 asks of PAX: `/bin/edwolf`, then
#           `/bin/as 1000 1000 /bin/edwolf` (user/edwolf/edwolf.lu, built
#           by 0.2.34 from its own pin, tools/mkedwolf): s247's os_fork
#           and its busy rule, s248's os_signal_wait_fds, the mode's bits
#           5-7 and os_term_restore_at_exit, fs_sync, fs_sync_dir and the
#           exclusive create, fs_realpath, os_clock_ns; then `/bin/hostq`
#           and `/bin/as 1000 1000 /bin/hostq` (user/elf/hostq.c,
#           tools/mkhostq): pax#107's rows, what s253's calls ask of the
#           kernel (uname, RLIMIT_CORE read and set, PR_SET_DUMPABLE, an
#           inherited descriptor's F_GETFD and F_SETFD); nothing typed.
#           Its archive: the two probes, `as`, /tmp (1777); kmain_console.
# Each command of the probe image is a process the kernel starts: a
# session leader with the console as its controlling terminal (named:
# Linux's init has neither), as the probe and the shell are on Linux on
# a pseudo-terminal.
#
# **The Linux sides.** Real root: kasumi's own kernel image under QEMU
# with notes/px48/vmjob.c as pid 1 running each program on a fresh
# pseudo-terminal as its session leader (notes/px48/linux-vm.sh),
# recorded and committed (tests/mpx5-jobs.d/linux/*.tty, vm-*.meta):
# the root rows' only reference (a rootless container is no reference
# for what root may do). A user's rows also in a throwaway container,
# run live (tools/linux-tree: the programs on a pseudo-terminal, pid 1
# of a fresh pid namespace, run through `as 1000 1000`), and held to the
# recording before PAX is held to either.
#
# What is compared, by rule: each command's transcript — what the
# terminal showed from its `run <k>:` line to its end — normalised as a
# serial log is (tools/lib.sh's serial_norm: carriage returns and escape
# sequences out: the shell asks where the cursor is, ESC [ 6 n, before
# each prompt), the kernel's own `user: …` lines out, and in the shell's
# `[<n>] <pid>` line the pid masked (PAX's pids are not the guest's).
# The soak's lines are held to their own rules (J5).
#
# Assertions, per tier, firmware and session:
#   J0 build: kmain_console built; jobs, as and busybox static (busybox
#      by its digest); the images built; the recordings there; the
#      container's user sessions ran and agree with the recordings.
#   J1 the probe as root (and over PS/2), byte-identical to real root's
#      recording; the probe as 1000:1000 likewise. Over PS/2 on a machine
#      with a screen, the window's size after the keys is the screen's
#      grid (pax#68: the device the person types at), held so and then
#      compared as the serial line's 0 by 0.
#   J2 the shell as root and as 1000:1000, byte-identical to real root's
#      recordings, the shell's exit status the recording's.
#   J3 the user sessions byte-identical to the container's too (px49:
#      on a host whose dev.tty.legacy_tiocsti is not 0, which lets a
#      user put a byte in its own terminal, gaps-user's TIOCSTI rows are
#      the host's and left out of the container's comparisons, named; J1
#      holds them to real root's recording all the same; px50: fds-user's
#      zombie row is the host kernel's — a zombie's fd/ is its own ids on
#      Linux 7.2.8, the recordings' and kasumi's, and root's, so -EACCES
#      to the user, under the CI runner's kernel (run 39076252598) — and
#      is left out of the container's comparisons; J8 holds it to real
#      root's recording).
#   J4 each run's own witness that it is what it says: the probe's
#      first line names root or a user and its mixed-group rows run or
#      are skipped by name; the shell's prompt is `# ` or `$ `; the
#      job-control lines are there (`Stopped`, `Running`, `Done`,
#      `Terminated`, the ^Z and ^C rows heard by the foreground job
#      only).
#   J5 the soak, as root and as 1000:1000: `soak: 3000 rounds of nine
#      calls, 0 wrong answers`, and MemFree one number at every quarter.
#   J6 -ENOSYS only for set_robust_list (273) and rseq (334); no
#      `refused:` line; the end: `PAX: init /bin/… ended with status 0;
#      nothing left to run`, `halt`, held halted.
#   J8 px50: fds as root and as 1000:1000, byte-identical to real root's
#      recordings (tests/mpx5-jobs.d/linux/fds.tty, fds-user.tty: the
#      guest's notes/px50/vmjob.c, px49's with `/` made root's 0755 as
#      PAX's is), the user's to the container's too (J3, its /sys
#      mounted); its J4 witness asks rows root's run and a user's answer
#      differently (root's 0644 file reopened for writing through its
#      entry, rmdir of /proc and /sys) and rows the fix turns (a file's
#      link, an entry followed, fdinfo's append flag). px52: an
#      EFD_SEMAPHORE eventfd's fdinfo (pax#82) and fdtab's N section,
#      /dev/stdin, stdout and stderr as links to /proc/self/fd/N (pax#83;
#      the guest's links made at its start, notes/px52/vmjob.c, as a
#      distribution's boot makes them: devtmpfs has none); its witness
#      the semaphore's read, the stdin link, the truncating reopen, and
#      the reopen of root's file by /dev/stdin, 0 to root, EACCES to a
#      user. px55 (pax#88): and /dev/fd, the link to /proc/self/fd beside
#      them (the guest's made at its start too): its readlink, lstat and
#      listing, what it names followed, `ls -l /dev/fd/` and `cat
#      /dev/fd/0`'s rows; its witness the link's row and the read through
#      /dev/fd/0.
#   J9 px51: each pjobs and pjobs-user run (one of sh18's sessions)
#      byte-identical to real root's recording of the same pelt on the
#      guest (tests/mpx5-jobs.d/linux/pjobs-*.tty), the user's to the
#      container's too (J3); its J4 witness: pelt's prompt, and over the
#      image the job lines (`Stopped`, `Running`, `Done`, `Terminated`,
#      `Killed`, `Stopped (tty input)`) and `leader`, `foreground`,
#      `own-group`, `group-is-pid` from /proc/<pid>/stat.
#   J10 px51: groups and groups-user byte-identical to real root's
#      recordings, the user's to the container's too (J3); its J4
#      witness: a group sent to (`Terminated`, `Killed`), `kill 0`'s
#      143, timeout's 124, 137, 125, 126, 127, `survived` once (the
#      --foreground run's child alone outlives the expiry). px53: and
#      139 and 162 (timeout dead of its command's SEGV and RTMIN), signal
#      0's words. A host whose kernel.core_pattern pipes cores to a
#      program dumps one whatever RLIMIT_CORE says (core(5); s246, bu28:
#      kasumi's and CI's runner's), so in the container timeout's
#      command carries the core bit and timeout says `the monitored
#      command dumped core`; there that line is the host's, left out of
#      the container's comparisons (named). Real root's guest (pid 1's
#      RLIMIT_CORE, soft 0) and PAX (which writes no core) print none.
#   J11 px53: sigs and sigs-user byte-identical to real root's
#      recordings (tests/mpx5-jobs.d/linux/sigs.tty, sigs-user.tty), the
#      user's to the container's too (J3; on a host whose core_pattern
#      pipes, its `C:` rows, the core siblings' answers, are the host's
#      and left out there, named); its J4 witness: who it runs as,
#      `text(0)`'s words, a SENT SEGV ending the program under the
#      default and lived through under the ignore, the group rows, the
#      overflow's 134. px55 (pax#93, #94): and the core file's limit as
#      /proc/self/limits says it (`L:`), soft 0 and hard unlimited, the
#      guest's boot and PAX's; the container's hard limit is
#      tools/linux-tree's `--ulimit core=0:0`, so that row is left out of
#      the container's comparisons (named); its witness both rows.
#      px83 (#174): the `~X:` row joins a runtime task before reading
#      SigIgn, with a preceding task-joined event in the transcript.
#      Both PAX and Linux must then read zero; a read before that event
#      is rejected. The historical recording's zero remains checked,
#      while every fresh Linux replay must also show the ordering.
#      POSIX exec preserves SIG_IGN, but sigaction lets the new runtime
#      replace it: this row observes the latter, not exec entry.
#   J12 px56 (pax#95, #96): execs and execs-user, xsh and xsh-user (the
#      typed sessions) byte-identical to real root's recordings
#      (tests/mpx5-jobs.d/linux/execs*.tty, xsh*.tty: notes/px52/vmjob.c's
#      guest, the image's own archive), the user's to the container's too
#      (J3); its J4 witness: who it runs as, a copy written since boot
#      run, the page rewritten in place run, the unlinked copy run by its
#      descriptor, ENOEXEC, ETXTBSY, a `#!` line's argument, a chain past
#      the limit ELOOP; the session's `hi` (the maintainer's
#      `./Script/greet.sh`), the copied `false`'s 1, `#!/bin/cat -n`'s
#      numbered line.
#   J13 px57: eds and eds-user, hostq and hostq-user byte-identical to
#      real root's recordings (tests/mpx5-jobs.d/linux/eds*.tty,
#      hostq*.tty: notes/px52/vmjob.c's guest, the image's own archive),
#      the user's to the container's too (J3), but for the lines that
#      start with `~`, which are PAX's own and left out of both
#      comparisons by name: the monotonic clock's grain (`~N:`: PAX's
#      clock advances in 10 ms ticks, so short work reads 0 ns), the
#      kernel's name (`~H: uname`) and a set of the core limit, which
#      Linux allows and PAX refuses whatever the values (`~H: prlimit64
#      … set`, pax#93's table); J13 holds those lines to PAX's answers on
#      PAX (at least 10 of 20 rounds read 0; sysname PAX; both sets
#      -EPERM, -1) and to Linux's in the recordings (0 of 20; Linux; both
#      sets 0). The container's hard core limit is tools/linux-tree's
#      --ulimit core=0:0, so hostq-user's hard row is left out there
#      (named, as sigwolf's). Its J4 witness: who it runs as, the fork's
#      child (0, -1) and `busy` twice, the meaning winning over a ready
#      pipe, the three bits read back and the mode back after each of the
#      four ends, a pipe's sync `io (22)`, the exclusive create's
#      `exists`, `..` after a link, a loop's `io (40)`; hostq's machine,
#      soft limit 0, dumpable 0 after the set, and the inherited
#      descriptor's F_GETFD 0 then 1.
#   J7 px49: gaps as root and as 1000:1000, byte-identical to real root's
#      recordings (tests/mpx5-jobs.d/linux/gaps.tty, gaps-user.tty: the
#      guest's notes/px49/vmjob.c, which brings the loopback up and
#      mounts /sys first), the user's to the container's too (J3); its
#      J4 witness asks rows a user's run and root's answer differently
#      (TIOCSTI on its own terminal, the accepted end's owner under
#      setfsuid, a 0600 file through a link) and the rows each gap's fix
#      turns (#75's two threads, #76's sendfile and splice stopped).
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only=
usage="usage: tests/mpx5-jobs [--images DIR | --no-boot | --only build | --only linux --images DIR] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3
python3 -I "$here/mpx5-jobs.d/sigign-selftest.py" || exit 1

SOAK=${PAX_JOBS_SOAK:-3000} # the soak's rounds a run (CI: 3000; PAX_JOBS_SOAK for a longer one)
REC=$here/mpx5-jobs.d/linux
JKEYS=$PAX_ROOT/user/console/jobs.keys
SKEYS=$PAX_ROOT/user/console/jobs-shell.keys
UKEYS=$SKEYS # the same keys; the user's prompt is `$ `
GKEYS=$PAX_ROOT/user/console/gaps.keys # px49
GAPS_SF='B: the sendfile reached the terminal' # /g/sf's line (and /g/r644's, /g/r600's)
FDS_R644='root file' # px50: the fds archive's /g/r644
# px55 (pax#88): fdtab's /dev/fd rows a run of fds must show (J4).
FDLINK='N: /dev/fd: readlink "/proc/self/fd"; lstat link 0777 size 13 nlink 1 owner 0:0; statx AT_SYMLINK_NOFOLLOW link 0777 size 13; in /dev'"'"'s listing DT_LNK'
FDCAT='N: descriptor 0 a file at offset 3: /dev/fd/0 stat file 0644, fstat'"'"'s: yes; statx fstat'"'"'s: yes; open /dev/fd/0 O_RDONLY 0, read 3 "abc", descriptor 0 still at 3'
PDIR=$PAX_ROOT/user/console/pjobs # px51: sh18's job-control sessions, one keys file a case
PCASES="c_jc_terminal_back c_jc_background_job c_jc_bg c_jc_bg_running c_jc_bg_ttin c_jc_ctrl_c_job_only c_jc_ctrl_c_loop
    c_jc_ctrl_z c_jc_done_message c_jc_exit_stopped c_jc_fg c_jc_fg_number c_jc_fg_pipeline c_jc_job_ids c_jc_jobs_list
    c_jc_jobs_states c_jc_mixed_pipeline c_jc_numbering c_jc_shell_ignores_tstp c_jc_states c_jc_wait_stopped
    c_jc_background_group-proc c_jc_foreground_group-proc c_jc_shell_is_leader-proc c_jc_kill_group-proc c_jc_jobs_l_pipeline-tr"
PCASES=$(echo $PCASES)
PBORE="sleep cat cut tr wc true kill timeout" # px51: boreutils in the pjobs archive
PTEXT='not a program' # px51: /g/text, a file timeout cannot run (126)
RKEYS=$PAX_ROOT/user/console/groups.keys # px51
CORE_LINE='timeout: the monitored command dumped core' # px53: GNU's words, timeout's at a core
LHARD='L: the core limit, hard: ' # px55: sigwolf's row of the hard core limit (the container's is its engine's)
HHARD='H: the core limit, hard: ' # px57: hostq's (the same: the container's is its engine's)
XKEYS=$PAX_ROOT/user/console/execs.keys # px56: the typed session of the execs image
XBORE="cat chmod cp false mkdir rm true" # px56: boreutils in the execs archive
# px51: what a pjobs case must show (a word of each line), by case.
pwitness() {
    case ${1#user-} in
        c_jc_background_job) echo Terminated ;;
        c_jc_bg_ttin) echo 'Stopped.(tty.input)' ;;
        c_jc_mixed_pipeline|c_jc_ctrl_z|c_jc_exit_stopped|c_jc_wait_stopped) echo Stopped ;;
        c_jc_ctrl_c_loop) echo 'trapped$' ;;
        c_jc_done_message) echo Done ;;
        c_jc_bg) echo 'st=0' ;;
        c_jc_states) echo 'st=TSTP st=STOP' ;;
        c_jc_shell_ignores_tstp) echo '^alive' ;;
        c_jc_background_group-proc|c_jc_shell_is_leader-proc) echo '^leader' ;;
        c_jc_foreground_group-proc) echo '^foreground ^own-group' ;;
        c_jc_kill_group-proc) echo '^group-is-pid' ;;
        c_jc_fg) echo '^typed.after.fg' ;;
    esac
}
pcase() { echo "$PCASES" | tr ' ' '\n' | sed -n "${1}p"; } # k -> the k-th case
# image: its run list (one command a line), its keys, its prompt.
image_runs() {
    case $1 in
        probe) printf '%s\n' /bin/jobs '/bin/as 1000 1000 /bin/jobs' "/bin/jobs soak $SOAK" "/bin/as 1000 1000 /bin/jobs soak $SOAK" ;;
        shell) printf '%s\n' '/bin/sh -i' ;;
        shell-user) printf '%s\n' '/bin/as 1000 1000 /bin/sh -i' ;;
        gaps) printf '%s\n' /bin/gaps '/bin/as 1000 1000 /bin/gaps' ;;
        fds) printf '%s\n' /bin/fdtab '/bin/as 1000 1000 /bin/fdtab' ;;
        pjobs) for c in $PCASES; do printf '%s\n' '/bin/sh -i -m'; done ;;
        pjobs-user) for c in $PCASES; do printf '%s\n' '/bin/as 1000 1000 /bin/sh -i -m'; done ;;
        groups) printf '%s\n' '/bin/sh -i -m' '/bin/as 1000 1000 /bin/sh -i -m' ;;
        sigs) printf '%s\n' /bin/sigwolf '/bin/as 1000 1000 /bin/sigwolf' ;; # px53
        execs) printf '%s\n' /bin/execs '/bin/as 1000 1000 /bin/execs' '/bin/sh -i -m' '/bin/as 1000 1000 /bin/sh -i -m' ;; # px56
        eds) printf '%s\n' /bin/edwolf '/bin/as 1000 1000 /bin/edwolf' /bin/hostq '/bin/as 1000 1000 /bin/hostq' ;; # px57
    esac
}
image_kernel() { case $1 in gaps|fds) echo kmain_session ;; *) echo kmain_console ;; esac; } # px49, px50
image_prompt() { case $1 in shell) printf '# ' ;; *) printf '$ ' ;; esac; }
image_keys() { # image -> a keys file (the probe's typed twice: its two typed runs)
    case $1 in
        probe) cat "$JKEYS" "$JKEYS" ;;
        shell) cat "$SKEYS" ;;
        shell-user) cat "$UKEYS" ;;
        gaps) cat "$GKEYS" "$GKEYS" ;;
        fds) : ;; # px50: nothing typed
        pjobs|pjobs-user) for c in $PCASES; do cat "$PDIR/$c.keys"; done ;;
        groups) cat "$RKEYS" "$RKEYS" ;;
        sigs) : ;; # px53: nothing typed
        execs) cat "$XKEYS" "$XKEYS" ;; # px56: the probe's two runs type nothing; pelt's two the session
        eds) : ;; # px57: nothing typed
    esac
}
# boot: image and keyboard. The probe over both; the shells over COM1.
BOOTS="probe:serial probe:ps2 shell:serial shell-user:serial gaps:serial fds:serial pjobs:serial pjobs-user:serial groups:serial sigs:serial execs:serial eds:serial"
# px51: PAX_JOBS_BOOTS names a subset (a plant's run of the images it
# breaks, which the probe's boot would otherwise stop first: qemu-halt's
# fail-fast refuses every typed boot after one whose first prompt never
# came). px52 (pax#85): CI's `workflow_dispatch` passes it as its
# `jobs_boots` input (empty there, and on every other event, is every
# boot), so a plant's red at a later image is seen in CI. A name that is
# not one of the boots above is refused (exit 2); the container runs the
# chosen images' user sessions only; the run says it is a subset.
ALL_BOOTS=$BOOTS
export PAX_JOBS_BOOTS=sigs:serial
echo '::warning::px83-plant-sigign: deliberate premature read; run only the sigs image'
subset=
if [ -n "${PAX_JOBS_BOOTS:-}" ]; then
    for b in $PAX_JOBS_BOOTS; do
        case " $ALL_BOOTS " in *" $b "*) ;; *) die "PAX_JOBS_BOOTS: '$b' is not one of: $ALL_BOOTS" ;; esac
    done
    BOOTS=$(echo $PAX_JOBS_BOOTS)
    subset=" (a subset, PAX_JOBS_BOOTS: $BOOTS)"
    say "boots: $BOOTS (PAX_JOBS_BOOTS: a subset of the suite's boots, not its verdict)"
fi
booted() { # image -> whether one of BOOTS boots it
    case " $BOOTS " in *" $1:"*) return 0 ;; esac
    return 1
}
user_image() { # a user session's name -> its image
    case $1 in pjobs-user-*) echo pjobs-user ;; shell-user) echo shell-user ;; xsh-user) echo execs ;; hostq-user) echo eds ;; *-user) echo "${1%-user}" ;; esac
}
# Each typed run's name, by image and run number, and its recording.
run_name() { # image k
    case $1:$2 in
        probe:1) echo probe ;; probe:2) echo probe-user ;; probe:3) echo soak ;; probe:4) echo soak-user ;;
        shell:1) echo shell ;; shell-user:1) echo shell-user ;;
        gaps:1) echo gaps ;; gaps:2) echo gaps-user ;;
        fds:1) echo fds ;; fds:2) echo fds-user ;;
        pjobs:*) echo "pjobs-$(pcase "$2")" ;; pjobs-user:*) echo "pjobs-user-$(pcase "$2")" ;;
        groups:1) echo groups ;; groups:2) echo groups-user ;;
        sigs:1) echo sigs ;; sigs:2) echo sigs-user ;; # px53
        execs:1) echo execs ;; execs:2) echo execs-user ;; execs:3) echo xsh ;; execs:4) echo xsh-user ;; # px56
        eds:1) echo eds ;; eds:2) echo eds-user ;; eds:3) echo hostq ;; eds:4) echo hostq-user ;; # px57
    esac
}
TYPED="probe probe-user shell shell-user gaps gaps-user fds fds-user groups groups-user sigs sigs-user execs execs-user xsh xsh-user eds eds-user hostq hostq-user"
for c in $PCASES; do TYPED+=" pjobs-$c pjobs-user-$c"; done # px51
UTYPED="probe-user shell-user gaps-user fds-user groups-user sigs-user execs-user xsh-user eds-user hostq-user" # the user sessions the container runs
for c in $PCASES; do UTYPED+=" pjobs-user-$c"; done

work=$PAX_BUILD/mpx5-jobs
runs=$PAX_BUILD/mpx5-jobs-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

# A transcript as compared: normalised as a serial log is; the shell's
# `[n] <pid>` line's pid masked.
norm_session() {
    serial_norm "$1" | sed -E 's/^(\[[0-9]+\]) [0-9]+$/\1 PID/'
}

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The container's user sessions: the probe and the shell through `as`.
linux_side() { # dir -> reasons on stdout
    mkdir -p "$1/linux"
    if ! booted probe; then :
    elif "$PAX_ROOT/tools/linux-tree" --root "$1/root" --keys "$JKEYS" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
        "$1/linux/probe-user.tty" -- /bin/as 1000 1000 /bin/jobs; then
        say "  linux probe-user: $(wc -c < "$1/linux/probe-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/probe-user.tty.rc")"
    else
        printf ' tools/linux-tree probe-user;'
    fi
    if ! booted shell-user; then :
    elif "$PAX_ROOT/tools/linux-tree" --root "$1/root" --keys "$UKEYS" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
        "$1/linux/shell-user.tty" -- /bin/as 1000 1000 /bin/sh -i; then
        say "  linux shell-user: $(wc -c < "$1/linux/shell-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/shell-user.tty.rc")"
    else
        printf ' tools/linux-tree shell-user;'
    fi
    # px49: gaps as 1000:1000, /g's modes as the archive gives them.
    if ! booted gaps; then :
    elif "$PAX_ROOT/tools/linux-tree" --root "$1/groot" --keys "$GKEYS" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
        --owners "$1/gaps.owners" "$1/linux/gaps-user.tty" -- /bin/as 1000 1000 /bin/gaps; then
        say "  linux gaps-user: $(wc -c < "$1/linux/gaps-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/gaps-user.tty.rc")"
    else
        printf ' tools/linux-tree gaps-user;'
    fi
    # px50: fds as 1000:1000, /g as the archive gives it, /sys mounted
    # (its rmdir and rename rows); nothing typed.
    : > "$1/fds.keys"
    if ! booted fds; then :
    elif "$PAX_ROOT/tools/linux-tree" --root "$1/froot" --keys "$1/fds.keys" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc --sys \
        --owners "$1/fds.owners" "$1/linux/fds-user.tty" -- /bin/as 1000 1000 /bin/fdtab; then
        say "  linux fds-user: $(wc -c < "$1/linux/fds-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/fds-user.tty.rc")"
    else
        printf ' tools/linux-tree fds-user;'
    fi
    # px51: pelt's sessions and the groups session as 1000:1000, /g as
    # the archive gives it; one container a case.
    local c
    for c in $PCASES; do
        if ! booted pjobs-user; then :
        elif "$PAX_ROOT/tools/linux-tree" --root "$1/proot" --keys "$PDIR/$c.keys" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
            --owners "$1/pjobs.owners" "$1/linux/pjobs-user-$c.tty" -- /bin/as 1000 1000 /bin/sh -i -m; then
            say "  linux pjobs-user-$c: $(wc -c < "$1/linux/pjobs-user-$c.tty" | tr -d ' ') bytes, status $(cat "$1/linux/pjobs-user-$c.tty.rc")"
        else
            printf ' tools/linux-tree pjobs-user-%s;' "$c"
        fi
    done
    if ! booted groups; then :
    elif "$PAX_ROOT/tools/linux-tree" --root "$1/proot" --keys "$RKEYS" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
        --owners "$1/pjobs.owners" "$1/linux/groups-user.tty" -- /bin/as 1000 1000 /bin/sh -i -m; then
        say "  linux groups-user: $(wc -c < "$1/linux/groups-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/groups-user.tty.rc")"
    else
        printf ' tools/linux-tree groups-user;'
    fi
    # px53: the probe of 0.2.33's calls as 1000:1000; nothing typed.
    : > "$1/sigs.keys"
    if ! booted sigs; then :
    elif "$PAX_ROOT/tools/linux-tree" --root "$1/sroot" --keys "$1/sigs.keys" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
        "$1/linux/sigs-user.tty" -- /bin/as 1000 1000 /bin/sigwolf; then
        say "  linux sigs-user: $(wc -c < "$1/linux/sigs-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/sigs-user.tty.rc")"
    else
        printf ' tools/linux-tree sigs-user;'
    fi
    # px56: the exec probe as 1000:1000 (nothing typed), then pelt typed
    # the session as 1000:1000; /g and /g/m as the archive gives them.
    : > "$1/execs.keys"
    if ! booted execs; then :
    else
        if "$PAX_ROOT/tools/linux-tree" --root "$1/xroot" --keys "$1/execs.keys" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
            --owners "$1/execs.owners" "$1/linux/execs-user.tty" -- /bin/as 1000 1000 /bin/execs; then
            say "  linux execs-user: $(wc -c < "$1/linux/execs-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/execs-user.tty.rc")"
        else
            printf ' tools/linux-tree execs-user;'
        fi
        if "$PAX_ROOT/tools/linux-tree" --root "$1/xroot" --keys "$XKEYS" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
            --owners "$1/execs.owners" "$1/linux/xsh-user.tty" -- /bin/as 1000 1000 /bin/sh -i -m; then
            say "  linux xsh-user: $(wc -c < "$1/linux/xsh-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/xsh-user.tty.rc")"
        else
            printf ' tools/linux-tree xsh-user;'
        fi
    fi
    # px57: the probe of 0.2.34's calls and pax#107's as 1000:1000
    # (nothing typed), /tmp as the archive gives it.
    : > "$1/eds.keys"
    if ! booted eds; then :
    else
        if "$PAX_ROOT/tools/linux-tree" --root "$1/eroot" --keys "$1/eds.keys" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
            --owners "$1/eds.owners" "$1/linux/eds-user.tty" -- /bin/as 1000 1000 /bin/edwolf; then
            say "  linux eds-user: $(wc -c < "$1/linux/eds-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/eds-user.tty.rc")"
        else
            printf ' tools/linux-tree eds-user;'
        fi
        if "$PAX_ROOT/tools/linux-tree" --root "$1/eroot" --keys "$1/eds.keys" --prompt '$ ' --argv0 /bin/as --size 256m --rdev --nsproc \
            --owners "$1/eds.owners" "$1/linux/hostq-user.tty" -- /bin/as 1000 1000 /bin/hostq; then
            say "  linux hostq-user: $(wc -c < "$1/linux/hostq-user.tty" | tr -d ' ') bytes, status $(cat "$1/linux/hostq-user.tty.rc")"
        else
            printf ' tools/linux-tree hostq-user;'
        fi
    fi
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS J0 (linux): the Linux side ran in a throwaway container" || bad "J0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/bin" "$r/etc" "$work/bin"
    why=
    "$PAX_ROOT/tools/mkjobs" "$work/bin" > "$work/jobs.txt" || why+=" tools/mkjobs;"
    "$PAX_ROOT/tools/mkas" "$work/bin" > "$work/as.txt" || why+=" tools/mkas;"
    "$PAX_ROOT/tools/fetch-busybox" "$work/bin" > "$work/busybox.txt" || why+=" tools/fetch-busybox;"
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" || why+=" tools/mkpelt;" # px51
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $(printf '%s\n' $PBORE $XBORE | sort -u) > "$work/bore.txt" || why+=" tools/mkboreutils;" # px51; px56: and XBORE
    "$PAX_ROOT/tools/mkexecs" "$work/execs" > "$work/execs.txt" || why+=" tools/mkexecs;" # px56
    "$PAX_ROOT/tools/mksigwolf" "$work/sigwolf" > "$work/sigwolf.txt" || why+=" tools/mksigwolf;" # px53
    "$PAX_ROOT/tools/mkedwolf" "$work/edwolf" > "$work/edwolf.txt" || why+=" tools/mkedwolf;" # px57
    "$PAX_ROOT/tools/mkhostq" "$work/hostq" > "$work/hostq.txt" || why+=" tools/mkhostq;" # px57
    cp "$work/bin/jobs" "$r/bin/jobs" 2>/dev/null || why+=" no jobs;"
    cp "$work/bin/gaps" "$r/bin/gaps" 2>/dev/null || why+=" no gaps;"
    cp "$work/bin/fdtab" "$r/bin/fdtab" 2>/dev/null || why+=" no fdtab;"
    cp "$work/bin/as" "$r/bin/as" 2>/dev/null || why+=" no as;"
    cp "$work/bin/busybox" "$r/bin/sh" 2>/dev/null || why+=" no busybox;"
    cp "$work/bin/busybox" "$r/bin/sleep" 2>/dev/null || true
    for f in "$r"/bin/*; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    # px51: the pjobs tree (pelt as sh, boreutils, as, /g) for the
    # archive and for the container.
    pr=$work/proot
    mkdir -p "$pr/bin" "$pr/etc" "$pr/g"
    cp "$work/pelt/pelt" "$pr/bin/pelt" 2>/dev/null || why+=" no pelt;"
    cp "$work/pelt/pelt" "$pr/bin/sh" 2>/dev/null || true
    for u in $PBORE; do cp "$work/bore/$u" "$pr/bin/$u" 2>/dev/null || why+=" no $u;"; done
    cp "$r/bin/as" "$pr/bin/as" 2>/dev/null || why+=" no as for the pjobs tree;"
    for f in "$pr"/bin/*; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: pjobs ${f#"$pr"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    printf '%s\n' "$PTEXT" > "$work/pjobs.text"
    cp "$work/pjobs.text" "$pr/g/text"
    printf '%s\n' '/g 1777 0 0' '/g/text 644 0 0' > "$work/pjobs.owners"
    pargs=(/g/:1777 /g/text="$work/pjobs.text":644)
    for f in "$pr"/bin/*; do pargs+=("/bin/${f##*/}=$f:755"); done
    for im in probe shell shell-user; do
        image_runs "$im" > "$work/$im.run"
        "$PAX_ROOT/tools/mkinitramfs" "$work/$im.cpio" /bin/jobs="$r/bin/jobs":755 /bin/as="$r/bin/as":755 \
            /bin/sh="$r/bin/sh":755 /bin/sleep="$r/bin/sleep":755 /etc/pax-run="$work/$im.run":644 > "$work/$im.initramfs.txt" \
            || why+=" tools/mkinitramfs $im;"
    done
    # px49: the gaps image, and the same tree for the container (its
    # modes by --owners, as the archive's).
    g=$work/groot
    mkdir -p "$g/bin" "$g/etc" "$g/g"
    cp "$r/bin/gaps" "$r/bin/as" "$g/bin/" 2>/dev/null || why+=" no gaps or as for the gaps tree;"
    printf '%s\n' "$GAPS_SF" > "$work/gaps.sf"
    for f in r644 r600 sf; do cp "$work/gaps.sf" "$g/g/$f"; done
    printf '%s\n' '/g 1777 0 0' '/g/r644 644 0 0' '/g/r600 600 0 0' '/g/sf 644 0 0' > "$work/gaps.owners"
    image_runs gaps > "$work/gaps.run"
    "$PAX_ROOT/tools/mkinitramfs" "$work/gaps.cpio" /bin/gaps="$r/bin/gaps":755 /bin/as="$r/bin/as":755 /g/:1777 \
        /g/r644="$work/gaps.sf":644 /g/r600="$work/gaps.sf":600 /g/sf="$work/gaps.sf":644 /etc/pax-run="$work/gaps.run":644 \
        > "$work/gaps.initramfs.txt" || why+=" tools/mkinitramfs gaps;"
    # px50: the fds image, and the same tree for the container.
    f=$work/froot
    mkdir -p "$f/bin" "$f/etc" "$f/g"
    cp "$r/bin/fdtab" "$r/bin/as" "$f/bin/" 2>/dev/null || why+=" no fdtab or as for the fds tree;"
    printf '%s\n' "$FDS_R644" > "$work/fds.r644"
    cp "$work/fds.r644" "$f/g/r644"
    printf '%s\n' '/g 1777 0 0' '/g/r644 644 0 0' > "$work/fds.owners"
    image_runs fds > "$work/fds.run"
    "$PAX_ROOT/tools/mkinitramfs" "$work/fds.cpio" /bin/fdtab="$r/bin/fdtab":755 /bin/as="$r/bin/as":755 /g/:1777 \
        /g/r644="$work/fds.r644":644 /etc/pax-run="$work/fds.run":644 > "$work/fds.initramfs.txt" || why+=" tools/mkinitramfs fds;"
    # px51: the pjobs, pjobs-user and groups images, one tree, each its
    # own run list (the run list in the container's tree is pjobs').
    for im in pjobs pjobs-user groups; do
        image_runs "$im" > "$work/$im.run"
        "$PAX_ROOT/tools/mkinitramfs" "$work/$im.cpio" "${pargs[@]}" /etc/pax-run="$work/$im.run":644 > "$work/$im.initramfs.txt" \
            || why+=" tools/mkinitramfs $im;"
    done
    # px53: the sigs image (the probe and `as`), and the same tree for
    # the container.
    sr=$work/sroot
    mkdir -p "$sr/bin" "$sr/etc"
    cp "$work/sigwolf/sigwolf" "$sr/bin/sigwolf" 2>/dev/null || why+=" no sigwolf;"
    cp "$r/bin/as" "$sr/bin/as" 2>/dev/null || why+=" no as for the sigs tree;"
    for f in "$sr"/bin/*; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: sigs ${f#"$sr"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    image_runs sigs > "$work/sigs.run"
    "$PAX_ROOT/tools/mkinitramfs" "$work/sigs.cpio" /bin/sigwolf="$sr/bin/sigwolf":755 /bin/as="$sr/bin/as":755 \
        /etc/pax-run="$work/sigs.run":644 > "$work/sigs.initramfs.txt" || why+=" tools/mkinitramfs sigs;"
    # px56: the execs image (the probe, seven, pelt, boreutils, as, and
    # the cases of /g/m with their modes and owners), and the same tree
    # for the container (the modes and owners by --owners).
    xr=$work/xroot
    rm -rf "$xr"
    mkdir -p "$xr/bin" "$xr/etc" "$xr/g/m/d0755" "$xr/g/m/ns" "$xr/g/m/ni"
    cp "$work/execs/execs" "$xr/bin/execs" 2>/dev/null || why+=" no execs;"
    cp "$work/pelt/pelt" "$xr/bin/pelt" 2>/dev/null || why+=" no pelt for the execs tree;"
    cp "$work/pelt/pelt" "$xr/bin/sh" 2>/dev/null || true
    for u in $XBORE; do cp "$work/bore/$u" "$xr/bin/$u" 2>/dev/null || why+=" no $u for the execs tree;"; done
    cp "$r/bin/as" "$xr/bin/as" 2>/dev/null || why+=" no as for the execs tree;"
    for f in "$xr"/bin/* "$work/execs/seven"; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: execs ${f#"$xr"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    printf 'echo text\n' > "$work/execs.text"
    : > "$work/execs.empty"
    printf '\177ELF' > "$work/execs.elf4"
    printf '#!/bin/execs say\n' > "$work/execs.script"
    printf 'not a program\n' > "$work/execs.tx"
    # each case: PATH SOURCE MODE UID GID (a directory's SOURCE is `-`)
    cat > "$work/execs.cases" <<CASES
/g - 1777 0 0
/g/m - 755 0 0
/g/m/d0755 - 755 0 0
/g/m/ns - 700 0 0
/g/m/ns/prog $work/execs/seven 755 0 0
/g/m/ni - 700 0 0
/g/m/ni/execs $work/execs/execs 755 0 0
/g/m/r0744 $work/execs/seven 744 0 0
/g/m/r0701 $work/execs/seven 701 0 0
/g/m/g0710 $work/execs/seven 710 0 1000
/g/m/n0644 $work/execs/seven 644 0 0
/g/m/text $work/execs.text 755 0 0
/g/m/empty $work/execs.empty 755 0 0
/g/m/elf4 $work/execs.elf4 755 0 0
/g/m/s0711 $work/execs.script 711 0 0
/g/m/s0644 $work/execs.script 644 0 0
/g/m/suid $work/execs.script 4755 0 0
/g/m/rw0 $work/execs/execs 755 0 0
/g/m/rw1000 $work/execs/execs 755 1000 1000
/g/m/tx0 $work/execs.tx 755 0 0
/g/m/tx1000 $work/execs.tx 755 1000 1000
CASES
    xargs=()
    : > "$work/execs.owners"
    while read -r path src mode uid gid; do
        printf '%s %s %s %s\n' "$path" "$mode" "$uid" "$gid" >> "$work/execs.owners"
        if [ "$src" = - ]; then
            mkdir -p "$xr$path"
            xargs+=("$path/:$mode:$uid:$gid")
        else
            cp "$src" "$xr$path" || why+=" no $src for $path;"
            xargs+=("$path=$src:$mode:$uid:$gid")
        fi
    done < "$work/execs.cases"
    for f in "$xr"/bin/*; do xargs+=("/bin/${f##*/}=$f:755"); done
    image_runs execs > "$work/execs.run"
    cp "$work/execs.run" "$xr/etc/pax-run"
    "$PAX_ROOT/tools/mkinitramfs" "$work/execs.cpio" "${xargs[@]}" /etc/pax-run="$work/execs.run":644 > "$work/execs.initramfs.txt" \
        || why+=" tools/mkinitramfs execs;"
    # px57: the eds image (the two probes, `as`, /tmp), and the same tree
    # for the container (/tmp's mode by --owners).
    er=$work/eroot
    rm -rf "$er"
    mkdir -p "$er/bin" "$er/etc" "$er/tmp"
    cp "$work/edwolf/edwolf" "$er/bin/edwolf" 2>/dev/null || why+=" no edwolf;"
    cp "$work/hostq/hostq" "$er/bin/hostq" 2>/dev/null || why+=" no hostq;"
    cp "$r/bin/as" "$er/bin/as" 2>/dev/null || why+=" no as for the eds tree;"
    for f in "$er"/bin/*; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: eds ${f#"$er"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    printf '%s\n' '/tmp 1777 0 0' > "$work/eds.owners"
    image_runs eds > "$work/eds.run"
    cp "$work/eds.run" "$er/etc/pax-run"
    "$PAX_ROOT/tools/mkinitramfs" "$work/eds.cpio" /bin/edwolf="$er/bin/edwolf":755 /bin/hostq="$er/bin/hostq":755 /bin/as="$er/bin/as":755 \
        /tmp/:1777 /etc/pax-run="$work/eds.run":644 > "$work/eds.initramfs.txt" || why+=" tools/mkinitramfs eds;"
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        for kn in kmain_console kmain_session; do
            log=$work/$tier/$kn.build-kernel.log
            if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/$kn.lu" "$work/$tier" 2>"$log"); then
                for im in probe shell shell-user gaps fds pjobs pjobs-user groups sigs execs eds; do
                    [ "$(image_kernel "$im")" = "$kn" ] || continue
                    "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                        --add "$work/$im.cpio" initramfs.cpio "$elf" "$work/$tier/$im.iso" >/dev/null \
                        || why+=" $tier $im: mkimage;"
                    say "built $tier $im: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/$im.iso"), initramfs $(sha256_of "$work/$im.cpio")"
                done
            else
                cat "$log" >&2
                why+=" $tier $kn: tools/build-kernel;"
            fi
        done
    done
    for n in $TYPED; do
        for f in "$n.tty" "$n.tty.rc" "vm-$n.meta"; do
            [ -s "$REC/$f" ] || why+=" no recording $REC/$f;"
        done
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS J0 (build): kmain_console and kmain_session built ($tiers), every program static, the images built, the recordings there" || bad "J0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS J0: kmain_console and kmain_session built ($tiers), every program static, the images built, the Linux side ran in a throwaway container" || bad "J0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx5-jobs build (J0): PASS (no boot: --no-boot)" || say "mpx5-jobs build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux

# px49: a container's user is refused TIOCSTI only where its host says
# dev.tty.legacy_tiocsti 0 (kasumi's, and the recordings' guest: -EIO);
# a host that says 1 lets a user put a byte in its own terminal. On such
# a host the container's TIOCSTI rows are its host's, left out (named)
# where gaps-user is held to the container.
STI=$(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null || echo 0)
# px53: a host whose kernel.core_pattern pipes cores to a program dumps
# one at every end by a core signal whatever RLIMIT_CORE says (core(5);
# s246 and bu28 measured kasumi's and CI's runner's), so its container's
# wait4 statuses carry the core bit: timeout's `dumped core` line and
# sigwolf's `C:` rows are that host's there, left out (named).
PIPED=0
case $(cat /proc/sys/kernel/core_pattern 2>/dev/null) in '|'*) PIPED=1 ;; esac
host_rows() { # name file -> the file, the host's rows left out
    if [ "$1" = gaps-user ] && [ "$STI" != 0 ]; then command grep -v '^I: TIOCSTI' "$2"
    elif [ "$1" = fds-user ]; then command grep -v "^P: its zombie child's fd/: " "$2" # px50: the host kernel's (below)
    elif [ "$1" = groups-user ] && [ "$PIPED" = 1 ]; then command grep -vxF "$CORE_LINE" "$2"
    elif [ "$1" = sigs-user ] && [ "$PIPED" = 1 ]; then command grep -v -e '^C: ' -e "^$LHARD" "$2"
    elif [ "$1" = sigs-user ]; then command grep -v "^$LHARD" "$2" # px55: tools/linux-tree's own --ulimit core=0:0
    elif [ "$1" = hostq-user ]; then command grep -v "^$HHARD" "$2" # px57: the same, hostq's row
    else cat "$2"; fi
}
# px57: the eds image's `~` lines are PAX's own (J13): left out of every
# comparison with Linux by name, and held to each side's answer apart.
pax_own() { # name file -> the file, its `~` rows left out where they are PAX's own
    case $1 in
        eds|eds-user|hostq|hostq-user) command grep -v -e '^~N: ' -e '^~H: ' "$2" ;;
        # px83: a changed probe moves deep's address; J4 checks the live
        # PC against its ELF symbol before the comparison masks the number.
        sigs|sigs-user) command grep -v -e '^~X: ' "$2" | sed -E 's/^  at pc=0x[0-9a-f]+$/  at pc=DEEP/' ;;
        *) cat "$2" ;;
    esac
}
# The recordings and the container agree before PAX is held to them.
for n in $TYPED; do
    norm_session "$REC/$n.tty" > "$images/rec-$n.full"
    pax_own "$n" "$images/rec-$n.full" > "$images/rec-$n.cmp" # px57: the `~` rows apart (J13)
done
for n in $UTYPED; do
    booted "$(user_image "$n")" || continue # px52: an image this run does not boot
    if [ ! -f "$lx/$n.tty" ]; then
        bad "J0 linux $n: no $lx/$n.tty (build first, and run the Linux side)"
        continue
    fi
    norm_session "$lx/$n.tty" > "$lx/$n.full"
    if [ "$n" = sigs-user ]; then
        python3 -I "$here/mpx5-jobs.d/sigign.py" "$lx/$n.full" "$images/sroot/bin/sigwolf" || bad 'J4 Linux SigIgn ordered probe'
    fi
    host_rows "$n" "$lx/$n.full" | pax_own "$n" /dev/stdin > "$lx/$n.cmp"
    host_rows "$n" "$images/rec-$n.cmp" > "$images/rec-$n.host.cmp"
    hn=; [ "$n" = gaps-user ] && [ "$STI" != 0 ] && hn=" (this host's dev.tty.legacy_tiocsti is $STI: its TIOCSTI rows left out)"
    [ "$n" = fds-user ] && hn=" (its zombie row left out: the host kernel's)"
    [ "$n" = groups-user ] && [ "$PIPED" = 1 ] && hn=" (this host's core_pattern pipes: timeout's 'dumped core' line left out)"
    [ "$n" = sigs-user ] && hn=" (the hard core limit's row left out: the container's is tools/linux-tree's --ulimit core=0:0)"
    [ "$n" = sigs-user ] && [ "$PIPED" = 1 ] && hn=" (this host's core_pattern pipes: the C rows left out; the hard core limit's row left out: the container's is tools/linux-tree's --ulimit core=0:0)"
    [ "$n" = hostq-user ] && hn=" (the hard core limit's row left out: the container's is tools/linux-tree's --ulimit core=0:0; the ~ rows apart, J13)"
    [ "$n" = eds-user ] && hn=" (the ~ rows apart, J13)"
    if cmp -s "$lx/$n.cmp" "$images/rec-$n.host.cmp" && [ "$(cat "$lx/$n.tty.rc")" = "$(cat "$REC/$n.tty.rc")" ]; then
        say "PASS J0 linux $n: the container's session is real root's recording, $(wc -l < "$lx/$n.cmp" | tr -d ' ') lines ($(sha256_of "$lx/$n.cmp" | cut -c1-12)…)$hn"
    else
        bad "J0 linux $n: the container's session is not real root's recording$hn: $(diff "$images/rec-$n.host.cmp" "$lx/$n.cmp" | head -n 14 | cut -c1-300 | tr '\n' '|')"
    fi
done

record() { # tier leg boot status
    ran=$((ran + 1))
    printf '%s kmain_console %s %s halt-status=%s accel=%s serial=%s iso=%s\n' "$1" "$2" "$3" "$4" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" "$(sha256_of "$iso")" >> "$runs"
}

# Run k's transcript: from its `run <k>:` line to the kernel's `user:
# frames free …` line after it (the run's report: its tree and its
# sockets' lines follow), the kernel's own lines left out.
run_part() { # norm k
    awk -v k="$2" '
        $0 ~ "^run " k ": " { on = 1; next }
        on && /^run [0-9]+: |^run: [0-9]+ commands$|^user: frames free / { exit }
        on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$1"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        for b in $BOOTS; do
            im=${b%%:*} kb=${b#*:}
            bn=$im; [ "$kb" = ps2 ] && bn=$im-ps2
            id="$tier $leg $bn"
            log=$PAX_BUILD/mpx5-jobs-$tier-$leg-$bn.serial.log
            elf=$images/$tier/$(image_kernel "$im").elf iso=$images/$tier/$im.iso
            rm -f "$log" "$log.verdict" "$log.typed"
            if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
                bad "J6 $id: no image"
                continue
            fi
            image_keys "$im" > "$images/$bn.keys"
            hrc=0
            "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 900 --qemu -m --qemu 512M \
                --elf "$elf" --marker 'halt|PANIC .*' --type "$images/$bn.keys" --prompt "$(image_prompt "$im")" --keyboard "$kb" "$iso" >"$log.verdict" 2>&1 || hrc=$?
            record "$tier" "$leg" "$bn" "$hrc"
            norm=$log.norm; serial_norm "$log" > "$norm"
            nk=$(image_runs "$im" | wc -l | tr -d ' ')
            k=1
            while [ "$k" -le "$nk" ]; do
                n=$(run_name "$im" "$k")
                out=$PAX_BUILD/mpx5-jobs-$tier-$leg-$bn-$n.session
                run_part "$norm" "$k" > "$out"
                norm_session "$out" > "$out.full"
                pax_own "$n" "$out.full" > "$out.cmp" # px57: the `~` rows apart (J13)
                case $n in
                    soak|soak-user)
                        # J5: the soak's own rules.
                        why=
                        grep -qx "soak: $SOAK rounds of nine calls, 0 wrong answers" "$out.cmp" || why+=" no 'soak: $SOAK rounds of nine calls, 0 wrong answers' ($(grep -m1 '^soak: ' "$out.cmp"));"
                        q=$(grep -c '^~soak: ' "$out.cmp")
                        [ "$q" = 4 ] || why+=" $q quarter lines, not 4;"
                        mf=$(sed -n 's/^~soak: [0-9]* rounds, [0-9]* wrong; MemFree:[[:space:]]*\([0-9]*\) kB$/\1/p' "$out.cmp" | sort -u | wc -l | tr -d ' ')
                        [ "$mf" = 1 ] || why+=" MemFree moved: $(sed -n 's/^~soak: .*MemFree:[[:space:]]*//p' "$out.cmp" | tr '\n' ' ');"
                        if [ "$n" = soak ]; then grep -qx "jobs: px48's probe, as root" "$out.cmp" || why+=" not root's;"
                        else grep -qx "jobs: px48's probe, as a user" "$out.cmp" || why+=" not a user's;"; fi
                        [ -z "$why" ] && say "PASS J5 $id $n: $SOAK rounds, 0 wrong, MemFree $(sed -n 's/^~soak: .*MemFree:[[:space:]]*//p' "$out.cmp" | head -n 1) at every quarter" || bad "J5 $id $n:$why"
                        ;;
                    *)
                        # J1/J2: real root's recording; J3: the container's.
                        rec=$images/rec-$n.cmp
                        why=
                        if [ "$kb" = ps2 ]; then
                            # pax#68: typed at the keyboard of a machine with a screen,
                            # the window is the screen's grid; held so, then compared as
                            # the serial line's 0 by 0 (Linux's pseudo-terminal's).
                            wl=$(grep -m1 '^V: TIOCGWINSZ after the keys: ' "$out.cmp")
                            case $wl in
                                'V: TIOCGWINSZ after the keys: 0, '[1-9]*' rows '[1-9]*' cols') ;;
                                *) why+=" the window after PS/2 keys is not the screen's grid ('$wl');" ;;
                            esac
                            sed -i.grid 's/^V: TIOCGWINSZ after the keys: 0, [0-9]* rows [0-9]* cols$/V: TIOCGWINSZ after the keys: 0, 0 rows 0 cols/' "$out.cmp"
                        fi
                        cmp -s "$rec" "$out.cmp" || why+=" the session differs from real root's recording: $(diff "$rec" "$out.cmp" | head -n 14 | cut -c1-300 | tr '\n' '|');"
                        short=10; case $n in pjobs-*) short=2 ;; esac # px51: sh18's sessions are short ones
                        [ "$(wc -l < "$out.cmp" | tr -d ' ')" -gt "$short" ] || why+=" a short session;"
                        t=J1; case $n in shell*) t=J2 ;; gaps*) t=J7 ;; fds*) t=J8 ;; pjobs*) t=J9 ;; groups*) t=J10 ;; sigs*) t=J11 ;; execs*|xsh*) t=J12 ;; eds*|hostq*) t=J13 ;; esac
                        [ -z "$why" ] && say "PASS $t $id $n: $(wc -l < "$out.cmp" | tr -d ' ') lines byte-identical to real root's recording ($(sha256_of "$out.cmp" | cut -c1-12)…)" || bad "$t $id $n:$why"
                        case $n in
                            *-user|pjobs-user-*)
                                why=
                                if [ -f "$lx/$n.cmp" ]; then
                                    host_rows "$n" "$out.cmp" > "$out.host.cmp"
                                    cmp -s "$lx/$n.cmp" "$out.host.cmp" || why+=" differs from the container's: $(diff "$lx/$n.cmp" "$out.host.cmp" | head -n 10 | cut -c1-300 | tr '\n' '|');"
                                else
                                    why+=" no container session;"
                                fi
                                [ -z "$why" ] && say "PASS J3 $id $n: byte-identical to the container's too" || bad "J3 $id $n:$why"
                                ;;
                        esac
                        # J4: the run's own witness.
                        why=
                        case $n in
                            probe) grep -qx "jobs: px48's probe, as root" "$out.cmp" || why+=" not root's;"
                                   grep -q '^K: as 1000, kill(-G) G={a root member, a 1000 member}: 0, heard Yuser:USR1$' "$out.cmp" || why+=" no mixed-group row;" ;;
                            probe-user) grep -qx "jobs: px48's probe, as a user" "$out.cmp" || why+=" not a user's;"
                                        grep -qx 'K: the mixed groups: skipped by name (not root)' "$out.cmp" || why+=" no skip by name;" ;;
                            shell) grep -q '^~ # ' "$out.cmp" || why+=" no root prompt;" ;;
                            shell-user) grep -q '^~ \$ ' "$out.cmp" || why+=" no user prompt;" ;;
                            # px49: who it is, by the rows that differ between root and a user.
                            gaps) grep -qx "gaps: px49's probe, as root" "$out.cmp" || why+=" not root's;"
                                  grep -qx "I: TIOCSTI 'q' on its own terminal: 0; a read then: 1 bytes \"q\"" "$out.cmp" || why+=" no root's TIOCSTI row;"
                                  grep -qx 'O: the end accept made: 1003:2003 (the maker'"'"'s file-system ids)' "$out.cmp" || why+=" no root's accept row;" ;;
                            # px50: who it is, by the rows that differ between root and a user.
                            fds) grep -qx "fdtab: px50's probe, as root" "$out.cmp" || why+=" not root's;"
                                 grep -qx "O: root's 0644 file's O_RDONLY entry opened O_WRONLY: 0" "$out.cmp" || why+=" no root's reopen row;"
                                 grep -qx "N: descriptor 0 root's 0644 file O_RDONLY: open /dev/stdin O_WRONLY 0" "$out.cmp" || why+=" no root's /dev/stdin reopen row;"
                                 grep -qx 'X: rmdir of /proc EBUSY, /sys EBUSY' "$out.cmp" || why+=" no root's rmdir row;"
                                 grep -qxF "$FDLINK" "$out.cmp" || why+=" no /dev/fd link row;" # px55
                                 grep -qxF "$FDCAT" "$out.cmp" || why+=" no read through /dev/fd/0;" ;;
                            fds-user) grep -qx "fdtab: px50's probe, as a user" "$out.cmp" || why+=" not a user's;"
                                      grep -qx "O: root's 0644 file's O_RDONLY entry opened O_WRONLY: EACCES" "$out.cmp" || why+=" no user's reopen row;"
                                      grep -qx "N: descriptor 0 root's 0644 file O_RDONLY: open /dev/stdin O_WRONLY EACCES" "$out.cmp" || why+=" no user's /dev/stdin reopen row;"
                                      grep -qx 'X: rmdir of /proc EACCES, /sys EACCES' "$out.cmp" || why+=" no user's rmdir row;"
                                      grep -qxF "$FDLINK" "$out.cmp" || why+=" no /dev/fd link row;" # px55
                                      grep -qxF "$FDCAT" "$out.cmp" || why+=" no read through /dev/fd/0;" ;;
                            # px51: pelt's prompt; the rows each case is about.
                            pjobs-*) grep -q '^\$ ' "$out.cmp" || why+=" no prompt;"
                                     for w in $(pwitness "${n#pjobs-}"); do
                                         grep -q -- "$w" "$out.cmp" || why+=" no '$w';"
                                     done ;;
                            groups|groups-user)
                                for w in st=124 st=137 st=125 st=126 st=127 st=143 'st=1$' Terminated Killed RTMAX checked \
                                         st=139 st=162 '^ 0 EXIT Unknown signal 0$'; do # px53: the last three
                                    grep -q -- "$w" "$out.cmp" || why+=" no '$w';"
                                done
                                [ "$(grep -c '^survived$' "$out.cmp")" = 1 ] || why+=" 'survived' $(grep -c '^survived$' "$out.cmp") times, not once (the --foreground run's alone);"
                                ! grep -qxF "$CORE_LINE" "$out.cmp" || why+=" '$CORE_LINE' on PAX, which writes no core;" ;;
                            # px53: who it is, and the rows 0.2.33 turns.
                            sigs|sigs-user)
                                if [ "$n" = sigs ]; then grep -qx "sigwolf: px53's probe of wolf 0.2.33's signal calls, as root" "$out.cmp" || why+=" not root's;"
                                else grep -qx "sigwolf: px53's probe of wolf 0.2.33's signal calls, as a user" "$out.cmp" || why+=" not a user's;"; fi
                                for w in 'T: text(0): Unknown signal 0' 'E: sent-segv: signal 11' 'E: ignored-sent-segv: exit 0' \
                                         'E: exit-segv: signal 11' 'E: ignored-rt: exit 0' 'E: defaulted-rt: signal 34' \
                                         'G: SEGMENT_FAULT to its own group, ignored by the leader: the job signal 11; the leader lives' \
                                         'G: host 34 to its own group, ignored by the leader: the job signal 34; the leader lives' \
                                         'C: exit-segv, wait_status_core: signal 11' 'F: overflow-ignored: exit 134' \
                                         'L: the core limit, soft: 0' 'L: the core limit, hard: unlimited' \
                                         'wolf-trap: stack-overflow'; do # px55: the two L rows; px65: 0.2.35's report
                                    grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                done
                                # px83 (#174): the joined-task event orders the runtime's
                                # handler installation before the read on both systems.
                                if ! sx=$(python3 -I "$here/mpx5-jobs.d/sigign.py" "$out.full" "$images/sroot/bin/sigwolf"); then
                                    why+=" $sx;"
                                fi
                                w='~X: a child started under the fault ignore: SigIgn: 0000000000000000'
                                grep -qxF "$w" "$images/rec-$n.full" || why+=" the recording's row '$w' not there;" ;;
                            gaps-user) grep -qx "gaps: px49's probe, as a user" "$out.cmp" || why+=" not a user's;"
                                       grep -qx "I: TIOCSTI 'q' on its own terminal: EIO; a read then: 0 bytes" "$out.cmp" || why+=" no user's TIOCSTI row;"
                                       grep -qx 'A: R_OK through the link: EACCES' "$out.cmp" || why+=" no user's refused access row;" ;;
                            # px56: who it is, and the rows #95 and #96 turn.
                            execs|execs-user)
                                if [ "$n" = execs ]; then xw=/g/w0 xi=0/0 xr='exit 7'; grep -qx "execs: px56's probe, as root" "$out.cmp" || why+=" not root's;"
                                else xw=/g/w1000 xi=1000/1000 xr='errno EACCES'; grep -qx "execs: px56's probe, as a user" "$out.cmp" || why+=" not a user's;"; fi
                                for w in "F: a copy written since boot (read, write, 0755): run: argc 3: \"copy\" \"one\" \"two\"; execfn \"$xw/copy\"; exe \"$xw/copy\"; name \"copy\"; ids $xi" \
                                         'F: the archive copy with that page rewritten: run: marker "px56 marker B"' \
                                         "F: run by /proc/self/fd/9: run: argc 2: \"fd\" \"u\"; execfn \"/proc/self/fd/9\"; exe \"$xw/gone (deleted)\"; name \"9\"; ids $xi" \
                                         "E: root's 0744 file: $xr" 'E: a 0755 text file with no #!: errno ENOEXEC' \
                                         'T: a copy the probe holds open for writing: errno ETXTBSY' \
                                         "S: #!/bin/execs say, run with argv zero a1 a2: run: argc 5: \"/bin/execs\" \"say\" \"$xw/s1\" \"a1\" \"a2\"; execfn \"$xw/s1\"; exe \"/bin/execs\"; name \"s1\"; ids $xi" \
                                         'S: a chain of 6 scripts: errno ELOOP'; do
                                    grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                done ;;
                            # px57: who it is, the rows 0.2.34's calls turn, and the `~` rows held to PAX's answers.
                            eds|eds-user)
                                if [ "$n" = eds ]; then grep -qx "edwolf: px57's probe of wolf 0.2.34's calls, as root" "$out.cmp" || why+=" not root's;"
                                else grep -qx "edwolf: px57's probe of wolf 0.2.34's calls, as a user" "$out.cmp" || why+=" not a user's;"; fi
                                for w in "K: through a pipe made before the fork: the child's pid new true, its ppid the parent's true, its answer (0, -1)" \
                                         'K: fork inside a scope while a task is live: busy' 'K: fork from a task: busy' \
                                         'K: fork after the scopes joined: ok, the child exit 0' \
                                         'W: USER raised to itself, a ready pipe beside it: the meaning wins: (-1, 512)' \
                                         'T: RAW_CR, RAW_OUTPUT and STRIP8 set and read back: true true true; the rest as set: true' \
                                         'T: restore-return: the child exit 0; the mode back: true' 'T: restore-exit: the child exit 3; the mode back: true' \
                                         'T: restore-trap: the child exit 134; the mode back: true' 'T: restore-signal: the child signal 15; the mode back: true' \
                                         'S: fs_sync of a pipe: io (22)' 'X: open mode 4, the name taken: exists' \
                                         'R: .. after a link to /etc: /' 'R: a loop of links: io (40)' 'edwolf: done'; do
                                    grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                done
                                z=$(sed -n 's/^~N: twenty rounds of work read 0 ns in \([0-9]*\) of 20 .*/\1/p' "$out.full")
                                [ -n "$z" ] && [ "$z" -ge 10 ] || why+=" the clock's grain: '$(grep -m1 '^~N: ' "$out.full")', not 10 or more of 20 rounds at 0 (PAX's 10 ms ticks);"
                                zr=$(sed -n 's/^~N: twenty rounds of work read 0 ns in \([0-9]*\) of 20 .*/\1/p' "$images/rec-$n.full")
                                [ "$zr" = 0 ] || why+=" the recording's clock row reads 0 in '$zr' rounds, not none (Linux's);" ;;
                            hostq|hostq-user)
                                if [ "$n" = hostq ]; then grep -qx "hostq: px57's probe of s253's calls (pax#107), as root" "$out.cmp" || why+=" not root's;"
                                else grep -qx "hostq: px57's probe of s253's calls (pax#107), as a user" "$out.cmp" || why+=" not a user's;"; fi
                                for w in 'H: uname: machine x86_64 (os_arch)' "H: prlimit64 RLIMIT_CORE read: 0, soft 0 (os_core_limit's first)" \
                                         'H: the core limit, hard: unlimited' 'H: prctl PR_GET_DUMPABLE then: 0' \
                                         'H: an inherited descriptor 5: F_GETFD 0 (open, not close-on-exec)' \
                                         'H: F_SETFD FD_CLOEXEC: 0; F_GETFD then: 1' 'H: a descriptor never opened (9): F_GETFD -9' \
                                         'hostq: the adopting child exit 0'; do
                                    grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                done
                                for w in '~H: uname: 0, sysname PAX (os_name: the sysname lowercased)' \
                                         '~H: prlimit64 RLIMIT_CORE set to itself: -1 (os_set_core_limit)' \
                                         '~H: prlimit64 RLIMIT_CORE set to soft 0, hard 0 (a lowering): -1'; do
                                    grep -qxF "$w" "$out.full" || why+=" PAX's own row '$w' not there;"
                                done
                                for w in '~H: uname: 0, sysname Linux (os_name: the sysname lowercased)' \
                                         '~H: prlimit64 RLIMIT_CORE set to itself: 0 (os_set_core_limit)' \
                                         '~H: prlimit64 RLIMIT_CORE set to soft 0, hard 0 (a lowering): 0'; do
                                    grep -qxF "$w" "$images/rec-$n.full" || why+=" the recording's row '$w' not there;"
                                done ;;
                            xsh|xsh-user)
                                for w in 'hi' '     1	#!/bin/cat -n' 'pelt: line 14: ./d5: cannot be run'; do
                                    grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                done
                                [ "$(grep -cx 'st=1' "$out.cmp")" = 2 ] || why+=" 'st=1' $(grep -cx 'st=1' "$out.cmp") times, not twice (the copied false, the rewritten copy);" ;;
                        esac
                        case $n in
                            probe*) for w in 'T: ^C with the job in the foreground: heard J1:INT,J2:INT' \
                                             'T: ^Z with a job at its default in the foreground: stopped by TSTP (status 0x147f)' \
                                             'T: the jobs that were not in the foreground heard -'; do
                                        grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                    done ;;
                            shell*) for w in Stopped Running Terminated Done; do
                                        grep -q "^\[[0-9]\]. *$w" "$out.cmp" || why+=" no '$w' job line;"
                                    done ;;
                            fds*) for w in 'L: a file opened O_RDONLY: "/g/f1"' \
                                           'L: a file unlinked while open: "/g/f5 (deleted)"' \
                                           'O: the directory'"'"'s entry, then o1: 0, /g/o1: yes' \
                                           'I: O_WRONLY|O_APPEND (>>): pos:\t0|flags:\t0102001|mnt_id:\t<the tree'"'"'s>|ino:\t<fstat'"'"'s>' \
                                           'I: then a read: 8 bytes, the value 1: pos:\t0|flags:\t02|mnt_id:\t<another>|ino:\t<fstat'"'"'s>|eventfd-count:                2|eventfd-id: N|eventfd-semaphore: 1' \
                                           'N: /dev/stdin: readlink "/proc/self/fd/0"; lstat link 0777 size 15 nlink 1 owner 0:0; statx AT_SYMLINK_NOFOLLOW link 0777 size 15; in /dev'"'"'s listing DT_LNK' \
                                           'N: descriptor 1 a file O_APPEND of 6 bytes: open /dev/stdout O_WRONLY|O_CREAT|O_TRUNC 0, the file then 0 bytes; x through it, y through descriptor 1: "xy"'; do
                                        grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                    done ;;
                            gaps*) for w in 'U: two threads, a process signal: 20 signals sent, each handled once yes; A left sigsuspend without its own handler 0 times; A waits at the end yes' \
                                            'B: sendfile under TOSTOP: stopped by TTOU; continued in the background: stopped by TTOU' \
                                            'B: splice under TOSTOP: stopped by TTOU; continued in the background: stopped by TTOU'; do
                                        grep -qxF "$w" "$out.cmp" || why+=" no '$w';"
                                    done ;;
                        esac
                        [ -z "$why" ] && say "PASS J4 $id $n: its own witness (who it runs as, the foreground group's keys, the job lines)" || bad "J4 $id $n:$why"
                        ;;
                esac
                k=$((k + 1))
            done

            # J6: what PAX lacks; nothing refused; the end.
            why=
            ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$norm" | sort -un | paste -sd' ' -)
            [ "$ns" = "273 334" ] || why+=" -ENOSYS for '$ns', not '273 334';"
            rf=$(grep -c ': refused: ' "$norm")
            [ "$rf" = 0 ] || why+=" $rf refused lines ($(grep -m1 ': refused: ' "$norm" | cut -c1-160));"
            init=$(image_runs "$im" | head -n 1 | cut -d' ' -f1)
            grep -qx "PAX: init $init ended with status 0; nothing left to run" "$norm" \
                || why+=" no 'PAX: init $init ended with status 0' ($(grep -m1 '^PAX: init ' "$norm"));"
            pn=$(grep -m1 '^PANIC ' "$norm")
            [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
            [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
            [ -z "$why" ] && say "PASS J6 $id: -ENOSYS only for 273 and 334; nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "J6 $id:$why"
        done
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx5-jobs: PASS$subset" || say "mpx5-jobs: FAIL$subset"
exit "$fail"
