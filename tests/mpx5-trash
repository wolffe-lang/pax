#!/usr/bin/env bash
# tests/mpx5-trash — tb03: trash, a reversible rm in wolf (user/trash.pin,
# tools/mktrash; wolffe-lang/trash), preinstalled on PAX as /bin/trash,
# /bin/trash-list, /bin/trash-restore, /bin/trash-rm and /bin/trash-empty,
# typed at the console's shell (pelt), held byte for byte to the same
# binaries on Linux, as root and as `pax`.
#
#   tests/mpx5-trash [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                    [--firmware bios|uefi|both] [--tier native|release|both]
#                    [--prebuilt DIR] [--kernel ELF]
#
# One image, kmain_console with the archive: pelt as /bin/pelt and
# /bin/sh, the five commands (unmodified: tools/mktrash's, already
# stripped by trash's own build), boreutils' printf and mkdir
# (user/boreutils.pin), /bin/as; /etc (hostname, motd, pax-run), /tmp
# (1777), /home/pax (0755, 1000:1000). Its run list, one typed session a
# run (user/console/trash.keys, typed twice), prompt `$ `:
#   trash       `/bin/sh -i -m` (root, HOME=/, so its trash is /Trash);
#   trash-user  `/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m`
#               (`pax`, its trash /home/pax/Trash).
# The keys define `s` (a command's status, then its standard output,
# `[stderr]` and its standard error), `l` (trash-list's paths, its dates
# left out: PAX's clock and the container's differ) and `f` (names, by a
# glob, so in its sorted order). Each listing holds one item at most, so
# no line depends on the order a directory lists its entries in.
#
# **The Linux side** is the same binaries typed the same keys in a
# throwaway container (tools/linux-tree: the tree a tmpfs, the shell on a
# pseudo-terminal as pid 1 of a fresh pid namespace, PAX's environment),
# as root and through `as 1000 1000`, run live.
#
# What is compared, by rule: each run's transcript, from its `run <k>:`
# line to the kernel's `user: frames free` line after it, normalised as a
# serial log is (tools/lib.sh's serial_norm), the kernel's own `user: …`
# lines out; the container's whole transcript, normalised the same way.
#
# Assertions, per tier, firmware and session:
#   A0 build: kmain_console built; pelt, the five, printf, mkdir and as
#      static (ET_EXEC, no PT_INTERP); the five built twice to one digest
#      each (tools/mktrash); /bin/sh pelt; the image built; the container's
#      two sessions ran.
#   A1 each session byte-identical to the container's.
#   A2 the session's own witness (tests/mpx5-trash.d/rows.py, 17 rows):
#      the commands found by PATH, --version, a file trashed and listed, a
#      tree and two files trashed, nothing left where they were and the four
#      in the trash under their names, a missing operand refused by name
#      (74) and silent under -f, the tree restored by its path with its
#      bytes, a pattern removed, trash-empty -i's question and its answer,
#      an empty listing and empty files/ and info/ at the end.
#   A3 -ENOSYS only for set_robust_list (273) and rseq (334); no
#      `refused:` line; `PAX: init /bin/sh ended with status 0; nothing
#      left to run`, `halt`, held halted.
# A2 is each run's own witness: the container runs the same binaries, so
# a break of both sides leaves A1 green and turns A2; a kernel break of
# PAX's alone turns A1.
#
# --prebuilt DIR takes pelt and boreutils' printf and mkdir already built,
# from DIR/pelt and DIR/bore (their builders' outputs, each with its
# sums.txt), instead of building them; --kernel ELF takes kmain_console
# already built for one tier (--tier native or release, not both). Both are
# for a lane's own runs on staged inputs; CI builds everything.
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only= prebuilt= kernel=
usage="usage: tests/mpx5-trash [--images DIR | --no-boot | --only build | --only linux --images DIR] [--firmware bios|uefi|both] [--tier native|release|both] [--prebuilt DIR] [--kernel ELF]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        --prebuilt) prebuilt=$(cd "$2" && pwd) || die "--prebuilt: no directory $2"; shift 2 ;;
        --kernel)   kernel=$(cd "$(dirname "$2")" && pwd)/$(basename "$2") || die "--kernel: no $2"; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
[ -z "$kernel" ] || [ "$tiers" = native ] || [ "$tiers" = release ] || die "--kernel takes one tier: --tier native or release"
need readelf python3

KEYS=$PAX_ROOT/user/console/trash.keys
ROWS=$here/mpx5-trash.d/rows.py
BORE="printf mkdir" # boreutils in the image (user/boreutils.pin)
TRASH="trash trash-list trash-restore trash-rm trash-empty"
RUNS=("/bin/sh -i -m" "/bin/as 1000 1000 /bin/env HOME=/home/pax /bin/sh -i -m")
NAMES=(trash trash-user)
HOMES=(/ /home/pax)

work=$PAX_BUILD/mpx5-trash
runs=$PAX_BUILD/mpx5-trash-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The container's two sessions, root's and the user's.
linux_side() { # dir -> reasons on stdout
    mkdir -p "$1/linux"
    local k a0
    for k in 0 1; do
        # shellcheck disable=SC2086 # the run line's words, as the kernel splits them
        set -- "$1" ${RUNS[$k]}
        a0=$2
        if "$PAX_ROOT/tools/linux-tree" --root "$1/root" --keys "$KEYS" --prompt '$ ' --argv0 "$a0" --size 512m --rdev --nsproc \
            --owners "$1/owners" "$1/linux/${NAMES[$k]}.tty" -- "${@:2}"; then
            say "  linux ${NAMES[$k]}: $(wc -c < "$1/linux/${NAMES[$k]}.tty" | tr -d ' ') bytes, status $(cat "$1/linux/${NAMES[$k]}.tty.rc")"
        else
            printf ' tools/linux-tree %s;' "${NAMES[$k]}"
        fi
    done
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS A0 (linux): the Linux side ran in a throwaway container" || bad "A0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    if [ -z "$kernel" ]; then
        wolf=${PAX_WOLF:-wolf}
        need "$wolf"
        say "wolf: $("$wolf" --version | head -n 1)"
    fi
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/bin" "$r/etc" "$r/home/pax" "$r/tmp" "$work/bin"
    why=
    if [ -n "$prebuilt" ]; then
        cp -R "$prebuilt/pelt" "$work/pelt" && cp -R "$prebuilt/bore" "$work/bore" || why+=" --prebuilt: no pelt/ or bore/;"
        for p in pelt bore; do
            while read -r n d z; do
                [ "$(sha256_of "$work/$p/$n" 2>/dev/null) $(wc -c < "$work/$p/$n" 2>/dev/null | tr -d ' ')" = "$d $z" ] \
                    || why+=" --prebuilt: $p/$n is not its sums.txt's;"
            done < "$work/$p/sums.txt"
            say "  prebuilt $p: $(tr '\n' ' ' < "$work/$p/sums.txt")"
        done
    else
        "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" || why+=" tools/mkpelt;"
        "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE > "$work/bore.txt" || why+=" tools/mkboreutils;"
    fi
    "$PAX_ROOT/tools/mktrash" "$work/trash" > "$work/trash.txt" || why+=" tools/mktrash;"
    "$PAX_ROOT/tools/mkas" "$work/bin" > "$work/as.txt" || why+=" tools/mkas;"
    cp "$work/pelt/pelt" "$r/bin/pelt" 2>/dev/null || why+=" no pelt;"
    cp "$work/pelt/pelt" "$r/bin/sh" 2>/dev/null || true
    for u in $TRASH; do cp "$work/trash/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"; done
    for u in $BORE; do cp "$work/bore/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"; done
    cp "$work/bin/as" "$r/bin/as" 2>/dev/null || why+=" no as;"
    for f in "$r"/bin/*; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    [ -x "$r/bin/sh" ] && cmp -s "$r/bin/sh" "$r/bin/pelt" || why+=" /bin/sh is not pelt in the root;"
    printf '%s\n' "${RUNS[@]}" > "$r/etc/pax-run"
    printf 'pax\n' > "$r/etc/hostname"
    printf 'PAX: trash at the console (tb03)\n' > "$r/etc/motd"
    printf '%s\n' '/tmp 1777 0 0' '/home/pax 755 1000 1000' > "$work/owners"
    args=(/tmp/:1777 /home/pax/:755:1000:1000
        /etc/pax-run="$r/etc/pax-run":644 /etc/hostname="$r/etc/hostname":644 /etc/motd="$r/etc/motd":644)
    for f in "$r"/bin/*; do args+=("/bin/${f##*/}=$f:755"); done
    "$PAX_ROOT/tools/mkinitramfs" "$work/trash.cpio" "${args[@]}" > "$work/trash.initramfs.txt" || why+=" tools/mkinitramfs;"
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if [ -n "$kernel" ]; then
            cp "$kernel" "$work/$tier/kmain_console.elf" && elf=$work/$tier/kmain_console.elf || why+=" --kernel: cannot copy $kernel;"
            say "  kernel: $tier kmain_console given, $(sha256_of "$elf")"
        elif ! elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
            continue
        fi
        "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
            --add "$work/trash.cpio" initramfs.cpio "$elf" "$work/$tier/trash.iso" >/dev/null || why+=" $tier: mkimage;"
        say "built $tier trash: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/trash.iso"), initramfs $(sha256_of "$work/trash.cpio")"
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS A0 (build): kmain_console ($tiers), every program static, the five twice to one digest, /bin/sh pelt, the image built" || bad "A0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS A0: kmain_console ($tiers), every program static, the five twice to one digest, /bin/sh pelt, the image built, the Linux side ran in a throwaway container" || bad "A0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx5-trash build (A0): PASS (no boot: --no-boot)" || say "mpx5-trash build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux
for n in "${NAMES[@]}"; do
    [ -f "$lx/$n.tty" ] || { bad "A0 linux $n: no $lx/$n.tty (build first, and run the Linux side)"; continue; }
    serial_norm "$lx/$n.tty" > "$lx/$n.cmp"
done

# Run k's transcript: from its `run <k>:` line to the kernel's `user:
# frames free …` line after it, the kernel's own lines left out
# (tests/mpx5-jobs' rule).
run_part() { # norm k
    awk -v k="$2" '
        $0 ~ "^run " k ": " { on = 1; next }
        on && /^run [0-9]+: |^run: [0-9]+ commands$|^user: frames free / { exit }
        on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$1"
}

record() { # tier leg status
    ran=$((ran + 1))
    printf '%s kmain_console %s trash halt-status=%s accel=%s serial=%s iso=%s\n' "$1" "$2" "$3" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" "$(sha256_of "$iso")" >> "$runs"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        id="$tier $leg trash"
        log=$PAX_BUILD/mpx5-trash-$tier-$leg.serial.log
        elf=$images/$tier/kmain_console.elf iso=$images/$tier/trash.iso
        rm -f "$log" "$log.verdict" "$log.typed"
        if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
            bad "A3 $id: no image"
            continue
        fi
        cat "$KEYS" "$KEYS" > "$images/trash.keys"
        hrc=0
        "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 900 --qemu -m --qemu 1024M \
            --elf "$elf" --marker 'halt|PANIC .*' --type "$images/trash.keys" --prompt '$ ' "$iso" >"$log.verdict" 2>&1 || hrc=$?
        record "$tier" "$leg" "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        for k in 0 1; do
            n=${NAMES[$k]}
            out=$PAX_BUILD/mpx5-trash-$tier-$leg-$n.session
            run_part "$norm" $((k + 1)) > "$out"
            serial_norm "$out" > "$out.cmp"
            # A1: the container's session.
            why=
            if [ -f "$lx/$n.cmp" ]; then
                cmp -s "$lx/$n.cmp" "$out.cmp" || why+=" the session differs from the container's: $(diff "$lx/$n.cmp" "$out.cmp" | head -n 14 | cut -c1-300 | tr '\n' '|');"
            else
                why+=" no container session;"
            fi
            [ "$(wc -l < "$out.cmp" | tr -d ' ')" -gt 40 ] || why+=" a short session;"
            [ -z "$why" ] && say "PASS A1 $id $n: $(wc -l < "$out.cmp" | tr -d ' ') lines byte-identical to the container's ($(sha256_of "$out.cmp" | cut -c1-12)…)" || bad "A1 $id $n:$why"
            # A2: the session's own witness.
            why=$(python3 "$ROWS" "$out.cmp" "${HOMES[$k]}")
            [ -z "$why" ] && say "PASS A2 $id $n: the $(python3 -c 'import runpy, sys; print(len(runpy.run_path(sys.argv[1])["rows"]("/")))' "$ROWS") rows (trashed, listed, refused, restored, removed, emptied)" || bad "A2 $id $n:$why"
        done
        # A3: what PAX lacks; nothing refused; the end.
        why=
        ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$norm" | sort -un | paste -sd' ' -)
        [ "$ns" = "273 334" ] || why+=" -ENOSYS for '$ns', not '273 334';"
        rf=$(grep -c ': refused: ' "$norm")
        [ "$rf" = 0 ] || why+=" $rf refused lines ($(grep -m1 ': refused: ' "$norm" | cut -c1-160));"
        grep -qx "PAX: init /bin/sh ended with status 0; nothing left to run" "$norm" \
            || why+=" no 'PAX: init /bin/sh ended with status 0' ($(grep -m1 '^PAX: init ' "$norm"));"
        pn=$(grep -m1 '^PANIC ' "$norm")
        [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
        [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
        [ -z "$why" ] && say "PASS A3 $id: -ENOSYS only for 273 and 334; nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "A3 $id:$why"
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx5-trash: PASS" || say "mpx5-trash: FAIL"
exit "$fail"
