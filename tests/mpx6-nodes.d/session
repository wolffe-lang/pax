#!/usr/bin/env python3
# session — a session's own lines from a serial log (px79,
# tests/mpx6-nodes; tests/mpx6-ext2.d/session's rule):
#
#   session pax SERIAL         PAX's: between `user: exec pid 1 ` and
#                              init's `user: <name> pid 1 exit_group|exit`,
#                              the kernel's own lines cut out (kernel/user's
#                              `user: …`, and kernel/block's `block: …`,
#                              kernel/ext2's `ext2: …` and kernel/journal's
#                              `journal: …`, which a rescan, a BLKPG change
#                              or a mount(2) print while a program runs),
#                              and a kernel line that landed inside a line
#                              a process had not finished cut from it
#   session linux SERIAL RUN   tools/linux-nodes's: between `linux-nodes:
#                              run RUN:` and `linux-nodes: run RUN status`
#
# Carriage returns and terminal escapes are removed first (lib.sh's
# serial_norm). The lines go to standard output.
import re
import sys

KERNEL = ("user: ", "block: ", "ext2: ", "journal: ", "blk: ", "fstab: ")


def lines(path):
    b = open(path, "rb").read().replace(b"\r", b"")
    b = re.sub(rb"\x1b\[[0-9;?=<>]*[A-Za-z]", b"", b)
    b = re.sub(rb"\x1b[()][A-Za-z0-9]", b"", b)
    b = re.sub(rb"\x1b[c78DEHM=>]", b"", b)
    return b.decode("utf-8", "surrogateescape").split("\n")


def pax(ls):
    out, on = [], False
    for l in ls:
        if l.startswith("user: exec pid 1 "):
            on = True
            continue
        if on and re.match(r"^user: [^ ]+ pid 1 (exit_group|exit) [0-9]+ after ", l):
            break
        if on:
            if l.startswith(KERNEL):
                continue
            i = min([j for j in (l.find(k) for k in KERNEL) if j > 0] or [-1])
            if i > 0:
                l = l[:i]
            out.append(l)
    return out


def linux(ls, run):
    out, on = [], False
    for l in ls:
        if l.startswith("linux-nodes: run %s:" % run):
            on = True
            continue
        if on and l.startswith("linux-nodes: run %s status" % run):
            break
        if on:
            out.append(l)
    return out


if len(sys.argv) < 3 or sys.argv[1] not in ("pax", "linux") or (sys.argv[1] == "linux" and len(sys.argv) != 4):
    sys.stderr.write("usage: session pax SERIAL | session linux SERIAL RUN\n")
    sys.exit(2)
got = pax(lines(sys.argv[2])) if sys.argv[1] == "pax" else linux(lines(sys.argv[2]), sys.argv[3])
sys.stdout.buffer.write(("\n".join(got) + "\n").encode("utf-8", "surrogateescape"))
