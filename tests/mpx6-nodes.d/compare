#!/usr/bin/env python3
# compare — hold PAX's session to the Linux guest's, section by section
# (px79, tests/mpx6-nodes): each `== <name>` line of the session scripts
# starts a section, and each section must be the guest's line for line,
# but for what is named here:
#
#   ls      the date column of `ls -l` (devtmpfs stamps a node with the
#           time it was made; PAX's /dev is the kernel's own, its times 0:
#           a named drift), folded to `DATE` on both sides;
#   ioctl   (any section's `ioctl` lines: the ioctl section's and the
#           gpt session's table) BLKSECTGET, BLKRAGET and BLKFRAGET,
#           which the guest answers
#           (its request queue's limit and its read-ahead, tunables of
#           its block layer, no fact of the device) and PAX refuses by
#           name: PAX's line must be `-25 ENOTTY` with the buffer
#           untouched; docs/CENSUS.md names them.
#
#   compare PAX.session GUEST.session SECTION...
#
# Prints `PASS <section>: <n> lines` or `FAIL <section>: …` with the
# first differences, for each SECTION asked (or every one the guest has
# when none is), and exits 0 when each holds, 1 otherwise.
import re
import sys

REFUSED = ("BLKSECTGET", "BLKRAGET", "BLKFRAGET")


def sections(path):
    out, cur = {}, None
    for l in open(path, encoding="utf-8", errors="surrogateescape").read().split("\n"):
        m = re.match(r"^== (\S+)$", l)
        if m:
            cur = m.group(1)
            out.setdefault(cur, [])
            continue
        if cur is not None:
            out[cur].append(l)
    for k in out:
        while out[k] and out[k][-1] == "":
            out[k].pop()
    return out


def fold_ls(l):
    # boreutils' `ls -l`: mode links owner group (size | major, minor) date name
    return re.sub(r"^(\S+\s+\d+\s+\S+\s+\S+\s+(?:\d+,\s+)?\d+) +[A-Z][a-z]{2} +\d{1,2} +(?:\d{1,2}:\d{2}|\d{4}) (.*)$", r"\1 DATE \2", l)


def want_pax(sec, gl):
    """The guest's line as PAX must print it."""
    if sec == "ls":
        return fold_ls(gl)
    if gl.startswith("ioctl "):
        m = re.match(r"^ioctl (\S+): ", gl)
        if m and m.group(1) in REFUSED:
            width = len(gl.split(" bytes ")[1]) if " bytes " in gl else 16
            return "ioctl %s: -25 ENOTTY bytes %s" % (m.group(1), "a5" * (width // 2))
    return gl


def main(argv):
    if len(argv) < 3:
        sys.stderr.write("usage: compare PAX.session GUEST.session [SECTION...]\n")
        return 2
    p, g = sections(argv[1]), sections(argv[2])
    names = argv[3:] or [k for k in g]
    ok = True
    for sec in names:
        gl = [want_pax(sec, l) for l in g.get(sec, [])]
        pl = [fold_ls(l) if sec == "ls" else l for l in p.get(sec, [])]
        if sec not in g:
            print("FAIL %s: the guest's session has no such section" % sec)
            ok = False
            continue
        if sec not in p:
            print("FAIL %s: PAX's session has no such section" % sec)
            ok = False
            continue
        if gl == pl:
            n = sum(1 for l in g[sec] if re.match(r"^ioctl (%s): 0 " % "|".join(REFUSED), l))
            drift = " (%d named refusals: %s)" % (n, ", ".join(REFUSED)) if n else ""
            if sec == "ls":
                drift = " (the date folded)"
            print("PASS %s: %d lines, the guest's%s" % (sec, len(pl), drift))
            continue
        ok = False
        diffs = []
        for i in range(max(len(gl), len(pl))):
            a = gl[i] if i < len(gl) else "<none>"
            b = pl[i] if i < len(pl) else "<none>"
            if a != b:
                diffs.append("line %d: guest '%s' | PAX '%s'" % (i + 1, a, b))
            if len(diffs) == 6:
                break
        print("FAIL %s: %d lines against the guest's %d; %s" % (sec, len(pl), len(gl), "; ".join(diffs)))
    return 0 if ok else 1


sys.exit(main(sys.argv))
