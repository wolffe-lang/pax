#!/usr/bin/env bash
# tests/mpx5-burrowd — burrowd, burrow's ssh server, on PAX, started at boot
# (px112, burrow's B6), reached from another machine on a LAN: the rig's
# own network namespace, a tap the guest leases its address on from
# dnsmasq, and the rig's OpenSSH ssh and git (the image's packages, pinned
# by its package list), as a machine on the LAN would.
#
#   tests/mpx5-burrowd [--images DIR | --no-boot] [--firmware bios|uefi|both]
#                      [--tier native|release|both] [--accel auto|kvm|tcg]
#
# P0 builds the image's tree (build/mpx5-burrowd/root, files.txt as
# tools/mkinitramfs' arguments): kmain_console, the kernel every shipped
# image boots, with `quiet`; the installed system's run list (/bin/login as
# pid 1, user/login built by tools/mkauth with /bin/passwd); pelt as /bin/sh;
# boreutils' cat chmod env head id kill ls mkdir rm sleep stty tty yes (head
# and yes for px130's B40); den as the images
# install it (tools/install-den: /bin/git, /bin/git-upload-pack,
# /bin/git-receive-pack); burrow's three programs (tools/mkburrow,
# tools/install-burrow: /bin/ssh, /bin/burrow-keygen, /bin/burrowd);
# /etc/pax-boot.d/burrowd as the images ship it (user/pax-boot.d); (px116)
# /etc/shrc and /etc/burrowd/burrowd_config as the dev image has them,
# tools/system-env's (the configuration's SetEnv line /etc/shrc's exports),
# and the dev compiler, /usr/bin/wolf and
# /usr/share/wolf/compiler-std (tools/mkwolf and tools/mkwolf-std, or
# PAX_DEV_WOLF_DIR and PAX_DEV_STD_DIR, held to user/wolf.sums and
# user/wolf.pin), and lupin's std at /usr/share/wolf/std (tools/fetch-std,
# user/std.pin); an /etc/passwd with root, pax, lobo
# and the worker's account burrowd; /etc/pax-net `dhcp wait=10`; an
# /etc/fstab that mounts the run's own small ext2 volume (label
# px112-keys) on /etc/burrowd, write-through, so a second boot of the same
# volume finds the first boot's host key. A piece the tree cannot build is
# named at P0 and left out, so the rows that need it fail by name.
#
# The rows (tests/mpx5-burrowd.d/rows.py's header has each), on every tier
# and firmware asked: B0 the image and its /etc/shadow (made at run time:
# passwords from Python's secrets, hashed by tools/mkauth's mkshadow on its
# standard input, never written to a file, an argument vector, a log or a
# record); B1 the first boot's host key, its fingerprint on the console
# and the key the rig's ssh is shown; B2 commands with pax's key, held byte
# for byte to the same through the rig's own sshd on Linux; B3 the same
# with pax's password; B4 `id` in the session; B5 the refusals (a wrong
# password, root by key and by password, an unlisted key, a locked
# account, a world-writable ~/.ssh); B6 an exit status and a signal; B7 git
# clone, push and clone again through burrowd and den, held to the same
# through sshd and git; B8 the listener killed at the console and a login
# working again; B9 the log at the console; B10 a second boot keeps the
# host key; B18 (px116, pax#334) a command over ssh has the variables
# /etc/shrc exports for the console, held to the rig's sshd given the same
# SetEnv line, and `wolf build` of a program that calls std.fs succeeds
# with no `. /etc/shrc;` before it; B19-B27 (px123) a terminal over ssh:
# `ssh host` at a terminal gets a pty and the prompt, `tty` a /dev/pts/N, the
# window size and a resize, Ctrl-C, Ctrl-\ and Ctrl-Z reaching a foreground
# program, a bare sudo asking on that session, the pty given back after, and
# burrowd itself with SIGINT and SIGQUIT at their defaults; B40-B43 (px130)
# the kernel's log at an installed console: a writer killed by SIGPIPE over
# ssh leaves the console's screen as it was and its line on the serial port
# and in the ring, root's dmesg shows it with its time, pax's is refused,
# and a warning written to /dev/kmsg is still drawn while an info line is
# not; B28 (pax#368)
# that session ran /etc/shrc (lope's hook: autocd takes a bare `../`, `g`
# is a function); B29 a command over ssh still reads no ENV (not
# interactive); B11 the live stick's shape (the live
# entry as pid 1, the shipped configuration's loopback): a connection from
# the LAN refused, one on loopback answered. B1-B10 boot the installed shape (/bin/login,
# the volume's configuration the installer's, `ListenAddress 0.0.0.0`).
#
# Needs root in the rig (the tap, dnsmasq) or `sudo -n`, /dev/net/tun,
# ip(8), dnsmasq(8), mke2fs, ssh, ssh-keygen, sshd and git:
# SKIPPED LOUDLY without them unless PAX_REQUIRE_BURROWD_RIG=1, when it is a
# failure. The UEFI leg needs OVMF (PAX_REQUIRE_UEFI=1: a failure without
# it). Exit 0 when every row held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"

images= legs=both tiers=both noboot=0 accel=auto
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        --accel)    accel=$2; shift 2 ;;
        *)          die "usage: tests/mpx5-burrowd [--images DIR | --no-boot] [--firmware bios|uefi|both] [--tier native|release|both] [--accel auto|kvm|tcg]" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac

BORE="cat chmod env head id kill ls mkdir rm sleep stty tty yes"
work=$PAX_BUILD/mpx5-burrowd
fail=0
need python3 readelf

static_ok() {
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf" git gcc
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/bin" "$r/etc/burrowd" "$r/etc/pax-boot.d" "$r/var/log" "$r/var/run" "$r/home/pax" "$work/tools"
    why= missing=
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" 2>&1 || why+=" tools/mkpelt;"
    cp "$work/pelt/pelt" "$r/bin/pelt" 2>/dev/null && cp "$work/pelt/pelt" "$r/bin/sh" || why+=" no pelt;"
    # pax#368: lope as the dev image has it (user/lope.pin, tools/mklope): /etc/shrc's hook, which a
    # session over ssh at a terminal runs (B28).
    "$PAX_ROOT/tools/mklope" "$work/lope" > "$work/lope.txt" 2>&1 || why+=" tools/mklope;"
    cp "$work/lope/lope" "$r/bin/lope" 2>/dev/null || why+=" no lope;"
    "$PAX_ROOT/tools/mkden" "$work/den" > "$work/den.txt" 2>&1 || why+=" tools/mkden;"
    "$PAX_ROOT/tools/install-den" "$work/den" "$r" > "$work/install-den.txt" 2>&1 || why+=" tools/install-den;"
    # shellcheck disable=SC2086 # the utilities' names, one word each
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE > "$work/bore.txt" 2>&1 || why+=" tools/mkboreutils;"
    for u in $BORE; do cp "$work/bore/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"; done
    # login and passwd as the installed system has them; mkshadow, the
    # test helper, beside the tree (never in the image).
    "$PAX_ROOT/tools/mkauth" "$work/auth" login passwd sudo mkshadow > "$work/auth.txt" 2>&1 || why+=" tools/mkauth;"
    # px130: dmesg as the images ship it (tools/mkdmesg; B41, B42). A tree without it names it
    # missing, and the rows that read the log fail by name.
    if [ -x "$PAX_ROOT/tools/mkdmesg" ] && "$PAX_ROOT/tools/mkdmesg" "$work/dmesg" > "$work/dmesg.txt" 2>&1; then
        cp "$work/dmesg/dmesg" "$r/bin/dmesg" || why+=" no dmesg;"
    else
        missing+=" /bin/dmesg (tools/mkdmesg)"
    fi
    for p in login passwd sudo; do cp "$work/auth/$p" "$r/bin/$p" 2>/dev/null || why+=" no $p;"; done
    # sudo and its policy as the images ship them (B15: a bare sudo over ssh; B16: sudo -k -S, and a plain -S measured), pax in group sudo.
    cp "$PAX_ROOT/user/sudo/sudoers" "$r/etc/sudoers" 2>/dev/null || why+=" no user/sudo/sudoers;"
    cp "$work/auth/mkshadow" "$work/tools/mkshadow" 2>/dev/null || why+=" no mkshadow;"
    # B17 (pax#340): the stack segment ring 3 holds after a system call and
    # after interrupts taken in ring 3, a static program of the suite's own.
    gcc -static -no-pie -O2 -Wall -Wextra -D_GNU_SOURCE -Wl,--build-id=none -Wl,-z,noexecstack \
        -o "$r/bin/sysret-ss" "$PAX_ROOT/tests/mpx5-burrowd.d/sysret-ss.c" > "$work/sysret-ss.txt" 2>&1 || why+=" gcc: sysret-ss;"
    # burrow: /bin/ssh, /bin/burrow-keygen and, since px112, /bin/burrowd.
    "$PAX_ROOT/tools/mkburrow" "$work/burrow" > "$work/burrow.txt" 2>&1 || why+=" tools/mkburrow;"
    "$PAX_ROOT/tools/install-burrow" "$work/burrow" "$r" >> "$work/burrow.txt" 2>&1 || why+=" tools/install-burrow;"
    [ -x "$r/bin/burrowd" ] || missing+=" /bin/burrowd (tools/mkburrow and tools/install-burrow carry no server)"
    # The shipped files, from user/, never copied by hand.
    for f in pax-boot.d/burrowd:etc/pax-boot.d/burrowd; do
        if [ -f "$PAX_ROOT/user/${f%%:*}" ]; then cp -p "$PAX_ROOT/user/${f%%:*}" "$r/${f#*:}"; else missing+=" /${f#*:} (no user/${f%%:*})"; fi
    done
    # px116 (pax#334): /etc/shrc and burrowd_config as the dev image has them, from the one list
    # the distribution's root is written from too (tools/system-env): the configuration's SetEnv
    # line is the variables /etc/shrc exports for the console, every one but PATH (B18).
    python3 -I "$PAX_ROOT/tools/system-env" shrc dev > "$r/etc/shrc" || why+=" tools/system-env shrc;"
    python3 -I "$PAX_ROOT/tools/system-env" burrowd-config "$r/etc/shrc" > "$r/etc/burrowd/burrowd_config" \
        || why+=" tools/system-env burrowd-config;"
    # px116: the dev image's compiler and its own std where the distribution's root has them
    # (/usr/bin/wolf and wolf-cimport-worker, held to user/wolf.sums; /usr/share/wolf/compiler-std,
    # its STD-REV user/wolf.pin's), so B18 builds over ssh what the console builds. No native link
    # stack (the base payload's; the wolf suite's fast root has none either): B18 builds an object.
    # tools/mkwolf and tools/mkwolf-std make them, or PAX_DEV_WOLF_DIR and PAX_DEV_STD_DIR name
    # copies already made (each held to the pins here all the same).
    wolf_pin=$(. "$PAX_ROOT/user/wolf.pin" && printf '%s' "$WOLF_STD_REV")
    wolfdir=${PAX_DEV_WOLF_DIR:-$work/wolf}
    if [ -z "${PAX_DEV_WOLF_DIR:-}" ]; then
        "$PAX_ROOT/tools/mkwolf" "$wolfdir" > "$work/wolf.txt" 2>&1 || say "tools/mkwolf failed: $(tail -n 3 "$work/wolf.txt")"
    fi
    held_wolf=1
    while read -r name digest size; do
        [ -f "$wolfdir/$name" ] && [ "$(sha256_of "$wolfdir/$name")" = "$digest" ] \
            && [ "$(wc -c < "$wolfdir/$name" | tr -d ' ')" = "$size" ] || held_wolf=0
    done < "$PAX_ROOT/user/wolf.sums"
    if [ "$held_wolf" = 1 ]; then
        mkdir -p "$r/usr/bin"
        for f in wolf wolf-cimport-worker; do cp "$wolfdir/$f" "$r/usr/bin/$f" && chmod 755 "$r/usr/bin/$f"; done
    else
        missing+=" /usr/bin/wolf (no compiler held to user/wolf.sums in $wolfdir)"
    fi
    stddir=${PAX_DEV_STD_DIR:-$work/wolf-std}
    if [ -z "${PAX_DEV_STD_DIR:-}" ]; then
        "$PAX_ROOT/tools/mkwolf-std" "$stddir" > "$work/wolf-std.txt" 2>&1 || say "tools/mkwolf-std failed: $(tail -n 3 "$work/wolf-std.txt")"
    fi
    if [ "$(cat "$stddir/STD-REV" 2>/dev/null)" = "$wolf_pin" ]; then
        mkdir -p "$r/usr/share/wolf/compiler-std"
        cp -R "$stddir/." "$r/usr/share/wolf/compiler-std/"
    else
        missing+=" /usr/share/wolf/compiler-std (no std at user/wolf.pin's $wolf_pin in $stddir)"
    fi
    # lupin's std where both images have it, /usr/share/wolf/std (user/std.pin's, tools/fetch-std):
    # the other standard library a compiler run with no WOLF_STD can resolve, as pax#334 found.
    if "$PAX_ROOT/tools/fetch-std" "$work/base-std" > "$work/base-std.txt" 2>&1; then
        mkdir -p "$r/usr/share/wolf/std"
        cp -R "$work/base-std/std/." "$r/usr/share/wolf/std/"
    else
        missing+=" /usr/share/wolf/std (tools/fetch-std: $(tail -n 1 "$work/base-std.txt"))"
    fi
    printf 'root:x:0:0:root:/root:/bin/sh\npax:x:1000:1000:pax:/home/pax:/bin/sh\nlobo:x:990:990:lobo:/srv/lobo:/bin/false\nburrowd:x:989:989:burrowd:/nonexistent:/bin/false\n' > "$r/etc/passwd"
    printf 'root:x:0:\npax:x:1000:\nlobo:x:990:\nburrowd:x:989:\nsudo:x:27:pax\n' > "$r/etc/group"
    printf 'LABEL=px112-keys /etc/burrowd ext2 sync 0 0\n' > "$r/etc/fstab"
    printf '/bin/login\n' > "$r/etc/pax-run"
    printf 'dhcp wait=10\n' > "$r/etc/pax-net"
    printf 'pax\n' > "$r/etc/hostname"
    "$PAX_ROOT/tools/mkzone" "$r/etc/localtime" > "$work/zone.txt" 2>&1 || why+=" tools/mkzone;"
    # The archive's arguments, one a line: the tree, root's unless said
    # (pax's home and what is in it are pax's).
    : > "$work/files.txt"
    printf '%s\n' /tmp/:1777 /root/:700 /run/:755 /home/:755 /home/pax/:755:1000:1000 /var/:755 /var/log/:755 \
        /var/run/:755 /etc/burrowd/:755 /etc/pax-boot.d/:755 >> "$work/files.txt"
    (cd "$r" && find . -mindepth 1 \( -type f -o -type l \) | sort) | while IFS= read -r f; do
        f=${f#./}
        if [ -L "$r/$f" ]; then
            printf '/%s->%s\n' "$f" "$(readlink "$r/$f")"
        else
            m=644; [ -x "$r/$f" ] && m=755
            printf '/%s=%s:%s\n' "$f" "$r/$f" "$m"
        fi
    done >> "$work/files.txt"
    # sudo set-user-ID root and its policy root's 0440, as the images have them (the distribution's root;
    # named in prose: the planner reads a path here as one this suite runs).
    sed -i -e 's#^\(/bin/sudo=.*\):755$#\1:4755#' -e 's#^\(/etc/sudoers=.*\):644$#\1:440#' "$work/files.txt"
    for f in "$r"/bin/*; do
        [ -L "$f" ] && { say "  program: ${f#"$r"/} -> $(readlink "$f")"; continue; }
        case $(head -c 2 "$f") in '#!') say "  script: ${f#"$r"/} $(sha256_of "$f")"; continue ;; esac
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    for f in usr/bin/wolf usr/bin/wolf-cimport-worker; do
        [ -f "$r/$f" ] || continue
        x=$(static_ok "$r/$f") || why+=" $x;"
        say "  program: $f $(sha256_of "$r/$f") $(wc -c < "$r/$f" | tr -d ' ') bytes"
    done
    for f in etc/shrc etc/burrowd/burrowd_config etc/pax-boot.d/burrowd; do
        [ -f "$r/$f" ] && say "  file: /$f $(sha256_of "$r/$f") $(wc -c < "$r/$f" | tr -d ' ') bytes"
    done
    git -C "$PAX_ROOT" rev-parse HEAD > "$work/tree.commit" 2>/dev/null || true
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            [ "$elf" = "$work/$tier/kmain_console.elf" ] || cp "$elf" "$work/$tier/kmain_console.elf"
            say "built $tier kmain_console: elf $(sha256_of "$elf"), $(wc -c < "$elf" | tr -d ' ') bytes"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    printf '%s\n' "${missing# }" > "$work/missing.txt"
    if [ -n "$missing" ]; then
        say "P0 the tree builds no$missing: left out of the image; the rows that need them fail by name"
    fi
    if [ -n "$why" ]; then
        say "FAIL P0 build:$why"
        exit 1
    fi
    say "P0 PASS build: kmain_console, the image's programs static, the image's tree (build/mpx5-burrowd/files.txt)"
    images=$work
fi
[ "$noboot" = 1 ] && exit 0

out=$PAX_BUILD/mpx5-burrowd-runs
mkdir -p "$out"
ran=0 skipped=0
for tier in $tiers; do
    elf=$images/$tier/kmain_console.elf
    [ -f "$elf" ] || { say "FAIL P1 $tier: no $elf"; fail=1; continue; }
    for leg in $legs; do
        if [ "$leg" = uefi ] && [ -z "$(find_ovmf 2>/dev/null)" ]; then
            if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then say "FAIL $tier uefi: no OVMF"; fail=1; else say "SKIPPED LOUDLY $tier uefi: no OVMF"; fi
            continue
        fi
        say "boots: $tier $leg"
        rc=0
        python3 -I "$here/mpx5-burrowd.d/rows.py" --images "$images" --elf "$elf" --tier "$tier" --leg "$leg" \
            --accel "$accel" --out "$out/$tier-$leg" || rc=$?
        case $rc in
            0) ran=$((ran + 1)) ;;
            3)
                if [ "${PAX_REQUIRE_BURROWD_RIG:-0}" = 1 ]; then
                    say "FAIL $tier $leg: the rig cannot run here, and PAX_REQUIRE_BURROWD_RIG=1"; fail=1
                else
                    say "SKIPPED LOUDLY $tier $leg: the rig cannot run here"; skipped=$((skipped + 1))
                fi ;;
            *) fail=1; ran=$((ran + 1)) ;;
        esac
    done
done
say "mpx5-burrowd: $ran legs, $skipped skipped"
exit $fail
