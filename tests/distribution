#!/usr/bin/env python3
"""Check the actual packed image, not just the metadata generator.
Usage: tests/distribution INITRAMFS KERNEL INPUTS IDENTITY_DIRECTORY dev|release
"""
from pathlib import Path
import hashlib
import sys

ROOT = Path(__file__).resolve().parents[1]
cpio, kernel, inputs, identity = map(Path, sys.argv[1:5])
variant = sys.argv[5]
def check(blob):
    rows = {}
    o = 0
    while True:
        header = blob[o:o+110]
        assert header[:6] == b'070701', 'image-newc-header'
        fields = [int(header[i:i+8], 16) for i in range(6, 110, 8)]
        name = blob[o+110:o+110+fields[11]-1].decode()
        start = (o+110+fields[11]+3) & ~3
        data = blob[start:start+fields[6]]
        assert len(data) == fields[6], 'image-short-entry'
        o = (start+fields[6]+3) & ~3
        if name == 'TRAILER!!!':
            break
        assert name not in rows, 'image-duplicate-' + name
        rows[name] = (fields, data)
    assert not blob[o:].strip(b'\0'), 'image-trailing-data'
    sha = lambda b: hashlib.sha256(b).hexdigest()
    release = rows['etc/pax-release'][1]
    assert release == (identity / 'pax-release').read_bytes(), 'image-release-pins'
    release_rows = {line.split()[0]: line.split()[1:] for line in release.decode().splitlines()}
    assert release_rows['kernel'][1] == sha(kernel.read_bytes()), 'image-kernel'
    assert rows['etc/pax-banner'][1] == (identity / 'pax-banner').read_bytes(), 'image-banner'
    assert sha(release)[:8].encode() in rows['etc/pax-banner'][1], 'image-banner-digest'
    assert rows['bin/pax-release'][0][1] == 0o100755, 'image-release-command'
    for line in rows['etc/pax-files.sha256'][1].decode().splitlines():
        digest, name = line.split('  ', 1)
        assert sha(rows[name][1]) == digest, 'image-file-digest-' + name
    expected = {name for name, (fields, _) in rows.items() if fields[1] & 0o170000 != 0o040000}
    listed = {line.split('  ', 1)[1] for line in rows['etc/pax-files.sha256'][1].decode().splitlines()}
    assert listed == expected - {'etc/pax-files.sha256'}, 'image-file-inventory'
    for game in ('pack', 'cub', 'trail'):
        for dest, source in ((game, game), ('source.tar.gz', game+'.source.tar.gz'), ('engine.source.tar.gz', game+'.engine.source.tar.gz')):
            fields, data = rows[f'home/pax/Games/{game}/{dest}']
            assert data == (inputs / 'games' / source).read_bytes(), 'image-game-' + game
            assert fields[2:4] == [1000, 1000], 'image-game-owner-' + game
        assert rows[f'home/pax/Games/{game}/{game}'][0][1] == 0o100755
    for source in (inputs / 'base-std/std').rglob('*'):
        if source.is_file():
            assert rows['usr/share/wolf/std/'+source.relative_to(inputs/'base-std/std').as_posix()][1] == source.read_bytes(), 'image-base-std'
    assert rows['bin/lupin'][1] == (inputs/'lupin/lupin').read_bytes(), 'image-published-lupin'
    assert rows['bin/lobo'][0][1] == 0o100755, 'image-lobo'
    # px103: sudo, set-user-ID root (04755, the mode survives the archive), its policy 0440 root's, and
    # /var/log for its log; the bytes are user/sudo/sudoers'. px106: sudo, su and passwd 04755, login
    # 0755, all root's, each the bytes tools/mkauth built into INPUTS/auth and held to its sums; no
    # image ships /etc/shadow (R1: no password in any image; R-px106-2: login's first-boot rule).
    sums = {l.split()[0]: l.split()[1:3] for l in (inputs/'auth'/'sums.txt').read_text().splitlines() if l.strip()}
    for name, mode in (('sudo', 0o104755), ('su', 0o104755), ('passwd', 0o104755), ('login', 0o100755)):
        assert 'bin/'+name in rows, 'image-'+name+'-missing'
        assert rows['bin/'+name][0][1] == mode and rows['bin/'+name][0][2:4] == [0, 0], 'image-'+name+'-mode'
        assert rows['bin/'+name][1] == (inputs/'auth'/name).read_bytes(), 'image-'+name+'-bytes'
        assert [sha(rows['bin/'+name][1]), str(len(rows['bin/'+name][1]))] == sums.get(name), 'image-'+name+'-sums'
    assert 'etc/shadow' not in rows, 'image-shadow-present'
    assert not any(n.startswith('etc/shadow.') for n in rows), 'image-shadow-scratch'
    assert rows['etc/pax-run'][1] == b'/bin/env ENV=/etc/shrc /bin/sh -i -m\n', 'image-pax-run'
    assert 'etc/sudoers' in rows, 'image-sudoers-missing'
    assert rows['etc/sudoers'][0][1] == 0o100440 and rows['etc/sudoers'][0][2:4] == [0, 0], 'image-sudoers-mode'
    assert rows['etc/sudoers'][1] == (ROOT/'user/sudo/sudoers').read_bytes(), 'image-sudoers-bytes'
    assert 'var/log' in rows and rows['var/log'][0][1] == 0o40755 and rows['var/log'][0][2:4] == [0, 0], 'image-var-log'
    assert 'var/log/sudo.log' not in rows, 'image-no-sudo-log'
    # px90: den byte for byte as tools/mkden built it (never stripped), 0755,
    # and git a symbolic link to it, not a copy.
    den = inputs/'den'/'den'
    assert rows['bin/den'][1] == den.read_bytes(), 'image-den-bytes'
    assert (sha(rows['bin/den'][1]) + ' ' + str(len(rows['bin/den'][1]))) == ' '.join(
        (inputs/'den'/'sums.txt').read_text().split()[1:3]), 'image-den-sums'
    assert rows['bin/den'][0][1] == 0o100755 and rows['bin/den'][0][2:4] == [0, 0], 'image-den-mode'
    assert rows['bin/git'][0][1] == 0o120777 and rows['bin/git'][1] == b'den', 'image-git-link'
    # px104 (R-px104-5, amending px100's R-px100-1): den's service wrappers,
    # user/den's bytes, 0755, root's, on PATH under git's names; /etc/shrc
    # names no service program, and nothing is left under /usr/libexec/den.
    for n in ('upload-pack', 'receive-pack'):
        assert rows['bin/git-'+n][1] == (ROOT/'user/den'/n).read_bytes(), 'image-den-'+n
        assert rows['bin/git-'+n][0][1] == 0o100755 and rows['bin/git-'+n][0][2:4] == [0, 0], 'image-den-'+n+'-mode'
    assert not any(name.startswith('usr/libexec/den/') for name in rows), 'image-den-libexec'
    shrc = rows['etc/shrc'][1].decode().splitlines()
    assert not any(line.startswith(('export DEN_UPLOAD_PACK=', 'export DEN_RECEIVE_PACK=')) for line in shrc), 'image-shrc-den'
    # px104: burrow as /bin/ssh and /bin/burrow-keygen, byte for byte as
    # tools/mkburrow built them (never stripped), 0755, root's.
    for name, built in (('ssh', 'burrow'), ('burrow-keygen', 'burrow-keygen'), ('burrowd', 'burrowd')):
        data = (inputs/'burrow'/built).read_bytes()
        assert rows['bin/'+name][1] == data, 'image-burrow-'+name
        assert rows['bin/'+name][0][1] == 0o100755 and rows['bin/'+name][0][2:4] == [0, 0], 'image-burrow-'+name+'-mode'
        assert any(line.split()[:2] == [built, sha(data)] for line in (inputs/'burrow'/'sums.txt').read_text().splitlines()), 'image-burrow-sums-'+name
    # px112: burrowd's configuration and boot hook, user/'s bytes, root's
    # (the hook 0755, the configuration 0644), its worker's account in
    # passwd and group, and no host key: each machine makes its own.
    for path, user, mode in (('etc/burrowd/burrowd_config', 'burrowd/burrowd_config', 0o100644),
                             ('etc/pax-boot.d/burrowd', 'pax-boot.d/burrowd', 0o100755)):
        assert rows[path][1] == (ROOT/'user'/user).read_bytes(), 'image-'+user
        assert rows[path][0][1] == mode and rows[path][0][2:4] == [0, 0], 'image-'+user+'-mode'
    assert b'\nburrowd:x:989:989:burrowd:/nonexistent:/bin/false\n' in b'\n' + rows['etc/passwd'][1], 'image-burrowd-account'
    assert b'\nburrowd:x:989:\n' in b'\n' + rows['etc/group'][1], 'image-burrowd-group'
    assert not any(n.startswith('etc/burrowd/ssh_host_') for n in rows), 'image-burrowd-no-host-key'
    # px104 (R-px104-2): the root set den's TLS reads, tools/mkroots' bytes,
    # 0644, and /etc/shrc naming it; GitHub's published host key for ssh.
    assert rows['etc/ssl/certs/ca-roots.der'][1] == (inputs/'roots'/'ca-roots.der').read_bytes(), 'image-roots'
    assert rows['etc/ssl/certs/ca-roots.der'][0][1] == 0o100644, 'image-roots-mode'
    assert 'export DEN_TLS_ROOTS=/etc/ssl/certs/ca-roots.der' in shrc, 'image-shrc-roots'
    for path, user in (('etc/ssh/ssh_known_hosts', 'ssh_known_hosts'),):
        assert rows[path][1] == (ROOT/'user'/user).read_bytes(), 'image-'+user
        assert rows[path][0][1] == 0o100644 and rows[path][0][2:4] == [0, 0], 'image-'+user+'-mode'
    # px90 (R-px90-2): den's zone, the bytes of /etc/localtime.
    assert rows['usr/share/zoneinfo/UTC'][1] == rows['etc/localtime'][1] and len(rows['etc/localtime'][1]) == 114, 'image-zoneinfo-utc'
    assert rows['usr/share/zoneinfo/UTC'][0][1] == 0o100644, 'image-zoneinfo-mode'
    assert rows['etc/pax-live'][1] == b'pax-live-games-v1\n', 'image-live-marker'
    # px105: /etc/pax-net, user/pax-net's bytes, 0644, root's: the console takes a lease.
    assert 'etc/pax-net' in rows and rows['etc/pax-net'][1] == (ROOT/'user/pax-net').read_bytes(), 'image-pax-net'
    assert rows['etc/pax-net'][0][1] == 0o100644 and rows['etc/pax-net'][0][2:4] == [0, 0], 'image-pax-net-mode'
    for name in ('pax-install', 'paxgpt', 'paxfat', 'paxext2', 'limine', 'reboot', 'poweroff'):
        assert rows['bin/'+name][0][1] == 0o100755, 'image-installer-mode-'+name
    assert rows['bin/poweroff'][1] == rows['bin/reboot'][1], 'image-poweroff-is-reboot'  # px87 (pax#243)
    for line in rows['usr/share/pax-install/boot.sha256'][1].decode().splitlines():
        digest, path = line.split()
        assert sha(rows[path.lstrip('/')][1]) == digest, 'image-installer-boot-'+path
    for game in ('pack', 'cub', 'trail'):
        for suffix in ('', '.source.tar.gz', '.engine.source.tar.gz'):
            name = game+suffix
            assert rows['usr/share/pax-install/games/'+name][1] == (inputs/'games'/name).read_bytes(), 'image-installer-game-'+name
    assert ('usr/bin/wolf' in rows) == (variant == 'dev'), 'image-variant'
    if variant == 'dev':
        assert 'usr/bin/ld.lld' in rows and 'usr/share/wolf/compiler-std/STD-REV' in rows, 'image-dev-stack'
    return release, len(listed)

blob = cpio.read_bytes()
release, count = check(blob)
print(f"I0 PASS actual {variant} initramfs: identity, {count} file digests, games/source/owners, base std, den and its git link, den's service wrappers on PATH, burrow as ssh, burrowd and its hook, configuration and account, the root set and /etc/shrc's DEN_TLS_ROOTS, ssh_known_hosts, sudo and its policy, su, passwd and login, no /etc/shadow, /etc/pax-net, and variant")
bad = bytearray(blob)
position = blob.find(release)
assert position >= 0
bad[position] ^= 1
try:
    check(bytes(bad))
except AssertionError as error:
    assert str(error) == 'image-release-pins', error
    print('I1 PASS actual-image release corruption rejected by name')
else:
    raise AssertionError('actual-image corruption accepted')
