clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/fpu.S -o @OUT/kmain_console.asm-fpu.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/io.S -o @OUT/kmain_console.asm-io.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/isr.S -o @OUT/kmain_console.asm-isr.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/net.S -o @OUT/kmain_console.asm-net.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/sched.S -o @OUT/kmain_console.asm-sched.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/screen.S -o @OUT/kmain_console.asm-screen.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/sound.S -o @OUT/kmain_console.asm-sound.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/speaker.S -o @OUT/kmain_console.asm-speaker.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/tree.S -o @OUT/kmain_console.asm-tree.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/unix.S -o @OUT/kmain_console.asm-unix.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../boot/user.S -o @OUT/kmain_console.asm-user.o 
clang	assembly	--target=x86_64-unknown-none-elf -c ../user/programs.S -o @OUT/kmain_console.asm-programs.o 
wolf	other	build kmain_console.lu --target x86_64-unknown-none --emit=obj -o @OUT/kmain_console.o 
