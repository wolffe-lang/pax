#!/usr/bin/env bash
# tests/mpx5-lope — px54 (ruling #91 R4): lope, the directory jumper in
# wolf (user/lope.pin, tools/mklope), preinstalled on PAX, and its
# no-prefix jump at the console through pelt's command_not_found_handle
# (sh21, user/pelt.pin). The console shell runs lope's hook before its
# first prompt: /etc/pax-run's `/bin/env ENV=/etc/shrc /bin/sh -i -m`,
# /etc/shrc's `eval "$(lope init pelt)"` (user/shrc; pelt runs $ENV's
# file, POSIX XCU 2.5.3), with the kernel's HOME=/ and no XDG variable,
# so root's store is /.local/share/lope/store in PAX's in-memory tree.
#
#   tests/mpx5-lope [--images DIR | --no-boot | --only build | --only linux --images DIR]
#                   [--firmware bios|uefi|both] [--tier native|release|both]
#
# One image, kmain_console with the archive: pelt as /bin/pelt and
# /bin/sh, /bin/lope, boreutils' env, ls and true (user/boreutils.pin),
# /bin/as, /etc/shrc, /etc/pax-run, /home/pax (0755, 1000:1000). Its run
# list, one typed session a run (user/console/lope.keys, typed twice),
# prompt `$ `:
#   lope       `/bin/env ENV=/etc/shrc /bin/sh -i -m` (root, HOME=/);
#   lope-user  `/bin/as 1000 1000 /bin/env HOME=/home/pax ENV=/etc/shrc
#              /bin/sh -i -m` (`pax`, the home `su pax` gives: `as` keeps
#              HOME=/, under which a user cannot make /.local).
# The keys: `cd /etc`, `cd /bin`, `lope list`; `etc` alone, `pwd`; `g
# -`; `ls`; `g` alone, `pwd`; `gi`, then `2` at its numbered menu (no fzf
# on PAX), `pwd`; `true`, `zzqqxx` (no match: 127); `exec sh -i -m` (a
# second shell, the first gone), `lope list` (the store the first
# wrote), `bin`, `pwd`; `exit`.
#
# **The Linux side** is the same binaries typed the same keys in a
# throwaway container (tools/linux-tree: the tree a tmpfs, the shell on
# a pseudo-terminal as pid 1 of a fresh pid namespace, PAX's
# environment), as root and through `as 1000 1000`, run live.
#
# What is compared, by rule: each run's transcript, from its `run <k>:`
# line to the kernel's `user: frames free` line after it, normalised as a
# serial log is (tools/lib.sh's serial_norm), the kernel's own `user: …`
# lines out; the container's whole transcript, normalised the same way.
#
# Assertions, per tier, firmware and session:
#   L0 build: kmain_console built; pelt, lope, env, ls, true and as
#      static; the image built; the container's two sessions ran.
#   L1 each session byte-identical to the container's, and its status.
#   L2 the jump rows, each a run of lines in the transcript, in order:
#      `etc` alone lands in /etc; `g -` prints /bin; `ls` runs bare and
#      lists /bin; `g` alone lands in $HOME; `gi`'s menu `1) /bin`, `2)
#      /etc`, `3) $HOME`, `lope: which? `, and `2` lands in /etc; `true`
#      runs (st=0); `zzqqxx` is pelt's `not found`, st=127; the second
#      shell's `bin` lands in /bin.
#   L3 the store rows: written in the first shell (`lope list` after the
#      two `cd`s is /bin, /etc) and read in the second, after the first
#      is gone (/etc, /bin, $HOME: every visit the first shell made).
#   L4 -ENOSYS only for set_robust_list (273) and rseq (334); no
#      `refused:` line; `PAX: init /bin/env ended with status 0; nothing
#      left to run`, `halt`, held halted.
# L2 and L3 are each run's own witness: the container runs the same
# image, so a break of both sides (the hook gone, the store unwritable)
# leaves L1 green and turns these.
#
# The menu's digit is typed a pause after `gi` (it has no `$ ` to wait
# for: tools/qemu-halt's PAX_TYPE_PAUSE, 2 s, on PAX; tools/linux-tty's
# 1.5 s in the container). Measured on kasumi under TCG and load: the
# transcripts are the same with the digit typed 0.2, 0.5, 1, 1.5, 2 or 3
# s after `gi` (notes/px54), so the pause is not what the row depends on.
#
# lope is PRIVATE (this repository is public): tools/mklope builds it
# from PAX_LOPE_REPO, a clone that holds the pin's commit (CI checks it
# out with the org's token; nothing of lope's is uploaded but its sums).
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both noboot=0 only=
usage="usage: tests/mpx5-lope [--images DIR | --no-boot | --only build | --only linux --images DIR] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --only)     only=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3

KEYS=$PAX_ROOT/user/console/lope.keys
SHRC=$PAX_ROOT/user/shrc
BORE="env ls true" # boreutils in the image (user/boreutils.pin)
RUNS=("/bin/env ENV=/etc/shrc /bin/sh -i -m" "/bin/as 1000 1000 /bin/env HOME=/home/pax ENV=/etc/shrc /bin/sh -i -m")
NAMES=(lope lope-user)
HOMES=(/ /home/pax)

work=$PAX_BUILD/mpx5-lope
runs=$PAX_BUILD/mpx5-lope-runs.txt
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# The container's two sessions, root's and the user's.
linux_side() { # dir -> reasons on stdout
    mkdir -p "$1/linux"
    local k a0
    for k in 0 1; do
        # shellcheck disable=SC2086 # the run line's words, as the kernel splits them
        set -- "$1" ${RUNS[$k]}
        a0=$2
        if "$PAX_ROOT/tools/linux-tree" --root "$1/root" --keys "$KEYS" --prompt '$ ' --argv0 "$a0" --size 256m --rdev --nsproc \
            --owners "$1/owners" "$1/linux/${NAMES[$k]}.tty" -- "${@:2}"; then
            say "  linux ${NAMES[$k]}: $(wc -c < "$1/linux/${NAMES[$k]}.tty" | tr -d ' ') bytes, status $(cat "$1/linux/${NAMES[$k]}.tty.rc")"
        else
            printf ' tools/linux-tree %s;' "${NAMES[$k]}"
        fi
    done
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS L0 (linux): the Linux side ran in a throwaway container" || bad "L0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/bin" "$r/etc" "$r/home/pax" "$work/bin"
    why=
    "$PAX_ROOT/tools/mkpelt" "$work/pelt" > "$work/pelt.txt" || why+=" tools/mkpelt;"
    "$PAX_ROOT/tools/mklope" "$work/lope" > "$work/lope.txt" || why+=" tools/mklope;"
    "$PAX_ROOT/tools/mkboreutils" "$work/bore" $BORE > "$work/bore.txt" || why+=" tools/mkboreutils;"
    "$PAX_ROOT/tools/mkas" "$work/bin" > "$work/as.txt" || why+=" tools/mkas;"
    cp "$work/pelt/pelt" "$r/bin/pelt" 2>/dev/null || why+=" no pelt;"
    cp "$work/pelt/pelt" "$r/bin/sh" 2>/dev/null || true
    cp "$work/lope/lope" "$r/bin/lope" 2>/dev/null || why+=" no lope;"
    for u in $BORE; do cp "$work/bore/$u" "$r/bin/$u" 2>/dev/null || why+=" no $u;"; done
    cp "$work/bin/as" "$r/bin/as" 2>/dev/null || why+=" no as;"
    for f in "$r"/bin/*; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    cp "$SHRC" "$r/etc/shrc" || why+=" no $SHRC;"
    printf '%s\n' "${RUNS[@]}" > "$r/etc/pax-run"
    printf '%s\n' '/home/pax 755 1000 1000' > "$work/owners"
    args=(/home/pax/:755:1000:1000 /etc/shrc="$r/etc/shrc":644 /etc/pax-run="$r/etc/pax-run":644)
    for f in "$r"/bin/*; do args+=("/bin/${f##*/}=$f:755"); done
    "$PAX_ROOT/tools/mkinitramfs" "$work/lope.cpio" "${args[@]}" > "$work/lope.initramfs.txt" || why+=" tools/mkinitramfs;"
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                --add "$work/lope.cpio" initramfs.cpio "$elf" "$work/$tier/lope.iso" >/dev/null || why+=" $tier: mkimage;"
            say "built $tier lope: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/lope.iso"), initramfs $(sha256_of "$work/lope.cpio")"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS L0 (build): kmain_console built ($tiers), every program static, the image built" || bad "L0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS L0: kmain_console built ($tiers), every program static, the image built, the Linux side ran in a throwaway container" || bad "L0:$why"
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx5-lope build (L0): PASS (no boot: --no-boot)" || say "mpx5-lope build: FAIL"
        exit "$fail"
    fi
fi
lx=$images/linux
for n in "${NAMES[@]}"; do
    [ -f "$lx/$n.tty" ] || { bad "L0 linux $n: no $lx/$n.tty (build first, and run the Linux side)"; continue; }
    serial_norm "$lx/$n.tty" > "$lx/$n.cmp"
done

# Run k's transcript: from its `run <k>:` line to the kernel's `user:
# frames free …` line after it, the kernel's own lines left out
# (tests/mpx5-jobs' rule).
run_part() { # norm k
    awk -v k="$2" '
        $0 ~ "^run " k ": " { on = 1; next }
        on && /^run [0-9]+: |^run: [0-9]+ commands$|^user: frames free / { exit }
        on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$1"
}

# L2 and L3: each row a run of whole lines that must follow one another
# in the transcript, the rows in order (a row's first line after the
# last line of the row before); a line is matched as a shell pattern
# (`*` the not-found line's number: pelt counts the lines the hook's
# text took). HOME is the session's home.
rows() { # kind home -> NAME<TAB>line<TAB>line…, one row a line
    local h=$2
    if [ "$1" = jump ]; then
        printf '%s\t%s\t%s\t%s\n' "etc alone lands in /etc" '$ etc' '$ pwd' /etc
        printf '%s\t%s\t%s\n' "g - prints /bin" '$ g -' /bin
        printf '%s\t%s\t%s\n' "ls runs bare in /bin" '$ ls' 'as  env  lope  ls  pelt  sh  true'
        printf '%s\t%s\t%s\t%s\n' "g alone lands in HOME" '$ g' '$ pwd' "$h"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "gi's menu, 2 lands in /etc" '$ gi' '1) /bin' '2) /etc' "3) $h" 'lope: which? 2' '$ pwd' /etc
        printf '%s\t%s\t%s\n' "true runs" '$ true; echo st=$?' st=0
        printf '%s\t%s\t%s\t%s\n' "no match: pelt's not found, 127" '$ zzqqxx; echo st=$?' 'pelt: line *: zzqqxx: not found' st=127
        printf '%s\t%s\t%s\t%s\n' "the second shell's bin lands in /bin" '$ bin' '$ pwd' /bin
    else
        printf '%s\t%s\t%s\t%s\t%s\n' "the store written: both cds recorded" '$ lope list' /bin /etc '$ etc'
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "the store read by a second shell, the first gone" '$ exec sh -i -m' '$ lope list' /etc /bin "$h" '$ bin'
    fi
}
held() { # file kind home -> the rows not held, on stdout
    rows "$2" "$3" | python3 -c '
import fnmatch, sys
lines = open(sys.argv[1], encoding="utf-8", errors="replace").read().split("\n")
at = 0
for row in sys.stdin.read().split("\n"):
    if not row:
        continue
    name, *want = row.split("\t")
    found = -1
    for i in range(at, len(lines) - len(want) + 1):
        if all(fnmatch.fnmatchcase(l, w) for l, w in zip(lines[i:i + len(want)], want)):
            found = i
            break
    if found < 0:
        print(" no %r;" % name, end="")
    else:
        at = found + len(want)
' "$1"
}

record() { # tier leg status
    ran=$((ran + 1))
    printf '%s kmain_console %s lope halt-status=%s accel=%s serial=%s iso=%s\n' "$1" "$2" "$3" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" "$(sha256_of "$iso")" >> "$runs"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        id="$tier $leg lope"
        log=$PAX_BUILD/mpx5-lope-$tier-$leg.serial.log
        elf=$images/$tier/kmain_console.elf iso=$images/$tier/lope.iso
        rm -f "$log" "$log.verdict" "$log.typed"
        if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
            bad "L4 $id: no image"
            continue
        fi
        cat "$KEYS" "$KEYS" > "$images/lope.keys"
        hrc=0
        "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 900 --qemu -m --qemu 512M \
            --elf "$elf" --marker 'halt|PANIC .*' --type "$images/lope.keys" --prompt '$ ' "$iso" >"$log.verdict" 2>&1 || hrc=$?
        record "$tier" "$leg" "$hrc"
        norm=$log.norm; serial_norm "$log" > "$norm"
        for k in 0 1; do
            n=${NAMES[$k]} h=${HOMES[$k]}
            out=$PAX_BUILD/mpx5-lope-$tier-$leg-$n.session
            run_part "$norm" $((k + 1)) > "$out"
            serial_norm "$out" > "$out.cmp"
            # L1: the container's session.
            why=
            if [ -f "$lx/$n.cmp" ]; then
                cmp -s "$lx/$n.cmp" "$out.cmp" || why+=" the session differs from the container's: $(diff "$lx/$n.cmp" "$out.cmp" | head -n 14 | cut -c1-300 | tr '\n' '|');"
            else
                why+=" no container session;"
            fi
            [ "$(wc -l < "$out.cmp" | tr -d ' ')" -gt 20 ] || why+=" a short session;"
            [ -z "$why" ] && say "PASS L1 $id $n: $(wc -l < "$out.cmp" | tr -d ' ') lines byte-identical to the container's ($(sha256_of "$out.cmp" | cut -c1-12)…)" || bad "L1 $id $n:$why"
            # L2, L3: the session's own witness.
            why=$(held "$out.cmp" jump "$h")
            [ -z "$why" ] && say "PASS L2 $id $n: the jump rows (etc, g -, ls, g, gi's menu, true, zzqqxx 127, bin)" || bad "L2 $id $n:$why"
            why=$(held "$out.cmp" store "$h")
            [ -z "$why" ] && say "PASS L3 $id $n: the store written by the first shell and read by the second" || bad "L3 $id $n:$why"
        done
        # L4: what PAX lacks; nothing refused; the end.
        why=
        ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$norm" | sort -un | paste -sd' ' -)
        [ "$ns" = "273 334" ] || why+=" -ENOSYS for '$ns', not '273 334';"
        rf=$(grep -c ': refused: ' "$norm")
        [ "$rf" = 0 ] || why+=" $rf refused lines ($(grep -m1 ': refused: ' "$norm" | cut -c1-160));"
        grep -qx "PAX: init /bin/env ended with status 0; nothing left to run" "$norm" \
            || why+=" no 'PAX: init /bin/env ended with status 0' ($(grep -m1 '^PAX: init ' "$norm"));"
        pn=$(grep -m1 '^PANIC ' "$norm")
        [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
        [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
        [ -z "$why" ] && say "PASS L4 $id: -ENOSYS only for 273 and 334; nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "L4 $id:$why"
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx5-lope: PASS" || say "mpx5-lope: FAIL"
exit "$fail"
