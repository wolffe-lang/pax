#!/usr/bin/env bash
# tests/mpx4-net — PAX on the network (px20, px21; toward M-PX4): the
# kernel finds QEMU's virtio network device on the PCI bus (kernel/pci),
# drives it through the virtio 1.x interface (kernel/virtio,
# kernel/net), resolves addresses through an ARP cache (kernel/arp),
# speaks IPv4 (kernel/ip) and answers and sends ICMP echo
# (kernel/icmp).
#
#   tests/mpx4-net [--images DIR | --no-boot] [--firmware bios|uefi|both]
#                  [--tier native|release|both] [--accel auto|kvm|tcg]
#
# One kernel, kernel/kmain_net.lu, booted five ways per tier (native,
# release) and firmware (bios, uefi):
#
#   net      `-netdev user,ipv6=off,hostfwd=udp:127.0.0.1:<port>-:7`, a
#            transitional `virtio-net-pci` with the address
#            52:54:00:12:34:56, and `-object filter-dump` writing every
#            frame that crosses the netdev to a pcap file; while the
#            kernel waits, this script sends UDP datagrams to <port>,
#            which makes the gateway ask for the guest's address. The
#            command line is `pci ping` (boot/limine-net.conf)
#   modern   the same with `disable-legacy=on`: a 1.x-only device
#   peer     `-netdev socket,udp=…,localaddr=…`: every frame is a UDP
#            datagram on this host's loopback, and tools/net-peer is the
#            whole network at the other end (an on-link host, the
#            gateway, a host behind it), with the same capture. The
#            command line is `peer` (boot/limine-net-peer.conf). This is
#            how an echo request gets INTO PAX: QEMU's user-mode gateway
#            forwards only TCP and UDP to a guest and originates no ICMP
#   absent   no network device at all
#   legacy   `disable-modern=on`: a device with no 1.x interface
#
# Assertions:
#   G0 the host (once): tools/gateway-probe — QEMU's gateway answers ARP
#      and ICMP echo for 10.0.2.2 itself on this host, which N6 and N12
#      stand on; whether it proxies an echo to an outside address is
#      printed, not held.
#   N0 build: tools/build-kernel's object assertions for kmain_net.
#   N1 census (net, modern, peer; `pci` on the command line for the
#      first two): `pci: <n> functions (configuration mechanism #1)`, n
#      >= 4, one line per function, and the network device's — vendor
#      1af4, device 1000 (transitional) or 1041 (modern), class
#      02.00.00, pin A and a line — with its BARs and a capability list
#      holding at least four vendor capabilities (09).
#   N2 the device up: the driver names the device it took and its BAR;
#      the features offered hold bits 32 and 5 and the features taken
#      are exactly 0x0000000100000020; both queues have 64 entries and
#      their parts are aligned as the specification orders
#      (descriptors 16, avail 2, used 4), in one frame, in the order
#      descriptors, avail, used, without overlap; the address is the
#      one QEMU was given; the vector is 32 + the line the census
#      printed; 66 frames held; and kernel/ip's line: 10.0.2.15 netmask
#      255.255.255.0 gateway 10.0.2.2, MTU 1500.
#   N3 answer (net, modern): `arp: answered 10.0.2.2
#      (52:55:0a:00:02:02) after <t> ticks` — the gateway's request for
#      10.0.2.15 was answered.
#   N4 resolve (net, modern): `arp: 10.0.2.2 is at 52:55:0a:00:02:02 (0
#      requests, <t> ticks)` — the cache learned the gateway from its
#      own request (RFC 826: the target was this station), so none of
#      PAX's is needed.
#   N5 the capture (net, modern, peer), byte by byte (tools/pcap-net):
#      every frame PAX sent rebuilt from its meaning and equal to the
#      capture's; every frame that reached PAX judged by the model,
#      every IP and ICMP checksum recomputed; no echo request and no
#      ARP request for PAX left unanswered; and the 20000 + 5000 burst
#      frames (net, modern).
#   N6 soak (net, modern): `soak: 10000 echo requests, 10000 replies …`
#      to the gateway, and the books the same before and after it: the
#      frame allocator's free count, the heap's pages and live blocks,
#      the driver's 66 frames, the protocols' 11.
#   N7 bursts (net, modern): 20000 frames of 60 bytes and 5000 of 1514
#      sent, `64 of 64 buffers back` after each.
#   N8 counters (net, modern, peer): the kernel's counters are the
#      capture's, one by one (tools/pcap-net --serial: 52 values), and
#      for net and modern: one ARP request answered, 6 + 10000 echo
#      requests sent and as many replies matched, nothing dropped but
#      this script's own datagrams (protocol 17, which nothing speaks:
#      at least one, and a destination unreachable for the first).
#   N9 halted (net, modern, peer): the log ends `halt`, no PANIC, and
#      tools/qemu-halt holds the machine to RIP in pax_halt, IF clear,
#      HLT=1.
#   N10 absent: `net: no virtio network device among <n> PCI
#      functions; the network is off`, then `halt`; no PANIC; halted.
#   N11 legacy: `net: refused: the device has no virtio 1.x common
#      configuration capability (a legacy-only device); the network is
#      off`, then `halt`; no PANIC; halted.
#   N12 ping (net, modern; `ping` on the command line): six echo
#      requests to the gateway, 56, 0 and 1472 data bytes, each `icmp:
#      <n> bytes from 10.0.2.2: seq=<s> ttl=255 time=<t> us`.
#   P1 (peer) tools/net-peer's verdict: every step of parts A and B (its
#      header lists them) ok — the pending queue, the route by way of
#      the gateway, the retry and the giving up, the ageing; echo
#      requests into PAX answered byte for byte; 31 malformed or
#      unwanted datagrams and 9 ARP packets not answered; destination
#      unreachable, limited; gratuitous ARP; more hosts than the cache
#      holds; 10000 echoes.
#   P2 (peer) the kernel's own account of part A: 4 queued and 2 pushed
#      out; echo 4 answered and one stray reply (echo 3's); echoes 5-8
#      from 10.0.2.100 and 9-10 from 192.0.2.1 with ttl=63; `arp:
#      10.0.2.99 unresolved after 3 requests in <t> ticks, 1 frames
#      dropped`, t in 290..400; 10.0.2.100 aged out and asked for
#      again; 8 and 1480 bytes answered; 1473 data bytes refused.
#   P3 (peer) the soak and the books: `serve: told to stop after <t>
#      ticks, <n> echo requests answered`, n = 28 + 10000, and the books
#      the same before and after.
#   P4 (peer) every drop by its name, exactly: kernel/ip's 2 short, 1
#      version, 1 ihl, 1 checksum, 2 length, 1 ttl, 2 fragment, 7
#      source, 3 option, 2 source-route, 2 other, 9 protocol;
#      kernel/icmp's 1 short, 1 checksum, 2 broadcast, 2 type, 2 stray;
#      2 destination unreachables sent, 5 limited, 2 silent; ARP's 6
#      bad, 1 conflict, 2 pushed out, 1 unresolved; 1 datagram refused
#      for its size; no entry beyond the cache's eight, and none for
#      10.0.2.123, whose gratuitous announcement must teach nothing.
#
# --images DIR boots ISOs and ELFs built earlier by this script (DIR
# holds <tier>/kmain_net.{iso,elf} and <tier>/kmain_net-peer.iso): any
# host with QEMU, nm and python3, no wolf needed. Without it the script
# builds with $PAX_WOLF (linux); --no-boot stops after the build (N0).
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. Exit 0 when
# every assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"

images= legs=both tiers=both noboot=0 accel=auto
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --no-boot)  noboot=1; shift ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        --accel)    accel=$2; shift 2 ;;
        *)          die "usage: tests/mpx4-net [--images DIR | --no-boot] [--firmware bios|uefi|both] [--tier native|release|both] [--accel auto|kvm|tcg]" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac

k=kmain_net
work=$PAX_BUILD/mpx4-net
MAC=52:54:00:12:34:56
GW_MAC=52:55:0a:00:02:02
SOAK=10000 SMALL=20000 LARGE=5000
fail=0 ran=0
bad() { say "FAIL $*"; fail=1; }
need nm python3

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf: $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    rm -rf "$work"
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/$k.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/$k.lu" "$work/$tier" 2>"$log"); then
            cat "$log" >&2
            say "PASS N0 $tier $k: build-kernel's assertions"
            "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-net.conf" "$elf" "$work/$tier/$k.iso" >/dev/null || bad "$tier $k: mkimage"
            "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-net-peer.conf" "$elf" "$work/$tier/$k-peer.iso" >/dev/null || bad "$tier $k: mkimage (peer)"
            say "built $tier $k: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/$k.iso"), peer iso $(sha256_of "$work/$tier/$k-peer.iso")"
        else
            cat "$log" >&2
            bad "N0 $tier $k: tools/build-kernel"
        fi
    done
    images=$work
    if [ "$noboot" = 1 ]; then
        [ "$fail" = 0 ] && say "mpx4-net build (N0): PASS (no boot: --no-boot)" || say "mpx4-net build: FAIL"
        exit "$fail"
    fi
fi

# Two UDP ports on this host, free to bind (two runs on one host must
# not share one): the netdev's forward, or the socket netdev's two ends.
pick_ports() {
    python3 -c '
import os, socket, sys
p = 20000 + (os.getpid() * 7919 + int(sys.argv[1]) * 16) % 20000
got = []
for k in range(400):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.bind(("127.0.0.1", p + k))
    except OSError:
        continue
    s.close()
    got.append(p + k)
    if len(got) == 2:
        break
print(*got)
' "$1"
}

# While the kernel waits for a request, send it datagrams (at most 40,
# 0.25 s apart) until it says it answered one. Runs beside QEMU.
poke() { # serial-log port
    local i=0
    while [ "$i" -lt 1200 ]; do
        grep -aq 'waiting for a request' "$1" 2>/dev/null && break
        # A kernel that ended without a network will never wait.
        grep -aq 'the network is off\|^PANIC' "$1" 2>/dev/null && return 0
        sleep 0.1; i=$((i + 1))
    done
    i=0
    while [ "$i" -lt 40 ]; do
        grep -aq 'arp: answered\|arp: no request' "$1" 2>/dev/null && break
        python3 -c 'import socket, sys; socket.socket(socket.AF_INET, socket.SOCK_DGRAM).sendto(b"pax", ("127.0.0.1", int(sys.argv[1])))' "$2"
        sleep 0.25; i=$((i + 1))
    done
}

# Boot the kernel one way to its halt; leaves the log in $log, the
# capture (net, modern, peer) in $pcap and tools/net-peer's account
# (peer) in $log.peer. Status: qemu-halt's.
boot() { # tier leg way
    local tier=$1 leg=$2 way=$3 rc=0 ports port port2 pid=
    log=$PAX_BUILD/mpx4-net-$tier-$leg-$way.serial.log
    pcap=$PAX_BUILD/mpx4-net-$tier-$leg-$way.pcap
    local iso=$images/$tier/$k.iso elf=$images/$tier/$k.elf
    [ "$way" = peer ] && iso=$images/$tier/$k-peer.iso
    rm -f "$log" "$log.verdict" "$log.peer" "$pcap"
    [ -f "$iso" ] && [ -f "$elf" ] || { say "no image or ELF for $tier $k ($iso)"; : > "$log"; return 2; }
    local q=()
    case $way in
        net|modern|peer)
            ports=$(pick_ports "$ran")
            port=${ports% *} port2=${ports#* }
            [ -n "$port" ] && [ "$port" != "$port2" ] || { say "no free UDP ports on this host"; : > "$log"; return 2; }
            local dev="virtio-net-pci,netdev=n0,mac=$MAC"
            [ "$way" = modern ] && dev+=",disable-legacy=on"
            if [ "$way" = peer ]; then
                q=(--qemu -netdev --qemu "socket,id=n0,udp=127.0.0.1:$port,localaddr=127.0.0.1:$port2")
                "$PAX_ROOT/tools/net-peer" --listen "$port" --qemu "$port2" --soak "$SOAK" --boot 170 >"$log.peer" 2>&1 &
            else
                q=(--qemu -netdev --qemu "user,id=n0,ipv6=off,hostfwd=udp:127.0.0.1:$port-:7")
                poke "$log" "$port" &
            fi
            pid=$!
            q+=(--qemu -device --qemu "$dev" --qemu -object --qemu "filter-dump,id=f0,netdev=n0,file=$pcap")
            ;;
        legacy)
            q=(--qemu -netdev --qemu "user,id=n0,ipv6=off"
               --qemu -device --qemu "virtio-net-pci,netdev=n0,mac=$MAC,disable-modern=on")
            ;;
        absent) ;;
    esac
    "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 180 --accel "$accel" \
        --elf "$elf" --marker halt ${q[@]+"${q[@]}"} "$iso" >"$log.verdict" 2>&1 || rc=$?
    if [ -n "$pid" ]; then
        # The script at the other end has said its last word by now, or
        # never will: QEMU is gone.
        [ "$way" = peer ] && { sleep 0.5; kill "$pid" 2>/dev/null; }
        wait "$pid" 2>/dev/null
    fi
    ran=$((ran + 1))
    printf '%s %s %s halt-status=%s accel=%s qemu="%s" serial=%s iso=%s%s\n' "$tier" "$leg" "$way" "$rc" \
        "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sed -n 's/^qemu: //p' "$log.meta" 2>/dev/null)" \
        "$(sha256_of "$log")" "$(sha256_of "$iso")" \
        "$([ -f "$pcap" ] && printf ' pcap=%s (%s bytes)' "$(sha256_of "$pcap")" "$(wc -c < "$pcap" | tr -d ' ')")" \
        >> "$PAX_BUILD/mpx4-net-runs.txt"
    return "$rc"
}

# The value of the last line of the normalised log matching sed BRE $2
# with one group.
grab() { serial_norm "$1" | sed -n "s/^$2\$/\\1/p" | tail -n 1; }
has() { serial_norm "$1" | grep -Eqx -- "$2"; }
line_of() { serial_norm "$1" | grep -E -m1 -- "$2"; }

halted() { # assertion label status
    if serial_norm "$log" | grep -q '^PANIC'; then bad "$1 $2: $(serial_norm "$log" | grep -m1 '^PANIC')"; fi
    if [ "$3" = 0 ]; then
        say "PASS $1 $2: halted: $(tail -n 1 "$log.verdict")"
    else
        bad "$1 $2: not halted (qemu-halt $3): $(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict")"
    fi
}

HEX='0x[0-9a-f]{16}'
BOOKS='frames free ([0-9]+), heap pages ([0-9]+), live blocks ([0-9]+), net frames 66, stack frames 11'

# N1, N2 for the boot whose log is $log: the census (when the command
# line asked for it) and the device up.
device_up() { # label device-id census?
    local L=$1 id=$2 census=$3
    local n dev line caps at
    if [ "$census" = 1 ]; then
        n=$(grab "$log" 'pci: \([0-9]*\) functions (configuration mechanism #1)')
        dev=$(serial_norm "$log" | grep -E "^pci [0-9a-f]{2}:[0-9a-f]{2}\.[0-7] 1af4:$id class 02\.00\.00 rev [0-9a-f]{2} subsystem [0-9a-f]{4}:[0-9a-f]{4} header 00 pin A line [0-9]+\$" | head -n 1)
        line=${dev##* line }
        at=${dev#pci }; at=${at%% *}
        caps=$(serial_norm "$log" | sed -n "s/^pci $at caps \(.*\)\$/\1/p" | head -n 1)
        local nfun nvend
        nfun=$(serial_norm "$log" | grep -Ec '^pci [0-9a-f]{2}:[0-9a-f]{2}\.[0-7] [0-9a-f]{4}:[0-9a-f]{4} class ')
        nvend=$(printf '%s\n' $caps | grep -c '^09@')
        if [ -n "$n" ] && [ "$n" -ge 4 ] && [ "$nfun" = "$n" ] && [ -n "$dev" ] && [ "$nvend" -ge 4 ] \
            && serial_norm "$log" | grep -Eq "^pci $at bar[0-5] mem(32|64) (prefetchable )?$HEX\$"; then
            say "PASS N1 $L: $n functions; $dev; caps $caps; $(serial_norm "$log" | grep -E "^pci $at bar" | sed "s/^pci $at //" | paste -sd, -)"
        else
            bad "N1 $L: the census: n='$n' lines=$nfun device='$dev' caps='$caps'"
        fi
    else
        at='[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]\.[0-7]' line=
        if serial_norm "$log" | grep -q '^pci '; then bad "N1 $L: a census nobody asked for"; else say "PASS N1 $L: no \`pci\` on the command line, no census"; fi
    fi
    local offered taken ok2=1 vec mac held bar
    bar=$(serial_norm "$log" | sed -n "s/^net: virtio-net 1af4:$id at $at, \(bar[0-5] 0x[0-9a-f]*\), 1\.x interface\$/\1/p" | tail -n 1)
    offered=$(grab "$log" 'net: features offered \(0x[0-9a-f]*\), taken 0x[0-9a-f]* (VERSION_1, MAC)')
    taken=$(grab "$log" 'net: features offered 0x[0-9a-f]*, taken \(0x[0-9a-f]*\) (VERSION_1, MAC)')
    [ -n "$bar" ] && [ -n "$offered" ] && [ "$taken" = 0x0000000100000020 ] \
        && [ $(( (offered >> 32) & 1 )) = 1 ] && [ $(( (offered >> 5) & 1 )) = 1 ] || ok2=0
    local qn name d a u q0= q1=
    for qn in 0 1; do
        name=receive; [ "$qn" = 1 ] && name=transmit
        read -r d a u <<< "$(serial_norm "$log" | sed -n "s/^net: $name queue $qn: 64 entries, descriptors \(0x[0-9a-f]*\) avail \(0x[0-9a-f]*\) used \(0x[0-9a-f]*\)\$/\1 \2 \3/p" | tail -n 1)"
        # descriptors 64 * 16 bytes, avail 6 + 2 * 64, used 6 + 8 * 64.
        if [ -n "${u:-}" ] && [ $((d % 16)) = 0 ] && [ $((a % 2)) = 0 ] && [ $((u % 4)) = 0 ] \
            && [ $((a)) -ge $((d + 1024)) ] && [ $((u)) -ge $((a + 134)) ] && [ $((u + 518)) -le $(( (d / 4096 + 1) * 4096 )) ]; then
            eval "q$qn='$name $d/$a/$u'"
        else
            ok2=0; eval "q$qn='$name BAD ${d:-} ${a:-} ${u:-}'"
        fi
    done
    mac=$(serial_norm "$log" | sed -n 's/^net: \([0-9a-f:]*\), line [0-9]* (vector [0-9]*, level; elcr [0-9a-f]* -> [0-9a-f]*), [0-9]* frames held$/\1/p' | tail -n 1)
    vec=$(serial_norm "$log" | sed -n 's/^net: [0-9a-f:]*, line \([0-9]*\) (vector \([0-9]*\), level; elcr \([0-9a-f]*\) -> \([0-9a-f]*\)), \([0-9]*\) frames held$/\1 \2 \3 \4 \5/p' | tail -n 1)
    local vl vv e0 e1
    read -r vl vv e0 e1 held <<< "$vec"
    [ "$mac" = "$MAC" ] && [ -n "${held:-}" ] && { [ -z "$line" ] || [ "$vl" = "$line" ]; } && [ "$vv" = $((32 + vl)) ] && [ "$held" = 66 ] \
        && [ $(( (0x$e1 >> vl) & 1 )) = 1 ] || ok2=0
    has "$log" 'ip: 10\.0\.2\.15 netmask 255\.255\.255\.0 gateway 10\.0\.2\.2, MTU 1500, TTL 64, DF set, no fragments either way' || ok2=0
    if [ "$ok2" = 1 ]; then
        say "PASS N2 $L: 1af4:$id, $bar; offered $offered, taken $taken; $q0; $q1 (16/2/4-aligned, one frame each); $mac; line $vl vector $vv level (elcr $e0 -> $e1); 66 frames; $(line_of "$log" '^ip: 10')"
    else
        bad "N2 $L: bar='$bar' offered='$offered' taken='$taken' q0='${q0:-}' q1='${q1:-}' mac='$mac' irq='$vec' (census line '$line') ip='$(line_of "$log" '^ip: 10')' $(serial_norm "$log" | grep -m1 '^net: refused')"
    fi
}

# N5 and N8's first half: the capture, and the kernel's counters
# against it.
capture() { # label pcap-net-args…
    local L=$1; shift
    if [ -s "$pcap" ] && "$PAX_ROOT/tools/pcap-net" "$@" --list 4 "$pcap" >"$pcap.check" 2>&1; then
        say "PASS N5 $L: $(grep '^pcap-net: [0-9]' "$pcap.check") [pcap $(sha256_of "$pcap" | cut -c1-12)…]"
    else
        tail -n 4 "$pcap.check" >&2 2>/dev/null
        bad "N5 $L: the capture ($pcap)"
    fi
    agree=0
    if [ -s "$pcap" ] && "$PAX_ROOT/tools/pcap-net" "$@" --serial "$log" "$pcap" >"$pcap.counters" 2>&1; then
        agree=1
    else
        grep '^pcap-net: FAIL' "$pcap.counters" >&2 2>/dev/null
    fi
}

# Whether the two `<phase>: before:` and `<phase>: after:` lines hold
# the same books; prints them.
books_flat() { # phase
    local b a
    b=$(serial_norm "$log" | sed -n -E "s/^$1: before: ($BOOKS)\$/\1/p" | tail -n 1)
    a=$(serial_norm "$log" | sed -n -E "s/^$1: after: ($BOOKS)\$/\1/p" | tail -n 1)
    printf '%s' "$b"
    [ -n "$b" ] && [ "$b" = "$a" ]
}

# N1-N9, N12 for one boot against QEMU's gateway.
with_gateway() { # tier leg way device-id
    local tier=$1 leg=$2 way=$3 id=$4 L="$1 $2 $3" hrc=0
    boot "$tier" "$leg" "$way" || hrc=$?
    device_up "$L" "$id" 1
    # --- N3, N4: answer and resolve -------------------------------------
    if has "$log" "arp: 10\.0\.2\.15, waiting for a request" && has "$log" "arp: answered 10\.0\.2\.2 \($GW_MAC\) after [0-9]+ ticks"; then
        say "PASS N3 $L: $(serial_norm "$log" | grep '^arp: answered')"
    else
        bad "N3 $L: no answer: $(serial_norm "$log" | grep -m1 '^arp: no request\|^arp: answered')"
    fi
    if has "$log" "arp: 10\.0\.2\.2 is at $GW_MAC \(0 requests, [0-9]+ ticks\)"; then
        say "PASS N4 $L: $(serial_norm "$log" | grep '^arp: 10.0.2.2 is at') (learned from the gateway's own request)"
    else
        bad "N4 $L: the gateway is not in the cache: $(serial_norm "$log" | grep -m1 '^arp: 10.0.2.2 ')"
    fi
    # --- N12: ping --------------------------------------------------------
    local pings
    pings=$(serial_norm "$log" | grep -Ec '^icmp: (64|8|1480) bytes from 10\.0\.2\.2: seq=[1-6] ttl=255 time=[0-9]+ us$')
    if [ "$pings" = 6 ] && has "$log" 'icmp: 8 bytes from 10\.0\.2\.2: seq=5 ttl=255 time=[0-9]+ us' \
        && has "$log" 'icmp: 1480 bytes from 10\.0\.2\.2: seq=6 ttl=255 time=[0-9]+ us' && has "$log" 'ping: 6 echo requests to 10\.0\.2\.2, 6 replies'; then
        say "PASS N12 $L: 6 of 6 echo requests to 10.0.2.2 answered (56, 0 and 1472 data bytes); round trips $(serial_norm "$log" | sed -n 's/^icmp: .* seq=[1-6] ttl=255 time=\([0-9]*\) us$/\1/p' | paste -sd' ' -) us"
    else
        bad "N12 $L: $pings of 6 ping lines; $(serial_norm "$log" | grep -m1 '^icmp: no reply\|^ping:')"
    fi
    # --- N5: the capture ------------------------------------------------
    capture "$L" --small "$SMALL" --large "$LARGE"
    # --- N6: the soak ---------------------------------------------------
    local s st sr bk
    s=$(serial_norm "$log" | sed -n "s/^soak: $SOAK echo requests, $SOAK replies in \([0-9]*\) ticks (\([0-9]*\) echoes\/s by the time-stamp counter)\$/\1 \2/p" | tail -n 1)
    read -r st sr <<< "$s"
    if [ -n "${sr:-}" ] && bk=$(books_flat soak); then
        say "PASS N6 $L: $SOAK echo requests, $SOAK replies in $st ticks ($sr echoes/s); before and after: $bk"
    else
        bad "N6 $L: $(serial_norm "$log" | grep '^soak:' | paste -sd'|' -)"
    fi
    # --- N7: the bursts -------------------------------------------------
    local b1 b2
    b1=$(grab "$log" "burst: $SMALL frames of 60 bytes in [0-9]* ticks (\([0-9]*\) frames\/s by the time-stamp counter), 64 of 64 buffers back")
    b2=$(grab "$log" "burst: $LARGE frames of 1514 bytes in [0-9]* ticks (\([0-9]*\) frames\/s by the time-stamp counter), 64 of 64 buffers back")
    if [ -n "$b1" ] && [ -n "$b2" ]; then
        say "PASS N7 $L: $SMALL frames of 60 bytes at $b1 frames/s, $LARGE of 1514 at $b2 frames/s, 64 of 64 buffers back after each"
    else
        bad "N7 $L: $(serial_norm "$log" | grep '^burst:' | paste -sd'|' -)"
    fi
    # --- N8: the counters -----------------------------------------------
    local proto unr
    proto=$(grab "$log" 'ip: rx [0-9]* datagrams delivered (0 with options, 0 broadcast), dropped 0 short 0 version 0 ihl 0 checksum 0 length 0 ttl 0 fragment 0 source 0 option 0 source-route 0 other \([0-9]*\) protocol')
    unr=$(grab "$log" 'icmp: unreachable \([0-9]*\) sent, [0-9]* limited, 0 silent; 0 not sent')
    if [ "$agree" = 1 ] && [ -n "$proto" ] && [ "$proto" -ge 1 ] && [ -n "$unr" ] && [ "$unr" -ge 1 ] \
        && has "$log" "arp: 0 requests sent, 0 replies received, 1 requests answered \(1 replies sent\), 0 bad, 0 conflict" \
        && has "$log" "icmp: echo 0 requests answered \(0 replies sent\), $((SOAK + 6)) requests sent, $((SOAK + 6)) replies matched, 0 stray; dropped 0 short 0 checksum 0 broadcast 0 type" \
        && has "$log" "net: rx [0-9]+ frames [0-9]+ bytes, dropped 0 runt 0 long 0 other 0 type"; then
        say "PASS N8 $L: $(grep '^pcap-net: the kernel' "$pcap.counters"); 1 ARP request answered; $((SOAK + 6)) echo requests sent and matched; dropped: $proto datagrams of protocol 17 (this script's), $unr destination unreachable sent; $(line_of "$log" '^net: tx')"
    else
        bad "N8 $L: agree=$agree protocol='$proto' unreachable='$unr'; $(grep -m1 '^pcap-net: FAIL' "$pcap.counters" 2>/dev/null); $(serial_norm "$log" | grep -m1 '^icmp: echo')"
    fi
    halted N9 "$L" "$hrc"
}

# N1, N2, N5, N8, N9 and P1-P4 for the boot against tools/net-peer.
with_peer() { # tier leg
    local tier=$1 leg=$2 L="$1 $2 peer" hrc=0
    boot "$tier" "$leg" peer || hrc=$?
    device_up "$L" 1000 0
    # --- P1: the script's verdict -----------------------------------------
    if grep -q '^net-peer: PASS ' "$log.peer" && [ "$(grep -c '^net-peer: ok ' "$log.peer")" = 13 ]; then
        say "PASS P1 $L: 13 steps ok; $(grep '^net-peer: ok A2' "$log.peer" | sed 's/^net-peer: ok //'); $(grep '^net-peer: ok B6' "$log.peer" | sed 's/^net-peer: ok //'); $(grep '^net-peer: ok B10' "$log.peer" | sed 's/^net-peer: ok //')"
    else
        grep -A3 '^net-peer: FAIL' "$log.peer" >&2
        bad "P1 $L: tools/net-peer: $(grep -c '^net-peer: ok ' "$log.peer") of 13 steps; $(grep -m1 '^net-peer: FAIL\|^Traceback\|Error' "$log.peer")"
    fi
    # --- P2: part A in the kernel's words -----------------------------------
    local ok=1 t pinged far
    has "$log" 'queue: 4 echo requests to 10\.0\.2\.100 before its address is known: 4 queued, 2 pushed out' || ok=0
    has "$log" 'queue: seq=4 answered, ttl=64 time=[0-9]+ us; 1 stray replies' || ok=0
    pinged=$(serial_norm "$log" | grep -Ec '^icmp: 64 bytes from 10\.0\.2\.100: seq=([5-8]|12) ttl=64 time=[0-9]+ us$')
    far=$(serial_norm "$log" | grep -Ec '^icmp: 64 bytes from 192\.0\.2\.1: seq=(9|10) ttl=63 time=[0-9]+ us$')
    [ "$pinged" = 5 ] && [ "$far" = 2 ] || ok=0
    t=$(grab "$log" 'arp: 10\.0\.2\.99 unresolved after 3 requests in \([0-9]*\) ticks, 1 frames dropped')
    [ -n "$t" ] && [ "$t" -ge 290 ] && [ "$t" -le 400 ] || ok=0
    has "$log" 'arp: 10\.0\.2\.100 had aged out \([0-9]+ aged so far, [0-9]+ at this use\), asked for again with 1 requests' || ok=0
    has "$log" 'icmp: 8 bytes from 10\.0\.2\.100: seq=13 ttl=64 time=[0-9]+ us' || ok=0
    has "$log" 'icmp: 1480 bytes from 10\.0\.2\.100: seq=14 ttl=64 time=[0-9]+ us' || ok=0
    has "$log" 'icmp: 1473 data bytes to 10\.0\.2\.100 refused: 1481 bytes is over the 1480 a datagram carries' || ok=0
    if [ "$ok" = 1 ]; then
        say "PASS P2 $L: 4 queued, 2 pushed out, echo 4 answered, 1 stray; 5 echoes from 10.0.2.100 and 2 from 192.0.2.1 (ttl 63, by way of the gateway); 10.0.2.99 given up after 3 requests in $t ticks, 1 frame dropped; 10.0.2.100 aged out and asked for again; 0 and 1472 data bytes answered, 1473 refused"
    else
        bad "P2 $L: pinged=$pinged far=$far unresolved-ticks='$t'; $(serial_norm "$log" | grep '^queue:\|^icmp: no reply\|^arp: 10.0.2.99\|^arp: 10.0.2.100 \|NOT refused' | paste -sd'|' -)"
    fi
    # --- N5: the capture --------------------------------------------------
    capture "$L"
    # --- P3: the soak and the books ---------------------------------------
    local n bk
    n=$(grab "$log" 'serve: told to stop after [0-9]* ticks, \([0-9]*\) echo requests answered')
    if [ "$n" = $((SOAK + 28)) ] && bk=$(books_flat serve); then
        say "PASS P3 $L: $(line_of "$log" '^serve: told'); before and after: $bk"
    else
        bad "P3 $L: answered='$n' (wanted $((SOAK + 28))); $(serial_norm "$log" | grep '^serve:' | paste -sd'|' -)"
    fi
    # --- N8, P4: the counters ---------------------------------------------
    if [ "$agree" = 1 ]; then
        say "PASS N8 $L: $(grep '^pcap-net: the kernel' "$pcap.counters"); $(line_of "$log" '^net: rx'); $(line_of "$log" '^ip: tx')"
    else
        bad "N8 $L: $(grep -m1 '^pcap-net: FAIL' "$pcap.counters" 2>/dev/null)"
    fi
    ok=1
    has "$log" 'ip: rx [0-9]+ datagrams delivered \(3 with options, 3 broadcast\), dropped 2 short 1 version 1 ihl 1 checksum 2 length 1 ttl 2 fragment 7 source 3 option 2 source-route 2 other 9 protocol' || ok=0
    has "$log" 'ip: tx [0-9]+ datagrams, not sent 1 size 0 dropped' || ok=0
    has "$log" "icmp: echo $((SOAK + 28)) requests answered \($((SOAK + 28)) replies sent\), 14 requests sent, 10 replies matched, 2 stray; dropped 1 short 1 checksum 2 broadcast 2 type" || ok=0
    has "$log" 'icmp: unreachable 2 sent, 5 limited, 2 silent; 0 not sent' || ok=0
    has "$log" 'arp: [0-9]+ requests sent, [0-9]+ replies received, 11 requests answered \(11 replies sent\), 6 bad, 1 conflict' || ok=0
    has "$log" 'arp: cache [0-9]+ learned, [0-9]+ updated, [1-9][0-9]* aged; pending [0-9]+ queued, [0-9]+ sent, 2 pushed out, 1 unresolved \(1 addresses given up\), 0 table full' || ok=0
    has "$log" 'net: rx [0-9]+ frames [0-9]+ bytes, dropped 0 runt 0 long 0 other 1 type' || ok=0
    local entries
    entries=$(serial_norm "$log" | sed -n '/^serve: after:/,$p' | grep -c '^arp: entry ')
    [ "$entries" -ge 1 ] && [ "$entries" -le 8 ] || ok=0
    serial_norm "$log" | grep -q '^arp: entry [0-9]: 10\.0\.2\.123 ' && ok=0
    if [ "$ok" = 1 ]; then
        say "PASS P4 $L: $(line_of "$log" '^ip: rx' | sed 's/^.*dropped/ip dropped/'); $(line_of "$log" '^icmp: echo' | sed 's/^.*matched, //'); $(line_of "$log" '^icmp: unreachable'); ARP 6 bad, 1 conflict, 2 pushed out, 1 unresolved; $entries cache entries at the end, none for 10.0.2.123"
    else
        bad "P4 $L: entries=$entries; $(serial_norm "$log" | grep '^ip: \(rx\|tx\)\|^icmp: \|^arp: [0-9]\|^arp: cache\|^net: rx' | paste -sd'|' -)"
    fi
    halted N9 "$L" "$hrc"
}

# N10, N11: a boot that must end without a network, by name.
without() { # label tier leg way line-ERE
    local hrc=0
    boot "$2" "$3" "$4" || hrc=$?
    if "$PAX_ROOT/tools/expect-serial" --tail --regex "$log" "$5" 'halt' >"$log.expect" 2>&1 \
        && ! serial_norm "$log" | grep -q '^PANIC\|^arp:\|^ip:\|^net: virtio-net' && [ "$hrc" = 0 ]; then
        say "PASS $1 $2 $3 $4: $(serial_norm "$log" | grep -m1 '^net: ') then halt, no panic; $(tail -n 1 "$log.verdict")"
    else
        cat "$log.expect" >&2
        bad "$1 $2 $3 $4: the line, a panic, or the halt (qemu-halt $hrc): $(serial_norm "$log" | grep -m1 '^net: \|^PANIC')"
    fi
}

mkdir -p "$PAX_BUILD"
: > "$PAX_BUILD/mpx4-net-runs.txt"

# --- G0: what this host's QEMU answers ----------------------------------
own=$(python3 -c '
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.connect(("192.0.2.1", 9))  # no datagram is sent: the route alone picks the address
    print(s.getsockname()[0])
except OSError:
    pass
' 2>/dev/null)
if "$PAX_ROOT/tools/gateway-probe" 127.0.0.1 ${own:+"$own"} >"$PAX_BUILD/mpx4-net-gateway-probe.txt" 2>&1; then
    say "PASS G0 $(sed -n '1s/^gateway-probe: //p' "$PAX_BUILD/mpx4-net-gateway-probe.txt"): the gateway answers ARP and three echo requests for 10.0.2.2 itself; $(tail -n 1 "$PAX_BUILD/mpx4-net-gateway-probe.txt" | sed 's/^gateway-probe: PASS //') (asked: 127.0.0.1${own:+ and $own, the address this host routes from})"
else
    cat "$PAX_BUILD/mpx4-net-gateway-probe.txt" >&2
    bad "G0: tools/gateway-probe: $(tail -n 1 "$PAX_BUILD/mpx4-net-gateway-probe.txt")"
fi

for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        with_gateway "$tier" "$leg" net 1000
        with_gateway "$tier" "$leg" modern 1041
        with_peer "$tier" "$leg"
        without N10 "$tier" "$leg" absent 'net: no virtio network device among [0-9]+ PCI functions; the network is off'
        without N11 "$tier" "$leg" legacy 'net: refused: the device has no virtio 1\.x common configuration capability \(a legacy-only device\); the network is off'
    done
done
cat "$PAX_BUILD/mpx4-net-runs.txt"
[ "$ran" -gt 0 ] || { say "FAIL: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx4-net: PASS" || say "mpx4-net: FAIL"
exit "$fail"
