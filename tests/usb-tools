#!/usr/bin/env python3
"""USB launcher contract. No firmware or physical devices are opened."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
import copy
import runpy
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent


class Launcher(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix="pax-usb-test-")
        self.addCleanup(self.tmp.cleanup)
        self.work = Path(self.tmp.name)
        self.image = self.work / "stick.img"
        self.image.write_bytes(b"fixture")
        qemu = self.work / "qemu"
        qemu.write_text("#!/bin/sh\nexit 0\n")
        qemu.chmod(0o755)
        self.env = dict(os.environ, PAX_QEMU=str(qemu))

    def run_qemu(self, *args):
        return subprocess.run([str(ROOT / "tools/qemu-run"), "--accel", "tcg",
                               "--serial", str(self.work / "serial"), *args],
                              env=self.env, text=True, capture_output=True)

    def test_usb_only_topology(self):
        r = self.run_qemu("--usb-stick", str(self.image))
        self.assertEqual(r.returncode, 0, r.stderr)
        command = (self.work / "serial.meta").read_text().splitlines()[0]
        self.assertIn("qemu-xhci", command)
        self.assertIn("usb-storage", command)
        self.assertNotIn("virtio-blk", command)
        self.assertNotIn("cdrom", command)
        self.assertIn("readonly=on", command)

    def test_conflicting_boot_media_refused(self):
        r = self.run_qemu("--boot-disk", "--usb-stick", str(self.image))
        self.assertNotEqual(r.returncode, 0)
        self.assertIn("cannot combine", r.stderr)

    def test_extra_disk_refused_for_live_usb(self):
        r = self.run_qemu("--usb-stick", str(self.image), "--drive", str(self.image))
        self.assertNotEqual(r.returncode, 0)
        self.assertIn("cannot combine", r.stderr)


class Builder(unittest.TestCase):
    def test_usb_geometry_covers_every_sector_at_large_sizes(self):
        api = runpy.run_path(str(ROOT / "tools/mkdisk"))
        self.assertEqual(api["fat_geometry_args"](False), [])
        self.assertEqual(api["fat_geometry_args"](True), ["-g", "1/1"])
        # mkfs.fat documents rounding the total down to sectors-per-track.
        for mib in (64, 755, 2048):
            sectors = mib * 2048
            track = int(api["fat_geometry_args"](True)[1].split('/')[1])
            self.assertEqual(sectors // track * track, sectors)

    def test_explicit_userland_is_required_before_linux_boot(self):
        with tempfile.TemporaryDirectory() as d:
            d = Path(d)
            for name in ('kernel', 'image', 'busybox'):
                (d / name).write_bytes(b'fixture')
            (d / 'userland').mkdir()
            result = subprocess.run([str(ROOT / 'tools/linux-part'), '--usb-stick',
                '--kernel', str(d / 'kernel'), '--busybox', str(d / 'busybox'),
                '--userland', str(d / 'userland'), str(d / 'out'), str(d / 'image')],
                capture_output=True, text=True)
            self.assertNotEqual(result.returncode, 0)
            self.assertIn('pre-staged userland lacks', result.stderr)
            self.assertNotIn('docker: command not found', result.stderr)

    def test_invalid_usb_inputs_fail_before_writing(self):
        with tempfile.TemporaryDirectory() as d:
            d = Path(d)
            kernel, cpio, conf, out = [d / x for x in ("kernel", "cpio", "conf", "out")]
            kernel.write_bytes(b"kernel-input")
            cpio.write_bytes(b"cpio-input")
            conf.write_text("/PAX\n    path: boot():/boot/pax\n")
            args = [str(ROOT / "tools/mkdisk"), "--usb", "--kernel", str(kernel),
                    "--initramfs", str(cpio), "--conf", str(conf)]
            for extra, target, expected in [
                (["--root", str(cpio)], out, "whole live root"),
                (["--home-size", "8M"], out, "whole live root"),
                (["--journal"], out, "whole live root"),
                (["32M"], out, "no room"),
                ([], kernel, "overwrite an input"),
            ]:
                with self.subTest(expected=expected, extra=extra):
                    r = subprocess.run([*args, *extra, str(target)], capture_output=True, text=True)
                    self.assertNotEqual(r.returncode, 0)
                    self.assertIn(expected, r.stderr)
                    self.assertFalse(out.exists())
                    self.assertEqual(kernel.read_bytes(), b"kernel-input")
            out.symlink_to(kernel)
            r = subprocess.run([*args, str(out)], capture_output=True, text=True)
            self.assertIn("never a device or symlink", r.stderr)
            self.assertEqual(kernel.read_bytes(), b"kernel-input")


class Writer(unittest.TestCase):
    def setUp(self):
        self.api = runpy.run_path(str(ROOT / "tools/usb-write"))
        self.disk = dict(path="/dev/sdz", type="disk", rm=True, ro=False,
                         tran="usb", model="Fixture Stick", serial="TEST-ONLY", size=1048576,
                         mountpoints=[None], **{"maj:min": "8:240", "log-sec": 512})
        self.root = dict(path="/dev/nvme0n1p1", type="part", mountpoints=["/"], **{"maj:min": "259:1"})

    def linux(self, disk=None, root_id="259:1"):
        return self.api["linux_plan"]("/dev/sdz", {"blockdevices": [self.root, disk or self.disk]}, root_id)

    def test_linux_valid(self):
        self.assertEqual(self.linux()["model"], "Fixture Stick")

    def test_linux_refusals(self):
        for field, value in (("rm", False), ("ro", True), ("tran", "sata"),
                             ("type", "part"), ("serial", None), ("log-sec", 4096),
                             ("mountpoints", ["/mnt/stick"])):
            with self.subTest(field=field):
                d = dict(self.disk, **{field: value})
                with self.assertRaises(ValueError):
                    self.linux(d)
        with self.assertRaisesRegex(ValueError, "running root"):
            self.linux(root_id="8:240")
        with self.assertRaisesRegex(ValueError, "identify running root"):
            self.linux(root_id="999:9")

    def test_linux_mounted_descendant(self):
        d = dict(self.disk, children=[dict(type="part", mountpoints=["/mnt/data"], **{"maj:min": "8:241"})])
        with self.assertRaisesRegex(ValueError, "mounted"):
            self.linux(d)

    def test_linux_unknown_mount_status_refused(self):
        d = dict(self.disk)
        del d["mountpoints"]
        with self.assertRaisesRegex(ValueError, "mount status"):
            self.linux(d)

    def mac(self, target=None, members=None, root=None, containers=None):
        target = target or dict(DeviceIdentifier="disk9", Whole=True, RemovableMedia=True,
                                Internal=False, BusProtocol="USB", Writable=True, DeviceBlockSize=512,
                                MediaName="Fixture Stick", DiskSize=1048576)
        return self.api["mac_plan"]("/dev/disk9", target, members or [], root or {"ParentWholeDisk": "disk0"}, containers or {})

    def test_mac_valid(self):
        self.assertEqual(self.mac()["size"], 1048576)

    def test_mac_root_apfs_refused(self):
        containers = {"Containers": [{"ContainerReference": "disk3", "PhysicalStores": [{"DeviceIdentifier": "disk9s2"}]}]}
        with self.assertRaisesRegex(ValueError, "running root"):
            self.mac(root={"APFSContainerReference": "disk3"}, containers=containers)
        with self.assertRaisesRegex(ValueError, "physical stores"):
            self.mac(root={"APFSContainerReference": "disk3"})
        with self.assertRaisesRegex(ValueError, "APFS container"):
            self.mac(containers=containers)

    def test_mac_mounted_refused(self):
        with self.assertRaisesRegex(ValueError, "mounted"):
            self.mac(members=[{"Mounted": True, "MountPoint": "/Volumes/USB"}])

    def test_dry_run_never_writes_on_either_platform(self):
        with tempfile.TemporaryDirectory() as d:
            image = Path(d) / "fixture.img"
            image.write_bytes(bytes(512))
            for plan in (self.linux(), self.mac()):
                main = self.api["main"]
                with patch.dict(main.__globals__, inventory=lambda device: copy.deepcopy(plan)), \
                     patch.object(sys, "argv", ["usb-write", "--dry-run", str(image), plan["device"]]), \
                     patch("os.open", side_effect=AssertionError("device open forbidden")), \
                     patch("subprocess.run", side_effect=AssertionError("dd forbidden")), \
                     patch("builtins.input", side_effect=AssertionError("prompt forbidden")):
                    self.assertEqual(main(), 0)


if __name__ == "__main__":
    unittest.main()
