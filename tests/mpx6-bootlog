#!/usr/bin/env bash
# tests/mpx6-bootlog — px118: a boot that goes black leaves evidence
# (notes/px118-boot-diagnosis.md).
#
# The console kernel (kmain_console) on ISOs (tools/mkimage) and
# installed-shape disks (tools/mkdisk --gpt --root) whose archive's first
# program (tests/mpx6-bootlog.d/init.c) prints /proc/pax-boot and
# /proc/pax-bootlog and exits. One QEMU process boots an image several
# times: the kernel's halt (or its test-only stop), then the monitor's
# system_reset, so CMOS and memory carry over as across a reset button.
# The rows, per firmware (tests/mpx6-bootlog.d/rows.py):
#   B1 a plain boot: QEMU's PC-speaker capture (`-audiodev wav`) holds two
#      tones, count 1140 (1046.6 Hz) then count 2280 (523.3 Hz), each
#      within 2% of its pitch and 40-250 ms long: the high beep at the
#      kernel's entry, the low one at the first line drawn
#   B2 `pax.nobeep`: no tone
#   B3 no display device (`-vga none`): no framebuffer, the high tone, then
#      a refused screen's three pips (count 1808, 1356, 1808: 659.9, 879.9,
#      659.9 Hz), never the low tone
#   B4 a sound card's capture (virtio-sound, the speaker bound to nothing, as
#      tests/mpx3-sound boots): no boot tone in it
#   M1 a cold QEMU's CMOS, dumped by `pax.nomarks pax.cmosdump` (nothing
#      written): the marks' bytes 0x78-0x7f read zero; the map is listed
#   M2 a cold disk boot claims 0x78-0x7f (`marks: boot 1; … claimed`); the
#      next boot holds them and says the previous boot completed, every
#      stage set (`/proc/pax-boot`)
#   L1 that boot's /proc/pax-bootlog is the first boot's console, from its
#      first line through `run 1:`, byte for byte
#   S1-S7 `pax.bootstop=STAGE` (test-only) stops the kernel at each stage
#      from `entered` to `init`; the next boot says the previous boot
#      stopped there, the stages up to it set
#   R1 another's bytes in CMOS (`pax.cmosfill=5a`, test-only): refused,
#      nothing written over them, the boot goes on
#   L2 a log area changed under its checksum (`pax.logflip`, test-only):
#      refused at the next boot, nothing of it printed
#   W1 the kernel's own warm reset (reboot(2)): the next boot finds the
#      previous one completed, its console kept
#   N1 `pax.nomarks`, and under BIOS no memory at the log's area (-m 64;
#      OVMF and Limine do not boot in so little): nothing kept, the boot
#      unchanged to its program
#   U1 the installed system's Limine options (`timeout: 5`, `verbose: yes`,
#      `serial: yes`): Limine's lines on the serial port before PAX's first,
#      the boot unattended
#   K1 the boot's first program, `pax-boot-status record` (user/bootlog,
#      tools/mkbootstatus), writes /var/log/boot.log (0600: the claim of the
#      CMOS bytes with their offsets at boot 1; boot 1 completed and its
#      console between markers at boot 2) and /var/log/boot.summary (0644,
#      one line a boot); `pax-boot-status` lists them
#   K2 a boot stopped at `devices`: the next boot's record and show say so
#   K3 a boot.log past 256 KiB: rotated to boot.log.1, a new boot.log begun
#   U2 the armed shape `pax-upgrade arm` writes (`timeout: 5`, `default_entry:
#      1`, a staged stand-in entry, then the installed entry in the new
#      text): the first entry boots with no key
#   P1 port 0x80 through QEMU's isa-debugcon at that port: 0x11 … 0x88, the
#      stages' POST codes, in order (SKIP, not measured, where QEMU takes no
#      debug console there)
#   F1-F5 the display shapes that gave a black hand-off (BIOS: Limine's
#      `resolution:` at 16 and at 24 bits a pixel, a cirrus card; UEFI:
#      virtio-gpu, no framebuffer) and a control (UEFI, `resolution:` at 16
#      bits, where OVMF hands 32), each on a disk booted twice: the marks
#      line, /proc/pax-boot, boot.log and pax-boot-status name the
#      framebuffer handed (size, bits a pixel, pitch, colour masks, physical
#      address) and why it was refused; the capture holds the entry's high
#      tone then the three pips, never the low one; port 0x80 ends 0x11 0x1E
#      0x3E 0x5E 0x6E 0x7E 0x8E; the next boot says the previous one ran
#      with its screen refused. The control: drawn, high then low, 0x11 …
#      0x88
#   A1 (px129) how the framebuffer was mapped, on record after boot: the
#      console's `fbmap:` line and /proc/pax-boot's `fbmap` (wc or uc, the
#      PAT entry and how it was had, IA32_PAT read back, the entry the first
#      page's leaf selects, the MTRR over the range) and `scroll` (redraw or
#      copy, and how decided) agree; with QEMU's PAT, wc (K1: boot.log
#      carries both lines)
#   A2 `pax.patdefault` (test-only: IA32_PAT put to its power-on value, no
#      wc entry): the kernel programs entry 5 to wc itself and maps the
#      framebuffer with it
#
#   tests/mpx6-bootlog [--tier native|release|both] [--firmware bios|uefi|both]
#
# The kernel is tools/build-kernel's, the release tier's with --release.
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1, when it is a failure. Exit 0 when every row held, 1
# otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"

legs=both tiers=both
while [ $# -gt 0 ]; do
    case $1 in
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "usage: tests/mpx6-bootlog [--tier native|release|both] [--firmware bios|uefi|both]" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
need python3 cc xorriso qemu-system-x86_64 mcopy mtype debugfs
"$PAX_ROOT/tools/fetch-limine" >&2 || exit 2

worst=0
# px118: pax-boot-status for the K and F rows (one build: a hosted program, the same for both kernel tiers).
if "$PAX_ROOT/tools/mkbootstatus" "$PAX_BUILD/mpx6-bootlog/bootstatus" >&2; then
    export PX118_BOOTSTATUS=$PAX_BUILD/mpx6-bootlog/bootstatus/pax-boot-status
else
    printf 'FAIL K0: tools/mkbootstatus\n'; worst=1
fi
for tier in $tiers; do
    work=$PAX_BUILD/mpx6-bootlog/$tier
    rm -rf "$work"
    mkdir -p "$work"
    flags=(); [ "$tier" != release ] || flags=(--release)
    say "the $tier tier's kernel, firmware $legs"
    elf=$("$PAX_ROOT/tools/build-kernel" "${flags[@]}" --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/kernel") \
        || { printf 'FAIL B0 %s: tools/build-kernel\n' "$tier"; worst=1; continue; }
    python3 -I "$here/mpx6-bootlog.d/rows.py" "$work" "$elf" $legs || worst=1
done
exit $worst
