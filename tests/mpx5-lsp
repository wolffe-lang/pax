#!/usr/bin/env bash
# tests/mpx5-lsp — px99: `wolf lsp`, the dev compiler's language server
# (/usr/bin/wolf 0.2.36, user/wolf.pin: tools/mkwolf's musl-static build,
# held to user/wolf.sums), driven on PAX by a client of its own and held
# frame for frame to the same client and the same server on Linux.
#
#   tests/mpx5-lsp [--images DIR | --only build | --only linux --images DIR]
#                  [--firmware bios|uefi|both] [--tier native|release|both]
#
# One image, kmain_console (the dev image's kernel) with the archive:
# /usr/bin/wolf and /usr/bin/wolf-cimport-worker (tools/mkwolf, or
# PAX_DEV_WOLF_DIR, a build of it: either way held to user/wolf.sums), the
# compiler's std at /usr/share/wolf/compiler-std, where the dev image keeps
# it (tools/mkwolf-std at user/wolf.pin's WOLF_STD_REV, or PAX_DEV_STD_DIR),
# the client /usr/bin/lspc (user/elf/lspc.c, tools/mklspc: C with no libc),
# /bin/as (tools/mkas), the two sessions under /usr/share/lsp
# (tests/mpx5-lsp.d/session.py), the workspace /home/pax/lsp holding
# typed.lu (tests/mpx5-lsp.d/typed.lu, one known type error; pax's,
# 1000:1000) and /tmp (1777). Its run list, /etc/pax-run, types nothing:
#   root-open-fix  /usr/bin/lspc /usr/share/lsp/open-fix.lsp
#   root-hung      /usr/bin/lspc /usr/share/lsp/hung.lsp
#   pax-open-fix   /bin/as 1000 1000 /usr/bin/lspc /usr/share/lsp/open-fix.lsp
#   pax-hung       /bin/as 1000 1000 /usr/bin/lspc /usr/share/lsp/hung.lsp
# The client starts `/usr/bin/wolf lsp` in /home/pax/lsp on three pipes and
# an exec-status pipe (fork, setpgid, dup2, execve), as an editor's client
# does, and waits on one poll over the terminal, the server's output and
# error and a SIGCHLD self-pipe. open-fix: initialize, initialized, didOpen
# of typed.lu, its diagnostics, a didChange to tests/mpx5-lsp.d/fixed.lu
# (never saved), the diagnostics cleared, shutdown, exit, the server's
# end. hung: the same server slowed by the compiler's own test hook
# (WOLF_QUERY_TEST_SLOW_MS), no diagnostics within 3 s, the server's
# process group killed and reaped. Nothing is typed at a shell, so pelt's
# prompt (friendly or not) never arises.
#
# **The Linux side** is the same tree, the same run lines, in a throwaway
# container (tools/linux-tree: the tree a tmpfs, each run line pid 1 of a
# fresh pid namespace on a pseudo-terminal, with PAX's environment), live.
# The paths are the same on both sides, so the frames need no normalising.
#
# Assertions, per tier, firmware and run:
#   LSP0 build: kmain_console built; wolf, its worker, lspc and as static
#        (ET_EXEC, no PT_INTERP); wolf the bytes user/wolf.sums records; the
#        std the pin's revision; the sessions written; the image built; the
#        container's four runs ran.
#   LSP1 the run's transcript (lspc's `lspc: begin` to its `lspc: end`)
#        byte-identical to the container's, every frame both ways, the
#        server's exit and its SIGCHLD; the one normalisation is that the
#        client's `time:` lines, the only lines that measure a machine, are
#        left out of both (LSP4 reads them).
#   LSP2 the session's own witness (tests/mpx5-lsp.d/rows.py): the frames
#        a session must hold, by the protocol and by the compiler's answer
#        to typed.lu, so a server or a client broken on both sides alike
#        cannot pass LSP1 and LSP2 together. Before any boot is read, the
#        witness's own proof (tests/mpx5-lsp.d/test_rows.py: the Linux
#        side's recorded transcripts pass it, and each of their mutations
#        fails at its row); a witness that cannot run, or exits other than
#        0, is a failure, never a pass.
#   LSP3 the kernel's end: no -ENOSYS but set_robust_list (273) and rseq
#        (334); no `refused:` line; no panic; init ended, status 0; halted.
#   LSP4 evidence, never a pass bound: the time to the first diagnostics
#        and to the server's end, on PAX and on Linux (a NOTE line).
#
# The UEFI leg needs OVMF: SKIPPED LOUDLY without it unless
# PAX_REQUIRE_UEFI=1 (CI sets it), when it is a failure. A failed row is
# printed `FAIL <row> …` at the start of a line. Exit 0 when every
# assertion held, 1 otherwise, 2 on a usage or tool error.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
. "$here/../tools/lib.sh"
grep() { command grep -a "$@"; }

images= legs=both tiers=both only=
usage="usage: tests/mpx5-lsp [--images DIR | --only build | --only linux --images DIR] [--firmware bios|uefi|both] [--tier native|release|both]"
while [ $# -gt 0 ]; do
    case $1 in
        --images)   images=$2; shift 2 ;;
        --only)     only=$2; shift 2 ;;
        --firmware) legs=$2; shift 2 ;;
        --tier)     tiers=$2; shift 2 ;;
        *)          die "$usage" ;;
    esac
done
case $legs in both) legs="bios uefi" ;; bios|uefi) ;; *) die "--firmware takes bios, uefi or both" ;; esac
case $tiers in both) tiers="native release" ;; native|release) ;; *) die "--tier takes native, release or both" ;; esac
case $only in ''|build|linux) ;; *) die "--only takes build or linux" ;; esac
[ "$only" != linux ] || [ -n "$images" ] || die "--only linux needs --images DIR"
need readelf python3 cmp

DD=$here/mpx5-lsp.d
RUNS=("/usr/bin/lspc /usr/share/lsp/open-fix.lsp" "/usr/bin/lspc /usr/share/lsp/hung.lsp"
    "/bin/as 1000 1000 /usr/bin/lspc /usr/share/lsp/open-fix.lsp" "/bin/as 1000 1000 /usr/bin/lspc /usr/share/lsp/hung.lsp")
NAMES=(root-open-fix root-hung pax-open-fix pax-hung)
SESSIONS=(open-fix hung open-fix hung)
STD=/usr/share/wolf/compiler-std
work=$PAX_BUILD/mpx5-lsp
runs=$PAX_BUILD/mpx5-lsp-runs.txt
fail=0 ran=0
bad() { printf 'FAIL %s\n' "$*"; fail=1; }

static_ok() { # file -> reason on failure
    readelf -hW "$1" 2>/dev/null | command grep -Eq 'Type: +EXEC' || { echo "$1 is not ET_EXEC"; return 1; }
    ! readelf -lW "$1" | command grep -q INTERP || { echo "$1 has a PT_INTERP"; return 1; }
}

# lspc's transcript of one run: from its `lspc: begin` line to its `lspc:
# end` line, the `time:` lines left out (LSP1's one normalisation).
region() { # file -> the region on stdout; status 1 when it is not whole
    awk '/^lspc: begin / { on = 1 } on && !/^time: / { print } on && /^lspc: end / { done = 1; exit } END { exit !done }' "$1"
}

# The container's four runs.
linux_side() { # dir -> reasons on stdout
    mkdir -p "$1/linux"
    : > "$1/linux/none.keys"
    local k
    for k in 0 1 2 3; do
        # shellcheck disable=SC2086 # the run line's words, as the kernel splits them
        set -- "$1" ${RUNS[$k]}
        if "$PAX_ROOT/tools/linux-tree" --root "$1/root" --keys "$1/linux/none.keys" --prompt '$ ' --argv0 "$2" \
            --size 512m --rdev --nsproc --owners "$1/owners" "$1/linux/${NAMES[$k]}.tty" -- "${@:2}"; then
            say "  linux ${NAMES[$k]}: $(wc -c < "$1/linux/${NAMES[$k]}.tty" | tr -d ' ') bytes, status $(cat "$1/linux/${NAMES[$k]}.tty.rc")"
        else
            printf ' tools/linux-tree %s;' "${NAMES[$k]}"
        fi
    done
}

if [ "$only" = linux ]; then
    why=$(linux_side "$images")
    [ -z "$why" ] && say "PASS LSP0 (linux): the Linux side ran in a throwaway container" || bad "LSP0 (linux):$why"
    exit "$fail"
fi

if [ -z "$images" ]; then
    wolf=${PAX_WOLF:-wolf}
    need "$wolf"
    say "wolf (the kernel's): $("$wolf" --version | head -n 1)"
    "$PAX_ROOT/tools/fetch-limine" || exit 2
    . "$PAX_ROOT/user/wolf.pin"
    rm -rf "$work"
    r=$work/root
    mkdir -p "$r/usr/bin" "$r/usr/share/lsp" "$r/bin" "$r/home/pax/lsp" "$r/tmp" "$r/etc" "$work/bin"
    why=
    bins=${PAX_DEV_WOLF_DIR:-$work/wolf}
    if [ -z "${PAX_DEV_WOLF_DIR:-}" ]; then
        "$PAX_ROOT/tools/mkwolf" "$bins" > "$work/wolf.txt" || why+=" tools/mkwolf;"
    fi
    # The dev compiler is the bytes user/wolf.sums records, built here or
    # given: either way the image's /usr/bin/wolf is the dev image's.
    for f in wolf wolf-cimport-worker; do
        row=$(awk -v n="$f" '$1 == n { print $2 " " $3 }' "$PAX_ROOT/user/wolf.sums")
        have="$(sha256_of "$bins/$f" 2>/dev/null) $(wc -c < "$bins/$f" 2>/dev/null | tr -d ' ')"
        [ "$have" = "$row" ] || why+=" $f is '$have', user/wolf.sums records '$row';"
        cp "$bins/$f" "$r/usr/bin/$f" 2>/dev/null || why+=" no $f;"
    done
    std=${PAX_DEV_STD_DIR:-$work/std}
    if [ -z "${PAX_DEV_STD_DIR:-}" ]; then
        "$PAX_ROOT/tools/mkwolf-std" "$std" > "$work/std.txt" || why+=" tools/mkwolf-std;"
    fi
    [ "$(cat "$std/STD-REV" 2>/dev/null)" = "$WOLF_STD_REV" ] || why+=" the std is not WOLF_STD_REV $WOLF_STD_REV;"
    mkdir -p "$r$STD"
    cp -R "$std/." "$r$STD/" 2>/dev/null || why+=" no std;"
    "$PAX_ROOT/tools/mklspc" "$work/lspc" > "$work/lspc.txt" || why+=" tools/mklspc;"
    cp "$work/lspc/lspc" "$r/usr/bin/lspc" 2>/dev/null || why+=" no lspc;"
    "$PAX_ROOT/tools/mkas" "$work/bin" > "$work/as.txt" || why+=" tools/mkas;"
    cp "$work/bin/as" "$r/bin/as" 2>/dev/null || why+=" no as;"
    python3 -I "$DD/session.py" "$r/usr/share/lsp" || why+=" tests/mpx5-lsp.d/session.py;"
    cp "$DD/typed.lu" "$r/home/pax/lsp/typed.lu" || why+=" no typed.lu;"
    for f in "$r/usr/bin/wolf" "$r/usr/bin/wolf-cimport-worker" "$r/usr/bin/lspc" "$r/bin/as"; do
        x=$(static_ok "$f") || why+=" $x;"
        say "  program: ${f#"$r"/} $(sha256_of "$f") $(wc -c < "$f" | tr -d ' ') bytes"
    done
    printf '%s\n' "${RUNS[@]}" > "$r/etc/pax-run"
    printf '%s\n' '/home/pax 755 1000 1000' '/home/pax/lsp 755 1000 1000' '/home/pax/lsp/typed.lu 644 1000 1000' \
        '/tmp 1777 0 0' > "$work/owners"
    # Sorted paths and explicit modes: the same tree on both sides.
    args=(/home/pax/:755:1000:1000 /home/pax/lsp/:755:1000:1000 /tmp/:1777)
    while IFS= read -r f; do
        p=/${f#"$r/"}
        case $p in
            /home/pax/lsp/typed.lu) args+=("$p=$f:644:1000:1000") ;;
            *) mode=644; [ -x "$f" ] && mode=755; args+=("$p=$f:$mode") ;;
        esac
    done < <(find "$r" -type f | LC_ALL=C sort)
    "$PAX_ROOT/tools/mkinitramfs" "$work/lsp.cpio" "${args[@]}" > "$work/initramfs.txt" || why+=" tools/mkinitramfs;"
    for tier in $tiers; do
        flag=(); [ "$tier" = release ] && flag=(--release)
        mkdir -p "$work/$tier"
        log=$work/$tier/kmain_console.build-kernel.log
        if elf=$("$PAX_ROOT/tools/build-kernel" ${flag[@]+"${flag[@]}"} --src "$PAX_ROOT/kernel/kmain_console.lu" "$work/$tier" 2>"$log"); then
            "$PAX_ROOT/tools/mkimage" --conf "$PAX_ROOT/boot/limine-initramfs.conf" \
                --add "$work/lsp.cpio" initramfs.cpio "$elf" "$work/$tier/lsp.iso" >/dev/null || why+=" $tier: mkimage;"
            say "built $tier lsp: elf $(sha256_of "$elf"), iso $(sha256_of "$work/$tier/lsp.iso"), initramfs $(sha256_of "$work/lsp.cpio")"
        else
            cat "$log" >&2
            why+=" $tier kmain_console: tools/build-kernel;"
        fi
    done
    if [ "$only" = build ]; then
        [ -z "$why" ] && say "PASS LSP0 (build): kmain_console built ($tiers), every program static, wolf the recorded bytes, the std the pin's, the sessions written, the image built" || bad "LSP0 (build):$why"
        exit "$fail"
    fi
    if [ "$(uname -s)" != Linux ]; then
        why+=" the Linux side needs Linux (this is $(uname -s)): build on Linux, boot here with --images;"
    else
        why+=$(linux_side "$work")
    fi
    [ -z "$why" ] && say "PASS LSP0: kmain_console built ($tiers), every program static, wolf the recorded bytes, the std the pin's, the sessions written, the image built, the Linux side ran in a throwaway container" || bad "LSP0:$why"
    images=$work
fi

# LSP2's witness proves it can fail before it is trusted.
if st=$(python3 -I "$DD/test_rows.py" 2>&1); then
    say "PASS LSP2 (self-test): $(printf '%s\n' "$st" | grep -c '^  ok ') cases (tests/mpx5-lsp.d/test_rows.py)"
else
    printf '%s\n' "$st" | grep -v '^  ok ' | head -n 8 | while IFS= read -r line; do printf 'FAIL LSP2 (self-test): %s\n' "$line"; done
    fail=1
fi

lx=$images/linux
for n in "${NAMES[@]}"; do
    [ -f "$lx/$n.tty" ] || { bad "LSP0 linux $n: no $lx/$n.tty (build first, and run the Linux side)"; continue; }
    serial_norm "$lx/$n.tty" > "$lx/$n.norm"
    region "$lx/$n.norm" > "$lx/$n.region" || bad "LSP0 linux $n: no whole lspc transcript in the container's"
done

# Run k's transcript: from its `run <k>:` line to the kernel's `user:
# frames free …` line after it, the kernel's own lines left out
# (tests/mpx5-jobs' rule).
run_part() { # norm k
    awk -v k="$2" '
        $0 ~ "^run " k ": " { on = 1; next }
        on && /^run [0-9]+: |^run: [0-9]+ commands$|^user: frames free / { exit }
        on { i = index($0, "user: "); if (i == 1) next; if (i > 1) { printf "%s", substr($0, 1, i - 1); next } print }' "$1"
}

timing() { # file label -> microseconds, or ?
    local v
    v=$(sed -n -E "s/^time: $2 ([0-9]+) us$/\\1/p" "$1" | head -n 1)
    printf '%s' "${v:-?}"
}

mkdir -p "$PAX_BUILD"
: > "$runs"
for leg in $legs; do
    if [ "$leg" = uefi ] && [ -z "$(find_ovmf)" ]; then
        if [ "${PAX_REQUIRE_UEFI:-0}" = 1 ]; then
            bad "LSP3 uefi: no OVMF firmware and PAX_REQUIRE_UEFI=1"
        else
            say "SKIP uefi: no OVMF firmware found on this host (set PAX_OVMF_CODE)"
        fi
        continue
    fi
    for tier in $tiers; do
        id="$tier $leg"
        log=$PAX_BUILD/mpx5-lsp-$tier-$leg.serial.log
        elf=$images/$tier/kmain_console.elf iso=$images/$tier/lsp.iso
        rm -f "$log" "$log.verdict"
        if [ ! -f "$iso" ] || [ ! -f "$elf" ]; then
            bad "LSP3 $id: no image"
            continue
        fi
        ran=$((ran + 1))
        hrc=0
        "$PAX_ROOT/tools/qemu-halt" --firmware "$leg" --serial "$log" --timeout 1800 --qemu -m --qemu 1024M \
            --elf "$elf" --marker 'halt|PANIC .*' "$iso" >"$log.verdict" 2>&1 || hrc=$?
        printf '%s %s lsp halt-status=%s accel=%s serial=%s\n' "$tier" "$leg" "$hrc" \
            "$(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null)" "$(sha256_of "$log")" >> "$runs"
        norm=$log.norm; serial_norm "$log" > "$norm"
        for k in 0 1 2 3; do
            n=${NAMES[$k]}
            out=$PAX_BUILD/mpx5-lsp-$tier-$leg-$n
            run_part "$norm" $((k + 1)) > "$out.run"
            if ! region "$out.run" > "$out.region"; then
                bad "LSP1 $id $n: no whole lspc transcript in run $((k + 1)) ($(grep -c . "$out.run") lines; last: $(tail -n 1 "$out.run" | cut -c1-160))"
                continue
            fi
            why=
            if [ -f "$lx/$n.region" ]; then
                cmp -s "$lx/$n.region" "$out.region" || why+=" the transcript differs from the container's: $(diff "$lx/$n.region" "$out.region" | head -n 12 | cut -c1-300 | tr '\n' '|');"
            else
                why+=" no container transcript;"
            fi
            [ -z "$why" ] && say "PASS LSP1 $id $n: $(grep -c '^s2c ' "$out.region") frames read and $(grep -c '^c2s ' "$out.region") sent, $(wc -l < "$out.region" | tr -d ' ') lines byte-identical to the container's ($(sha256_of "$out.region" | cut -c1-12)…; the time: lines left out)" || bad "LSP1 $id $n:$why"
            rrc=0
            why=$(python3 -I "$DD/rows.py" "${SESSIONS[$k]}" "$out.region" 2>&1) || rrc=$?
            [ "$rrc" = 0 ] || [ -n "$why" ] || why="tests/mpx5-lsp.d/rows.py exited $rrc"
            if [ "$rrc" = 0 ] && [ -z "$why" ]; then
                say "PASS LSP2 $id $n: the ${SESSIONS[$k]} session's frames (tests/mpx5-lsp.d/rows.py)"
            else
                while IFS= read -r line; do bad "LSP2 $id $n: $line"; done <<< "$why"
            fi
            say "NOTE LSP4 $id $n: first diagnostics $(timing "$out.run" first-diagnostics) us on PAX, $(timing "$lx/$n.norm" first-diagnostics) us on Linux; the server's end $(timing "$out.run" exit) us on PAX, $(timing "$lx/$n.norm" exit) us on Linux (accel $(sed -n 's/^accel: //p' "$log.meta" 2>/dev/null); evidence, never a bound)"
        done
        why=
        ns=$(sed -n -E 's/^user: [^ ]+ pid [0-9]+ syscall ([0-9]+): -ENOSYS$/\1/p' "$norm" | sort -un | paste -sd' ' -)
        for x in $ns; do case $x in 273|334) ;; *) why+=" -ENOSYS for $x ($(grep -m1 "syscall $x: -ENOSYS" "$norm"));" ;; esac; done
        rf=$(grep -c ': refused: ' "$norm")
        [ "$rf" = 0 ] || why+=" $rf refused lines ($(grep -m1 ': refused: ' "$norm" | cut -c1-160));"
        grep -Eqx "PAX: init /usr/bin/lspc ended with status 0; nothing left to run" "$norm" \
            || why+=" no 'PAX: init /usr/bin/lspc ended with status 0' ($(grep -m1 '^PAX: init ' "$norm"));"
        pn=$(grep -m1 '^PANIC ' "$norm")
        [ -z "$pn" ] || why+=" the kernel panicked: $pn;"
        [ "$hrc" = 0 ] || why+=" not halted ($(grep -m1 'NOT HALTED\|qemu-halt:' "$log.verdict"));"
        [ -z "$why" ] && say "PASS LSP3 $id: -ENOSYS only for '${ns:-none}' (of 273 334); nothing refused by name; init ended, status 0; $(tail -n 1 "$log.verdict")" || bad "LSP3 $id:$why"
    done
done
cat "$runs"
[ "$ran" -gt 0 ] || { bad "LSP3: no boot ran"; exit 1; }
[ "$fail" = 0 ] && say "mpx5-lsp: PASS" || say "mpx5-lsp: FAIL"
exit "$fail"
