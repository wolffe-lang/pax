#!/usr/bin/env python3
"""Exercise the BusyBox fetch with real curl and local HTTP oracles: the archive's and, after it fails, the second
source's (Launchpad's librarian, BUSYBOX_URL2). Last, tests/mpx5-jobs against stub tools: a fetch that fails stops
its build there, by name."""
import contextlib
import hashlib
import http.server
import io
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import threading
import time

ROOT = Path(__file__).resolve().parent.parent
BINARY = b"fixture static binary\n"


def deb_bytes():
    data = io.BytesIO()
    with tarfile.open(fileobj=data, mode="w:gz") as archive:
        info = tarfile.TarInfo("./usr/bin/busybox")
        info.size = len(BINARY)
        info.mode = 0o755
        archive.addfile(info, io.BytesIO(BINARY))
    payload = data.getvalue()
    header = f"{'data.tar.gz':<16}{0:<12}{0:<6}{0:<6}{'100644':<8}{len(payload):<10}`\n"
    return b"!<arch>\n" + header.encode() + payload + (b"\n" if len(payload) % 2 else b"")


class Oracle(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.server.requests.append(time.monotonic())
        index = min(len(self.server.requests) - 1, len(self.server.statuses) - 1)
        status = self.server.statuses[index]
        payload = self.server.payload if status == 200 else b"try again\n"
        self.send_response(status)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *args):
        pass


@contextlib.contextmanager
def oracle(statuses, payload):
    server = http.server.HTTPServer(("127.0.0.1", 0), Oracle)
    server.statuses = statuses
    server.payload = payload
    server.requests = []
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        yield server
    finally:
        server.shutdown()
        server.server_close()
        thread.join(timeout=2)


def script(path, text):
    path.write_text("#!/bin/sh\n" + text)
    path.chmod(0o755)


def calls(lines):
    """curl's arguments, one list per call (the stub writes a `=== call` line before each)."""
    out = []
    for line in lines:
        if line == "=== call":
            out.append([])
        elif out:
            out[-1].append(line)
    return out


def run_case(name, statuses, *, corrupt=False, bad_binary=False, cached=False, timeout=False,
             second=(404,), second_corrupt=False):
    archive = deb_bytes()
    with tempfile.TemporaryDirectory(prefix="busybox-fetch-") as temp:
        work = Path(temp)
        for directory in ("tools", "user", "bin", "home", "tmp"):
            (work / directory).mkdir()
        for tool in ("fetch-busybox", "lib.sh"):
            shutil.copyfile(ROOT / "tools" / tool, work / "tools" / tool)
        # Extraction is real ar/tar. The fixture is not an executable, so only
        # readelf's format report is a stub; both digest checks remain real.
        script(work / "bin/readelf", 'case "$1" in -hW) echo "Type: EXEC";; -lW) echo "LOAD";; *) exit 2;; esac\n')
        script(work / "bin/zstd", 'exit 99\n')  # the fixture uses gzip
        real_curl = shutil.which("curl")
        assert real_curl, "curl missing"
        if timeout:
            script(work / "bin/curl", 'echo "=== call" >> "$CURL_ARGS"\nprintf "%s\\n" "$@" >> "$CURL_ARGS"\n'
                   'echo "curl: (28) Operation timed out" >&2\nexit 28\n')
        else:
            script(work / "bin/curl", 'echo "=== call" >> "$CURL_ARGS"\nprintf "%s\\n" "$@" >> "$CURL_ARGS"\nexec '
                   + shlex.quote(real_curl) + ' "$@"\n')
        with oracle(statuses, b"corrupt" if corrupt else archive) as server, \
                oracle(list(second), b"corrupt" if second_corrupt else archive) as librarian:
            binary_digest = hashlib.sha256(b"wrong" if bad_binary else BINARY).hexdigest()
            url = f"http://127.0.0.1:{server.server_port}/busybox.deb"
            url2 = f"http://127.0.0.1:{librarian.server_port}/librarian/busybox.deb"
            (work / "user/busybox.pin").write_text(
                f"BUSYBOX_URL={url}\n"
                f"BUSYBOX_URL2={url2}\n"
                f"BUSYBOX_DEB_SHA256={hashlib.sha256(archive).hexdigest()}\n"
                f"BUSYBOX_SHA256={binary_digest}\n")
            env = dict(os.environ, PATH=str(work / "bin") + ":" + os.environ["PATH"],
                       HOME=str(work / "home"), SHELL="/bin/sh", TMPDIR=str(work / "tmp"),
                       CURL_ARGS=str(work / "curl.args"), NO_PROXY="127.0.0.1", no_proxy="127.0.0.1")
            env.pop("PAX_CACHE", None)
            env.pop("PAX_BUILD", None)
            argv = ["bash", str(work / "tools/fetch-busybox"), str(work / "out")]
            result = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=15)
            requests = list(server.requests)
            second_requests = list(librarian.requests)
            args = (work / "curl.args").read_text().splitlines()
            each = calls(args)
            bounded = all(flag in args and args[args.index(flag) + 1] == value for flag, value in
                          [("--connect-timeout", "10"), ("--max-time", "25"),
                           ("--retry", "2"), ("--retry-max-time", "90")])
            bounded = bounded and "--retry-all-errors" in args and "--retry-delay" not in args
            # The second source: one attempt, bounded the same way (10 s to connect, 25 s), so both fit the
            # USB suite's 120 s fetch phase; tried only when the first source could not be fetched.
            tried = len(each) > 1 and url2 in each[1]
            if tried:
                two = each[1]
                bounded = bounded and "--retry" not in two and all(
                    flag in two and two[two.index(flag) + 1] == value for flag, value in
                    [("--connect-timeout", "10"), ("--max-time", "25")])
            first_failed = timeout or (statuses[-1] != 200 and not corrupt and not bad_binary)
            named = f"cannot fetch {url}; from Launchpad's librarian, {url2}" in result.stderr
            if timeout:
                good = result.returncode == 2 and "Operation timed out" in result.stderr and tried and named
                good = good and f"cannot fetch {url} or {url2}" in result.stderr
            elif corrupt or bad_binary:
                good = result.returncode == 2 and "sha256" in result.stderr and not (work / "out/busybox").exists()
            elif statuses[-1] != 200 and second[-1] == 200 and second_corrupt:
                good = result.returncode == 2 and named and f"{url2}: sha256" in result.stderr
                good = good and not (work / "out/busybox").exists() and len(second_requests) == 1
            elif statuses[-1] != 200 and second[-1] == 200:
                good = result.returncode == 0 and (work / "out/busybox").read_bytes() == BINARY
                good = good and len(requests) == 3 and len(second_requests) == 1 and named
            elif statuses[-1] != 200:
                good = result.returncode == 2 and len(requests) == 3 and not (work / "out/busybox").exists()
                good = good and len(second_requests) == 1 and named and f"cannot fetch {url} or {url2}" in result.stderr
            else:
                good = result.returncode == 0 and (work / "out/busybox").read_bytes() == BINARY
                good = good and len(requests) == len(statuses)
            if not first_failed:
                good = good and not second_requests and not tried
            if len(statuses) >= 3 and statuses[:2] == [503, 503] and len(requests) == 3:
                good = good and requests[1] - requests[0] >= 0.8 and requests[2] - requests[1] >= 1.8
            if cached and good:
                (work / "curl.args").unlink()
                again = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=5)
                good = again.returncode == 0 and not (work / "curl.args").exists() and len(server.requests) == 1
            good = good and bounded
            print(f"{'PASS' if good else 'FAIL'} {name} exit={result.returncode} requests={len(requests)}"
                  f" second={len(second_requests)} bounded={bounded}")
            if not good:
                print(json.dumps({"args": args, "stderr": result.stderr}))
            return good


def run_jobs_stop(name):
    """tests/mpx5-jobs --only build with a tools/fetch-busybox that cannot fetch, every other tool a stub that
    records its name: J0 stops at the fetch, by name, exit 2, and no tool after it runs."""
    with tempfile.TemporaryDirectory(prefix="busybox-stop-") as temp:
        work = Path(temp)
        for directory in ("tools", "tests", "bin", "home", "tmp", "build"):
            (work / directory).mkdir()
        shutil.copyfile(ROOT / "tests/mpx5-jobs", work / "tests/mpx5-jobs")
        shutil.copytree(ROOT / "tests/mpx5-jobs.d", work / "tests/mpx5-jobs.d")
        shutil.copyfile(ROOT / "tools/lib.sh", work / "tools/lib.sh")
        for tool in sorted(p.name for p in (ROOT / "tools").iterdir() if p.is_file() and p.name != "lib.sh"):
            if tool == "fetch-busybox":
                script(work / "tools" / tool, 'echo fetch-busybox >> "$CALLS"\n'
                       'echo "fetch-busybox: cannot fetch http://127.0.0.1:9/a.deb or http://127.0.0.1:9/b.deb" >&2\nexit 2\n')
            else:
                script(work / "tools" / tool, 'echo %s >> "$CALLS"\n' % tool)
        script(work / "bin/wolf", 'echo "wolf 0.0.0 (a stub)"\n')
        script(work / "bin/readelf", 'exit 0\n')
        env = dict(os.environ, PATH=str(work / "bin") + ":" + os.environ["PATH"], HOME=str(work / "home"),
                   SHELL="/bin/sh", TMPDIR=str(work / "tmp"), CALLS=str(work / "calls"),
                   PAX_WOLF=str(work / "bin/wolf"), PAX_BUILD=str(work / "build"))
        env.pop("PAX_CACHE", None)
        argv = ["bash", str(work / "tests/mpx5-jobs"), "--only", "build", "--tier", "native", "--firmware", "bios"]
        try:
            result = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=60)
        except subprocess.TimeoutExpired:
            print(f"FAIL {name}: tests/mpx5-jobs did not stop within 60 s")
            return False
        called = (work / "calls").read_text().split() if (work / "calls").exists() else []
        after = called[called.index("fetch-busybox") + 1:] if "fetch-busybox" in called else None
        said = "FAIL J0: tools/fetch-busybox could not fetch BusyBox; nothing after it ran" in result.stdout + result.stderr
        good = result.returncode == 2 and after == [] and said and "cannot fetch" in result.stderr
        print(f"{'PASS' if good else 'FAIL'} {name} exit={result.returncode} tools after the fetch={after}")
        if not good:
            print(json.dumps({"called": called, "stdout": result.stdout[-1500:], "stderr": result.stderr[-1500:]}))
        return good


def main():
    cases = [
        ("busybox-first-transfer", [200], {}),
        ("busybox-retry-recovery", [503, 200], {}),
        ("busybox-exponential-backoff", [503, 503, 200], {}),
        ("busybox-retry-exhausted", [503], {}),
        ("busybox-deb-digest", [200], {"corrupt": True}),
        ("busybox-binary-digest", [200], {"bad_binary": True}),
        ("busybox-cache-verified", [200], {"cached": True}),
        ("busybox-timeout-diagnostic", [200], {"timeout": True}),
        ("busybox-second-source", [503], {"second": (200,)}),
        ("busybox-second-digest", [503], {"second": (200,), "second_corrupt": True}),
        ("busybox-both-fail", [503], {"second": (503,)}),
    ]
    passed = sum(run_case(name, statuses, **options) for name, statuses, options in cases)
    passed += run_jobs_stop("busybox-stops-mpx5-jobs")
    print(f"fetch-busybox: {passed}/{len(cases) + 1}, 0 SKIP")
    return passed != len(cases) + 1


if __name__ == "__main__":
    sys.exit(main())
