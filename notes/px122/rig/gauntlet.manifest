# notes/px122/rig/gauntlet.manifest — px122's green take at the head (take.sh, a light take: Python, shell
# and KVM boots): the plan job's checks (the budgets among them) and tests/mpx6-bootlog on both tiers and
# firmwares with KVM, which prints /proc/pax-boot's text and holds it line for line (kernel/procfs's
# change). The kernel's build times are kernel.manifest's takes, on a block.
floor 25
rig lib.sh committed=../../..:HEAD:notes/px122/rig/lib.sh
rig engine-local committed=../../..:HEAD:notes/px122/rig/engine-local
rig gauntlet.manifest committed=../../..:HEAD:notes/px122/rig/gauntlet.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3,git script=step.sh -- ci-plan
step budgets image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- budgets
step selftests image=localhost/px75-ubuntu:2 tools=python3,bash script=step.sh -- selftests
step bootlog image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,mke2fs,debugfs script=step.sh -- bootlog --tier both --firmware both
