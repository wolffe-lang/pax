# notes/px122/rig/kernel.manifest — one commit's kernel build take (take.sh): kmain_console alone,
# native then release, each timed (wall seconds, the compiler's peak resident set), in a container of
# CI's shape. Taken at the last green trunk, at each of #344's kernel commits in turn, and at trunk.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px122/rig/lib.sh
rig stamped.py committed=../../..:HEAD:notes/px122/rig/stamped.py
rig kernel.manifest committed=../../..:HEAD:notes/px122/rig/kernel.manifest
step native image=localhost/px75-ubuntu:2 tools=clang,readelf,python3,git,curl script=step.sh -- kernel native
step release image=localhost/px75-ubuntu:2 tools=clang,readelf,python3,git,curl script=step.sh -- kernel release
