# notes/px122/rig/budget.manifest — the plan job's checks at one commit (take.sh): the planner's
# rows, the long jobs' budgets (mpx3-shell's and mpx5-pelt's rows among them) and its other
# selftests, each in a container of CI's shape. Python and shell only: a light take. Taken at the
# rows' commit (red: the limits not yet raised), at the head (green) and at the plant (red by name).
floor 25
rig lib.sh committed=../../..:HEAD:notes/px122/rig/lib.sh
rig budget.manifest committed=../../..:HEAD:notes/px122/rig/budget.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3,git script=step.sh -- ci-plan
step budgets image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- budgets
step selftests image=localhost/px75-ubuntu:2 tools=python3,bash script=step.sh -- selftests
