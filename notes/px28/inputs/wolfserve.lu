// px28 probe (kept as evidence, not built by any test): does a wolf server that must WAIT for its connection run on trunk's PAX?
fn main() -> !int {
    let srv = net_listen("0.0.0.0:7070")?
    let port = net_port(srv)?
    print("wolfserve: listening on port {port}")
    let conn = net_accept(srv)?
    let msg = net_read(conn, 256)?
    print("wolfserve: read {msg.len} bytes: {msg.trim()}")
    net_write(conn, "the wolf heard: {msg.trim()}\n")?
    net_close(conn)?
    net_close(srv)?
    print("wolfserve: one request served")
    0
}
