// px28 probe (kept as evidence, not built by any test): accept only after the connection is queued (a sleep first), then read what is already there.
fn main() -> !int {
    let srv = net_listen("0.0.0.0:7070")?
    print("wolfsleep: listening on port {net_port(srv)?}")
    time_sleep_ms(8000)
    let conn = net_accept(srv)?
    let msg = net_read(conn, 256)?
    print("wolfsleep: read {msg.len} bytes: {msg.trim()}")
    net_write(conn, "the wolf heard: {msg.trim()}\n")?
    net_close(conn)?
    net_close(srv)?
    0
}
