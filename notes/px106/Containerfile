# px106: the throwaway Ubuntu 24.04 of notes/px106/auth-ct.sh (localhost/px106-auth:1): px103's
# base digest, its sudo, and python3 (tools/linux-tty) and whois (mkpasswd), each pinned; no
# network at run time. login, passwd and su (util-linux) are the base image's own.
FROM docker.io/library/ubuntu@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends sudo=1.9.15p5-3ubuntu5.24.04.4 python3=3.12.3-0ubuntu2.1 whois=5.5.22 && rm -rf /var/lib/apt/lists/* \
 && dpkg-query -W -f='${Package} ${Version}\n' sudo login passwd util-linux libc6 libpam-modules libpam-runtime libcrypt1 python3 whois > /px106-versions.txt \
 && sha256sum /usr/bin/sudo /usr/bin/su /usr/bin/login /usr/bin/passwd /usr/bin/mkpasswd >> /px106-versions.txt && dpkg -S /usr/bin/login /usr/bin/su /usr/bin/passwd >> /px106-versions.txt
