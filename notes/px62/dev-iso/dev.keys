su pax
cd
id
whoami
wolf --version
cat > hello.lu
^~//! member: false
^~fn main() -> !int {
^~    print("written on PAX, checked by wolf")
^~    0
^~}
^~^D
wolf fmt hello.lu
wolf fmt --check hello.lu; echo fmt=$?
wolf conform-run --json --phase=typecheck hello.lu
wolf conform-run --json --checked hello.lu
wolf build --no-cache --emit=obj hello.lu -o hello.o; echo object=$?
wolf build hello.lu; echo build=$?
./hello; echo native=$?
wolf build --release --no-cache hello.lu -o release; echo release=$?
cd /bin
../home/pax
pwd
exit
exit
