//! HID 1.11 appendix B/C boot reports and HUT 1.7 section 10.
//! Reports are packed little-endian: modifiers, reserved, six usage bytes.
//! No implementation source consulted. Console owns the character table;
//! this table names the same physical keys as its set-1 input adapter.

pub fn key_at(report: u64, index: u64) -> u64 {
    if index >= 6 { return 0 }
    (report >> (16 + index * 8)) & 255
}

pub fn contains(report: u64, usage: u64) -> bool {
    if usage == 0 { return false }
    var i: u64 = 0
    while i < 6 {
        if key_at(report, i) == usage { return true }
        i += 1
    }
    false
}

/// ErrorRollOver, POSTFail and ErrorUndefined preserve the prior key state.
pub fn valid(report: u64) -> bool {
    var i: u64 = 0
    while i < 6 {
        let k = key_at(report, i)
        if k > 0 && k < 4 { return false }
        i += 1
    }
    true
}

/// Low seven bits: set-1 physical key; bit 8: extended key. 0: unmapped.
pub fn code(usage: u64) -> u64 {
    if usage >= 0x1e && usage <= 0x27 { return usage - 0x1c }
    if usage >= 0x3a && usage <= 0x43 { return usage + 1 }
    match usage {
        4 => 0x1e, 5 => 0x30, 6 => 0x2e, 7 => 0x20, 8 => 0x12,
        9 => 0x21, 10 => 0x22, 11 => 0x23, 12 => 0x17, 13 => 0x24,
        14 => 0x25, 15 => 0x26, 16 => 0x32, 17 => 0x31, 18 => 0x18,
        19 => 0x19, 20 => 0x10, 21 => 0x13, 22 => 0x1f, 23 => 0x14,
        24 => 0x16, 25 => 0x2f, 26 => 0x11, 27 => 0x2d, 28 => 0x15,
        29 => 0x2c,
        0x28 => 0x1c, 0x29 => 1, 0x2a => 0x0e, 0x2b => 0x0f,
        0x2c => 0x39, 0x2d => 0x0c, 0x2e => 0x0d, 0x2f => 0x1a,
        0x30 => 0x1b, 0x31 => 0x2b, 0x32 => 0x2b, 0x33 => 0x27,
        0x34 => 0x28, 0x35 => 0x29, 0x36 => 0x33, 0x37 => 0x34,
        0x38 => 0x35, 0x39 => 0x3a, 0x44 => 0x57, 0x45 => 0x58,
        0x49 => 0x152, 0x4a => 0x147, 0x4b => 0x149, 0x4c => 0x153,
        0x4d => 0x14f, 0x4e => 0x151, 0x4f => 0x14d, 0x50 => 0x14b,
        0x51 => 0x150, 0x52 => 0x148, 0x53 => 0x45, 0x54 => 0x135,
        0x55 => 0x37, 0x56 => 0x4a, 0x57 => 0x4e, 0x58 => 0x11c,
        0x59 => 0x4f, 0x5a => 0x50, 0x5b => 0x51, 0x5c => 0x4b,
        0x5d => 0x4c, 0x5e => 0x4d, 0x5f => 0x47, 0x60 => 0x48,
        0x61 => 0x49, 0x62 => 0x52, 0x63 => 0x53,
        0xe0 => 0x1d, 0xe1 => 0x2a, 0xe2 => 0x38,
        0xe4 => 0x11d, 0xe5 => 0x36, 0xe6 => 0x138,
        _ => 0,
    }
}

pub fn repeats(usage: u64) -> bool {
    usage >= 4 && usage < 0xe0 && usage != 0x39 && usage != 0x53 && code(usage) != 0
}
