# px75's rig on hasu: the CI runner's packages (pax's ci.yml apt lines) on Ubuntu 24.04,
# so QEMU, OVMF, gcc and xorriso are the versions CI boots with. Nothing of the host's.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      qemu-system-x86 ovmf xorriso clang lld binutils gcc libc6-dev gdb python3 cpio mtools dosfstools \
      zstd xz-utils file git curl ca-certificates e2fsprogs util-linux bsdextrautils make procps \
    && rm -rf /var/lib/apt/lists/*
