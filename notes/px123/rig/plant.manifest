# notes/px123/rig/plant.manifest — the plant's take (px123-plant-sigint, one commit over the green
# head: the hook's line put back, burrowd started with SIGINT and SIGQUIT ignored): the burrowd suite
# native on BIOS, where B27 (burrowd's own SigIgn) says FAIL by name at column 0.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px123/rig/lib.sh
rig plant.manifest committed=../../..:HEAD:notes/px123/rig/plant.manifest
step burrowd-native-bios image=localhost/px123-net:1 tools=qemu-system-x86_64,python3,ssh,dnsmasq script=step.sh -- burrowd --tier native --firmware bios
