# notes/px123/rig/gauntlet.manifest — px123's green take at the head (take.sh, the recorder's steps
# mode with --keep-going and --preflight): the planner's test; the census (burrow's pin against the
# image's inside); the installer's units; the burrowd suite on all four legs (the image with the moved
# pin and the hook, B0-B27: the terminal over ssh, Ctrl-C, Ctrl-\, Ctrl-Z, burrowd's own SigIgn); the
# push suite native on BIOS (the moved pin's /bin/ssh); the USB suite native on BIOS (docs/SOURCES.md's
# usbredir row). These are the plan's five suites (census, mpx4-console-push, mpx5-burrowd,
# mpx6-install, mpx6-usb), the installer by its units.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px123/rig/lib.sh
rig gauntlet.manifest committed=../../..:HEAD:notes/px123/rig/gauntlet.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step census image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- census
step install-units image=localhost/px123-net:1 tools=python3 script=step.sh -- install-units
step burrowd-all image=localhost/px123-net:1 tools=qemu-system-x86_64,python3,ssh,dnsmasq script=step.sh -- burrowd --tier both --firmware both
step push-native-bios image=localhost/px123-net:1 tools=qemu-system-x86_64,python3,ssh script=step.sh -- push --tier native --firmware bios
step usb-native-bios image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf script=step.sh -- usb --tier native --firmware bios
