# notes/px123/rig/pelt.manifest — a second green take at the head (take.sh, the recorder's steps mode with
# --keep-going and --preflight): the suites that type into pelt and wait for `$ `, which pelt b80d657 (on by
# default: friendly) made red until each asked for it off. Native BIOS, the merge gate's leg; their Linux
# sides in the take's container (ctr sys). Its own record, so neither take holds a block past two hours.
# mpx3-shell is left out: on this host's kernel its shell-long row is red at trunk too (Linux's tmpfs
# counts /bin/ls one page more than the 3746 its bytes fill: st_blocks 29976, PAX's 29968); its other
# rows were taken by hand, and the hosted run holds it whole.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px123/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px123/rig/engine-ns
rig pelt.manifest committed=../../..:HEAD:notes/px123/rig/pelt.manifest
step screen image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,xorriso script=step.sh -- pelt mpx3-screen --tier native --firmware bios
step console image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,xorriso,unshare script=step.sh -- pelt mpx3-console --tier native --firmware bios
step session image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,xorriso,unshare script=step.sh -- pelt mpx4-session --tier native --firmware bios
step speaker image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,xorriso script=step.sh -- pelt mpx3-speaker --tier native --firmware bios
step lobo image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,xorriso,unshare script=step.sh -- pelt mpx4-lobo --tier native --firmware bios
step tree image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,xorriso,unshare script=step.sh -- pelt mpx3-tree --tier native --firmware bios
