cd /home/pax
cd /
sudo -n true
pax-install --check
echo PX114-CENSUS=begin
for d in /* /.[!.]*; do case $d in /dev|/proc|/sys) ls -land --full-time "$d" ;; *) ls -laRn --full-time "$d" ;; esac; done
for f in /var/lib/dhcp/pax.lease /etc/resolv.conf /.sh_history /var/log/sudo.log /.local/share/lope/store; do echo "== $f"; sha256sum "$f"; cat "$f"; done
echo PX114-CENSUS=end
exit 0
