# notes/px129/rig/flood.manifest — what a console flood leaves the network (R-px129-13): tests/mpx3-conflood
# under KVM, native BIOS, its three modes, each with no COM1 and with COM1 drained at 115200 baud (R-px129-15);
# a perf take (both of the host's heavy locks, nothing beside it).
# F2 is red until the console stops holding interrupts off across a whole write.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig flood.manifest committed=../../..:HEAD:notes/px129/rig/flood.manifest
step flood image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl script=step.sh -- flood --accel kvm --firmware bios
