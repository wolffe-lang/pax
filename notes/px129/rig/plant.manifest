# notes/px129/rig/plant.manifest — the plant's take (px129-plant-*: the head with one hunk that
# draws every touched cell whether or not it changed): the new suite on native UEFI, red by name.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig plant.manifest committed=../../..:HEAD:notes/px129/rig/plant.manifest
step conspeed image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl script=step.sh -- conspeed --tier native --firmware uefi
