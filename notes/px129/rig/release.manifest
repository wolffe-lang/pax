# notes/px129/rig/release.manifest — quick.manifest's suites on the release tier (wolf's optimised kernels and
# programs): mpx3-conspeed's two legs (no COM1, and COM1 drained at 115200 baud: C9, C10) on both firmwares;
# the screen pixel for pixel and the scroll's ways (mpx3-screen) on both; the VT's rows (mpx5-screen), the games'
# frames (mpx6-games), the pointer (mpx6-pointer) and the typed sessions (mpx3-console), BIOS; pseudo-terminals
# (mpx5-pty), both firmwares, KVM and TCG. Every suite here reads COM1.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig release.manifest committed=../../..:HEAD:notes/px129/rig/release.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step conspeed image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl script=step.sh -- conspeed --tier release --firmware both
step screen image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- screen --tier release --firmware both
step vt image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- vt --tier release --firmware bios
step games image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- games --tier release --firmware bios
step pointer image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- pointer --tier release --firmware bios
step console image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- console --tier release --firmware bios
step pty image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- pty --tier release --firmware both --accel both
