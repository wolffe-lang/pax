# notes/px129/rig/norms.manifest — T2's mask (tests/mpx6-triage.d/mask) and V4's strip (tests/mpx3-screen.d/v4-strip)
# held to their fixtures: pairs from hosted runs' logs that must compare alike (kernel/timer's calibration lines in
# their documented forms; the attach probe's way) or apart. No boot.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig norms.manifest committed=../../..:HEAD:notes/px129/rig/norms.manifest
step norms image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- norms
