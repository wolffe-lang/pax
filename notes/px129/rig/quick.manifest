# notes/px129/rig/quick.manifest — px129's quick checks at the head (the orchestrator's word: full
# records later): the planner's test; the new suite on native, both firmwares; the screen pixel for
# pixel and the scroll's ways (mpx3-screen), the VT's rows (mpx5-screen), the games' frames
# (mpx6-games), the pointer (mpx6-pointer) and the typed sessions (mpx3-console), native, BIOS.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig quick.manifest committed=../../..:HEAD:notes/px129/rig/quick.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step conspeed image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl script=step.sh -- conspeed --tier native --firmware both
step screen image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- screen --tier native --firmware both
step vt image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- vt --tier native --firmware bios
step games image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- games --tier native --firmware bios
step pointer image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- pointer --tier native --firmware bios
step console image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- console --tier native --firmware bios
