# notes/px129/rig/fbmap.manifest — the framebuffer's mapping on record and write-combining whatever the
# bootloader left in IA32_PAT (R-px129-14): tests/mpx6-bootlog's groups A (A1 the console's and
# /proc/pax-boot's fbmap and scroll; A2 `pax.patdefault`, no WC entry, programmed), native, both
# firmwares, each an ISO. Group K (boot.log keeps the lines) needs an ext2 volume, which tools/e2fs makes
# in a container of its own: not inside the rig's container; CI's Docker runs it.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig fbmap.manifest committed=../../..:HEAD:notes/px129/rig/fbmap.manifest
step bootlog image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,xorriso,mcopy,mtype,debugfs,curl script=step.sh -- bootlog A --tier native --firmware both
