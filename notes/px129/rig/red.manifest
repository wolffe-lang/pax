# notes/px129/rig/red.manifest — the red take at the rows' commit (the rows before the fix): the
# new suite on native UEFI, where every row but the table and yew's keypress is out of bounds
# (`FAIL C2 …` to `FAIL C8 …` at column 0).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig red.manifest committed=../../..:HEAD:notes/px129/rig/red.manifest
step conspeed image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl script=step.sh -- conspeed --tier native --firmware uefi
