# notes/px129/rig/uart.manifest — a console write and a slow UART (R-px129-15): tests/mpx3-conspeed's
# slow-UART leg (COM1 drained at 115200 baud by tests/mpx3-conspeed.d/uart.py), native BIOS: C1, C8, C9, C10.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig uart.manifest committed=../../..:HEAD:notes/px129/rig/uart.manifest
step conspeed image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl script=step.sh -- conspeed --tier native --firmware bios --uart slow
