# notes/px129/rig/pty-rate.manifest — mpx5-pty's session as a rate (pax#382): the session image booted 20
# times, native BIOS under TCG (the hosted leg's accelerator), each run's rows checked as the suite does
# (pty-rate.sh); red when any boot's session-root or session-user differs from Linux's.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px129/rig/lib.sh
rig pty-rate.manifest committed=../../..:HEAD:notes/px129/rig/pty-rate.manifest
rig pty-rate.sh committed=../../..:HEAD:notes/px129/rig/pty-rate.sh
step ptyrate image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf,git,curl script=step.sh -- ptyrate 20 tcg bios
