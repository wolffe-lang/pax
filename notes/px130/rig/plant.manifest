# notes/px130/rig/plant.manifest — the plant's take (px130-plant-level, one commit over the final head:
# kernel/log draws every line on the screen whatever its level): the burrowd suite native on BIOS, where B40 (the
# console's screen after a SIGPIPE over ssh) says FAIL by name at column 0.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig plant.manifest committed=../../..:HEAD:notes/px130/rig/plant.manifest
step burrowd-native-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,ssh,dnsmasq script=step.sh -- burrowd --tier native --firmware bios
