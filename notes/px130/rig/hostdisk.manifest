# notes/px130/rig/hostdisk.manifest — the two rows of the killed-line suites that compare `ls -l`'s total with
# Linux's for the same tree (mpx3-shell's S2 shell-long, mpx4-session's E2 session-shell), native on BIOS at the
# final head, on a build host whose disk keeps a copy of a 15 MB program in at most four extents: a host whose
# disk splits it further gives Linux's side an ext4 index block more than the file's pages, and those rows red.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig hostdisk.manifest committed=../../..:HEAD:notes/px130/rig/hostdisk.manifest
step mpx3-shell image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-shell --tier native --firmware bios
step mpx4-session image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx4-session --tier native --firmware bios
