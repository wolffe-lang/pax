# notes/px130/rig/red.manifest — the rows' take at the rows' commit (the kernel and the images as trunk has them):
# the kernel-log probe against Linux's recording (no /dev/kmsg, no syslog(2): M1 and M2 red) and the burrowd
# suite's B40-B43 (the line drawn over the console, no dmesg, no /dev/kmsg: red), native on BIOS.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig red.manifest committed=../../..:HEAD:notes/px130/rig/red.manifest
step kmsg-native-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- kmsg --tier native --firmware bios
step burrowd-native-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,ssh,dnsmasq script=step.sh -- burrowd --tier native --firmware bios
