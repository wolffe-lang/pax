# notes/px130/rig/dev.manifest — a development take (take.sh): the suites px130 changed, native on BIOS: the
# kernel-log probe against Linux's recording, the burrowd suite's installed shape (B40-B43 the console's screen,
# dmesg and the console level), the users' privilege probe (/dev/kmsg's rows), and the screen suite.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig dev.manifest committed=../../..:HEAD:notes/px130/rig/dev.manifest
step kmsg-native image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- kmsg --tier native --firmware both
step burrowd-native-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,ssh,dnsmasq script=step.sh -- burrowd --tier native --firmware bios
step users-native-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx5-users --tier native --firmware bios
step screen-native-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc,clang,readelf,xorriso script=step.sh -- suite mpx3-screen --tier native --firmware bios
