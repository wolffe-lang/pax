# notes/px130/rig/killed1.manifest — the suites that read the kernel's `killed:` lines (or its screen) from the
# serial port, the programs and the console's, native on BIOS at the final head: the serial port keeps every line, so each
# passes unchanged.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig killed1.manifest committed=../../..:HEAD:notes/px130/rig/killed1.manifest
step mpx3-user image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-user --tier native --firmware bios
step mpx3-loader image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-loader --tier native --firmware bios
step mpx3-boreutils image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-boreutils --tier native --firmware bios
step mpx3-threads image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-threads --tier native --firmware bios
step mpx3-maps image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-maps --tier native --firmware bios
step mpx3-tree image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-tree --tier native --firmware bios
step mpx3-shell image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-shell --tier native --firmware bios
