# notes/px130/rig/killed2.manifest — the suites that read the kernel's `killed:` lines (or its screen) from the
# serial port, the network's, native on BIOS at the final head: the serial port keeps every line, so each
# passes unchanged.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig killed2.manifest committed=../../..:HEAD:notes/px130/rig/killed2.manifest
step mpx4-udp image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx4-udp --tier native --firmware bios
step mpx4-tcp image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx4-tcp --tier native --firmware bios
step mpx4-unix image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx4-unix --tier native --firmware bios
step mpx4-ready image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx4-ready --tier native --firmware bios
step mpx4-session image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx4-session --tier native --firmware bios
step mpx4-lobo image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx4-lobo --tier native --firmware bios
