# notes/px130/rig/killed3.manifest — the suites that read the kernel's `killed:` lines (or its screen) from the
# serial port, the accounts', the disks', the screen's and the boot record's, native on BIOS at the final head: the serial port keeps every line, so each
# passes unchanged.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig killed3.manifest committed=../../..:HEAD:notes/px130/rig/killed3.manifest
step mpx5-accounts image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx5-accounts --tier native --firmware bios
step mpx5-forks image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx5-forks --tier native --firmware bios
step mpx6-journal image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx6-journal --tier native --firmware bios
step mpx6-root image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx6-root --tier native --firmware bios
step mpx3-screen image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-screen --tier native --firmware bios
step mpx5-screen image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx5-screen --tier native --firmware bios
step mpx6-bootlog image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx6-bootlog --tier native --firmware bios
