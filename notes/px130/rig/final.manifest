# notes/px130/rig/final.manifest — px130's one gauntlet at the final head (take.sh; the build host's locks): the
# planner's test, the census, then the suites px130 changed on the release tier beside the native one: the
# kernel-log probe against Linux's recording (both firmwares), the burrowd suite's installed shape (B40-B43:
# the console's screen, dmesg, the console level) and the users' privilege probe (/dev/kmsg's rows), BIOS; since
# the rebase onto pax#379, px129's console speed (mpx3-conspeed: kernel/serial's `put` is the screen's and then
# `put_wire`, on the path it times, and its rows against the CPU's unit are held by KVM records alone).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig final.manifest committed=../../..:HEAD:notes/px130/rig/final.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step census image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- census
step kmsg-both image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- kmsg --tier both --firmware both
step burrowd-both-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,ssh,dnsmasq script=step.sh -- burrowd --tier both --firmware bios
step users-both-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx5-users --tier both --firmware bios
step conspeed-both-bios image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx3-conspeed --tier both --firmware bios
