# notes/px130/rig/disks.manifest — the suites of the killed-line set that build ext2 disks through the engine
# (tools/e2fs, tools/disktools): the journal's, the root's and the boot record's (px118's, which takes every byte
# kernel/log sends the wire), native on BIOS at the final head.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px130/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px130/rig/engine-ns
rig disks.manifest committed=../../..:HEAD:notes/px130/rig/disks.manifest
step mpx6-bootlog image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx6-bootlog --tier native --firmware bios
step mpx6-journal image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx6-journal --tier native --firmware bios
step mpx6-root image=localhost/px130-net:1 tools=qemu-system-x86_64,python3,cc script=step.sh -- suite mpx6-root --tier native --firmware bios
