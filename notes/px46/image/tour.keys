cat /etc/motd
id
whoami
ls /
ls /bin | wc -l
cut -d: -f1,3,6,7 /etc/passwd
kill -l
ls -ln /home/pax
su pax
id
groups
echo $HOME $USER $LOGNAME $SHELL
cat /etc/secret
echo $?
ls /root
cat /home/pax/notes/todo
kill 1
echo $?
echo mine > /tmp/paxfile
ls -l /tmp
rm /tmp/paxfile
su
echo $?
exit
id
su - pax -c id
su - pax -c 'pwd; env'
su -s /bin/pelt lobo -c 'id; ls /srv/lobo'
trap 'echo caught INT' INT
^C^.
^~echo after the trap
trap - INT
sleep 30
^~^C^.
echo $?
exit
