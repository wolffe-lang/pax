# notes/px120/rig/short.manifest — the red take at the rows' tip (the hot-plug rows before the
# kernel's change): the hot-plug session on native BIOS, where pax#348's stream says FAIL by name at
# column 0; and the planner's test and the judge's selftest beside it.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px120/rig/lib.sh
rig short.manifest committed=../../..:HEAD:notes/px120/rig/short.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step build-once image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- build-once
step hotplug image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf script=step.sh -- hotplug --tier native --firmware bios
