# notes/px120/rig/plant.manifest — a plant's take (a px120-plant-* branch, one commit over the green
# head): the hot-plug session on native BIOS and the frame allocator's suite native on BIOS, where
# the rows the plant breaks say FAIL by name at column 0.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px120/rig/lib.sh
rig plant.manifest committed=../../..:HEAD:notes/px120/rig/plant.manifest
step hotplug image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf script=step.sh -- hotplug --tier native --firmware bios
step frames image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,clang,readelf script=step.sh -- frames --tier native --firmware bios
