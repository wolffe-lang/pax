# px87 (pax#246): `quiet` (px15's word, kernel/user): the live session prints
# no line for a program's ordinary life (its exec, its exit, a system call it
# is the first to try that PAX lacks), so the screen holds what the programs
# and the installer write; a refusal, a fault and a bad buffer still print.
timeout: 3

