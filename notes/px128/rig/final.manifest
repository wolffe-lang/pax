# notes/px128/rig/final.manifest — px128's one gauntlet at the final head (take.sh; the build host's
# locks): the quick checks (the planner's test, the census, the source fetches' helper, mkligature's two
# checkouts and the pin's digest) and the rows on the dev image built from the pins at ligature's move
# (r2-642e4b72; nothing the image is built from moved since).
# preflight: r2-642e4b72
floor 35
rig lib.sh committed=../../..:HEAD:notes/px128/rig/lib.sh
rig final.manifest committed=../../..:HEAD:notes/px128/rig/final.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step census image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- census
step fetch-retry image=localhost/px75-ubuntu:2 tools=git script=step.sh -- fetch-retry
step mkligature image=localhost/px75-ubuntu:2 tools=git,curl,cc,readelf,strip script=step.sh -- mkligature
step rows-ligature image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,git,xorriso script=step.sh -- rows r2-642e4b72
