# notes/px128/rig/quick.manifest — px128's quick checks at the head (take.sh, light): the planner's
# test (ligature's pin, builder and rows plan the distribution's checks), the census, the source
# fetches' helper (mkligature among them), and mkligature itself (two checkouts, one digest, the pin's).
# preflight:
floor 35
rig lib.sh committed=../../..:HEAD:notes/px128/rig/lib.sh
rig quick.manifest committed=../../..:HEAD:notes/px128/rig/quick.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step census image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- census
step fetch-retry image=localhost/px75-ubuntu:2 tools=git script=step.sh -- fetch-retry
step mkligature image=localhost/px75-ubuntu:2 tools=git,curl,cc,readelf,strip script=step.sh -- mkligature
