cd
id
ld.lld --version
wolf build --no-cache /usr/share/wolf/hello.lu -o hello; echo link-hello=$?
./hello; echo native-hello=$?
wolf build --no-cache /usr/share/wolf/loop.lu -o loop; echo link-loop=$?
./loop; echo native-loop=$?
wolf build --no-cache /usr/share/wolf/signal.lu -o signal; echo link-signal=$?
./signal; echo native-signal=$?
exit
