$ cd
$ id
uid=1000 gid=1000 groups=1000
$ ld.lld --version
LLD 17.0.6 (compatible with GNU linkers)
$ wolf build --no-cache /usr/share/wolf/hello.lu -o hello; echo link-hello=$?
link-hello=0
$ ./hello; echo native-hello=$?
hello, wolf
native-hello=0
$ wolf build --no-cache /usr/share/wolf/loop.lu -o loop; echo link-loop=$?
link-loop=0
$ ./loop; echo native-loop=$?
1 squared is 1
2 squared is 4
3 squared is 9
4 squared is 16
5 squared is 25
6 squared is 36
7 squared is 49
8 squared is 64
9 squared is 81
10 squared is 100
the sum of the squares: 385
native-loop=0
$ wolf build --no-cache /usr/share/wolf/signal.lu -o signal; echo link-signal=$?
link-signal=0
$ ./signal; echo native-signal=$?
INTERRUPT is signal 2 here
its words: Interrupt
native-signal=0
$ exit
