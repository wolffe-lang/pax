# px88: px75's image (QEMU 8.2.2, OVMF, clang, lld 18, gcc, xorriso) and
# Ubuntu 24.04's musl-tools (musl-gcc, the packaged static musl: never
# built from musl's source), the toolchain CI's runner gets from apt for
# tests/mpx5-forks, and strace for black-box Linux observation.
FROM localhost/px75-ubuntu:2
RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      musl-tools strace && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W musl musl-dev musl-tools gcc strace > /etc/px88-packages.txt
