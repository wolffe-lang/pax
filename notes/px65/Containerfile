# px65 (px64's recipe, unchanged): the lane's own baseline: Ubuntu 24.04 by digest (the CI runner's release and
# scent's oracle base), the packages px13-ubuntu carries for building PAX
# and its programs, plus QEMU and OVMF so the boots run in the same
# container, under TCG as CI's do. Never kasumi's CachyOS glibc.
FROM docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
        gcc libc6-dev strace binutils file python3 curl ca-certificates git busybox-static clang lld make xorriso \
        qemu-system-x86 ovmf cpio xz-utils \
    && rm -rf /var/lib/apt/lists/*
ENV LC_ALL=C CARGO_INCREMENTAL=0
