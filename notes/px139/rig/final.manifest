engine podman --memory 12g
floor 35
rig final.manifest committed=../../..:HEAD:notes/px139/rig/final.manifest
rig step.sh committed=../../..:HEAD:notes/px139/rig/step.sh
step mask image=localhost/px75-ubuntu:2 tools=bash,python3,sed script=step.sh -- norms
step ci-plan image=localhost/px75-ubuntu:2 tools=python3,bash script=step.sh -- ci-plan
step triage-native image=localhost/px75-ubuntu:2 tools=bash,python3,cc,ld.lld,qemu-system-x86_64,xorriso script=step.sh -- triage --tier native --firmware both
step triage-release image=localhost/px75-ubuntu:2 tools=bash,python3,cc,clang,ld.lld,qemu-system-x86_64,xorriso script=step.sh -- triage --tier release --firmware both
step screen-native image=localhost/px75-ubuntu:2 tools=bash,python3,cc,ld.lld,qemu-system-x86_64,xorriso script=step.sh -- screen --tier native --firmware both
step screen-release image=localhost/px75-ubuntu:2 tools=bash,python3,cc,clang,ld.lld,qemu-system-x86_64,xorriso script=step.sh -- screen --tier release --firmware both
