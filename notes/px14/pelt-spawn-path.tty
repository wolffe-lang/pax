$ cat /etc/motd
PAX: this is /etc/motd, a text file in the initramfs, and not an ELF executable.
$ ls /bin
cat    echo   false  head   ls     pelt   pwd    sleep  tail   true   wc
$ wc /etc/motd
 1 15 81 /etc/motd
$ echo hi
hi
$ false; echo $?
1
$ sleep 1
$ nosuch
pelt: line 7: nosuch: not found
$ exit
