#!ps2-session
prompt 1 $\x20
type winsize
enter
quiet 1
type stty cols 80 rows 24
enter
quiet 1
type winsize
enter
quiet 1
type set -o friendly -o suggest -o histsearch
enter
quiet 1
type echo prefix_suffix
enter
quiet 1
type echo prefix
quiet 1
dump default-shadow 1
key ctrl-c
quiet 1
type PELT_COLORS='command=green:shadow=brblack+dim'
enter
quiet 1
type echo prefix
quiet 1
dump dim-shadow 1
key ctrl-c
quiet 1
type echo
quiet 1
dump command 1
key ctrl-c
quiet 1
type px81_missing
quiet 1
dump unknown 1
key ctrl-c
quiet 1
type echo '
quiet 1
dump open-quote 1
key ctrl-c
quiet 1
type abbr add zz 'echo PX81-ABBR'
enter
quiet 1
type zz 
quiet 1
dump abbr-space 1
enter
quiet 1
type echo PX81-EVENT
enter
quiet 1
type !!
enter
quiet 1
type echo !$
enter
quiet 1
type echo 
quiet 1
key alt-dot
quiet 1
dump last-arg 1
enter
quiet 1
type set +o friendly
enter
quiet 1
type echo PX81-DONE
enter
quiet 1
type exit 0
enter
quiet 1
