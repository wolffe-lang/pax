^~echo prefix_suffix
^~echo prefix^.
^~^C^.
^~PELT_COLORS='command=green:shadow=brblack+dim'
^~echo prefix^.
^~^C^.
^~echo^.
^~^C^.
^~px81_missing^.
^~^C^.
^~echo '^.
^~^C^.
^~abbr add zz 'echo PX81-ABBR'
^~zz ^.
^~
^~echo PX81-EVENT
^~!!
^~echo !$
^~echo ^.
^~.^.
^~
^~set +o friendly
