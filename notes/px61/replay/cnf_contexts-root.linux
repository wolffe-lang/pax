$ :
$ mkdir -p /tmp/px61-cnf_contexts-root
$ cd /tmp/px61-cnf_contexts-root
$ cd /tmp/px61-cnf_contexts-root
$ command_not_found_handle() { echo "handler: $1 $#"; return 4; }
$ nosuch1 | cat; echo "pipe st=$?"
handler: nosuch1 1
pipe st=0
$ v=$(nosuch2); echo "sub: [$v] st=$?"
sub: [handler: nosuch2 1] st=4
$ f() { nosuch3 x y; echo "in f st=$? 1=$1"; }; f F
handler: nosuch3 3
in f st=4 1=F
$ (nosuch4); echo "paren st=$?"
handler: nosuch4 1
paren st=4
$ exec true
