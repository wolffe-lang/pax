$ :
$ mkdir -p /tmp/px61-cnf_redirect-root
$ cd /tmp/px61-cnf_redirect-root
$ cd /tmp/px61-cnf_redirect-root
$ command_not_found_handle() { echo "out: $*"; echo "err: $*" >&2; }
$ nosuch a b >o 2>e; echo "st=$?"
st=0
$ cat o e
out: nosuch a b
err: nosuch a b
$ nosuch c 2>&1 | cat
out: nosuch c
err: nosuch c
$ exec true
