$ :
$ mkdir -p /tmp/px61-autocd_subshell-pax
$ cd /tmp/px61-autocd_subshell-pax
$ cd /tmp/px61-autocd_subshell-pax
$ shopt -s autocd 2>/dev/null; set -o autocd 2>/dev/null
$ W=$PWD; mkdir sub
$ x=$(sub 2>/dev/null); echo "cs-bare st=$? [${PWD#"$W"}]"
cs-bare st=127 []
$ x=$(./sub 2>/dev/null); echo "cs-slash st=$? [${PWD#"$W"}]"
cs-slash st=126 []
$ echo "cs-in $(sub 2>/dev/null; echo "[${PWD#"$W"}]")"
cs-in []
$ (sub 2>/dev/null; echo "paren [${PWD#"$W"}]")
paren []
$ (cd .; sub 2>/dev/null; echo "paren-two [${PWD#"$W"}]")
paren-two []
$ { sub 2>/dev/null; echo "group-in-pipe [${PWD#"$W"}]"; } | cat
group-in-pipe []
$ echo x | { sub 2>/dev/null; echo "last-stage [${PWD#"$W"}]"; }
last-stage []
$ sub 2>/dev/null | cat; echo "simple-stage-after [${PWD#"$W"}]"
simple-stage-after []
$ exit
