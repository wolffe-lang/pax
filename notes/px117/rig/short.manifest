# notes/px117/rig/short.manifest — the red take at the rows' commit (the rows before the kernel's
# change, run with this manifest from the head's worktree): kmain_console native with the pointer's
# probe and the pointer session on native BIOS; yew's session image and Y9 on native BIOS. A row's
# FAIL line reaches the record at column 0 (the recorder leaves `FAIL ` lines there).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px117/rig/lib.sh
rig short.manifest committed=../../..:HEAD:notes/px117/rig/short.manifest
step build image=localhost/px75-ubuntu:2 tools=cc,clang,readelf,python3,git,curl script=step.sh -- build --tier native
step pointer needs=build image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3 script=step.sh -- pointer --tier native --firmware bios
step yew-build image=localhost/px75-ubuntu:2 tools=cc,clang,readelf,python3,git,curl script=step.sh -- yew-build --tier native
step yew needs=yew-build image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3 script=step.sh -- yew --tier native --firmware bios
