# notes/px117/rig/plant.manifest — the plant's take (px117-plant-right-as-left, one commit over the
# green head): kmain_console native with the pointer's probe and the pointer session on native BIOS,
# where the rows that press the right button say FAIL by name at column 0.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px117/rig/lib.sh
rig plant.manifest committed=../../..:HEAD:notes/px117/rig/plant.manifest
step build image=localhost/px75-ubuntu:2 tools=cc,clang,readelf,python3,git,curl script=step.sh -- build --tier native
step pointer needs=build image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3 script=step.sh -- pointer --tier native --firmware bios
