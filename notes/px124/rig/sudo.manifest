# notes/px124/rig/sudo.manifest — tests/mpx5-sudo (take.sh, the recorder's steps mode with --keep-going
# and --preflight): the native build, the container sides (the host's engine through
# notes/px106/rig/docker-like), the native BIOS boots. login changed (its boot duties are init's), and
# the suite's login images boot it as pid 1 with no /bin/init: their rows must hold as they were.
floor 25
rig lib.sh committed=../../..:HEAD:notes/px124/rig/lib.sh
rig sudo.manifest committed=../../..:HEAD:notes/px124/rig/sudo.manifest
rig ../../px106/rig/docker-like committed=../../..:HEAD:notes/px106/rig/docker-like
step build image=localhost/px75-ubuntu:2 tools=cc,clang,readelf,python3,git,curl script=step.sh -- sudo-build --tier native
step auth needs=build tools=python3,taskset,readelf script=step.sh -- sudo-auth
step boot needs=build image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3 script=step.sh -- boot mpx5-sudo --tier native --firmware bios
