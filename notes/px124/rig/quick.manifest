# notes/px124/rig/quick.manifest — a quick check of tests/mpx5-init (take.sh, the recorder's steps
# mode with --keep-going and --preflight): its build (native) and its boots (native, BIOS, KVM).
floor 25
rig lib.sh committed=../../..:HEAD:notes/px124/rig/lib.sh
rig quick.manifest committed=../../..:HEAD:notes/px124/rig/quick.manifest
step build image=localhost/px75-ubuntu:2 tools=cc,gcc,clang,readelf,python3,git,curl script=step.sh -- build mpx5-init --tier native
step boot needs=build image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,mke2fs,debugfs,e2fsck script=step.sh -- boot mpx5-init --tier native --firmware bios
