# notes/px124/rig/burrowd.manifest — tests/mpx5-burrowd (take.sh, the recorder's steps mode with
# --keep-going and --preflight): its tree and its boots, native BIOS, in the rig's network image (KVM, a
# tap, dnsmasq, OpenSSH's ssh and sshd, git), the dev compiler copied by value.
floor 25
rig lib.sh committed=../../..:HEAD:notes/px124/rig/lib.sh
rig burrowd.manifest committed=../../..:HEAD:notes/px124/rig/burrowd.manifest
step burrowd image=localhost/px124-net:1 tools=cc,gcc,clang,readelf,python3,git,curl,qemu-system-x86_64,ssh,sshd,dnsmasq,ip,mke2fs script=step.sh -- burrowd --tier native --firmware bios
