# notes/px131/rig/red.manifest — the guard's red take at the rows' commit (trunk's kernel paths and
# the instrument): mpx6-latency's guard loads, native, both firmwares, 1 GiB, KVM, where munmap of a
# terabyte of nothing, getrandom of 8 MiB and a read of 8 MiB of /proc/self/mem are out of bounds
# (`FAIL L2 …` at column 0).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig red.manifest committed=../../..:HEAD:notes/px131/rig/red.manifest
step latency image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier native --firmware both --mem 1024 --accel kvm
