# notes/px131/rig/plant-2.manifest — the second part's plant (px131-plant-*: its head with one hunk in
# kernel/sched that leaves a device's wake-up to wait for the quantum again): the guard on native BIOS at
# 1 GiB under KVM, red by name at a host's ping beside a hog (`FAIL L5 …`).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig plant-2.manifest committed=../../..:HEAD:notes/px131/rig/plant-2.manifest
step latency image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier native --firmware bios --mem 1024 --accel kvm
