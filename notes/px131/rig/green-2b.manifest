# notes/px131/rig/green-2b.manifest — the second part's take at its head, second half: the suites
# whose waits the change reaches, native BIOS, each against Linux where it has its side: the clocks
# and sleeps (mpx3-user), futexes' timeouts and signals between threads (mpx3-threads), a key's
# reader (mpx3-console), a pty's two ends (mpx5-pty), UDP through the network thread (mpx4-udp) and USB's
# commands and transfers, which now look before their deadline (mpx6-usb).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px131/rig/engine-ns
rig green-2b.manifest committed=../../..:HEAD:notes/px131/rig/green-2b.manifest
step user image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-user --tier native --firmware bios
step threads image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-threads --tier native --firmware bios
step console image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-console --tier native --firmware bios
step pty image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx5-pty --tier native --firmware bios
step udp image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx4-udp --tier native --firmware bios
step usb image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx6-usb --tier native --firmware bios
