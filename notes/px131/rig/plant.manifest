# notes/px131/rig/plant.manifest — the plant's take (px131-plant-*: the head with one hunk in
# kernel/vm that walks a range a page at a time again): the guard on native BIOS at 1 GiB under KVM,
# red by name at munmap of a terabyte of nothing (`FAIL L2 … hole:1024 …`).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig plant.manifest committed=../../..:HEAD:notes/px131/rig/plant.manifest
step latency image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier native --firmware bios --mem 1024 --accel kvm
