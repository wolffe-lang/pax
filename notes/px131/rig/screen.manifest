# notes/px131/rig/screen.manifest — the console's write at the installed machine's shape: a 2560x1440 screen
# and no COM1, so every byte is drawn and none is sent (tests/mpx6-latency --screen --no-com1), native BIOS
# at 1 GiB under KVM, a 64 KiB write and a 4 KiB one: how long each holds interrupts off.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig screen.manifest committed=../../..:HEAD:notes/px131/rig/screen.manifest
step console-64k image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier native --firmware bios --mem 1024 --accel kvm --screen 2560x1440 --no-com1 --loads console:65536
step console-4k image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier native --firmware bios --mem 1024 --accel kvm --screen 2560x1440 --no-com1 --loads console:4096
