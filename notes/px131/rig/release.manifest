# notes/px131/rig/release.manifest — px131's release tier (the LLVM tier the images ship) of the suites
# the change touches: the guard on both firmwares under KVM, the scheduler, the interrupts, mappings and
# /proc/<pid>/mem, BIOS.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px131/rig/engine-ns
rig release.manifest committed=../../..:HEAD:notes/px131/rig/release.manifest
step latency image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier release --firmware both --mem 1024 --accel kvm
step sched image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,readelf,curl,xorriso script=step.sh -- suite mpx2-sched --tier release --firmware bios
step interrupts image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,readelf,curl,xorriso script=step.sh -- suite mpx2-interrupts --tier release --firmware bios
step maps image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-maps --tier release --firmware bios
step trace image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx5-trace --tier release --firmware bios
