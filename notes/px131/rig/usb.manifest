# notes/px131/rig/usb.manifest — the second part's take after its USB session's change (the kernel as at b310a495):
# the planner, the session's selftest, and the USB suite (the keyboard on the root port, behind a hub and nested,
# the mouse and hot-plug) on native BIOS and UEFI.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px131/rig/engine-ns
rig usb.manifest committed=../../..:HEAD:notes/px131/rig/usb.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step usb-session-selftest image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- suite usb-session-selftest
step usb image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx6-usb --tier native --firmware bios
step usb-uefi image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx6-usb --tier native --firmware uefi
