# notes/px131/rig/quick-b.manifest — px131's take at the head, second half: the user suites the
# fixes reach, native BIOS: system calls (mpx3-user), mappings and munmap (mpx3-maps), /proc/<pid>/mem
# and ptrace (mpx5-trace), the devices' rights and reads (mpx5-users), and
# the tree with /proc (mpx3-tree), each against Linux where the suite has its side.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig engine-ns committed=../../..:HEAD:notes/px131/rig/engine-ns
rig quick-b.manifest committed=../../..:HEAD:notes/px131/rig/quick-b.manifest
step user image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-user --tier native --firmware bios
step maps image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-maps --tier native --firmware bios
step trace image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx5-trace --tier native --firmware bios
step users image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx5-users --tier native --firmware bios
step tree image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-tree --tier native --firmware bios
