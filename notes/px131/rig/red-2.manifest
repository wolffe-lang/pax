# notes/px131/rig/red-2.manifest — the second part's red take at its rows' commit (the first part's
# kernel): mpx6-latency's guard loads with `flood`, native, both firmwares, 1 GiB, KVM, where the clocks
# keep a fraction of the counter's time across long calls (`FAIL L4 …`) and the host's ping beside a
# hog waits a quantum a hop (`FAIL L5 …`); L6 (a hog under a ping flood) holds.
floor 35
rig lib.sh committed=../../..:HEAD:notes/px131/rig/lib.sh
rig red-2.manifest committed=../../..:HEAD:notes/px131/rig/red-2.manifest
step latency image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier native --firmware both --mem 1024 --accel kvm
