cd /etc
cd /bin
g -
aspen /
cd /usr/share/lupin
lupin run hello.lu
su pax
cd /home/pax
mkdir Script
echo 'echo hi' > Script/greet.sh; chmod +x Script/greet.sh; ./Script/greet.sh
echo st=$?
aspen -a /home/pax
cat > x.lu
^~//! member: false
^~fn main() -> !int {
^~    print("written and run on PAX by pax")
^~    0
^~}
^~^D
lupin run x.lu
exit
exit
