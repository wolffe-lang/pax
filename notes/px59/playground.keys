#!ps2-session
# px59: the maintainer's session on the rebuilt playground, typed at the
# PS/2 keyboard (tools/ps2-session): yew notes.txt, a line typed in
# insert mode, saved, quit, the file read back; each screen held to
# tools/screen-ref.
prompt 1 $\x20
type cd /tmp
enter
prompt 2 $\x20
type yew notes.txt
enter
quiet 6
dump play-yew-opened
type i
pause 1
type written in yew on PAX, at its keyboard
pause 1
key esc
dump play-yew-typed
type :w
enter
pause 6
dump play-yew-saved
type :q
enter
prompt 3 $\x20
type cat notes.txt
enter
prompt 4 $\x20
dump play-shell
type exit
enter
