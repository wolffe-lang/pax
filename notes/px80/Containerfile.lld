# px80: the static lld 18 build environment (px60's Containerfile and
# Containerfile.lld in one, adapted): Alpine 3.20 by digest, clang 17 with
# libc++/libc++abi, LLVM libunwind and compiler-rt, all static; zlib and zstd
# as static libraries with their headers (R-px80-2: px60's lld had neither).
# Packages only; the LLVM tarball is compiled, never read.
FROM docker.io/library/alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache musl-dev lld-dev llvm17-static llvm17-dev clang17 \
    libc++-dev libc++-static zlib-dev zlib-static zstd-dev zstd-static libxml2-static \
    cmake ninja python3 curl compiler-rt llvm-libunwind-dev llvm-libunwind-static \
 && apk info -vv | sort
