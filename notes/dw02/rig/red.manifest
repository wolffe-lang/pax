# notes/dw02/rig/red.manifest — the measurement and the rows' red take at the rows' commit (px131's
# kernel, unchanged): the planner's test; mpx6-entropy's six configurations, native, both firmwares
# under KVM, then the same images on BIOS under TCG (CI's accelerator). What today's kernel answers is
# the `~` table; the contract's rows go red by name (`FAIL E1`, `FAIL E2`, … at column 0).
floor 35
rig lib.sh committed=../../..:HEAD:notes/dw02/rig/lib.sh
rig red.manifest committed=../../..:HEAD:notes/dw02/rig/red.manifest
step ci-plan image=localhost/px75-ubuntu:2 tools=python3 script=step.sh -- ci-plan
step entropy-kvm image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,clang,readelf,curl,xorriso script=step.sh -- suite mpx6-entropy --tier native --firmware both --accel kvm
step entropy-tcg image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,readelf,xorriso script=step.sh -- again mpx6-entropy --tier native --firmware bios --accel tcg
