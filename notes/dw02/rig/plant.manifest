# notes/dw02/rig/plant.manifest — the plant's take (dw02-plant-*: the head with one hunk in kernel/user
# that serves a strict request from the insecure path when the source is not ready, the silent fallback
# this lane removes): mpx6-entropy native, BIOS, KVM, red by name where the strict calls must refuse
# (`FAIL E2 … masked`, `FAIL E5 … fail`, `FAIL E6 … stuck`, `FAIL E9 … masked`).
floor 35
rig lib.sh committed=../../..:HEAD:notes/dw02/rig/lib.sh
rig plant.manifest committed=../../..:HEAD:notes/dw02/rig/plant.manifest
step entropy image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,clang,readelf,curl,xorriso script=step.sh -- suite mpx6-entropy --tier native --firmware bios --accel kvm
