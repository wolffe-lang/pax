# notes/dw02/rig/release.manifest — dw02's release tier (the LLVM tier the images ship) of the suites the
# change touches: mpx6-entropy's six configurations on both firmwares under KVM, the loader's AT_RANDOM and
# the latency guard's getrandom load, BIOS; tests/kernel-as at the release tier.
floor 35
rig lib.sh committed=../../..:HEAD:notes/dw02/rig/lib.sh
rig release.manifest committed=../../..:HEAD:notes/dw02/rig/release.manifest
step entropy-kvm image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,clang,readelf,curl,xorriso script=step.sh -- suite mpx6-entropy --tier release --firmware both --accel kvm
step loader image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,cc,readelf,curl,xorriso script=step.sh -- suite mpx3-loader --tier release --firmware bios
step latency image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3,gcc,readelf,curl,xorriso script=step.sh -- suite mpx6-latency --tier release --firmware bios --mem 1024 --accel kvm
step kernel-as-release image=localhost/px75-ubuntu:2 tools=cc,clang,as,ld.lld,nm,objdump,git,curl,strip,readelf,tar script=step.sh -- kernel-as --tier release
