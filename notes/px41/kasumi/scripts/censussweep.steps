# px41: pax#47 counted. tests/mpx4-lobo's load session with the census taken 28 times a boot, each a different time after its round: after the
# warm-up and one unmeasured round, 28 rounds of @ROUND@ s of four clients, each followed by a sleep of
# 0 0.25 0.5 0.75 1 1.25 1.5 1.75 2 2.25 2.5 3 4 6 s (twice over) and the census.
pax: wait ^\$ $ 120
type cd /srv
mark
type lobo -c conf/four.conf serve &
type echo master $!
wait master (\d+)\s*$ 30
capture M master (\d+)\s*$
wait generation-activated gen=1 seq=2 worker=4 120
get warm 80 / 50 new
get warm-big 80 /big.txt 10 new
load r0 80 /,/big.txt @ROUND@ 4
loadwait r0
sleep 0
mark
type echo census 0; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r1 80 /,/big.txt @ROUND@ 4
loadwait r1
sleep 0.25
mark
type echo census 1; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r2 80 /,/big.txt @ROUND@ 4
loadwait r2
sleep 0.5
mark
type echo census 2; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r3 80 /,/big.txt @ROUND@ 4
loadwait r3
sleep 0.75
mark
type echo census 3; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r4 80 /,/big.txt @ROUND@ 4
loadwait r4
sleep 1
mark
type echo census 4; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r5 80 /,/big.txt @ROUND@ 4
loadwait r5
sleep 1.25
mark
type echo census 5; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r6 80 /,/big.txt @ROUND@ 4
loadwait r6
sleep 1.5
mark
type echo census 6; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r7 80 /,/big.txt @ROUND@ 4
loadwait r7
sleep 1.75
mark
type echo census 7; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r8 80 /,/big.txt @ROUND@ 4
loadwait r8
sleep 2
mark
type echo census 8; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r9 80 /,/big.txt @ROUND@ 4
loadwait r9
sleep 2.25
mark
type echo census 9; cat /proc/meminfo /proc/sys/fs/file-nr /proc/net/sockstat /proc/[0-9]*/status; echo census end
wait ^census end 60
load r10 80 /,/big.txt @ROUND@ 4
loadwait r10
sleep 2.5
mark
