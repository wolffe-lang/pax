# notes/px125/rig/short.manifest — the red take at the rows' commit (the rows before the console's and
# the font's fixes, run with this manifest from the head's worktree): tests/mpx7-mux built native,
# its Linux side, and booted on native BIOS, where M4 names Ctrl-Space's byte and the box, arrow and
# powerline glyphs not drawn (`FAIL M4 B5 ctrl-space`, `FAIL M4 B3 …` at column 0).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px125/rig/lib.sh
rig engine.sh committed=../../..:HEAD:notes/px125/rig/engine.sh
rig short.manifest committed=../../..:HEAD:notes/px125/rig/short.manifest
step build image=localhost/px75-ubuntu:2 tools=cc,clang,readelf,python3,git,curl script=step.sh -- build --tier native
step linux needs=build tools=python3 script=step.sh -- linux
step boot needs=build image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3 script=step.sh -- boot --tier native --firmware bios
