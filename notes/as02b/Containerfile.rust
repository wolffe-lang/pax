# as02b (px57's notes/px57/rust/Containerfile on as02b's base): the image
# the seam wolf (wolf-lang 9f2cff44, as02a's --assembler / WOLF_AS) is built
# in. The base is clef's pinned integration image (clef ci/integration-lock.json
# at 996a3ccd: Ubuntu 24.04 by digest, binutils 2.42-4ubuntu2.10, gcc 13.3,
# clang/lld 18.1.3, QEMU, OVMF, every package by sha256), built on kasumi by
# clef's own tools/in-container and tools/integration-image. rustup-init
# from static.rust-lang.org, checked against the digest its .sha256 names
# (read twice, 2026-10-25: the same digest px57 read); wolf-lang's channel
# (rust-toolchain.toml at 9f2cff44: 1.97.1, with rustfmt and clippy, which
# that file names) installed INSIDE the image, never on a host.
#   podman build -t localhost/as02b-rust -f notes/as02b/Containerfile.rust notes/as02b
FROM localhost/clef-integration:52846d3b65aeafca
ENV RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo PATH=/opt/rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ARG RUSTUP_INIT_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
RUN curl -sSfL --retry 3 -o /tmp/rustup-init https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init \
 && echo "$RUSTUP_INIT_SHA256  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.97.1 --component rustfmt,clippy \
 && rm /tmp/rustup-init \
 && chmod -R a+rX /opt/rust \
 && rustc --version && cargo --version && rustup component list --installed
