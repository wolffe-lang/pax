# notes/px119/rig/short.manifest — the red take at the rows' commit and the plant's take (take.sh):
# the native build, the container sides (P4's sudo-n-tty-reused) and native BIOS's boots (P8, P9).
# A row's FAIL line reaches the record at column 0 (the recorder leaves `FAIL ` lines there).
floor 35
rig lib.sh committed=../../..:HEAD:notes/px119/rig/lib.sh
rig short.manifest committed=../../..:HEAD:notes/px119/rig/short.manifest
rig ../../px106/rig/docker-like committed=../../..:HEAD:notes/px106/rig/docker-like
step build image=localhost/px75-ubuntu:2 tools=cc,clang,readelf,python3,git,curl script=step.sh -- build --tier native
step auth needs=build tools=python3,taskset,readelf script=step.sh -- auth
step boot needs=build image=localhost/px75-ubuntu:2 tools=qemu-system-x86_64,python3 script=step.sh -- boot --tier native --firmware bios
