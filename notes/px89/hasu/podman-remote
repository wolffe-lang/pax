#!/usr/bin/env bash
# px89: the container engine inside the lane's containers (ctr2.sh
# ENGINE=1): hasu's podman as a remote client of the lane's service
# (podman-service.sh). A `run` gets --memory 12g and --pids-limit, and its
# command `taskset -c $PX89_CPUS` after the image (the argument equal to
# $PAX_TREE_IMAGE or $PAX_E2FS_IMAGE): rootless podman has no cpuset
# controller on hasu, so the pinning is inside (hasu-env/README.md).
set -euo pipefail
# The Nix store's own path: the container mounts /nix/store, not hasu-env
# (whose profile link names this binary on the host).
P=/nix/store/a4x9z75ghw7jrd7kv4c4rrv6dz0ayfsp-podman-5.8.9/bin/podman
R=(--remote --url unix:///home/mfwolffe/lanes/px89/podman.sock)
[ -n "${PX89_CPUS:-}" ] || { echo "podman-remote: PX89_CPUS unset" >&2; exit 2; }
if [ "${1:-}" != run ]; then exec "$P" "${R[@]}" "$@"; fi
shift
out=(run --memory 12g --pids-limit 16384)
seen=0
for a in "$@"; do
    out+=("$a")
    if [ "$seen" = 0 ] && { [ "$a" = "${PAX_TREE_IMAGE:-x}" ] || [ "$a" = "${PAX_E2FS_IMAGE:-x}" ]; }; then
        out+=(taskset -c "$PX89_CPUS")
        seen=1
    fi
done
[ "$seen" = 1 ] || { echo "podman-remote: no image argument in: $*" >&2; exit 2; }
exec "$P" "${R[@]}" "${out[@]}"
