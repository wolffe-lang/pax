# /pax/install-targets: the disks PAX's installer (pax-install) may erase.
#
# pax-install writes to no disk that is not named here by its model AND
# its serial, exactly as Linux shows them. As shipped, this file names no
# disk, so the installer refuses every disk and writes nothing.
#
# To allow one, from any OS before booting this stick, add one line:
#
#   model=<model> serial=<serial>
#
# reading both values on Linux (sdX is the disk, by its size and model in
# lsblk; check it twice):
#
#   cat /sys/block/sdX/device/model /sys/block/sdX/device/serial
#
# Never list the disk your running system lives on. Lines that start with
# '#' and blank lines are ignored; any other line that is not of the form
# above makes the installer refuse every disk. The installer's screen
# prints, for each disk it refuses, the line that would allow it.
model=Samsung SSD 860 serial=<kasumi-serial>
